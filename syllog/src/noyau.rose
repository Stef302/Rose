# ═══════════════════════════════════════════════════════════════════════════
# syllog/src/noyau.rose — NOYAU DE VÉRIFICATION DE TYPES DE SYLLOG
# ═══════════════════════════════════════════════════════════════════════════
#
# Interface publique (SPEC.md) :
#   verifier(t, ctx)      -> Resultat  {ok: booleen, type: Terme, erreur: chaine}
#   beta(t)               -> Terme     (beta-réduction complète, garde 10000)
#   convertible(a, b)     -> booleen   (beta + alpha-équivalence)
#   bien_forme(t, ctx)    -> booleen
#
# REPRÉSENTATION (contract SPEC.md) :
#   Terme = table Rose avec champ « genre » :
#     var          {genre:"var", nom}
#     type         {genre:"type", niveau: entier}
#     pi           {genre:"pi", nom, domaine, codomaine}
#     lam          {genre:"lam", nom, domaine, corps}
#     app          {genre:"app", fonction, argument}
#     const        {genre:"const", nom, type}
#     ind          {genre:"ind", nom, params: liste<table>}
#     constructeur {genre:"constructeur", nom, type}
#     elim         {genre:"elim", nom, motif, branches: liste<table>}
#   Contexte = liste<table> d'associations {nom, type}, REMBOURRÉE à l'index 0
#   par table() (le vérificateur Rose refuse les listes vides). Une table
#   {nom: Terme} est aussi acceptée : noy_normaliser_ctx la convertit.
#   Les listes de termes (params, branches) sont elles aussi rembourrées.
#   Sentinelle interne : {genre:"_absent"} = champ manquant / non lié.
#
# Aucune dépendance externe, aucun fichier modifié hors celui-ci.
# Documentation : syllog/docs/NOYAU.md
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────── 1. Constructeurs et accès défensif ───────────────────

fn noy_absent() -> table {
  $t = table()
  inserer($t, "genre", "_absent")
  retour $t
}

fn noy_genre(t: table) -> chaine {
  $g = ""
  si (type(t) == "table") {
    si (cle_existe(t, "genre")) {
      $x = t["genre"]
      si (type($x) == "chaine") { $g = $x }
    }
  }
  retour $g
}

fn noy_est_absent(t: table) -> booleen {
  retour noy_genre(t) == "_absent"
}

fn noy_nom(t: table) -> chaine {
  $v = ""
  si (type(t) == "table") {
    si (cle_existe(t, "nom")) {
      $x = t["nom"]
      si (type($x) == "chaine") { $v = $x }
    }
  }
  retour $v
}

fn noy_niveau(t: table) -> entier {
  $v = -1
  si (type(t) == "table") {
    si (cle_existe(t, "niveau")) {
      $x = t["niveau"]
      si (type($x) == "entier") { $v = $x }
    }
  }
  retour $v
}

# Lecture d'un champ-table : jamais d'erreur « clé absente ».
fn noy_champ(t: table, cle: chaine) -> table {
  $r = noy_absent()
  si (type(t) == "table") {
    si (cle_existe(t, cle)) { $r = t[cle] }
  }
  retour $r
}

fn noy_champ_liste(t: table, cle: chaine) -> liste<table> {
  $r = [table()]
  si (type(t) == "table") {
    si (cle_existe(t, cle)) {
      $x = t[cle]
      si (type($x) == "liste") { $r = $x }
    }
  }
  retour $r
}

fn noy_corps(t: table) -> table {
  $g = noy_genre(t)
  si ($g == "pi") { retour noy_champ(t, "codomaine") }
  si ($g == "lam") { retour noy_champ(t, "corps") }
  retour noy_absent()
}

fn noy_var(n: chaine) -> table {
  $t = table()
  inserer($t, "genre", "var")
  inserer($t, "nom", n)
  retour $t
}

fn noy_type(n: entier) -> table {
  $t = table()
  inserer($t, "genre", "type")
  inserer($t, "niveau", n)
  retour $t
}

fn noy_pi(n: chaine, d: table, c: table) -> table {
  $t = table()
  inserer($t, "genre", "pi")
  inserer($t, "nom", n)
  inserer($t, "domaine", d)
  inserer($t, "codomaine", c)
  retour $t
}

fn noy_lam(n: chaine, d: table, c: table) -> table {
  $t = table()
  inserer($t, "genre", "lam")
  inserer($t, "nom", n)
  inserer($t, "domaine", d)
  inserer($t, "corps", c)
  retour $t
}

fn noy_app(f: table, a: table) -> table {
  $t = table()
  inserer($t, "genre", "app")
  inserer($t, "fonction", f)
  inserer($t, "argument", a)
  retour $t
}

fn noy_const(n: chaine, ty: table) -> table {
  $t = table()
  inserer($t, "genre", "const")
  inserer($t, "nom", n)
  inserer($t, "type", ty)
  retour $t
}

fn noy_constructeur(n: chaine, ty: table) -> table {
  $t = table()
  inserer($t, "genre", "constructeur")
  inserer($t, "nom", n)
  inserer($t, "type", ty)
  retour $t
}

fn noy_ind(n: chaine, p: liste<table>) -> table {
  $t = table()
  inserer($t, "genre", "ind")
  inserer($t, "nom", n)
  inserer($t, "params", p)
  retour $t
}

fn noy_elim(n: chaine, m: table, b: liste<table>) -> table {
  $t = table()
  inserer($t, "genre", "elim")
  inserer($t, "nom", n)
  inserer($t, "motif", m)
  inserer($t, "branches", b)
  retour $t
}

# ───────────────────────── 2. Listes de noms ───────────────────────────────

fn noy_contient(l: liste<chaine>, s: chaine) -> booleen {
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    si (l[$k] == s) { retour vrai }
    $k = $k + 1
  }
  retour faux
}

fn noy_copie_ch(l: liste<chaine>) -> liste<chaine> {
  $r = [""]
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    joindre($r, l[$k])
    $k = $k + 1
  }
  retour $r
}

fn noy_ajoute_unique(l: liste<chaine>, s: chaine) -> liste<chaine> {
  $r = noy_copie_ch(l)
  si (non noy_contient($r, s)) { joindre($r, s) }
  retour $r
}

fn noy_sans_ch(l: liste<chaine>, s: chaine) -> liste<chaine> {
  $r = [""]
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    si (l[$k] != s) { joindre($r, l[$k]) }
    $k = $k + 1
  }
  retour $r
}

fn noy_union_ch(a: liste<chaine>, b: liste<chaine>) -> liste<chaine> {
  $r = noy_copie_ch(a)
  $n = longueur(b)
  $k = 1
  tant_que ($k < $n) {
    si (non noy_contient($r, b[$k])) { joindre($r, b[$k]) }
    $k = $k + 1
  }
  retour $r
}

fn noy_copie_tab(l: liste<table>) -> liste<table> {
  $r = [table()]
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    joindre($r, l[$k])
    $k = $k + 1
  }
  retour $r
}

# ───────────────── 3. Variables libres / noms / fraîcheur ──────────────────

fn noy_libres_liste(l: liste<table>) -> liste<chaine> {
  $r = [""]
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    $r = noy_union_ch($r, noy_libres(l[$k]))
    $k = $k + 1
  }
  retour $r
}

fn noy_libres(t: table) -> liste<chaine> {
  $g = noy_genre(t)
  $r = [""]
  si ($g == "var") {
    retour noy_ajoute_unique($r, noy_nom(t))
  }
  si ($g == "app") {
    $r = noy_union_ch(noy_libres(noy_champ(t, "fonction")),
                      noy_libres(noy_champ(t, "argument")))
    retour $r
  }
  si ($g == "pi" ou $g == "lam") {
    $r = noy_union_ch(noy_libres(noy_champ(t, "domaine")),
                      noy_libres(noy_corps(t)))
    $r = noy_sans_ch($r, noy_nom(t))
    retour $r
  }
  si ($g == "const" ou $g == "constructeur") {
    retour noy_libres(noy_champ(t, "type"))
  }
  si ($g == "ind") {
    retour noy_libres_liste(noy_champ_liste(t, "params"))
  }
  si ($g == "elim") {
    $r = noy_union_ch(noy_libres(noy_champ(t, "motif")),
                      noy_libres_liste(noy_champ_liste(t, "branches")))
    retour $r
  }
  retour $r
}

# TOUS les noms présents dans un terme (libres ET lieurs) : sert à garantir
# qu'un nom frais ne capturera rien, même sous un lieur intérieur.
fn noy_noms_liste(l: liste<table>) -> liste<chaine> {
  $r = [""]
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    $r = noy_union_ch($r, noy_noms(l[$k]))
    $k = $k + 1
  }
  retour $r
}

fn noy_noms(t: table) -> liste<chaine> {
  $g = noy_genre(t)
  $r = [""]
  si ($g == "var" ou $g == "const" ou $g == "constructeur" ou
      $g == "ind" ou $g == "elim") {
    $r = noy_ajoute_unique($r, noy_nom(t))
  }
  si ($g == "app") {
    $r = noy_union_ch(noy_noms(noy_champ(t, "fonction")),
                      noy_noms(noy_champ(t, "argument")))
    retour $r
  }
  si ($g == "pi" ou $g == "lam") {
    $r = noy_ajoute_unique($r, noy_nom(t))
    $r = noy_union_ch($r, noy_noms(noy_champ(t, "domaine")))
    $r = noy_union_ch($r, noy_noms(noy_corps(t)))
    retour $r
  }
  si ($g == "ind") {
    $r = noy_union_ch($r, noy_noms_liste(noy_champ_liste(t, "params")))
    retour $r
  }
  si ($g == "elim") {
    $r = noy_union_ch($r, noy_noms(noy_champ(t, "motif")))
    $r = noy_union_ch($r, noy_noms_liste(noy_champ_liste(t, "branches")))
    retour $r
  }
  si ($g == "const" ou $g == "constructeur") {
    $r = noy_union_ch($r, noy_noms(noy_champ(t, "type")))
  }
  retour $r
}

fn noy_frais(base: chaine, ev: liste<chaine>) -> chaine {
  $cand = base
  $suf = ""
  tant_que (noy_contient(ev, $cand)) {
    $suf = $suf + "'"
    $cand = base + $suf
  }
  retour $cand
}

# ───────────── 4. Substitution capture-évitante (le cœur) ──────────────────

fn noy_subst_liste(l: liste<table>, nom: chaine, val: table) -> liste<table> {
  $r = [table()]
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    joindre($r, noy_subst(l[$k], nom, val))
    $k = $k + 1
  }
  retour $r
}

fn noy_subst(t: table, nom: chaine, val: table) -> table {
  $g = noy_genre(t)

  si ($g == "var") {
    si (noy_nom(t) == nom) { retour val }
    retour t
  }
  si ($g == "type" ou $g == "_absent") { retour t }

  si ($g == "app") {
    retour noy_app(noy_subst(noy_champ(t, "fonction"), nom, val),
                   noy_subst(noy_champ(t, "argument"), nom, val))
  }

  si ($g == "pi" ou $g == "lam") {
    $b = noy_nom(t)
    $dom = noy_subst(noy_champ(t, "domaine"), nom, val)
    $c = noy_corps(t)

    # Le lieur « b » masque « nom » dans le corps ; le domaine, lui, est
    # hors de sa portée et doit être substitué.
    si ($b == nom) {
      si ($g == "pi") { retour noy_pi($b, $dom, $c) }
      retour noy_lam($b, $dom, $c)
    }

    # Évitation de capture : on ne renomme le lieur QUE si la substitution
    # a réellement lieu dans le corps (nom libre dans c) ET que « b » est
    # libre dans « val ». Renommer sans nécessité est correct à alpha près,
    # mais rendrait les types affichés instables.
    $a_substituer = noy_contient(noy_libres($c), nom)
    $capture = noy_contient(noy_libres(val), $b)
    $ev = noy_union_ch(noy_noms(t), noy_libres(val))
    $ev = noy_ajoute_unique($ev, nom)
    $nb = $b
    $c2 = $c
    si ($a_substituer et $capture) {
      $nb = noy_frais($b, $ev)
      $c2 = noy_subst($c, $b, noy_var($nb))
    }
    $c3 = noy_subst($c2, nom, val)
    si ($g == "pi") { retour noy_pi($nb, $dom, $c3) }
    retour noy_lam($nb, $dom, $c3)
  }

  si ($g == "const" ou $g == "constructeur") {
    $ty = noy_subst(noy_champ(t, "type"), nom, val)
    si ($g == "const") { retour noy_const(noy_nom(t), $ty) }
    retour noy_constructeur(noy_nom(t), $ty)
  }

  si ($g == "ind") {
    retour noy_ind(noy_nom(t), noy_subst_liste(noy_champ_liste(t, "params"), nom, val))
  }

  si ($g == "elim") {
    $br = noy_subst_liste(noy_champ_liste(t, "branches"), nom, val)
    retour noy_elim(noy_nom(t), noy_subst(noy_champ(t, "motif"), nom, val), $br)
  }

  retour t
}

# ────────────────────── 5. Beta-réduction complète ─────────────────────────

fn noy_pas(t: table) -> table {
  $r = table()
  inserer($r, "change", vrai)
  inserer($r, "terme", t)
  retour $r
}

fn noy_rien(t: table) -> table {
  $r = table()
  inserer($r, "change", faux)
  inserer($r, "terme", t)
  retour $r
}

fn noy_pas_l(l: liste<table>) -> table {
  $r = table()
  inserer($r, "change", vrai)
  inserer($r, "liste", l)
  retour $r
}

fn noy_rien_l(l: liste<table>) -> table {
  $r = table()
  inserer($r, "change", faux)
  inserer($r, "liste", l)
  retour $r
}

fn noy_change(r: table) -> booleen {
  $v = faux
  si (cle_existe(r, "change")) {
    $x = r["change"]
    si (type($x) == "booleen") { $v = $x }
  }
  retour $v
}

fn noy_resultat(r: table) -> table {
  retour noy_champ(r, "terme")
}

fn noy_resultat_l(r: table) -> liste<table> {
  $v = [table()]
  si (cle_existe(r, "liste")) {
    $x = r["liste"]
    si (type($x) == "liste") { $v = $x }
  }
  retour $v
}

# Un pas de réduction en stratégie normale (le plus à gauche, dehors).
fn noy_redex_liste(l: liste<table>) -> table {
  $n = longueur(l)
  $k = 1
  tant_que ($k < $n) {
    $r = noy_redex(l[$k])
    si (noy_change($r)) {
      $out = [table()]
      $j = 1
      tant_que ($j < $k) {
        joindre($out, l[$j])
        $j = $j + 1
      }
      joindre($out, noy_resultat($r))
      $j = $k + 1
      tant_que ($j < $n) {
        joindre($out, l[$j])
        $j = $j + 1
      }
      retour noy_pas_l($out)
    }
    $k = $k + 1
  }
  retour noy_rien_l(l)
}

fn noy_redex(t: table) -> table {
  $g = noy_genre(t)

  si ($g == "app") {
    $f = noy_champ(t, "fonction")
    $a = noy_champ(t, "argument")
    $rf = noy_redex($f)
    si (noy_change($rf)) {
      retour noy_pas(noy_app(noy_resultat($rf), $a))
    }
    si (noy_genre($f) == "lam") {
      retour noy_pas(noy_subst(noy_champ($f, "corps"), noy_nom($f), $a))
    }
    $ra = noy_redex($a)
    si (noy_change($ra)) {
      retour noy_pas(noy_app($f, noy_resultat($ra)))
    }
    retour noy_rien(t)
  }

  si ($g == "pi") {
    $rd = noy_redex(noy_champ(t, "domaine"))
    si (noy_change($rd)) {
      retour noy_pas(noy_pi(noy_nom(t), noy_resultat($rd), noy_champ(t, "codomaine")))
    }
    $rc = noy_redex(noy_champ(t, "codomaine"))
    si (noy_change($rc)) {
      retour noy_pas(noy_pi(noy_nom(t), noy_champ(t, "domaine"), noy_resultat($rc)))
    }
    retour noy_rien(t)
  }

  si ($g == "lam") {
    $rd = noy_redex(noy_champ(t, "domaine"))
    si (noy_change($rd)) {
      retour noy_pas(noy_lam(noy_nom(t), noy_resultat($rd), noy_champ(t, "corps")))
    }
    $rc = noy_redex(noy_champ(t, "corps"))
    si (noy_change($rc)) {
      retour noy_pas(noy_lam(noy_nom(t), noy_champ(t, "domaine"), noy_resultat($rc)))
    }
    retour noy_rien(t)
  }

  si ($g == "const" ou $g == "constructeur") {
    $rt = noy_redex(noy_champ(t, "type"))
    si (noy_change($rt)) {
      si ($g == "const") { retour noy_pas(noy_const(noy_nom(t), noy_resultat($rt))) }
      retour noy_pas(noy_constructeur(noy_nom(t), noy_resultat($rt)))
    }
    retour noy_rien(t)
  }

  si ($g == "ind") {
    $rl = noy_redex_liste(noy_champ_liste(t, "params"))
    si (noy_change($rl)) {
      retour noy_pas(noy_ind(noy_nom(t), noy_resultat_l($rl)))
    }
    retour noy_rien(t)
  }

  si ($g == "elim") {
    $rm = noy_redex(noy_champ(t, "motif"))
    si (noy_change($rm)) {
      retour noy_pas(noy_elim(noy_nom(t), noy_resultat($rm), noy_champ_liste(t, "branches")))
    }
    $rb = noy_redex_liste(noy_champ_liste(t, "branches"))
    si (noy_change($rb)) {
      retour noy_pas(noy_elim(noy_nom(t), noy_champ(t, "motif"), noy_resultat_l($rb)))
    }
    retour noy_rien(t)
  }

  retour noy_rien(t)
}

fn noy_pas_beta(r: table) -> entier {
  $v = 0
  si (cle_existe(r, "pas")) {
    $x = r["pas"]
    si (type($x) == "entier") { $v = $x }
  }
  retour $v
}

fn noy_erreur_beta(r: table) -> chaine {
  $v = ""
  si (cle_existe(r, "erreur")) {
    $x = r["erreur"]
    si (type($x) == "chaine") { $v = $x }
  }
  retour $v
}

# Réduction complète bornée. Rend {terme, pas, erreur}. En cas de dépassement,
# on rend le terme PARTIELLEMENT réduit et une erreur explicite : jamais de
# boucle infinie, jamais de plantage.
fn noy_beta_lim(t: table, limite: entier) -> table {
  $cur = t
  $pas = 0
  $err = ""
  $cont = vrai
  tant_que ($cont) {
    si ($pas >= limite) {
      $test = noy_redex($cur)
      si (noy_change($test)) {
        $err = "depassement de la garde de pas (" + chaine(limite) + ")"
      }
      $cont = faux
    } sinon {
      $r = noy_redex($cur)
      si (noy_change($r)) {
        $cur = noy_resultat($r)
        $pas = $pas + 1
      } sinon {
        $cont = faux
      }
    }
  }
  $res = table()
  inserer($res, "terme", $cur)
  inserer($res, "pas", $pas)
  inserer($res, "erreur", $err)
  retour $res
}

fn beta(t: table) -> table {
  $r = noy_beta_lim(t, 10000)
  retour noy_champ($r, "terme")
}

# ────────────── 6. Alpha-équivalence (environnement de noms) ───────────────

# Indice (de Bruijn) du nom dans l'environnement, 0 = nom libre.
fn noy_index_env(env: liste<chaine>, s: chaine) -> entier {
  $n = longueur(env)
  $k = $n - 1
  tant_que ($k >= 1) {
    si (env[$k] == s) { retour $n - $k }
    $k = $k - 1
  }
  retour 0
}

fn noy_alpha_liste(a: liste<table>, b: liste<table>,
                   ea: liste<chaine>, eb: liste<chaine>) -> booleen {
  $na = longueur(a)
  $nb = longueur(b)
  si ($na != $nb) { retour faux }
  $k = 1
  tant_que ($k < $na) {
    si (non noy_alpha(a[$k], b[$k], $ea, $eb)) { retour faux }
    $k = $k + 1
  }
  retour vrai
}

# ea / eb : environnements de correspondance (listes de lieurs empilés).
fn noy_alpha(a: table, b: table,
             ea: liste<chaine>, eb: liste<chaine>) -> booleen {
  $ga = noy_genre(a)
  $gb = noy_genre(b)
  si ($ga != $gb) { retour faux }

  si ($ga == "var") {
    $ia = noy_index_env($ea, noy_nom(a))
    $ib = noy_index_env($eb, noy_nom(b))
    si ($ia > 0 ou $ib > 0) { retour $ia == $ib }
    retour noy_nom(a) == noy_nom(b)
  }
  si ($ga == "type") { retour noy_niveau(a) == noy_niveau(b) }
  si ($ga == "app") {
    si (non noy_alpha(noy_champ(a, "fonction"), noy_champ(b, "fonction"), $ea, $eb)) {
      retour faux
    }
    retour noy_alpha(noy_champ(a, "argument"), noy_champ(b, "argument"), $ea, $eb)
  }
  si ($ga == "pi" ou $ga == "lam") {
    si (non noy_alpha(noy_champ(a, "domaine"), noy_champ(b, "domaine"), $ea, $eb)) {
      retour faux
    }
    $nea = noy_copie_ch($ea)
    joindre($nea, noy_nom(a))
    $neb = noy_copie_ch($eb)
    joindre($neb, noy_nom(b))
    retour noy_alpha(noy_corps(a), noy_corps(b), $nea, $neb)
  }
  si ($ga == "const" ou $ga == "constructeur") {
    si (noy_nom(a) != noy_nom(b)) { retour faux }
    retour noy_alpha(noy_champ(a, "type"), noy_champ(b, "type"), $ea, $eb)
  }
  si ($ga == "ind") {
    si (noy_nom(a) != noy_nom(b)) { retour faux }
    retour noy_alpha_liste(noy_champ_liste(a, "params"),
                           noy_champ_liste(b, "params"), $ea, $eb)
  }
  si ($ga == "elim") {
    si (noy_nom(a) != noy_nom(b)) { retour faux }
    si (non noy_alpha(noy_champ(a, "motif"), noy_champ(b, "motif"), $ea, $eb)) {
      retour faux
    }
    retour noy_alpha_liste(noy_champ_liste(a, "branches"),
                           noy_champ_liste(b, "branches"), $ea, $eb)
  }
  si ($ga == "_absent") { retour vrai }
  retour faux
}

fn convertible(a: table, b: table) -> booleen {
  $ra = noy_beta_lim(a, 10000)
  $rb = noy_beta_lim(b, 10000)
  $ea = [""]
  $eb = [""]
  retour noy_alpha(noy_champ($ra, "terme"), noy_champ($rb, "terme"), $ea, $eb)
}

# ─────────────────────── 7. Contextes ──────────────────────────────────────

fn noy_ctx_vide() -> liste<table> {
  $c = [table()]
  retour $c
}

# Accepte liste<table> REMBOURRÉE ou table {nom: Terme}.
fn noy_normaliser_ctx(ctx) -> liste<table> {
  $r = [table()]
  si (type(ctx) == "liste") {
    $c = [table()]
    $c = ctx
    retour $c
  }
  si (type(ctx) == "table") {
    $tb = table()
    $tb = ctx
    $ks = cles($tb)
    $n = longueur($ks)
    $k = 0
    tant_que ($k < $n) {
      $key = ""
      $key = $ks[$k]
      $e = table()
      inserer($e, "nom", $key)
      $v = $tb[$key]
      inserer($e, "type", $v)
      joindre($r, $e)
      $k = $k + 1
    }
  }
  retour $r
}

# Nouveau contexte (non destructif) : la liaison ajoutée masque les précédentes.
fn noy_ctx_ajouter(ctx: liste<table>, n: chaine, ty: table) -> liste<table> {
  $r = [table()]
  $cnt = longueur(ctx)
  $k = 1
  tant_que ($k < $cnt) {
    joindre($r, ctx[$k])
    $k = $k + 1
  }
  $e = table()
  inserer($e, "nom", n)
  inserer($e, "type", ty)
  joindre($r, $e)
  retour $r
}

fn noy_ctx_type(ctx: liste<table>, n: chaine) -> table {
  $r = noy_absent()
  $cnt = longueur(ctx)
  $k = $cnt - 1
  tant_que ($k >= 1) {
    $e = ctx[$k]
    si (noy_nom($e) == n) {
      $r = noy_champ($e, "type")
      retour $r
    }
    $k = $k - 1
  }
  retour $r
}

# ──────────────────── 8. Synthèse de type (le vérificateur) ────────────────

fn noy_ok(ty: table, pas: entier) -> table {
  $r = table()
  inserer($r, "ok", vrai)
  inserer($r, "type", ty)
  inserer($r, "erreur", "")
  inserer($r, "pas", pas)
  retour $r
}

fn noy_err(msg: chaine, pas: entier) -> table {
  $r = table()
  inserer($r, "ok", faux)
  inserer($r, "type", noy_absent())
  inserer($r, "erreur", msg)
  inserer($r, "pas", pas)
  retour $r
}

fn noy_est_ok(r: table) -> booleen {
  $v = faux
  si (cle_existe(r, "ok")) {
    $x = r["ok"]
    si (type($x) == "booleen") { $v = $x }
  }
  retour $v
}

fn noy_erreur(r: table) -> chaine {
  $v = ""
  si (cle_existe(r, "erreur")) {
    $x = r["erreur"]
    si (type($x) == "chaine") { $v = $x }
  }
  retour $v
}

fn noy_type_res(r: table) -> table {
  retour noy_champ(r, "type")
}

fn noy_pas_res(r: table) -> entier {
  $v = 0
  si (cle_existe(r, "pas")) {
    $x = r["pas"]
    si (type($x) == "entier") { $v = $x }
  }
  retour $v
}

# Niveau d'un univers, -1 si le terme n'est pas un Type après beta.
fn noy_univers(t: table) -> entier {
  $r = noy_beta_lim(t, 1000)
  $u = noy_champ($r, "terme")
  $v = -1
  si (noy_genre($u) == "type") { $v = noy_niveau($u) }
  retour $v
}

fn noy_synth(t: table, ctx: liste<table>, limite: entier, pas0: entier) -> table {
  si (pas0 >= limite) {
    retour noy_err("depassement de la garde de pas (" + chaine(limite) + ")", pas0)
  }

  $g = noy_genre(t)

  si ($g == "var") {
    $ty = noy_ctx_type(ctx, noy_nom(t))
    si (noy_est_absent($ty)) {
      retour noy_err("variable non liee: " + noy_nom(t), pas0)
    }
    retour noy_ok($ty, pas0)
  }

  # Règle Type(n) : Type(n+1).
  si ($g == "type") {
    $n = noy_niveau(t)
    si ($n < 0) { retour noy_err("niveau de type negatif", pas0) }
    retour noy_ok(noy_type($n + 1), pas0)
  }

  # Règle Π.
  si ($g == "pi") {
    $r1 = noy_synth(noy_champ(t, "domaine"), ctx, limite, pas0)
    si (non noy_est_ok($r1)) { retour $r1 }
    $i = noy_univers(noy_type_res($r1))
    si ($i < 0) { retour noy_err("domaine de Pi non typé par un univers", noy_pas_res($r1)) }
    $ctx2 = noy_ctx_ajouter(ctx, noy_nom(t), noy_champ(t, "domaine"))
    $r2 = noy_synth(noy_champ(t, "codomaine"), $ctx2, limite, noy_pas_res($r1))
    si (non noy_est_ok($r2)) { retour $r2 }
    $j = noy_univers(noy_type_res($r2))
    si ($j < 0) { retour noy_err("codomaine de Pi non typé par un univers", noy_pas_res($r2)) }
    retour noy_ok(noy_type(max($i, $j)), noy_pas_res($r2))
  }

  # Règle λ : type = Π(nom, domaine, type_du_corps).
  si ($g == "lam") {
    $r1 = noy_synth(noy_champ(t, "domaine"), ctx, limite, pas0)
    si (non noy_est_ok($r1)) { retour $r1 }
    $i = noy_univers(noy_type_res($r1))
    si ($i < 0) { retour noy_err("domaine de Lambda non typé par un univers", noy_pas_res($r1)) }
    $ctx2 = noy_ctx_ajouter(ctx, noy_nom(t), noy_champ(t, "domaine"))
    $r2 = noy_synth(noy_champ(t, "corps"), $ctx2, limite, noy_pas_res($r1))
    si (non noy_est_ok($r2)) { retour $r2 }
    $ty = noy_pi(noy_nom(t), noy_champ(t, "domaine"), noy_type_res($r2))
    retour noy_ok($ty, noy_pas_res($r2))
  }

  # Règle App : fonction : Πx:A.B, argument : A  =>  B[argument/x].
  si ($g == "app") {
    $rf = noy_synth(noy_champ(t, "fonction"), ctx, limite, pas0)
    si (non noy_est_ok($rf)) { retour $rf }
    $pas1 = noy_pas_res($rf)
    $rb = noy_beta_lim(noy_type_res($rf), limite - $pas1)
    $pas2 = $pas1 + noy_pas_beta($rb)
    si (noy_erreur_beta($rb) != "") { retour noy_err(noy_erreur_beta($rb), $pas2) }
    $ft = noy_champ($rb, "terme")
    si (noy_genre($ft) != "pi") {
      retour noy_err("application d'un terme dont le type n'est pas un Pi", $pas2)
    }
    $ra = noy_synth(noy_champ(t, "argument"), ctx, limite, $pas2)
    si (non noy_est_ok($ra)) { retour $ra }
    $pas3 = noy_pas_res($ra)
    $dom = noy_champ($ft, "domaine")
    si (non convertible(noy_type_res($ra), $dom)) {
      retour noy_err("type de l'argument incompatible avec le domaine", $pas3)
    }
    $res = noy_subst(noy_champ($ft, "codomaine"), noy_nom($ft), noy_champ(t, "argument"))
    retour noy_ok($res, $pas3)
  }

  si ($g == "const" ou $g == "constructeur") {
    $ann = noy_champ(t, "type")
    $rt = noy_synth($ann, ctx, limite, pas0)
    si (non noy_est_ok($rt)) { retour $rt }
    $pas1 = noy_pas_res($rt)
    si (noy_univers(noy_type_res($rt)) < 0) {
      retour noy_err("annotation de type non bien formée", $pas1)
    }
    retour noy_ok($ann, $pas1)
  }

  # ind / elim : validation structurelle ; le type rendu est une approximation
  # documentée (Type(0)) —voir NOYAU.md, section « Limites ».
  si ($g == "ind") {
    $pl = noy_champ_liste(t, "params")
    $n = longueur($pl)
    $k = 1
    $pas = pas0
    tant_que ($k < $n) {
      $r = noy_synth($pl[$k], ctx, limite, $pas)
      si (non noy_est_ok($r)) { retour $r }
      $pas = noy_pas_res($r)
      $k = $k + 1
    }
    retour noy_ok(noy_type(0), $pas)
  }

  si ($g == "elim") {
    $rm = noy_synth(noy_champ(t, "motif"), ctx, limite, pas0)
    si (non noy_est_ok($rm)) { retour $rm }
    $pas = noy_pas_res($rm)
    $bl = noy_champ_liste(t, "branches")
    $n = longueur($bl)
    $k = 1
    tant_que ($k < $n) {
      $r = noy_synth($bl[$k], ctx, limite, $pas)
      si (non noy_est_ok($r)) { retour $r }
      $pas = noy_pas_res($r)
      $k = $k + 1
    }
    retour noy_ok(noy_type(0), $pas)
  }

  retour noy_err("genre de terme inconnu ou mal formé: " + $g, pas0)
}

# ────────────────────────── 9. Interface publique ──────────────────────────

fn verifier(t: table, ctx) -> table {
  $c = noy_normaliser_ctx(ctx)
  $r = noy_synth(t, $c, 10000, 0)
  $res = table()
  inserer($res, "ok", noy_est_ok($r))
  inserer($res, "type", noy_type_res($r))
  inserer($res, "erreur", noy_erreur($r))
  retour $res
}

fn bien_forme(t: table, ctx) -> booleen {
  $g = noy_genre(t)
  $connu = faux
  si ($g == "var" ou $g == "type" ou $g == "pi" ou $g == "lam" ou
      $g == "app" ou $g == "const" ou $g == "ind" ou
      $g == "constructeur" ou $g == "elim") { $connu = vrai }
  si (non $connu) { retour faux }
  $r = verifier(t, ctx)
  retour noy_est_ok($r)
}
