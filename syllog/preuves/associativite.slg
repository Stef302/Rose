# Syllog — preuve de démonstration : associativité de l'addition
# Statut : VÉRIFIÉE PAR LE NOYAU PROV1.
#   Terme produit : nat_rec P base pas avec
#     P = λm, pour_tout n, pour_tout p, (m+n)+p = m+(n+p)
#     base = λn. λp. trans (congr_plus_l (plus 0 n) n p (plus_0_l n))
#                          (symm (plus_0_l (plus n p)))
#     pas  = λk. λih. λn. λp. trans (trans (trans
#              (congr_plus_l (plus (succ k) n) (succ (plus k n)) p (plus_s_l k n))
#              (plus_s_l (plus k n) p))
#              (congr_succ (ih n p)))
#              (symm (plus_s_l k (plus n p)))
#   Contrôle : demo_associativite() construit le terme, appele induction_resolue()
#              puis verifier + convertible dans le contexte vide.
#   Preuve de sortie : ./rose/rose syllog/tests_tactiques.rose -> OK demo/associativite
#   Limite : plus_0_l et plus_s_l sont des axiomes de signature (equations de
#            reduction), voir docs/TACTIQUES.md. Les lemmes symm/trans/congr_* sont
#            des termes DERIVES et verifies, pas des axiomes.

théorème associativite_plus :
  pour_tout m : Nat, pour_tout n : Nat, pour_tout p : Nat,
    (m + n) + p = m + (n + p)
preuve
  induction m
  cas zero :
    introduction n
    introduction p
    appliquer trans (congr_plus_l (plus 0 n) n p (plus_0_l n))
                    (symm (plus_0_l (plus n p)))
  cas succ k ih :
    introduction n
    introduction p
    appliquer trans
      (trans (trans
        (congr_plus_l (plus (succ k) n) (succ (plus k n)) p (plus_s_l k n))
        (plus_s_l (plus k n) p))
        (congr_succ (ih n p)))
      (symm (plus_s_l k (plus n p)))
fin
