# publier-release.rose — automatisateur de release Rose, ÉCRIT EN ROSE.
#
# Équivalent Rose de scripts/publier-release.py (REL1) : les dix étapes sont
# pilotées depuis Rose via la FFI vers libc system(). Auto-hébergement jusqu'à
# l'outil de publication.
#
# LIMITE FFI MESURÉE (détails : rose/docs/PUBLICATION_ROSE.md) :
#   system(char*) rend un int. Le moteur Rose n'accepte PAS un argument
#   chaîne pour une fonction FFI à retour entier (il tente une conversion
#   chaîne→entier et échoue). La seule déclaration qui transmet correctement
#   la chaîne est un retour « flottant ». La valeur flottante rendue n'est
#   PAS utilisée : le vrai code de retour et la sortie sont capturés par le
#   shell dans deux fichiers, puis lus avec lire_texte().
#   `@dll("c")` est requis (lib<c>.so, c.so, libc.so.6…).
#
# SÉCURITÉ : le jeton n'est JAMAIS interpolé dans une chaîne affichée ni
# transmis en argument : les commandes distantes le relisent dans le fichier
# au moment de l'exécution via $(cat …).
#
# Usage (depuis la racine du dépôt) :
#   ./rose/rose scripts/publier-release.rose <version> "<titre>" <notes> \
#       [--dry-run] [--no-build] [--force]
# --dry-run : aucun appel réseau, aucune écriture, aucun build, aucun commit.

# ── Pont FFI ─────────────────────────────────────────────────────────────
@dll("c")
@sym("system")
fn sh(cmd: chaine) -> flottant

@dll("c")
@sym("getenv")
fn env(nom: chaine) -> chaine

# ── Constantes ───────────────────────────────────────────────────────────
$TMP = "/tmp/opencode/rose-release-ffi"
$LOGPLEIN = $TMP + "/journal-complet.txt"
$LOG = $TMP + "/journal.txt"
$RC = $TMP + "/rc.txt"
$DRAPEAU = $TMP + "/drapeau.txt"
$USERJSON = $TMP + "/user.json"

$HOME = env("HOME")
$TOKEN_PATH = $HOME + "/.config/opencode/.gh_token"
$LOGIN_ATTENDU = "Stef302"
$DEPOT = "Stef302/Rose"

# ── Affichage ────────────────────────────────────────────────────────────
fn etape(num: entier, texte: chaine) {
    afficher("")
    afficher("=== Étape " + chaine(num) + "/10 : " + texte + " ===")
}

fn ok(msg: chaine) {
    afficher("  ✓ " + msg)
}

fn info(msg: chaine) {
    afficher("    " + msg)
}

fn simuler(cmd: chaine) {
    afficher("    [SIMULÉ] " + cmd)
}

fn abort(msg: chaine) {
    afficher("")
    afficher("ÉCHEC : " + msg)
    afficher("Aucune publication n'a été effectuée par cette étape.")
    quitter(1)
}

# Exécuter une commande via system(). Le shell capture le code de retour
# dans $RC et les 25 dernières lignes de sortie dans $LOG ; le journal complet
# reste dans $LOGPLEIN. Retourne vrai si rc==0.
fn executer(cmd: chaine, dry: booleen) -> booleen {
    si (dry == vrai) {
        simuler(cmd)
        retour vrai
    }
    afficher("    $ " + cmd)
    $ignore = sh("{ " + cmd + " ; } > " + $LOGPLEIN + " 2>&1 ; printf %s $? > " + $RC + " ; tail -n 25 " + $LOGPLEIN + " > " + $LOG)
    $rc = lire_texte($RC)
    $sortie = lire_texte($LOG)
    si (longueur($sortie) > 0) { afficher($sortie) }
    si ($rc != "0") {
        afficher("  ✗ échec (rc=" + $rc + ") — journal complet : " + $LOGPLEIN)
        retour faux
    }
    ok("rc=0 : " + cmd)
    retour vrai
}

# Exécuter sans afficher, retourner la sortie capturée (ou "ERREUR rc=…").
fn capter(cmd: chaine) -> chaine {
    $ignore = sh("{ " + cmd + " ; } > " + $LOG + " 2>&1 ; printf %s $? > " + $RC)
    $rc = lire_texte($RC)
    si ($rc != "0") { retour "ERREUR_rc_" + $rc }
    retour lire_texte($LOG)
}

# ── Étape 1 : compte GitHub ──────────────────────────────────────────────
fn verifier_compte(dry: booleen) -> booleen {
    etape(1, "vérification du compte GitHub")
    $jeton = lire_texte($TOKEN_PATH)
    si (longueur($jeton) == 0) { abort("jeton vide : " + $TOKEN_PATH) }
    ok("jeton lu dans " + $TOKEN_PATH + " (jamais affiché)")

    $curl = "curl -sS --max-time 20 -H \"Authorization: Bearer $(cat " + $TOKEN_PATH + ")\" -H \"Accept: application/vnd.github+json\" -H \"User-Agent: rose-publier-release\" https://api.github.com/user"
    si (dry == vrai) {
        simuler($curl + " > <capture> ; grep login == " + $LOGIN_ATTENDU)
        info("dry-run : aucun appel réseau (contrairement au dry-run Python)")
    } sinon {
        $ignore = sh("{ " + $curl + " ; } > " + $USERJSON + " 2>&1 ; printf %s $? > " + $RC + " ; grep -q '\"login\"[[:space:]]*:[[:space:]]*\"" + $LOGIN_ATTENDU + "\"' " + $USERJSON + " && printf %s OK > " + $DRAPEAU + " || printf %s REFUSE > " + $DRAPEAU)
        si (lire_texte($DRAPEAU) != "OK") {
            abort("compte GitHub refusé ou appel /user impossible : seul " + $LOGIN_ATTENDU + " est autorisé (jeton non affiché)")
        }
        ok("compte vérifié : " + $LOGIN_ATTENDU + " (sortie curl capturée, jeton non affiché)")
    }
    retour vrai
}

# ── Étape 2 : validation de version ──────────────────────────────────────
fn valider_version(brut: chaine) -> booleen {
    $n = longueur(brut)
    si ($n < 5 ou $n > 9) { retour faux }
    $points = 0
    $bon = vrai
    pour k de 0 vers $n {
        $c = sous_chaine(brut, k, k + 1)
        si ($c == ".") {
            $points = $points + 1
        } sinon {
            $o = ordre($c)
            si ($o < 48 ou $o > 57) { $bon = faux }
        }
    }
    si ($points != 2) { $bon = faux }
    retour $bon
}

# ── Commandes construites ────────────────────────────────────────────────
# Préfixe Python : importe le module REL1 existant (non modifié) et réutilise
# sa logique de fichiers au lieu de la recopier en Rose.
$PY = "import sys,datetime as dt,importlib.util; s=importlib.util.spec_from_file_location(\"pub\",\"scripts/publier-release.py\"); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); r=m.Rapport(False); "

fn cmd_version(version: chaine, notes: chaine) -> chaine {
    retour "python3 -c '" + $PY + "v=m.valider_version(sys.argv[1],r); a=m.version_courante(); n=m.lire_notes(sys.argv[2]); m.maj_cargo(a,v,r,False); m.maj_marqueurs(a,v,r,False)' \"" + version + "\" \"" + notes + "\""
}

fn cmd_site(version: chaine, titre: chaine, notes: chaine) -> chaine {
    retour "python3 -c '" + $PY + "v=m.valider_version(sys.argv[1],r); m.copier_artefacts(v,r,False); n=m.lire_notes(sys.argv[2]); man=m.regenerer_manifeste(v,sys.argv[3],n,dt.date.today(),r,False); m.maj_html(v,sys.argv[3],n,dt.date.today(),man,r,False)' \"" + version + "\" \"" + notes + "\" \"" + titre + "\""
}

fn liste_assets(version: chaine) -> chaine {
    retour "docs/telechargements/Rose-" + version + "-full.nupkg docs/telechargements/releases.win.json docs/telechargements/Rose-win-Setup.exe docs/telechargements/rose.exe docs/telechargements/rose-shell.exe docs/telechargements/rose-wasm.wasm"
}

# ── Analyse des arguments ────────────────────────────────────────────────
$dry = faux
$no_build = faux
$force = faux
$version = ""
$titre = ""
$notes = ""
$nbpos = 0

pour k de 0 vers nb_arguments() {
    $a = argument(k)
    si ($a == "--dry-run") {
        $dry = vrai
    } sinon {
        si ($a == "--no-build") {
            $no_build = vrai
        } sinon {
            si ($a == "--force") {
                $force = vrai
            } sinon {
                si ($nbpos == 0) { $version = $a }
                sinon {
                    si ($nbpos == 1) { $titre = $a } sinon { $notes = $a }
                }
                $nbpos = $nbpos + 1
            }
        }
    }
}

si ($nbpos < 3) {
    afficher("Usage : ./rose/rose scripts/publier-release.rose <version> \"<titre>\" <notes> [--dry-run] [--no-build] [--force]")
    quitter(2)
}

si ($dry == vrai) {
    afficher("╔═══════════════════════════════════════════════════════════╗")
    afficher("║  DRY-RUN — aucune écriture, aucun build, aucune publication ║")
    afficher("╚═══════════════════════════════════════════════════════════╝")
}

# Dossier de travail FFI (écriture locale, uniquement en mode réel).
si ($dry == faux) {
    $ignore = sh("mkdir -p " + $TMP + " > /dev/null 2>&1 ; printf %s 0 > " + $RC)
}

# ── Étape 1 ──────────────────────────────────────────────────────────────
verifier_compte($dry)

# ── Étape 2 ──────────────────────────────────────────────────────────────
etape(2, "validation du format de version")
si (valider_version($version) == faux) {
    abort("version " + $version + " invalide : attendu x.y.z ou x.y.zz")
}
ok("version validée : " + $version)
$contenu_notes = lire_texte($notes)
si (longueur($contenu_notes) == 0) { abort("fichier de notes vide : " + $notes) }
ok("notes lues : " + $notes)

# ── Étapes 3-4 ───────────────────────────────────────────────────────────
etape(3, "mise à jour de Cargo.toml / Cargo.lock + marqueurs")
si (executer(cmd_version($version, $notes), $dry) == faux) {
    abort("échec de la mise à jour des versions (étapes 3-4)")
}

# ── Étape 5 ──────────────────────────────────────────────────────────────
etape(5, "construction des artefacts")
si ($no_build == vrai) {
    info("--no-build : construction sautée")
} sinon {
    si (executer("sh scripts/build-windows-rebuild.sh", $dry) == faux) {
        abort("échec du build Windows")
    }
    si (executer("sh installateur/velopack/pack-linux.sh " + $version, $dry) == faux) {
        abort("échec du paquet Velopack Linux")
    }
    si (executer("CARGO_TARGET_DIR=rose/target cargo build --release --target wasm32-unknown-unknown --lib --manifest-path rose/Cargo.toml", $dry) == faux) {
        abort("échec du build wasm")
    }
}

# ── Étapes 6-8 ───────────────────────────────────────────────────────────
etape(6, "copie des artefacts, SHA256SUMS, manifeste, CHANGELOG/RELEASES")
si (executer(cmd_site($version, $titre, $notes), $dry) == faux) {
    abort("échec de la génération du site (étapes 6-8)")
}

# ── Étape 9 ──────────────────────────────────────────────────────────────
etape(9, "commit et push sur main")
$cmdbranche = "git rev-parse --abbrev-ref HEAD | tr -d '\\n'"
si ($dry == vrai) {
    simuler($cmdbranche + " ; vérification branche == main")
    simuler("git add -- <fichiers de la release>")
    simuler("git commit -m \"chore(release): publier v" + $version + "\"")
    simuler("git push origin main")
} sinon {
    $branche = capter($cmdbranche)
    si ($branche != "main") { abort("branche " + $branche + " : la publication exige 'main'") }
    ok("branche : main")
    $fichiers = "rose/Cargo.toml rose/Cargo.lock README.md docs/index.html wikimiroir/Home.md wikimiroir/CLI.md docs/telechargements/VERSION docs/telechargements/SHA256SUMS docs/telechargements/releases.json " + liste_assets($version)
    si (executer("git add -- " + $fichiers, $dry) == faux) { abort("échec git add") }
    si (executer("git commit -m \"chore(release): publier v" + $version + "\"", $dry) == faux) { abort("échec git commit") }
    si (executer("git push origin main", $dry) == faux) { abort("échec git push") }
}

# ── Étape 10 ─────────────────────────────────────────────────────────────
etape(10, "création et vérification de la release GitHub")
$pre = "GH_TOKEN=$(cat " + $TOKEN_PATH + ")"
$gh_create = $pre + " gh release create v" + $version + " --title \"" + $titre + "\" --notes-file \"" + $notes + "\" " + liste_assets($version)
$gh_delete = $pre + " gh release delete v" + $version + " --yes"
$gh_view = $pre + " gh release view v" + $version + " --json assets --jq '.assets|length' | tr -d '\\n'"
$gh_down = $pre + " gh release download v" + $version + " --pattern 'Rose-" + $version + "-full.nupkg' --dir " + $TMP + " --clobber && sha256sum docs/telechargements/Rose-" + $version + "-full.nupkg " + $TMP + "/Rose-" + $version + "-full.nupkg | awk '{print $1}' | sort -u | wc -l | tr -d ' '"

si ($dry == vrai) {
    si ($force == vrai) { simuler($gh_delete + "  (--force)") }
    simuler($gh_create)
    simuler($gh_view)
    simuler($gh_down + "  (doit rendre 1)")
    info("vérification API : tag présent, nombre d'assets, SHA-256 du nupkg téléchargé")
} sinon {
    si ($force == vrai) {
        si (executer($gh_delete, $dry) == faux) { info("--force : release absente ou suppression impossible, création tentée") }
    }
    si (executer($gh_create, $dry) == faux) { abort("échec gh release create") }
    $nbassets = capter($gh_view)
    si ($nbassets != "6") { abort("vérification API : " + $nbassets + " assets au lieu de 6") }
    ok("API : tag v" + $version + " présent, 6 assets")
    $unicite = capter($gh_down)
    si ($unicite != "1") { abort("SHA-256 du nupkg téléchargé différent du local") }
    ok("SHA-256 du nupkg téléchargé == local")
}

# ── Rapport final ────────────────────────────────────────────────────────
afficher("")
si ($dry == vrai) {
    afficher("╔═══════════════════════════════════════════════════════════╗")
    afficher("║  RAPPORT DRY-RUN — simulation terminée (10 étapes)        ║")
    afficher("╚═══════════════════════════════════════════════════════════╝")
    afficher("Aucun fichier du dépôt modifié, aucun build, aucun commit, aucune release.")
} sinon {
    afficher("╔═══════════════════════════════════════════════════════════╗")
    afficher("║  PUBLICATION TERMINÉE — v" + $version + "                       ║")
    afficher("╚═══════════════════════════════════════════════════════════╝")
}
