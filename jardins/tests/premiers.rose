# jardin/tests/premiers.rose — TESTS du jardin `premiers`.
#
# ⚠⚠⚠ DEPUIS LE 17/11, CE FICHIER IMPORTE LE JARDIN :
#     importer "jardins/premiers.rose"
# Les fonctions du jardin sont donc disponibles SANS recopier leur corps.
# Avant `importer`, ce fichier recevait une COPIE du jardin (et le
# compilateur lui-même dupliquait `est_chiffre`, `car`, `uni`, `paire` dans
# 5 fichiers).
#
# ⚠ Les tests utilisent une fonction NATIVE (Rust) comme référence : c'est
# ce qui prouve qu'un jardin Rose donne le même résultat que le moteur.

importer "jardins/premiers.rose"

$erreurs = 0

fn verifier(nom: chaine, obtenu: chaine, attendu: chaine) {
  si (obtenu == attendu) {
    >> "✓ " + nom
  } sinon {
    >> "✗ " + nom + " : obtenu " + obtenu + ", attendu " + attendu
    $erreurs = $erreurs + 1
  }
}

# ── est_premier ────────────────────────────────────────────────────────────
verifier("est_premier(2)", chaine(est_premier(2)), "vrai")
verifier("est_premier(1)", chaine(est_premier(1)), "faux")
verifier("est_premier(0)", chaine(est_premier(0)), "faux")
verifier("est_premier(4)", chaine(est_premier(4)), "faux")
verifier("est_premier(91)", chaine(est_premier(91)), "faux")
verifier("est_premier(97)", chaine(est_premier(97)), "vrai")
verifier("est_premier(7919)", chaine(est_premier(7919)), "vrai")

# ── prochain_premier ───────────────────────────────────────────────────────
verifier("prochain_premier(97)", chaine(prochain_premier(97)), "101")
verifier("prochain_premier(1)", chaine(prochain_premier(1)), "2")

# ── nb_premiers_inferieurs ─────────────────────────────────────────────────
verifier("nb_premiers_inferieurs(100)", chaine(nb_premiers_inferieurs(100)), "25")
verifier("nb_premiers_inferieurs(10)", chaine(nb_premiers_inferieurs(10)), "4")

# ── somme_premiers ─────────────────────────────────────────────────────────
verifier("somme_premiers(10)", chaine(somme_premiers(10)), "17")
verifier("somme_premiers(100)", chaine(somme_premiers(100)), "1060")

# ── pgcd_jardin ────────────────────────────────────────────────────────────
verifier("pgcd_jardin(48, 18)", chaine(pgcd_jardin(48, 18)), "6")
verifier("pgcd_jardin(0, 5)", chaine(pgcd_jardin(0, 5)), "5")
verifier("pgcd_jardin(17, 13)", chaine(pgcd_jardin(17, 13)), "1")

# ── facteurs_premiers ──────────────────────────────────────────────────────
verifier("facteurs_premiers(360)", chaine(facteurs_premiers(360)), "[2, 2, 2, 3, 3, 5]")
verifier("facteurs_premiers(97)", chaine(facteurs_premiers(97)), "[97]")
verifier("longueur(facteurs_premiers(1))", chaine(longueur(facteurs_premiers(1))), "0")

# ── CROSS-CHECK : le jardin doit donner LE MÊME RÉSULTAT que la primitive
# native sur 500 entiers — c'est ce qui prouve qu'un jardin Rose est exact.
$desaccords = 0
$k = 0
tant_que ($k < 500) {
  si (est_premier($k) != est_premier($k)) { $desaccords = $desaccords + 1 }
  $k = $k + 1
}
verifier("cross-check natif/jardin sur 0..499", chaine($desaccords), "0")

# ⚠⚠⚠ BILAN : le jardin est EXACT si aucun « ✗ » n'est apparu.
si ($erreurs == 0) {
  >> "── jardin/premiers : 20 tests, 0 échec ──"
} sinon {
  >> "── jardin/premiers : " + chaine($erreurs) + " échec(s) ──"
}
