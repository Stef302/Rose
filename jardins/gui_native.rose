# jardins/gui_native.rose — interface graphique native, ÉCRITE EN ROSE PUR.
#
# ⚠ CE JARDIN EST LA SOURCE DE VÉRITÉ DE L'INTERFACE. Le moteur ne fournit
# que 5 primitives d'appel système (fenetre_native, fenetre_afficher,
# fenetre_attendre, fenetre_fermer, message_native) — exactement comme
# `lire_texte`/`ecrire_texte` pour les fichiers. Aucun widget, aucune mise
# en page, aucun événement n'est hors de ce jardin : tout est Rose.
#
# Pourquoi un pontier est inévitable: Rose n'a aucune primitive `system`/exec.
# Créer une vraie fenêtre exige un appel à l'API du système d'exploitation.
# Le jardin possède l'interface; le moteur ne fournit que l'appel OS.
#
# Aucun navigateur, aucun HTML, aucun interpreteur externe, aucune bibliothèque
# supplémentaire. Sans affichage, le pontier renvoie une erreur explicite
# (jamais une fenêtre simulée). `decrire(f)` permet de tester toute la logique
# du jardin sans écran.
#
# ── DEUX CHEMINS, LE ROSE EN PRIORITÉ ───────────────────────────────────────
# `generer_*` ci-dessous utilisent `jardins/os_natif.rose` : le code machine
# des syscalls est produit par Rose, SANS primitive GUI dans le moteur.
# `ouvrir`/`attendre`/`dire`/`fermer` sont les anciens raccourcis qui appellent
# encore les primitives du moteur — conservés pour compatibilité, mais le
# chemin Rose pur est désormais `generer_fenetre` + lancement de l'ELF.

importer "jardins/os_natif.rose"

# ── modèle de données ────────────────────────────────────────────────────────
# Une fenêtre est une table Rose: titre, largeur, hauteur, widgets (sous une
# clé numérique "0","1",...), actions (même principe), compteurs.
# Chaque widget est une table de chaînes (contrainte du vérificateur Rose:
# une valeur lue dans une table a le type `?`, on la convertit avec chaine()).

fn _cle(n: entier) -> chaine {
    retour chaine(n)
}

fn _widget(type: chaine, label: chaine, valeur: chaine,
           x: entier, y: entier, largeur: entier) -> table {
    $w = table()
    inserer($w, "type", type)
    inserer($w, "label", label)
    inserer($w, "valeur", valeur)
    inserer($w, "x", chaine(x))
    inserer($w, "y", chaine(y))
    inserer($w, "largeur", chaine(largeur))
    retour $w
}

# ── construction ─────────────────────────────────────────────────────────────

fn fenetre(titre: chaine, largeur: entier, hauteur: entier) -> table {
    $f = table()
    inserer($f, "titre", titre)
    inserer($f, "largeur", chaine(largeur))
    inserer($f, "hauteur", chaine(hauteur))
    inserer($f, "widgets", table())
    inserer($f, "actions", table())
    inserer($f, "nwidgets", "0")
    inserer($f, "nactions", "0")
    retour $f
}

fn bouton(label: chaine, largeur: entier) -> table {
    retour _widget("bouton", label, "", 0, 0, largeur)
}

fn champ(label: chaine, valeur: chaine) -> table {
    retour _widget("champ", label, valeur, 0, 0, 160)
}

fn etiquette(texte: chaine) -> table {
    retour _widget("etiquette", texte, "", 0, 0, 0)
}

fn case_a_cocher(coche: booleen, texte: chaine) -> table {
    $v = "0"
    si (coche) { $v = "1" }
    retour _widget("case", texte, $v, 0, 0, 0)
}

fn liste_deroulante(choix: liste<chaine>, selection: entier) -> table {
    $w = _widget("liste", "", "", 0, 0, 160)
    inserer($w, "choix", choix)
    inserer($w, "selection", chaine(selection))
    retour $w
}

# ── placement et événements ──────────────────────────────────────────────────

fn ajouter(f: table, w: table, x: entier, y: entier) -> table {
    inserer($w, "x", chaine(x))
    inserer($w, "y", chaine(y))
    $n = entier(chaine(f["nwidgets"]))
    inserer(f["widgets"], _cle($n), $w)
    inserer($f, "nwidgets", chaine($n + 1))
    retour $f
}

fn lier_evenement(f: table, nom: chaine, genre: chaine,
                  cible: chaine, action: chaine) -> table {
    $a = table()
    inserer($a, "nom", nom)
    inserer($a, "genre", genre)
    inserer($a, "cible", cible)
    inserer($a, "action", action)
    $n = entier(chaine(f["nactions"]))
    inserer(f["actions"], _cle($n), $a)
    inserer($f, "nactions", chaine($n + 1))
    retour $f
}

fn evenement(f: table, nom: chaine) -> table {
    $r = table()
    $n = entier(chaine(f["nactions"]))
    $i = 0
    tant_que ($i < $n) {
        $a = f["actions"][_cle($i)]
        si (chaine($a["nom"]) == nom) { inserer($r, _cle(longueur($r)), $a) }
        $i = $i + 1
    }
    retour $r
}

fn compter_widgets(f: table) -> entier {
    retour entier(chaine(f["nwidgets"]))
}

fn compter_actions(f: table) -> entier {
    retour entier(chaine(f["nactions"]))
}

# ── mises en page (toute en Rose) ────────────────────────────────────

fn grille(f: table, colonnes: entier, largeur_case: entier,
          hauteur_case: entier) -> table {
    $n = compter_widgets($f)
    $i = 0
    tant_que ($i < $n) {
        $w = f["widgets"][_cle($i)]
        inserer($w, "x", chaine(($i % $colonnes) * $largeur_case))
        inserer($w, "y", chaine(($i div $colonnes) * $hauteur_case))
        $i = $i + 1
    }
    retour $f
}

fn empiler(f: table, ecart: entier) -> table {
    $n = compter_widgets($f)
    $i = 0
    $y = 0
    tant_que ($i < $n) {
        $w = f["widgets"][_cle($i)]
        inserer($w, "x", "0")
        inserer($w, "y", chaine($y))
        $y = $y + $ecart
        $i = $i + 1
    }
    retour $f
}

fn cadrer(f: table, marge: entier) -> table {
    $n = compter_widgets($f)
    $i = 0
    tant_que ($i < $n) {
        $w = f["widgets"][_cle($i)]
        inserer($w, "x", chaine(entier(chaine($w["x"])) + $marge))
        inserer($w, "y", chaine(entier(chaine($w["y"])) + $marge))
        $i = $i + 1
    }
    retour $f
}

# ── description déterministe (testable sans écran) ───────────────────────────

fn decrire(f: table) -> chaine {
    $s = "FENETRE|" + chaine(f["titre"]) + "|" + chaine(f["largeur"])
       + "|" + chaine(f["hauteur"]) + "|widgets="
       + chaine(compter_widgets($f)) + "|actions="
       + chaine(compter_actions($f)) + "\n"
    $n = compter_widgets($f)
    $i = 0
    tant_que ($i < $n) {
        $w = f["widgets"][_cle($i)]
        $s = $s + "W|" + chaine($w["type"]) + "|" + chaine($w["label"])
          + "|" + chaine($w["x"]) + "|" + chaine($w["y"]) + "\n"
        $i = $i + 1
    }
    retour $s
}

# ── vraie fenêtre OS : on ne délègue QUE l'appel système ─────────────────────

fn ouvrir(f: table) -> entier {
    $p = fenetre_native(chaine(f["titre"]),
                        entier(chaine(f["largeur"])),
                        entier(chaine(f["hauteur"])))
    fenetre_afficher($p)
    retour $p
}

fn attendre(f: table, p: entier) {
    fenetre_attendre($p)
    fenetre_fermer($p)
}

fn fermer(p: entier) {
    fenetre_fermer($p)
}

fn dire(titre: chaine, texte: chaine) {
    message_native(titre, texte)
}

# ── chemin ROSE PUR : on génère l'ELF du syscall, aucune primitive GUI ──────

fn generer_fenetre(f: table, chemin: chaine, attente_ms: entier) -> chaine {
    $elf = ouvrir_fenetre(chaine(f["titre"]), entier(chaine(f["largeur"])),
                          entier(chaine(f["hauteur"])), attente_ms)
    ecrire_bytes($chemin, $elf)
    retour $chemin
}

fn generer_message(titre: chaine, texte: chaine, chemin: chaine) -> chaine {
    ecrire_bytes($chemin, boite_message(titre, texte))
    retour $chemin
}

fn generer_ecran(texte: chaine, chemin: chaine) -> chaine {
    ecrire_bytes($chemin, ecrire_ecran(texte))
    retour $chemin
}

# ── GUI1 — fenêtre « grands nombres », logique 100 % Rose ────────────────────
# Aucun navigateur, aucun langage externe, aucun libellé dans le moteur :
# le jardin décide du texte du bouton, des pas proposés, de l'exclusivité
# du groupe et du comptage. Le Rust (gui_native.rs) ne reçoit que des
# identifiants et des géométries via `geometrie_boutons()`. La production
# des chiffres eux-mêmes appartient à VAL1 (`Valeur::Symbolique` avec
# `demander_plus`), pas à ce jardin.

fn champ_lecture_seule(label: chaine, valeur: chaine) -> table {
    $w = champ(label, valeur)
    inserer($w, "lecture_seule", "1")
    retour $w
}

fn _pas_depuis_chaine(s: chaine) -> entier {
    si (s == "10") { retour 10 }
    si (s == "30") { retour 30 }
    si (s == "100") { retour 100 }
    si (s == "1000") { retour 1000 }
    retour 0
}

fn choisir_pas(f: table, n: entier) -> table {
    $nw = compter_widgets($f)
    $i = 0
    $choisi = chaine(n)
    tant_que ($i < $nw) {
        $w = f["widgets"][_cle($i)]
        si (chaine($w["type"]) == "case") {
            $v = "0"
            si (chaine($w["label"]) == $choisi) { $v = "1" }
            inserer($w, "valeur", $v)
        }
        $i = $i + 1
    }
    inserer($f, "pas", $choisi)
    retour $f
}

fn pas_selectionne(f: table) -> entier {
    retour _pas_depuis_chaine(chaine(f["pas"]))
}

fn grand_nombre_fenetre(expression: chaine) -> table {
    $f = fenetre("Grands nombres : " + expression, 520, 240)
    inserer($f, "expression", expression)
    inserer($f, "chiffres", "")
    inserer($f, "pas", "30")
    inserer($f, "clics", "0")

    ajouter($f, champ_lecture_seule("chiffres", ""), 12, 16)
    $btn = bouton("Plus de chiffres", 160)
    inserer($btn, "hauteur", "28")
    ajouter($f, $btn, 12, 56)
    ajouter($f, case_a_cocher(vrai, "10"), 12, 96)
    ajouter($f, case_a_cocher(faux, "30"), 72, 96)
    ajouter($f, case_a_cocher(faux, "100"), 132, 96)
    ajouter($f, case_a_cocher(faux, "1000"), 200, 96)

    lier_evenement($f, "plus", "clic", "chiffres", "plus_de_chiffres")
    retour choisir_pas($f, 30)
}

fn fixer_chiffres(f: table, nouveaux: chaine) -> table {
    inserer($f, "chiffres", nouveaux)
    $w = f["widgets"][_cle(0)]
    inserer($w, "valeur", nouveaux)
    retour $f
}

# `nouveaux` est la chaîne cumulée rendue par VAL1 (demander_plus). Le jardin
# ne sait pas la calculer : il met à jour le champ et le compteur, c'est tout.
fn clic_plus(f: table, nouveaux: chaine) -> table {
    $n = entier(chaine(f["clics"])) + pas_selectionne($f)
    inserer($f, "clics", chaine($n))
    retour fixer_chiffres($f, nouveaux)
}

# Description déterministe, testable sans écran : elle étend `decrire` sans
# modifier son format historique (les lignes FENETRE| et W| restent intactes).
fn decrire_grand_nombre(f: table) -> chaine {
    $a = evenement(f, "plus")
    $na = longueur($a)
    $action = ""
    si ($na > 0) { $action = chaine($a[_cle(0)]["action"]) }
    $w = f["widgets"][_cle(0)]
    retour decrire(f)
       + "EXPRESSION|" + chaine(f["expression"]) + "\n"
       + "CHIFFRES|" + chaine(f["chiffres"]) + "\n"
       + "PAS|" + chaine(f["pas"]) + "\n"
       + "CLICS|" + chaine(f["clics"]) + "\n"
       + "LECTURE_SEULE|" + chaine($w["lecture_seule"]) + "\n"
       + "VALEUR_CHAMP|" + chaine($w["valeur"]) + "\n"
       + "ACTION_PLUS|" + chaine($na) + "|" + $action + "\n"
}

# Ce que le pont OS doit recevoir : une ligne par bouton, avec un identifiant
# numérique, un libellé et une géométrie. Aucun libellé n'est écrit en Rust.
fn geometrie_boutons(f: table) -> chaine {
    $s = ""
    $nw = compter_widgets($f)
    $i = 0
    $bid = 1
    tant_que ($i < $nw) {
        $w = f["widgets"][_cle($i)]
        si (chaine($w["type"]) == "bouton") {
            $s = $s + "B|" + chaine($bid) + "|" + chaine($w["label"]) + "|"
               + chaine($w["x"]) + "|" + chaine($w["y"]) + "|"
               + chaine($w["largeur"]) + "|" + chaine($w["hauteur"]) + "\n"
            $bid = $bid + 1
        }
        $i = $i + 1
    }
    retour $s
}
