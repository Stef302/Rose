# ALTERNATIVE — PGCD par divisions euclidiennes successives au lieu de Stein (soustractions/décalages)
$a = 0
$b = 0
pour i de 1 vers 101 {
    $a = $a * 10000000000 + 1234567890
    $b = $b * 10000000000 + 9876543210
}
$d = temps()
tant_que ($b != 0) {
    $r = $a % $b
    $a = $b
    $b = $r
}
$f = temps()
>> "RESULT:" + chaine($a)
>> "INTERNAL_NS:" + chaine($f - $d)
