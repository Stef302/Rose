# Contrôle : la MÊME boucle Rose SANS appel de racine (soustraction du coût
# d'interprétation). $1 = N (défaut 200000).
$N = 200000
si (nb_arguments() > 0) { $N = entier(argument(0)) }
$m0 = millisecondes()
$s = 0
pour $i de 0 vers $N {
    $k = 1000003 + $i
    $s = $s + $k
}
$m1 = millisecondes()
>> $s
>> $m1 - $m0
