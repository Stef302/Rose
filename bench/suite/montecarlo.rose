# Benchmark : estimation de π par méthode de Monte Carlo
# Mesure : qualité du RNG + opérations flottantes + calculs de distance
# Syntaxe Rose valide

$N = 1000000
si (nb_arguments() > 0) { $N = entier(argument(0)) }

graine(2026)
$m0 = millisecondes()
$inside = 0
pour $i de 0 vers $N {
    $x = hasard(1000000) / 1000000.0
    $y = hasard(1000000) / 1000000.0
    $d2 = $x * $x + $y * $y
    si ($d2 <= 1.0) {
        $inside = $inside + 1
    }
}
$m1 = millisecondes()
>> $m1 - $m0
