{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rose",
  "scopeName": "source.rose",
  "fileTypes": [
    "rose"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rose",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rose",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rose",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "storage.modifier.rose",
          "match": "@(dll|sym)\\b"
        },
        {
          "name": "meta.decorator.rose",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.imaginary.rose",
          "match": "\\b[0-9]+(\\.[0-9]+)?i\\b"
        },
        {
          "name": "constant.numeric.float.rose",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.rose",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.rose",
          "match": "\\$[a-zA-Z_àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ][a-zA-Z0-9_àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ]*"
        },
        {
          "name": "variable.other.rose",
          "match": "\\b[a-zA-Z_àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ][a-zA-Z0-9_àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ]*\\b",
          "captures": {}
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rose",
          "match": "\\b(si|sinon|tant_que|pour|de|vers|fn|retour|et|ou|non)\\b"
        },
        {
          "name": "constant.language.rose",
          "match": "\\b(vrai|faux|vide|pi|e|phi)\\b"
        },
        {
          "name": "keyword.operator.word.rose",
          "match": "\\b(et|ou|non)\\b"
        },
        {
          "name": "keyword.other.rose",
          "match": "(>>|<<)"
        },
        {
          "name": "keyword.control.rose",
          "match": "[?@]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.rose",
          "match": "\\b(entier|rationnel|flottant|booleen|chaine|complexe|irrationnel|liste|table|tableau|tampon)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rose",
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.rose" }
          }
        },
        {
          "name": "support.function.rose",
          "match": "\\b(abs|min|max|partie_entiere|factorielle|fact|fib|fibonacci|pgcd|gcd|ppcm|lcm|puissance|pow|nb_chiffres|digits|est_premier|is_prime|compter_premiers|pi|e|phi|racine|fraction|re|im|conj|arg|modulus|longueur|len|ordre|caractere|sous_chaine|sub|concatener|table|map|inserer|cle_existe|supprimer|cles|valeurs|joindre|graine|seed|hasard|prng|hasard_systeme|rng_materiel|hasard_vrai|lire_texte|ecrire_texte|ecrire_binaire|argument|nb_arguments|temps|millisecondes|ms|time|duree|afficher|afficher_erreur|quitter|tampon|octets|eval_expr|breakpoint|watch)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rose",
          "match": "(==|!=|<=|>=|<|>|≤|≥|≠|≈|→|->|\\+|-|\\*|⋅|·|×|/|÷|%|\\^|!|~|=|:)"
        },
        {
          "name": "keyword.operator.logical.rose",
          "match": "\\b(et|ou|non)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.rose",
          "match": "[,;]"
        },
        {
          "name": "punctuation.bracket.rose",
          "match": "[\\{\\}\\[\\]\\(\\)]"
        }
      ]
    }
  }
}
