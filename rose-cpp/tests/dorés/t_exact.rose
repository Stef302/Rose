fn collatz_long(n: entier) -> entier {
    $c = 0
    tant_que ($n != 1) {
        si ($n % 2 == 0) { $n = $n div 2 } sinon { $n = 3 * $n + 1 }
        $c = $c + 1
    }
    retour $c
}
