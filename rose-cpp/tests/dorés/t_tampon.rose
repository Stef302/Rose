graine(99)
$ok = vrai
$u = 0
pour $k de 0 vers 2000 { $x = hasard(64)
  si ($x < 0) { $ok = faux }
  si ($x > 63) { $ok = faux }
  $u = $u + $x }
>> $ok
>> $u > 0
$buf = tampon(64)
$alp = octets("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")
remplir_hasard($buf, $alp)
>> longueur($buf)
$bornes = vrai
pour $j de 0 vers 64 { $c = tampon_case($buf, $j)
  si ($c < 45) { $bornes = faux }
  si ($c > 122) { $bornes = faux } }
>> $bornes
$somme = 0
pour $p de 0 vers 64 { $somme = $somme + tampon_case($buf, $p) }
>> $somme
tampon_pose($buf, 0, 88)
>> tampon_case($buf, 0)
$g1 = octets("abcXYZ-_")
$g2 = octets("abcXYZ-_")
>> $g1 == $g2
graine(7)
$b1 = tampon(16)
remplir_hasard($b1, $g1)
graine(7)
$b2 = tampon(16)
remplir_hasard($b2, $g1)
>> $b1 == $b2
