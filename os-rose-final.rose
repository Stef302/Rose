# os-rose-final.rose — OS 32 BITS COMPLET EN ROSE PUR (boot + noyau + apps)
#
# Constat daté : 26/11/2026. Un SEUL programme Rose génère TOUT :
#   - le bootloader (512 octets, données Rose)
#   - le noyau graphique Rose (framebuffer VESA)
#   - 3 applications Rose (PAINT, CLOCK, SNAKE)
#   - l'image disque 1,44 Mo complète
# AUCun fichier Zig, aucun assembleur, aucun linker, aucune lecture de binaire.

fn octet_brut($v: entier) -> chaine { retour caractere($v % 256) }
fn o(v: entier) -> chaine { retour octet_brut($v % 256) }
fn u32le(v: entier) -> chaine {
  $r = o(v % 256); $r = $r + o((v ÷ 256) % 256)
  $r = $r + o((v ÷ 65536) % 256); $r = $r + o((v ÷ 16777216) % 256)
  retour $r
}
fn octets_ajouter(l: liste<entier>, a: liste<entier>) -> liste<entier> {
  $r = [l[0]]
  $k = 1
  tant_que ($k < longueur(l)) { joindre($r, l[$k]); $k = $k + 1 }
  $j = 0
  tant_que ($j < longueur(a)) { joindre($r, a[$j]); $j = $j + 1 }
  retour $r
}
fn liste_vers_chaine(l: liste<entier>) -> chaine {
  $out = ""
  $i = 1
  tant_que ($i < longueur(l)) { $out = $out + octet_brut(l[$i]); $i = $i + 1 }
  retour $out
}

# ═══════════════════════════════════════════════════════════════════════════
# 1. BOOTLOADER (données Rose, identique au bootloader de référence)
# ═══════════════════════════════════════════════════════════════════════════
$boot_octets = [0]
$boot_octets = octets_ajouter($boot_octets, [49,192,142,216,142,192,142,208,188,0,124,136,22,68,125,190])
$boot_octets = octets_ajouter($boot_octets, [71,125,173,131,248,255,15,132,37,1,163,69,125,184,1,79])
$boot_octets = octets_ajouter($boot_octets, [139,14,69,125,191,0,112,205,16,131,248,79,117,228,128,62])
$boot_octets = octets_ajouter($boot_octets, [25,112,32,117,221,102,161,40,112,102,163,96,125,184,2,79])
