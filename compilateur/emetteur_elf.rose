# emetteur_elf.rose — Émetteur ELF64 natif pour Rose.
# Génère un binaire ELF exécutable autonome à partir d'un programme Rose.
# Zéro dépendance externe : pas de rustc, pas de clang, pas de LLVM.
# Utilisation : rose/rose run compilateur/emetteur_elf.rose prog.rose -o sortie

# ── Utilitaires d'écriture little-endian ──

fn u8le($v: entier) -> chaine {
  retour caractere($v % 256)
}

fn u16le($v: entier) -> chaine {
  $b0 = $v % 256
  $b1 = partie_entiere($v / 256) % 256
  retour caractere($b0) + caractere($b1)
}

fn u32le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = partie_entiere($v / 256)
  $b1 = $v1 % 256
  $v2 = partie_entiere($v1 / 256)
  $b2 = $v2 % 256
  $v3 = partie_entiere($v2 / 256)
  $b3 = $v3 % 256
  retour caractere($b0) + caractere($b1) + caractere($b2) + caractere($b3)
}

fn u64le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = partie_entiere($v / 256)
  $b1 = $v1 % 256
  $v2 = partie_entiere($v1 / 256)
  $b2 = $v2 % 256
  $v3 = partie_entiere($v2 / 256)
  $b3 = $v3 % 256
  $v4 = partie_entiere($v3 / 256)
  $b4 = $v4 % 256
  $v5 = partie_entiere($v4 / 256)
  $b5 = $v5 % 256
  $v6 = partie_entiere($v5 / 256)
  $b6 = $v6 % 256
  $v7 = partie_entiere($v6 / 256)
  $b7 = $v7 % 256
  retour caractere($b0) + caractere($b1) + caractere($b2) + caractere($b3) + caractere($b4) + caractere($b5) + caractere($b6) + caractere($b7)
}

# ── Substitution d'un nom de variable nu (bornes alphanumeriques) ──
fn substituer_nom($txt: chaine, $nom: chaine, $val: chaine) -> chaine {
  $res = ""
  $k = 0
  $ln = longueur($txt)
  $lnn = longueur($nom)
  tant_que ($k < $ln) {
    $ok = 0
    si ($k + $lnn <= $ln) {
      si (sous_chaine($txt, $k, $k + $lnn) == $nom) {
        $ok_avant = 1
        si ($k > 0) {
          $prec = sous_chaine($txt, $k - 1, $k)
          si (($prec >= "a" et $prec <= "z") ou ($prec >= "A" et $prec <= "Z") ou ($prec >= "0" et $prec <= "9") ou $prec == "_") {
            $ok_avant = 0
          }
        }
        $ok_apres = 1
        si ($k + $lnn < $ln) {
          $suiv = sous_chaine($txt, $k + $lnn, $k + $lnn + 1)
          si (($suiv >= "a" et $suiv <= "z") ou ($suiv >= "A" et $suiv <= "Z") ou ($suiv >= "0" et $suiv <= "9") ou $suiv == "_") {
            $ok_apres = 0
          }
        }
        si ($ok_avant == 1 et $ok_apres == 1) {
          $ok = 1
        }
      }
    }
    si ($ok == 1) {
      $res = $res + $val
      $k = $k + $lnn
    } sinon {
      $res = $res + sous_chaine($txt, $k, $k + 1)
      $k = $k + 1
    }
  }
  retour $res
}

# ── Constantes ELF64 ──
$ELFMAG = "\177ELF"
$ELFCLASS64 = 2
$ELFDATA2LSB = 1
$EV_CURRENT = 1
$ELFOSABI_SYSV = 0
$ET_EXEC = 2
$EM_AARCH64 = 183
$PT_LOAD = 1
$PF_R = 4
$PF_W = 2
$PF_X = 1
$SHT_NULL = 0
$SHT_PROGBITS = 1
$SHT_STRTAB = 3
$SHN_UNDEF = 0

# Adresse de chargement aarch64
$BASE_ADDR = 4194304
$TEXT_OFFSET = 4096
$TEXT_ADDR = $BASE_ADDR + $TEXT_OFFSET

# ── Émetteur ELF minimal : produit un binaire qui retourne 0 ──
fn fold_last_return($sub2: chaine) -> chaine {
  # La chaîne $sub2 est une suite d'expressions séparées par des espaces au
  # niveau 0 (une par « retour » dans le corps d'une fonction). On rend la
  # dernière expression, ou $sub2 si aucune découpe n'est nécessaire.
  $pos_dernier_espace = -1
  $prof_q = 0
  $qe = 0
  tant_que ($qe < longueur($sub2)) {
    $cq = sous_chaine($sub2, $qe, $qe + 1)
    si ($cq == "(" ou $cq == "[" ou $cq == "{") { $prof_q = $prof_q + 1 }
    si ($cq == ")" ou $cq == "]" ou $cq == "}") { $prof_q = $prof_q - 1 }
    si ($cq == " " et $prof_q == 0) { $pos_dernier_espace = $qe }
    $qe = $qe + 1
  }
  si ($pos_dernier_espace >= 0) {
    retour sous_chaine($sub2, $pos_dernier_espace + 1, longueur($sub2))
  }
  retour $sub2
}

# Rend la position de la prochaine parenthese ouvrante precedee immediatement
# par un identifiant alphanumerique (0 si aucune).
fn find_appel($s: chaine, $debut: entier) -> entier {
  $k = $debut
  $ln = longueur($s)
  tant_que ($k < $ln) {
    $c = sous_chaine($s, $k, $k + 1)
    si ($c == "(") {
      # reculer sur un identifiant
      $j = $k
      si ($j > 0) {
        $prev = sous_chaine($s, $j - 1, $j)
        si (($prev >= "a" et $prev <= "z") ou ($prev >= "A" et $prev <= "Z") ou ($prev >= "0" et $prev <= "9") ou $prev == "_") {
          retour $k
        }
      }
    }
    $k = $k + 1
  }
  retour -1
}

# Extrait la liste des arguments d'un appel starting a $pos_open (la
# position de "("), en remplissant la liste $out via joindre. Rend la
# position de la parenthese fermante.
fn lire_args_appel($s: chaine, $pos_open: entier) -> entier {
  $prof = 1
  $cur = ""
  $lst = [""]
  $nb = 0
  $p = $pos_open + 1
  $ln = longueur($s)
  $fin_p = $p
  $fini = 0
  tant_que ($p < $ln et $fini == 0) {
    $c = sous_chaine($s, $p, $p + 1)
    si ($c == "(" ou $c == "[" ou $c == "{") {
      $prof = $prof + 1
      $cur = $cur + $c
    } sinon si ($c == ")" ou $c == "]" ou $c == "}") {
      $prof = $prof - 1
      si ($prof == 0) {
        $fini = 1
        $fin_p = $p
      } sinon {
        $cur = $cur + $c
      }
    } sinon si ($c == "," et $prof == 1) {
      # trim
      $ca = $cur
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
      joindre($lst, $ca)
      $nb = $nb + 1
      $cur = ""
    } sinon {
      $cur = $cur + $c
    }
    $p = $p + 1
  }
  $ca = $cur
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
  si (longueur($ca) > 0) {
    joindre($lst, $ca)
    $nb = $nb + 1
  }
  # table de retour : on la construit par paires (pos, n, args) via des vars
  # locales : $pos_ferm, $nb_args_out, $lst_args_out
  $pos_ferm = $fin_p
  $nb_args_out = $nb
  $lst_args_out = $lst
  # On les expose via une table renvoyée ; pour rester simple on rend 3 valeurs
  # séparees par des espaces via une chaine, que le caller décompose.
  retour $fin_p
}

# Variante : lit les args d'un appel et rend une liste $out (première cellule
# = position fermante, deuxième = nombre d'args, les suivantes = args).
fn lire_args_appel2($s: chaine, $pos_open: entier) -> entier {
  $prof = 1
  $cur = ""
  $lst = ["#"]
  $nb = 0
  $p = $pos_open + 1
  $ln = longueur($s)
  $fin_p = $p
  $fini = 0
  tant_que ($p < $ln et $fini == 0) {
    $c = sous_chaine($s, $p, $p + 1)
    si ($c == "(" ou $c == "[" ou $c == "{") {
      $prof = $prof + 1
      $cur = $cur + $c
    } sinon si ($c == ")" ou $c == "]" ou $c == "}") {
      $prof = $prof - 1
      si ($prof == 0) {
        $fini = 1
        $fin_p = $p
      } sinon {
        $cur = $cur + $c
      }
    } sinon si ($c == "," et $prof == 1) {
      $ca = $cur
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
      joindre($lst, $ca)
      $nb = $nb + 1
      $cur = ""
    } sinon {
      $cur = $cur + $c
    }
    $p = $p + 1
  }
  $ca = $cur
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
  si (longueur($ca) > 0) {
    joindre($lst, $ca)
    $nb = $nb + 1
  }
  $lia_out = $lst
  $lia_n = $nb
  retour $fin_p
}

$lia_n = 0
$lia_out = ["#"]

# Extraire l'expression situee apres le premier "retour" au niveau 0 d'un
# bloc (ignorant les accolades imbriquees). Rend le bloc tel quel si aucun
# "retour" de niveau 0 n'est trouve.
fn extraire_retour($_b: chaine) -> chaine {
  $_i = 0
  $_ln = longueur($_b)
  $_prof = 0
  $_ret = ""
  tant_que ($_i < $_ln) {
    $_ch = sous_chaine($_b, $_i, $_i + 1)
    si ($_ch == "{") { $_prof = $_prof + 1 }
    sinon si ($_ch == "}") { $_prof = $_prof - 1 }
    sinon si ($_prof == 0) {
      si ($_i + 6 <= $_ln et sous_chaine($_b, $_i, $_i + 6) == "retour") {
        $_j = $_i + 6
        tant_que ($_j < $_ln et sous_chaine($_b, $_j, $_j + 1) == " ") { $_j = $_j + 1 }
        $_ret = sous_chaine($_b, $_j, $_ln)
        $_nbret = longueur($_ret)
        tant_que ($_nbret > 0 et (sous_chaine($_ret, $_nbret - 1, $_nbret) == " " ou sous_chaine($_ret, $_nbret - 1, $_nbret) == "
" ou sous_chaine($_ret, $_nbret - 1, $_nbret) == "	")) {
          $_ret = sous_chaine($_ret, 0, $_nbret - 1)
          $_nbret = longueur($_ret)
        }
        retour $_ret
      }
    }
    $_i = $_i + 1
  }
  retour $_b
}

# Resoudre un corps de fonction (eventuellement contenant des `si`) en
# l'expression de retour nue. Les arguments ont deja ete substitues dans
# $corps. Evalue les conditions `si` a la compilation via eval_expr.
fn resoudre_corps($_c: chaine) -> chaine {
  $_pos = 0
  $_ln = longueur($_c)
  $_ret = ""
  $_fini = 0
  tant_que ($_pos < $_ln et $_fini == 0) {
    tant_que ($_pos < $_ln et (sous_chaine($_c, $_pos, $_pos + 1) == " " ou sous_chaine($_c, $_pos, $_pos + 1) == "
" ou sous_chaine($_c, $_pos, $_pos + 1) == "	")) { $_pos = $_pos + 1 }
    si ($_pos >= $_ln) { $_fini = 1 }
    sinon si (sous_chaine($_c, $_pos, $_pos + 2) == "si") {
      $_cc = ""
      si ($_pos + 2 < $_ln) { $_cc = sous_chaine($_c, $_pos + 2, $_pos + 3) }
      si ($_cc != " " et $_cc != "(") { $_fini = 1 }
      sinon {
        $_p = $_pos + 3
        tant_que ($_p < $_ln et sous_chaine($_c, $_p, $_p + 1) == " ") { $_p = $_p + 1 }
        si ($_p >= $_ln ou sous_chaine($_c, $_p, $_p + 1) != "(") { $_fini = 1 }
        sinon {
          $_cond = ""
          $_prof = 1
          $_p = $_p + 1
          tant_que ($_p < $_ln et $_prof > 0) {
            $_ch = sous_chaine($_c, $_p, $_p + 1)
            si ($_ch == "(") { $_prof = $_prof + 1 }
            sinon si ($_ch == ")") { $_prof = $_prof - 1 }
            si ($_prof > 0) { $_cond = $_cond + $_ch }
            $_p = $_p + 1
          }
          $_cond_val = eval_expr($_cond)
          $_est_vrai = 1
          si ($_cond_val == "0" ou $_cond_val == "faux" ou $_cond_val == "" ou longueur($_cond_val) == 0) { $_est_vrai = 0 }
          tant_que ($_p < $_ln et sous_chaine($_c, $_p, $_p + 1) == " ") { $_p = $_p + 1 }
          si ($_p >= $_ln ou sous_chaine($_c, $_p, $_p + 1) != "{") { $_fini = 1 }
          sinon {
            $_prof = 1
            $_p = $_p + 1
            $_debut_a = $_p
            tant_que ($_p < $_ln et $_prof > 0) {
              $_ch = sous_chaine($_c, $_p, $_p + 1)
              si ($_ch == "{") { $_prof = $_prof + 1 }
              sinon si ($_ch == "}") { $_prof = $_prof - 1 }
              $_p = $_p + 1
            }
            $_fin_a = $_p - 1
            $_alors = sous_chaine($_c, $_debut_a, $_fin_a)
            si ($_est_vrai == 1) {
              $_ret = extraire_retour($_alors)
              $_fini = 1
            } sinon {
              tant_que ($_p < $_ln et (sous_chaine($_c, $_p, $_p + 1) == " " ou sous_chaine($_c, $_p, $_p + 1) == "
" ou sous_chaine($_c, $_p, $_p + 1) == "	")) { $_p = $_p + 1 }
              $_trouve_sinon = 0
              si ($_p + 5 <= $_ln) {
                si (sous_chaine($_c, $_p, $_p + 1) == "s" et sous_chaine($_c, $_p + 1, $_p + 2) == "i" et sous_chaine($_c, $_p + 2, $_p + 3) == "n" et sous_chaine($_c, $_p + 3, $_p + 4) == "o" et sous_chaine($_c, $_p + 4, $_p + 5) == "n") {
                  $_trouve_sinon = 1
                }
              }
              si ($_trouve_sinon == 1) {
                $_p2 = $_p + 5
                tant_que ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == " ") { $_p2 = $_p2 + 1 }
                $_cc2 = ""
                si ($_p2 + 2 <= $_ln) { $_cc2 = sous_chaine($_c, $_p2, $_p2 + 2) }
                si ($_cc2 == "si") {
                  $_pos = $_p2
                } sinon {
                  tant_que ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == " ") { $_p2 = $_p2 + 1 }
                  si ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == "{") {
                    $_prof = 1
                    $_p2 = $_p2 + 1
                    $_debut_s = $_p2
                    tant_que ($_p2 < $_ln et $_prof > 0) {
                      $_ch = sous_chaine($_c, $_p2, $_p2 + 1)
                      si ($_ch == "{") { $_prof = $_prof + 1 }
                      sinon si ($_ch == "}") { $_prof = $_prof - 1 }
                      $_p2 = $_p2 + 1
                    }
                    $_fin_s = $_p2 - 1
                    $_sinon_bloc = sous_chaine($_c, $_debut_s, $_fin_s)
                    $_ret = extraire_retour($_sinon_bloc)
                    $_fini = 1
                  } sinon {
                    $_fini = 1
                  }
                  $_pos = $_ln
                }
              } sinon {
                $_pos = $_p
              }
            }
          }
        }
      }
    } sinon {
      $_reste = sous_chaine($_c, $_pos, $_ln)
      $_ret = extraire_retour($_reste)
      $_fini = 1
    }
  }
  si (longueur($_ret) == 0) { retour $_c } sinon { retour $_ret }
}

# Plier iterativement une expression `$expr` qui peut contenir des appels a
# des fonctions deja enregistrees dans $fn_noms/$fn_params/$fn_retours.
fn plier_expression($expr: chaine) -> chaine {
  $cour = $expr
  $tour = 0
  tant_que ($tour < 256) {
    $tour = $tour + 1
    # si entierement numerique, evaluer.
    $tn = 1
    $qn = 0
    $lnc = longueur($cour)
    tant_que ($qn < $lnc) {
      $cn = sous_chaine($cour, $qn, $qn + 1)
      si (($cn >= "a" et $cn <= "z") ou ($cn >= "A" et $cn <= "Z")) {
        $tn = 0
        $qn = $lnc
      }
      $qn = $qn + 1
    }
    si ($tn == 1 et $lnc > 0) {
      $ev = eval_expr($cour)
      si (longueur($ev) > 0) { $cour = $ev }
      $tour = 256
    } sinon {
      # trouver le prochain "nom(" le plus a gauche
      $p = find_appel($cour, 0)
      si ($p < 0) { $tour = 256 }
      sinon {
        # lire l'identifiant
        $fin_id = $p
        $debut_id = $p
        tant_que ($debut_id > 0) {
          $cp = sous_chaine($cour, $debut_id - 1, $debut_id)
          si (($cp >= "a" et $cp <= "z") ou ($cp >= "A" et $cp <= "Z") ou ($cp >= "0" et $cp <= "9") ou $cp == "_") {
            $debut_id = $debut_id - 1
          } sinon {
            $debut_id = 0
          }
        }
        $nom_f = sous_chaine($cour, $debut_id, $fin_id)
        # est-ce une fn connue ?
        $fi = 1
        $trouve = 0
        tant_que ($fi <= $nb_fn) {
          si ($fn_noms[$fi] == $nom_f) { $trouve = $fi }
          $fi = $fi + 1
        }
        si ($trouve == 0) { $tour = 256 }
        sinon {
          $pos_f = lire_args_appel2($cour, $p)
          $nb_a2 = $lia_n
          $lst_a2 = $lia_out
          # lire les params de la fn : extraire chaque "$nom".
          $pr = $fn_params[$trouve]
          $pn = ["#"]
          $pn_n = 0
          $ip = 0
          $lpr = longueur($pr)
          tant_que ($ip < $lpr) {
            $ch = sous_chaine($pr, $ip, $ip + 1)
            si ($ch == "$") {
              $nom_w = "$"
              $ip = $ip + 1
              $fin_w = 0
              tant_que ($ip < $lpr et $fin_w == 0) {
                $ch2 = sous_chaine($pr, $ip, $ip + 1)
                si (($ch2 >= "a" et $ch2 <= "z") ou ($ch2 >= "A" et $ch2 <= "Z") ou ($ch2 >= "0" et $ch2 <= "9") ou $ch2 == "_") {
                  $nom_w = $nom_w + $ch2
                  $ip = $ip + 1
                } sinon {
                  $fin_w = 1
                }
              }
              joindre($pn, $nom_w)
              $pn_n = $pn_n + 1
            } sinon {
              $ip = $ip + 1
            }
          }
          $nb_p = $pn_n
          $sub = $fn_retours[$trouve]
          $pj = 1
          tant_que ($pj <= $nb_p et $pj <= $nb_a2) {
            $pn_j = $pn[$pj]
            $la_j = $lst_a2[$pj]
            # plier l'argument recursivement (si possible), pour que la
            # substitution soit litterale.
            $la_pliee = $la_j
            si (longueur($la_j) > 0) {
              $pl = plier_expression($la_j)
              si (longueur($pl) > 0) { $la_pliee = $pl } sinon {
                $ev_a = eval_expr($la_j)
                si (longueur($ev_a) > 0) { $la_pliee = $ev_a }
              }
            }
            $sub = substituer_nom($sub, $pn_j, $la_pliee)
            $pj = $pj + 1
          }
          # Resoudre les si du corps de fonction pour obtenir l'expression de
          # retour nue (gere le cas recursif avec cas de base dans un si).
          $sub = resoudre_corps($sub)
          $av = sous_chaine($cour, 0, $debut_id)
          $lgc = longueur($cour)
          $di = $pos_f + 1
          $ap = ""
          si ($di <= $lgc) { $ap = sous_chaine($cour, $di, $lgc) }
          $cour = $av + $sub + $ap
        }
      }
    }
  }
  retour $cour
}

fn emettre_elf_print($sortie: chaine, $texte: chaine) {
  $out = ""
  $ELFMAG = "ELF"
  $ELFCLASS64 = 2
  $ELFDATA2LSB = 1
  $EV_CURRENT = 1
  $ELFOSABI_SYSV = 0
  $ET_EXEC = 2
  $EM_AARCH64 = 183
  $PT_LOAD = 1
  $PF_R = 4
  $PF_W = 2
  $PF_X = 1
  $BASE_ADDR = 4194304
  $TEXT_OFFSET = 4096
  $TEXT_ADDR = 4198400

  # ── ELF header (64 octets) ──
  $out = $out + $ELFMAG                                    # e_ident[0..3]
  $out = $out + caractere($ELFCLASS64)     # e_ident[4] = ELFCLASS64
  $out = $out + caractere($ELFDATA2LSB)    # e_ident[5] = ELFDATA2LSB
  $out = $out + caractere($EV_CURRENT)     # e_ident[6] = EV_CURRENT
  $out = $out + caractere($ELFOSABI_SYSV)  # e_ident[7] = ELFOSABI_SYSV
  $out = $out + caractere(0)               # e_ident[8] = 0
  $out = $out + caractere(0)               # e_ident[9] = 0
  $out = $out + caractere(0)               # e_ident[10] = 0
  $out = $out + caractere(0)               # e_ident[11] = 0
  $out = $out + caractere(0)               # e_ident[12] = 0
  $out = $out + caractere(0)               # e_ident[13] = 0
  $out = $out + caractere(0)               # e_ident[14] = 0
  $out = $out + caractere(0)               # e_ident[15] = 0
  $out = $out + u16le($ET_EXEC)                            # e_type = ET_EXEC
  $out = $out + u16le($EM_AARCH64)                         # e_machine = EM_AARCH64
  $out = $out + u32le(1)                                   # e_version = 1
  $out = $out + u64le($TEXT_ADDR)                          # e_entry = adresse de _start
  $out = $out + u64le(64)                                  # e_phoff = 64 (juste après l'en-tête)
  $out = $out + u64le(0)                                   # e_shoff = 0 (pas de section header pour l'instant)
  $out = $out + u32le(0)                                   # e_flags = 0
  $out = $out + u16le(64)                                  # e_ehsize = 64
  $out = $out + u16le(56)                                  # e_phentsize = 56
  $out = $out + u16le(1)                                   # e_phnum = 1 (un segment)
  $out = $out + u16le(64)                                  # e_shentsize = 64
  $out = $out + u16le(0)                                   # e_shnum = 0
  $out = $out + u16le(0)                                   # e_shstrndx = 0

  # ── Program header (1 segment PT_LOAD, 56 octets) ──
  $out = $out + u32le($PT_LOAD)                            # p_type = PT_LOAD
  $out = $out + u32le(5)                                   # p_flags = R|X
  $out = $out + u64le($TEXT_OFFSET)                        # p_offset = 4096
  $out = $out + u64le($TEXT_ADDR)                          # p_vaddr
  $out = $out + u64le($TEXT_ADDR)                          # p_paddr
  $fsz = 8 * 4 + longueur($texte)                          # 8 instr * 4 + data
  $out = $out + u64le($fsz)                                # p_filesz
  $out = $out + u64le($fsz)                                # p_memsz
  $out = $out + u64le(2097152)                             # p_align

  # ── Padding jusqu'a 4096 (0x1000) ──
  $pad = 4096 - longueur($out)
  $i = 0
  tant_que ($i < $pad) {
    $out = $out + caractere(0)
    $i = $i + 1
  }

  # ── Code machine aarch64 : affiche "Hello" et exit 0 ──
  $out = $out + u32le(3531604000)   # mov x0, #1 (stdout)
  $out = $out + u32le(268435681)    # adr x1, data (offset 28)
  $len_texte = longueur($texte)
  $opcode_x2 = 3531603968 + $len_texte * 32 + 2
  $out = $out + u32le($opcode_x2)   # mov x2, #len (len)
  $out = $out + u32le(3531606024)   # mov x8, #64 (write)
  $out = $out + u32le(3556769793)   # svc #0
  $out = $out + u32le(3531603968)   # mov x0, #0 (exit code)
  $out = $out + u32le(3531606952)   # mov x8, #93 (exit)
  $out = $out + u32le(3556769793)   # svc #0
  # data: texte
  $out = $out + $texte
  # ── Écrire le fichier ──
  ecrire_bytes($sortie, $out)
  >> "rose: " + $sortie + " produit (binaire ELF autonome, " + chaine(longueur($out)) + " octets)"
}

# ── Point d'entrée ──
$chemin = argument(0)
$sortie = argument(1)
si (longueur($sortie) == 0) {
  $sortie = "prog"
}
$src = lire_texte($chemin)
si (longueur($src) == 0) {
  afficher_erreur("emetteur_elf : fichier vide ou introuvable : " + $chemin)
  quitter(1)
}
# Fonctions : extraire les blocs "fn nom(params) -> type { ... }" et les
# retirer du source. On conserve leur nom, leurs params et l'expr de retour.
$fn_noms = [""]
$fn_params = [""]
$fn_retours = [""]
$nb_fn = 0
# Extraction iterative
$modif_fn = 1
tant_que ($modif_fn == 1) {
  $modif_fn = 0
  # chercher "fn "
  $pos_fn = -1
  $i = 0
  tant_que ($i + 3 <= longueur($src)) {
    si (sous_chaine($src, $i, $i + 3) == "fn ") {
      $pos_fn = $i
      $i = longueur($src)
    } sinon {
      $i = $i + 1
    }
  }
  si ($pos_fn >= 0) {
    # lire le nom
    $j = $pos_fn + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") { $j = $j + 1 }
    $nom_fn = ""
    tant_que ($j < longueur($src)) {
      $ch = sous_chaine($src, $j, $j + 1)
      si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
        $nom_fn = $nom_fn + $ch
        $j = $j + 1
      } sinon {
        $j = longueur($src)
      }
    }
    # trouver "("
    $jp = $pos_fn + 3
    tant_que ($jp < longueur($src) et sous_chaine($src, $jp, $jp + 1) != "(") { $jp = $jp + 1 }
    # params jusqu'a ")"
    $params_fn = ""
    $prof = 1
    $jp = $jp + 1
    $debut_p = $jp
    tant_que ($jp < longueur($src) et $prof > 0) {
      $ch = sous_chaine($src, $jp, $jp + 1)
      si ($ch == "(") { $prof = $prof + 1 }
      si ($ch == ")") { $prof = $prof - 1 }
      si ($prof > 0) { $params_fn = $params_fn + $ch }
      $jp = $jp + 1
    }
    # trouver "{" apres ")"
    $ja = $jp
    tant_que ($ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) != "{") { $ja = $ja + 1 }
    # trouver "}" correspondant (profondeur, en ignorant les crochets [ ] )
    $prof = 1
    $ja = $ja + 1
    $debut_b = $ja
    $fin_b = $ja
    $fini_b = 0
    tant_que ($ja < longueur($src) et $fini_b == 0) {
      $ch = sous_chaine($src, $ja, $ja + 1)
      si ($ch == "{") { $prof = $prof + 1 }
      si ($ch == "}") {
        $prof = $prof - 1
        si ($prof == 0) {
          $fin_b = $ja
          $fini_b = 1
        }
      }
      $ja = $ja + 1
    }
    $corps_fn = sous_chaine($src, $debut_b, $fin_b)
    # extraire TOUTES les exprs apres chaque "retour" au NIVEAU 0 du corps.
    # On decoupe $corps_fn en « instructions » separees par "\n" au niveau 0,
    # puis, pour chaque instruction dont le premier mot est « retour », on
    # retient l'expression (le reste de la ligne,trimmee). Les « retour » a
    # l'interieur de blocs { ... } ne sont PAS consideres (ils appartiennent
    # au sous-bloc). On retient la DERNIERE expression « retour » de niveau 0.
    $ret = ""
    $nb_e = 0
    $ligne_buf = ""
    $prof_l = 0
    $kr = 0
    tant_que ($kr <= longueur($corps_fn)) {
      $en_ligne = 0
      si ($kr < longueur($corps_fn)) { $en_ligne = 1 }
      $fin_ligne = 0
      si ($en_ligne == 1) {
        $ch = sous_chaine($corps_fn, $kr, $kr + 1)
        si ($ch == "\n") { $fin_ligne = 1 }
      } sinon {
        $fin_ligne = 1
      }
      si ($fin_ligne == 1) {
        # traiter $ligne_buf comme une instruction
        # trim leading
        $ln = longueur($ligne_buf)
        tant_que ($ln > 0 et sous_chaine($ligne_buf, 0, 1) == " ") { $ligne_buf = sous_chaine($ligne_buf, 1, $ln); $ln = longueur($ligne_buf) }
        tant_que ($ln > 0 et sous_chaine($ligne_buf, $ln - 1, $ln) == " ") { $ligne_buf = sous_chaine($ligne_buf, 0, $ln - 1); $ln = longueur($ligne_buf) }
        tant_que ($ln > 0 et sous_chaine($ligne_buf, $ln - 1, $ln) == "\r") { $ligne_buf = sous_chaine($ligne_buf, 0, $ln - 1); $ln = longueur($ligne_buf) }
        si ($prof_l == 0 et $ln >= 6) {
          si (sous_chaine($ligne_buf, 0, 6) == "retour") {
            # le 7e caractere doit etre espace ou fin ; et on accepte « retour ... »
            $suiv_est_ok = 0
            si ($ln == 6) { $suiv_est_ok = 1 }
            sinon {
              $c7 = sous_chaine($ligne_buf, 6, 7)
              si ($c7 == " " ou $c7 == "\t") { $suiv_est_ok = 1 }
            }
            si ($suiv_est_ok == 1) {
              # extraire l'expression apres "retour "
              $expr_e = sous_chaine($ligne_buf, 6, $ln)
              # trim
              $le = longueur($expr_e)
              tant_que ($le > 0 et sous_chaine($expr_e, 0, 1) == " ") { $expr_e = sous_chaine($expr_e, 1, $le); $le = longueur($expr_e) }
              tant_que ($le > 0 et sous_chaine($expr_e, $le - 1, $le) == " ") { $expr_e = sous_chaine($expr_e, 0, $le - 1); $le = longueur($expr_e) }
              si ($le > 0) { $ret = $expr_e }
            }
          }
        }
        # mettre a jour la profondeur avec les {} de cette ligne
        $kp = 0
        tant_que ($kp < $ln) {
          $cphp = sous_chaine($ligne_buf, $kp, $kp + 1)
          si ($cphp == "{") { $prof_l = $prof_l + 1 }
          si ($cphp == "}") { $prof_l = $prof_l - 1 }
          $kp = $kp + 1
        }
        $ligne_buf = ""
      } sinon {
        $ligne_buf = $ligne_buf + $ch
      }
      $kr = $kr + 1
    }
    # trim leading spaces
    $nbret = longueur($ret)
    tant_que ($nbret > 0 et sous_chaine($ret, 0, 1) == " ") {
      $ret = sous_chaine($ret, 1, $nbret)
      $nbret = longueur($ret)
    }
    # trim trailing spaces/newlines
    $nbret = longueur($ret)
    tant_que ($nbret > 0 et (sous_chaine($ret, $nbret - 1, $nbret) == " " ou sous_chaine($ret, $nbret - 1, $nbret) == "\n" ou sous_chaine($ret, $nbret - 1, $nbret) == "\t")) {
      $ret = sous_chaine($ret, 0, $nbret - 1)
      $nbret = longueur($ret)
    }
    # stocker : si $ret est entierement numerique, on le plie une premiere fois
    si (longueur($ret) > 0) {
      $tnum = 1
      $qn0 = 0
      tant_que ($qn0 < longueur($ret)) {
        $cn0 = sous_chaine($ret, $qn0, $qn0 + 1)
        si (($cn0 >= "a" et $cn0 <= "z") ou ($cn0 >= "A" et $cn0 <= "Z")) {
          $tnum = 0
          $qn0 = longueur($ret)
        }
        $qn0 = $qn0 + 1
      }
      si ($tnum == 1) {
        $plie = eval_expr($ret)
        si (longueur($plie) > 0) { $ret = $plie }
      }
    }
    # stocker le CORPS COMPLET (y compris les si) pour le repli des appels.
    # On trim les espaces/newlines autour du corps.
    $corps_b = $corps_fn
    $lnb = longueur($corps_b)
    tant_que ($lnb > 0 et sous_chaine($corps_b, 0, 1) == " ") { $corps_b = sous_chaine($corps_b, 1, $lnb); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, $lnb - 1, $lnb) == " ") { $corps_b = sous_chaine($corps_b, 0, $lnb - 1); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, 0, 1) == "\n") { $corps_b = sous_chaine($corps_b, 1, $lnb); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, $lnb - 1, $lnb) == "\n") { $corps_b = sous_chaine($corps_b, 0, $lnb - 1); $lnb = longueur($corps_b) }
    joindre($fn_noms, $nom_fn)
    joindre($fn_params, $params_fn)
    joindre($fn_retours, $corps_b)
    $nb_fn = $nb_fn + 1
    # retirer le bloc fn du src (de pos_fn jusqu'a la "}" fermante +1)
    $avant_fn = sous_chaine($src, 0, $pos_fn)
    $apres_fn = sous_chaine($src, $ja, longueur($src))
    $src = $avant_fn + $apres_fn
    $modif_fn = 1
  }
}

# Inlining des appels de fonction dans les lignes ">> name(...)"
$modif_inl = 1
tant_que ($modif_inl == 1) {
  $modif_inl = 0
  $i = 0
  tant_que ($i < longueur($src)) {
    # trouver ">> "
    $pos = -1
    $k = $i
    tant_que ($k + 3 <= longueur($src)) {
      si (sous_chaine($src, $k, $k + 3) == ">> ") {
        $pos = $k
        $k = longueur($src)
      } sinon {
        $k = $k + 1
      }
    }
    si ($pos < 0) {
      $i = longueur($src)
    } sinon {
      # avancer les espaces
      $ja = $pos + 3
      tant_que ($ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) == " ") { $ja = $ja + 1 }
      # lire le nom de fonction
      $nom_appel = ""
      $ja0 = $ja
      $done_ja = 0
      tant_que ($ja < longueur($src) et $done_ja == 0) {
        $ch = sous_chaine($src, $ja, $ja + 1)
        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
          $nom_appel = $nom_appel + $ch
          $ja = $ja + 1
        } sinon {
          $done_ja = 1
        }
      }
      # verifier que c'est une fonction connue et suivi de "("
      $est_fn = 0
      $idx_fn = 0
      $fi = 1
      tant_que ($fi <= $nb_fn) {
        si ($fn_noms[$fi] == $nom_appel) {
          $est_fn = 1
          $idx_fn = $fi
        }
        $fi = $fi + 1
      }
      si ($est_fn == 1 et $ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) == "(") {
        # extraire les args jusqu'a ")"
        $ja = $ja + 1
        $args_str = ""
        $prof = 1
        tant_que ($ja < longueur($src) et $prof > 0) {
          $ch = sous_chaine($src, $ja, $ja + 1)
          si ($ch == "(") { $prof = $prof + 1 }
          si ($ch == ")") { $prof = $prof - 1 }
          si ($prof > 0) { $args_str = $args_str + $ch }
          $ja = $ja + 1
        }
        # fin de ligne
        $fin_ligne = $ja
        tant_que ($fin_ligne < longueur($src) et sous_chaine($src, $fin_ligne, $fin_ligne + 1) != "\n") {
          $fin_ligne = $fin_ligne + 1
        }
        # substituer les params dans le retour
        $ret = $fn_retours[$idx_fn]
        $params = $fn_params[$idx_fn]
        # decouper params par virgule (niveau 0)
        $pi = 0
        # on utilise une liste manuelle : on stocke dans des vars temporaires via joindre
        $param_noms = [""]
        $param_vals = [""]
        $nb_p = 0
        # parse params
        $pp = 0
        $ppn = ""
        $curp = ""
        $depth = 0
        $tok = ""
        # params format: "$a: entier, $b: entier"
        # extraire les noms ($xxx) avant ':'
        $iip = 0
        $lp = longueur($params)
        $cur_nom = ""
        $in_nom = 0
        tant_que ($iip < $lp) {
          $ch = sous_chaine($params, $iip, $iip + 1)
          si ($ch == "$") {
            $cur_nom = "$"
            $iip = $iip + 1
          } sinon si ($cur_nom != "" et (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_")) {
            $cur_nom = $cur_nom + $ch
            $iip = $iip + 1
          } sinon {
            si (longueur($cur_nom) > 1) {
              joindre($param_noms, $cur_nom)
              $nb_p = $nb_p + 1
            }
            $cur_nom = ""
            $iip = $iip + 1
          }
        }
        si (longueur($cur_nom) > 1) {
          joindre($param_noms, $cur_nom)
          $nb_p = $nb_p + 1
        }
        # decouper args par virgule top-level
        $arg_list = [""]
        $nb_a = 0
        $cur_arg = ""
        $depth = 0
        $ka = 0
        $la = longueur($args_str)
        tant_que ($ka < $la) {
          $ch = sous_chaine($args_str, $ka, $ka + 1)
          si ($ch == "(" ou $ch == "[" ou $ch == "{") { $depth = $depth + 1 }
          si ($ch == ")" ou $ch == "]" ou $ch == "}") { $depth = $depth - 1 }
          si ($ch == "," et $depth == 0) {
            # trim
            $ca = $cur_arg
            $nbca = longueur($ca)
            tant_que ($nbca > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, longueur($ca)); $nbca = longueur($ca) }
            $nbca = longueur($ca)
            tant_que ($nbca > 0 et sous_chaine($ca, $nbca - 1, $nbca) == " ") { $ca = sous_chaine($ca, 0, $nbca - 1); $nbca = longueur($ca) }
            joindre($arg_list, $ca)
            $nb_a = $nb_a + 1
            $cur_arg = ""
          } sinon {
            $cur_arg = $cur_arg + $ch
          }
          $ka = $ka + 1
        }
        $ca = $cur_arg
        $nbca = longueur($ca)
        tant_que ($nbca > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, longueur($ca)); $nbca = longueur($ca) }
        $nbca = longueur($ca)
        tant_que ($nbca > 0 et sous_chaine($ca, $nbca - 1, $nbca) == " ") { $ca = sous_chaine($ca, 0, $nbca - 1); $nbca = longueur($ca) }
        si (longueur($ca) > 0) {
          joindre($arg_list, $ca)
          $nb_a = $nb_a + 1
        }
        # substituer params -> args dans ret, puis replier les appels
        # recursifs/nommes internes jusqu'a stabilisation
        # Substituer les params par les args dans le "retour".
        $ret_inl = $ret
        $pi = 1
        tant_que ($pi <= $nb_p et $pi <= $nb_a) {
          $ret_inl = substituer_nom($ret_inl, $param_noms[$pi], $arg_list[$pi])
          $pi = $pi + 1
        }
        # Resoudre les si du corps pour obtenir l'expression de retour nue.
        $ret_inl = resoudre_corps($ret_inl)
        # Si l'expression resultant n'a plus de lettre (entierement numerique),
        # on la plie via eval_expr.
        $tout_num_inl = 1
        $qn_inl = 0
        tant_que ($qn_inl < longueur($ret_inl)) {
          $cn_inl = sous_chaine($ret_inl, $qn_inl, $qn_inl + 1)
          si (($cn_inl >= "a" et $cn_inl <= "z") ou ($cn_inl >= "A" et $cn_inl <= "Z")) {
            $tout_num_inl = 0
          }
          $qn_inl = $qn_inl + 1
        }
        si ($tout_num_inl == 1 et longueur($ret_inl) > 0) {
          $r_inl = eval_expr($ret_inl)
          si (longueur($r_inl) > 0) { $ret_inl = $r_inl }
        }
        $tour_inl = 0
        $encore = 1
        tant_que ($encore == 1 et $tour_inl < 64) {
          $encore = 0
          $fi2 = 1
          tant_que ($fi2 <= $nb_fn) {
            $nm = $fn_noms[$fi2]
            $lm = longueur($nm)
            $kk = 0
            $trouve_i = 0
            $dp0 = 0
            $nb_esp0 = 0
            tant_que ($kk + $lm <= longueur($ret_inl) et $trouve_i == 0) {
              si (sous_chaine($ret_inl, $kk, $kk + $lm) == $nm) {
                $ap = $kk + $lm
                $nb_esp0 = 0
                tant_que ($ap < longueur($ret_inl) et sous_chaine($ret_inl, $ap, $ap + 1) == " ") { $ap = $ap + 1; $nb_esp0 = $nb_esp0 + 1 }
                si ($ap < longueur($ret_inl) et sous_chaine($ret_inl, $ap, $ap + 1) == "(") {
                  $trouve_i = 1
                  $dp0 = $ap + 1
                }
              }
              si ($trouve_i == 0) { $kk = $kk + 1 }
            }
            si ($trouve_i == 1) {
              # extraire les args de cet appel
              $dp = $dp0
              $prof_d = 1
              $cur_d = ""
              $nb_d = 0
              $lst_d = [""]
              $fini_d = 0
              $dp_fin = $dp
              tant_que ($dp < longueur($ret_inl) et $fini_d == 0) {
                $chd = sous_chaine($ret_inl, $dp, $dp + 1)
                si ($chd == "(" ou $chd == "[" ou $chd == "{") {
                  $prof_d = $prof_d + 1
                  $cur_d = $cur_d + $chd
                } sinon si ($chd == ")" ou $chd == "]" ou $chd == "}") {
                  $prof_d = $prof_d - 1
                  si ($prof_d == 0) {
                    $fini_d = 1
                    $dp_fin = $dp
                  } sinon {
                    $cur_d = $cur_d + $chd
                  }
                } sinon si ($chd == "," et $prof_d == 1) {
                  $cd = $cur_d
                  $nbcd = longueur($cd)
                  tant_que ($nbcd > 0 et sous_chaine($cd, 0, 1) == " ") { $cd = sous_chaine($cd, 1, longueur($cd)); $nbcd = longueur($cd) }
                  $nbcd = longueur($cd)
                  tant_que ($nbcd > 0 et sous_chaine($cd, $nbcd - 1, $nbcd) == " ") { $cd = sous_chaine($cd, 0, $nbcd - 1); $nbcd = longueur($cd) }
                  joindre($lst_d, $cd)
                  $nb_d = $nb_d + 1
                  $cur_d = ""
                } sinon {
                  $cur_d = $cur_d + $chd
                }
                $dp = $dp + 1
              }
              $cd = $cur_d
              $nbcd = longueur($cd)
              tant_que ($nbcd > 0 et sous_chaine($cd, 0, 1) == " ") { $cd = sous_chaine($cd, 1, longueur($cd)); $nbcd = longueur($cd) }
              $nbcd = longueur($cd)
              tant_que ($nbcd > 0 et sous_chaine($cd, $nbcd - 1, $nbcd) == " ") { $cd = sous_chaine($cd, 0, $nbcd - 1); $nbcd = longueur($cd) }
              si (longueur($cd) > 0) {
                joindre($lst_d, $cd)
                $nb_d = $nb_d + 1
              }
              # lire les params du fn fi2
              $pr2 = $fn_params[$fi2]
              $pn2 = ["#"]
              $iip2 = 0
              $cur_n2 = ""
              $lp2 = longueur($pr2)
              tant_que ($iip2 < $lp2) {
                $ch2 = sous_chaine($pr2, $iip2, $iip2 + 1)
                si ($ch2 == "$") {
                  $cur_n2 = "$"
                  $iip2 = $iip2 + 1
                } sinon si ($cur_n2 != "" et (($ch2 >= "a" et $ch2 <= "z") ou ($ch2 >= "A" et $ch2 <= "Z") ou ($ch2 >= "0" et $ch2 <= "9") ou $ch2 == "_")) {
                  $cur_n2 = $cur_n2 + $ch2
                  $iip2 = $iip2 + 1
                } sinon {
                  si (longueur($cur_n2) > 1) {
                    joindre($pn2, $cur_n2)
                  }
                  $cur_n2 = ""
                  $iip2 = $iip2 + 1
                }
              }
              si (longueur($cur_n2) > 1) {
                joindre($pn2, $cur_n2)
              }
              $nb_p2 = longueur($pn2) - 1
              # substituer params dans le corps complet de la fonction
              $sub2 = $fn_retours[$fi2]
              $pj2 = 1
              tant_que ($pj2 <= $nb_p2 et $pj2 <= $nb_d) {
                $_la2 = $lst_d[$pj2]
                # plier l'argument recursivement avant substitution (comme
                # plier_expression) pour eviter les problemes de priorite.
                si (longueur($_la2) > 0) {
                  $_pl2 = plier_expression($_la2)
                  si (longueur($_pl2) > 0) { $_la2 = $_pl2 } sinon {
                    $_ev2a = eval_expr($_la2)
                    si (longueur($_ev2a) > 0) { $_la2 = $_ev2a }
                  }
                }
                $sub2 = substituer_nom($sub2, $pn2[$pj2], $_la2)
                $pj2 = $pj2 + 1
              }
              # Resoudre les si pour obtenir l'expression de retour nue.
              $sub2 = resoudre_corps($sub2)
              # Plier recursivement via plier_expression.
              $sub2 = plier_expression($sub2)
              # si $sub2 est entierement numerique, le plier
              $tnum2 = 1
              $qn2 = 0
              tant_que ($qn2 < longueur($sub2)) {
                $cn2 = sous_chaine($sub2, $qn2, $qn2 + 1)
                si (($cn2 >= "a" et $cn2 <= "z") ou ($cn2 >= "A" et $cn2 <= "Z")) {
                  $tnum2 = 0
                  $qn2 = longueur($sub2)
                }
                $qn2 = $qn2 + 1
              }
              si ($tnum2 == 1 et longueur($sub2) > 0) {
                $ev2 = eval_expr($sub2)
                si (longueur($ev2) > 0) { $sub2 = $ev2 }
              }
              # remplacer l'appel par sub2 dans ret_inl
              $avant2 = sous_chaine($ret_inl, 0, $kk)
              $apres2 = sous_chaine($ret_inl, $dp_fin + 1, longueur($ret_inl))
              $ret_inl = $avant2 + $sub2 + $apres2
              $encore = 1
            }
            $fi2 = $fi2 + 1
          }
          $tour_inl = $tour_inl + 1
        }

# remplacer la ligne ">> name(args...)" par ">> ret_inl"
        $avant_l = sous_chaine($src, 0, $pos)
        $apres_l = sous_chaine($src, $fin_ligne, longueur($src))
        $src = $avant_l + ">> " + $ret_inl + $apres_l
        $modif_inl = 1
        $i = $pos
      } sinon {
        $i = $pos + 1
      }
    }
  }
}

# Variables
$var_noms = [""]
$var_vals = [""]
$nb_vars = 0

# Pretraitement 0.5 : collecter les variables (premier passage)
# (deja fait ci-dessous, mais on a besoin des variables pour si)
# On fait d'abord une passe pour collecter les variables
# puis on traite les si, puis on collecte a nouveau

# Pretraitement 0 : collecter les variables (hors corps de tant_que,
# pour que les boucles pilotées par variable partent de valeurs propres)

$i = 0
$tq_prof = 0
$tq_attente = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  $c2 = ""
  $c3 = ""
  $c4 = ""
  $c5 = ""
  $c6 = ""
  $c7 = ""
  $c8 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  si ($i + 3 < longueur($src)) { $c4 = sous_chaine($src, $i + 3, $i + 4) }
  si ($i + 4 < longueur($src)) { $c5 = sous_chaine($src, $i + 4, $i + 5) }
  si ($i + 5 < longueur($src)) { $c6 = sous_chaine($src, $i + 5, $i + 6) }
  si ($i + 6 < longueur($src)) { $c7 = sous_chaine($src, $i + 6, $i + 7) }
  si ($i + 7 < longueur($src)) { $c8 = sous_chaine($src, $i + 7, $i + 8) }
  # Suivre la profondeur d'entree dans un corps de tant_que
  si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
    $tq_attente = 1
  }
  si ($c1 == "{") {
    si ($tq_attente == 1) {
      $tq_attente = 0
      $tq_prof = $tq_prof + 1
    } sinon {
      si ($tq_prof > 0) {
        $tq_prof = $tq_prof + 1
      }
    }
  }
  si ($c1 == "}" et $tq_prof > 0) {
    $tq_prof = $tq_prof - 1
  }
  si ($c1 == "v" et $c2 == "a" et $c3 == "r" et $tq_prof == 0) {
    $j = $i + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    $nom_var = ""
    tant_que ($j < longueur($src)) {
      $ch = sous_chaine($src, $j, $j + 1)
      si ($ch == " " ou $ch == "=") {
        $j = longueur($src) + 1
      } sinon {
        $nom_var = $nom_var + $ch
        $j = $j + 1
      }
    }
    $j = $i + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) != "=") {
      $j = $j + 1
    }
    $j = $j + 1
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    $expr = ""
    $k = $j
    tant_que ($k < longueur($src)) {
      $ch = sous_chaine($src, $k, $k + 1)
      si ($ch == "\n") {
        $k = longueur($src) + 1
      } sinon {
        $expr = $expr + $ch
        $k = $k + 1
      }
    }
    si (longueur($expr) > 0 et longueur($nom_var) > 0) {
      # Construire le contexte de variables (en ARRIERE : la derniere
      # valeur appendee est inseree en premier et gagne les remplacements)
      $ctx = ""
      $vi = 1
      tant_que ($vi <= $nb_vars) {
        $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
        $vi = $vi + 1
      }
      si (longueur($ctx) > 0) {
        $expr_full = $expr + " // vars: " + $ctx
      } sinon {
        $expr_full = $expr
      }
      $resultat = eval_expr($expr_full)
      joindre($var_noms, $nom_var)
      joindre($var_vals, $resultat)
      $nb_vars = $nb_vars + 1
    }
  }
  $i = $i + 1
}

# Pretraitement 0b : collecter les affectations NUES "nom = expr" hors corps de
# tant_que (les "var" sont deja collectes par la passe 0).
$i = 0
$tq_prof = 0
$tq_attente = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  si ($i + 3 < longueur($src)) { $c4 = sous_chaine($src, $i + 3, $i + 4) }
  si ($i + 4 < longueur($src)) { $c5 = sous_chaine($src, $i + 4, $i + 5) }
  si ($i + 5 < longueur($src)) { $c6 = sous_chaine($src, $i + 5, $i + 6) }
  si ($i + 6 < longueur($src)) { $c7 = sous_chaine($src, $i + 6, $i + 7) }
  si ($i + 7 < longueur($src)) { $c8 = sous_chaine($src, $i + 7, $i + 8) }
  si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
    $tq_attente = 1
  }
  si ($c1 == "{") {
    si ($tq_attente == 1) {
      $tq_attente = 0
      $tq_prof = $tq_prof + 1
    } sinon {
      si ($tq_prof > 0) {
        $tq_prof = $tq_prof + 1
      }
    }
  }
  si ($c1 == "}" et $tq_prof > 0) {
    $tq_prof = $tq_prof - 1
  }
  $est_nom = 0
  si ($tq_prof == 0) {
    si (($c1 >= "a" et $c1 <= "z") ou ($c1 >= "A" et $c1 <= "Z") ou $c1 == "_") {
      $est_nom = 1
    }
  }
  si ($est_nom == 1) {
    $nom_nu = ""
    $jn = $i
    $fin_n = 0
    tant_que ($jn < longueur($src) et $fin_n == 0) {
      $ch = sous_chaine($src, $jn, $jn + 1)
      si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
        $nom_nu = $nom_nu + $ch
        $jn = $jn + 1
      } sinon {
        $fin_n = 1
      }
    }
    $jn2 = $jn
    tant_que ($jn2 < longueur($src) et sous_chaine($src, $jn2, $jn2 + 1) == " ") {
      $jn2 = $jn2 + 1
    }
    $a_eq = 0
    si ($jn2 < longueur($src)) {
      si (sous_chaine($src, $jn2, $jn2 + 1) == "=") { $a_eq = 1 }
    }
    si ($nom_nu == "si" ou $nom_nu == "pour" ou $nom_nu == "tant_que" ou $nom_nu == "var" ou $nom_nu == "fn" ou $nom_nu == "retour") {
      $a_eq = 0
    }
    si ($a_eq == 1 et longueur($nom_nu) > 0) {
      $jx = $jn2 + 1
      tant_que ($jx < longueur($src) et sous_chaine($src, $jx, $jx + 1) == " ") {
        $jx = $jx + 1
      }
      $expr_nu = ""
      $kx = $jx
      $nl_pos = longueur($src)
      tant_que ($kx < longueur($src)) {
        $ch = sous_chaine($src, $kx, $kx + 1)
        si ($ch == "\n") {
          $nl_pos = $kx
          $kx = longueur($src) + 1
        } sinon {
          si ($ch != "\r") {
            $expr_nu = $expr_nu + $ch
          }
          $kx = $kx + 1
        }
      }
      $nbx = longueur($expr_nu)
      tant_que ($nbx > 0 et sous_chaine($expr_nu, 0, 1) == " ") {
        $expr_nu = sous_chaine($expr_nu, 1, longueur($expr_nu))
        $nbx = longueur($expr_nu)
      }
      $nbx = longueur($expr_nu)
      tant_que ($nbx > 0 et sous_chaine($expr_nu, $nbx - 1, $nbx) == " ") {
        $expr_nu = sous_chaine($expr_nu, 0, $nbx - 1)
        $nbx = longueur($expr_nu)
      }
      si (longueur($expr_nu) > 0) {
        $ctx = ""
        $vi = 1
        tant_que ($vi <= $nb_vars) {
          $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
          $vi = $vi + 1
        }
        si (longueur($ctx) > 0) {
          $expr_full = $expr_nu + " // vars: " + $ctx
        } sinon {
          $expr_full = $expr_nu
        }
        $resultat = eval_expr($expr_full)
        joindre($var_noms, $nom_nu)
        joindre($var_vals, $resultat)
        $nb_vars = $nb_vars + 1
      }
      $i = $nl_pos
    }
  }
  $i = $i + 1
}

# Pretraitement tant_que : deplier les boucles a la compilation.
# Deux modes :
#  - condition SANS variable connue : deplier une seule fois
#    (ou supprimer tout le bloc si la condition est fausse) ;
#  - condition dependant d'une variable : execution sequentielle a la
#    compilation — chaque ligne "var x = ..." du corps met a jour le stockage,
#    chaque ligne ">> ..." du corps est literalisee avec la valeur courante,
#    et les autres lignes subissent la substitution textuelle des variables.
$src_proc3 = $src
$modifie_tq = 1
$iter_max_tq = 1000
tant_que ($modifie_tq == 1) {
  $modifie_tq = 0
  $i = 0
  tant_que ($i < longueur($src_proc3)) {
    $c1 = ""
    $c2 = ""
    $c3 = ""
    $c4 = ""
    $c5 = ""
    $c6 = ""
    $c7 = ""
    $c8 = ""
    si ($i < longueur($src_proc3)) { $c1 = sous_chaine($src_proc3, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc3)) { $c2 = sous_chaine($src_proc3, $i + 1, $i + 2) }
    si ($i + 2 < longueur($src_proc3)) { $c3 = sous_chaine($src_proc3, $i + 2, $i + 3) }
    si ($i + 3 < longueur($src_proc3)) { $c4 = sous_chaine($src_proc3, $i + 3, $i + 4) }
    si ($i + 4 < longueur($src_proc3)) { $c5 = sous_chaine($src_proc3, $i + 4, $i + 5) }
    si ($i + 5 < longueur($src_proc3)) { $c6 = sous_chaine($src_proc3, $i + 5, $i + 6) }
    si ($i + 6 < longueur($src_proc3)) { $c7 = sous_chaine($src_proc3, $i + 6, $i + 7) }
    si ($i + 7 < longueur($src_proc3)) { $c8 = sous_chaine($src_proc3, $i + 7, $i + 8) }
    si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
      $j = $i + 8
      tant_que ($j < longueur($src_proc3) et sous_chaine($src_proc3, $j, $j + 1) == " ") {
        $j = $j + 1
      }
      si ($j < longueur($src_proc3) et sous_chaine($src_proc3, $j, $j + 1) == "(") {
        $j = $j + 1
        $cond = ""
        $prof = 1
        tant_que ($j < longueur($src_proc3) et $prof > 0) {
          $ch = sous_chaine($src_proc3, $j, $j + 1)
          si ($ch == "(") { $prof = $prof + 1 }
          si ($ch == ")") { $prof = $prof - 1 }
          si ($prof > 0) { $cond = $cond + $ch }
          $j = $j + 1
        }
        # Trouver le corps { ... }
        $prof = 0
        $trouve = 0
        $debut = $j
        tant_que ($j < longueur($src_proc3) et $trouve == 0) {
          $ch = sous_chaine($src_proc3, $j, $j + 1)
          si ($ch == "{") { $prof = $prof + 1 }
          si ($ch == "}") { $prof = $prof - 1 }
          si ($prof == 0 et $ch == "}") { $trouve = 1 }
          $j = $j + 1
        }
        si ($trouve == 1) {
          $fin_bloc = $j
          $corps = sous_chaine($src_proc3, $debut + 1, $fin_bloc - 1)
          $long = longueur($src_proc3)
          # Construire le contexte de variables (en ARRIERE : la derniere
          # valeur appendee est inseree en premier et gagne les remplacements)
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $cond_full = $cond + " // vars: " + $ctx
          } sinon {
            $cond_full = $cond
          }
          $cond_val = eval_expr($cond_full)
          $est_faux = 0
          si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
            $est_faux = 1
          }
          # Detecter une dependance de la condition a une variable connue
          # (marqueur : la substitution modifie le texte de la condition nue)
          $cond_var = 0
          $vq = 1
          tant_que ($vq <= $nb_vars) {
            si ($cond_var == 0) {
              $marque = substituer_nom($cond, $var_noms[$vq], "@SUB@")
              si ($marque != $cond) {
                $cond_var = 1
              }
            }
            $vq = $vq + 1
          }
          si ($est_faux == 1) {
            # Condition fausse : supprimer tout le bloc
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $apres
            $modifie_tq = 1
            $i = 0
          } sinon si ($cond_var == 0) {
            # Condition constante vraie : deplier une seule fois
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $corps + $apres
            $modifie_tq = 1
            $i = 0
          } sinon {
            # Condition pilotée par variable : execution sequentielle
            $unrolled_tq = ""
            $fini_tq = 0
            $n_iter_tq = 0
            tant_que ($fini_tq == 0 et $n_iter_tq < $iter_max_tq) {
              # Traiter le corps ligne par ligne
              $corps_out = ""
              $lp = 0
              tant_que ($lp < longueur($corps)) {
                # Trouver la fin de ligne
                $fl = $lp
                $a_fl = 0
                tant_que ($fl < longueur($corps) et $a_fl == 0) {
                  si (sous_chaine($corps, $fl, $fl + 1) == "\n") {
                    $a_fl = 1
                  } sinon {
                    $fl = $fl + 1
                  }
                }
                $ligne = sous_chaine($corps, $lp, $fl)
                # Premier caractere non blanc de la ligne
                $lc = 0
                tant_que ($lc < longueur($ligne) et (sous_chaine($ligne, $lc, $lc + 1) == " " ou sous_chaine($ligne, $lc, $lc + 1) == "\t")) {
                  $lc = $lc + 1
                }
                $consumé = 0
                # Detecter une affectation nue "nom = expr" (sans "var")
                $est_bare = 0
                $nom_bare = ""
                $la_b = $lc
                $fin_b = 0
                tant_que ($la_b < longueur($ligne) et $fin_b == 0) {
                  $ch = sous_chaine($ligne, $la_b, $la_b + 1)
                  si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                    $nom_bare = $nom_bare + $ch
                    $la_b = $la_b + 1
                  } sinon {
                    $fin_b = 1
                  }
                }
                $la_b2 = $la_b
                tant_que ($la_b2 < longueur($ligne) et sous_chaine($ligne, $la_b2, $la_b2 + 1) == " ") {
                  $la_b2 = $la_b2 + 1
                }
                si ($la_b2 < longueur($ligne) et sous_chaine($ligne, $la_b2, $la_b2 + 1) == "=" et longueur($nom_bare) > 0) {
                  $est_kw = 0
                  si ($nom_bare == "si") { $est_kw = 1 }
                  si ($nom_bare == "pour") { $est_kw = 1 }
                  si ($nom_bare == "tant_que") { $est_kw = 1 }
                  si ($nom_bare == "var") { $est_kw = 1 }
                  si ($nom_bare == "fn") { $est_kw = 1 }
                  si ($nom_bare == "retour") { $est_kw = 1 }
                  si ($est_kw == 0) {
                    $est_bare = 1
                  }
                }
                si ($est_bare == 1) {
                  $la_b = $la_b2 + 1
                  tant_que ($la_b < longueur($ligne) et sous_chaine($ligne, $la_b, $la_b + 1) == " ") {
                    $la_b = $la_b + 1
                  }
                  $expr_b = sous_chaine($ligne, $la_b, longueur($ligne))
                  si (longueur($expr_b) > 0) {
                    si (longueur($ctx) > 0) {
                      $expr_b_full = $expr_b + " // vars: " + $ctx
                    } sinon {
                      $expr_b_full = $expr_b
                    }
                    $val_b = eval_expr($expr_b_full)
                    joindre($var_noms, $nom_bare)
                    joindre($var_vals, $val_b)
                    $nb_vars = $nb_vars + 1
                  }
                  $consumé = 1
                }
                si ($consumé == 0) {
                  si ($lc + 3 < longueur($ligne)) {
                    si (sous_chaine($ligne, $lc, $lc + 1) == "v" et sous_chaine($ligne, $lc + 1, $lc + 2) == "a" et sous_chaine($ligne, $lc + 2, $lc + 3) == "r" et sous_chaine($ligne, $lc + 3, $lc + 4) == " ") {
                    # Affectation : var nom = expr
                    $la = $lc + 4
                    $nom_l = ""
                    tant_que ($la < longueur($ligne)) {
                      $ch = sous_chaine($ligne, $la, $la + 1)
                      si ($ch == " " ou $ch == "=") {
                        $la = longueur($ligne) + 1
                      } sinon {
                        $nom_l = $nom_l + $ch
                        $la = $la + 1
                      }
                    }
                    $la = $lc + 4
                    tant_que ($la < longueur($ligne) et sous_chaine($ligne, $la, $la + 1) != "=") {
                      $la = $la + 1
                    }
                    $la = $la + 1
                    tant_que ($la < longueur($ligne) et sous_chaine($ligne, $la, $la + 1) == " ") {
                      $la = $la + 1
                    }
                    $expr_l = sous_chaine($ligne, $la, longueur($ligne))
                    si (longueur($nom_l) > 0 et longueur($expr_l) > 0) {
                      si (longueur($ctx) > 0) {
                        $expr_l_full = $expr_l + " // vars: " + $ctx
                      } sinon {
                        $expr_l_full = $expr_l
                      }
                      $val_l = eval_expr($expr_l_full)
                      # Shadowing : on ajoute (la derniere valeur fait foi)
                      joindre($var_noms, $nom_l)
                      joindre($var_vals, $val_l)
                      $nb_vars = $nb_vars + 1
                    }
                    $consumé = 1
                  }
                }
                si ($consumé == 0) {
                  si ($lc + 1 < longueur($ligne)) {
                    si (sous_chaine($ligne, $lc, $lc + 1) == ">" et sous_chaine($ligne, $lc + 1, $lc + 2) == ">") {
                      # Affichage : >> expr -> literaliser
                      $ja = $lc + 2
                      tant_que ($ja < longueur($ligne) et sous_chaine($ligne, $ja, $ja + 1) == " ") {
                        $ja = $ja + 1
                      }
                      $expr_a = sous_chaine($ligne, $ja, longueur($ligne))
                      si (longueur($expr_a) > 0) {
                        si (longueur($ctx) > 0) {
                          $expr_a_full = $expr_a + " // vars: " + $ctx
                        } sinon {
                          $expr_a_full = $expr_a
                        }
                        $val_a = eval_expr($expr_a_full)
                        $corps_out = $corps_out + '>> "' + $val_a + '"' + "\n"
                      }
                      $consumé = 1
                    }
                  }
                }
                }
                si ($consumé == 0) {
                  # Autre ligne : substitution textuelle de toutes les variables
                  # (en ARRIERE : la valeur la plus recente fait foi)
                  $ligne_sub = $ligne
                  $li2 = $nb_vars
                  tant_que ($li2 >= 1) {
                    $ligne_sub = substituer_nom($ligne_sub, $var_noms[$li2], $var_vals[$li2])
                    $li2 = $li2 - 1
                  }
                  $corps_out = $corps_out + $ligne_sub + "\n"
                }
                $lp = $fl + 1
              }
              $unrolled_tq = $unrolled_tq + $corps_out
              # Re-evaluer la condition avec le stockage mis a jour
              # (contexte en ARRIERE : la derniere valeur appendee gagne)
              $ctx = ""
              $vi = 1
              tant_que ($vi <= $nb_vars) {
                $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
                $vi = $vi + 1
              }
              si (longueur($ctx) > 0) {
                $cond_full = $cond + " // vars: " + $ctx
              } sinon {
                $cond_full = $cond
              }
              $cond_val = eval_expr($cond_full)
              si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
                $fini_tq = 1
              }
              $n_iter_tq = $n_iter_tq + 1
            }
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $unrolled_tq + $apres
            $modifie_tq = 1
            $i = 0
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc3

# Pretraitement si : evaluer les conditions constantes et supprimer les branches
# non prises. Gere si (cond) { ... }, si (cond) { ... } sinon { ... } et les
# chaines "sinon si (...) { ... }".
$src_proc = $src_proc3
$modifie = 1
tant_que ($modifie == 1) {
  $modifie = 0
  $i = 0
  tant_que ($i < longueur($src_proc)) {
    $c1 = ""
    $c2 = ""
    si ($i < longueur($src_proc)) { $c1 = sous_chaine($src_proc, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc)) { $c2 = sous_chaine($src_proc, $i + 1, $i + 2) }
    si ($c1 == "s" et $c2 == "i") {
      $next = ""
      si ($i + 2 < longueur($src_proc)) { $next = sous_chaine($src_proc, $i + 2, $i + 3) }
      si ($next == " " ou $next == "(") {
        $j = $i + 2
        tant_que ($j < longueur($src_proc) et sous_chaine($src_proc, $j, $j + 1) == " ") {
          $j = $j + 1
        }
        si ($j < longueur($src_proc) et sous_chaine($src_proc, $j, $j + 1) == "(") {
          $j = $j + 1
          $cond = ""
          $prof = 1
          tant_que ($j < longueur($src_proc) et $prof > 0) {
            $ch = sous_chaine($src_proc, $j, $j + 1)
            si ($ch == "(") { $prof = $prof + 1 }
            si ($ch == ")") { $prof = $prof - 1 }
            si ($prof > 0) { $cond = $cond + $ch }
            $j = $j + 1
          }
          # Contexte de variables (en ARRIERE : la derniere valeur gagne)
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $cond_full = $cond + " // vars: " + $ctx
          } sinon {
            $cond_full = $cond
          }
          $cond_val = eval_expr($cond_full)
          $est_faux = 0
          si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
            $est_faux = 1
          }
          # Trouver le bloc { ... } du si
          $prof = 0
          $trouve = 0
          $debut = $j
          tant_que ($j < longueur($src_proc) et $trouve == 0) {
            $ch = sous_chaine($src_proc, $j, $j + 1)
            si ($ch == "{") { $prof = $prof + 1 }
            si ($ch == "}") { $prof = $prof - 1 }
            si ($prof == 0 et $ch == "}") { $trouve = 1 }
            $j = $j + 1
          }
          si ($trouve == 1) {
            $fin_bloc = $j
            $long = longueur($src_proc)
            # Detecter un "sinon" juste apres le bloc du si
            $q = $fin_bloc
            tant_que ($q < $long et (sous_chaine($src_proc, $q, $q + 1) == " " ou sous_chaine($src_proc, $q, $q + 1) == "\n" ou sous_chaine($src_proc, $q, $q + 1) == "\t")) {
              $q = $q + 1
            }
            $sinon_ici = 0
            si ($q + 4 < $long) {
              si (sous_chaine($src_proc, $q, $q + 1) == "s" et sous_chaine($src_proc, $q + 1, $q + 2) == "i" et sous_chaine($src_proc, $q + 2, $q + 3) == "n" et sous_chaine($src_proc, $q + 3, $q + 4) == "o" et sous_chaine($src_proc, $q + 4, $q + 5) == "n") {
                $sinon_ici = 1
              }
            }
            si ($sinon_ici == 0) {
              # Pas de sinon
              si ($est_faux == 1) {
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $fin_bloc, $long)
                $src_proc = $avant + $apres
                $modifie = 1
                $i = 0
              } sinon {
                $corps = sous_chaine($src_proc, $debut + 1, $fin_bloc - 1)
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $fin_bloc, $long)
                $src_proc = $avant + $corps + $apres
                $modifie = 1
                $i = 0
              }
            } sinon {
              # Un sinon est present : bloc simple ou "sinon si" ?
              $q2 = $q + 5
              tant_que ($q2 < $long et (sous_chaine($src_proc, $q2, $q2 + 1) == " " ou sous_chaine($src_proc, $q2, $q2 + 1) == "\n" ou sous_chaine($src_proc, $q2, $q2 + 1) == "\t")) {
                $q2 = $q2 + 1
              }
              $sinon_si = 0
              si ($q2 + 3 < $long) {
                si (sous_chaine($src_proc, $q2, $q2 + 1) == "s" et sous_chaine($src_proc, $q2 + 1, $q2 + 2) == "i") {
                  $suivant = ""
                  si ($q2 + 2 < $long) { $suivant = sous_chaine($src_proc, $q2 + 2, $q2 + 3) }
                  si ($suivant == " " ou $suivant == "(") {
                    $sinon_si = 1
                  }
                }
              }
              si ($est_faux == 1) {
                si ($sinon_si == 1) {
                  # Faux avec "sinon si" : garder le si suivant pour re-traitement
                  $avant = sous_chaine($src_proc, 0, $i)
                  $apres = sous_chaine($src_proc, $q2, $long)
                  $src_proc = $avant + $apres
                  $modifie = 1
                  $i = 0
                } sinon {
                  # Faux avec sinon bloc : garder le corps du sinon, supprimer le reste
                  $jj = $q2
                  tant_que ($jj < $long et sous_chaine($src_proc, $jj, $jj + 1) != "{") {
                    $jj = $jj + 1
                  }
                  $prof2 = 1
                  $jj = $jj + 1
                  tant_que ($jj < $long et $prof2 > 0) {
                    $ch = sous_chaine($src_proc, $jj, $jj + 1)
                    si ($ch == "{") { $prof2 = $prof2 + 1 }
                    si ($ch == "}") { $prof2 = $prof2 - 1 }
                    $jj = $jj + 1
                  }
                  $fin_sinon = $jj
                  $corps_sinon = sous_chaine($src_proc, $q2 + 1, $fin_sinon - 1)
                  $avant = sous_chaine($src_proc, 0, $i)
                  $apres = sous_chaine($src_proc, $fin_sinon, $long)
                  $src_proc = $avant + $corps_sinon + $apres
                  $modifie = 1
                  $i = 0
                }
              } sinon {
                # Vrai : supprimer TOUTE la chaine de sinon (si ... ou bloc)
                $pos = $fin_bloc
                $encore = 1
                tant_que ($encore == 1) {
                  $qq = $pos
                  tant_que ($qq < $long et (sous_chaine($src_proc, $qq, $qq + 1) == " " ou sous_chaine($src_proc, $qq, $qq + 1) == "\n" ou sous_chaine($src_proc, $qq, $qq + 1) == "\t")) {
                    $qq = $qq + 1
                  }
                  $a_sinon = 0
                  si ($qq + 4 < $long) {
                    si (sous_chaine($src_proc, $qq, $qq + 1) == "s" et sous_chaine($src_proc, $qq + 1, $qq + 2) == "i" et sous_chaine($src_proc, $qq + 2, $qq + 3) == "n" et sous_chaine($src_proc, $qq + 3, $qq + 4) == "o" et sous_chaine($src_proc, $qq + 4, $qq + 5) == "n") {
                      $a_sinon = 1
                    }
                  }
                  si ($a_sinon == 0) {
                    $encore = 0
                  } sinon {
                    $qq2 = $qq + 5
                    tant_que ($qq2 < $long et (sous_chaine($src_proc, $qq2, $qq2 + 1) == " " ou sous_chaine($src_proc, $qq2, $qq2 + 1) == "\n" ou sous_chaine($src_proc, $qq2, $qq2 + 1) == "\t")) {
                      $qq2 = $qq2 + 1
                    }
                    $sinon_si2 = 0
                    si ($qq2 + 3 < $long) {
                      si (sous_chaine($src_proc, $qq2, $qq2 + 1) == "s" et sous_chaine($src_proc, $qq2 + 1, $qq2 + 2) == "i") {
                        $suivant2 = ""
                        si ($qq2 + 2 < $long) { $suivant2 = sous_chaine($src_proc, $qq2 + 2, $qq2 + 3) }
                        si ($suivant2 == " " ou $suivant2 == "(") {
                          $sinon_si2 = 1
                        }
                      }
                    }
                    si ($sinon_si2 == 1) {
                      # Consommer "si (cond) { ... }"
                      $jj2 = $qq2 + 2
                      tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) == " ") {
                        $jj2 = $jj2 + 1
                      }
                      si ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) == "(") {
                        $jj2 = $jj2 + 1
                        $prof2 = 1
                        tant_que ($jj2 < $long et $prof2 > 0) {
                          $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                          si ($ch == "(") { $prof2 = $prof2 + 1 }
                          si ($ch == ")") { $prof2 = $prof2 - 1 }
                          $jj2 = $jj2 + 1
                        }
                        tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) != "{") {
                          $jj2 = $jj2 + 1
                        }
                        $prof2 = 1
                        $jj2 = $jj2 + 1
                        tant_que ($jj2 < $long et $prof2 > 0) {
                          $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                          si ($ch == "{") { $prof2 = $prof2 + 1 }
                          si ($ch == "}") { $prof2 = $prof2 - 1 }
                          $jj2 = $jj2 + 1
                        }
                        $pos = $jj2
                      } sinon {
                        $encore = 0
                      }
                    } sinon {
                      # Consommer "{ ... }"
                      $jj2 = $qq2
                      tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) != "{") {
                        $jj2 = $jj2 + 1
                      }
                      $prof2 = 1
                      $jj2 = $jj2 + 1
                      tant_que ($jj2 < $long et $prof2 > 0) {
                        $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                        si ($ch == "{") { $prof2 = $prof2 + 1 }
                        si ($ch == "}") { $prof2 = $prof2 - 1 }
                        $jj2 = $jj2 + 1
                      }
                      $pos = $jj2
                    }
                  }
                }
                $corps = sous_chaine($src_proc, $debut + 1, $fin_bloc - 1)
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $pos, $long)
                $src_proc = $avant + $corps + $apres
                $modifie = 1
                $i = 0
              }
            }
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc

# Pretraitement pour : deplier les boucles "pour N de D vers F" a la compilation
# Semantique moteur : borne superieure EXCLUSIVE (de 1 vers 5 -> 1,2,3,4)
$src_proc4 = $src_proc
$modifie_pr = 1
$iter_max_pr = 10000
tant_que ($modifie_pr == 1) {
  $modifie_pr = 0
  $i = 0
  tant_que ($i < longueur($src_proc4)) {
    # Detecter "pour "
    $c1 = ""
    $c2 = ""
    $c3 = ""
    $c4 = ""
    $c5 = ""
    si ($i < longueur($src_proc4)) { $c1 = sous_chaine($src_proc4, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc4)) { $c2 = sous_chaine($src_proc4, $i + 1, $i + 2) }
    si ($i + 2 < longueur($src_proc4)) { $c3 = sous_chaine($src_proc4, $i + 2, $i + 3) }
    si ($i + 3 < longueur($src_proc4)) { $c4 = sous_chaine($src_proc4, $i + 3, $i + 4) }
    si ($i + 4 < longueur($src_proc4)) { $c5 = sous_chaine($src_proc4, $i + 4, $i + 5) }
    si ($c1 == "p" et $c2 == "o" et $c3 == "u" et $c4 == "r" et $c5 == " ") {
      $j = $i + 5
      # Lire le nom de la variable de boucle (nom nu : alphanumerique + _)
      $nom_pr = ""
      $fin_nom = 0
      tant_que ($j < longueur($src_proc4) et $fin_nom == 0) {
        $ch = sous_chaine($src_proc4, $j, $j + 1)
        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
          $nom_pr = $nom_pr + $ch
          $j = $j + 1
        } sinon {
          $fin_nom = 1
        }
      }
      # Passer les espaces puis chercher "de "
      $j2 = $j
      tant_que ($j2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == " ") {
        $j2 = $j2 + 1
      }
      $a_de = 0
      si ($j2 + 2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == "d" et sous_chaine($src_proc4, $j2 + 1, $j2 + 2) == "e" et sous_chaine($src_proc4, $j2 + 2, $j2 + 3) == " ") {
        $a_de = 1
      }
      si ($a_de == 1 et longueur($nom_pr) > 0) {
        $j2 = $j2 + 3
        tant_que ($j2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == " ") {
          $j2 = $j2 + 1
        }
        # Extraire expr1 jusqu'a " vers " (sequence v e r s delimitee par des espaces)
        $expr1 = ""
        $trouve_vers = 0
        $k2 = $j2
        tant_que ($k2 < longueur($src_proc4) et $trouve_vers == 0) {
          si ($k2 + 4 < longueur($src_proc4) et sous_chaine($src_proc4, $k2, $k2 + 1) == " " et sous_chaine($src_proc4, $k2 + 1, $k2 + 2) == "v" et sous_chaine($src_proc4, $k2 + 2, $k2 + 3) == "e" et sous_chaine($src_proc4, $k2 + 3, $k2 + 4) == "r" et sous_chaine($src_proc4, $k2 + 4, $k2 + 5) == "s" et sous_chaine($src_proc4, $k2 + 5, $k2 + 6) == " ") {
            $trouve_vers = 1
            $k2 = $k2 + 6
          } sinon {
            $expr1 = $expr1 + sous_chaine($src_proc4, $k2, $k2 + 1)
            $k2 = $k2 + 1
          }
        }
        si ($trouve_vers == 1) {
          # Extraire expr2 jusqu'a "{"
          $expr2 = ""
          $k3 = $k2
          $trouve_acc = 0
          tant_que ($k3 < longueur($src_proc4) et $trouve_acc == 0) {
            $ch = sous_chaine($src_proc4, $k3, $k3 + 1)
            si ($ch == "{") {
              $trouve_acc = 1
            } sinon {
              si ($ch != " " et $ch != "\n" et $ch != "\t") {
                $expr2 = $expr2 + $ch
              }
              $k3 = $k3 + 1
            }
          }
          si ($trouve_acc == 1) {
            # Trouver le corps { ... }
            $prof = 0
            $trouve_fb = 0
            $debut_pr = $k3
            $k4 = $k3
            tant_que ($k4 < longueur($src_proc4) et $trouve_fb == 0) {
              $ch = sous_chaine($src_proc4, $k4, $k4 + 1)
              si ($ch == "{") { $prof = $prof + 1 }
              si ($ch == "}") { $prof = $prof - 1 }
              si ($prof == 0 et $ch == "}") { $trouve_fb = 1 }
              $k4 = $k4 + 1
            }
            si ($trouve_fb == 1) {
              $fin_pr = $k4
              $corps_pr = sous_chaine($src_proc4, $debut_pr + 1, $fin_pr - 1)
              # Evaluer les bornes avec le contexte de variables
              # (en ARRIERE : la derniere valeur appendee gagne)
              $ctx = ""
              $vi = 1
              tant_que ($vi <= $nb_vars) {
                $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
                $vi = $vi + 1
              }
              # Pre-substituer les variables connues dans les bornes
              $e1_sub = $expr1
              $e2_sub = $expr2
              $vi = $nb_vars
              tant_que ($vi >= 1) {
                $e1_sub = substituer_nom($e1_sub, $var_noms[$vi], $var_vals[$vi])
                $e2_sub = substituer_nom($e2_sub, $var_noms[$vi], $var_vals[$vi])
                $vi = $vi - 1
              }
              si (longueur($ctx) > 0) {
                $e1_full = $e1_sub + " // vars: " + $ctx
                $e2_full = $e2_sub + " // vars: " + $ctx
              } sinon {
                $e1_full = $e1_sub
                $e2_full = $e2_sub
              }
              $d1 = eval_expr($e1_full)
              $f2 = eval_expr($e2_full)
              # Verifier que les bornes sont numeriques
              $bornes_ok = 1
              $kc = 0
              tant_que ($kc < longueur($d1)) {
                $chc = sous_chaine($d1, $kc, $kc + 1)
                si (($chc < "0" ou $chc > "9") et $kc > 0) {
                  $bornes_ok = 0
                }
                si ($kc == 0 et $chc != "-" et ($chc < "0" ou $chc > "9")) {
                  $bornes_ok = 0
                }
                $kc = $kc + 1
              }
              $kc = 0
              tant_que ($kc < longueur($f2)) {
                $chc = sous_chaine($f2, $kc, $kc + 1)
                si (($chc < "0" ou $chc > "9") et $kc > 0) {
                  $bornes_ok = 0
                }
                si ($kc == 0 et $chc != "-" et ($chc < "0" ou $chc > "9")) {
                  $bornes_ok = 0
                }
                $kc = $kc + 1
              }
              si ($bornes_ok == 1) {
                # Deplier : remplacer le nom de boucle par sa valeur dans le corps
                $unrolled = ""
                $valeur = $d1
                $n_iter = 0
                $fini = 0
                tant_que ($fini == 0 et $n_iter < $iter_max_pr) {
                  $cmp_full = $valeur + " < " + $f2
                  si (longueur($ctx) > 0) {
                    $cmp_full = $cmp_full + " // vars: " + $ctx
                  }
                  $cmp_val = eval_expr($cmp_full)
                  si ($cmp_val == "vrai" ou $cmp_val == "1") {
                    # Collecter les noms assignes dans ce corps
                    $assigns_pr = ""
                    $ap2 = 0
                    $nb_corps2 = longueur($corps_pr)
                    tant_que ($ap2 < $nb_corps2) {
                      $flp = $ap2
                      $af = 0
                      tant_que ($flp < $nb_corps2 et $af == 0) {
                        si (sous_chaine($corps_pr, $flp, $flp + 1) == "\n") { $af = 1 } sinon { $flp = $flp + 1 }
                      }
                      $lnp = sous_chaine($corps_pr, $ap2, $flp)
                      $lcp = 0
                      tant_que ($lcp < longueur($lnp) et (sous_chaine($lnp, $lcp, $lcp + 1) == " " ou sous_chaine($lnp, $lcp, $lcp + 1) == "\t")) { $lcp = $lcp + 1 }
                      $nom_p2 = ""
                      $lap = $lcp
                      $finp = 0
                      tant_que ($lap < longueur($lnp) et $finp == 0) {
                        $ch = sous_chaine($lnp, $lap, $lap + 1)
                        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                          $nom_p2 = $nom_p2 + $ch
                          $lap = $lap + 1
                        } sinon {
                          $finp = 1
                        }
                      }
                      $lap2 = $lap
                      tant_que ($lap2 < longueur($lnp) et sous_chaine($lnp, $lap2, $lap2 + 1) == " ") { $lap2 = $lap2 + 1 }
                      si ($lap2 < longueur($lnp) et sous_chaine($lnp, $lap2, $lap2 + 1) == "=" et longueur($nom_p2) > 0) {
                        $assigns_pr = $assigns_pr + $nom_p2 + " "
                      }
                      $ap2 = $flp + 1
                    }
                    # contexte de cette iteration
                    $ctx_it = $ctx
                    si (longueur($nom_pr) > 0) {
                      $ctx_it = $nom_pr + "=" + $valeur + " " + $ctx
                    }
                    # Deplier le corps ligne par ligne
                    $sub_it = ""
                    $lp2 = 0
                    $nb_corps = longueur($corps_pr)
                    tant_que ($lp2 < $nb_corps) {
                      $fl2 = $lp2
                      $a_fl2 = 0
                      tant_que ($fl2 < $nb_corps et $a_fl2 == 0) {
                        si (sous_chaine($corps_pr, $fl2, $fl2 + 1) == "\n") {
                          $a_fl2 = 1
                        } sinon {
                          $fl2 = $fl2 + 1
                        }
                      }
                      $ligne2 = sous_chaine($corps_pr, $lp2, $fl2)
                      $lc2 = 0
                      tant_que ($lc2 < longueur($ligne2) et (sous_chaine($ligne2, $lc2, $lc2 + 1) == " " ou sous_chaine($ligne2, $lc2, $lc2 + 1) == "\t")) {
                        $lc2 = $lc2 + 1
                      }
                      $conso2 = 0
                      si ($lc2 + 1 < longueur($ligne2)) {
                        si (sous_chaine($ligne2, $lc2, $lc2 + 1) == ">" et sous_chaine($ligne2, $lc2 + 1, $lc2 + 2) == ">") {
                          $ja2 = $lc2 + 2
                          tant_que ($ja2 < longueur($ligne2) et sous_chaine($ligne2, $ja2, $ja2 + 1) == " ") {
                            $ja2 = $ja2 + 1
                          }
                          $expr_a2 = sous_chaine($ligne2, $ja2, longueur($ligne2))
                          si (longueur($expr_a2) > 0) {
                            # literaliser seulement si depend d'une var assignee
                            $lit = 0
                            $probe = $expr_a2
                            $cur = ""
                            $ki = 0
                            $nass = longueur($assigns_pr)
                            tant_que ($ki < $nass) {
                              $ch = sous_chaine($assigns_pr, $ki, $ki + 1)
                              si ($ch == " ") {
                                si (longueur($cur) > 0) {
                                  $probe2 = substituer_nom($probe, $cur, "@A@")
                                  si ($probe2 != $probe) { $lit = 1 }
                                  $probe = $probe2
                                }
                                $cur = ""
                              } sinon {
                                $cur = $cur + $ch
                              }
                              $ki = $ki + 1
                            }
                            si (longueur($cur) > 0) {
                              $probe2 = substituer_nom($probe, $cur, "@A@")
                              si ($probe2 != $probe) { $lit = 1 }
                            }
                            si ($lit == 1) {
                              si (longueur($ctx_it) > 0) {
                                $ea_full = $expr_a2 + " // vars: " + $ctx_it
                              } sinon {
                                $ea_full = $expr_a2
                              }
                              $val_a2 = eval_expr($ea_full)
                              $sub_it = $sub_it + '>> "' + $val_a2 + '"' + "\n"
                            } sinon {
                              $expr_sub2 = $expr_a2
                              $expr_sub2 = substituer_nom($expr_sub2, $nom_pr, $valeur)
                              $li4 = $nb_vars
                              tant_que ($li4 >= 1) {
                                $expr_sub2 = substituer_nom($expr_sub2, $var_noms[$li4], $var_vals[$li4])
                                $li4 = $li4 - 1
                              }
                              $sub_it = $sub_it + ">> " + $expr_sub2 + "\n"
                            }
                          }
                          $conso2 = 1
                        }
                      }
                      si ($conso2 == 0) {
                        # detecter affectation nue
                        $trim2 = $ligne2
                        $lt2 = 0
                        tant_que ($lt2 < longueur($trim2) et (sous_chaine($trim2, $lt2, $lt2 + 1) == " " ou sous_chaine($trim2, $lt2, $lt2 + 1) == "\t")) {
                          $lt2 = $lt2 + 1
                        }
                        $nom_a2 = ""
                        $la2 = $lt2
                        $fin_na2 = 0
                        tant_que ($la2 < longueur($trim2) et $fin_na2 == 0) {
                          $ch = sous_chaine($trim2, $la2, $la2 + 1)
                          si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                            $nom_a2 = $nom_a2 + $ch
                            $la2 = $la2 + 1
                          } sinon {
                            $fin_na2 = 1
                          }
                        }
                        $la3 = $la2
                        tant_que ($la3 < longueur($trim2) et sous_chaine($trim2, $la3, $la3 + 1) == " ") {
                          $la3 = $la3 + 1
                        }
                        $est_aff2 = 0
                        si ($la3 < longueur($trim2)) {
                          si (sous_chaine($trim2, $la3, $la3 + 1) == "=") {
                            $est_aff2 = 1
                          }
                        }
                        si ($est_aff2 == 1 et longueur($nom_a2) > 0) {
                          $kx2 = $la3 + 1
                          tant_que ($kx2 < longueur($trim2) et sous_chaine($trim2, $kx2, $kx2 + 1) == " ") {
                            $kx2 = $kx2 + 1
                          }
                          $expr_a2b = sous_chaine($trim2, $kx2, longueur($trim2))
                          si (longueur($ctx_it) > 0) {
                            $ea2_full = $expr_a2b + " // vars: " + $ctx_it
                          } sinon {
                            $ea2_full = $expr_a2b
                          }
                          $val_a2b = eval_expr($ea2_full)
                          $ctx_it = $ctx_it + " " + $nom_a2 + "=" + $val_a2b
                        } sinon {
                          $ligne_s2 = $ligne2
                          $ligne_s2 = substituer_nom($ligne_s2, $nom_pr, $valeur)
                          $li4 = $nb_vars
                          tant_que ($li4 >= 1) {
                            $ligne_s2 = substituer_nom($ligne_s2, $var_noms[$li4], $var_vals[$li4])
                            $li4 = $li4 - 1
                          }
                          $sub_it = $sub_it + $ligne_s2 + "\n"
                        }
                      }
                      $lp2 = $fl2 + 1
                    }
                    $unrolled = $unrolled + $sub_it
                    $valeur = eval_expr($valeur + " + 1")
                    $n_iter = $n_iter + 1
                  } sinon {
                    $fini = 1
                  }
                }
                # Remplacer le bloc pour par les iterations depliees
                $avant = sous_chaine($src_proc4, 0, $i)
                $apres = sous_chaine($src_proc4, $fin_pr, longueur($src_proc4))
                $src_proc4 = $avant + $unrolled + $apres
                $modifie_pr = 1
                $i = 0
              }
            }
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc4

# Post-traitement : evaluer numeriquement chaque ligne ">> <expr>" deja
# substituee (les noms ont ete remplaces plus tot), pour que les appels
# recursifs plies reviennent a des nombres.
$k = 0
$modif_num = 1
tant_que ($modif_num == 1) {
  $modif_num = 0
  $j = $k
  # trouver la prochaine ">> "
  $pos_g = -1
  $kk = $j
  tant_que ($kk + 3 <= longueur($src)) {
    si (sous_chaine($src, $kk, $kk + 3) == ">> ") {
      $pos_g = $kk
      $kk = longueur($src)
    } sinon {
      $kk = $kk + 1
    }
  }
  si ($pos_g < 0) {
    $k = longueur($src)
  } sinon {
    # avancer les espaces
    $p2 = $pos_g + 3
    tant_que ($p2 < longueur($src) et sous_chaine($src, $p2, $p2 + 1) == " ") { $p2 = $p2 + 1 }
    # lire l'expression jusqu'a \n
    $e2 = ""
    $p3 = $p2
    $fin_l2 = $p2
    $fini_l2 = 0
    tant_que ($p3 < longueur($src) et $fini_l2 == 0) {
      $cch = sous_chaine($src, $p3, $p3 + 1)
      si ($cch == "\n") {
        $fin_l2 = $p3
        $fini_l2 = 1
      } sinon {
        $e2 = $e2 + $cch
        $p3 = $p3 + 1
      }
    }
    $fin_l2 = $p3
    # evaluer via eval_expr, avec le contexte des variables connues
    $ctx2 = ""
    $vw = 1
    tant_que ($vw <= $nb_vars) {
      $ctx2 = $ctx2 + $var_noms[$vw] + "=" + $var_vals[$vw] + " "
      $vw = $vw + 1
    }
    si (longueur($ctx2) > 0) {
      $res2 = eval_expr($e2 + " // vars: " + $ctx2)
    } sinon {
      $res2 = eval_expr($e2)
    }
        si (longueur($res2) > 0 et $res2 != $e2) {
      $avant2 = sous_chaine($src, 0, $pos_g)
      $apres2 = sous_chaine($src, $fin_l2, longueur($src))
      $src = $avant2 + ">> " + $res2 + $apres2
      $p4 = $pos_g + 3 + longueur($res2)
      $fini_p4 = 0
      tant_que ($p4 < longueur($src) et $fini_p4 == 0) {
        si (sous_chaine($src, $p4, $p4 + 1) == "\n") { $fini_p4 = 1 } sinon { $p4 = $p4 + 1 }
      }
      $k = $p4
      $modif_num = 1
    } sinon {
      $k = $fin_l2
    }
  }
}

# Extraire et evaluer toutes les expressions apres >>
$affichage = ""
$i = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  $c2 = ""
  $c3 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  # Detecter "var " (deja traite en preprocessing, skip)
  si ($c1 == "v" et $c2 == "a" et $c3 == "r") {
    $i = $i + 1
  } sinon si ($c1 == ">" et $c2 == ">") {
    $j = $i + 2
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    # Extraire l'expression jusqu'a la fin de ligne
    $expr = ""
    $k = $j
    tant_que ($k < longueur($src)) {
      $ch = sous_chaine($src, $k, $k + 1)
      si ($ch == "\n") {
        $k = longueur($src) + 1
      } sinon {
        $expr = $expr + $ch
        $k = $k + 1
      }
    }
    si (longueur($expr) > 0) {
      # Verifier si c'est un nom de variable connu (en ARRIERE :
      # la valeur la plus recente fait foi apres le shadowing)
      $est_var = 0
      $vi = $nb_vars
      tant_que ($vi >= 1) {
        si ($est_var == 0) {
          si ($var_noms[$vi] == $expr) {
            $est_var = 1
            $resultat = $var_vals[$vi]
          }
        }
        $vi = $vi - 1
      }
      si ($est_var == 0) {
        # Si l'expression est deja un appel eval_expr(...) , evaluer directement.
        $est_ee = 0
        si (longueur($expr) >= 11) {
          si (sous_chaine($expr, 0, 10) == "eval_expr(") {
            $est_ee = 1
          }
        }
        si ($est_ee == 1) {
          # Extraire l'argument de eval_expr(...) : sous_chaine entre ( et ) final
          $j0 = 10
          $n0 = longueur($expr)
          # $expr = "eval_expr(<arg>)"
          $nb_arg = 0
          $k0 = $j0
          $cur = ""
          $prof0 = 0
          $fini0 = 0
          $arg_ee = ""
          tant_que ($k0 < $n0 et $fini0 == 0) {
            $cc = sous_chaine($expr, $k0, $k0 + 1)
            si ($cc == "(" ou $cc == "[" ou $cc == "{") {
              $prof0 = $prof0 + 1
              $cur = $cur + $cc
            } sinon si ($cc == ")" ou $cc == "]" ou $cc == "}") {
              si ($prof0 == 0) {
                $fini0 = 1
              } sinon {
                $prof0 = $prof0 - 1
                $cur = $cur + $cc
              }
            } sinon {
              $cur = $cur + $cc
            }
            $k0 = $k0 + 1
          }
          # trim
          $nbcur = longueur($cur)
          tant_que ($nbcur > 0 et sous_chaine($cur, 0, 1) == " ") { $cur = sous_chaine($cur, 1, longueur($cur)); $nbcur = longueur($cur) }
          $nbcur = longueur($cur)
          tant_que ($nbcur > 0 et sous_chaine($cur, $nbcur - 1, $nbcur) == " ") { $cur = sous_chaine($cur, 0, $nbcur - 1); $nbcur = longueur($cur) }
          $arg_ee = $cur
          # si l'arg commence par " et finit par ", decaper
          $nb_arg = longueur($arg_ee)
          si ($nb_arg >= 2) {
            $f1 = sous_chaine($arg_ee, 0, 1)
            $f2 = sous_chaine($arg_ee, $nb_arg - 1, $nb_arg)
            si ($f1 == "\"" et $f2 == "\"") {
              $arg_ee = sous_chaine($arg_ee, 1, $nb_arg - 1)
            }
          }
          $resultat = eval_expr($arg_ee)
                  } sinon {
          # Construire le contexte de variables (en AVANT : la derniere
          # valeur appendee fait foi via la substitution par paires_prelude).
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $expr_full = $expr + " // vars: " + $ctx
          } sinon {
            $expr_full = $expr
          }
          $resultat = eval_expr($expr_full)
        }
      }
      $affichage = $affichage + $resultat + "\n"
    }
  }
  $i = $i + 1
}
si (longueur($affichage) == 0) {
  afficher_erreur("emetteur_elf : pas de >> <expression> trouve")
  quitter(1)
}
emettre_elf_print($sortie, $affichage)
