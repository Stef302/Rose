# emetteur_elf.rose — Émetteur ELF64 natif pour Rose.
# Génère un binaire ELF exécutable autonome à partir d'un programme Rose.
# Zéro dépendance externe : pas de rustc, pas de clang, pas de LLVM.
# Utilisation : rose/rose run compilateur/emetteur_elf.rose prog.rose -o sortie

# ── Utilitaires d'écriture little-endian ──

fn u8le($v: entier) -> chaine {
  retour sous_chaine(chaine($v % 256), 0, 1)
}

fn u16le($v: entier) -> chaine {
  $b0 = $v % 256
  $b1 = ($v / 256) % 256
  retour sous_chaine(chaine($b0), 0, 1) + sous_chaine(chaine($b1), 0, 1)
}

fn u32le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = $v / 256
  $b1 = $v1 % 256
  $v2 = $v1 / 256
  $b2 = $v2 % 256
  $v3 = $v2 / 256
  $b3 = $v3 % 256
  retour sous_chaine(chaine($b0), 0, 1) + sous_chaine(chaine($b1), 0, 1) + sous_chaine(chaine($b2), 0, 1) + sous_chaine(chaine($b3), 0, 1)
}

fn u64le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = $v / 256
  $b1 = $v1 % 256
  $v2 = $v1 / 256
  $b2 = $v2 % 256
  $v3 = $v2 / 256
  $b3 = $v3 % 256
  $v4 = $v3 / 256
  $b4 = $v4 % 256
  $v5 = $v4 / 256
  $b5 = $v5 % 256
  $v6 = $v5 / 256
  $b6 = $v6 % 256
  $v7 = $v6 / 256
  $b7 = $v7 % 256
  retour sous_chaine(chaine($b0), 0, 1) + sous_chaine(chaine($b1), 0, 1) + sous_chaine(chaine($b2), 0, 1) + sous_chaine(chaine($b3), 0, 1) + sous_chaine(chaine($b4), 0, 1) + sous_chaine(chaine($b5), 0, 1) + sous_chaine(chaine($b6), 0, 1) + sous_chaine(chaine($b7), 0, 1)
}

# ── Constantes ELF64 ──
$ELFMAG = "\177ELF"
$ELFCLASS64 = 2
$ELFDATA2LSB = 1
$EV_CURRENT = 1
$ELFOSABI_SYSV = 0
$ET_EXEC = 2
$EM_AARCH64 = 183
$PT_LOAD = 1
$PF_R = 4
$PF_W = 2
$PF_X = 1
$SHT_NULL = 0
$SHT_PROGBITS = 1
$SHT_STRTAB = 3
$SHN_UNDEF = 0

# Adresse de chargement aarch64
$BASE_ADDR = 0x400000
$TEXT_OFFSET = 0x1000
$TEXT_ADDR = $BASE_ADDR + $TEXT_OFFSET

# ── Émetteur ELF minimal : produit un binaire qui retourne 0 ──
fn emettre_elf_minimal($sortie: chaine) {
  $out = ""

  # ── ELF header (64 octets) ──
  $out = $out + $ELFMAG                                    # e_ident[0..3]
  $out = $out + sous_chaine(chaine($ELFCLASS64), 0, 1)     # e_ident[4] = ELFCLASS64
  $out = $out + sous_chaine(chaine($ELFDATA2LSB), 0, 1)    # e_ident[5] = ELFDATA2LSB
  $out = $out + sous_chaine(chaine($EV_CURRENT), 0, 1)     # e_ident[6] = EV_CURRENT
  $out = $out + sous_chaine(chaine($ELFOSABI_SYSV), 0, 1)  # e_ident[7] = ELFOSABI_SYSV
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[8] = 0
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[9] = 0
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[10] = 0
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[11] = 0
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[12] = 0
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[13] = 0
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[14] = 0
  $out = $out + sous_chaine(chaine(0), 0, 1)               # e_ident[15] = 0
  $out = $out + u16le($ET_EXEC)                            # e_type = ET_EXEC
  $out = $out + u16le($EM_AARCH64)                         # e_machine = EM_AARCH64
  $out = $out + u32le(1)                                   # e_version = 1
  $out = $out + u64le($TEXT_ADDR)                          # e_entry = adresse de _start
  $out = $out + u64le(64)                                  # e_phoff = 64 (juste après l'en-tête)
  $out = $out + u64le(0)                                   # e_shoff = 0 (pas de section header pour l'instant)
  $out = $out + u32le(0)                                   # e_flags = 0
  $out = $out + u16le(64)                                  # e_ehsize = 64
  $out = $out + u16le(56)                                  # e_phentsize = 56
  $out = $out + u16le(1)                                   # e_phnum = 1 (un segment)
  $out = $out + u16le(64)                                  # e_shentsize = 64
  $out = $out + u16le(0)                                   # e_shnum = 0
  $out = $out + u16le(0)                                   # e_shstrndx = 0

  # ── Program header (1 segment PT_LOAD, 56 octets) ──
  $out = $out + u32le($PT_LOAD)                            # p_type = PT_LOAD
  $out = $out + u32le($PF_R | $PF_X)                       # p_flags = R|X
  $out = $out + u64le($TEXT_OFFSET)                        # p_offset = 0x1000
  $out = $out + u64le($TEXT_ADDR)                          # p_vaddr
  $out = $out + u64le($TEXT_ADDR)                          # p_paddr
  $out = $out + u64le(12)                                  # p_filesz = 12 octets (2 instructions)
  $out = $out + u64le(12)                                  # p_memsz = 12 octets
  $out = $out + u64le(0x200000)                            # p_align

  # ── Code machine aarch64 : retour 0 ──
  # mov w0, #0      = 0xaa0003e0
  # mov x8, #93     = 0xaa0003e8 (syscall number exit)
  # svc #0          = 0xd65f0000
  $out = $out + u32le(0xaa0003e0)   # mov w0, #0
  $out = $out + u32le(0xaa0003e8)   # mov x8, #93
  $out = $out + u32le(0xd65f0000)   # svc #0

  # ── Écrire le fichier ──
  $fd = ouvrir_ecriture($sortie)
  si ($fd < 0) {
    afficher_erreur("emetteur_elf : impossible d'ecrire " + $sortie)
    quitter(1)
  }
  ecrire($fd, $out)
  fermer($fd)
  >> "rose: " + $sortie + " produit (binaire ELF autonome, " + longueur($out) + " octets)"
}

# ── Point d'entrée ──
$chemin = argument(0)
$sortie = ""
$i = 1
tant_que ($i < longueur($chemin)) {
  # placeholder, on utilise les arguments positions
  $i = $i + 1
}
# utilisation simple : premier argument = source, second = sortie (optionnel)
# On lit le fichier source mais on ignore son contenu pour l'instant
$src = lire_texte($chemin)
si (longueur($src) == 0) {
  afficher_erreur("emetteur_elf : fichier vide ou introuvable : " + $chemin)
  quitter(1)
}
$sortie = argument(1)
si (longueur($sortie) == 0) {
  $sortie = "prog"
}
emettre_elf_minimal($sortie)
