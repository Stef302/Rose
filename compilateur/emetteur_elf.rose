# emetteur_elf.rose — Émetteur ELF64 natif pour Rose.
# Génère un binaire ELF exécutable autonome à partir d'un programme Rose.
# Zéro dépendance externe : pas de rustc, pas de clang, pas de LLVM.
# Utilisation : rose/rose run compilateur/emetteur_elf.rose prog.rose -o sortie

# ── Utilitaires d'écriture little-endian ──

fn u8le($v: entier) -> chaine {
  retour caractere($v % 256)
}

fn u16le($v: entier) -> chaine {
  $b0 = $v % 256
  $b1 = partie_entiere($v / 256) % 256
  retour caractere($b0) + caractere($b1)
}

fn u32le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = partie_entiere($v / 256)
  $b1 = $v1 % 256
  $v2 = partie_entiere($v1 / 256)
  $b2 = $v2 % 256
  $v3 = partie_entiere($v2 / 256)
  $b3 = $v3 % 256
  retour caractere($b0) + caractere($b1) + caractere($b2) + caractere($b3)
}

fn u64le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = partie_entiere($v / 256)
  $b1 = $v1 % 256
  $v2 = partie_entiere($v1 / 256)
  $b2 = $v2 % 256
  $v3 = partie_entiere($v2 / 256)
  $b3 = $v3 % 256
  $v4 = partie_entiere($v3 / 256)
  $b4 = $v4 % 256
  $v5 = partie_entiere($v4 / 256)
  $b5 = $v5 % 256
  $v6 = partie_entiere($v5 / 256)
  $b6 = $v6 % 256
  $v7 = partie_entiere($v6 / 256)
  $b7 = $v7 % 256
  retour caractere($b0) + caractere($b1) + caractere($b2) + caractere($b3) + caractere($b4) + caractere($b5) + caractere($b6) + caractere($b7)
}


fn g4_pos($s: chaine, $mot: chaine) -> entier {
  $p = 0
  $ln = longueur($s)
  $lm = longueur($mot)
  si ($lm == 0) { retour 0 }
  tant_que ($p + $lm <= $ln et sous_chaine($s, $p, $p + $lm) != $mot) { $p = $p + 1 }
  si ($p + $lm > $ln) { retour -1 }
  retour $p
}
fn g4_entier_ou_zero($s: chaine) -> entier {
  $t = g4_trim($s)
  $n = longueur($t)
  si ($n == 0) { retour 0 }
  $neg = 0
  $i = 0
  si (sous_chaine($t, 0, 1) == "-") { $neg = 1; $i = 1 }
  $ok = 1
  tant_que ($i < $n) {
    $c = sous_chaine($t, $i, $i + 1)
    si ($c < "0" ou $c > "9") { $ok = 0 }
    $i = $i + 1
  }
  si ($ok == 0) { retour 0 }
  $deb = 0
  si ($neg == 1) { $deb = 1 }
  $v = entier(sous_chaine($t, $deb, $n))
  si ($neg == 1) { retour -$v }
  retour $v
}
fn g4_trim($s: chaine) -> chaine {
  $r = $s
  $n = longueur($r)
  tant_que ($n > 0 et sous_chaine($r, 0, 1) == " ") { $r = sous_chaine($r, 1, $n); $n = longueur($r) }
  tant_que ($n > 0 et sous_chaine($r, $n - 1, $n) == " ") { $r = sous_chaine($r, 0, $n - 1); $n = longueur($r) }
  retour $r
}
fn g4_lignes($s: chaine) -> liste<chaine> {
  $res = [""]
  $i = 0
  $n = longueur($s)
  $deb = 0
  tant_que ($i <= $n) {
    si ($i == $n ou sous_chaine($s, $i, $i + 1) == "\n") {
      $ligne = sous_chaine($s, $deb, $i)
      $ln = longueur($ligne)
      si ($ln > 0 et sous_chaine($ligne, $ln - 1, $ln) == "\r") { $ligne = sous_chaine($ligne, 0, $ln - 1) }
      joindre($res, $ligne)
      $deb = $i + 1
    }
    $i = $i + 1
  }
  retour $res
}
fn g4_operand($op: chaine, $mot: chaine) -> chaine {
  $p = g4_pos($op, $mot)
  si ($p < 0) { retour "" }
  $i = $p + longueur($mot)
  $n = longueur($op)
  tant_que ($i < $n et sous_chaine($op, $i, $i + 1) == " ") { $i = $i + 1 }
  retour g4_trim(sous_chaine($op, $i, $n))
}
fn g5_nu_op($ligne: chaine) -> chaine {
  $n = longueur($ligne)
  $i = 0
  tant_que ($i < $n et sous_chaine($ligne, $i, $i + 1) == " ") { $i = $i + 1 }
  $j = 0
  tant_que ($i < $n et $j < 4 et sous_chaine($ligne, $i, $i + 1) >= "0" et sous_chaine($ligne, $i, $i + 1) <= "9") { $i = $i + 1; $j = $j + 1 }
  tant_que ($i < $n et sous_chaine($ligne, $i, $i + 1) == " ") { $i = $i + 1 }
  retour sous_chaine($ligne, $i, $n)
}

# ── État (listes append-only ; joindre mute l'objet partagé) ──
$g5_code = [0 : entier]
$g5_meta = [0 : chaine]
$g5_lbldef = [0 : chaine]
$g5_ctr = [0]
$g5_fn = [0 : chaine]
$g5_fnslot = [0 : entier]
$g5_fnam = [0 : chaine]
$g5_fop = [0 : entier]
$g5_fnop = [0 : entier]
$g5_flbl = [0 : entier]
$g5_fparam = [0 : entier]
$g5_ops = [0 : chaine]
$g5_oplbl = [0 : entier]
$g5_endlbl = [0 : entier]
$g5_err = [0 : chaine]

fn g5_sub($s: chaine, $a: entier, $b: entier) -> chaine {
  si ($a < 0 ou $b < 0 ou $a > $b) {
    joindre($g5_err, "sous_chaine invalide : " + chaine($a) + ".." + chaine($b) + " sur " + chaine(longueur($s)) + " octets")
    retour ""
  }
  $n = longueur($s)
  $fin = $b
  si ($fin > $n) { $fin = $n }
  $deb = $a
  si ($deb > $n) { $deb = $n }
  retour sous_chaine($s, $deb, $fin)
}

fn g5_next() -> entier { joindre($g5_ctr, 0); retour longueur($g5_ctr) - 1 }
fn g5_wrap($v: entier, $m: entier) -> entier {
  $r = $v % $m
  si ($r < 0) { $r = $r + $m }
  retour $r
}
fn g5_emit($w: entier) -> entier {
  joindre($g5_code, g5_wrap($w, 4294967296))
  joindre($g5_meta, "")
  retour longueur($g5_code) - 1
}
fn g5_branch($kind: entier, $l: entier) -> entier {
  joindre($g5_code, 0)
  joindre($g5_meta, "F" + chaine($l) + "|" + chaine($kind))
  retour longueur($g5_code) - 1
}
# Saut court à déplacement CONSTANT, résolu à l'émission (pas de label).
# Évite de grossir g5_lbldef : g5_patch est une recherche linéaire, donc
# 3000 labels supplémentaires rendaient l'émission du compilateur entier
# plusieurs minutes. Utilisé uniquement dans les patrons de dispatch de tag.
fn g5_branch_off($kind: entier, $off: entier) -> entier {
  si ($kind == 0) { g5_emit(335544320 + g5_wrap($off, 67108864)); retour 0 }
  si ($kind == 1) { g5_emit(2483027968 + g5_wrap($off, 67108864)); retour 0 }
  g5_emit(1409286144 + g5_wrap($off, 524288) * 32 + ($kind - 100))
  retour 0
}
fn g5_mark($l: entier) -> entier {
  joindre($g5_lbldef, chaine($l) + "|" + chaine(longueur($g5_code)))
  retour longueur($g5_code) - 1
}
fn g5_labelidx($l: entier) -> entier {
  $i = 0
  tant_que ($i < longueur($g5_lbldef)) {
    $s = $g5_lbldef[$i]
    $bar = g4_pos($s, "|")
    si (g4_entier_ou_zero(g5_sub($s, 0, $bar)) == $l) {
      retour g4_entier_ou_zero(g5_sub($s, $bar + 1, longueur($s)))
    }
    $i = $i + 1
  }
  retour -1
}
fn g5_fail($msg: chaine) -> entier { joindre($g5_err, $msg); retour -1 }

# ── Encodage AArch64 — bases vérifiées par objdump sur gx10-2 (aarch64) ──
fn movz($rd: entier, $im: entier) -> entier { retour 3531603968 + $im * 32 + $rd }
fn movk($rd: entier, $im: entier, $sh: entier) -> entier { retour 4068474880 + $sh * 2097152 + $im * 32 + $rd }
fn addi($rd: entier, $rn: entier, $im: entier) -> entier { retour 2432696320 + $im * 1024 + $rn * 32 + $rd }
fn subi($rd: entier, $rn: entier, $im: entier) -> entier { retour 3506438144 + $im * 1024 + $rn * 32 + $rd }
fn addr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2332033024 + $rm * 65536 + $rn * 32 + $rd }
fn subr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 3405774848 + $rm * 65536 + $rn * 32 + $rd }
fn andr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2315255808 + $rm * 65536 + $rn * 32 + $rd }
fn orrr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2852126720 + $rm * 65536 + $rn * 32 + $rd }
fn eorr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 3388997632 + $rm * 65536 + $rn * 32 + $rd }
fn mulr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2600500224 + $rm * 65536 + $rn * 32 + $rd }
fn sdivr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2596276224 + $rm * 65536 + $rn * 32 + $rd }
fn udivr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2596276224 + $rm * 65536 + $rn * 32 + $rd }
# MSUB : Rd bits 0-4, Rn bits 5-9, Ra bits 10-14 (×1024), Rm bits 16-20.
# Le facteur 16 historique était faux dès que Ra≠0 (il écrivait dans Rd).
fn msubr($rd: entier, $rn: entier, $rm: entier, $ra: entier) -> entier { retour 2600501248 + $rm * 65536 + $ra * 1024 + $rn * 32 + $rd }
fn cmpr($rn: entier, $rm: entier) -> entier { retour 3942645791 + $rm * 65536 + $rn * 32 }
fn cmpi($rn: entier, $im: entier) -> entier { retour 4043309087 + $im * 1024 + $rn * 32 }
fn ldroff($rt: entier, $rn: entier, $off: entier) -> entier { retour 4181721088 + partie_entiere($off / 8) * 1024 + $rn * 32 + $rt }
fn stroff($rt: entier, $rn: entier, $off: entier) -> entier { retour 4177526784 + partie_entiere($off / 8) * 1024 + $rn * 32 + $rt }
fn strboff($rt: entier, $rn: entier) -> entier { retour 941648864 + $rn * 65536 + $rt }
fn ldrboff($rt: entier, $rn: entier) -> entier { retour 945843168 + $rn * 65536 + $rt }
fn cset($rd: entier, $cond: entier) -> entier {
  $inv = $cond + 1
  si ($cond % 2 == 1) { $inv = $cond - 1 }
  retour 2594113504 + $inv * 4096 + $rd
}
fn RET_I() -> entier { retour 3596551104 }
fn SVC_I() -> entier { retour 3556769793 }

# ── G5-R (réflexivité) : extensions chaînes/listes ──
# Encodages vérifiés avec as/objdump sur aarch64 :
#   strb wRt,[xRn,#off] = 0x39000000 + off*1024 + Rn*32 + Rt
#   ldrb wRt,[xRn,#off] = 0x39400000 + off*1024 + Rn*32 + Rt
#   strb wRt,[xRn,xRm]  = 0x38206800 + Rm*65536 + Rn*32 + Rt
#   ldrb wRt,[xRn,xRm]  = 0x38606800 + Rm*65536 + Rn*32 + Rt
fn movzs($rd: entier, $im: entier, $sh: entier) -> entier { retour 3531603968 + $sh * 2097152 + $im * 32 + $rd }
fn strbio($rt: entier, $rn: entier, $off: entier) -> entier { retour 956301312 + $off * 1024 + $rn * 32 + $rt }
fn ldrbio($rt: entier, $rn: entier, $off: entier) -> entier { retour 960495616 + $off * 1024 + $rn * 32 + $rt }
fn strbr($rt: entier, $rn: entier, $rm: entier) -> entier { retour 941647872 + $rm * 65536 + $rn * 32 + $rt }
fn ldrbr($rt: entier, $rn: entier, $rm: entier) -> entier { retour 945842176 + $rm * 65536 + $rn * 32 + $rt }

# ── ABI G5 : tag dans les 3 bits bas (décision AB1, 19/11) ──
#UNE seule représentation pour TOUTES les valeurs G5 :
#  entier / booléen : n<<3        (bits bas 000)
#  chaîne           : pointeur|1   (descripteur [tag=1][len][octets…])
#  liste            : pointeur|2   (descripteur [tag=2][len][cap][valeurs…])
#Les descripteurs sont alignés sur 8 : les 3 bits bas sont libres.
#Encodages vérifiés avec as/objdump sur aarch64 :
#  and xRd,xRn,#0xfffffffffffffff8 = 0x927df000 + Rn*32 + Rd
#  lsr xRd,xRn,#3                 = 0xd343fc00 + Rn*32 + Rd
#  lsl xRd,xRn,#3                 = 0xd37df000 + Rn*32 + Rd
#  orr xRd,xRn,#1                 = 0xb2400000 + Rn*32 + Rd
#  orr xRd,xRn,#2                 = 0xb27f0000 + Rn*32 + Rd
fn g5_masktag($rd: entier, $rn: entier) -> entier { retour 2457726976 + $rn * 32 + $rd }
fn g5_tagbits($rd: entier, $rn: entier) -> entier { retour 2453669888 + $rn * 32 + $rd }
fn g5_lsr3($rd: entier, $rn: entier) -> entier { retour 3544448000 + $rn * 32 + $rd }
fn g5_asr3($rd: entier, $rn: entier) -> entier { retour 2470706176 + $rn * 32 + $rd }
fn g5_lsl3($rd: entier, $rn: entier) -> entier { retour 3548246016 + $rn * 32 + $rd }
fn g5_tag1($rd: entier, $rn: entier) -> entier { retour 2990538752 + $rn * 32 + $rd }
fn g5_tag2($rd: entier, $rn: entier) -> entier { retour 2994667520 + $rn * 32 + $rd }
# Charge un entier Rose (déjà tagué) dans $rd. g5_load reste brut ( adresses, tailles ).
fn g5_load_val($rd: entier, $v: entier) -> entier {
  g5_load($rd, $v)
  g5_emit(g5_lsl3($rd, $rd))
  retour 0
}

$g5_allocl = 0
$g5_lenl = 0
$g5_ordl = 0
$g5_sousl = 0
$g5_idxl = 0
$g5_chl = 0
$g5_joindrel = 0
$g5_inserrel = 0
$g5_entierl = 0
$g5_catl = 0
$g5_streql = 0
$g5_stub0l = 0
$g5_stubsl = 0

# ── G5-IO : primitives d'entrée/sortie par syscalls Linux aarch64 ──
# Ces routines sont ÉMISES dans l'ELF (elles ne s'exécutent pas dans Rose) :
#   nb_arguments()  -> argc de la pile initiale, moins 1 (arguments utilisateur)
#   argument(i)     -> argv[i+1], copié en chaîne Rose taguée [tag=1][len][octets]
#   lire_texte(p)   -> openat/read/close (svc #0), chaîne taguée
#   ecrire_bytes(p,d), ecrire_texte(p,d) -> openat/write/close
# Les variables globales sont logées dans la page RW à 0x60000000, AU-DESSOUS
# du pointeur libre du tas (désormais initialisé à 0x60000300) pour ne jamais
# être écrasées par g5_alloc_inline.
$g5_nbargs_l = 0
$g5_argument_l = 0
$g5_lire_l = 0
$g5_ecrire_l = 0

fn g5_load($rd: entier, $v: entier) -> entier {
  $u = $v
  si ($u < -9223372036854775808) { retour g5_fail("immédiat hors int64 : " + chaine($v)) }
  si ($u >= 18446744073709551616) { $u = $u % 18446744073709551616 }
  si ($u < 0) { $u = $u + 18446744073709551616 }
  $c0 = $u % 65536
  $c1 = partie_entiere($u / 65536) % 65536
  $c2 = partie_entiere($u / 4294967296) % 65536
  $c3 = partie_entiere($u / 281474976710656) % 65536
  g5_emit(movz($rd, $c0))
  si ($c1 != 0) { g5_emit(movk($rd, $c1, 1)) }
  si ($c2 != 0) { g5_emit(movk($rd, $c2, 2)) }
  si ($c3 != 0) { g5_emit(movk($rd, $c3, 3)) }
  retour 0
}

fn g5_tokens($s: chaine) -> liste<chaine> {
  $r = [0 : chaine]
  $i = 0
  $n = longueur($s)
  tant_que ($i < $n) {
    $c = g5_sub($s, $i, $i + 1)
    si ($c == "(" ou $c == ")") { joindre($r, $c); $i = $i + 1 }
    sinon si ($c == " " ou $c == "\t") { $i = $i + 1 }
    sinon si ($c == "\"") {
      # G5-R : un littéral de chaîne est UN seul jeton, y compris ses espaces,
      # ses parenthèses et ses échappements.
      $j = $i + 1
      $fin = 0
      tant_que ($j < $n et $fin == 0) {
        $d = g5_sub($s, $j, $j + 1)
        si ($d == "\\") { $j = $j + 2
        } sinon si ($d == "\"") { $j = $j + 1; $fin = 1
        } sinon { $j = $j + 1 }
      }
      si ($j > $n) { $j = $n }
      joindre($r, g5_sub($s, $i, $j))
      $i = $j
    }
    sinon {
      $j = $i
      tant_que ($j < $n et g5_sub($s, $j, $j + 1) != "(" et g5_sub($s, $j, $j + 1) != ")" et g5_sub($s, $j, $j + 1) != " " et g5_sub($s, $j, $j + 1) != "\t") { $j = $j + 1 }
      joindre($r, g5_sub($s, $i, $j))
      $i = $j
    }
  }
  retour $r
}

# Décode un jeton "(s \"…\")" du RIR vers les octets Rose réels.
fn g5_unescape($tok: chaine) -> chaine {
  $n = longueur($tok)
  $deb = 1
  $fin = $n - 1
  si ($fin < $deb) { $fin = $deb }
  $r = ""
  $i = $deb
  tant_que ($i < $fin) {
    $c = sous_chaine($tok, $i, $i + 1)
    si ($c == "\\") {
      $d = sous_chaine($tok, $i + 1, $i + 2)
      si ($d == "n") { $r = $r + caractere(10); $i = $i + 2
      } sinon si ($d == "r") { $r = $r + caractere(13); $i = $i + 2
      } sinon si ($d == "t") { $r = $r + caractere(9); $i = $i + 2
      } sinon si ($d == "\"") { $r = $r + caractere(34); $i = $i + 2
      } sinon si ($d == "\\") { $r = $r + caractere(92); $i = $i + 2
      } sinon { $r = $r + $c; $i = $i + 1 }
    } sinon { $r = $r + $c; $i = $i + 1 }
  }
  retour $r
}

# Allocation EN LIGNE : évite de clobber x30 (BL écraserait le LR de la fonction).
fn g5_alloc_inline() -> entier {
  g5_load(9, 1610612736)
  g5_emit(ldroff(2, 9, 0))
  g5_emit(orrr(1, 31, 0))
  g5_emit(orrr(0, 31, 2))
  g5_emit(addr(2, 2, 1))
  g5_emit(stroff(2, 9, 0))
  retour 0
}

# Émet le code qui construit un descripteur [tag=1][len][octets…] dans x0.
# G5-TAS : les chaînes Rose sont immuables, donc un littéral peut être
# construit UNE fois et réutilisé. Table d'internement à 0x60000300 :
# 512 entrées de 16 octets [clé 64 bits][pointeur], la clé est vérifiée
# avant réutilisation (une collision d'index ne peut donc pas rendre une
# mauvaise chaîne).
fn g5_make_str($s: chaine) -> entier {
  $n = longueur($s)
  $h = 0
  $hi = 0
  tant_que ($hi < $n) {
    $h = ($h * 131 + ordre(sous_chaine($s, $hi, $hi + 1))) % 18446744073709551616
    $hi = $hi + 1
  }
  $lbl_miss = g5_next()
  $lbl_done = g5_next()
  g5_load(12, 1610613504 + 16 * ($h % 512))
  g5_emit(ldroff(13, 12, 0))
  g5_load(14, $h)
  g5_emit(cmpr(13, 14))
  g5_branch(101, $lbl_miss)
  g5_emit(ldroff(0, 12, 8))
  g5_emit(cmpi(0, 0))
  g5_branch(101, $lbl_done)
  g5_mark($lbl_miss)
  $sz = 16 + 8 * partie_entiere(($n + 7) / 8)
  g5_load(0, $sz)
  g5_alloc_inline()
  g5_load(1, 1)
  g5_emit(stroff(1, 0, 0))
  g5_load(1, $n)
  g5_emit(stroff(1, 0, 8))
  $i = 0
  tant_que ($i < $n) {
    g5_load(1, ordre(sous_chaine($s, $i, $i + 1)))
    g5_emit(strbio(1, 0, 16 + $i))
    $i = $i + 1
  }
  g5_emit(stroff(14, 12, 0))
  g5_emit(stroff(0, 12, 8))
  g5_mark($lbl_done)
  g5_emit(g5_tag1(0, 0))
  retour 0
}

fn g5_noms($s: chaine) -> chaine {
  $n = longueur($s)
  $p = 0
  $res = ""
  tant_que ($p < $n) {
    si (g5_sub($s, $p, $p + 1) == "[") {
      $q = $p + 1
      tant_que ($q < $n et g5_sub($s, $q, $q + 1) != "]") { $q = $q + 1 }
      $ix = g5_sub($s, $p + 1, $q)
      $p = $q + 1
      tant_que ($p < $n et g5_sub($s, $p, $p + 1) == " ") { $p = $p + 1 }
      $q = $p
      tant_que ($q < $n et g5_sub($s, $q, $q + 1) != " ") { $q = $q + 1 }
      $nm = g5_sub($s, $p, $q)
      si (longueur($res) > 0) { $res = $res + "|" }
      $res = $res + $ix + ":" + $nm
      $p = $q
    } sinon { $p = $p + 1 }
  }
  retour $res
}

fn g5_slot_of($f: entier, $nom: chaine) -> entier {
  $t = $g5_fnam[$f]
  $n = longueur($t)
  $i = 0
  tant_que ($i < $n) {
    $fin = g4_pos(g5_sub($t, $i, $n), "|")
    si ($fin < 0) { $fin = $n - $i }
    $ent = g5_sub($t, $i, $i + $fin)
    $sep = g4_pos($ent, ":")
    si ($sep >= 0) {
      si (g5_sub($ent, $sep + 1, longueur($ent)) == $nom) { retour g4_entier_ou_zero(g5_sub($ent, 0, $sep)) }
    }
    $i = $i + $fin + 1
  }
  # G5-R : une variable non locale (globale Rust dans le source) est repliée
  # à zéro plutôt que de bloquer l'émission. Ce n'est PAS une sémantiqueRose.
  retour -1
}
# G5-FIX (19/11) : régions de gratte-papier SÉPARÉES PAR PROFONDEUR D'IMBRICATION.
# Avant : tmp = mot 32+$d, args = mot 64+$i, listes = mot 80+$i (regions FIXES).
# Un appel imbriqué dans une expression d'argument (ex. noeud8(... (app VX0 x p) ...))
# ecrivait ses propres arguments dans argoff(0..1) et DETRUISait ceux de l'appel
# externe deja stipies : noeud8 recevait tx=1 au lieu d'un descripteur de liste.
# Desormais chaque profondeur $d possede une bande de 64 mots :
#   [0..7]=tmp, [8..51]=args (jusqu'a 36 params), [52..63]=listes.
# Les 128 premiers mots restent les slots (n_slots max observe = 116).
# Profondeur max observee = 13 ; 16 bandes suffisent (marge).
fn g5_slotoff($s: entier) -> entier { retour 16 + 8 * $s }
fn g5_tmpoff($d: entier) -> entier { retour 16 + 8 * (128 + 64 * $d) }
fn g5_argoff($i: entier, $d: entier) -> entier { retour 16 + 8 * (128 + 64 * $d + 8 + $i) }
fn g5_listoff($i: entier, $d: entier) -> entier { retour 16 + 8 * (128 + 64 * $d + 52 + $i) }
fn g5_framesize($f: entier) -> entier {
  # 16 + 8*(128 + 64*16) = 9232 octets, multiple de 16 (alignement AArch64).
  retour 9232
}
# `sub sp,sp,#imm` / `add sp,sp,#imm` ne codent que 12 bits (<= 4095).
# 9232 > 4095 : on découpe en tranches de 4080 (multiples de 16).
fn g5_emit_subsp($sz: entier) -> entier {
  $r = $sz
  tant_que ($r > 4080) { g5_emit(subi(31, 31, 4080)); $r = $r - 4080 }
  si ($r > 0) { g5_emit(subi(31, 31, $r)) }
  retour 0
}
fn g5_emit_addsp($sz: entier) -> entier {
  $r = $sz
  tant_que ($r > 4080) { g5_emit(addi(31, 31, 4080)); $r = $r - 4080 }
  si ($r > 0) { g5_emit(addi(31, 31, $r)) }
  retour 0
}
fn g5_cond($op: chaine) -> entier {
  si ($op == "==") { retour 0 }
  si ($op == "!=") { retour 1 }
  si ($op == "<") { retour 11 }
  si ($op == ">=") { retour 10 }
  si ($op == ">") { retour 12 }
  si ($op == "<=") { retour 13 }
  retour -1
}
fn g5_func_id($nom: chaine) -> entier {
  $i = 0
  tant_que ($i < longueur($g5_fn)) {
    si ($g5_fn[$i] == $nom) { retour $g5_flbl[$i] }
    $i = $i + 1
  }
  retour g5_fail("appel non résolu : " + $nom)
}

# Saute une expression RIR parenthésée (retourne la position suivant son ')' ).
fn g5_skip_expr($t: liste<chaine>, $p0: entier) -> entier {
  $p = $p0
  $prof = 0
  $n = longueur($t)
  tant_que ($p < $n) {
    si ($t[$p] == "(") { $prof = $prof + 1 }
    si ($t[$p] == ")") {
      $prof = $prof - 1
      si ($prof == 0) { retour $p + 1 }
    }
    $p = $p + 1
  }
  retour $p
}

fn g5_eval($t: liste<chaine>, $pos: entier, $d: entier, $f: entier) -> entier {
  si (longueur($g5_err) > 0) { retour -1 }
  $n = longueur($t)
  si ($pos >= $n) { retour g5_fail("expression vide") }
  $tk = $t[$pos]
  si ($tk == "(") {
    $head = $t[$pos + 1]
    si ($head == "n" ou $head == "entier") {
      g5_load_val(0, g4_entier_ou_zero($t[$pos + 2]))
      retour $pos + 4
    }
    si ($head == "v") {
      $sl = g5_slot_of($f, $t[$pos + 2])
      si ($sl < 0) { g5_load(0, 0)
      } sinon { g5_emit(ldroff(0, 31, g5_slotoff($sl))) }
      retour $pos + 4
    }
    si ($head == "s") {
      g5_make_str(g5_unescape($t[$pos + 2]))
      g5_emit(g5_tag1(0, 0))
      retour $pos + 4
    }
    si ($head == "f") {
      # G5 n'a pas de flottants : les littéraux (f K.K) sont repliés en entier.
      g5_load_val(0, g4_entier_ou_zero($t[$pos + 2]))
      retour $pos + 4
    }
    si ($head == "lstvide") {
      g5_load(0, 88)
      g5_alloc_inline()
      g5_load(1, 2)
      g5_emit(stroff(1, 0, 0))
      g5_emit(movz(1, 0))
      g5_emit(stroff(1, 0, 8))
      g5_load(1, 8)
      g5_emit(stroff(1, 0, 16))
      g5_emit(g5_tag2(0, 0))
      retour $pos + 4
    }
    si ($head == "lst") {
      $p = $pos + 2
      $k = 0
      tant_que ($p < $n et $t[$p] != ")") {
        $p = g5_eval($t, $p, $d + 1, $f)
        si ($p < 0) { retour -1 }
        g5_emit(stroff(0, 31, g5_listoff($k, $d)))
        $k = $k + 1
      }
      g5_load(0, 24 + 8 * $k)
      g5_alloc_inline()
      g5_load(1, 2)
      g5_emit(stroff(1, 0, 0))
      g5_load(1, $k)
      g5_emit(stroff(1, 0, 8))
      g5_load(1, $k)
      g5_emit(stroff(1, 0, 16))
      $j = 0
      tant_que ($j < $k) {
        g5_emit(ldroff(1, 31, g5_listoff($j, $d)))
        g5_emit(stroff(1, 0, 24 + 8 * $j))
        $j = $j + 1
      }
      g5_emit(g5_tag2(0, 0))
      retour $p + 1
    }
    si ($head == "idx") {
      $p = g5_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(stroff(0, 31, g5_tmpoff($d)))
      $p = g5_eval($t, $p, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(orrr(1, 31, 0))
      g5_emit(ldroff(0, 31, g5_tmpoff($d)))
      g5_branch(1, $g5_idxl)
      retour $p + 1
    }
    si ($head == "bin") {
      $op = $t[$pos + 2]
      # G5-TAS : fusion sous_chaine(s,a,b) == "littéral" (et !=).
      # Au lieu d'allouer un descripteur de sous-chaîne à chaque caractère
      # balayé, on compare la LONGUEUR puis les OCTETS de la source avec le
      # littéral connu à l'émission. C'est la représentation par tranche
      # (pointeur,longueur), sans matérialisation du descripteur.
      si (($op == "==" ou $op == "!=") et $pos + 5 < $n et
          $t[$pos + 3] == "(" et $t[$pos + 4] == "app" et $t[$pos + 5] == "sous_chaine") {
        $a0 = $pos + 6
        $a1 = g5_skip_expr($t, $a0)
        $a2 = g5_skip_expr($t, $a1)
        $a3 = g5_skip_expr($t, $a2)
        # $a3 pointe sur le ')' fermant l'appel sous_chaine ; l'opérande
        # droite (le littéral) commence juste après.
        $pr = $a3 + 1
        si ($pr + 2 < $n et $t[$pr] == "(" et $t[$pr + 1] == "s") {
          $lit = g5_unescape($t[$pr + 2])
          $ll = longueur($lit)
          $lfaux = g5_next()
          $lfin = g5_next()
          $p = g5_eval($t, $a0, $d + 1, $f)
          si ($p < 0) { retour -1 }
          g5_emit(stroff(0, 31, g5_tmpoff($d)))
          $p = g5_eval($t, $a1, $d + 1, $f)
          si ($p < 0) { retour -1 }
          g5_emit(orrr(1, 31, 0))
          $p = g5_eval($t, $a2, $d + 1, $f)
          si ($p < 0) { retour -1 }
          g5_emit(orrr(2, 31, 0))
          g5_emit(ldroff(0, 31, g5_tmpoff($d)))
          g5_emit(g5_asr3(1, 1))
          g5_emit(g5_asr3(2, 2))
          g5_emit(subr(3, 2, 1))
          g5_load(4, $ll)
          g5_emit(cmpr(3, 4))
          g5_branch(101, $lfaux)
          g5_emit(g5_masktag(6, 0))
          g5_emit(addi(1, 1, 16))
          g5_emit(addr(7, 6, 1))
          $li = 0
          tant_que ($li < $ll) {
            g5_emit(ldrbio(8, 7, $li))
            g5_load(9, ordre(sous_chaine($lit, $li, $li + 1)))
            g5_emit(cmpr(8, 9))
            g5_branch(101, $lfaux)
            $li = $li + 1
          }
          g5_load(0, 8)
          g5_branch(0, $lfin)
          g5_mark($lfaux)
          g5_emit(movz(0, 0))
          g5_mark($lfin)
          si ($op == "!=") {
            g5_load(5, 8)
            g5_emit(eorr(0, 0, 5))
          }
          retour g5_skip_expr($t, $pr) + 1
        }
      }
      $p = g5_eval($t, $pos + 3, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(stroff(0, 31, g5_tmpoff($d)))
      $p = g5_eval($t, $p, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(ldroff(1, 31, g5_tmpoff($d)))
      # x1 = opérande gauche taguée, x0 = opérande droite taguée.
      $c = g5_cond($op)
      si ($op == "==" ou $op == "!=") {
        # Égalité de chaînes : comparer le CONTENU, pas les pointeurs.
        # Sauts courts à déplacement calculé : zéro label supplémentaire.
        $npost = 0
        si ($op == "!=") { $npost = 2 }
        g5_emit(g5_tagbits(2, 1))
        g5_emit(g5_tagbits(3, 0))
        g5_emit(cmpi(2, 1)); g5_branch_off(101, 8 + $npost)
        g5_emit(cmpi(3, 1)); g5_branch_off(101, 6 + $npost)
        g5_emit(orrr(2, 31, 0)); g5_emit(orrr(0, 31, 1)); g5_emit(orrr(1, 31, 2))
        g5_branch(1, $g5_streql)
        si ($op == "!=") { g5_load(2, 8); g5_emit(eorr(0, 0, 2)) }
        g5_branch_off(0, 4)
        g5_emit(cmpr(1, 0)); g5_emit(cset(0, $c)); g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "+") {
        # '+' sur chaînes = CONCATÉNATION (c'était la cause du SIGSEGV :
        # deux descripteurs étaient additionnés comme des entiers brutaux).
        g5_emit(g5_tagbits(2, 1))
        g5_emit(cmpi(2, 0)); g5_branch_off(101, 6)
        g5_emit(g5_tagbits(2, 0))
        g5_emit(cmpi(2, 0)); g5_branch_off(101, 3)
        g5_emit(addr(0, 1, 0)); g5_branch_off(0, 5)
        g5_emit(orrr(2, 31, 0)); g5_emit(orrr(0, 31, 1)); g5_emit(orrr(1, 31, 2))
        g5_branch(1, $g5_catl)
      } sinon si ($c >= 0) {
        g5_emit(cmpr(1, 0)); g5_emit(cset(0, $c)); g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "-") { g5_emit(subr(0, 1, 0))
      } sinon si ($op == "*") { g5_emit(mulr(0, 1, 0)); g5_emit(g5_lsr3(0, 0))
      } sinon si ($op == "/" ou $op == "//" ou $op == "div") {
        g5_emit(g5_asr3(1, 1)); g5_emit(g5_asr3(0, 0))
        g5_emit(sdivr(0, 1, 0)); g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "%") {
        g5_emit(g5_asr3(1, 1)); g5_emit(g5_asr3(0, 0))
        g5_emit(sdivr(2, 1, 0))
        g5_emit(msubr(3, 2, 0, 1))
        g5_emit(orrr(0, 31, 3))
        g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "^") {
        # x1 = base taguée, x0 = exposant tagué ; repli entier (pas de flottants).
        $l1 = g5_next()
        $l2 = g5_next()
        g5_emit(g5_asr3(2, 1))
        g5_emit(g5_asr3(3, 0))
        g5_emit(movz(0, 1))
        g5_mark($l1)
        g5_emit(cmpi(3, 0))
        g5_branch(100, $l2)
        g5_emit(mulr(0, 0, 2))
        g5_emit(subi(3, 3, 1))
        g5_branch(0, $l1)
        g5_mark($l2)
        g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "et") { g5_emit(andr(0, 1, 0))
      } sinon si ($op == "ou") { g5_emit(orrr(0, 1, 0))
      } sinon { retour g5_fail("op bin non couverte : " + $op) }
      retour $p + 1
    }
    si ($head == "app" ou $head == "appel_rir" ou $head == "appel") {
      $nom = $t[$pos + 2]
      $p = $pos + 3
      $k = 0
      tant_que ($p < $n et $t[$p] != ")") {
        $p = g5_eval($t, $p, $d + 1, $f)
        si ($p < 0) { retour -1 }
        g5_emit(stroff(0, 31, g5_argoff($k, $d)))
        $k = $k + 1
      }
      $i = 0
      tant_que ($i < $k) { g5_emit(ldroff($i, 31, g5_argoff($i, $d))); $i = $i + 1 }
      $lbl = -1
      si ($nom == "longueur") { $lbl = $g5_lenl }
      si ($nom == "ordre") { $lbl = $g5_ordl }
      si ($nom == "sous_chaine") { $lbl = $g5_sousl }
      si ($nom == "chaine") { $lbl = $g5_chl }
      si ($nom == "joindre") { $lbl = $g5_joindrel }
      si ($nom == "inserer") { $lbl = $g5_inserrel }
      si ($nom == "entier") { $lbl = $g5_entierl }
      # G5-IO : ces primitives sont de vraies routines émises (syscalls), plus des stubs.
      si ($nom == "nb_arguments") { $lbl = $g5_nbargs_l }
      si ($nom == "argument") { $lbl = $g5_argument_l }
      si ($nom == "lire_texte") { $lbl = $g5_lire_l }
      si ($nom == "ecrire_bytes" ou $nom == "ecrire_texte") { $lbl = $g5_ecrire_l }
      si ($nom == "flottant" ou $nom == "cle_existe") { $lbl = $g5_stub0l }
      si ($nom == "table") { $lbl = $g5_stubsl }
      si ($lbl < 0) {
        $trouve = 0
        $fi = 0
        tant_que ($fi < longueur($g5_fn)) {
          si ($g5_fn[$fi] == $nom) { $trouve = 1; $lbl = $g5_flbl[$fi] }
          $fi = $fi + 1
        }
        si ($trouve == 0) { $lbl = $g5_stub0l }
      }
      g5_branch(1, $lbl)
      retour $p + 1
    }
    si ($head == "neg") {
      $p = g5_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(subr(0, 31, 0))
      retour $p + 1
    }
    si ($head == "b") {
      $v = 0
      si ($t[$pos + 2] == "vraie") { $v = 1 }
      g5_load_val(0, $v)
      retour $pos + 3
    }
    si ($head == "non") {
      $p = g5_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(cmpi(0, 0)); g5_emit(cset(0, 0)); g5_emit(g5_lsl3(0, 0))
      retour $p + 1
    }
    si ($head == "uni") {
      $p = g5_eval($t, $pos + 3, $d + 1, $f)
      si ($p < 0) { retour -1 }
      si ($t[$pos + 2] == "non") { g5_emit(cmpi(0, 0)); g5_emit(cset(0, 0)); g5_emit(g5_lsl3(0, 0))
      } sinon si ($t[$pos + 2] == "neg" ou $t[$pos + 2] == "-") { g5_emit(subr(0, 31, 0))
      } sinon { retour g5_fail("unaire non couvert : " + $t[$pos + 2]) }
      retour $p + 1
    }
    retour g5_fail("forme parenthésée non couverte : " + $head)
  }
  si ($tk == "slot") { g5_emit(ldroff(0, 31, g5_slotoff(g4_entier_ou_zero($t[$pos + 1])))); retour $pos + 2 }
  si ($tk == "entier" ou $tk == "n") { g5_load_val(0, g4_entier_ou_zero($t[$pos + 1])); retour $pos + 2 }
  si ($tk == "flottant") { g5_load_val(0, g4_entier_ou_zero($t[$pos + 1])); retour $pos + 2 }
  si ($tk == "v") {
    $sl = g5_slot_of($f, $t[$pos + 1])
    si ($sl < 0) { g5_load(0, 0)
    } sinon { g5_emit(ldroff(0, 31, g5_slotoff($sl))) }
    retour $pos + 2
  }
  g5_load_val(0, g4_entier_ou_zero($tk))
  retour $pos + 1
}

# Un saut dont la cible vaut le nombre d'ops signifie « fin de fonction ».
fn g5_cible($f: entier, $tok: chaine) -> entier {
  $c = g4_entier_ou_zero($tok)
  si ($c >= $g5_fnop[$f]) { retour $g5_endlbl[$f] }
  retour $g5_oplbl[$g5_fop[$f] + $c]
}

fn g5_op($op: chaine, $f: entier, $principal: entier, $printl: entier, $exitl: entier) -> entier {
  # G5-R : le préfixe doit être AU DÉBUT de l'op. g4_operand cherchait n'importe
  # où et capturait à tort les littéraux (s "affect slot ") du propre RIR G5.
  $a = ""
  si (g5_sub($op, 0, 12) == "affect slot ") { $a = g4_trim(g5_sub($op, 12, longueur($op))) }
  si (g5_sub($op, 0, 16) == "affect_ast slot ") { $a = g4_trim(g5_sub($op, 16, longueur($op))) }
  si (longueur($a) > 0) {
    $eq = g4_pos($a, "=")
    $sl = g4_entier_ou_zero(g5_sub($a, 0, $eq))
    $rhs = g4_trim(g5_sub($a, $eq + 1, longueur($a)))
    g5_eval(g5_tokens($rhs), 0, 0, $f)
    g5_emit(stroff(0, 31, g5_slotoff($sl)))
    retour 0
  }
  $t = g5_tokens($op)
  $head = $t[0]
  si ($head == "expr") { g5_eval($t, 1, 0, $f); retour 0 }
  si ($head == "saut") { g5_branch(0, g5_cible($f, $t[1])); retour 0 }
  si ($head == "saut_si_faux" ou $head == "saut_si_faux_abstrait") {
    g5_eval($t, 2, 0, $f)
    g5_emit(cmpi(0, 0))
    g5_branch(100, g5_cible($f, $t[1]))
    retour 0
  }
  si ($head == "retour" ou $head == "retour_abstrait") {
    g5_eval($t, 1, 0, $f)
    si ($f == $principal) { g5_branch(1, $printl)
    } sinon { g5_emit(ldroff(30, 31, 0)); g5_emit_addsp(g5_framesize($f)); g5_emit(RET_I()) }
    retour 0
  }
  si ($head == "afficher" ou $head == "afficher_abstrait") {
    g5_eval($t, 1, 0, $f)
    g5_branch(1, $printl)
    retour 0
  }
  retour g5_fail("op non couverte : " + $op)
}

fn g5_parse($src: chaine) -> entier {
  $ll = g4_lignes($src)
  $i = 1
  tant_que ($i < longueur($ll)) {
    $t = g4_trim($ll[$i])
    si (g5_sub($t, 0, 9) == "fonction ") {
      $nm = g4_trim(g5_sub($t, 9, longueur($t)))
      $slot = 0
      $noms = ""
      $nparam = 0
      $ops = [0 : chaine]
      $en_ops = 0
      $i = $i + 1
      tant_que ($i < longueur($ll) et g5_sub(g4_trim($ll[$i]), 0, 9) != "fonction ") {
        $u = g4_trim($ll[$i])
        si (g5_sub($u, 0, 6) == "param ") { $nparam = $nparam + 1
        } sinon si (g5_sub($u, 0, 8) == "n_slots ") { $slot = g4_entier_ou_zero(g5_sub($u, 8, longueur($u)))
        } sinon si (g5_sub($u, 0, 5) == "noms ") { $noms = g4_trim(g5_sub($u, 5, longueur($u)))
        } sinon si ($u == "ops") { $en_ops = 1
        } sinon si ($en_ops == 1 et longueur($u) > 0) { joindre($ops, g5_nu_op($u)) }
        $i = $i + 1
      }
      joindre($g5_fn, $nm)
      joindre($g5_fnslot, $slot)
      joindre($g5_fnam, g5_noms($noms))
      joindre($g5_fop, longueur($g5_ops))
      joindre($g5_fnop, longueur($ops))
      joindre($g5_flbl, g5_next())
      joindre($g5_endlbl, g5_next())
      joindre($g5_fparam, $nparam)
      $j = 0
      tant_que ($j < longueur($ops)) { joindre($g5_ops, $ops[$j]); joindre($g5_oplbl, g5_next()); $j = $j + 1 }
    } sinon { $i = $i + 1 }
  }
  retour longueur($g5_fn)
}

fn g5_compile_fonction($f: entier, $principal: entier, $printl: entier, $exitl: entier) -> entier {
  g5_mark($g5_flbl[$f])
  # G5-IO : AVANT de déplacer sp, mémoriser argc et l'adresse de argv[0]
  # tels que le noyau les a posés sur la pile initiale. Ces cases sont sous
  # le début du tas (0x60000300) et ne peuvent donc pas être écrasées.
  si ($f == $principal) {
    g5_emit(ldroff(10, 31, 0))
    g5_emit(addi(11, 31, 8))
    g5_load(9, 1610612752)
    g5_emit(stroff(10, 9, 0))
    g5_emit(stroff(11, 9, 8))
  }
  g5_emit_subsp(g5_framesize($f))
  g5_emit(stroff(30, 31, 0))
  si ($f == $principal) {
    g5_load(9, 1610612736)
    # G5-TAS : le tas démarre désormais à 0x60002000. Les pages 0x60000300
    # (512 entrées de chaînes littérales) et 0x60001300 (256 entrées de
    # caractères) sont des tables d'internement, hors du tas.
    g5_load(8, 1610629120)
    g5_emit(stroff(8, 9, 0))
  }
  $p = 0
  tant_que ($p < $g5_fparam[$f]) { g5_emit(stroff($p, 31, g5_slotoff($p))); $p = $p + 1 }
  $i = 0
  tant_que ($i < $g5_fnop[$f]) {
    g5_mark($g5_oplbl[$g5_fop[$f] + $i])
    g5_op($g5_ops[$g5_fop[$f] + $i], $f, $principal, $printl, $exitl)
    si (longueur($g5_err) > 0) { retour -1 }
    $i = $i + 1
  }
  g5_mark($g5_endlbl[$f])
  si ($f == $principal) { g5_branch(1, $exitl)
  } sinon { g5_emit(ldroff(30, 31, 0)); g5_emit_addsp(g5_framesize($f)); g5_emit(RET_I()) }
  retour 0
}

# Routine write(1,buf,len) — reçoit la valeur dans x0. $lbl est le premier de 7 labels réservés.
fn g5_emit_print($lbl: entier) -> entier {
  g5_mark($lbl)
  # E/S réelles : write(1, sp+64, len) puis write(1, "\n", 1).
  # Les buffers de conversion VIVENT DANS LE CADRE (sp+64 / sp+128) :
  # la version historique écrivait aux adresses ABSOLUES 16 et 64 (SIGSEGV
  # dès qu'une chaîne était affichée) — constat rejoué sur le binaire HEAD.
  $lstr = g5_next()
  $lcpy = g5_next()
  $lwrtstr = g5_next()
  $lpos = g5_next()
  $ldig = g5_next()
  $ldloop = g5_next()
  $lrev = g5_next()
  $lrevloop = g5_next()
  $lwrtint = g5_next()
  $lfin = g5_next()
  g5_emit(stroff(0, 31, 8))
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 1))
  g5_branch(100, $lstr)
  # ── entier : conversion décimale signée ──
  g5_emit(g5_asr3(0, 0))
  g5_emit(addi(6, 31, 64))
  g5_emit(orrr(7, 31, 6))
  g5_emit(cmpi(0, 0))
  g5_branch(110, $lpos)
  g5_emit(movz(1, 45))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_emit(subr(0, 31, 0))
  g5_mark($lpos)
  g5_emit(cmpi(0, 0))
  g5_branch(101, $ldig)
  g5_emit(movz(1, 48))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_branch(0, $lwrtint)
  g5_mark($ldig)
  g5_emit(addi(3, 31, 128))
  g5_emit(movz(2, 0))
  g5_mark($ldloop)
  g5_emit(cmpi(0, 0))
  g5_branch(100, $lrev)
  g5_emit(movz(1, 10))
  g5_emit(udivr(4, 0, 1))
  g5_emit(msubr(5, 4, 1, 0))
  g5_emit(addi(5, 5, 48))
  g5_emit(strbio(5, 3, 0))
  g5_emit(addi(3, 3, 1))
  g5_emit(addi(2, 2, 1))
  g5_emit(orrr(0, 31, 4))
  g5_branch(0, $ldloop)
  g5_mark($lrev)
  g5_emit(subi(4, 3, 1))
  g5_emit(movz(5, 0))
  g5_mark($lrevloop)
  g5_emit(cmpr(5, 2))
  g5_branch(110, $lwrtint)
  g5_emit(ldrbio(1, 4, 0))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_emit(subi(4, 4, 1))
  g5_emit(addi(5, 5, 1))
  g5_branch(0, $lrevloop)
  g5_mark($lwrtint)
  g5_emit(subr(2, 7, 6))
  g5_emit(movz(0, 1))
  g5_emit(addi(1, 31, 64))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_branch(0, $lfin)
  # ── chaîne : write(1, descripteur+16, len) par blocs, SANS tampon de pile ──
  # (une copie dans sp+64 débordait le cadre de 9232 o dès ~9 Ko ; constat
  # rejoué avec lire_texte sur le RIR de 263 065 octets.)
  g5_mark($lstr)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(10, 9, 8))
  g5_emit(addi(1, 9, 16))
  g5_emit(movz(5, 0))
  g5_mark($lcpy)
  g5_emit(cmpr(5, 10))
  g5_branch(110, $lwrtstr)
  g5_emit(movz(0, 1))
  g5_emit(subr(2, 10, 5))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lwrtstr)
  g5_emit(orrr(4, 31, 0))
  g5_emit(addr(1, 1, 4))
  g5_emit(addr(5, 5, 4))
  g5_branch(0, $lcpy)
  g5_mark($lwrtstr)
  g5_branch(0, $lfin)
  g5_mark($lfin)
  # `>>` de Rose termine chaque affichage par un saut de ligne.
  g5_emit(movz(1, 10))
  g5_emit(strbio(1, 31, 64))
  g5_emit(movz(0, 1))
  g5_emit(addi(1, 31, 64))
  g5_emit(movz(2, 1))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(RET_I())
  retour 0
}

# ── G5-R : runtime des valeurs chaîne/liste ──
# Descripteur : [tag: 1=chaîne, 2=liste][longueur][données…].
# Tas : page RW à 0x60000000 ; le mot [0x60000000] contient le pointeur libre.
fn g5_emit_alloc($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_load(9, 1610612736)
  g5_emit(ldroff(2, 9, 0))
  g5_emit(orrr(1, 31, 0))
  g5_emit(orrr(0, 31, 2))
  g5_emit(addr(2, 2, 1))
  g5_emit(stroff(2, 9, 0))
  g5_emit(RET_I())
  retour 0
}

fn g5_emit_len($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(1, 0))
  g5_emit(ldroff(2, 1, 0))
  g5_emit(cmpi(2, 1))
  g5_branch(100, $lbl + 1)
  g5_emit(cmpi(2, 2))
  g5_branch(101, $lbl + 2)
  g5_emit(ldroff(0, 1, 8))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 1)
  g5_emit(ldroff(0, 1, 8))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 2)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}

fn g5_emit_ordre($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldrbio(0, 9, 16))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  retour 0
}

# sous_chaine(s, a, b) — x0=s, x1=a, x2=b ; renvoie une NOUVELLE chaîne.
fn g5_emit_sous($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(1, 1))
  g5_emit(g5_asr3(2, 2))
  g5_emit(orrr(8, 31, 1))
  g5_emit(subr(3, 2, 1))
  g5_emit(g5_masktag(10, 0))
  g5_emit(addr(4, 3, 3))
  g5_emit(addr(4, 4, 4))
  g5_emit(addr(4, 4, 4))
  g5_emit(addi(4, 4, 24))
  g5_emit(orrr(0, 31, 4))
  g5_alloc_inline()
  g5_emit(orrr(5, 31, 0))
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 5, 0))
  g5_emit(orrr(1, 31, 3))
  g5_emit(stroff(1, 5, 8))
  g5_emit(movz(6, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(6, 3))
  g5_branch(110, $lbl + 2)
  g5_emit(addr(7, 8, 6))
  g5_emit(ldrbr(7, 10, 7))
  g5_emit(addi(4, 6, 16))
  g5_emit(strbr(7, 5, 4))
  g5_emit(addi(6, 6, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(g5_tag1(0, 5))
  g5_emit(RET_I())
  retour 0
}

# idx(container, i) — chaîne : 1 caractère ; liste : élément.
fn g5_emit_idx($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(6, 0))
  g5_emit(ldroff(2, 6, 0))
  g5_emit(cmpi(2, 2))
  g5_branch(100, $lbl + 1)
  # G5-TAS : un caractère est un descripteur immuable de 24 octets ; on le
  # construit au plus une fois par valeur d'octet (table @0x60001300).
  g5_emit(g5_asr3(7, 1))
  g5_emit(addi(5, 7, 16))
  g5_emit(ldrbr(4, 6, 5))
  g5_load(12, 1610625024)
  g5_emit(g5_lsl3(4, 4))
  g5_emit(addr(12, 12, 4))
  g5_emit(ldroff(0, 12, 0))
  g5_emit(cmpi(0, 0))
  g5_branch(101, $lbl + 2)
  g5_load(0, 24)
  g5_alloc_inline()
  g5_emit(orrr(3, 31, 0))
  g5_emit(movz(4, 1))
  g5_emit(stroff(4, 3, 0))
  g5_emit(movz(4, 1))
  g5_emit(stroff(4, 3, 8))
  g5_emit(addi(5, 7, 16))
  g5_emit(ldrbr(4, 6, 5))
  g5_emit(strbio(4, 3, 16))
  g5_emit(stroff(3, 12, 0))
  g5_mark($lbl + 2)
  g5_emit(g5_tag1(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 1)
  g5_emit(g5_asr3(1, 1))
  g5_emit(addr(2, 1, 1))
  g5_emit(addr(2, 2, 2))
  g5_emit(addr(2, 2, 2))
  g5_emit(addi(2, 2, 24))
  g5_emit(addr(2, 6, 2))
  g5_emit(ldroff(0, 2, 0))
  g5_emit(RET_I())
  retour 0
}

# joindre(liste, valeur) — invite liste [tag=2][len][cap][valeurs…].
fn g5_emit_join($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(5, 0))
  g5_emit(ldroff(2, 5, 8))
  g5_emit(ldroff(3, 5, 16))
  g5_emit(cmpr(2, 3))
  g5_branch(110, $lbl + 1)
  g5_emit(addr(4, 2, 2))
  g5_emit(addr(4, 4, 4))
  g5_emit(addr(4, 4, 4))
  g5_emit(addi(4, 4, 24))
  g5_emit(addr(4, 5, 4))
  g5_emit(stroff(1, 4, 0))
  g5_emit(addi(2, 2, 1))
  g5_emit(stroff(2, 5, 8))
  g5_emit(g5_tag2(0, 5))
  g5_emit(RET_I())
  g5_mark($lbl + 1)
  g5_emit(orrr(6, 31, 1))
  g5_emit(orrr(8, 31, 2))
  g5_emit(addi(3, 8, 1))
  g5_emit(addr(4, 3, 3))
  g5_emit(addr(4, 4, 4))
  g5_emit(addr(4, 4, 4))
  g5_emit(addi(4, 4, 24))
  g5_emit(orrr(0, 31, 4))
  g5_alloc_inline()
  g5_emit(orrr(7, 31, 0))
  g5_emit(movz(1, 2))
  g5_emit(stroff(1, 7, 0))
  g5_emit(addi(1, 8, 1))
  g5_emit(stroff(1, 7, 8))
  g5_emit(stroff(1, 7, 16))
  g5_emit(movz(3, 0))
  g5_mark($lbl + 2)
  g5_emit(cmpr(3, 8))
  g5_branch(110, $lbl + 3)
  g5_emit(addr(4, 3, 3))
  g5_emit(addr(4, 4, 4))
  g5_emit(addr(4, 4, 4))
  g5_emit(addi(4, 4, 24))
  g5_emit(addr(4, 5, 4))
  g5_emit(ldroff(1, 4, 0))
  g5_emit(addr(4, 3, 3))
  g5_emit(addr(4, 4, 4))
  g5_emit(addr(4, 4, 4))
  g5_emit(addi(4, 4, 24))
  g5_emit(addr(4, 7, 4))
  g5_emit(stroff(1, 4, 0))
  g5_emit(addi(3, 3, 1))
  g5_branch(0, $lbl + 2)
  g5_mark($lbl + 3)
  g5_emit(addr(4, 8, 8))
  g5_emit(addr(4, 4, 4))
  g5_emit(addr(4, 4, 4))
  g5_emit(addi(4, 4, 24))
  g5_emit(addr(4, 7, 4))
  g5_emit(stroff(6, 4, 0))
  g5_emit(g5_tag2(0, 7))
  g5_emit(RET_I())
  retour 0
}

# inserer(liste, i, valeur) — STUB documenté : se comporte comme joindre.
fn g5_emit_inser($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(RET_I())
  retour 0
}

# entier(chaine) — conversion décimale signée.
fn g5_emit_entier($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(1, 9, 8))
  g5_emit(movz(2, 0))
  g5_emit(movz(3, 0))
  g5_emit(movz(4, 1))
  g5_emit(cmpi(1, 0))
  g5_branch(100, $lbl + 1)
  g5_emit(ldrbio(5, 9, 16))
  g5_emit(cmpi(5, 45))
  g5_branch(101, $lbl + 1)
  g5_load(4, -1)
  g5_emit(movz(2, 1))
  g5_mark($lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(cmpr(2, 1))
  g5_branch(110, $lbl + 3)
  g5_emit(addi(6, 2, 16))
  g5_emit(ldrbr(5, 9, 6))
  g5_emit(subi(5, 5, 48))
  g5_emit(movz(6, 10))
  g5_emit(mulr(3, 3, 6))
  g5_emit(addr(3, 3, 5))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 2)
  g5_mark($lbl + 3)
  g5_emit(cmpi(4, 0))
  g5_branch(110, $lbl + 4)
  g5_emit(subr(3, 31, 3))
  g5_mark($lbl + 4)
  g5_emit(g5_lsl3(0, 3))
  g5_emit(RET_I())
  retour 0
}

# `chaine(x)` : si x est déjà une chaîne taguée (bits bas = 1), identité ;
# sinon on fabrique une chaîne vide [tag=1][len=0]. La conversion décimale
# d'un entier n'est PAS implémentée ici (elle n'est pas nécessaire au chemin
# d'émission de l'émetteur lui-même) — constat documenté.
fn g5_emit_ch($lbl: entier) -> entier {
  g5_mark($lbl)
  # ABI unique : test du TAG (bits bas), plus de test de plage ad hoc.
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 1))
  g5_branch(101, $lbl + 1)
  g5_emit(RET_I())
  g5_mark($lbl + 1)
  g5_load(0, 16)
  g5_alloc_inline()
  g5_emit(orrr(5, 31, 0))
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 5, 0))
  g5_emit(movz(1, 0))
  g5_emit(stroff(1, 5, 8))
  g5_emit(g5_tag1(0, 5))
  g5_emit(RET_I())
  retour 0
}

# concat(a,b) — '+' sur deux chaînes. x0=a taguée, x1=b taguée.
# Renvoie une NOUVELLE chaîne taguée [tag=1][len][octets…].
fn g5_emit_cat($lbl: entier) -> entier {
  g5_mark($lbl)
  $lna = g5_next()
  $lga = g5_next()
  $lnb = g5_next()
  $lgb = g5_next()
  $lla = g5_next()
  $laa = g5_next()
  $llb = g5_next()
  $ldn = g5_next()
  g5_emit(g5_tagbits(2, 0)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lna)
  g5_emit(g5_masktag(6, 0)); g5_emit(ldroff(8, 6, 8))
  g5_branch(0, $lga)
  g5_mark($lna)
  g5_emit(movz(6, 0)); g5_emit(movz(8, 0))
  g5_mark($lga)
  g5_emit(g5_tagbits(2, 1)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lnb)
  g5_emit(g5_masktag(7, 1)); g5_emit(ldroff(11, 7, 8))
  g5_branch(0, $lgb)
  g5_mark($lnb)
  g5_emit(movz(7, 0)); g5_emit(movz(11, 0))
  g5_mark($lgb)
  g5_emit(addr(10, 8, 11))
  # Taille = 16 + 8*ceil(total/8) : l'alignement 8 est OBLIGATOIRE, sinon
  # les bits bas du pointeur servent de tag et l'allocation suivante
  # dérape hors du tas (constat : SIGSEGV sur str x1,[x4] dans joindre).
  g5_emit(addi(2, 10, 7))
  g5_emit(g5_lsr3(2, 2))
  g5_emit(g5_lsl3(2, 2))
  g5_emit(addi(2, 2, 16))
  g5_emit(orrr(0, 31, 2))
  g5_alloc_inline()
  g5_emit(orrr(5, 31, 0))
  g5_emit(movz(1, 1)); g5_emit(stroff(1, 5, 0))
  g5_emit(orrr(1, 31, 10)); g5_emit(stroff(1, 5, 8))
  g5_emit(movz(2, 0))
  g5_mark($lla)
  g5_emit(cmpr(2, 8)); g5_branch(110, $laa)
  g5_emit(addi(3, 2, 16)); g5_emit(ldrbr(4, 6, 3))
  g5_emit(strbr(4, 5, 3))
  g5_emit(addi(2, 2, 1)); g5_branch(0, $lla)
  g5_mark($laa)
  g5_emit(addi(6, 8, 16))
  g5_emit(movz(2, 0))
  g5_mark($llb)
  g5_emit(cmpr(2, 11)); g5_branch(110, $ldn)
  g5_emit(addi(3, 2, 16)); g5_emit(ldrbr(4, 7, 3))
  g5_emit(addr(3, 6, 2)); g5_emit(strbr(4, 5, 3))
  g5_emit(addi(2, 2, 1)); g5_branch(0, $llb)
  g5_mark($ldn)
  g5_emit(g5_tag1(0, 5))
  g5_emit(RET_I())
  retour 0
}

# streq(a,b) — égalité de CONTENU de deux chaînes taguées. Booléen tagué (0 ou 8).
fn g5_emit_streq($lbl: entier) -> entier {
  g5_mark($lbl)
  $lf = g5_next()
  $lt = g5_next()
  $ll = g5_next()
  g5_emit(g5_masktag(6, 0)); g5_emit(g5_masktag(7, 1))
  g5_emit(ldroff(2, 6, 8)); g5_emit(ldroff(3, 7, 8))
  g5_emit(cmpr(2, 3)); g5_branch(101, $lf)
  g5_emit(orrr(10, 31, 2))
  g5_emit(movz(2, 0))
  g5_mark($ll)
  g5_emit(cmpr(2, 10)); g5_branch(110, $lt)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 6, 3)); g5_emit(ldrbr(5, 7, 3))
  g5_emit(cmpr(4, 5)); g5_branch(101, $lf)
  g5_emit(addi(2, 2, 1)); g5_branch(0, $ll)
  g5_mark($lf)
  g5_emit(movz(0, 0)); g5_emit(RET_I())
  g5_mark($lt)
  g5_load(0, 8); g5_emit(RET_I())
  retour 0
}

# Primitives non implémentées : retour neutre (0 ou chaîne vide).
fn g5_emit_stub0($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}
fn g5_emit_stubs($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_load(0, 24)
  g5_alloc_inline()
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 0, 0))
  g5_emit(movz(1, 0))
  g5_emit(stroff(1, 0, 8))
  g5_emit(g5_tag1(0, 0))
  g5_emit(RET_I())
  retour 0
}

# ── G5-IO : routines ÉMISES dans l'ELF (syscalls aarch64, svc #0) ──
# Cartographie mémoire RW (page à 0x60000000) :
#   0x60000000  pointeur libre du tas (démarre à 0x60000300)
#   0x60000010  argc brut de la pile initiale
#   0x60000018  adresse de argv[0] sur la pile initiale
#   0x60000020  tampon de chemin (480 octets, NUL terminal)
#   0x60000200  tampon struct stat (144 octets, st_size à +48)
#   0x60000300  début du tas (allocations des descripteurs)
# Couches syscalls vérifiées : openat=56, close=57, read=63, write=64, fstat=80.

# nb_arguments() -> argc utilisateur (argc ELF - 1), entier tagué.
fn g5_emit_nbargs($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_load(9, 1610612752)
  g5_emit(ldroff(0, 9, 0))
  g5_emit(subi(0, 0, 1))
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 1)
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 1)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}

# argument(i) -> argv[i+1] copié en chaîne taguée [tag=1][len][octets].
fn g5_emit_argument($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0))
  g5_emit(addi(0, 0, 1))
  g5_load(9, 1610612760)
  g5_emit(ldroff(9, 9, 0))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(addr(6, 9, 0))
  g5_emit(ldroff(6, 6, 0))
  # strlen -> x7
  g5_emit(movz(7, 0))
  g5_mark($lbl + 1)
  g5_emit(ldrbr(2, 6, 7))
  g5_emit(cmpi(2, 0))
  g5_branch(100, $lbl + 2)
  g5_emit(addi(7, 7, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(addi(0, 7, 7))
  g5_emit(g5_lsr3(0, 0))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(addi(0, 0, 16))
  g5_alloc_inline()
  g5_emit(orrr(10, 31, 0))
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 10, 0))
  g5_emit(orrr(1, 31, 7))
  g5_emit(stroff(1, 10, 8))
  g5_emit(movz(2, 0))
  g5_mark($lbl + 3)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 4)
  g5_emit(ldrbr(4, 6, 2))
  g5_emit(addi(3, 2, 16))
  g5_emit(strbr(4, 10, 3))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(g5_tag1(0, 10))
  g5_emit(RET_I())
  retour 0
}

# lire_texte(chemin) -> openat + fstat + read + close, chaîne taguée.
fn g5_emit_lire($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(7, 9, 8))
  g5_load(6, 1610612768)
  g5_emit(movz(2, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 2)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 9, 3))
  g5_emit(strbr(4, 6, 2))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(movz(5, 0))
  g5_emit(strbr(5, 6, 2))
  # openat(AT_FDCWD=-100, chemin, O_RDONLY=0, 0) = 56
  g5_load(0, -100)
  g5_load(1, 1610612768)
  g5_emit(movz(2, 0))
  g5_emit(movz(3, 0))
  g5_emit(movz(8, 56))
  g5_emit(SVC_I())
  g5_emit(orrr(10, 31, 0))
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 9)
  # fstat(fd, tampon) = 80 ; st_size à +48
  g5_emit(orrr(0, 31, 10))
  g5_load(1, 1610613248)
  g5_emit(movz(8, 80))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 9)
  g5_load(11, 1610613248 + 48)
  g5_emit(ldroff(7, 11, 0))
  g5_emit(addi(0, 7, 7))
  g5_emit(g5_lsr3(0, 0))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(addi(0, 0, 16))
  g5_alloc_inline()
  g5_emit(orrr(11, 31, 0))
  g5_emit(movz(6, 0))
  g5_mark($lbl + 3)
  g5_emit(cmpr(6, 7))
  g5_branch(110, $lbl + 4)
  g5_emit(addi(1, 11, 16))
  g5_emit(addr(1, 1, 6))
  g5_emit(orrr(0, 31, 10))
  g5_emit(movz(8, 63))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(100, $lbl + 4)
  g5_branch(111, $lbl + 4)
  g5_emit(addr(6, 6, 0))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(orrr(0, 31, 10))
  g5_emit(movz(8, 57))
  g5_emit(SVC_I())
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 11, 0))
  g5_emit(orrr(1, 31, 6))
  g5_emit(stroff(1, 11, 8))
  g5_emit(g5_tag1(0, 11))
  g5_emit(RET_I())
  g5_mark($lbl + 9)
  g5_load(0, 16)
  g5_alloc_inline()
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 0, 0))
  g5_emit(movz(1, 0))
  g5_emit(stroff(1, 0, 8))
  g5_emit(g5_tag1(0, 0))
  g5_emit(RET_I())
  retour 0
}

# ecrire_bytes / ecrire_texte(chemin, donnees) -> openat(O_WRONLY|O_CREAT|O_TRUNC)
# + write + close. Renvoie `vide` (0 tagué), comme la primitive Rose.
fn g5_emit_ecrire($lbl: entier) -> entier {
  g5_mark($lbl)
  # x1 = données ; openat utilisera x1 pour le chemin : le préserver dans x11.
  g5_emit(orrr(11, 31, 1))
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(7, 9, 8))
  g5_load(6, 1610612768)
  g5_emit(movz(2, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 2)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 9, 3))
  g5_emit(strbr(4, 6, 2))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(movz(5, 0))
  g5_emit(strbr(5, 6, 2))
  # 577 = O_WRONLY(1)|O_CREAT(64)|O_TRUNC(512) ; 420 = 0644
  g5_load(0, -100)
  g5_load(1, 1610612768)
  g5_load(2, 577)
  g5_load(3, 420)
  g5_emit(movz(8, 56))
  g5_emit(SVC_I())
  g5_emit(orrr(10, 31, 0))
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 6)
  g5_emit(g5_masktag(9, 11))
  g5_emit(ldroff(7, 9, 8))
  g5_emit(addi(1, 9, 16))
  g5_emit(movz(6, 0))
  g5_mark($lbl + 3)
  g5_emit(cmpr(6, 7))
  g5_branch(110, $lbl + 4)
  g5_emit(orrr(0, 31, 10))
  g5_emit(subr(2, 7, 6))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 4)
  g5_emit(orrr(4, 31, 0))
  g5_emit(addr(1, 1, 4))
  g5_emit(addr(6, 6, 4))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(orrr(0, 31, 10))
  g5_emit(movz(8, 57))
  g5_emit(SVC_I())
  g5_mark($lbl + 6)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}

fn g5_patch() -> liste<entier> {
  $out = [0 : entier]
  $i = 0
  tant_que ($i < longueur($g5_code)) {
    $m = $g5_meta[$i]
    si ($m == "") {
      joindre($out, $g5_code[$i])
    } sinon {
      $bar = g4_pos($m, "|")
      $l = g4_entier_ou_zero(g5_sub($m, 1, $bar))
      $kind = g4_entier_ou_zero(g5_sub($m, $bar + 1, longueur($m)))
      $t = g5_labelidx($l)
      $off = $t - $i
      si ($kind == 0) { joindre($out, 335544320 + g5_wrap($off, 67108864))
      } sinon si ($kind == 1) { joindre($out, 2483027968 + g5_wrap($off, 67108864))
      } sinon { joindre($out, 1409286144 + g5_wrap($off, 524288) * 32 + ($kind - 100)) }
    }
    $i = $i + 1
  }
  retour $out
}

fn g5_elf() -> chaine {
  $base = 4194304
  $heap = 1610612736
  $code_off = 176
  $fsz = $code_off + 4 * longueur($g5_code)
  $out = ""
  $out = $out + caractere(127) + "ELF" + caractere(2) + caractere(1) + caractere(1) + caractere(0)
  $z = 0
  tant_que ($z < 8) { $out = $out + caractere(0); $z = $z + 1 }
  $out = $out + u16le(2) + u16le(183) + u32le(1)
  $out = $out + u64le($base + $code_off) + u64le(64) + u64le(0) + u32le(0)
  $out = $out + u16le(64) + u16le(56) + u16le(2) + u16le(0) + u16le(0) + u16le(0)
  $out = $out + u32le(1) + u32le(5)
  $out = $out + u64le(0) + u64le($base) + u64le($base)
  $out = $out + u64le($fsz) + u64le($fsz) + u64le(4096)
  $out = $out + u32le(1) + u32le(6)
  $out = $out + u64le(0) + u64le($heap) + u64le($heap)
  # Tas de 64 Mio (1 Mio épuisé, 64 Mio épuisé aussi, 512 Mio épuisé en 1,3 s :
  # boucle d'allocation sans fin, pas un simple manque de place — voir le doc).
  $out = $out + u64le(0) + u64le(67108864) + u64le(4096)
  $i = 0
  tant_que ($i < longueur($g5_code)) { $out = $out + u32le($g5_code[$i]); $i = $i + 1 }
  retour $out
}

# ── Point d'entrée ──
# ── Dispatch G5 : RIR texte → ELF64 autonome ; sinon voie historique ──
si (nb_arguments() >= 1) {
$src = lire_texte(argument(0))
si (longueur($src) >= 3 et sous_chaine($src, 0, 3) == "rir") {
$nfn = g5_parse($src)
$principal = 0
$i = 0
tant_que ($i < $nfn) {
  si ($g5_fn[$i] == "$principal") { $principal = $i }
  $i = $i + 1
}
$printl = g5_next()
$k = 0
tant_que ($k < 14) { g5_next(); $k = $k + 1 }
$g5_allocl = g5_next()
$g5_lenl = g5_next()
$k = 0
tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$g5_ordl = g5_next()
$g5_sousl = g5_next()
$k = 0
tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$g5_idxl = g5_next()
$k = 0
tant_que ($k < 1) { g5_next(); $k = $k + 1 }
$g5_chl = g5_next()
$k = 0
tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$g5_joindrel = g5_next()
$k = 0
tant_que ($k < 3) { g5_next(); $k = $k + 1 }
$g5_inserrel = g5_next()
$g5_entierl = g5_next()
$k = 0
tant_que ($k < 4) { g5_next(); $k = $k + 1 }
$g5_catl = g5_next()
$k = 0
tant_que ($k < 8) { g5_next(); $k = $k + 1 }
$g5_streql = g5_next()
$k = 0
tant_que ($k < 3) { g5_next(); $k = $k + 1 }
$g5_stub0l = g5_next()
$g5_stubsl = g5_next()
# G5-IO : réservation des labels des routines syscalls (4 internes chacune).
$g5_nbargs_l = g5_next()
$k = 0
tant_que ($k < 4) { g5_next(); $k = $k + 1 }
$g5_argument_l = g5_next()
$k = 0
tant_que ($k < 6) { g5_next(); $k = $k + 1 }
$g5_lire_l = g5_next()
$k = 0
tant_que ($k < 12) { g5_next(); $k = $k + 1 }
$g5_ecrire_l = g5_next()
$k = 0
tant_que ($k < 8) { g5_next(); $k = $k + 1 }
$exitl = g5_next()
g5_compile_fonction($principal, $principal, $printl, $exitl)
$i = 0
tant_que ($i < $nfn) {
  si ($i != $principal) { g5_compile_fonction($i, $principal, $printl, $exitl) }
  $i = $i + 1
}
g5_emit_alloc($g5_allocl)
g5_emit_len($g5_lenl)
g5_emit_ordre($g5_ordl)
g5_emit_sous($g5_sousl)
g5_emit_idx($g5_idxl)
g5_emit_ch($g5_chl)
g5_emit_join($g5_joindrel)
g5_emit_inser($g5_inserrel)
g5_emit_entier($g5_entierl)
g5_emit_cat($g5_catl)
g5_emit_streq($g5_streql)
g5_emit_stub0($g5_stub0l)
g5_emit_stubs($g5_stubsl)
g5_emit_nbargs($g5_nbargs_l)
g5_emit_argument($g5_argument_l)
g5_emit_lire($g5_lire_l)
g5_emit_ecrire($g5_ecrire_l)
g5_emit_print($printl)
g5_mark($exitl)
g5_emit(movz(0, 0))
g5_emit(movz(8, 93))
g5_emit(SVC_I())
si (longueur($g5_err) > 0) {
  afficher_erreur("G5 : " + $g5_err[0])
  quitter(2)
}
$g5_code = g5_patch()
ecrire_bytes("/dev/stdout", g5_elf())
quitter(0)
}
}

# ── Substitution d'un nom de variable nu (bornes alphanumeriques) ──
fn substituer_nom($txt: chaine, $nom: chaine, $val: chaine) -> chaine {
  $res = ""
  $k = 0
  $ln = longueur($txt)
  $lnn = longueur($nom)
  tant_que ($k < $ln) {
    $ok = 0
    si ($k + $lnn <= $ln) {
      si (sous_chaine($txt, $k, $k + $lnn) == $nom) {
        $ok_avant = 1
        si ($k > 0) {
          $prec = sous_chaine($txt, $k - 1, $k)
          si (($prec >= "a" et $prec <= "z") ou ($prec >= "A" et $prec <= "Z") ou ($prec >= "0" et $prec <= "9") ou $prec == "_") {
            $ok_avant = 0
          }
        }
        $ok_apres = 1
        si ($k + $lnn < $ln) {
          $suiv = sous_chaine($txt, $k + $lnn, $k + $lnn + 1)
          si (($suiv >= "a" et $suiv <= "z") ou ($suiv >= "A" et $suiv <= "Z") ou ($suiv >= "0" et $suiv <= "9") ou $suiv == "_") {
            $ok_apres = 0
          }
        }
        si ($ok_avant == 1 et $ok_apres == 1) {
          $ok = 1
        }
      }
    }
    si ($ok == 1) {
      $res = $res + $val
      $k = $k + $lnn
    } sinon {
      $res = $res + sous_chaine($txt, $k, $k + 1)
      $k = $k + 1
    }
  }
  retour $res
}

# ── Constantes ELF64 ──
$ELFMAG = "\177ELF"
$ELFCLASS64 = 2
$ELFDATA2LSB = 1
$EV_CURRENT = 1
$ELFOSABI_SYSV = 0
$ET_EXEC = 2
$EM_AARCH64 = 183
$PT_LOAD = 1
$PF_R = 4
$PF_W = 2
$PF_X = 1
$SHT_NULL = 0
$SHT_PROGBITS = 1
$SHT_STRTAB = 3
$SHN_UNDEF = 0

# Adresse de chargement aarch64
$BASE_ADDR = 4194304
$TEXT_OFFSET = 4096
$TEXT_ADDR = $BASE_ADDR + $TEXT_OFFSET

# ── Émetteur ELF minimal : produit un binaire qui retourne 0 ──
fn fold_last_return($sub2: chaine) -> chaine {
  # La chaîne $sub2 est une suite d'expressions séparées par des espaces au
  # niveau 0 (une par « retour » dans le corps d'une fonction). On rend la
  # dernière expression, ou $sub2 si aucune découpe n'est nécessaire.
  $pos_dernier_espace = -1
  $prof_q = 0
  $qe = 0
  tant_que ($qe < longueur($sub2)) {
    $cq = sous_chaine($sub2, $qe, $qe + 1)
    si ($cq == "(" ou $cq == "[" ou $cq == "{") { $prof_q = $prof_q + 1 }
    si ($cq == ")" ou $cq == "]" ou $cq == "}") { $prof_q = $prof_q - 1 }
    si ($cq == " " et $prof_q == 0) { $pos_dernier_espace = $qe }
    $qe = $qe + 1
  }
  si ($pos_dernier_espace >= 0) {
    retour sous_chaine($sub2, $pos_dernier_espace + 1, longueur($sub2))
  }
  retour $sub2
}

# Rend la position de la prochaine parenthese ouvrante precedee immediatement
# par un identifiant alphanumerique (0 si aucune).
fn find_appel($s: chaine, $debut: entier) -> entier {
  $k = $debut
  $ln = longueur($s)
  tant_que ($k < $ln) {
    $c = sous_chaine($s, $k, $k + 1)
    si ($c == "(") {
      # reculer sur un identifiant
      $j = $k
      si ($j > 0) {
        $prev = sous_chaine($s, $j - 1, $j)
        si (($prev >= "a" et $prev <= "z") ou ($prev >= "A" et $prev <= "Z") ou ($prev >= "0" et $prev <= "9") ou $prev == "_") {
          retour $k
        }
      }
    }
    $k = $k + 1
  }
  retour -1
}

# Extrait la liste des arguments d'un appel starting a $pos_open (la
# position de "("), en remplissant la liste $out via joindre. Rend la
# position de la parenthese fermante.
fn lire_args_appel($s: chaine, $pos_open: entier) -> entier {
  $prof = 1
  $cur = ""
  $lst = [""]
  $nb = 0
  $p = $pos_open + 1
  $ln = longueur($s)
  $fin_p = $p
  $fini = 0
  tant_que ($p < $ln et $fini == 0) {
    $c = sous_chaine($s, $p, $p + 1)
    si ($c == "(" ou $c == "[" ou $c == "{") {
      $prof = $prof + 1
      $cur = $cur + $c
    } sinon si ($c == ")" ou $c == "]" ou $c == "}") {
      $prof = $prof - 1
      si ($prof == 0) {
        $fini = 1
        $fin_p = $p
      } sinon {
        $cur = $cur + $c
      }
    } sinon si ($c == "," et $prof == 1) {
      # trim
      $ca = $cur
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
      joindre($lst, $ca)
      $nb = $nb + 1
      $cur = ""
    } sinon {
      $cur = $cur + $c
    }
    $p = $p + 1
  }
  $ca = $cur
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
  si (longueur($ca) > 0) {
    joindre($lst, $ca)
    $nb = $nb + 1
  }
  # table de retour : on la construit par paires (pos, n, args) via des vars
  # locales : $pos_ferm, $nb_args_out, $lst_args_out
  $pos_ferm = $fin_p
  $nb_args_out = $nb
  $lst_args_out = $lst
  # On les expose via une table renvoyée ; pour rester simple on rend 3 valeurs
  # séparees par des espaces via une chaine, que le caller décompose.
  retour $fin_p
}

# Variante : lit les args d'un appel et rend une liste $out (première cellule
# = position fermante, deuxième = nombre d'args, les suivantes = args).
fn lire_args_appel2($s: chaine, $pos_open: entier) -> entier {
  $prof = 1
  $cur = ""
  $lst = ["#"]
  $nb = 0
  $p = $pos_open + 1
  $ln = longueur($s)
  $fin_p = $p
  $fini = 0
  tant_que ($p < $ln et $fini == 0) {
    $c = sous_chaine($s, $p, $p + 1)
    si ($c == "(" ou $c == "[" ou $c == "{") {
      $prof = $prof + 1
      $cur = $cur + $c
    } sinon si ($c == ")" ou $c == "]" ou $c == "}") {
      $prof = $prof - 1
      si ($prof == 0) {
        $fini = 1
        $fin_p = $p
      } sinon {
        $cur = $cur + $c
      }
    } sinon si ($c == "," et $prof == 1) {
      $ca = $cur
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
      joindre($lst, $ca)
      $nb = $nb + 1
      $cur = ""
    } sinon {
      $cur = $cur + $c
    }
    $p = $p + 1
  }
  $ca = $cur
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
  si (longueur($ca) > 0) {
    joindre($lst, $ca)
    $nb = $nb + 1
  }
  $lia_out = $lst
  $lia_n = $nb
  retour $fin_p
}

$lia_n = 0
$lia_out = ["#"]

# Extraire l'expression situee apres le premier "retour" au niveau 0 d'un
# bloc (ignorant les accolades imbriquees). Rend le bloc tel quel si aucun
# "retour" de niveau 0 n'est trouve.
fn extraire_retour($_b: chaine) -> chaine {
  $_i = 0
  $_ln = longueur($_b)
  $_prof = 0
  $_ret = ""
  tant_que ($_i < $_ln) {
    $_ch = sous_chaine($_b, $_i, $_i + 1)
    si ($_ch == "{") { $_prof = $_prof + 1 }
    sinon si ($_ch == "}") { $_prof = $_prof - 1 }
    sinon si ($_prof == 0) {
      si ($_i + 6 <= $_ln et sous_chaine($_b, $_i, $_i + 6) == "retour") {
        $_j = $_i + 6
        tant_que ($_j < $_ln et sous_chaine($_b, $_j, $_j + 1) == " ") { $_j = $_j + 1 }
        $_ret = sous_chaine($_b, $_j, $_ln)
        $_nbret = longueur($_ret)
        tant_que ($_nbret > 0 et (sous_chaine($_ret, $_nbret - 1, $_nbret) == " " ou sous_chaine($_ret, $_nbret - 1, $_nbret) == "
" ou sous_chaine($_ret, $_nbret - 1, $_nbret) == "	")) {
          $_ret = sous_chaine($_ret, 0, $_nbret - 1)
          $_nbret = longueur($_ret)
        }
        retour $_ret
      }
    }
    $_i = $_i + 1
  }
  retour $_b
}

# Resoudre un corps de fonction (eventuellement contenant des `si`) en
# l'expression de retour nue. Les arguments ont deja ete substitues dans
# $corps. Evalue les conditions `si` a la compilation via eval_expr.
fn resoudre_corps($_c: chaine) -> chaine {
  $_pos = 0
  $_ln = longueur($_c)
  $_ret = ""
  $_fini = 0
  tant_que ($_pos < $_ln et $_fini == 0) {
    tant_que ($_pos < $_ln et (sous_chaine($_c, $_pos, $_pos + 1) == " " ou sous_chaine($_c, $_pos, $_pos + 1) == "
" ou sous_chaine($_c, $_pos, $_pos + 1) == "	")) { $_pos = $_pos + 1 }
    si ($_pos >= $_ln) { $_fini = 1 }
    sinon si (sous_chaine($_c, $_pos, $_pos + 2) == "si") {
      $_cc = ""
      si ($_pos + 2 < $_ln) { $_cc = sous_chaine($_c, $_pos + 2, $_pos + 3) }
      si ($_cc != " " et $_cc != "(") { $_fini = 1 }
      sinon {
        $_p = $_pos + 3
        tant_que ($_p < $_ln et sous_chaine($_c, $_p, $_p + 1) == " ") { $_p = $_p + 1 }
        si ($_p >= $_ln ou sous_chaine($_c, $_p, $_p + 1) != "(") { $_fini = 1 }
        sinon {
          $_cond = ""
          $_prof = 1
          $_p = $_p + 1
          tant_que ($_p < $_ln et $_prof > 0) {
            $_ch = sous_chaine($_c, $_p, $_p + 1)
            si ($_ch == "(") { $_prof = $_prof + 1 }
            sinon si ($_ch == ")") { $_prof = $_prof - 1 }
            si ($_prof > 0) { $_cond = $_cond + $_ch }
            $_p = $_p + 1
          }
          $_cond_val = eval_expr($_cond)
          $_est_vrai = 1
          si ($_cond_val == "0" ou $_cond_val == "faux" ou $_cond_val == "" ou longueur($_cond_val) == 0) { $_est_vrai = 0 }
          tant_que ($_p < $_ln et sous_chaine($_c, $_p, $_p + 1) == " ") { $_p = $_p + 1 }
          si ($_p >= $_ln ou sous_chaine($_c, $_p, $_p + 1) != "{") { $_fini = 1 }
          sinon {
            $_prof = 1
            $_p = $_p + 1
            $_debut_a = $_p
            tant_que ($_p < $_ln et $_prof > 0) {
              $_ch = sous_chaine($_c, $_p, $_p + 1)
              si ($_ch == "{") { $_prof = $_prof + 1 }
              sinon si ($_ch == "}") { $_prof = $_prof - 1 }
              $_p = $_p + 1
            }
            $_fin_a = $_p - 1
            $_alors = sous_chaine($_c, $_debut_a, $_fin_a)
            si ($_est_vrai == 1) {
              $_ret = extraire_retour($_alors)
              $_fini = 1
            } sinon {
              tant_que ($_p < $_ln et (sous_chaine($_c, $_p, $_p + 1) == " " ou sous_chaine($_c, $_p, $_p + 1) == "
" ou sous_chaine($_c, $_p, $_p + 1) == "	")) { $_p = $_p + 1 }
              $_trouve_sinon = 0
              si ($_p + 5 <= $_ln) {
                si (sous_chaine($_c, $_p, $_p + 1) == "s" et sous_chaine($_c, $_p + 1, $_p + 2) == "i" et sous_chaine($_c, $_p + 2, $_p + 3) == "n" et sous_chaine($_c, $_p + 3, $_p + 4) == "o" et sous_chaine($_c, $_p + 4, $_p + 5) == "n") {
                  $_trouve_sinon = 1
                }
              }
              si ($_trouve_sinon == 1) {
                $_p2 = $_p + 5
                tant_que ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == " ") { $_p2 = $_p2 + 1 }
                $_cc2 = ""
                si ($_p2 + 2 <= $_ln) { $_cc2 = sous_chaine($_c, $_p2, $_p2 + 2) }
                si ($_cc2 == "si") {
                  $_pos = $_p2
                } sinon {
                  tant_que ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == " ") { $_p2 = $_p2 + 1 }
                  si ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == "{") {
                    $_prof = 1
                    $_p2 = $_p2 + 1
                    $_debut_s = $_p2
                    tant_que ($_p2 < $_ln et $_prof > 0) {
                      $_ch = sous_chaine($_c, $_p2, $_p2 + 1)
                      si ($_ch == "{") { $_prof = $_prof + 1 }
                      sinon si ($_ch == "}") { $_prof = $_prof - 1 }
                      $_p2 = $_p2 + 1
                    }
                    $_fin_s = $_p2 - 1
                    $_sinon_bloc = sous_chaine($_c, $_debut_s, $_fin_s)
                    $_ret = extraire_retour($_sinon_bloc)
                    $_fini = 1
                  } sinon {
                    $_fini = 1
                  }
                  $_pos = $_ln
                }
              } sinon {
                $_pos = $_p
              }
            }
          }
        }
      }
    } sinon {
      $_reste = sous_chaine($_c, $_pos, $_ln)
      $_ret = extraire_retour($_reste)
      $_fini = 1
    }
  }
  si (longueur($_ret) == 0) { retour $_c } sinon { retour $_ret }
}

# Plier iterativement une expression `$expr` qui peut contenir des appels a
# des fonctions deja enregistrees dans $fn_noms/$fn_params/$fn_retours.
fn plier_expression($expr: chaine) -> chaine {
  $cour = $expr
  $tour = 0
  tant_que ($tour < 256) {
    $tour = $tour + 1
    # si entierement numerique, evaluer.
    $tn = 1
    $qn = 0
    $lnc = longueur($cour)
    tant_que ($qn < $lnc) {
      $cn = sous_chaine($cour, $qn, $qn + 1)
      si (($cn >= "a" et $cn <= "z") ou ($cn >= "A" et $cn <= "Z")) {
        $tn = 0
        $qn = $lnc
      }
      $qn = $qn + 1
    }
    si ($tn == 1 et $lnc > 0) {
      $ev = eval_expr($cour)
      si (longueur($ev) > 0) { $cour = $ev }
      $tour = 256
    } sinon {
      # trouver le prochain "nom(" le plus a gauche
      $p = find_appel($cour, 0)
      si ($p < 0) { $tour = 256 }
      sinon {
        # lire l'identifiant
        $fin_id = $p
        $debut_id = $p
        tant_que ($debut_id > 0) {
          $cp = sous_chaine($cour, $debut_id - 1, $debut_id)
          si (($cp >= "a" et $cp <= "z") ou ($cp >= "A" et $cp <= "Z") ou ($cp >= "0" et $cp <= "9") ou $cp == "_") {
            $debut_id = $debut_id - 1
          } sinon {
            $debut_id = 0
          }
        }
        $nom_f = sous_chaine($cour, $debut_id, $fin_id)
        # est-ce une fn connue ?
        $fi = 1
        $trouve = 0
        tant_que ($fi <= $nb_fn) {
          si ($fn_noms[$fi] == $nom_f) { $trouve = $fi }
          $fi = $fi + 1
        }
        si ($trouve == 0) { $tour = 256 }
        sinon {
          $pos_f = lire_args_appel2($cour, $p)
          $nb_a2 = $lia_n
          $lst_a2 = $lia_out
          # lire les params de la fn : extraire chaque "$nom".
          $pr = $fn_params[$trouve]
          $pn = ["#"]
          $pn_n = 0
          $ip = 0
          $lpr = longueur($pr)
          tant_que ($ip < $lpr) {
            $ch = sous_chaine($pr, $ip, $ip + 1)
            si ($ch == "$") {
              $nom_w = "$"
              $ip = $ip + 1
              $fin_w = 0
              tant_que ($ip < $lpr et $fin_w == 0) {
                $ch2 = sous_chaine($pr, $ip, $ip + 1)
                si (($ch2 >= "a" et $ch2 <= "z") ou ($ch2 >= "A" et $ch2 <= "Z") ou ($ch2 >= "0" et $ch2 <= "9") ou $ch2 == "_") {
                  $nom_w = $nom_w + $ch2
                  $ip = $ip + 1
                } sinon {
                  $fin_w = 1
                }
              }
              joindre($pn, $nom_w)
              $pn_n = $pn_n + 1
            } sinon {
              $ip = $ip + 1
            }
          }
          $nb_p = $pn_n
          $sub = $fn_retours[$trouve]
          $pj = 1
          tant_que ($pj <= $nb_p et $pj <= $nb_a2) {
            $pn_j = $pn[$pj]
            $la_j = $lst_a2[$pj]
            # plier l'argument recursivement (si possible), pour que la
            # substitution soit litterale.
            $la_pliee = $la_j
            si (longueur($la_j) > 0) {
              $pl = plier_expression($la_j)
              si (longueur($pl) > 0) { $la_pliee = $pl } sinon {
                $ev_a = eval_expr($la_j)
                si (longueur($ev_a) > 0) { $la_pliee = $ev_a }
              }
            }
            $sub = substituer_nom($sub, $pn_j, $la_pliee)
            $pj = $pj + 1
          }
          # Resoudre les si du corps de fonction pour obtenir l'expression de
          # retour nue (gere le cas recursif avec cas de base dans un si).
          $sub = resoudre_corps($sub)
          $av = sous_chaine($cour, 0, $debut_id)
          $lgc = longueur($cour)
          $di = $pos_f + 1
          $ap = ""
          si ($di <= $lgc) { $ap = sous_chaine($cour, $di, $lgc) }
          $cour = $av + $sub + $ap
        }
      }
    }
  }
  retour $cour
}

fn emettre_elf_print($sortie: chaine, $texte: chaine, $code_sortie: chaine, $expr_texte: chaine, $cible: chaine) -> entier {
  $out = ""
  $ELFMAG = "ELF"
  $ELFCLASS64 = 2
  $ELFDATA2LSB = 1
  $EV_CURRENT = 1
  $ELFOSABI_SYSV = 0
  $ET_EXEC = 2
  $EM_AARCH64 = 183
  $PT_LOAD = 1
  $PF_R = 4
  $PF_W = 2
  $PF_X = 1
  $BASE_ADDR = 4194304
  $TEXT_OFFSET = 4096
  $TEXT_ADDR = 4198400

  # Détecter une opération « n1 + n2 » ou « n1 - n2 » dans l'expression texte
  # (n1 et n2 peuvent être des nombres littéraux ou des noms de variables
  # connues dans $var_noms/$var_vals) pour générer du code machine qui calcule
  # à l'exécution.
  $est_op = 0
  $op_n1 = 0
  $op_n2 = 0
  $op_sym = ""
  $oe = longueur($expr_texte)
  $op_idx = 0
  # sauter les espaces
  tant_que ($op_idx < $oe et sous_chaine($expr_texte, $op_idx, $op_idx + 1) == " ") {
    $op_idx = $op_idx + 1
  }
  $op_a1 = ""
  $op_fin1 = 0
  tant_que ($op_idx < $oe et $op_fin1 == 0) {
    $oc = sous_chaine($expr_texte, $op_idx, $op_idx + 1)
    si (($oc >= "0" et $oc <= "9") ou ($oc >= "a" et $oc <= "z") ou ($oc >= "A" et $oc <= "Z") ou $oc == "_") {
      $op_a1 = $op_a1 + $oc
      $op_idx = $op_idx + 1
    } sinon {
      $op_fin1 = 1
    }
  }
  si (longueur($op_a1) > 0) {
    # op_a1 est un nombre littéral ou un nom de variable
    $op_n1 = 0
    $op_n1_est_var = 0
    $op_n1_val_trouve = 0
    si (sous_chaine($op_a1, 0, 1) >= "0" et sous_chaine($op_a1, 0, 1) <= "9") {
      $op_n1 = entier($op_a1)
      $op_n1_est_var = 0
      $op_n1_val_trouve = 1
    } sinon {
      # chercher dans les variables connues
      $vn = 1
      tant_que ($vn <= $nb_vars) {
        si ($var_noms[$vn] == $op_a1) {
          $op_n1 = entier($var_vals[$vn])
          $op_n1_est_var = 1
          $op_n1_val_trouve = 1
          $vn = $nb_vars + 1
        } sinon {
          $vn = $vn + 1
        }
      }
    }
    si ($op_n1_val_trouve == 1) {
      # sauter les espaces
      tant_que ($op_idx < $oe et sous_chaine($expr_texte, $op_idx, $op_idx + 1) == " ") {
        $op_idx = $op_idx + 1
      }
      $op_sym = sous_chaine($expr_texte, $op_idx, $op_idx + 1)
      si ($op_sym == "+" ou $op_sym == "-") {
        $op_idx = $op_idx + 1
        # sauter les espaces
        tant_que ($op_idx < $oe et sous_chaine($expr_texte, $op_idx, $op_idx + 1) == " ") {
          $op_idx = $op_idx + 1
        }
        $op_a2 = ""
        $op_fin2 = 0
        tant_que ($op_idx < $oe et $op_fin2 == 0) {
          $oc = sous_chaine($expr_texte, $op_idx, $op_idx + 1)
          si (($oc >= "0" et $oc <= "9") ou ($oc >= "a" et $oc <= "z") ou ($oc >= "A" et $oc <= "Z") ou $oc == "_") {
            $op_a2 = $op_a2 + $oc
            $op_idx = $op_idx + 1
          } sinon {
            $op_fin2 = 1
          }
        }
        si (longueur($op_a2) > 0) {
          $op_n2 = 0
          $op_n2_est_var = 0
          $op_n2_val_trouve = 0
          si (sous_chaine($op_a2, 0, 1) >= "0" et sous_chaine($op_a2, 0, 1) <= "9") {
            $op_n2 = entier($op_a2)
            $op_n2_est_var = 0
            $op_n2_val_trouve = 1
          } sinon {
            # chercher dans les variables connues
            $vn = 1
            tant_que ($vn <= $nb_vars) {
              si ($var_noms[$vn] == $op_a2) {
                $op_n2 = entier($var_vals[$vn])
                $op_n2_est_var = 1
                $op_n2_val_trouve = 1
                $vn = $nb_vars + 1
              } sinon {
                $vn = $vn + 1
              }
            }
          }
          si ($op_n2_val_trouve == 1) {
            # vérifier qu'il n'y a que des espaces jusqu'à la fin
            $op_fin_ok = 1
            $op_idx2 = $op_idx
            tant_que ($op_idx2 < $oe) {
              $oc2 = sous_chaine($expr_texte, $op_idx2, $op_idx2 + 1)
              si ($oc2 != " ") {
                $op_fin_ok = 0
                $op_idx2 = $oe
              } sinon {
                $op_idx2 = $op_idx2 + 1
              }
            }
            si ($op_fin_ok == 1) {
              $est_op = 1
            }
          }
        }
      }
    }
  }

  # ── Nombre de mots du bloc texte (pour l'offset adr) ──
  $nb_mots = 8
  si ($est_op == 1 et $op_n2 <= 4095) {
    $nb_mots = 9
  }
  $adr_bytes = ($nb_mots - 1) * 4
  $adr_immlo = $adr_bytes % 4
  $adr_immhi = partie_entiere($adr_bytes / 4)
  $adr_op = 268435456 + ($adr_immlo * 536870912) + ($adr_immhi * 32) + 1

  # ═══════════════════════════════════════════════════════════════════
  # Cible x86_64 (ELF64, little-endian) — voie native sans rustc.
  # ═══════════════════════════════════════════════════════════════════
  si ($cible == "x86_64") {
    # --- code_sortie -> entier $code (miroir de la voie aarch64) ---
    $code = 0
    $est_code = 1
    $kc = 0
    $lg_cs = longueur($code_sortie)
    tant_que ($kc < $lg_cs) {
      $cc = sous_chaine($code_sortie, $kc, $kc + 1)
      si (($cc >= "0" et $cc <= "9")) {
        $code = $code * 10 + entier($cc)
        $kc = $kc + 1
      } sinon {
        $est_code = 0
        $kc = $lg_cs
      }
    }
    si ($est_code == 0 ou $lg_cs == 0) { $code = 0 }
    si ($code > 255) { $code = 0 }

    # --- padding texte a 8 pour aligner les variables u64 ---
    $nb_pad8 = longueur($texte) % 8
    si ($nb_pad8 == 1) { $nb_pad8 = 7 }
    si ($nb_pad8 == 2) { $nb_pad8 = 6 }
    si ($nb_pad8 == 3) { $nb_pad8 = 5 }
    si ($nb_pad8 == 4) { $nb_pad8 = 4 }
    si ($nb_pad8 == 5) { $nb_pad8 = 3 }
    si ($nb_pad8 == 6) { $nb_pad8 = 2 }
    si ($nb_pad8 == 7) { $nb_pad8 = 1 }
    si ($nb_pad8 == 0) { $nb_pad8 = 0 }
    si ($nb_vars == 0) { $nb_pad8 = 0 }

    # --- nombre d'octets de code ---
    $nb_code = 49
    si ($est_op == 1 et $op_n2 <= 4095) {
      $nb_code = 58
    }
    $data_addr = 4198400 + $nb_code
    $lg_txt = longueur($texte)
    $fsz = $nb_code + $lg_txt + $nb_pad8 + 8 * $nb_vars

    # --- ELF header (x86_64) ---
    $out = $out + $ELFMAG
    $out = $out + caractere(2)
    $out = $out + caractere(1)
    $out = $out + caractere(1)
    $out = $out + caractere(0)
    $i = 0
    tant_que ($i < 8) { $out = $out + caractere(0); $i = $i + 1 }
    $out = $out + u16le(2)
    $out = $out + u16le(62)
    $out = $out + u32le(1)
    $out = $out + u64le(4198400)
    $out = $out + u64le(64)
    $out = $out + u64le(0)
    $out = $out + u32le(0)
    $out = $out + u16le(64)
    $out = $out + u16le(56)
    $out = $out + u16le(1)
    $out = $out + u16le(64)
    $out = $out + u16le(0)
    $out = $out + u16le(0)

    # --- program header ---
    $out = $out + u32le(1)
    $out = $out + u32le(5)
    $out = $out + u64le(4096)
    $out = $out + u64le(4198400)
    $out = $out + u64le(4198400)
    $out = $out + u64le($fsz)
    $out = $out + u64le($fsz)
    $out = $out + u64le(4096)

    # --- padding to 4096 ---
    $pad = 4096 - longueur($out)
    $i = 0
    tant_que ($i < $pad) { $out = $out + caractere(0); $i = $i + 1 }

    # --- code : write(text) ---
    # mov rax, 1
    $out = $out + caractere(72) + caractere(199) + caractere(192) + caractere(1) + caractere(0) + caractere(0) + caractere(0)
    # mov rdi, 1
    $out = $out + caractere(72) + caractere(199) + caractere(199) + caractere(1) + caractere(0) + caractere(0) + caractere(0)
    # mov rsi, data_addr
    $out = $out + caractere(72) + caractere(190)
    $out = $out + u64le($data_addr)
    # mov rdx, len_texte
    $out = $out + caractere(72) + caractere(199) + caractere(194)
    $out = $out + u32le($lg_txt)
    # syscall
    $out = $out + caractere(15) + caractere(5)

    # --- code : compute exit code ---
    si ($est_op == 1 et $op_n2 <= 4095) {
      # mov rax, n1
      $out = $out + caractere(72) + caractere(199) + caractere(192)
      $out = $out + u32le($op_n1)
      # add/sub rax, n2
      si ($op_sym == "+") {
        $out = $out + caractere(72) + caractere(5)
        $out = $out + u32le($op_n2)
      } sinon {
        $out = $out + caractere(72) + caractere(45)
        $out = $out + u32le($op_n2)
      }
      # mov rdi, rax
      $out = $out + caractere(72) + caractere(135) + caractere(199)
    } sinon {
      # mov rdi, code
      $out = $out + caractere(72) + caractere(199) + caractere(199)
      $out = $out + u32le($code)
    }
    # mov rax, 60
    $out = $out + caractere(72) + caractere(199) + caractere(192)
    $out = $out + u32le(60)
    # syscall
    $out = $out + caractere(15) + caractere(5)

    # --- data : texte + padding + vars u64 ---
    $out = $out + $texte
    $ip = 0
    tant_que ($ip < $nb_pad8) {
      $out = $out + caractere(0)
      $ip = $ip + 1
    }
    $vi = 1
    tant_que ($vi <= $nb_vars) {
      $vv = $var_vals[$vi]
      $vvnum = 1
      $ivv = 0
      $lvv = longueur($vv)
      si ($lvv == 0) { $vvnum = 0 }
      si ($lvv > 0 et sous_chaine($vv, 0, 1) == "-") { $ivv = 1 }
      $kv = $ivv
      tant_que ($kv < $lvv et $vvnum == 1) {
        $cv = sous_chaine($vv, $kv, $kv + 1)
        si ($cv < "0" ou $cv > "9") {
          $vvnum = 0
          $kv = $lvv
        } sinon {
          $kv = $kv + 1
        }
      }
      si ($vvnum == 0) { $vv = "0" }
      $out = $out + u64le(entier($vv))
      $vi = $vi + 1
    }

    # --- ecrire ---
    $iq = longueur($out)
    tant_que ($iq < 4096 + $fsz) {
      $out = $out + caractere(0)
      $iq = $iq + 1
    }
    ecrire_bytes($sortie, $out)
    >> "rose: " + $sortie + " produit (binaire ELF x86_64, " + chaine(longueur($out)) + " octets)"
    retour 0
  }

  # ── ELF header (64 octets) ──
  $out = $out + $ELFMAG                                    # e_ident[0..3]
  $out = $out + caractere($ELFCLASS64)     # e_ident[4] = ELFCLASS64
  $out = $out + caractere($ELFDATA2LSB)    # e_ident[5] = ELFDATA2LSB
  $out = $out + caractere($EV_CURRENT)     # e_ident[6] = EV_CURRENT
  $out = $out + caractere($ELFOSABI_SYSV)  # e_ident[7] = ELFOSABI_SYSV
  $out = $out + caractere(0)               # e_ident[8] = 0
  $out = $out + caractere(0)               # e_ident[9] = 0
  $out = $out + caractere(0)               # e_ident[10] = 0
  $out = $out + caractere(0)               # e_ident[11] = 0
  $out = $out + caractere(0)               # e_ident[12] = 0
  $out = $out + caractere(0)               # e_ident[13] = 0
  $out = $out + caractere(0)               # e_ident[14] = 0
  $out = $out + caractere(0)               # e_ident[15] = 0
  $out = $out + u16le($ET_EXEC)                            # e_type = ET_EXEC
  $out = $out + u16le($EM_AARCH64)                         # e_machine = EM_AARCH64
  $out = $out + u32le(1)                                   # e_version = 1
  $out = $out + u64le($TEXT_ADDR)                          # e_entry = adresse de _start
  $out = $out + u64le(64)                                  # e_phoff = 64 (juste après l'en-tête)
  $out = $out + u64le(0)                                   # e_shoff = 0 (pas de section header pour l'instant)
  $out = $out + u32le(0)                                   # e_flags = 0
  $out = $out + u16le(64)                                  # e_ehsize = 64
  $out = $out + u16le(56)                                  # e_phentsize = 56
  $out = $out + u16le(1)                                   # e_phnum = 1 (un segment)
  $out = $out + u16le(64)                                  # e_shentsize = 64
  $out = $out + u16le(0)                                   # e_shnum = 0
  $out = $out + u16le(0)                                   # e_shstrndx = 0

  # ── Program header (1 segment PT_LOAD, 56 octets) ──
  $out = $out + u32le($PT_LOAD)                            # p_type = PT_LOAD
  $out = $out + u32le(5)                                   # p_flags = R|X
  $out = $out + u64le($TEXT_OFFSET)                        # p_offset = 4096
  $out = $out + u64le($TEXT_ADDR)                          # p_vaddr
  $out = $out + u64le($TEXT_ADDR)                          # p_paddr
  $nb_pad8 = longueur($texte) % 8
  si ($nb_pad8 == 1) { $nb_pad8 = 7 }
  si ($nb_pad8 == 2) { $nb_pad8 = 6 }
  si ($nb_pad8 == 3) { $nb_pad8 = 5 }
  si ($nb_pad8 == 4) { $nb_pad8 = 4 }
  si ($nb_pad8 == 5) { $nb_pad8 = 3 }
  si ($nb_pad8 == 6) { $nb_pad8 = 2 }
  si ($nb_pad8 == 7) { $nb_pad8 = 1 }
  si ($nb_pad8 == 0) { $nb_pad8 = 0 }
  $fsz = 4 * $nb_mots + longueur($texte) + $nb_pad8 + 8 * $nb_vars   # p_filesz
  $out = $out + u64le($fsz)                                # p_filesz
  $out = $out + u64le($fsz)                                # p_memsz
  $out = $out + u64le($fsz)                                # p_filesz
  $out = $out + u64le($fsz)                                # p_memsz
  $out = $out + u64le(2097152)                             # p_align

  # ── Padding jusqu'a 4096 (0x1000) ──
  $pad = 4096 - longueur($out)
  $i = 0
  tant_que ($i < $pad) {
    $out = $out + caractere(0)
    $i = $i + 1
  }

  # ── Code machine aarch64 : affiche le texte et sort avec $code_sortie ──
  $code = 0
  $est_code = 1
  $kc = 0
  tant_que ($kc < longueur($code_sortie)) {
    $cc = sous_chaine($code_sortie, $kc, $kc + 1)
    si (($cc >= "0" et $cc <= "9")) {
      $code = $code * 10 + entier($cc)
      $kc = $kc + 1
    } sinon {
      $est_code = 0
      $kc = longueur($code_sortie)
    }
  }
  si ($est_code == 0 ou longueur($code_sortie) == 0) {
    $code = 0
  } sinon si ($code > 255) {
    $code = 0
  }

  $out = $out + u32le(3531604000)   # mov x0, #1 (stdout)
  $out = $out + u32le($adr_op)      # adr x1, data
  $len_texte = longueur($texte)
  $opcode_x2 = 3531603968 + $len_texte * 32 + 2
  $out = $out + u32le($opcode_x2)   # mov x2, #len (len)
  $out = $out + u32le(3531606024)   # mov x8, #64 (write)
  $out = $out + u32le(3556769793)   # svc #0
  si ($est_op == 1 et $op_n2 <= 4095) {
    $out = $out + u32le(3531603968 + $op_n1 * 32)   # mov x0, #n1
    si ($op_sym == "+") {
      $out = $out + u32le(2432696320 + $op_n2 * 1024)   # add x0, x0, #n2
    } sinon {
      $out = $out + u32le(3510145024 + $op_n2 * 1024)   # sub x0, x0, #n2
    }
  } sinon {
    $out = $out + u32le(3531603968 + $code * 32)   # mov x0, #$code (exit code)
  }
  $out = $out + u32le(3531606952)   # mov x8, #93 (exit)
  $out = $out + u32le(3556769793)   # svc #0
  # Data : variables + texte
  $out = $out + $texte
  si ($nb_vars > 0) {
    $vi = 1
    tant_que ($vi <= $nb_vars) {
      $vv = $var_vals[$vi]
      $vvnum = 1
      $ivv = 0
      $lvv = longueur($vv)
      si ($lvv == 0) { $vvnum = 0 }
      si ($lvv > 0 et sous_chaine($vv, 0, 1) == "-") { $ivv = 1 }
      $kv = $ivv
      tant_que ($kv < $lvv et $vvnum == 1) {
        $cv = sous_chaine($vv, $kv, $kv + 1)
        si ($cv < "0" ou $cv > "9") {
          $vvnum = 0
          $kv = $lvv
        } sinon {
          $kv = $kv + 1
        }
      }
      si ($vvnum == 0) { $vv = "0" }
      $out = $out + u64le(entier($vv))
      $vi = $vi + 1
    }
  }
  # ── Écrire le fichier ──
  # completer a 4096 + fsz octets
  $iq = longueur($out)
  tant_que ($iq < 4096 + $fsz) {
    $out = $out + caractere(0)
    $iq = $iq + 1
  }
  ecrire_bytes($sortie, $out)
  >> "rose: " + $sortie + " produit (binaire ELF autonome, " + chaine(longueur($out)) + " octets)"
  retour 0
}

# ── Point d'entrée ──
$chemin = argument(0)
$sortie = argument(1)
si (longueur($sortie) == 0) {
  $sortie = "prog"
}
$src = lire_texte($chemin)
si (longueur($src) == 0) {
  afficher_erreur("emetteur_elf : fichier vide ou introuvable : " + $chemin)
  quitter(1)
}
# Fonctions : extraire les blocs "fn nom(params) -> type { ... }" et les
# retirer du source. On conserve leur nom, leurs params et l'expr de retour.
$fn_noms = [""]
$fn_params = [""]
$fn_retours = [""]
$nb_fn = 0
# Extraction iterative
$modif_fn = 1
tant_que ($modif_fn == 1) {
  $modif_fn = 0
  # chercher "fn "
  $pos_fn = -1
  $i = 0
  tant_que ($i + 3 <= longueur($src)) {
    si (sous_chaine($src, $i, $i + 3) == "fn ") {
      $pos_fn = $i
      $i = longueur($src)
    } sinon {
      $i = $i + 1
    }
  }
  si ($pos_fn >= 0) {
    # lire le nom
    $j = $pos_fn + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") { $j = $j + 1 }
    $nom_fn = ""
    tant_que ($j < longueur($src)) {
      $ch = sous_chaine($src, $j, $j + 1)
      si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
        $nom_fn = $nom_fn + $ch
        $j = $j + 1
      } sinon {
        $j = longueur($src)
      }
    }
    # trouver "("
    $jp = $pos_fn + 3
    tant_que ($jp < longueur($src) et sous_chaine($src, $jp, $jp + 1) != "(") { $jp = $jp + 1 }
    # params jusqu'a ")"
    $params_fn = ""
    $prof = 1
    $jp = $jp + 1
    $debut_p = $jp
    tant_que ($jp < longueur($src) et $prof > 0) {
      $ch = sous_chaine($src, $jp, $jp + 1)
      si ($ch == "(") { $prof = $prof + 1 }
      si ($ch == ")") { $prof = $prof - 1 }
      si ($prof > 0) { $params_fn = $params_fn + $ch }
      $jp = $jp + 1
    }
    # trouver "{" apres ")"
    $ja = $jp
    tant_que ($ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) != "{") { $ja = $ja + 1 }
    # trouver "}" correspondant (profondeur, en ignorant les crochets [ ] )
    $prof = 1
    $ja = $ja + 1
    $debut_b = $ja
    $fin_b = $ja
    $fini_b = 0
    tant_que ($ja < longueur($src) et $fini_b == 0) {
      $ch = sous_chaine($src, $ja, $ja + 1)
      si ($ch == "{") { $prof = $prof + 1 }
      si ($ch == "}") {
        $prof = $prof - 1
        si ($prof == 0) {
          $fin_b = $ja
          $fini_b = 1
        }
      }
      $ja = $ja + 1
    }
    $corps_fn = sous_chaine($src, $debut_b, $fin_b)
    # extraire TOUTES les exprs apres chaque "retour" au NIVEAU 0 du corps.
    # On decoupe $corps_fn en « instructions » separees par "\n" au niveau 0,
    # puis, pour chaque instruction dont le premier mot est « retour », on
    # retient l'expression (le reste de la ligne,trimmee). Les « retour » a
    # l'interieur de blocs { ... } ne sont PAS consideres (ils appartiennent
    # au sous-bloc). On retient la DERNIERE expression « retour » de niveau 0.
    $ret = ""
    $nb_e = 0
    $ligne_buf = ""
    $prof_l = 0
    $kr = 0
    tant_que ($kr <= longueur($corps_fn)) {
      $en_ligne = 0
      si ($kr < longueur($corps_fn)) { $en_ligne = 1 }
      $fin_ligne = 0
      si ($en_ligne == 1) {
        $ch = sous_chaine($corps_fn, $kr, $kr + 1)
        si ($ch == "\n") { $fin_ligne = 1 }
      } sinon {
        $fin_ligne = 1
      }
      si ($fin_ligne == 1) {
        # traiter $ligne_buf comme une instruction
        # trim leading
        $ln = longueur($ligne_buf)
        tant_que ($ln > 0 et sous_chaine($ligne_buf, 0, 1) == " ") { $ligne_buf = sous_chaine($ligne_buf, 1, $ln); $ln = longueur($ligne_buf) }
        tant_que ($ln > 0 et sous_chaine($ligne_buf, $ln - 1, $ln) == " ") { $ligne_buf = sous_chaine($ligne_buf, 0, $ln - 1); $ln = longueur($ligne_buf) }
        tant_que ($ln > 0 et sous_chaine($ligne_buf, $ln - 1, $ln) == "\r") { $ligne_buf = sous_chaine($ligne_buf, 0, $ln - 1); $ln = longueur($ligne_buf) }
        si ($prof_l == 0 et $ln >= 6) {
          si (sous_chaine($ligne_buf, 0, 6) == "retour") {
            # le 7e caractere doit etre espace ou fin ; et on accepte « retour ... »
            $suiv_est_ok = 0
            si ($ln == 6) { $suiv_est_ok = 1 }
            sinon {
              $c7 = sous_chaine($ligne_buf, 6, 7)
              si ($c7 == " " ou $c7 == "\t") { $suiv_est_ok = 1 }
            }
            si ($suiv_est_ok == 1) {
              # extraire l'expression apres "retour "
              $expr_e = sous_chaine($ligne_buf, 6, $ln)
              # trim
              $le = longueur($expr_e)
              tant_que ($le > 0 et sous_chaine($expr_e, 0, 1) == " ") { $expr_e = sous_chaine($expr_e, 1, $le); $le = longueur($expr_e) }
              tant_que ($le > 0 et sous_chaine($expr_e, $le - 1, $le) == " ") { $expr_e = sous_chaine($expr_e, 0, $le - 1); $le = longueur($expr_e) }
              si ($le > 0) { $ret = $expr_e }
            }
          }
        }
        # mettre a jour la profondeur avec les {} de cette ligne
        $kp = 0
        tant_que ($kp < $ln) {
          $cphp = sous_chaine($ligne_buf, $kp, $kp + 1)
          si ($cphp == "{") { $prof_l = $prof_l + 1 }
          si ($cphp == "}") { $prof_l = $prof_l - 1 }
          $kp = $kp + 1
        }
        $ligne_buf = ""
      } sinon {
        $ligne_buf = $ligne_buf + $ch
      }
      $kr = $kr + 1
    }
    # trim leading spaces
    $nbret = longueur($ret)
    tant_que ($nbret > 0 et sous_chaine($ret, 0, 1) == " ") {
      $ret = sous_chaine($ret, 1, $nbret)
      $nbret = longueur($ret)
    }
    # trim trailing spaces/newlines
    $nbret = longueur($ret)
    tant_que ($nbret > 0 et (sous_chaine($ret, $nbret - 1, $nbret) == " " ou sous_chaine($ret, $nbret - 1, $nbret) == "\n" ou sous_chaine($ret, $nbret - 1, $nbret) == "\t")) {
      $ret = sous_chaine($ret, 0, $nbret - 1)
      $nbret = longueur($ret)
    }
    # stocker : si $ret est entierement numerique, on le plie une premiere fois
    si (longueur($ret) > 0) {
      $tnum = 1
      $qn0 = 0
      tant_que ($qn0 < longueur($ret)) {
        $cn0 = sous_chaine($ret, $qn0, $qn0 + 1)
        si (($cn0 >= "a" et $cn0 <= "z") ou ($cn0 >= "A" et $cn0 <= "Z")) {
          $tnum = 0
          $qn0 = longueur($ret)
        }
        $qn0 = $qn0 + 1
      }
      si ($tnum == 1) {
        $plie = eval_expr($ret)
        si (longueur($plie) > 0) { $ret = $plie }
      }
    }
    # stocker le CORPS COMPLET (y compris les si) pour le repli des appels.
    # On trim les espaces/newlines autour du corps.
    $corps_b = $corps_fn
    $lnb = longueur($corps_b)
    tant_que ($lnb > 0 et sous_chaine($corps_b, 0, 1) == " ") { $corps_b = sous_chaine($corps_b, 1, $lnb); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, $lnb - 1, $lnb) == " ") { $corps_b = sous_chaine($corps_b, 0, $lnb - 1); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, 0, 1) == "\n") { $corps_b = sous_chaine($corps_b, 1, $lnb); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, $lnb - 1, $lnb) == "\n") { $corps_b = sous_chaine($corps_b, 0, $lnb - 1); $lnb = longueur($corps_b) }
    joindre($fn_noms, $nom_fn)
    joindre($fn_params, $params_fn)
    joindre($fn_retours, $corps_b)
    $nb_fn = $nb_fn + 1
    # retirer le bloc fn du src (de pos_fn jusqu'a la "}" fermante +1)
    $avant_fn = sous_chaine($src, 0, $pos_fn)
    $apres_fn = sous_chaine($src, $ja, longueur($src))
    $src = $avant_fn + $apres_fn
    $modif_fn = 1
  }
}

# Inlining des appels de fonction dans les lignes ">> name(...)"
$modif_inl = 1
tant_que ($modif_inl == 1) {
  $modif_inl = 0
  $i = 0
  tant_que ($i < longueur($src)) {
    # trouver ">> "
    $pos = -1
    $k = $i
    tant_que ($k + 3 <= longueur($src)) {
      si (sous_chaine($src, $k, $k + 3) == ">> ") {
        $pos = $k
        $k = longueur($src)
      } sinon {
        $k = $k + 1
      }
    }
    si ($pos < 0) {
      $i = longueur($src)
    } sinon {
      # avancer les espaces
      $ja = $pos + 3
      tant_que ($ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) == " ") { $ja = $ja + 1 }
      # lire le nom de fonction
      $nom_appel = ""
      $ja0 = $ja
      $done_ja = 0
      tant_que ($ja < longueur($src) et $done_ja == 0) {
        $ch = sous_chaine($src, $ja, $ja + 1)
        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
          $nom_appel = $nom_appel + $ch
          $ja = $ja + 1
        } sinon {
          $done_ja = 1
        }
      }
      # verifier que c'est une fonction connue et suivi de "("
      $est_fn = 0
      $idx_fn = 0
      $fi = 1
      tant_que ($fi <= $nb_fn) {
        si ($fn_noms[$fi] == $nom_appel) {
          $est_fn = 1
          $idx_fn = $fi
        }
        $fi = $fi + 1
      }
      si ($est_fn == 1 et $ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) == "(") {
        # extraire les args jusqu'a ")"
        $ja = $ja + 1
        $args_str = ""
        $prof = 1
        tant_que ($ja < longueur($src) et $prof > 0) {
          $ch = sous_chaine($src, $ja, $ja + 1)
          si ($ch == "(") { $prof = $prof + 1 }
          si ($ch == ")") { $prof = $prof - 1 }
          si ($prof > 0) { $args_str = $args_str + $ch }
          $ja = $ja + 1
        }
        # fin de ligne
        $fin_ligne = $ja
        tant_que ($fin_ligne < longueur($src) et sous_chaine($src, $fin_ligne, $fin_ligne + 1) != "\n") {
          $fin_ligne = $fin_ligne + 1
        }
        # substituer les params dans le retour
        $ret = $fn_retours[$idx_fn]
        $params = $fn_params[$idx_fn]
        # decouper params par virgule (niveau 0)
        $pi = 0
        # on utilise une liste manuelle : on stocke dans des vars temporaires via joindre
        $param_noms = [""]
        $param_vals = [""]
        $nb_p = 0
        # parse params
        $pp = 0
        $ppn = ""
        $curp = ""
        $depth = 0
        $tok = ""
        # params format: "$a: entier, $b: entier"
        # extraire les noms ($xxx) avant ':'
        $iip = 0
        $lp = longueur($params)
        $cur_nom = ""
        $in_nom = 0
        tant_que ($iip < $lp) {
          $ch = sous_chaine($params, $iip, $iip + 1)
          si ($ch == "$") {
            $cur_nom = "$"
            $iip = $iip + 1
          } sinon si ($cur_nom != "" et (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_")) {
            $cur_nom = $cur_nom + $ch
            $iip = $iip + 1
          } sinon {
            si (longueur($cur_nom) > 1) {
              joindre($param_noms, $cur_nom)
              $nb_p = $nb_p + 1
            }
            $cur_nom = ""
            $iip = $iip + 1
          }
        }
        si (longueur($cur_nom) > 1) {
          joindre($param_noms, $cur_nom)
          $nb_p = $nb_p + 1
        }
        # decouper args par virgule top-level
        $arg_list = [""]
        $nb_a = 0
        $cur_arg = ""
        $depth = 0
        $ka = 0
        $la = longueur($args_str)
        tant_que ($ka < $la) {
          $ch = sous_chaine($args_str, $ka, $ka + 1)
          si ($ch == "(" ou $ch == "[" ou $ch == "{") { $depth = $depth + 1 }
          si ($ch == ")" ou $ch == "]" ou $ch == "}") { $depth = $depth - 1 }
          si ($ch == "," et $depth == 0) {
            # trim
            $ca = $cur_arg
            $nbca = longueur($ca)
            tant_que ($nbca > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, longueur($ca)); $nbca = longueur($ca) }
            $nbca = longueur($ca)
            tant_que ($nbca > 0 et sous_chaine($ca, $nbca - 1, $nbca) == " ") { $ca = sous_chaine($ca, 0, $nbca - 1); $nbca = longueur($ca) }
            joindre($arg_list, $ca)
            $nb_a = $nb_a + 1
            $cur_arg = ""
          } sinon {
            $cur_arg = $cur_arg + $ch
          }
          $ka = $ka + 1
        }
        $ca = $cur_arg
        $nbca = longueur($ca)
        tant_que ($nbca > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, longueur($ca)); $nbca = longueur($ca) }
        $nbca = longueur($ca)
        tant_que ($nbca > 0 et sous_chaine($ca, $nbca - 1, $nbca) == " ") { $ca = sous_chaine($ca, 0, $nbca - 1); $nbca = longueur($ca) }
        si (longueur($ca) > 0) {
          joindre($arg_list, $ca)
          $nb_a = $nb_a + 1
        }
        # substituer params -> args dans ret, puis replier les appels
        # recursifs/nommes internes jusqu'a stabilisation
        # Substituer les params par les args dans le "retour".
        $ret_inl = $ret
        $pi = 1
        tant_que ($pi <= $nb_p et $pi <= $nb_a) {
          $ret_inl = substituer_nom($ret_inl, $param_noms[$pi], $arg_list[$pi])
          $pi = $pi + 1
        }
        # Resoudre les si du corps pour obtenir l'expression de retour nue.
        $ret_inl = resoudre_corps($ret_inl)
        # Si l'expression resultant n'a plus de lettre (entierement numerique),
        # on la plie via eval_expr.
        $tout_num_inl = 1
        $qn_inl = 0
        tant_que ($qn_inl < longueur($ret_inl)) {
          $cn_inl = sous_chaine($ret_inl, $qn_inl, $qn_inl + 1)
          si (($cn_inl >= "a" et $cn_inl <= "z") ou ($cn_inl >= "A" et $cn_inl <= "Z")) {
            $tout_num_inl = 0
          }
          $qn_inl = $qn_inl + 1
        }
        si ($tout_num_inl == 1 et longueur($ret_inl) > 0) {
          $r_inl = eval_expr($ret_inl)
          si (longueur($r_inl) > 0) { $ret_inl = $r_inl }
        }
        $tour_inl = 0
        $encore = 1
        tant_que ($encore == 1 et $tour_inl < 64) {
          $encore = 0
          $fi2 = 1
          tant_que ($fi2 <= $nb_fn) {
            $nm = $fn_noms[$fi2]
            $lm = longueur($nm)
            $kk = 0
            $trouve_i = 0
            $dp0 = 0
            $nb_esp0 = 0
            tant_que ($kk + $lm <= longueur($ret_inl) et $trouve_i == 0) {
              si (sous_chaine($ret_inl, $kk, $kk + $lm) == $nm) {
                $ap = $kk + $lm
                $nb_esp0 = 0
                tant_que ($ap < longueur($ret_inl) et sous_chaine($ret_inl, $ap, $ap + 1) == " ") { $ap = $ap + 1; $nb_esp0 = $nb_esp0 + 1 }
                si ($ap < longueur($ret_inl) et sous_chaine($ret_inl, $ap, $ap + 1) == "(") {
                  $trouve_i = 1
                  $dp0 = $ap + 1
                }
              }
              si ($trouve_i == 0) { $kk = $kk + 1 }
            }
            si ($trouve_i == 1) {
              # extraire les args de cet appel
              $dp = $dp0
              $prof_d = 1
              $cur_d = ""
              $nb_d = 0
              $lst_d = [""]
              $fini_d = 0
              $dp_fin = $dp
              tant_que ($dp < longueur($ret_inl) et $fini_d == 0) {
                $chd = sous_chaine($ret_inl, $dp, $dp + 1)
                si ($chd == "(" ou $chd == "[" ou $chd == "{") {
                  $prof_d = $prof_d + 1
                  $cur_d = $cur_d + $chd
                } sinon si ($chd == ")" ou $chd == "]" ou $chd == "}") {
                  $prof_d = $prof_d - 1
                  si ($prof_d == 0) {
                    $fini_d = 1
                    $dp_fin = $dp
                  } sinon {
                    $cur_d = $cur_d + $chd
                  }
                } sinon si ($chd == "," et $prof_d == 1) {
                  $cd = $cur_d
                  $nbcd = longueur($cd)
                  tant_que ($nbcd > 0 et sous_chaine($cd, 0, 1) == " ") { $cd = sous_chaine($cd, 1, longueur($cd)); $nbcd = longueur($cd) }
                  $nbcd = longueur($cd)
                  tant_que ($nbcd > 0 et sous_chaine($cd, $nbcd - 1, $nbcd) == " ") { $cd = sous_chaine($cd, 0, $nbcd - 1); $nbcd = longueur($cd) }
                  joindre($lst_d, $cd)
                  $nb_d = $nb_d + 1
                  $cur_d = ""
                } sinon {
                  $cur_d = $cur_d + $chd
                }
                $dp = $dp + 1
              }
              $cd = $cur_d
              $nbcd = longueur($cd)
              tant_que ($nbcd > 0 et sous_chaine($cd, 0, 1) == " ") { $cd = sous_chaine($cd, 1, longueur($cd)); $nbcd = longueur($cd) }
              $nbcd = longueur($cd)
              tant_que ($nbcd > 0 et sous_chaine($cd, $nbcd - 1, $nbcd) == " ") { $cd = sous_chaine($cd, 0, $nbcd - 1); $nbcd = longueur($cd) }
              si (longueur($cd) > 0) {
                joindre($lst_d, $cd)
                $nb_d = $nb_d + 1
              }
              # lire les params du fn fi2
              $pr2 = $fn_params[$fi2]
              $pn2 = ["#"]
              $iip2 = 0
              $cur_n2 = ""
              $lp2 = longueur($pr2)
              tant_que ($iip2 < $lp2) {
                $ch2 = sous_chaine($pr2, $iip2, $iip2 + 1)
                si ($ch2 == "$") {
                  $cur_n2 = "$"
                  $iip2 = $iip2 + 1
                } sinon si ($cur_n2 != "" et (($ch2 >= "a" et $ch2 <= "z") ou ($ch2 >= "A" et $ch2 <= "Z") ou ($ch2 >= "0" et $ch2 <= "9") ou $ch2 == "_")) {
                  $cur_n2 = $cur_n2 + $ch2
                  $iip2 = $iip2 + 1
                } sinon {
                  si (longueur($cur_n2) > 1) {
                    joindre($pn2, $cur_n2)
                  }
                  $cur_n2 = ""
                  $iip2 = $iip2 + 1
                }
              }
              si (longueur($cur_n2) > 1) {
                joindre($pn2, $cur_n2)
              }
              $nb_p2 = longueur($pn2) - 1
              # substituer params dans le corps complet de la fonction
              $sub2 = $fn_retours[$fi2]
              $pj2 = 1
              tant_que ($pj2 <= $nb_p2 et $pj2 <= $nb_d) {
                $_la2 = $lst_d[$pj2]
                # plier l'argument recursivement avant substitution (comme
                # plier_expression) pour eviter les problemes de priorite.
                si (longueur($_la2) > 0) {
                  $_pl2 = plier_expression($_la2)
                  si (longueur($_pl2) > 0) { $_la2 = $_pl2 } sinon {
                    $_ev2a = eval_expr($_la2)
                    si (longueur($_ev2a) > 0) { $_la2 = $_ev2a }
                  }
                }
                $sub2 = substituer_nom($sub2, $pn2[$pj2], $_la2)
                $pj2 = $pj2 + 1
              }
              # Resoudre les si pour obtenir l'expression de retour nue.
              $sub2 = resoudre_corps($sub2)
              # Plier recursivement via plier_expression.
              $sub2 = plier_expression($sub2)
              # si $sub2 est entierement numerique, le plier
              $tnum2 = 1
              $qn2 = 0
              tant_que ($qn2 < longueur($sub2)) {
                $cn2 = sous_chaine($sub2, $qn2, $qn2 + 1)
                si (($cn2 >= "a" et $cn2 <= "z") ou ($cn2 >= "A" et $cn2 <= "Z")) {
                  $tnum2 = 0
                  $qn2 = longueur($sub2)
                }
                $qn2 = $qn2 + 1
              }
              si ($tnum2 == 1 et longueur($sub2) > 0) {
                $ev2 = eval_expr($sub2)
                si (longueur($ev2) > 0) { $sub2 = $ev2 }
              }
              # remplacer l'appel par sub2 dans ret_inl
              $avant2 = sous_chaine($ret_inl, 0, $kk)
              $apres2 = sous_chaine($ret_inl, $dp_fin + 1, longueur($ret_inl))
              $ret_inl = $avant2 + $sub2 + $apres2
              $encore = 1
            }
            $fi2 = $fi2 + 1
          }
          $tour_inl = $tour_inl + 1
        }

# remplacer la ligne ">> name(args...)" par ">> ret_inl"
        $avant_l = sous_chaine($src, 0, $pos)
        $apres_l = sous_chaine($src, $fin_ligne, longueur($src))
        $src = $avant_l + ">> " + $ret_inl + $apres_l
        $modif_inl = 1
        $i = $pos
      } sinon {
        $i = $pos + 1
      }
    }
  }
}

# Variables
$var_noms = [""]
$var_vals = [""]
$nb_vars = 0

# Pretraitement 0.5 : collecter les variables (premier passage)
# (deja fait ci-dessous, mais on a besoin des variables pour si)
# On fait d'abord une passe pour collecter les variables
# puis on traite les si, puis on collecte a nouveau

# Pretraitement 0 : collecter les variables (hors corps de tant_que,
# pour que les boucles pilotées par variable partent de valeurs propres)

$i = 0
$tq_prof = 0
$tq_attente = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  $c2 = ""
  $c3 = ""
  $c4 = ""
  $c5 = ""
  $c6 = ""
  $c7 = ""
  $c8 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  si ($i + 3 < longueur($src)) { $c4 = sous_chaine($src, $i + 3, $i + 4) }
  si ($i + 4 < longueur($src)) { $c5 = sous_chaine($src, $i + 4, $i + 5) }
  si ($i + 5 < longueur($src)) { $c6 = sous_chaine($src, $i + 5, $i + 6) }
  si ($i + 6 < longueur($src)) { $c7 = sous_chaine($src, $i + 6, $i + 7) }
  si ($i + 7 < longueur($src)) { $c8 = sous_chaine($src, $i + 7, $i + 8) }
  # Suivre la profondeur d'entree dans un corps de tant_que
  si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
    $tq_attente = 1
  }
  si ($c1 == "{") {
    si ($tq_attente == 1) {
      $tq_attente = 0
      $tq_prof = $tq_prof + 1
    } sinon {
      si ($tq_prof > 0) {
        $tq_prof = $tq_prof + 1
      }
    }
  }
  si ($c1 == "}" et $tq_prof > 0) {
    $tq_prof = $tq_prof - 1
  }
  si ($c1 == "v" et $c2 == "a" et $c3 == "r" et $tq_prof == 0) {
    $j = $i + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    $nom_var = ""
    tant_que ($j < longueur($src)) {
      $ch = sous_chaine($src, $j, $j + 1)
      si ($ch == " " ou $ch == "=") {
        $j = longueur($src) + 1
      } sinon {
        $nom_var = $nom_var + $ch
        $j = $j + 1
      }
    }
    $j = $i + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) != "=") {
      $j = $j + 1
    }
    $j = $j + 1
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    $expr = ""
    $k = $j
    tant_que ($k < longueur($src)) {
      $ch = sous_chaine($src, $k, $k + 1)
      si ($ch == "\n") {
        $k = longueur($src) + 1
      } sinon {
        $expr = $expr + $ch
        $k = $k + 1
      }
    }
    si (longueur($expr) > 0 et longueur($nom_var) > 0) {
      # Construire le contexte de variables (en ARRIERE : la derniere
      # valeur appendee est inseree en premier et gagne les remplacements)
      $ctx = ""
      $vi = 1
      tant_que ($vi <= $nb_vars) {
        $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
        $vi = $vi + 1
      }
      si (longueur($ctx) > 0) {
        $expr_full = $expr + " // vars: " + $ctx
      } sinon {
        $expr_full = $expr
      }
      $resultat = eval_expr($expr_full)
      joindre($var_noms, $nom_var)
      joindre($var_vals, $resultat)
      $nb_vars = $nb_vars + 1
    }
  }
  $i = $i + 1
}

# Pretraitement 0b : collecter les affectations NUES "nom = expr" hors corps de
# tant_que (les "var" sont deja collectes par la passe 0).
$i = 0
$tq_prof = 0
$tq_attente = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  si ($i + 3 < longueur($src)) { $c4 = sous_chaine($src, $i + 3, $i + 4) }
  si ($i + 4 < longueur($src)) { $c5 = sous_chaine($src, $i + 4, $i + 5) }
  si ($i + 5 < longueur($src)) { $c6 = sous_chaine($src, $i + 5, $i + 6) }
  si ($i + 6 < longueur($src)) { $c7 = sous_chaine($src, $i + 6, $i + 7) }
  si ($i + 7 < longueur($src)) { $c8 = sous_chaine($src, $i + 7, $i + 8) }
  si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
    $tq_attente = 1
  }
  si ($c1 == "{") {
    si ($tq_attente == 1) {
      $tq_attente = 0
      $tq_prof = $tq_prof + 1
    } sinon {
      si ($tq_prof > 0) {
        $tq_prof = $tq_prof + 1
      }
    }
  }
  si ($c1 == "}" et $tq_prof > 0) {
    $tq_prof = $tq_prof - 1
  }
  $est_nom = 0
  si ($tq_prof == 0) {
    si (($c1 >= "a" et $c1 <= "z") ou ($c1 >= "A" et $c1 <= "Z") ou $c1 == "_") {
      $est_nom = 1
    }
  }
  si ($est_nom == 1) {
    $nom_nu = ""
    $jn = $i
    $fin_n = 0
    tant_que ($jn < longueur($src) et $fin_n == 0) {
      $ch = sous_chaine($src, $jn, $jn + 1)
      si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
        $nom_nu = $nom_nu + $ch
        $jn = $jn + 1
      } sinon {
        $fin_n = 1
      }
    }
    $jn2 = $jn
    tant_que ($jn2 < longueur($src) et sous_chaine($src, $jn2, $jn2 + 1) == " ") {
      $jn2 = $jn2 + 1
    }
    $a_eq = 0
    si ($jn2 < longueur($src)) {
      si (sous_chaine($src, $jn2, $jn2 + 1) == "=") { $a_eq = 1 }
    }
    si ($nom_nu == "si" ou $nom_nu == "pour" ou $nom_nu == "tant_que" ou $nom_nu == "var" ou $nom_nu == "fn" ou $nom_nu == "retour") {
      $a_eq = 0
    }
    si ($a_eq == 1 et longueur($nom_nu) > 0) {
      $jx = $jn2 + 1
      tant_que ($jx < longueur($src) et sous_chaine($src, $jx, $jx + 1) == " ") {
        $jx = $jx + 1
      }
      $expr_nu = ""
      $kx = $jx
      $nl_pos = longueur($src)
      tant_que ($kx < longueur($src)) {
        $ch = sous_chaine($src, $kx, $kx + 1)
        si ($ch == "\n") {
          $nl_pos = $kx
          $kx = longueur($src) + 1
        } sinon {
          si ($ch != "\r") {
            $expr_nu = $expr_nu + $ch
          }
          $kx = $kx + 1
        }
      }
      $nbx = longueur($expr_nu)
      tant_que ($nbx > 0 et sous_chaine($expr_nu, 0, 1) == " ") {
        $expr_nu = sous_chaine($expr_nu, 1, longueur($expr_nu))
        $nbx = longueur($expr_nu)
      }
      $nbx = longueur($expr_nu)
      tant_que ($nbx > 0 et sous_chaine($expr_nu, $nbx - 1, $nbx) == " ") {
        $expr_nu = sous_chaine($expr_nu, 0, $nbx - 1)
        $nbx = longueur($expr_nu)
      }
      si (longueur($expr_nu) > 0) {
        $ctx = ""
        $vi = 1
        tant_que ($vi <= $nb_vars) {
          $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
          $vi = $vi + 1
        }
        si (longueur($ctx) > 0) {
          $expr_full = $expr_nu + " // vars: " + $ctx
        } sinon {
          $expr_full = $expr_nu
        }
        $resultat = eval_expr($expr_full)
        joindre($var_noms, $nom_nu)
        joindre($var_vals, $resultat)
        $nb_vars = $nb_vars + 1
      }
      $i = $nl_pos
    }
  }
  $i = $i + 1
}

# Pretraitement tant_que : deplier les boucles a la compilation.
# Deux modes :
#  - condition SANS variable connue : deplier une seule fois
#    (ou supprimer tout le bloc si la condition est fausse) ;
#  - condition dependant d'une variable : execution sequentielle a la
#    compilation — chaque ligne "var x = ..." du corps met a jour le stockage,
#    chaque ligne ">> ..." du corps est literalisee avec la valeur courante,
#    et les autres lignes subissent la substitution textuelle des variables.
$src_proc3 = $src
$modifie_tq = 1
$iter_max_tq = 1000
tant_que ($modifie_tq == 1) {
  $modifie_tq = 0
  $i = 0
  tant_que ($i < longueur($src_proc3)) {
    $c1 = ""
    $c2 = ""
    $c3 = ""
    $c4 = ""
    $c5 = ""
    $c6 = ""
    $c7 = ""
    $c8 = ""
    si ($i < longueur($src_proc3)) { $c1 = sous_chaine($src_proc3, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc3)) { $c2 = sous_chaine($src_proc3, $i + 1, $i + 2) }
    si ($i + 2 < longueur($src_proc3)) { $c3 = sous_chaine($src_proc3, $i + 2, $i + 3) }
    si ($i + 3 < longueur($src_proc3)) { $c4 = sous_chaine($src_proc3, $i + 3, $i + 4) }
    si ($i + 4 < longueur($src_proc3)) { $c5 = sous_chaine($src_proc3, $i + 4, $i + 5) }
    si ($i + 5 < longueur($src_proc3)) { $c6 = sous_chaine($src_proc3, $i + 5, $i + 6) }
    si ($i + 6 < longueur($src_proc3)) { $c7 = sous_chaine($src_proc3, $i + 6, $i + 7) }
    si ($i + 7 < longueur($src_proc3)) { $c8 = sous_chaine($src_proc3, $i + 7, $i + 8) }
    si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
      $j = $i + 8
      tant_que ($j < longueur($src_proc3) et sous_chaine($src_proc3, $j, $j + 1) == " ") {
        $j = $j + 1
      }
      si ($j < longueur($src_proc3) et sous_chaine($src_proc3, $j, $j + 1) == "(") {
        $j = $j + 1
        $cond = ""
        $prof = 1
        tant_que ($j < longueur($src_proc3) et $prof > 0) {
          $ch = sous_chaine($src_proc3, $j, $j + 1)
          si ($ch == "(") { $prof = $prof + 1 }
          si ($ch == ")") { $prof = $prof - 1 }
          si ($prof > 0) { $cond = $cond + $ch }
          $j = $j + 1
        }
        # Trouver le corps { ... }
        $prof = 0
        $trouve = 0
        $debut = $j
        tant_que ($j < longueur($src_proc3) et $trouve == 0) {
          $ch = sous_chaine($src_proc3, $j, $j + 1)
          si ($ch == "{") { $prof = $prof + 1 }
          si ($ch == "}") { $prof = $prof - 1 }
          si ($prof == 0 et $ch == "}") { $trouve = 1 }
          $j = $j + 1
        }
        si ($trouve == 1) {
          $fin_bloc = $j
          $corps = sous_chaine($src_proc3, $debut + 1, $fin_bloc - 1)
          $long = longueur($src_proc3)
          # Construire le contexte de variables (en ARRIERE : la derniere
          # valeur appendee est inseree en premier et gagne les remplacements)
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $cond_full = $cond + " // vars: " + $ctx
          } sinon {
            $cond_full = $cond
          }
          $cond_val = eval_expr($cond_full)
          $est_faux = 0
          si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
            $est_faux = 1
          }
          # Detecter une dependance de la condition a une variable connue
          # (marqueur : la substitution modifie le texte de la condition nue)
          $cond_var = 0
          $vq = 1
          tant_que ($vq <= $nb_vars) {
            si ($cond_var == 0) {
              $marque = substituer_nom($cond, $var_noms[$vq], "@SUB@")
              si ($marque != $cond) {
                $cond_var = 1
              }
            }
            $vq = $vq + 1
          }
          si ($est_faux == 1) {
            # Condition fausse : supprimer tout le bloc
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $apres
            $modifie_tq = 1
            $i = 0
          } sinon si ($cond_var == 0) {
            # Condition constante vraie : deplier une seule fois
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $corps + $apres
            $modifie_tq = 1
            $i = 0
          } sinon {
            # Condition pilotée par variable : execution sequentielle
            $unrolled_tq = ""
            $fini_tq = 0
            $n_iter_tq = 0
            tant_que ($fini_tq == 0 et $n_iter_tq < $iter_max_tq) {
              # Traiter le corps ligne par ligne
              $corps_out = ""
              $lp = 0
              tant_que ($lp < longueur($corps)) {
                # Trouver la fin de ligne
                $fl = $lp
                $a_fl = 0
                tant_que ($fl < longueur($corps) et $a_fl == 0) {
                  si (sous_chaine($corps, $fl, $fl + 1) == "\n") {
                    $a_fl = 1
                  } sinon {
                    $fl = $fl + 1
                  }
                }
                $ligne = sous_chaine($corps, $lp, $fl)
                # Premier caractere non blanc de la ligne
                $lc = 0
                tant_que ($lc < longueur($ligne) et (sous_chaine($ligne, $lc, $lc + 1) == " " ou sous_chaine($ligne, $lc, $lc + 1) == "\t")) {
                  $lc = $lc + 1
                }
                $consumé = 0
                # Detecter une affectation nue "nom = expr" (sans "var")
                $est_bare = 0
                $nom_bare = ""
                $la_b = $lc
                $fin_b = 0
                tant_que ($la_b < longueur($ligne) et $fin_b == 0) {
                  $ch = sous_chaine($ligne, $la_b, $la_b + 1)
                  si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                    $nom_bare = $nom_bare + $ch
                    $la_b = $la_b + 1
                  } sinon {
                    $fin_b = 1
                  }
                }
                $la_b2 = $la_b
                tant_que ($la_b2 < longueur($ligne) et sous_chaine($ligne, $la_b2, $la_b2 + 1) == " ") {
                  $la_b2 = $la_b2 + 1
                }
                si ($la_b2 < longueur($ligne) et sous_chaine($ligne, $la_b2, $la_b2 + 1) == "=" et longueur($nom_bare) > 0) {
                  $est_kw = 0
                  si ($nom_bare == "si") { $est_kw = 1 }
                  si ($nom_bare == "pour") { $est_kw = 1 }
                  si ($nom_bare == "tant_que") { $est_kw = 1 }
                  si ($nom_bare == "var") { $est_kw = 1 }
                  si ($nom_bare == "fn") { $est_kw = 1 }
                  si ($nom_bare == "retour") { $est_kw = 1 }
                  si ($est_kw == 0) {
                    $est_bare = 1
                  }
                }
                si ($est_bare == 1) {
                  $la_b = $la_b2 + 1
                  tant_que ($la_b < longueur($ligne) et sous_chaine($ligne, $la_b, $la_b + 1) == " ") {
                    $la_b = $la_b + 1
                  }
                  $expr_b = sous_chaine($ligne, $la_b, longueur($ligne))
                  si (longueur($expr_b) > 0) {
                    si (longueur($ctx) > 0) {
                      $expr_b_full = $expr_b + " // vars: " + $ctx
                    } sinon {
                      $expr_b_full = $expr_b
                    }
                    $val_b = eval_expr($expr_b_full)
                    joindre($var_noms, $nom_bare)
                    joindre($var_vals, $val_b)
                    $nb_vars = $nb_vars + 1
                  }
                  $consumé = 1
                }
                si ($consumé == 0) {
                  si ($lc + 3 < longueur($ligne)) {
                    si (sous_chaine($ligne, $lc, $lc + 1) == "v" et sous_chaine($ligne, $lc + 1, $lc + 2) == "a" et sous_chaine($ligne, $lc + 2, $lc + 3) == "r" et sous_chaine($ligne, $lc + 3, $lc + 4) == " ") {
                    # Affectation : var nom = expr
                    $la = $lc + 4
                    $nom_l = ""
                    tant_que ($la < longueur($ligne)) {
                      $ch = sous_chaine($ligne, $la, $la + 1)
                      si ($ch == " " ou $ch == "=") {
                        $la = longueur($ligne) + 1
                      } sinon {
                        $nom_l = $nom_l + $ch
                        $la = $la + 1
                      }
                    }
                    $la = $lc + 4
                    tant_que ($la < longueur($ligne) et sous_chaine($ligne, $la, $la + 1) != "=") {
                      $la = $la + 1
                    }
                    $la = $la + 1
                    tant_que ($la < longueur($ligne) et sous_chaine($ligne, $la, $la + 1) == " ") {
                      $la = $la + 1
                    }
                    $expr_l = sous_chaine($ligne, $la, longueur($ligne))
                    si (longueur($nom_l) > 0 et longueur($expr_l) > 0) {
                      si (longueur($ctx) > 0) {
                        $expr_l_full = $expr_l + " // vars: " + $ctx
                      } sinon {
                        $expr_l_full = $expr_l
                      }
                      $val_l = eval_expr($expr_l_full)
                      # Shadowing : on ajoute (la derniere valeur fait foi)
                      joindre($var_noms, $nom_l)
                      joindre($var_vals, $val_l)
                      $nb_vars = $nb_vars + 1
                    }
                    $consumé = 1
                  }
                }
                si ($consumé == 0) {
                  si ($lc + 1 < longueur($ligne)) {
                    si (sous_chaine($ligne, $lc, $lc + 1) == ">" et sous_chaine($ligne, $lc + 1, $lc + 2) == ">") {
                      # Affichage : >> expr -> literaliser
                      $ja = $lc + 2
                      tant_que ($ja < longueur($ligne) et sous_chaine($ligne, $ja, $ja + 1) == " ") {
                        $ja = $ja + 1
                      }
                      $expr_a = sous_chaine($ligne, $ja, longueur($ligne))
                      si (longueur($expr_a) > 0) {
                        si (longueur($ctx) > 0) {
                          $expr_a_full = $expr_a + " // vars: " + $ctx
                        } sinon {
                          $expr_a_full = $expr_a
                        }
                        $val_a = eval_expr($expr_a_full)
                        $corps_out = $corps_out + '>> "' + $val_a + '"' + "\n"
                      }
                      $consumé = 1
                    }
                  }
                }
                }
                si ($consumé == 0) {
                  # Autre ligne : substitution textuelle de toutes les variables
                  # (en ARRIERE : la valeur la plus recente fait foi)
                  $ligne_sub = $ligne
                  $li2 = $nb_vars
                  tant_que ($li2 >= 1) {
                    $ligne_sub = substituer_nom($ligne_sub, $var_noms[$li2], $var_vals[$li2])
                    $li2 = $li2 - 1
                  }
                  $corps_out = $corps_out + $ligne_sub + "\n"
                }
                $lp = $fl + 1
              }
              $unrolled_tq = $unrolled_tq + $corps_out
              # Re-evaluer la condition avec le stockage mis a jour
              # (contexte en ARRIERE : la derniere valeur appendee gagne)
              $ctx = ""
              $vi = 1
              tant_que ($vi <= $nb_vars) {
                $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
                $vi = $vi + 1
              }
              si (longueur($ctx) > 0) {
                $cond_full = $cond + " // vars: " + $ctx
              } sinon {
                $cond_full = $cond
              }
              $cond_val = eval_expr($cond_full)
              si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
                $fini_tq = 1
              }
              $n_iter_tq = $n_iter_tq + 1
            }
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $unrolled_tq + $apres
            $modifie_tq = 1
            $i = 0
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc3

# Pretraitement si : evaluer les conditions constantes et supprimer les branches
# non prises. Gere si (cond) { ... }, si (cond) { ... } sinon { ... } et les
# chaines "sinon si (...) { ... }".
$src_proc = $src_proc3
$modifie = 1
tant_que ($modifie == 1) {
  $modifie = 0
  $i = 0
    tant_que ($i < longueur($src_proc)) {
    $c1 = ""
    $c2 = ""
    si ($i < longueur($src_proc)) { $c1 = sous_chaine($src_proc, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc)) { $c2 = sous_chaine($src_proc, $i + 1, $i + 2) }
    si ($c1 == "s" et $c2 == "i") {
      $next = ""
      si ($i + 2 < longueur($src_proc)) { $next = sous_chaine($src_proc, $i + 2, $i + 3) }
      si ($next == " " ou $next == "(") {
        $j = $i + 2
        tant_que ($j < longueur($src_proc) et sous_chaine($src_proc, $j, $j + 1) == " ") {
          $j = $j + 1
        }
        si ($j < longueur($src_proc) et sous_chaine($src_proc, $j, $j + 1) == "(") {
          $j = $j + 1
          $cond = ""
          $prof = 1
          tant_que ($j < longueur($src_proc) et $prof > 0) {
            $ch = sous_chaine($src_proc, $j, $j + 1)
            si ($ch == "(") { $prof = $prof + 1 }
            si ($ch == ")") { $prof = $prof - 1 }
            si ($prof > 0) { $cond = $cond + $ch }
            $j = $j + 1
          }
          # Contexte de variables (en ARRIERE : la derniere valeur gagne)
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $cond_full = $cond + " // vars: " + $ctx
          } sinon {
            $cond_full = $cond
          }
          $cond_val = eval_expr($cond_full)
          $est_faux = 0
          si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
            $est_faux = 1
          }
          # Trouver le bloc { ... } du si
          $prof = 0
          $trouve = 0
          $debut = $j
          tant_que ($j < longueur($src_proc) et $trouve == 0) {
            $ch = sous_chaine($src_proc, $j, $j + 1)
            si ($ch == "{") { $prof = $prof + 1 }
            si ($ch == "}") { $prof = $prof - 1 }
            si ($prof == 0 et $ch == "}") { $trouve = 1 }
            $j = $j + 1
          }
          si ($trouve == 1) {
            $fin_bloc = $j
            $long = longueur($src_proc)
            # Detecter un "sinon" juste apres le bloc du si
            $q = $fin_bloc
            tant_que ($q < $long et (sous_chaine($src_proc, $q, $q + 1) == " " ou sous_chaine($src_proc, $q, $q + 1) == "\n" ou sous_chaine($src_proc, $q, $q + 1) == "\t")) {
              $q = $q + 1
            }
            $sinon_ici = 0
            si ($q + 4 < $long) {
              si (sous_chaine($src_proc, $q, $q + 1) == "s" et sous_chaine($src_proc, $q + 1, $q + 2) == "i" et sous_chaine($src_proc, $q + 2, $q + 3) == "n" et sous_chaine($src_proc, $q + 3, $q + 4) == "o" et sous_chaine($src_proc, $q + 4, $q + 5) == "n") {
                $sinon_ici = 1
              }
            }
            si ($sinon_ici == 0) {
              # Pas de sinon
              si ($est_faux == 1) {
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $fin_bloc, $long)
                $src_proc = $avant + $apres
                $modifie = 1
                $i = 0
              } sinon {
                $corps = sous_chaine($src_proc, $debut + 1, $fin_bloc - 1)
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $fin_bloc, $long)
                $src_proc = $avant + $corps + $apres
                $modifie = 1
                $i = 0
              }
            } sinon {
              # Un sinon est present : bloc simple ou "sinon si" ?
              $q2 = $q + 5
              tant_que ($q2 < $long et (sous_chaine($src_proc, $q2, $q2 + 1) == " " ou sous_chaine($src_proc, $q2, $q2 + 1) == "\n" ou sous_chaine($src_proc, $q2, $q2 + 1) == "\t")) {
                $q2 = $q2 + 1
              }
              $sinon_si = 0
              si ($q2 + 3 < $long) {
                si (sous_chaine($src_proc, $q2, $q2 + 1) == "s" et sous_chaine($src_proc, $q2 + 1, $q2 + 2) == "i") {
                  $suivant = ""
                  si ($q2 + 2 < $long) { $suivant = sous_chaine($src_proc, $q2 + 2, $q2 + 3) }
                  si ($suivant == " " ou $suivant == "(") {
                    $sinon_si = 1
                  }
                }
              }
              si ($est_faux == 1) {
                si ($sinon_si == 1) {
                  # Faux avec "sinon si" : garder le si suivant pour re-traitement
                  $avant = sous_chaine($src_proc, 0, $i)
                  $apres = sous_chaine($src_proc, $q2, $long)
                  $src_proc = $avant + $apres
                  $modifie = 1
                  $i = 0
                } sinon {
                  # Faux avec sinon bloc : garder le corps du sinon, supprimer le reste
                  $jj = $q2
                  tant_que ($jj < $long et sous_chaine($src_proc, $jj, $jj + 1) != "{") {
                    $jj = $jj + 1
                  }
                  $prof2 = 1
                  $jj = $jj + 1
                  tant_que ($jj < $long et $prof2 > 0) {
                    $ch = sous_chaine($src_proc, $jj, $jj + 1)
                    si ($ch == "{") { $prof2 = $prof2 + 1 }
                    si ($ch == "}") { $prof2 = $prof2 - 1 }
                    $jj = $jj + 1
                  }
                  $fin_sinon = $jj
                  $corps_sinon = sous_chaine($src_proc, $q2 + 1, $fin_sinon - 1)
                  $avant = sous_chaine($src_proc, 0, $i)
                  $apres = sous_chaine($src_proc, $fin_sinon, $long)
                  $src_proc = $avant + $corps_sinon + $apres
                  $modifie = 1
                  $i = 0
                }
              } sinon {
                # Vrai : supprimer TOUTE la chaine de sinon (si ... ou bloc)
                $pos = $fin_bloc
                $encore = 1
                tant_que ($encore == 1) {
                  $qq = $pos
                  tant_que ($qq < $long et (sous_chaine($src_proc, $qq, $qq + 1) == " " ou sous_chaine($src_proc, $qq, $qq + 1) == "\n" ou sous_chaine($src_proc, $qq, $qq + 1) == "\t")) {
                    $qq = $qq + 1
                  }
                  $a_sinon = 0
                  si ($qq + 4 < $long) {
                    si (sous_chaine($src_proc, $qq, $qq + 1) == "s" et sous_chaine($src_proc, $qq + 1, $qq + 2) == "i" et sous_chaine($src_proc, $qq + 2, $qq + 3) == "n" et sous_chaine($src_proc, $qq + 3, $qq + 4) == "o" et sous_chaine($src_proc, $qq + 4, $qq + 5) == "n") {
                      $a_sinon = 1
                    }
                  }
                  si ($a_sinon == 0) {
                    $encore = 0
                  } sinon {
                    $qq2 = $qq + 5
                    tant_que ($qq2 < $long et (sous_chaine($src_proc, $qq2, $qq2 + 1) == " " ou sous_chaine($src_proc, $qq2, $qq2 + 1) == "\n" ou sous_chaine($src_proc, $qq2, $qq2 + 1) == "\t")) {
                      $qq2 = $qq2 + 1
                    }
                    $sinon_si2 = 0
                    si ($qq2 + 3 < $long) {
                      si (sous_chaine($src_proc, $qq2, $qq2 + 1) == "s" et sous_chaine($src_proc, $qq2 + 1, $qq2 + 2) == "i") {
                        $suivant2 = ""
                        si ($qq2 + 2 < $long) { $suivant2 = sous_chaine($src_proc, $qq2 + 2, $qq2 + 3) }
                        si ($suivant2 == " " ou $suivant2 == "(") {
                          $sinon_si2 = 1
                        }
                      }
                    }
                    si ($sinon_si2 == 1) {
                      # Consommer "si (cond) { ... }"
                      $jj2 = $qq2 + 2
                      tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) == " ") {
                        $jj2 = $jj2 + 1
                      }
                      si ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) == "(") {
                        $jj2 = $jj2 + 1
                        $prof2 = 1
                        tant_que ($jj2 < $long et $prof2 > 0) {
                          $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                          si ($ch == "(") { $prof2 = $prof2 + 1 }
                          si ($ch == ")") { $prof2 = $prof2 - 1 }
                          $jj2 = $jj2 + 1
                        }
                        tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) != "{") {
                          $jj2 = $jj2 + 1
                        }
                        $prof2 = 1
                        $jj2 = $jj2 + 1
                        tant_que ($jj2 < $long et $prof2 > 0) {
                          $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                          si ($ch == "{") { $prof2 = $prof2 + 1 }
                          si ($ch == "}") { $prof2 = $prof2 - 1 }
                          $jj2 = $jj2 + 1
                        }
                        $pos = $jj2
                      } sinon {
                        $encore = 0
                      }
                    } sinon {
                      # Consommer "{ ... }"
                      $jj2 = $qq2
                      tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) != "{") {
                        $jj2 = $jj2 + 1
                      }
                      $prof2 = 1
                      $jj2 = $jj2 + 1
                      tant_que ($jj2 < $long et $prof2 > 0) {
                        $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                        si ($ch == "{") { $prof2 = $prof2 + 1 }
                        si ($ch == "}") { $prof2 = $prof2 - 1 }
                        $jj2 = $jj2 + 1
                      }
                      $pos = $jj2
                    }
                  }
                }
                $corps = sous_chaine($src_proc, $debut + 1, $fin_bloc - 1)
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $pos, $long)
                $src_proc = $avant + $corps + $apres
                $modifie = 1
                $i = 0
              }
            }
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc

# Pretraitement pour : deplier les boucles "pour N de D vers F" a la compilation
# Semantique moteur : borne superieure EXCLUSIVE (de 1 vers 5 -> 1,2,3,4)
$src_proc4 = $src_proc
$modifie_pr = 1
$iter_max_pr = 10000
tant_que ($modifie_pr == 1) {
  $modifie_pr = 0
  $i = 0
  tant_que ($i < longueur($src_proc4)) {
    # Detecter "pour "
    $c1 = ""
    $c2 = ""
    $c3 = ""
    $c4 = ""
    $c5 = ""
    si ($i < longueur($src_proc4)) { $c1 = sous_chaine($src_proc4, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc4)) { $c2 = sous_chaine($src_proc4, $i + 1, $i + 2) }
    si ($i + 2 < longueur($src_proc4)) { $c3 = sous_chaine($src_proc4, $i + 2, $i + 3) }
    si ($i + 3 < longueur($src_proc4)) { $c4 = sous_chaine($src_proc4, $i + 3, $i + 4) }
    si ($i + 4 < longueur($src_proc4)) { $c5 = sous_chaine($src_proc4, $i + 4, $i + 5) }
    si ($c1 == "p" et $c2 == "o" et $c3 == "u" et $c4 == "r" et $c5 == " ") {
      $j = $i + 5
      # Lire le nom de la variable de boucle (nom nu : alphanumerique + _)
      $nom_pr = ""
      $fin_nom = 0
      tant_que ($j < longueur($src_proc4) et $fin_nom == 0) {
        $ch = sous_chaine($src_proc4, $j, $j + 1)
        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
          $nom_pr = $nom_pr + $ch
          $j = $j + 1
        } sinon {
          $fin_nom = 1
        }
      }
      # Passer les espaces puis chercher "de "
      $j2 = $j
      tant_que ($j2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == " ") {
        $j2 = $j2 + 1
      }
      $a_de = 0
      si ($j2 + 2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == "d" et sous_chaine($src_proc4, $j2 + 1, $j2 + 2) == "e" et sous_chaine($src_proc4, $j2 + 2, $j2 + 3) == " ") {
        $a_de = 1
      }
      si ($a_de == 1 et longueur($nom_pr) > 0) {
        $j2 = $j2 + 3
        tant_que ($j2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == " ") {
          $j2 = $j2 + 1
        }
        # Extraire expr1 jusqu'a " vers " (sequence v e r s delimitee par des espaces)
        $expr1 = ""
        $trouve_vers = 0
        $k2 = $j2
        tant_que ($k2 < longueur($src_proc4) et $trouve_vers == 0) {
          si ($k2 + 4 < longueur($src_proc4) et sous_chaine($src_proc4, $k2, $k2 + 1) == " " et sous_chaine($src_proc4, $k2 + 1, $k2 + 2) == "v" et sous_chaine($src_proc4, $k2 + 2, $k2 + 3) == "e" et sous_chaine($src_proc4, $k2 + 3, $k2 + 4) == "r" et sous_chaine($src_proc4, $k2 + 4, $k2 + 5) == "s" et sous_chaine($src_proc4, $k2 + 5, $k2 + 6) == " ") {
            $trouve_vers = 1
            $k2 = $k2 + 6
          } sinon {
            $expr1 = $expr1 + sous_chaine($src_proc4, $k2, $k2 + 1)
            $k2 = $k2 + 1
          }
        }
        si ($trouve_vers == 1) {
          # Extraire expr2 jusqu'a "{"
          $expr2 = ""
          $k3 = $k2
          $trouve_acc = 0
          tant_que ($k3 < longueur($src_proc4) et $trouve_acc == 0) {
            $ch = sous_chaine($src_proc4, $k3, $k3 + 1)
            si ($ch == "{") {
              $trouve_acc = 1
            } sinon {
              si ($ch != " " et $ch != "\n" et $ch != "\t") {
                $expr2 = $expr2 + $ch
              }
              $k3 = $k3 + 1
            }
          }
          si ($trouve_acc == 1) {
            # Trouver le corps { ... }
            $prof = 0
            $trouve_fb = 0
            $debut_pr = $k3
            $k4 = $k3
            tant_que ($k4 < longueur($src_proc4) et $trouve_fb == 0) {
              $ch = sous_chaine($src_proc4, $k4, $k4 + 1)
              si ($ch == "{") { $prof = $prof + 1 }
              si ($ch == "}") { $prof = $prof - 1 }
              si ($prof == 0 et $ch == "}") { $trouve_fb = 1 }
              $k4 = $k4 + 1
            }
            si ($trouve_fb == 1) {
              $fin_pr = $k4
              $corps_pr = sous_chaine($src_proc4, $debut_pr + 1, $fin_pr - 1)
              # Evaluer les bornes avec le contexte de variables
              # (en ARRIERE : la derniere valeur appendee gagne)
              $ctx = ""
              $vi = 1
              tant_que ($vi <= $nb_vars) {
                $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
                $vi = $vi + 1
              }
              # Pre-substituer les variables connues dans les bornes
              $e1_sub = $expr1
              $e2_sub = $expr2
              $vi = $nb_vars
              tant_que ($vi >= 1) {
                $e1_sub = substituer_nom($e1_sub, $var_noms[$vi], $var_vals[$vi])
                $e2_sub = substituer_nom($e2_sub, $var_noms[$vi], $var_vals[$vi])
                $vi = $vi - 1
              }
              si (longueur($ctx) > 0) {
                $e1_full = $e1_sub + " // vars: " + $ctx
                $e2_full = $e2_sub + " // vars: " + $ctx
              } sinon {
                $e1_full = $e1_sub
                $e2_full = $e2_sub
              }
              $d1 = eval_expr($e1_full)
              $f2 = eval_expr($e2_full)
              # Verifier que les bornes sont numeriques
              $bornes_ok = 1
              $kc = 0
              tant_que ($kc < longueur($d1)) {
                $chc = sous_chaine($d1, $kc, $kc + 1)
                si (($chc < "0" ou $chc > "9") et $kc > 0) {
                  $bornes_ok = 0
                }
                si ($kc == 0 et $chc != "-" et ($chc < "0" ou $chc > "9")) {
                  $bornes_ok = 0
                }
                $kc = $kc + 1
              }
              $kc = 0
              tant_que ($kc < longueur($f2)) {
                $chc = sous_chaine($f2, $kc, $kc + 1)
                si (($chc < "0" ou $chc > "9") et $kc > 0) {
                  $bornes_ok = 0
                }
                si ($kc == 0 et $chc != "-" et ($chc < "0" ou $chc > "9")) {
                  $bornes_ok = 0
                }
                $kc = $kc + 1
              }
              si ($bornes_ok == 1) {
                # Deplier : remplacer le nom de boucle par sa valeur dans le corps
                $unrolled = ""
                $valeur = $d1
                $n_iter = 0
                $fini = 0
                tant_que ($fini == 0 et $n_iter < $iter_max_pr) {
                  $cmp_full = $valeur + " < " + $f2
                  si (longueur($ctx) > 0) {
                    $cmp_full = $cmp_full + " // vars: " + $ctx
                  }
                  $cmp_val = eval_expr($cmp_full)
                  si ($cmp_val == "vrai" ou $cmp_val == "1") {
                    # Collecter les noms assignes dans ce corps
                    $assigns_pr = ""
                    $ap2 = 0
                    $nb_corps2 = longueur($corps_pr)
                    tant_que ($ap2 < $nb_corps2) {
                      $flp = $ap2
                      $af = 0
                      tant_que ($flp < $nb_corps2 et $af == 0) {
                        si (sous_chaine($corps_pr, $flp, $flp + 1) == "\n") { $af = 1 } sinon { $flp = $flp + 1 }
                      }
                      $lnp = sous_chaine($corps_pr, $ap2, $flp)
                      $lcp = 0
                      tant_que ($lcp < longueur($lnp) et (sous_chaine($lnp, $lcp, $lcp + 1) == " " ou sous_chaine($lnp, $lcp, $lcp + 1) == "\t")) { $lcp = $lcp + 1 }
                      $nom_p2 = ""
                      $lap = $lcp
                      $finp = 0
                      tant_que ($lap < longueur($lnp) et $finp == 0) {
                        $ch = sous_chaine($lnp, $lap, $lap + 1)
                        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                          $nom_p2 = $nom_p2 + $ch
                          $lap = $lap + 1
                        } sinon {
                          $finp = 1
                        }
                      }
                      $lap2 = $lap
                      tant_que ($lap2 < longueur($lnp) et sous_chaine($lnp, $lap2, $lap2 + 1) == " ") { $lap2 = $lap2 + 1 }
                      si ($lap2 < longueur($lnp) et sous_chaine($lnp, $lap2, $lap2 + 1) == "=" et longueur($nom_p2) > 0) {
                        $assigns_pr = $assigns_pr + $nom_p2 + " "
                      }
                      $ap2 = $flp + 1
                    }
                    # contexte de cette iteration
                    $ctx_it = $ctx
                    si (longueur($nom_pr) > 0) {
                      $ctx_it = $nom_pr + "=" + $valeur + " " + $ctx
                    }
                    # Deplier le corps ligne par ligne
                    $sub_it = ""
                    $lp2 = 0
                    $nb_corps = longueur($corps_pr)
                    tant_que ($lp2 < $nb_corps) {
                      $fl2 = $lp2
                      $a_fl2 = 0
                      tant_que ($fl2 < $nb_corps et $a_fl2 == 0) {
                        si (sous_chaine($corps_pr, $fl2, $fl2 + 1) == "\n") {
                          $a_fl2 = 1
                        } sinon {
                          $fl2 = $fl2 + 1
                        }
                      }
                      $ligne2 = sous_chaine($corps_pr, $lp2, $fl2)
                      $lc2 = 0
                      tant_que ($lc2 < longueur($ligne2) et (sous_chaine($ligne2, $lc2, $lc2 + 1) == " " ou sous_chaine($ligne2, $lc2, $lc2 + 1) == "\t")) {
                        $lc2 = $lc2 + 1
                      }
                      $conso2 = 0
                      si ($lc2 + 1 < longueur($ligne2)) {
                        si (sous_chaine($ligne2, $lc2, $lc2 + 1) == ">" et sous_chaine($ligne2, $lc2 + 1, $lc2 + 2) == ">") {
                          $ja2 = $lc2 + 2
                          tant_que ($ja2 < longueur($ligne2) et sous_chaine($ligne2, $ja2, $ja2 + 1) == " ") {
                            $ja2 = $ja2 + 1
                          }
                          $expr_a2 = sous_chaine($ligne2, $ja2, longueur($ligne2))
                          si (longueur($expr_a2) > 0) {
                            # literaliser seulement si depend d'une var assignee
                            $lit = 0
                            $probe = $expr_a2
                            $cur = ""
                            $ki = 0
                            $nass = longueur($assigns_pr)
                            tant_que ($ki < $nass) {
                              $ch = sous_chaine($assigns_pr, $ki, $ki + 1)
                              si ($ch == " ") {
                                si (longueur($cur) > 0) {
                                  $probe2 = substituer_nom($probe, $cur, "@A@")
                                  si ($probe2 != $probe) { $lit = 1 }
                                  $probe = $probe2
                                }
                                $cur = ""
                              } sinon {
                                $cur = $cur + $ch
                              }
                              $ki = $ki + 1
                            }
                            si (longueur($cur) > 0) {
                              $probe2 = substituer_nom($probe, $cur, "@A@")
                              si ($probe2 != $probe) { $lit = 1 }
                            }
                            si ($lit == 1) {
                              si (longueur($ctx_it) > 0) {
                                $ea_full = $expr_a2 + " // vars: " + $ctx_it
                              } sinon {
                                $ea_full = $expr_a2
                              }
                              $val_a2 = eval_expr($ea_full)
                              $sub_it = $sub_it + '>> "' + $val_a2 + '"' + "\n"
                            } sinon {
                              $expr_sub2 = $expr_a2
                              $expr_sub2 = substituer_nom($expr_sub2, $nom_pr, $valeur)
                              $li4 = $nb_vars
                              tant_que ($li4 >= 1) {
                                $expr_sub2 = substituer_nom($expr_sub2, $var_noms[$li4], $var_vals[$li4])
                                $li4 = $li4 - 1
                              }
                              $sub_it = $sub_it + ">> " + $expr_sub2 + "\n"
                            }
                          }
                          $conso2 = 1
                        }
                      }
                      si ($conso2 == 0) {
                        # detecter affectation nue
                        $trim2 = $ligne2
                        $lt2 = 0
                        tant_que ($lt2 < longueur($trim2) et (sous_chaine($trim2, $lt2, $lt2 + 1) == " " ou sous_chaine($trim2, $lt2, $lt2 + 1) == "\t")) {
                          $lt2 = $lt2 + 1
                        }
                        $nom_a2 = ""
                        $la2 = $lt2
                        $fin_na2 = 0
                        tant_que ($la2 < longueur($trim2) et $fin_na2 == 0) {
                          $ch = sous_chaine($trim2, $la2, $la2 + 1)
                          si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                            $nom_a2 = $nom_a2 + $ch
                            $la2 = $la2 + 1
                          } sinon {
                            $fin_na2 = 1
                          }
                        }
                        $la3 = $la2
                        tant_que ($la3 < longueur($trim2) et sous_chaine($trim2, $la3, $la3 + 1) == " ") {
                          $la3 = $la3 + 1
                        }
                        $est_aff2 = 0
                        si ($la3 < longueur($trim2)) {
                          si (sous_chaine($trim2, $la3, $la3 + 1) == "=") {
                            $est_aff2 = 1
                          }
                        }
                        si ($est_aff2 == 1 et longueur($nom_a2) > 0) {
                          $kx2 = $la3 + 1
                          tant_que ($kx2 < longueur($trim2) et sous_chaine($trim2, $kx2, $kx2 + 1) == " ") {
                            $kx2 = $kx2 + 1
                          }
                          $expr_a2b = sous_chaine($trim2, $kx2, longueur($trim2))
                          si (longueur($ctx_it) > 0) {
                            $ea2_full = $expr_a2b + " // vars: " + $ctx_it
                          } sinon {
                            $ea2_full = $expr_a2b
                          }
                          $val_a2b = eval_expr($ea2_full)
                          $ctx_it = $ctx_it + " " + $nom_a2 + "=" + $val_a2b
                        } sinon {
                          $ligne_s2 = $ligne2
                          $ligne_s2 = substituer_nom($ligne_s2, $nom_pr, $valeur)
                          $li4 = $nb_vars
                          tant_que ($li4 >= 1) {
                            $ligne_s2 = substituer_nom($ligne_s2, $var_noms[$li4], $var_vals[$li4])
                            $li4 = $li4 - 1
                          }
                          $sub_it = $sub_it + $ligne_s2 + "\n"
                        }
                      }
                      $lp2 = $fl2 + 1
                    }
                    $unrolled = $unrolled + $sub_it
                    $valeur = eval_expr($valeur + " + 1")
                    $n_iter = $n_iter + 1
                  } sinon {
                    $fini = 1
                  }
                }
                # Remplacer le bloc pour par les iterations depliees
                $avant = sous_chaine($src_proc4, 0, $i)
                $apres = sous_chaine($src_proc4, $fin_pr, longueur($src_proc4))
                $src_proc4 = $avant + $unrolled + $apres
                $modifie_pr = 1
                $i = 0
              }
            }
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc4

# Post-traitement : evaluer numeriquement chaque ligne ">> <expr>" deja
# substituee (les noms ont ete remplaces plus tot), pour que les appels
# recursifs plies reviennent a des nombres.
$k = 0
$modif_num = 1
tant_que ($modif_num == 1) {
  $modif_num = 0
  $j = $k
  # trouver la prochaine ">> "
  $pos_g = -1
  $kk = $j
  tant_que ($kk + 3 <= longueur($src)) {
    si (sous_chaine($src, $kk, $kk + 3) == ">> ") {
      $pos_g = $kk
      $kk = longueur($src)
    } sinon {
      $kk = $kk + 1
    }
  }
  si ($pos_g < 0) {
    $k = longueur($src)
  } sinon {
    # avancer les espaces
    $p2 = $pos_g + 3
    tant_que ($p2 < longueur($src) et sous_chaine($src, $p2, $p2 + 1) == " ") { $p2 = $p2 + 1 }
    # lire l'expression jusqu'a \n
    $e2 = ""
    $p3 = $p2
    $fin_l2 = $p2
    $fini_l2 = 0
    tant_que ($p3 < longueur($src) et $fini_l2 == 0) {
      $cch = sous_chaine($src, $p3, $p3 + 1)
      si ($cch == "\n") {
        $fin_l2 = $p3
        $fini_l2 = 1
      } sinon {
        $e2 = $e2 + $cch
        $p3 = $p3 + 1
      }
    }
    $fin_l2 = $p3
    # evaluer via eval_expr, avec le contexte des variables connues
    $ctx2 = ""
    $vw = 1
    tant_que ($vw <= $nb_vars) {
      $ctx2 = $ctx2 + $var_noms[$vw] + "=" + $var_vals[$vw] + " "
      $vw = $vw + 1
    }
    si (longueur($ctx2) > 0) {
      $res2 = eval_expr($e2 + " // vars: " + $ctx2)
    } sinon {
      $res2 = eval_expr($e2)
    }
        # Ne pas remplacer un littéral chaîne : les guillemets doivent être
    # préservés pour que l'extraction ">>" puisse distinguer une chaîne
    # d'une variable du même nom.
    $nb_e2 = longueur($e2)
    $est_chaine_lit = 0
    si ($nb_e2 >= 2) {
      $f1b = sous_chaine($e2, 0, 1)
      $f2b = sous_chaine($e2, $nb_e2 - 1, $nb_e2)
      si ($f1b == "\"" et $f2b == "\"") {
        $est_chaine_lit = 1
      }
    }
    # Ne pas remplacer un booléen (vrai/faux) : ils sont affichés tels quels
    # par l'extraction finale, ce qui produirait du bruit pour les conditions
    # de boucle (tant_que/pour) déjà traitées au prétraitement.
    $est_bool = 0
    si ($res2 == "vrai" ou $res2 == "faux") {
      $est_bool = 1
    }
    si (longueur($res2) > 0 et $res2 != $e2 et $est_chaine_lit == 0 et $est_bool == 0) {
      $avant2 = sous_chaine($src, 0, $pos_g)
      $apres2 = sous_chaine($src, $fin_l2, longueur($src))
      $src = $avant2 + ">> " + $res2 + $apres2
      $p4 = $pos_g + 3 + longueur($res2)
      $fini_p4 = 0
      tant_que ($p4 < longueur($src) et $fini_p4 == 0) {
        si (sous_chaine($src, $p4, $p4 + 1) == "\n") { $fini_p4 = 1 } sinon { $p4 = $p4 + 1 }
      }
      $k = $p4
      $modif_num = 1
    } sinon {
      $k = $fin_l2
    }
  }
}

# Extraire et evaluer toutes les expressions apres >>
$affichage = ""
$dernier_resultat = ""
$dernier_expr_texte = ""
$i = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  $c2 = ""
  $c3 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  # Detecter "var " (deja traite en preprocessing, skip)
  si ($c1 == "v" et $c2 == "a" et $c3 == "r") {
    $i = $i + 1
  } sinon si ($c1 == ">" et $c2 == ">") {
    $j = $i + 2
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    # Extraire l'expression jusqu'a la fin de ligne
    $pc = ""
    si ($j < longueur($src)) { $pc = sous_chaine($src, $j, $j + 1) }
    $expr = ""
    $k = $j
    tant_que ($k < longueur($src)) {
      $ch = sous_chaine($src, $k, $k + 1)
      si ($ch == "\n") {
        $k = longueur($src) + 1
      } sinon {
        $expr = $expr + $ch
        $k = $k + 1
      }
    }
        si (longueur($expr) > 0) {
      # Verifier si c'est un nom de variable connu (en ARRIERE :
      # la valeur la plus recente fait foi apres le shadowing)
      $est_var = 0
      $vi = $nb_vars
      tant_que ($vi >= 1) {
        si ($est_var == 0) {
          si ($var_noms[$vi] == $expr) {
            $est_var = 1
            $resultat = $var_vals[$vi]
          }
        }
        $vi = $vi - 1
      }
      si ($est_var == 0) {
        # Si l'expression est deja un appel eval_expr(...) , evaluer directement.
        $est_ee = 0
        si (longueur($expr) >= 11) {
          si (sous_chaine($expr, 0, 10) == "eval_expr(") {
            $est_ee = 1
          }
        }
        si ($est_ee == 1) {
          # Extraire l'argument de eval_expr(...) : sous_chaine entre ( et ) final
          $j0 = 10
          $n0 = longueur($expr)
          # $expr = "eval_expr(<arg>)"
          $nb_arg = 0
          $k0 = $j0
          $cur = ""
          $prof0 = 0
          $fini0 = 0
          $arg_ee = ""
          tant_que ($k0 < $n0 et $fini0 == 0) {
            $cc = sous_chaine($expr, $k0, $k0 + 1)
            si ($cc == "(" ou $cc == "[" ou $cc == "{") {
              $prof0 = $prof0 + 1
              $cur = $cur + $cc
            } sinon si ($cc == ")" ou $cc == "]" ou $cc == "}") {
              si ($prof0 == 0) {
                $fini0 = 1
              } sinon {
                $prof0 = $prof0 - 1
                $cur = $cur + $cc
              }
            } sinon {
              $cur = $cur + $cc
            }
            $k0 = $k0 + 1
          }
          # trim
          $nbcur = longueur($cur)
          tant_que ($nbcur > 0 et sous_chaine($cur, 0, 1) == " ") { $cur = sous_chaine($cur, 1, longueur($cur)); $nbcur = longueur($cur) }
          $nbcur = longueur($cur)
          tant_que ($nbcur > 0 et sous_chaine($cur, $nbcur - 1, $nbcur) == " ") { $cur = sous_chaine($cur, 0, $nbcur - 1); $nbcur = longueur($cur) }
          $arg_ee = $cur
          # si l'arg commence par " et finit par ", decaper
          $nb_arg = longueur($arg_ee)
          si ($nb_arg >= 2) {
            $f1 = sous_chaine($arg_ee, 0, 1)
            $f2 = sous_chaine($arg_ee, $nb_arg - 1, $nb_arg)
            si ($f1 == "\"" et $f2 == "\"") {
              $arg_ee = sous_chaine($arg_ee, 1, $nb_arg - 1)
            }
          }
          $resultat = eval_expr($arg_ee)
                  } sinon {
          # Construire le contexte de variables (en AVANT : la derniere
          # valeur appendee fait foi via la substitution par paires_prelude).
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $expr_full = $expr + " // vars: " + $ctx
          } sinon {
            $expr_full = $expr
          }
          $resultat = eval_expr($expr_full)
        }
      }
            $dernier_expr_texte = $expr
            $dernier_resultat = $resultat
            $affichage = $affichage + $resultat + "\n"
    }
  }
  $i = $i + 1
}
si (longueur($affichage) == 0) {
  afficher_erreur("emetteur_elf : pas de >> <expression> trouve")
  quitter(1)
}
$cible = "aarch64"
si (nb_arguments() >= 3) {
  $cible = argument(2)
  si (longueur($cible) == 0) { $cible = "aarch64" }
}
emettre_elf_print($sortie, $affichage, $dernier_resultat, $dernier_expr_texte, $cible)
