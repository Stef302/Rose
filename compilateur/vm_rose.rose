# vm_rose.rose — machine virtuelle ROSEBC v3 en Rose pur (sous-ensemble G5).
#
# Ce module est le port de `rose/src/rosevm.rs` (PARTIE 3, snapshot AST) vers
# le langage Rose. Il ne dépend d'AUCUN binaire Rust : le chargeur lit les
# octets du `.rosebc`, la boucle d'exécution interprète les expressions et les
# instructions du snapshot avec les primitives de `interpreteur_rir.rose`
# (valeurs taguées `i:`/`r:`/`f:`/`s:`/`b:`/`l:`/`t:`, `val_*`, `call_prim`,
# `show`, `u_bytes`/`u_points`/`u_texte` pour l'UTF-8).
#
# Format v3 (little-endian), identique à `ecrire_snapshot` de rosevm.rs :
#
#   "ROSEBC" | version u32 (=3)
#   n_imports u32 | n_imports × chaîne
#   n_signatures u32 | n_signatures × signature
#       chaîne nom | u32 n_params | n_params × (chaîne, ty2)
#       ty2 retour | bool a_retour | bool corps_present
#       [u32 n_ins | n_ins × instruction]
#       chaîne dll | chaîne dll_son | chaîne symbole | u32 ligne
#   u32 n_ins | n_ins × instruction
#
#   chaîne = u32 len + UTF-8 ; bool = 1 octet ; ty2 = 2 octets.
#   expression = tag u8 + charges (EX3_*) + u32 ligne (sauf EXPRSTMT).
#   instruction = tag u8 + charges (IN3_*) [+ u32 ligne].
#
# État global (listes à sentinelle, indice 0 = fictif) :
#   $rvm_b        : octets du fichier (liste<entier>, accès via rvm_octet)
#   $rvm_env      : journal des liaisons (liste<chaine>, pack(nom)+pack(valeur))
#   $rvm_fn_*     : table des signatures du snapshot
#   $rvm_principal: [debut, fin] du corps principal
#
# L'environnement est un journal APPEND-ONLY : une fonction qui affecte une
# globale en Rose crée une locale, mais `joindre` mute la liste globale. Une
# trame est délimitée par une base (longueur du journal à l'entrée) ; les
# recherches ne voient que [base, fin], ce qui donne récursion et portée
# sans jamais retirer d'élément.

# ── État ───────────────────────────────────────────────────────────────────
$rvm_b = [0]
$rvm_env = [""]
$rvm_fn_nom = [""]
$rvm_fn_deb = [0]
$rvm_fn_fin = [0]
$rvm_fn_par = [""]
$rvm_principal = [0]

# ── Utilitaires dechaîne / de flux ─────────────────────────────────────────

fn rvm_parts($s: chaine) -> liste<chaine> {
  $r = [""]
  $n = longueur($s)
  $j = 0
  tant_que ($j < $n et sous_chaine($s, $j, $j + 1) != "|") { $j = $j + 1 }
  si ($j >= $n) {
    joindre($r, $s)
    joindre($r, "")
    joindre($r, "")
    retour $r
  }
  joindre($r, sous_chaine($s, 0, $j))
  $p = $j + 1
  $j = $p
  tant_que ($j < $n et sous_chaine($s, $j, $j + 1) != "|") { $j = $j + 1 }
  joindre($r, sous_chaine($s, $p, $j))
  si ($j < $n) { joindre($r, sous_chaine($s, $j + 1, $n)) } sinon { joindre($r, "") }
  retour $r
}

# ⚠ G5/C0 : `entier(appel_de_fonction(...))` est mal compilé par l'émetteur
# natif (segfault mesuré). Ces ponts font la conversion sur une LOCALE.
fn rvm_vstr_i($v: chaine) -> entier { $s = val_str($v); retour entier($s) }
fn rvm_octet_c($p: entier) -> chaine { $v = rvm_octet($p); retour chaine($v) }

# Les résultats de lecture sont encodés avec une POSITION À LARGEUR FIXE
# (10 chiffres). Un séparateur '|' serait ambigu : une valeur Rose (liste,
# table, chaîne) peut contenir ce caractère.
fn rvm_p10($n: entier) -> chaine {
  $s = chaine($n)
  tant_que (longueur($s) < 10) { $s = "0" + $s }
  retour $s
}

fn rvm_ip($s: chaine) -> entier {
  $t = sous_chaine($s, 0, 10)
  $j = 0
  tant_que ($j < 9 et sous_chaine($t, $j, $j + 1) == "0") { $j = $j + 1 }
  retour entier(sous_chaine($t, $j, 10))
}

fn rvm_iv($s: chaine) -> chaine { retour sous_chaine($s, 10, longueur($s)) }
fn rvm_ival($s: chaine) -> entier { $v = rvm_iv($s); retour entier($v) }
fn rvm_i2($s: chaine) -> entier {
  $t = sous_chaine($s, 10, 20)
  $j = 0
  tant_que ($j < 9 et sous_chaine($t, $j, $j + 1) == "0") { $j = $j + 1 }
  retour entier(sous_chaine($t, $j, 20))
}
fn rvm_v2($s: chaine) -> chaine { retour sous_chaine($s, 20, longueur($s)) }

# pack(s) = "<longueur>:<s>" — longueur en POINTS DE CODE (sans '|').
fn rvm_pack($s: chaine) -> chaine { retour chaine(longueur($s)) + ":" + $s }

# rvm_take(s, p) -> "fin|charge" (lit un champ longueur-préfixé).
fn rvm_take($s: chaine, $p: entier) -> chaine {
  $n = longueur($s)
  $j = $p
  tant_que ($j < $n et sous_chaine($s, $j, $j + 1) != ":") { $j = $j + 1 }
  $len = entier(sous_chaine($s, $p, $j))
  $d = $j + 1
  retour rvm_p10($d + $len) + sous_chaine($s, $d, $d + $len)
}

# ── Lecture des octets (le flux est une liste<entier> globale) ─────────────

fn rvm_octet($p: entier) -> entier { retour $rvm_b[1 + $p] }

fn rvm_u8($p: entier) -> chaine {
  retour rvm_p10($p + 1) + rvm_octet_c($p)
}

fn rvm_u32($p: entier) -> chaine {
  $v = rvm_octet($p) + 256 * rvm_octet($p + 1) + 65536 * rvm_octet($p + 2) + 16777216 * rvm_octet($p + 3)
  retour rvm_p10($p + 4) + chaine($v)
}

fn rvm_str($p: entier) -> chaine {
  $r = rvm_u32($p)
  $q = rvm_ip($r)
  $n = rvm_ival($r)
  $bytes = [0]
  $i = 0
  tant_que ($i < $n) {
    joindre($bytes, rvm_octet($q + $i))
    $i = $i + 1
  }
  $txt = u_texte(u_points($bytes))
  retour rvm_p10($q + $n) + $txt
}

fn rvm_bool($p: entier) -> chaine { retour rvm_u8($p) }

# ── Sauts structurels (lecture sans évaluation) ────────────────────────────

fn rvm_skip_expr($p: entier) -> entier {
  $tag = rvm_octet($p)
  $q = $p + 1
  $r = ""
  $n = 0
  $i = 0
  si ($tag == 1) {
    $r = rvm_str($q); $q = rvm_ip($r)   # texte
    $q = $q + 3 + 1 + 4                          # flott, rationnel, neg, tykind, ligne
  } sinon si ($tag == 2) {
    $q = $q + 16 + 4                             # re/im f64 + ligne
  } sinon si ($tag == 3) {
    $r = rvm_str($q); $q = rvm_ip($r) + 4
  } sinon si ($tag == 4) {
    $q = $q + 1 + 4
  } sinon si ($tag == 5) {
    $r = rvm_str($q); $q = rvm_ip($r) + 4
  } sinon si ($tag == 6) {
    $r = rvm_str($q); $q = rvm_ip($r)    # nom
    $r = rvm_str($q); $q = rvm_ip($r)    # module
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $i = 0
    tant_que ($i < $n) { $q = rvm_skip_expr($q); $i = $i + 1 }
    $q = $q + 4
  } sinon si ($tag == 7) {
    $r = rvm_str($q); $q = rvm_ip($r)    # op
    $q = rvm_skip_expr($q)
    $q = rvm_skip_expr($q) + 4
  } sinon si ($tag == 8) {
    $r = rvm_str($q); $q = rvm_ip($r)
    $q = rvm_skip_expr($q) + 4
  } sinon si ($tag == 9 ou $tag == 11 ou $tag == 12 ou $tag == 13 ou $tag == 14) {
    $q = rvm_skip_expr($q) + 4
  } sinon si ($tag == 10) {
    $q = rvm_skip_expr($q) + 1 + 4               # k (u8) + ligne
  } sinon si ($tag == 15) {
    $q = rvm_skip_expr($q)
    $q = rvm_skip_expr($q) + 4
  } sinon si ($tag == 16) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $i = 0
    tant_que ($i < $n) { $q = rvm_skip_expr($q); $i = $i + 1 }
    $q = $q + 4
  } sinon si ($tag == 17) {
    $q = $q + 1 + 4
  } sinon si ($tag == 18) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $i = 0
    tant_que ($i < $n) {
      $r = rvm_str($q); $q = rvm_ip($r)  # clé
      $q = rvm_skip_expr($q)
      $i = $i + 1
    }
    $q = $q + 4
  }
  retour $q
}

fn rvm_skip_instrs($p: entier, $n: entier) -> entier {
  $q = $p
  $i = 0
  tant_que ($i < $n) { $q = rvm_skip_instr($q); $i = $i + 1 }
  retour $q
}

fn rvm_skip_instr($p: entier) -> entier {
  $tag = rvm_octet($p)
  $q = $p + 1
  $r = ""
  $n = 0
  $b = 0
  si ($tag == 1) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $i = 0
    tant_que ($i < $n) { $q = rvm_skip_expr($q); $i = $i + 1 }
    $q = $q + 4
  } sinon si ($tag == 2) {
    $r = rvm_str($q); $q = rvm_ip($r) + 1 + 4
  } sinon si ($tag == 3) {
    $r = rvm_str($q); $q = rvm_ip($r)
    $q = rvm_skip_expr($q) + 4
  } sinon si ($tag == 4) {
    $r = rvm_str($q); $q = rvm_ip($r)
    $q = rvm_skip_expr($q)
    $q = rvm_skip_expr($q) + 4
  } sinon si ($tag == 5) {
    $q = rvm_skip_expr($q)
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $q = rvm_skip_instrs($q, $n)
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    si ($b == 1) {
      $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
      $q = rvm_skip_instrs($q, $n)
    }
    $q = $q + 4
  } sinon si ($tag == 6) {
    $q = rvm_skip_expr($q)
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $q = rvm_skip_instrs($q, $n) + 4
  } sinon si ($tag == 7) {
    $r = rvm_str($q); $q = rvm_ip($r)
    $q = rvm_skip_expr($q)
    $q = rvm_skip_expr($q)
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $q = rvm_skip_instrs($q, $n) + 4
  } sinon si ($tag == 8) {
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    si ($b == 1) { $q = rvm_skip_expr($q) }
    $q = $q + 4
  } sinon si ($tag == 9) {
    $q = rvm_skip_expr($q)
  } sinon si ($tag == 10) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $q = rvm_skip_instrs($q, $n)
  } sinon si ($tag == 11) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $q = rvm_skip_instrs($q, $n) + 4
  } sinon si ($tag == 12) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $q = rvm_skip_instrs($q, $n)
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    si ($b == 1) {
      $r = rvm_str($q); $q = rvm_ip($r)
      $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
      $q = rvm_skip_instrs($q, $n)
    }
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    si ($b == 1) {
      $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
      $q = rvm_skip_instrs($q, $n)
    }
    $q = $q + 4
  } sinon si ($tag == 13) {
    $q = rvm_skip_expr($q) + 4
  }
  retour $q
}

# ── Environnement ──────────────────────────────────────────────────────────

fn rvm_lier($nom: chaine, $val: chaine) {
  joindre($rvm_env, rvm_pack($nom) + rvm_pack($val))
}

fn rvm_lookup($nom: chaine, $base: entier) -> chaine {
  $i = longueur($rvm_env) - 1
  tant_que ($i >= $base) {
    $paire = $rvm_env[$i]
    # Un retour de fonction pose un marqueur "@<longueur>" : il rend
    # invisibles TOUTES les liaisons créées pendant cet appel (portée
    # dynamique correcte, y compris en récursion).
    si (longueur($paire) > 0 et sous_chaine($paire, 0, 1) == "@") {
      $i = entier(sous_chaine($paire, 1, longueur($paire))) + 1
      $paire = ""
    }
    si (longueur($paire) > 0 et sous_chaine($paire, 0, 1) != "@") {
    $t = rvm_take($paire, 0)
    si (rvm_iv($t) == $nom) {
      $tdeux = rvm_take($paire, rvm_ip($t))
      retour rvm_iv($tdeux)
    }
    }
    $i = $i - 1
  }
  retour vi("0")
}

fn rvm_find_fn($nom: chaine) -> entier {
  $i = 1
  tant_que ($i < longueur($rvm_fn_nom)) {
    si ($rvm_fn_nom[$i] == $nom) { retour $i }
    $i = $i + 1
  }
  retour 0
}

# ── Évaluateur d'expressions ───────────────────────────────────────────────
# rvm_eval -> "position_suivante|valeur"

fn rvm_eval($p: entier, $base: entier, $prof: entier) -> chaine {
  $tag = rvm_octet($p)
  $q = $p + 1
  $r = ""
  $v = vi("0")
  $x = vi("0")
  $y = vi("0")

  si ($tag == 1) {
    $r = rvm_str($q); $texte = rvm_iv($r); $q = rvm_ip($r)
    $flott = rvm_octet($q)
    $rationnel = rvm_octet($q + 1)
    $q = $q + 4 + 4
    si ($flott == 1 ou $rationnel == 1) { $v = vf($texte) } sinon { $v = vi($texte) }
  } sinon si ($tag == 2) {
    $q = $q + 16 + 4
    $v = vs("")
  } sinon si ($tag == 3) {
    $r = rvm_str($q); $ltxt = rvm_iv($r); $v = vs($ltxt); $q = rvm_ip($r) + 4
  } sinon si ($tag == 4) {
    $b = rvm_octet($q)
    $v = vb($b == 1)
    $q = $q + 1 + 4
  } sinon si ($tag == 5) {
    $r = rvm_str($q); $lnom = rvm_iv($r); $v = rvm_lookup($lnom, $base); $q = rvm_ip($r) + 4
  } sinon si ($tag == 6) {
    $r = rvm_str($q); $nom = rvm_iv($r); $q = rvm_ip($r)
    $r = rvm_str($q); $module = rvm_iv($r); $q = rvm_ip($r)
    $r = rvm_u32($q); $nargs = rvm_ival($r); $q = rvm_ip($r)
    # `inserer` et `joindre` MUTENT leur premier argument dans le moteur
    # Rust. Le snapshot garde l'appel en ExprStmt ; on relie donc la variable
    # au résultat retourné par call_prim (table/list persistante).
    $mutvar = ""
    si (($nom == "inserer" ou $nom == "joindre") et $nargs >= 2) {
      si (rvm_octet($q) == 5) {
        $rt = rvm_str($q + 1)
        $mutvar = rvm_iv($rt)
      }
    }
    $args = [""]
    $i = 0
    tant_que ($i < $nargs) {
      $re = rvm_eval($q, $base, $prof + 1)
      $arge = rvm_iv($re)
      joindre($args, $arge)
      $q = rvm_ip($re)
      $i = $i + 1
    }
    $q = $q + 4
    # Les arguments CLI de la RVM sont  après [classe] [methode].
    si ($nom == "argument" et longueur($args) >= 2) {
      $ix = rvm_vstr_i($args[1]) + 4
      $v = vs(argument($ix))
    } sinon si ($nom == "nb_arguments") {
      $na = nb_arguments() - 4
      si ($na < 0) { $na = 0 }
      $v = vi(chaine($na))
    } sinon {
      $fi = rvm_find_fn($nom)
      si ($fi > 0) {
        $v = rvm_call_fn($fi, $args, $prof + 1)
      } sinon {
        $v = call_prim($nom, $args)
      }
    }
    si (longueur($mutvar) > 0) { rvm_lier($mutvar, $v) }
  } sinon si ($tag == 7) {
    $r = rvm_str($q); $op = rvm_iv($r); $q = rvm_ip($r)
    $re = rvm_eval($q, $base, $prof + 1); $x = rvm_iv($re); $q = rvm_ip($re)
    $re = rvm_eval($q, $base, $prof + 1); $y = rvm_iv($re); $q = rvm_ip($re) + 4
    $v = rvm_binaire($op, $x, $y)
  } sinon si ($tag == 8) {
    $r = rvm_str($q); $op = rvm_iv($r); $q = rvm_ip($r)
    $re = rvm_eval($q, $base, $prof + 1); $x = rvm_iv($re); $q = rvm_ip($re) + 4
    $v = $x
    si ($op == "-" ou $op == "neg" ou $op == "−") { $v = val_neg($x) }
    si ($op == "non" ou $op == "!" ou $op == "¬") { $v = vb(non val_truth($x)) }
  } sinon si ($tag == 9 ou $tag == 11 ou $tag == 12 ou $tag == 13 ou $tag == 14) {
    $re = rvm_eval($q, $base, $prof + 1); $x = rvm_iv($re); $q = rvm_ip($re) + 4
    $nn = rvm_vstr_i($x)
    si ($tag == 9) { $v = vi(fact_big($nn)) }
    si ($tag == 11) { $v = vi(rvm_sousfact($nn)) }
    si ($tag == 12) { $v = vi(rvm_primorielle($nn)) }
    si ($tag == 13) { $v = vi(rvm_terminal($nn)) }
    si ($tag == 14) { $v = vi(rvm_superfact($nn)) }
  } sinon si ($tag == 10) {
    $re = rvm_eval($q, $base, $prof + 1); $x = rvm_iv($re); $q = rvm_ip($re)
    $k = rvm_octet($q)
    $q = $q + 1 + 4
    $nn = rvm_vstr_i($x)
    $prod = "1"
    $j = $nn
    tant_que ($j > 0) { $prod = bmul($prod, chaine($j)); $j = $j - $k }
    $v = vi($prod)
  } sinon si ($tag == 15) {
    $re = rvm_eval($q, $base, $prof + 1); $x = rvm_iv($re); $q = rvm_ip($re)
    $re = rvm_eval($q, $base, $prof + 1); $y = rvm_iv($re); $q = rvm_ip($re) + 4
    $tx = vtag($x)
    $v = "v:"
    si ($tx == "s") {
      $ix = rvm_vstr_i($y)
      $v = vs(sous_chaine(vpay($x), $ix, $ix + 1))
    }
    si ($tx == "l") { $v = lst_get($x, rvm_vstr_i($y)) }
    si ($tx == "t") { $v = tab_get($x, val_str($y)) }
  } sinon si ($tag == 16) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $lst = lst_empty()
    $i = 0
    tant_que ($i < $n) {
      $re = rvm_eval($q, $base, $prof + 1)
      $elem = rvm_iv($re)
      $lst = lst_append($lst, $elem)
      $q = rvm_ip($re)
      $i = $i + 1
    }
    $q = $q + 4
    $v = $lst
  } sinon si ($tag == 17) {
    $q = $q + 1 + 4
    $v = lst_empty()
  } sinon si ($tag == 18) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $tab = tab_empty()
    $i = 0
    tant_que ($i < $n) {
      $r = rvm_str($q); $cle = rvm_iv($r); $q = rvm_ip($r)
      $re = rvm_eval($q, $base, $prof + 1)
      $vent = rvm_iv($re)
      $tab = tab_set($tab, $cle, $vent)
      $q = rvm_ip($re)
      $i = $i + 1
    }
    $q = $q + 4
    $v = $tab
  }
  retour rvm_p10($q) + $v
}

fn rvm_binaire($op: chaine, $x: chaine, $y: chaine) -> chaine {
  $v = vi("0")
  si ($op == "+" ou $op == "⋅" ou $op == "·" ou $op == "×") { $v = val_add($x, $y) }
  si ($op == "-" ou $op == "−") { $v = val_sub($x, $y) }
  si ($op == "*" ou $op == "∗") { $v = val_mul($x, $y) }
  si ($op == "/" ou $op == "div" ou $op == "//" ou $op == "÷") { $v = val_div($x, $y) }
  si ($op == "%" ou $op == "mod") { $v = val_mod($x, $y) }
  si ($op == "^" ou $op == "puissance") { $v = val_pow($x, $y) }
  si ($op == "<") { $v = vb(val_cmp($x, $y) < 0) }
  si ($op == "<=" ou $op == "≤") { $v = vb(val_cmp($x, $y) <= 0) }
  si ($op == ">") { $v = vb(val_cmp($x, $y) > 0) }
  si ($op == ">=" ou $op == "≥") { $v = vb(val_cmp($x, $y) >= 0) }
  si ($op == "==" ou $op == "=") { $v = vb(val_eq($x, $y)) }
  si ($op == "!=" ou $op == "≠") { $v = vb(non val_eq($x, $y)) }
  si ($op == "et" ou $op == "&&") { $v = vb(val_truth($x) et val_truth($y)) }
  si ($op == "ou" ou $op == "||") { $v = vb(val_truth($x) ou val_truth($y)) }
  retour $v
}

# Sous-factorielle : !n = n·!(n−1) + (−1)^n.
fn rvm_sousfact($n: entier) -> chaine {
  $r = "1"
  $i = 1
  tant_que ($i <= $n) {
    $r = bmul(chaine($i), $r)
    si ($i % 2 == 0) { $r = badd($r, "1") } sinon { $r = bsub($r, "1") }
    $i = $i + 1
  }
  retour $r
}

fn rvm_est_premier_str($n: chaine) -> booleen {
  si (bcmp($n, "2") < 0) { retour faux }
  $d = "2"
  tant_que (bcmp(bmul($d, $d), $n) <= 0) {
    si (bmod($n, $d) == "0") { retour faux }
    $d = badd($d, "1")
  }
  retour vrai
}

fn rvm_primorielle($n: entier) -> chaine {
  $r = "1"
  $i = 2
  tant_que ($i <= $n) {
    si (rvm_est_premier_str(chaine($i))) { $r = bmul($r, chaine($i)) }
    $i = $i + 1
  }
  retour $r
}

fn rvm_terminal($n: entier) -> chaine {
  $r = bdiv(bmul(chaine($n), chaine($n + 1)), "2")
  retour $r
}

fn rvm_superfact($n: entier) -> chaine {
  $r = "1"
  $f = "1"
  $i = 1
  tant_que ($i <= $n) { $f = bmul($f, chaine($i)); $r = bmul($r, $f); $i = $i + 1 }
  retour $r
}

# ── Exécution des instructions ─────────────────────────────────────────────
# rvm_instr -> "position_suivante|statut|valeur_de_retour"
#   statut 0 = normal, 1 = retour de fonction, 2 = erreur.

fn rvm_exec($p: entier, $fin: entier, $base: entier, $prof: entier) -> chaine {
  $r = ""
  $r = ""
  $q = $p
  $st = 0
  $garde = 0
  tant_que ($q < $fin et $st == 0 et $garde < 100000000) {
    $r = rvm_instr($q, $base, $prof)
    $q = rvm_ip($r)
    $st = rvm_i2($r)
    $garde = $garde + 1
  }
  $v = ""
  si (longueur($r) >= 20) { $v = rvm_v2($r) }
  retour rvm_p10($q) + rvm_p10($st) + $v
}

fn rvm_call_fn($fi: entier, $args: liste<chaine>, $prof: entier) -> chaine {
  $ancien = longueur($rvm_env) - 1
  $params = $rvm_fn_par[$fi]
  $q = 0
  $np = 0
  tant_que ($q < longueur($params)) {
    $t = rvm_take($params, $q)
    $np = $np + 1
    $pnam = rvm_iv($t)
    $pval = $args[$np]
    rvm_lier($pnam, $pval)
    $q = rvm_ip($t)
  }
  $base = longueur($rvm_env) - 1
  $r = rvm_exec($rvm_fn_deb[$fi], $rvm_fn_fin[$fi], $base, $prof)
  $st = rvm_i2($r)
  joindre($rvm_env, "@" + chaine($ancien))
  si ($st == 1) { retour rvm_v2($r) }
  retour "v:"
}

fn rvm_instr($p: entier, $base: entier, $prof: entier) -> chaine {
  $tag = rvm_octet($p)
  $q = $p + 1
  $r = ""
  $n = 0
  $b = 0
  $v = "v:"
  $st = 0

  si ($tag == 1) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $i = 0
    tant_que ($i < $n) {
      $re = rvm_eval($q, $base, $prof)
      show(rvm_iv($re))
      $q = rvm_ip($re)
      $i = $i + 1
    }
    $q = $q + 4
  } sinon si ($tag == 2) {
    $r = rvm_str($q); $nom = rvm_iv($r); $q = rvm_ip($r)
    $q = $q + 1 + 4
    $lu = lire_texte("/dev/stdin")
    $v = vs($lu)
    rvm_lier($nom, $v)
  } sinon si ($tag == 3) {
    $r = rvm_str($q); $nom = rvm_iv($r); $q = rvm_ip($r)
    $re = rvm_eval($q, $base, $prof); $v = rvm_iv($re); $q = rvm_ip($re) + 4
    rvm_lier($nom, $v)
  } sinon si ($tag == 4) {
    $r = rvm_str($q); $nom = rvm_iv($r); $q = rvm_ip($r)
    $re = rvm_eval($q, $base, $prof); $key = rvm_iv($re); $q = rvm_ip($re)
    $re = rvm_eval($q, $base, $prof); $val = rvm_iv($re); $q = rvm_ip($re) + 4
    $cur = rvm_lookup($nom, $base)
    si (vtag($cur) == "t") { $cur = tab_set($cur, val_str($key), $val) }
    rvm_lier($nom, $cur)
  } sinon si ($tag == 5) {
    $test_p = $q
    $re = rvm_eval($q, $base, $prof); $test = rvm_iv($re); $q = rvm_ip($re)
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $da = $q
    $fa = rvm_skip_instrs($q, $n)
    $q = $fa
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    $ds = $q
    $fs = $q
    si ($b == 1) {
      $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
      $ds = $q
      $fs = rvm_skip_instrs($q, $n)
      $q = $fs
    }
    $q = $q + 4
    si (val_truth($test)) {
      $rr = rvm_exec($da, $fa, $base, $prof)
            $st = rvm_i2($rr)
      $v = rvm_v2($rr)
    } sinon {
      si ($b == 1) {
        $rr = rvm_exec($ds, $fs, $base, $prof)
                $st = rvm_i2($rr)
        $v = rvm_v2($rr)
      }
    }
  } sinon si ($tag == 6) {
    $test_p = $q
    $re = rvm_eval($q, $base, $prof); $q = rvm_ip($re)
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $dc = $q
    $fc = rvm_skip_instrs($q, $n)
    $q = $fc + 4
    $garde = 0
    $cont = vrai
    tant_que ($cont et $st == 0 et $garde < 10000000) {
      $tr = rvm_eval($test_p, $base, $prof)
      $tv = rvm_iv($tr)
      $cont = val_truth($tv)
      si ($cont) {
        $rr = rvm_exec($dc, $fc, $base, $prof)
                $st = rvm_i2($rr)
        $v = rvm_v2($rr)
      }
      $garde = $garde + 1
    }
  } sinon si ($tag == 7) {
    $r = rvm_str($q); $nom = rvm_iv($r); $q = rvm_ip($r)
    $re = rvm_eval($q, $base, $prof); $dv = rvm_iv($re); $d = val_str($dv); $q = rvm_ip($re)
    $re = rvm_eval($q, $base, $prof); $fmv = rvm_iv($re); $fm = val_str($fmv); $q = rvm_ip($re)
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $dc = $q
    $fc = rvm_skip_instrs($q, $n)
    $q = $fc + 4
    rvm_lier($nom, vi($d))
    $garde = 0
    tant_que (bcmp($d, $fm) < 0 et $st == 0 et $garde < 10000000) {
      $rr = rvm_exec($dc, $fc, $base, $prof)
            $st = rvm_i2($rr)
      $v = rvm_v2($rr)
      $d = badd($d, "1")
      rvm_lier($nom, vi($d))
      $garde = $garde + 1
    }
  } sinon si ($tag == 8) {
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    $v = "v:"
    si ($b == 1) {
      $re = rvm_eval($q, $base, $prof); $v = rvm_iv($re); $q = rvm_ip($re)
    }
    $q = $q + 4
    $st = 1
  } sinon si ($tag == 9) {
    $re = rvm_eval($q, $base, $prof); $q = rvm_ip($re)
  } sinon si ($tag == 10) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $db = $q
    $fb = rvm_skip_instrs($q, $n)
    $rr = rvm_exec($db, $fb, $base, $prof)
        $st = rvm_i2($rr)
    $v = rvm_v2($rr)
    $q = $fb
  } sinon si ($tag == 11) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $q = rvm_skip_instrs($q, $n) + 4
  } sinon si ($tag == 12) {
    $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
    $dc = $q
    $fc = rvm_skip_instrs($q, $n)
    $rr = rvm_exec($dc, $fc, $base, $prof)
        $st = rvm_i2($rr)
    $v = rvm_v2($rr)
    $q = $fc
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    si ($b == 1) {
      $r = rvm_str($q); $q = rvm_ip($r)
      $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
      $q = rvm_skip_instrs($q, $n)
    }
    $r = rvm_bool($q); $b = rvm_ival($r); $q = rvm_ip($r)
    si ($b == 1) {
      $r = rvm_u32($q); $n = rvm_ival($r); $q = rvm_ip($r)
      $q = rvm_skip_instrs($q, $n)
    }
    $q = $q + 4
  } sinon si ($tag == 13) {
    $re = rvm_eval($q, $base, $prof); $q = rvm_ip($re) + 4
    $v = rvm_iv($re)
    $st = 2
  }
  retour rvm_p10($q) + rvm_p10($st) + $v
}

# ── Chargeur ───────────────────────────────────────────────────────────────
# rvm_charger($chemin) -> "OK|" ou "ERR|message" ; remplit les globales.

fn rvm_charger($chemin: chaine) -> chaine {
  $txt = lire_texte($chemin)
  si (longueur($txt) == 0) { retour "ERR:rose rvm : lecture impossible : " + $chemin }

  # Reconstruit les octets bruts (C0 indexe les chaînes en points de code).
  $oct = u_bytes($txt)
  $i = 0
  tant_que ($i < u_long($oct)) {
    joindre($rvm_b, u_get($oct, $i))
    $i = $i + 1
  }
  $nb = u_long($oct)
  si ($nb < 10) { retour "ERR:bytecode Rose : fichier tronqué" }

  $i = 0
  tant_que ($i < 6) {
    si (rvm_octet($i) != ordre(sous_chaine("ROSEBC", $i, $i + 1))) {
      retour "ERR:bytecode Rose : magic `ROSEBC` absent"
    }
    $i = $i + 1
  }
  $r = rvm_u32(6)
  $version = rvm_ival($r)
  si ($version != 3) { retour "ERR:bytecode Rose : version non supportée (attendu 3)" }
  $q = 10

  $r = rvm_u32($q); $nimp = rvm_ival($r); $q = rvm_ip($r)
  $i = 0
  tant_que ($i < $nimp) { $r = rvm_str($q); $q = rvm_ip($r); $i = $i + 1 }

  $r = rvm_u32($q); $nsig = rvm_ival($r); $q = rvm_ip($r)
  $i = 0
  tant_que ($i < $nsig) {
    $r = rvm_str($q); $nom = rvm_iv($r); $q = rvm_ip($r)
    $r = rvm_u32($q); $npar = rvm_ival($r); $q = rvm_ip($r)
    $params = ""
    $j = 0
    tant_que ($j < $npar) {
      $r = rvm_str($q); $pn = rvm_iv($r); $params = $params + rvm_pack($pn); $q = rvm_ip($r)
      $q = $q + 2                                  # type du paramètre
      $j = $j + 1
    }
    $q = $q + 2                                    # type de retour
    $r = rvm_bool($q); $q = rvm_ip($r)    # a_retour
    $r = rvm_bool($q); $present = rvm_ival($r); $q = rvm_ip($r)
    $deb = $q
    $fin = $q
    si ($present == 1) {
      $r = rvm_u32($q); $nins = rvm_ival($r); $q = rvm_ip($r)
      $deb = $q
      $fin = rvm_skip_instrs($q, $nins)
      $q = $fin
    }
    $r = rvm_str($q); $q = rvm_ip($r)     # dll
    $r = rvm_str($q); $q = rvm_ip($r)     # dll_son
    $r = rvm_str($q); $q = rvm_ip($r)     # symbole
    $r = rvm_u32($q); $q = rvm_ip($r)     # ligne
    joindre($rvm_fn_nom, $nom)
    joindre($rvm_fn_deb, $deb)
    joindre($rvm_fn_fin, $fin)
    joindre($rvm_fn_par, $params)
    $i = $i + 1
  }

  $r = rvm_u32($q); $nins = rvm_ival($r); $q = rvm_ip($r)
  joindre($rvm_principal, $q)
  joindre($rvm_principal, rvm_skip_instrs($q, $nins))
  retour "OK"
}

# Exécute le snapshot chargé. Rend le statut de sortie (0 / 1).
fn rvm_run($chemin: chaine) -> entier {
  $r = rvm_charger($chemin)
  si ($r != "OK") {
    ecrire_bytes("/dev/stderr", sous_chaine($r, 4, longueur($r)) + "\n")
    retour 1
  }
  $fin = longueur($rvm_principal) - 1
  si ($fin < 2) {
    ecrire_bytes("/dev/stderr", "bytecode Rose : principal absent\n")
    retour 1
  }
  $rr = rvm_exec($rvm_principal[1], $rvm_principal[2], 0, 0)
  si (rvm_i2($rr) == 2) {
    ecrire_bytes("/dev/stderr", "VM Rose : erreur d'exécution\n")
    retour 1
  }
  retour 0
}
