# x_ordre : premier octet UTF-8 (point de code exact pour l'ASCII)
fn x_emit_ordre($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_addi(0, 24)
  xb(70); xb(15); xb(182); xb(8); xb(25)
  x_shl_rax(3)
  x_epilogue()
  retour 0
}
# x_caractere : point de code ASCII (les autres deviennent '?')
fn x_emit_caractere($lbl: entier, $make_str: entier) -> entier {
  x_mark($lbl)
  x_prologue(128)
  $Lqmark = x_new()
  $Lcall = x_new()
  x_byte_imm(-64, 0)
  x_mem(139, 1, -8); x_sar_rax(3); x_mem(137, 0, -16)
  x_mem(139, 0, -16); x_cmp(0, 127)
  x_branch(143, $Lqmark)
  x_mem(139, 0, -16)
  x_stb_rax(-64, 0)
  x_branch(233, $Lcall)
  x_mark($Lqmark)
  x_stb_rax(-64, 63)
  x_mark($Lcall)
  x_mem(141, 10, -64)
  x_movimm(2, 1)
  x_movimm(8, 1)
  x_call_lbl($make_str)
  x_epilogue()
  retour 0
}

