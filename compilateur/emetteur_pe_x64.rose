  $Lloop = x_new()
  $Lfound = x_new()
  $Lfin = x_new()
  $Lfin2 = x_new()
  $Lshift = x_new()
  $Lshiftend = x_new()
  x_mark($Lloop)
  x_mem(139, 9, -24); x_cmp(9, 0)
  x_branch(141, $Lfin)
  x_mem(139, 0, -32)
  xb(74); xb(139); xb(4); xb(136)
  x_mem(139, 10, -16)
  x_cmp(0, 10)
  x_branch(132, $Lfound)
  x_addi(9, 1)
  x_branch(233, $Lloop)
