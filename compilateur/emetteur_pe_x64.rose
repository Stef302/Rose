  retour 0
}

fn x_andi_1f($r: entier) -> entier {
  $b = 0; si ($r >= 8) { $b = 1 }
  x_rex(1, 0, 0, $b); xb(131); xb(224 + ($r % 8)); xb(31)
  retour 0
}
fn x_or_rax($r: entier) -> entier {
  $b = 0; si ($r >= 8) { $b = 1 }
  $rr = 0; si ($r >= 8) { $rr = 1 }
  x_rex(1, $rr, 0, $b); xb(11); xb(192 + ($r % 8))
  retour 0
}
# x_supprimer(RCX=table, RDX=clé) -> RAX = booléen étiqueté
fn x_emit_supprimer($lbl: entier) -> entier {
  x_mark($lbl)
