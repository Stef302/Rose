  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_ldq_rax(10, 8); x_mem(137, 10, -24)
  x_ldq_rax(0, 24); x_mem(137, 0, -32)
  x_movimm(9, 0)
  $Lloop = x_new()
  $Loui = x_new()
  $Lfin = x_new()
