# Affichage d'une valeur étiquetée : chaîne -> octets, entier -> décimal.
fn x_emit_print_val($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(176)
  x_mem(137, 1, -8)
  $Lstr = x_new()
  $Lnum = x_new()
  $Lfin = x_new()
  x_mov(0, 1); xb(73); xb(131); xb(226); xb(7)
  x_cmp(0, 1)
  x_branch(132, $Lstr)
  x_branch(233, $Lnum)
  x_mark($Lstr)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248); x_addi(0, 24)
  x_mem(137, 0, -24)
  x_ldq_rax(10, 16); x_mem(137, 10, -32)
  xb(185); xb(245); xb(255); xb(255); xb(255)
  x_call_iat(0)
  x_mem(137, 0, -40)
  x_mem(139, 1, -40)
  x_mem(139, 2, -24)
  x_mem(139, 8, -32)
  x_mem(141, 9, -48)
  xb(72); xb(199); xb(68); xb(36); xb(32); x_imm32(0)
  x_call_iat(1)
  x_branch(233, $Lfin)
  x_mark($Lnum)
  x_mem(139, 1, -8)
  x_sar_rax(3)
  $Lz = x_new()
  $Lp = x_new()
  $Lc = x_new()
  $Lloop = x_new()
  $Ldone = x_new()
  $Lwrite = x_new()
  xb(69); xb(49); xb(219)
  x_mem(137, 11, -56)
  xb(72); xb(133); xb(192)
  x_branch(132, $Lz)
  x_branch(137, $Lp)
  xb(72); xb(247); xb(216)
  x_movimm(11, 1)
  x_mem(137, 11, -56)
  x_branch(233, $Lc)
  x_mark($Lz)
  x_byte_imm(-97, 48)
  x_movimm(10, 1)
  x_movimm(9, 1)
  x_branch(233, $Lwrite)
  x_mark($Lp)
  x_mark($Lc)
  x_mem(141, 10, -96)
  x_movimm(9, 0)
  x_mark($Lloop)
  xb(72); xb(133); xb(192)
  x_branch(132, $Ldone)
  xb(72); xb(49); xb(210)
  x_movimm(8, 10)
  xb(73); xb(247); xb(240)
  xb(128); xb(194); xb(48)
  x_subi(10, 1)
  xb(65); xb(136); xb(18)
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Ldone)
  xb(72); xb(131); xb(189); x_imm32(-56); xb(0)
  x_branch(132, $Lwrite)
  x_subi(10, 1)
  xb(65); xb(198); xb(2); xb(45)
  x_addi(9, 1)
  x_mark($Lwrite)
  xb(185); xb(245); xb(255); xb(255); xb(255)
  x_call_iat(0)
  x_mem(137, 0, -40)
  x_mem(139, 1, -40)
  x_mov(2, 10)
  x_mov(8, 9)
  x_mem(141, 9, -48)
  xb(72); xb(199); xb(68); xb(36); xb(32); x_imm32(0)
  x_call_iat(1)
  x_mark($Lfin)
  x_epilogue()
  retour 0
}
# Primitive : le Dispatch par nom est résolu à l'émission.
fn x_emit_prim($nom: chaine, $lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  $Lpf = x_new()
  si ($nom == "longueur") { x_call_lbl($h_len)
  } sinon si ($nom == "sous_chaine") { x_call_lbl($h_sous)
  } sinon si ($nom == "joindre") { x_call_lbl($h_joindre)
  } sinon si ($nom == "chaine") { x_call_lbl($h_chaine)
  } sinon si ($nom == "entier") { x_call_lbl($h_entier)
  } sinon si ($nom == "table") { x_call_lbl($h_table)
  } sinon si ($nom == "inserer") { x_call_lbl($h_inserer)
  } sinon si ($nom == "supprimer") { x_call_lbl($h_suppr)
  } sinon si ($nom == "cle_existe") { x_call_lbl($h_cle)
  } sinon si ($nom == "ordre") { x_call_lbl($h_ordre)
  } sinon si ($nom == "caractere") { x_call_lbl($h_car)
  } sinon si ($nom == "quitter") {
    x_mem(139, 1, -8); xb(72); xb(131); xb(233); xb(248); x_mov(1, 0)
    x_call_iat(2)
  } sinon si ($nom == "temps" ou $nom == "hasard") {
    x_call_iat(11)
    x_shl_rax(3)
  } sinon si ($nom == "partie_entiere" ou $nom == "flottant") {
    x_mem(139, 0, -8)
    xb(73); xb(131); xb(226); xb(7)
    x_cmp(0, 0)
    x_branch(132, $Lpf)
    x_call_lbl($h_entier)
    x_mark($Lpf)
  } sinon si ($nom == "graine") {
    x_movimm(0, 0)
  } sinon si ($nom == "nb_arguments") {
    x_movimm(0, 0)
  } sinon si ($nom == "argument") {
    x_movimm(1, 0)
    x_movimm(2, 0)
    x_movimm(8, 0)
    x_call_lbl($h_make_str)
  } sinon si ($nom == "afficher_erreur") {
    x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248); x_addi(0, 24)
    x_mem(137, 0, -24)
    x_ldq_rax(10, 16); x_mem(137, 10, -32)
    xb(185); xb(245); xb(255); xb(255); xb(255)
    x_call_iat(0)
    x_mem(137, 0, -40)
    x_mem(139, 1, -40)
    x_mem(139, 2, -24)
    x_mem(139, 8, -32)
    x_mem(141, 9, -48)
    xb(72); xb(199); xb(68); xb(36); xb(32); x_imm32(0)
    x_call_iat(1)
    x_movimm(0, 0)
  } sinon si ($nom == "lire_texte" ou $nom == "ecrire_bytes" ou $nom == "ecrire_texte") {
    x_movimm(1, 0)
    x_movimm(2, 0)
    x_movimm(8, 0)
    x_call_lbl($h_make_str)
  } sinon {
    x_movimm(0, 0)
  }
  x_epilogue()
  retour 0
}

# ── Parse RIR ──────────────────────────────────────────────────────────────
fn x_parse($src: chaine) -> entier {
  $ll = x_lignes($src)
  $i = 1
  tant_que ($i < longueur($ll)) {
    $t = x_trim($ll[$i])
    si (x_sub($t, 0, 9) == "fonction ") {
      $nm = x_trim(x_sub($t, 9, longueur($t)))
      $slot = 0
      $noms = ""
      $nparam = 0
      $ops = [0 : chaine]
      $en_ops = 0
      $i = $i + 1
      tant_que ($i < longueur($ll) et x_sub(x_trim(x_elt_ch($ll, $i)), 0, 9) != "fonction ") {
        $u = x_trim($ll[$i])
        si (x_sub($u, 0, 6) == "param ") { $nparam = $nparam + 1
        } sinon si (x_sub($u, 0, 8) == "n_slots ") { $slot = x_ent(x_sub($u, 8, longueur($u)))
        } sinon si (x_sub($u, 0, 5) == "noms ") { $noms = x_trim(x_sub($u, 5, longueur($u)))
        } sinon si ($u == "ops") { $en_ops = 1
        } sinon si ($en_ops == 1 et longueur($u) > 0) { joindre($ops, x_nu_op($u)) }
        $i = $i + 1
      }
      joindre($x_fn, $nm)
      joindre($x_fnslot, $slot)
      joindre($x_fnam, x_noms($noms))
      joindre($x_fop, longueur($x_ops))
      joindre($x_fnop, longueur($ops))
      joindre($x_flbl, x_new())
      joindre($x_endlbl, x_new())
      joindre($x_fparam, $nparam)
      $j = 0
      tant_que ($j < longueur($ops)) { joindre($x_ops, $ops[$j]); joindre($x_oplbl, x_new()); $j = $j + 1 }
    } sinon { $i = $i + 1 }
  }
  retour longueur($x_fn)
}

# ── Patch des sauts et des appels IAT ──────────────────────────────────────
$rva_text = 4096
$x_rva_data = 8192
$x_iat_off = 200
fn x_patch() -> chaine {
  # Jointure équilibrée : l'accumulation `+` octet par octet devient O(n^2)
  # dans le runtime natif (mesuré sur le RIR complet de 795 634 octets).
  $parts = [""]
  $i = 0
  $n = x_off()
  tant_que ($i < $n) {
    $m = $x_meta[$i]
    si (longueur($m) > 0 et sous_chaine($m, 0, 1) == "B") {
      $l = x_ent(x_sub($m, 1, longueur($m)))
      $t = x_label($l)
      si ($t < 0) { $t = 0 }
      joindre($parts, u32le($t - $i - 4))
      $i = $i + 4
    } sinon si (longueur($m) > 0 et sous_chaine($m, 0, 1) == "I") {
      $idx = x_ent(x_sub($m, 1, longueur($m)))
      $cible = $x_rva_data + $x_iat_off + 8 * $idx
      joindre($parts, u32le($cible - ($rva_text + $i + 4)))
      $i = $i + 4
    } sinon {
      joindre($parts, u8le($x_code[$i]))
      $i = $i + 1
    }
  }
  retour pe_join($parts, 1, longueur($parts))
}

# ── Writer PE32+ x86-64 ────────────────────────────────────────────────────
fn pe_z($n: entier) -> chaine {
  $r = ""
  $i = 0
  tant_que ($i < $n) { $r = $r + caractere(0); $i = $i + 1 }
  retour $r
}
fn pe_c($s: chaine, $cible: entier) -> chaine {
  $n = longueur($s)
  si ($n >= $cible) { retour $s }
  retour $s + pe_z($cible - $n)
}
# pe_join — jointure équilibrée d'une liste de morceaux : O(n log n) octets
# copiés au lieu du O(n^2) d'une accumulation `+` octet par octet dans le
# runtime G5 natif (mesuré : +235 octets de bourrage sans ce correctif J2).
fn pe_join($p: liste<chaine>, $d: entier, $f: entier) -> chaine {
  si ($f - $d <= 0) { retour "" }
  si ($f - $d == 1) { retour $p[$d] }
  $m = ($d + $f) div 2
  retour pe_join($p, $d, $m) + pe_join($p, $m, $f)
}
# pe_raw — conversion de chaque POINT DE CODE en OCTET BRUT, au dernier
# moment : tous les encarts sont construits avec caractere() (UTF-8 valide),
# donc `longueur()` = nombre de points de code = nombre d'octets finaux.
fn pe_raw($s: chaine) -> chaine {
  $parts = [""]
  $i = 0
  $n = longueur($s)
  tant_que ($i < $n) {
    joindre($parts, octet_brut(ordre(sous_chaine($s, $i, $i + 1))))
    $i = $i + 1
  }
  retour pe_join($parts, 1, longueur($parts))
}
fn x_pe($bin: chaine) -> chaine {
  $rva_data = $x_rva_data
  $image_base = 5368709120        # 0x140000000
  $imp_off = 32                   # 0x20
  $ilt_off = 96                   # 0x60 : 12 entrées + terminateur -> 200
  $iat_off = $x_iat_off           # 0xC8 : 12 entrées + terminateur -> 304
  $hint_base = 320                # 0x140 (12 × 32 octets : les noms longs dépassent 16)
  $dll_off = 704                  # 0x2C0
  $nimports = 12
  $data_sz = 1024                 # .data : ILT/IAT + 12 noms + DLL name
  $text_len = longueur($bin)
  $text_raw = partie_entiere(($text_len + 511) / 512) * 512
  $off_text = 1024
  $off_data = $off_text + $text_raw
  $off_pdata = $off_data + 512
  $rva_pdata = partie_entiere(($rva_data + 512 + 4095) / 4096) * 4096
  $size_image = $rva_pdata + 4096

  $out = "MZ"
  $out = pe_c($out, 60)
  $out = $out + u32le(128)
  $out = $out + "Rose PE64-x64" + caractere(0)
  $out = pe_c($out, 128)
  $out = $out + "PE" + caractere(0) + caractere(0)

  # COFF
  $out = $out + u16le(34404)      # 0x8664 AMD64
  $out = $out + u16le(3)
  $out = $out + u32le(0) + u32le(0) + u32le(0)
  $out = $out + u16le(240)        # SizeOfOptionalHeader
  $out = $out + u16le(34)         # 0x22 EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

  # OptionalHeader PE32+
  $out = $out + u16le(523) + caractere(0) + caractere(0)
  $out = $out + u32le($text_raw) + u32le(512) + u32le(0)
  $out = $out + u32le($rva_text) + u32le($rva_text)
  $out = $out + u64le($image_base)
  $out = $out + u32le(4096) + u32le(512)
  $out = $out + u16le(6) + u16le(0) + u16le(0) + u16le(0) + u16le(6) + u16le(0)
  $out = $out + u32le(0)
  $out = $out + u32le($size_image) + u32le(1024) + u32le(0)
  $out = $out + u16le(3) + u16le(33120)          # CUI, 0x8160
  $out = $out + u64le(1048576) + u64le(4096) + u64le(1048576) + u64le(4096)
  $out = $out + u32le(0) + u32le(16)
  $out = $out + pe_z(8)
  $out = $out + u32le($rva_data + $imp_off) + u32le(40)
  $out = $out + pe_z(8)
  $out = $out + u32le($rva_pdata) + u32le(12)
  $out = $out + pe_z(64)
  $out = $out + u32le($rva_data + $iat_off) + u32le(8 * $nimports)
  $out = $out + pe_z(24)

  # Section headers
  $out = pe_c($out, 392)
  $out = $out + ".text" + pe_z(3)
  $out = $out + u32le($text_len) + u32le($rva_text) + u32le($text_raw) + u32le($off_text)
  $out = $out + u32le(0) + u32le(0) + u16le(0) + u16le(0) + u32le(1610612768)
  $out = $out + ".data" + pe_z(3)
  $out = $out + u32le($data_sz) + u32le($rva_data) + u32le($data_sz) + u32le($off_data)
  $out = $out + u32le(0) + u32le(0) + u16le(0) + u16le(0) + u32le(3221225536)
  $out = $out + ".pdata" + pe_z(2)
  $out = $out + u32le(36) + u32le($rva_pdata) + u32le(512) + u32le($off_pdata)
  $out = $out + u32le(0) + u32le(0) + u16le(0) + u16le(0) + u32le(1073741888)
  $out = pe_c($out, 1024)

  # .data
  $noms = ["GetStdHandle", "WriteFile", "ExitProcess", "GetProcessHeap",
           "HeapAlloc", "HeapFree", "CreateFileA", "ReadFile", "CloseHandle",
           "GetFileSize", "GetCommandLineA", "GetTickCount64"]
  $dat = pe_c("", 32)
  $dat = $dat + u32le($rva_data + $ilt_off) + u32le(0) + u32le(0) + u32le($rva_data + $dll_off) + u32le($rva_data + $iat_off)
  $dat = pe_c($dat, 72)                  # descripteur nul
  $dat = pe_c($dat, 96)
  $i = 0
  tant_que ($i < $nimports) { $dat = $dat + u64le($rva_data + $hint_base + 32 * $i); $i = $i + 1 }
  $dat = $dat + u64le(0)                 # terminateur ILT
  $dat = pe_c($dat, $iat_off)            # alignement IAT (12 entrées)
  $i = 0
  tant_que ($i < $nimports) { $dat = $dat + u64le($rva_data + $hint_base + 32 * $i); $i = $i + 1 }
  $dat = $dat + u64le(0)                 # terminateur IAT
  $dat = pe_c($dat, $hint_base)          # alignement des noms
  $i = 0
  tant_que ($i < $nimports) {
    $dat = $dat + u16le(0) + $noms[$i] + caractere(0)
    $dat = pe_c($dat, $hint_base + 32 * ($i + 1))
    $i = $i + 1
  }
  $dat = pe_c($dat, $dll_off)
  $dat = $dat + "KERNEL32.DLL" + caractere(0)
  $dat = pe_c($dat, $data_sz)

  $out = $out + $bin
  $out = pe_c($out, $off_data)
  $out = $out + $dat

  # .pdata : RUNTIME_FUNCTION(12) + UNWIND_INFO(12)
  $frame = x_frame()
  $pd = ""
  $pd = $pd + u32le($rva_text)
  $pd = $pd + u32le($rva_text + $text_len)
  $pd = $pd + u32le($rva_pdata + 24)       # UNWIND_INFO après le terminateur
  $pd = $pd + pe_z(12)                     # entrée nulle = fin du tableau RUNTIME_FUNCTION
  $pd = $pd + u8le(1) + u8le(11) + u8le(4) + u8le(0)   # v1, prolog 11, 4 codes, pas de frame reg
  $pd = $pd + u16le(20481)                        # 0x5001 UWOP_PUSH_NONVOL rbp, offset 1
  $pd = $pd + u16le(4363)                         # 0x110B UWOP_ALLOC_LARGE imm32, offset 11
  $pd = $pd + u16le($frame % 65536) + u16le(partie_entiere($frame / 65536) % 65536)
  $pd = pe_c($pd, 512)
  $out = $out + $pd
  retour $out
}

# ── Point d'entrée ─────────────────────────────────────────────────────────
si (nb_arguments() >= 1) {
  $src = lire_texte(argument(0))
  si (x_sub($src, 0, 3) == "rir") {
    $nfn = x_parse($src)
    $principal = -1
    $i = 0
    tant_que ($i < $nfn) {
      si ($x_fn[$i] == "$principal") { $principal = $i }
      $i = $i + 1
    }
    si ($principal < 0) { ecrire_bytes("/dev/stderr", "principal introuvable\n"); quitter(2) }
    $x_lst_lbl = x_new()
    $x_idx_lbl = x_new()
    $x_truth_lbl = x_new()
    $x_prim_defaut_lbl = x_new()
    $i = 0
    tant_que ($i < 14) { joindre($x_bin_lbl, x_new()); $i = $i + 1 }
    $printl = x_new()
    x_compile_fonction($principal, $principal, $printl)
    $i = 0
    tant_que ($i < $nfn) {
      si ($i != $principal) { x_compile_fonction($i, $principal, $printl) }
      $i = $i + 1
    }
    # Émet TOUS les helpers runtime dans .text.
  $h_alloc = x_new()
  $h_free = x_new()
  $h_make_str = x_new()
  $h_truth = x_new()
  $h_len = x_new()
  $h_idx = x_new()
  $h_concat = x_new()
  $h_strcmp = x_new()
  $h_sous = x_new()
  $h_list = x_new()
  $h_chaine = x_new()
  $h_entier = x_new()
  $h_joindre = x_new()
  $h_table = x_new()
  $h_inserer = x_new()
  $h_cle = x_new()
  $h_suppr = x_new()
  $h_ordre = x_new()
  $h_car = x_new()
  x_emit_alloc($h_alloc)
  x_emit_free($h_free)
  x_emit_make_str($h_make_str, $h_alloc)
  x_emit_truth($h_truth)
  x_emit_len($h_len)
  x_emit_concat($h_concat, $h_alloc)
  x_emit_strcmp($h_strcmp)
  x_emit_make_list($h_list, $h_alloc)
  x_emit_sous($h_sous, $h_make_str)
  x_emit_idx($h_idx, $h_sous)
  x_emit_chaine($h_chaine, $h_make_str)
  x_emit_entier($h_entier)
  x_emit_joindre($h_joindre, $h_alloc, $h_free)
  x_emit_table_new($h_table, $h_alloc)
  x_emit_inserer($h_inserer, $h_alloc, $h_free)
  x_emit_cle($h_cle)
  x_emit_supprimer($h_suppr)
  x_emit_ordre($h_ordre)
  x_emit_caractere($h_car, $h_make_str)
  $i = 0
  tant_que ($i < longueur($x_bin_lbl)) {
    x_emit_bin_helper($i, $x_bin_lbl[$i], $h_truth, $h_concat, $h_strcmp, $h_chaine)
    $i = $i + 1
  }
  $noms = ["longueur", "joindre", "sous_chaine", "chaine", "entier", "quitter",
           "lire_texte", "ordre", "argument", "ecrire_bytes", "inserer",
           "caractere", "nb_arguments", "table", "partie_entiere", "hasard",
           "temps", "flottant", "graine", "afficher_erreur", "supprimer",
           "ecrire_texte", "cle_existe"]
  $i = 0
  tant_que ($i < longueur($noms)) {
    $l = x_prim_lbl($noms[$i])
    x_emit_prim($noms[$i], $l)
    $i = $i + 1
  }
  x_emit_prim("non_catalogue", $x_prim_defaut_lbl)
    x_emit_print_val($printl)
    si (longueur($x_err) > 0) {
      ecrire_bytes("/dev/stderr", "X64 : " + $x_err[0] + "\n")
      quitter(2)
    }
    # .data est aligné page APRÈS .text ; calculé avant le patch des IAT.
    $text_len = x_off()
    $text_raw = partie_entiere(($text_len + 511) / 512) * 512
    $x_rva_data = partie_entiere((4096 + $text_raw + 4095) / 4096) * 4096
    $bin = x_patch()
    ecrire_bytes("/dev/stdout", pe_raw(x_pe($bin)))
    quitter(0)
  }
  ecrire_bytes("/dev/stderr", "emetteur_x64 : entrée RIR attendue\n")
  quitter(2)
}
