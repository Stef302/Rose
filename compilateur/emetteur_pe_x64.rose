  x_mark($Lshift)
  x_mem(139, 9, -24); x_cmp(9, 0)
  x_branch(141, $Lshiftend)
  x_mem(139, 0, -32)
  x_mem(139, 9, -24); x_shl_rax(4); x_add(0, 9)
  x_mem(139, 10, -32); x_shl_rax(4); x_add(10, 9)
  x_addi(11, 16)
  xb(72); xb(139); xb(4); xb(217)
  xb(73); xb(137); xb(4); xb(218)
  x_subi(9, 1)
  x_branch(233, $Lshift)
  x_mark($Lshiftend)
  x_mem(139, 0, -24)
  x_ldq_rax(10, 8)
  x_subi(10, 1)
  x_stq_rax(8, 10)
  x_movimm(0, 8)
  x_branch(233, $Lfin2)
  x_mark($Lfin)
  x_movimm(0, 0)
  x_mark($Lfin2)
