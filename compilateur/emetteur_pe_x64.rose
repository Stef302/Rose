# emetteur_pe_x64.rose — Émetteur PE32+ x86-64 (AMD64) en Rose pur, version
# NATIVE C0 (jalon §5.1 de rose/docs/RELEASE_SANS_CARGO.md).
#
# Dérivé de compilateur/emetteur_x64.rose (backend RIR → PE AMD64) avec les
# quatre correctifs mesurés dans rose/docs/J2_PE_NATIF.md et
# rose/docs/PE_X64_NATIF.md pour que l'émetteur compilé par C0 en ELF AArch64
# produise les mêmes octets que la voie interprétée :
#   1. `x_elt_ch()` — indexation BORNÉE des listes : le backend G5 natif
#      n'évalue pas `et`/`ou` en court-circuit (contrairement à Rust) ;
#   2. `u32le()` — normalisation 32 bits AVANT la décomposition : le natif
#      tronque `partie_entiere(negatif/256)` vers zéro (rel32 -44 émis
#      `d4 00 00 00` au lieu de `d4 ff ff ff`) ;
#   3. `x_imm64()` — complément à 2 par chunks 16 bits : la constante 2^64
#      est tronquée à 0 en natif (>> -47 donnait `movabsq $0xd1`) ;
#   4. `octet_brut()` + `pe_raw()` — construction du PE avec `caractere()`
#      (UTF-8 valide, `longueur()` = points de code), conversion en octets
#      bruts au dernier moment juste avant `ecrire_bytes`.
# ⚠ Le correctif 3 déclenche un bug du JIT de la graine Rust sur le programme
#   émetteur (`index sur une valeur qui n'est pas une liste`) : utiliser
#   `ROSE_SANS_JIT=1 rose interprete` pour la voie interprétée. Le C0 natif,
#   cible de ce fichier, n'est pas concerné.
#
# Chaîne (C0 = /tmp/opencode/C0_h.elf) :
#   C0 compilateur/emetteur_pe_x64.rose > emetteur_pe_x64_nat.elf
#   ./emetteur_pe_x64_nat.elf prog.rir > prog.exe
#
# Cible : x86_64-pc-windows-msvc / x86_64-pc-windows-gnu. JAMAIS i686.
# Sous-ensemble couvert (RIR) : entiers 64 bits, + - * / % ^ et comparaisons,
# variables (slots), appels de fonctions (récursion incluse, >4 arguments via
# la pile), sauts, affectations, afficher, ET les formes `s` (littéral
# chaîne), `lst` (littéral liste), `idx` (indexation) et `app` des primitives.
#
# ABI DES VALEURS (identique à celle du backend G5 aarch64, adaptée en x64) :
#   entier / booléen : n << 3        (bits bas 000)
#   chaîne           : pointeur | 1  (descripteur [1][ncp][noct][octets…])
#   liste            : pointeur | 2  (descripteur [2][len][cap][valeurs…])
#   table            : pointeur | 3  (descripteur [3][len][cap][clé,valeur…])
# Le tas est obtenu par GetProcessHeap + HeapAlloc (HeapFree est importé).
# Les descripteurs sont alignés 8 par HeapAlloc : les 3 bits bas sont libres.
#
# Writer PE32+ complet : DOS, COFF Machine=0x8664, OptionalHeader 0x20B,
# sections .text/.data/.pdata, 12 imports KERNEL32 via IAT (GetStdHandle,
# WriteFile, ExitProcess, GetProcessHeap, HeapAlloc, HeapFree, CreateFileA,
# ReadFile, CloseHandle, GetFileSize, GetCommandLineA, GetTickCount64),
# conventions MS x64 (RCX/RDX/R8/R9, shadow space, RSP aligné 16),
# RUNTIME_FUNCTION + UNWIND_INFO dans .pdata.
#
# ⚠ Wine présent ici est AARCH64 (wine-9.0, hôte aarch64) : aucun PE AMD64
#   ne peut être lancé (pas de WoW64). Validation STRUCTURELLE (file,
#   llvm-readobj, llvm-objdump) + égalité octet pour octet avec la voie
#   interprétée.

# ── Utilitaires little-endian ──────────────────────────────────────────────
fn u8le($v: entier) -> chaine {
  retour caractere($v % 256)
}
fn u16le($v: entier) -> chaine {
  $b0 = $v % 256
  $b1 = partie_entiere($v / 256) % 256
  retour caractere($b0) + caractere($b1)
}
fn u32le($v: entier) -> chaine {
  # Normalisation 32 bits AVANT la décomposition : sous le backend G5 natif,
  # `partie_entiere(negatif / 256)` tronque vers zéro au lieu de plancher,
  # ce qui donne 00 00 00 au lieu de FF FF FF pour un rel32 négatif
  # (mesuré : jmp -44 émis d4 00 00 00 au lieu de d4 ff ff ff).
  $u = $v % 4294967296
  si ($u < 0) { $u = $u + 4294967296 }
  $b0 = $u % 256
  $v1 = partie_entiere($u / 256)
  $b1 = $v1 % 256
  $v2 = partie_entiere($v1 / 256)
  $b2 = $v2 % 256
  $v3 = partie_entiere($v2 / 256)
  $b3 = $v3 % 256
  retour caractere($b0) + caractere($b1) + caractere($b2) + caractere($b3)
}
fn u64le($v: entier) -> chaine {
  $r = ""
  $u = $v
  $k = 0
  tant_que ($k < 8) {
    $r = $r + caractere($u % 256)
    $u = partie_entiere($u / 256)
    $k = $k + 1
  }
  retour $r
}

# OCTET_BRUT : sous le backend G5 natif (C0) `caractere(n)` encode un point
# de code UTF-8 (0x80 -> c2 80), ce qui corrompt l'en-tête PE. Le dispatch G5
# intercepte `octet_brut` ($g5_octetll) et écrit l'octet brut ; sous
# l'interpréteur Rust c'est équivalent à `caractere($v % 256)`.
fn octet_brut($v: entier) -> chaine {
  retour caractere($v % 256)
}

# x_elt_ch — indexation BORNÉE d'une liste de chaînes. Le backend G5 natif
# évalue `et`/`ou` AVANT de tester la première branche : une condition
# `$i < longueur(l) et l[$i] ...` déréférence `l[i]` hors bornes en fin de
# boucle (segfault mesuré sur l'émetteur PE ARM64 natif, pc 0x42d988).
fn x_elt_ch($l: liste<chaine>, $i: entier) -> chaine {
  si ($i < 0 ou $i >= longueur($l)) { retour "" }
  retour $l[$i]
}

# ── Chaînes ────────────────────────────────────────────────────────────────
fn x_pos($s: chaine, $mot: chaine) -> entier {
  $p = 0
  $ln = longueur($s)
  $lm = longueur($mot)
  si ($lm == 0) { retour 0 }
  tant_que ($p + $lm <= $ln et sous_chaine($s, $p, $p + $lm) != $mot) { $p = $p + 1 }
  si ($p + $lm > $ln) { retour -1 }
  retour $p
}
fn x_trim($s: chaine) -> chaine {
  $r = $s
  $n = longueur($r)
  tant_que ($n > 0 et sous_chaine($r, 0, 1) == " ") { $r = sous_chaine($r, 1, $n); $n = longueur($r) }
  tant_que ($n > 0 et sous_chaine($r, $n - 1, $n) == " ") { $r = sous_chaine($r, 0, $n - 1); $n = longueur($r) }
  retour $r
}
fn x_ent($s: chaine) -> entier {
  $t = x_trim($s)
  $n = longueur($t)
  si ($n == 0) { retour 0 }
  $neg = 0
  $i = 0
  si (sous_chaine($t, 0, 1) == "-") { $neg = 1; $i = 1 }
  $ok = 1
  tant_que ($i < $n) {
    $c = sous_chaine($t, $i, $i + 1)
    si ($c < "0" ou $c > "9") { $ok = 0 }
    $i = $i + 1
  }
  si ($ok == 0) { retour 0 }
  $deb = 0
  si ($neg == 1) { $deb = 1 }
  $v = entier(sous_chaine($t, $deb, $n))
  si ($neg == 1) { retour -$v }
  retour $v
}
fn x_sub($s: chaine, $a: entier, $b: entier) -> chaine {
  $n = longueur($s)
  $fin = $b
  si ($fin > $n) { $fin = $n }
  $deb = $a
  si ($deb > $n) { $deb = $n }
  si ($a < 0 ou $b < 0 ou $a > $b) { retour "" }
  retour sous_chaine($s, $deb, $fin)
}
fn x_lignes($s: chaine) -> liste<chaine> {
  $res = [0 : chaine]
  $i = 0
  $n = longueur($s)
  $deb = 0
  tant_que ($i <= $n) {
    si ($i == $n ou sous_chaine($s, $i, $i + 1) == "\n") {
      $ligne = sous_chaine($s, $deb, $i)
      $ln = longueur($ligne)
      si ($ln > 0 et sous_chaine($ligne, $ln - 1, $ln) == "\r") { $ligne = sous_chaine($ligne, 0, $ln - 1) }
      joindre($res, $ligne)
      $deb = $i + 1
    }
    $i = $i + 1
  }
  retour $res
}
fn x_nu_op($ligne: chaine) -> chaine {
  $n = longueur($ligne)
  $i = 0
  tant_que ($i < $n et sous_chaine($ligne, $i, $i + 1) == " ") { $i = $i + 1 }
  $j = 0
  tant_que ($i < $n et $j < 4 et sous_chaine($ligne, $i, $i + 1) >= "0" et sous_chaine($ligne, $i, $i + 1) <= "9") { $i = $i + 1; $j = $j + 1 }
  tant_que ($i < $n et sous_chaine($ligne, $i, $i + 1) == " ") { $i = $i + 1 }
  retour sous_chaine($ligne, $i, $n)
}
fn x_tokens($s: chaine) -> liste<chaine> {
  $r = [0 : chaine]
  $i = 0
  $n = longueur($s)
  tant_que ($i < $n) {
    $c = x_sub($s, $i, $i + 1)
    si ($c == "(" ou $c == ")") { joindre($r, $c); $i = $i + 1
    } sinon si ($c == " " ou $c == "\t") { $i = $i + 1
    } sinon si ($c == "\"") {
      $j = $i + 1
      $fin = 0
      tant_que ($j < $n et $fin == 0) {
        $d = x_sub($s, $j, $j + 1)
        si ($d == "\\") { $j = $j + 2
        } sinon si ($d == "\"") { $j = $j + 1; $fin = 1
        } sinon { $j = $j + 1 }
      }
      si ($j > $n) { $j = $n }
      joindre($r, x_sub($s, $i, $j))
      $i = $j
    } sinon {
      $j = $i
      tant_que ($j < $n et x_sub($s, $j, $j + 1) != "(" et x_sub($s, $j, $j + 1) != ")" et x_sub($s, $j, $j + 1) != " " et x_sub($s, $j, $j + 1) != "\t") { $j = $j + 1 }
      joindre($r, x_sub($s, $i, $j))
      $i = $j
    }
  }
  retour $r
}

# ── Buffer de code (listes parallèles, index 0 =入场 dummy) ─────────────────
$x_code = [0 : entier]
$x_meta = [0 : chaine]
$x_lbl = [0 : chaine]
$x_lbl_tab = table()                       # id de label -> offset (O(1))
$x_ctr = [0]
$x_err = [0 : chaine]

fn x_new() -> entier { joindre($x_ctr, 0); retour longueur($x_ctr) - 1 }
fn x_fail($m: chaine) -> entier { joindre($x_err, $m); retour -1 }
fn x_off() -> entier { retour longueur($x_code) }
fn xb($b: entier) -> entier {
  joindre($x_code, $b % 256)
  joindre($x_meta, "")
  retour 0
}
fn x_imm32($v: entier) -> entier {
  $u = $v % 4294967296
  si ($u < 0) { $u = $u + 4294967296 }
  xb($u % 256)
  xb(partie_entiere($u / 256) % 256)
  xb(partie_entiere($u / 65536) % 256)
  xb(partie_entiere($u / 16777216) % 256)
  retour 0
}
fn x_imm64($v: entier) -> entier {
  # Complément à 2 sur 64 bits CHUNK PAR CHUNK : aucune constante > 2^48
  # (l'ABI G5 n'en conserve que 61 bits ; 2^64 y devient 0).
  $u = $v
  $neg = 0
  si ($u < 0) { $neg = 1; $u = -$u }
  $c0 = $u % 65536
  $c1 = partie_entiere($u / 65536) % 65536
  $c2 = partie_entiere($u / 4294967296) % 65536
  $c3 = partie_entiere($u / 281474976710656) % 65536
  si ($neg == 1) {
    $c0 = 65536 - $c0
    $c1 = 65535 - $c1
    $c2 = 65535 - $c2
    $c3 = 65535 - $c3
    si ($c0 >= 65536) { $c0 = $c0 - 65536; $c1 = $c1 + 1 }
    si ($c1 >= 65536) { $c1 = $c1 - 65536; $c2 = $c2 + 1 }
    si ($c2 >= 65536) { $c2 = $c2 - 65536; $c3 = $c3 + 1 }
    si ($c3 >= 65536) { $c3 = $c3 - 65536 }
  }
  $k = 0
  tant_que ($k < 4) {
    $w = $c0
    si ($k == 1) { $w = $c1 }
    si ($k == 2) { $w = $c2 }
    si ($k == 3) { $w = $c3 }
    xb($w % 256)
    xb(partie_entiere($w / 256) % 256)
    $k = $k + 1
  }
  retour 0
}
fn x_mark($l: entier) -> entier {
  inserer($x_lbl_tab, $l, x_off())           # table d'indexation directe
  joindre($x_lbl, chaine($l) + "|" + chaine(x_off()))
  retour 0
}
fn x_label($l: entier) -> entier {
  si (cle_existe($x_lbl_tab, $l)) { retour x_ent(chaine($x_lbl_tab[$l])) }
  retour -1
}
# Saut rel32 : 0xE8/0xE9 (5 o) ou 0F 8x (6 o). Le champ rel32 est marqué.
fn x_branch($op2: entier, $l: entier) -> entier {
  si ($op2 == 232 ou $op2 == 233) { xb($op2)
  } sinon { xb(15); xb($op2) }
  joindre($x_code, 0)
  joindre($x_meta, "B" + chaine($l))
  $k = 0
  tant_que ($k < 3) { joindre($x_code, 0); joindre($x_meta, "s"); $k = $k + 1 }
  retour 0
}
# Appel via IAT : FF 15 disp32. Le disp32 est marqué "I<idx>".
fn x_call_iat($idx: entier) -> entier {
  xb(255); xb(21)
  joindre($x_code, 0)
  joindre($x_meta, "I" + chaine($idx))
  $k = 0
  tant_que ($k < 3) { joindre($x_code, 0); joindre($x_meta, "s"); $k = $k + 1 }
  retour 0
}

# ── Encodeurs x86-64 ───────────────────────────────────────────────────────
fn x_rex($w: entier, $r: entier, $xx: entier, $b: entier) -> entier {
  xb(64 + 8 * $w + 4 * $r + 2 * $xx + $b)
  retour 0
}
# opcode /r, reg et rm sont des registres 64 bits (mod=11).
fn x_rr($opcode: entier, $reg: entier, $rm: entier) -> entier {
  $r = 0; si ($reg >= 8) { $r = 1 }
  $b = 0; si ($rm >= 8) { $b = 1 }
  x_rex(1, $r, 0, $b)
  xb($opcode)
  xb(192 + (($reg % 8) * 8) + ($rm % 8))
  retour 0
}
# opcode /r avec adresse [rbp + disp32] (mod=10, rm=101).
fn x_mem($opcode: entier, $reg: entier, $disp: entier) -> entier {
  $r = 0; si ($reg >= 8) { $r = 1 }
  x_rex(1, $r, 0, 0)
  xb($opcode)
  xb(128 + (($reg % 8) * 8) + 5)
  x_imm32($disp)
  retour 0
}
fn x_mov($dst: entier, $src: entier) -> entier { retour x_rr(139, $dst, $src) }
fn x_add($dst: entier, $src: entier) -> entier { retour x_rr(1, $src, $dst) }
fn x_subreg($dst: entier, $src: entier) -> entier { retour x_rr(41, $src, $dst) }
fn x_cmp($a: entier, $b: entier) -> entier { retour x_rr(57, $b, $a) }
fn x_movimm($reg: entier, $v: entier) -> entier {
  $b = 0; si ($reg >= 8) { $b = 1 }
  x_rex(1, 0, 0, $b)
  xb(184 + ($reg % 8))
  x_imm64($v)
  retour 0
}
# add r64, imm8 / sub r64, imm8
fn x_addi($reg: entier, $v: entier) -> entier {
  $b = 0; si ($reg >= 8) { $b = 1 }
  x_rex(1, 0, 0, $b); xb(131); xb(192 + ($reg % 8)); xb($v % 256)
  retour 0
}
fn x_subi($reg: entier, $v: entier) -> entier {
  $b = 0; si ($reg >= 8) { $b = 1 }
  x_rex(1, 0, 0, $b); xb(131); xb(232 + ($reg % 8)); xb($v % 256)
  retour 0
}
fn x_byte_imm($disp: entier, $v: entier) -> entier {
  xb(198); xb(133); x_imm32($disp); xb($v % 256)
  retour 0
}
# ── Encodeurs supplémentaires pour le tas et les valeurs étiquetées ───────
# mov byte [rax+disp32], imm8  (C6 80 disp32 imm8)
fn x_stb_rax($disp: entier, $v: entier) -> entier {
  xb(198); xb(128); x_imm32($disp); xb($v % 256)
  retour 0
}
# mov qword [rax+disp32], reg64  (REX.W 89 /r mod=10 rm=000)
fn x_stq_rax($disp: entier, $reg: entier) -> entier {
  $r = 0; si ($reg >= 8) { $r = 1 }
  x_rex(1, $r, 0, 0); xb(137)
  xb(128 + (($reg % 8) * 8))
  x_imm32($disp)
  retour 0
}
# mov reg64, qword [rax+disp32]  (REX.W 8B /r mod=10 rm=000)
fn x_ldq_rax($reg: entier, $disp: entier) -> entier {
  $r = 0; si ($reg >= 8) { $r = 1 }
  x_rex(1, $r, 0, 0); xb(139)
  xb(128 + (($reg % 8) * 8))
  x_imm32($disp)
  retour 0
}
# shl rax, imm8 / sar rax, imm8  (REX.W C1 /4|/7)
fn x_shl_rax($n: entier) -> entier { xb(72); xb(193); xb(224); xb($n % 256); retour 0 }
fn x_sar_rax($n: entier) -> entier { xb(72); xb(193); xb(248); xb($n % 256); retour 0 }
# test al, imm8  (A8 imm8)
fn x_test_al($m: entier) -> entier { xb(168); xb($m % 256); retour 0 }
fn x_prologue($frame: entier) -> entier {
  xb(85)                     # push rbp
  xb(72); xb(137); xb(229)   # mov rbp, rsp
  xb(72); xb(129); xb(236)   # sub rsp, imm32
  x_imm32($frame)
  retour 0
}
fn x_epilogue() -> entier {
  xb(72); xb(137); xb(236)   # mov rsp, rbp
  xb(93)                     # pop rbp
  xb(195)                    # ret
  retour 0
}

# ── Layout des slots / scratch ─────────────────────────────────────────────
# slots utilisateur : [rbp-16-8k]
# scratch binaire à la profondeur d : [rbp-144-64d]
# arguments d'appel à la profondeur d, index i : [rbp-144-64d-8(i+1)]
fn x_slot_off($k: entier) -> entier { retour -(16 + 8 * $k) }
fn x_bin_off($d: entier) -> entier { retour -(144 + 64 * $d) }
fn x_arg_off($d: entier, $i: entier) -> entier { retour -(144 + 64 * $d + 8 * ($i + 1)) }
fn x_frame() -> entier { retour 688 }
$argregs = [1, 2, 8, 9]    # RCX, RDX, R8, R9

# ── État RIR ───────────────────────────────────────────────────────────────
$x_fn = [0 : chaine]
$x_fnslot = [0 : entier]
$x_fnam = [0 : chaine]
$x_fop = [0 : entier]
$x_fnop = [0 : entier]
$x_flbl = [0 : entier]
$x_endlbl = [0 : entier]
$x_fparam = [0 : entier]
$x_ops = [0 : chaine]
$x_oplbl = [0 : entier]

fn x_noms($s: chaine) -> chaine {
  $n = longueur($s)
  $p = 0
  $res = ""
  tant_que ($p < $n) {
    si (x_sub($s, $p, $p + 1) == "[") {
      $q = $p + 1
      tant_que ($q < $n et x_sub($s, $q, $q + 1) != "]") { $q = $q + 1 }
      $ix = x_sub($s, $p + 1, $q)
      $p = $q + 1
      tant_que ($p < $n et x_sub($s, $p, $p + 1) == " ") { $p = $p + 1 }
      $q = $p
      tant_que ($q < $n et x_sub($s, $q, $q + 1) != " ") { $q = $q + 1 }
      $nm = x_sub($s, $p, $q)
      si (longueur($res) > 0) { $res = $res + "|" }
      $res = $res + $ix + ":" + $nm
      $p = $q
    } sinon { $p = $p + 1 }
  }
  retour $res
}
fn x_slot_of($f: entier, $nom: chaine) -> entier {
  $t = $x_fnam[$f]
  $n = longueur($t)
  $i = 0
  tant_que ($i < $n) {
    $fin = x_pos(x_sub($t, $i, $n), "|")
    si ($fin < 0) { $fin = $n - $i }
    $ent = x_sub($t, $i, $i + $fin)
    $sep = x_pos($ent, ":")
    si ($sep >= 0) {
      si (x_sub($ent, $sep + 1, longueur($ent)) == $nom) { retour x_ent(x_sub($ent, 0, $sep)) }
    }
    $i = $i + $fin + 1
  }
  retour -1
}
fn x_func_lbl($nom: chaine) -> entier {
  $i = 0
  tant_que ($i < longueur($x_fn)) {
    si ($x_fn[$i] == $nom) { retour $x_flbl[$i] }
    $i = $i + 1
  }
  retour -1
}
fn x_cible($f: entier, $tok: chaine) -> entier {
  $c = x_ent($tok)
  si ($c >= $x_fnop[$f]) { retour $x_endlbl[$f] }
  retour $x_oplbl[$x_fop[$f] + $c]
}
fn x_cond($op: chaine) -> entier {
  # 0 = sete, 1 = setne, 4 = setl, 5 = setge, 6 = setg, 7 = setle
  si ($op == "==") { retour 148 }
  si ($op == "!=") { retour 149 }
  si ($op == "<") { retour 156 }
  si ($op == ">=") { retour 157 }
  si ($op == ">") { retour 159 }
  si ($op == "<=") { retour 158 }
  retour -1
}
fn x_jcc_cond($op: chaine) -> entier {
  # Codes 0F 8x pour l'enregistrement des conditions dans x_op.
  si ($op == "==") { retour 132 }
  si ($op == "!=") { retour 133 }
  si ($op == "<") { retour 140 }
  si ($op == ">=") { retour 141 }
  si ($op == ">") { retour 143 }
  si ($op == "<=") { retour 142 }
  retour 132
}

# ── Valeurs étiquetées : tables de dispatch et petits encodeurs ────────────
$x_lst_lbl = 0
$x_idx_lbl = 0
$x_binop_lbl = 0
$x_truth_lbl = 0
$x_prim_defaut_lbl = 0
$x_prim_inconnues = [0 : chaine]

fn x_call_lbl($l: entier) -> entier { retour x_branch(232, $l) }
# mov qword [rsp+disp32], reg64  (REX.W 89 /r, SIB=24)
fn x_stq_rsp($disp: entier, $reg: entier) -> entier {
  $r = 0; si ($reg >= 8) { $r = 1 }
  x_rex(1, $r, 0, 0); xb(137)
  xb(148 + (($reg % 8) * 8))
  xb(36)
  x_imm32($disp)
  retour 0
}
# Arguments 5..n sur la pile : [rsp+40+8*(i-4)] (shadow space = [rsp+8..39]).
fn x_charger_args($d: entier, $k: entier) -> entier {
  $i = 0
  tant_que ($i < $k et $i < 4) {
    x_mem(139, $argregs[$i], x_arg_off($d, $i))
    $i = $i + 1
  }
  tant_que ($i < $k) {
    x_mem(139, 10, x_arg_off($d, $i))
    x_stq_rsp(40 + 8 * ($i - 4), 10)
    $i = $i + 1
  }
  retour 0
}
fn x_binop_code($op: chaine) -> entier {
  si ($op == "+") { retour 0 }
  si ($op == "-") { retour 1 }
  si ($op == "*") { retour 2 }
  si ($op == "/" ou $op == "//" ou $op == "div") { retour 3 }
  si ($op == "%") { retour 4 }
  si ($op == "^") { retour 5 }
  si ($op == "==") { retour 6 }
  si ($op == "!=") { retour 7 }
  si ($op == "<") { retour 8 }
  si ($op == "<=") { retour 9 }
  si ($op == ">") { retour 10 }
  si ($op == ">=") { retour 11 }
  si ($op == "et") { retour 12 }
  si ($op == "ou") { retour 13 }
  retour -1
}
# Primitives du catalogue RIR : une étiquette émise par primitive.
$prim_longueur_lbl = 0
$prim_joindre_lbl = 0
$prim_sous_lbl = 0
$prim_chaine_lbl = 0
$prim_entier_lbl = 0
$prim_quitter_lbl = 0
$prim_lire_lbl = 0
$prim_ordre_lbl = 0
$prim_argument_lbl = 0
$prim_ecrire_lbl = 0
$prim_inserer_lbl = 0
$prim_caractere_lbl = 0
$prim_nbargs_lbl = 0
$prim_table_lbl = 0
$prim_partie_lbl = 0
$prim_hasard_lbl = 0
$prim_temps_lbl = 0
$prim_flottant_lbl = 0
$prim_graine_lbl = 0
$prim_erreur_lbl = 0
$prim_supprimer_lbl = 0
$prim_ecriretexte_lbl = 0
$prim_cleexiste_lbl = 0

fn x_prim_lbl($nom: chaine) -> entier {
  si ($nom == "longueur") { retour $prim_longueur_lbl }
  si ($nom == "joindre") { retour $prim_joindre_lbl }
  si ($nom == "sous_chaine") { retour $prim_sous_lbl }
  si ($nom == "chaine") { retour $prim_chaine_lbl }
  si ($nom == "entier") { retour $prim_entier_lbl }
  si ($nom == "quitter") { retour $prim_quitter_lbl }
  si ($nom == "lire_texte") { retour $prim_lire_lbl }
  si ($nom == "ordre") { retour $prim_ordre_lbl }
  si ($nom == "argument") { retour $prim_argument_lbl }
  si ($nom == "ecrire_bytes") { retour $prim_ecrire_lbl }
  si ($nom == "inserer") { retour $prim_inserer_lbl }
  si ($nom == "caractere") { retour $prim_caractere_lbl }
  si ($nom == "nb_arguments") { retour $prim_nbargs_lbl }
  si ($nom == "table") { retour $prim_table_lbl }
  si ($nom == "partie_entiere") { retour $prim_partie_lbl }
  si ($nom == "hasard") { retour $prim_hasard_lbl }
  si ($nom == "temps") { retour $prim_temps_lbl }
  si ($nom == "flottant") { retour $prim_flottant_lbl }
  si ($nom == "graine") { retour $prim_graine_lbl }
  si ($nom == "afficher_erreur") { retour $prim_erreur_lbl }
  si ($nom == "supprimer") { retour $prim_supprimer_lbl }
  si ($nom == "ecrire_texte") { retour $prim_ecriretexte_lbl }
  si ($nom == "cle_existe") { retour $prim_cleexiste_lbl }
  retour -1
}

# ── Évaluateur d'expressions : résultat dans RAX ───────────────────────────
fn x_eval($t: liste<chaine>, $pos: entier, $d: entier, $f: entier) -> entier {
  si (longueur($x_err) > 0) { retour -1 }
  $n = longueur($t)
  si ($pos >= $n) { retour x_fail("expression vide") }
  $tk = $t[$pos]
  si ($tk == "(") {
    $head = $t[$pos + 1]
    si ($head == "n" ou $head == "entier" ou $head == "f" ou $head == "flottant") {
      x_movimm(0, 8 * x_ent($t[$pos + 2]))   # entier étiqueté n<<3
      retour $pos + 4
    }
    si ($head == "b") {
      $v = 0
      si ($t[$pos + 2] == "vraie") { $v = 8 }  # booléen étiqueté
      x_movimm(0, $v)
      retour $pos + 3
    }
    si ($head == "s") {
      x_emit_chaine_lit($t[$pos + 2])
      retour $pos + 4
    }
    si ($head == "lst" ou $head == "liste") {
      $p = $pos + 2
      $k = 0
      tant_que ($p < $n et x_elt_ch($t, $p) != ")") {
        $p = x_eval($t, $p, $d + 1, $f)
        si ($p < 0) { retour -1 }
        x_mem(137, 0, x_bin_off($d) + 8 * $k)   # valeurs dans le scratch
        $k = $k + 1
      }
      # x_make_list : RCX = nombre d'éléments, RDX = adresse des valeurs
      x_mov(1, 9)
      x_mem(141, 2, x_bin_off($d))
      x_call_lbl($x_lst_lbl)
      retour $p + 1
    }
    si ($head == "idx") {
      $p = x_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      x_mem(137, 0, x_bin_off($d))
      $p = x_eval($t, $p, $d + 1, $f)
      si ($p < 0) { retour -1 }
      x_mov(2, 0)                              # RDX = index étiqueté
      x_mem(139, 1, x_bin_off($d))             # RCX = conteneur
      x_call_lbl($x_idx_lbl)
      retour $p + 1
    }
    si ($head == "slot") {
      x_mem(139, 0, x_slot_off(x_ent($t[$pos + 2])))
      retour $pos + 3
    }
    si ($head == "v") {
      $sl = x_slot_of($f, $t[$pos + 2])
      si ($sl < 0) { x_movimm(0, 0)
      } sinon { x_mem(139, 0, x_slot_off($sl)) }
      retour $pos + 4
    }
    si ($head == "bin") {
      $op = $t[$pos + 2]
      $code = x_binop_code($op)
      si ($code < 0) { retour x_fail("op bin non couverte : " + $op) }
      $p = x_eval($t, $pos + 3, $d + 1, $f)
      si ($p < 0) { retour -1 }
      x_mem(137, 0, x_bin_off($d))       # sauvegarde gauche
      $p = x_eval($t, $p, $d + 1, $f)
      si ($p < 0) { retour -1 }
      x_mov(2, 0)                        # RDX = droite étiquetée
      x_mem(139, 1, x_bin_off($d))       # RCX = gauche étiquetée
      x_movimm(8, $code)                 # R8 = opcode
      x_call_lbl($x_binop_lbl)
      retour $p + 1
    }
    si ($head == "app" ou $head == "appel" ou $head == "appel_rir") {
      $nom = $t[$pos + 2]
      $p = $pos + 3
      $k = 0
      tant_que ($p < $n et x_elt_ch($t, $p) != ")") {
        $p = x_eval($t, $p, $d + 1, $f)
        si ($p < 0) { retour -1 }
        x_mem(137, 0, x_arg_off($d, $k))
        $k = $k + 1
      }
      $lbl = x_func_lbl($nom)
      $prim = -1
      si ($lbl < 0) {
        $prim = x_prim_lbl($nom)
        si ($prim < 0) {
          joindre($x_prim_inconnues, $nom)
          $prim = $x_prim_defaut_lbl
        }
        $lbl = $prim
      }
      x_charger_args($d, $k)
      x_call_lbl($lbl)
      retour $p + 1
    }
    si ($head == "neg" ou $head == "uni") {
      $p = $pos + 2
      si ($head == "uni") { $p = $pos + 3 }
      $p = x_eval($t, $p, $d + 1, $f)
      si ($p < 0) { retour -1 }
      xb(72); xb(247); xb(216)           # neg rax (n<<3 -> -n<<3)
      retour $p + 1
    }
    si ($head == "non") {
      $p = x_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      x_call_lbl($x_truth_lbl)
      xb(72); xb(133); xb(192)           # test rax, rax
      xb(15); xb(148); xb(192)           # sete al
      x_shl_rax(3)                       # booléen étiqueté 0 ou 8
      retour $p + 1
    }
    retour x_fail("forme non couverte : " + $head)
  }
  si ($tk == "slot") { x_mem(139, 0, x_slot_off(x_ent($t[$pos + 1]))); retour $pos + 2 }
  si ($tk == "entier" ou $tk == "n" ou $tk == "flottant") { x_movimm(0, 8 * x_ent($t[$pos + 1])); retour $pos + 2 }
  si ($tk == "v") {
    $sl = x_slot_of($f, $t[$pos + 1])
    si ($sl < 0) { x_movimm(0, 0)
    } sinon { x_mem(139, 0, x_slot_off($sl)) }
    retour $pos + 2
  }
  si ($tk == "b") {
    $v = 0
    si ($t[$pos + 1] == "vraie") { $v = 8 }
    x_movimm(0, $v)
    retour $pos + 2
  }
  x_movimm(0, 8 * x_ent($tk))
  retour $pos + 1
}

# ── Opérations RIR ─────────────────────────────────────────────────────────
fn x_op($op: chaine, $f: entier, $principal: entier, $printl: entier) -> entier {
  $a = ""
  si (x_sub($op, 0, 12) == "affect slot ") { $a = x_trim(x_sub($op, 12, longueur($op))) }
  si (x_sub($op, 0, 16) == "affect_ast slot ") { $a = x_trim(x_sub($op, 16, longueur($op))) }
  si (longueur($a) > 0) {
    $eq = x_pos($a, "=")
    $sl = x_ent(x_sub($a, 0, $eq))
    $rhs = x_trim(x_sub($a, $eq + 1, longueur($a)))
    x_eval(x_tokens($rhs), 0, 0, $f)
    x_mem(137, 0, x_slot_off($sl))
    retour 0
  }
  $t = x_tokens($op)
  $head = $t[0]
  si ($head == "expr") { x_eval($t, 1, 0, $f); retour 0 }
  si ($head == "saut") { x_branch(233, x_cible($f, $t[1])); retour 0 }
  si ($head == "saut_si_faux" ou $head == "saut_si_faux_abstrait") {
    x_eval($t, 2, 0, $f)
    x_call_lbl($x_truth_lbl)             # vérité étiquetée (chaîne/liste/table)
    xb(72); xb(133); xb(192)             # test rax, rax
    x_branch(132, x_cible($f, $t[1]))    # je cible
    retour 0
  }
  si ($head == "bloc") { retour 0 }      # bloc RIR imbriqué : marqueur sans effet
  si ($head == "retour" ou $head == "retour_abstrait") {
    x_eval($t, 1, 0, $f)
    x_epilogue()
    retour 0
  }
  si ($head == "afficher" ou $head == "afficher_abstrait") {
    x_eval($t, 1, 0, $f)
    x_mov(1, 0)                          # RCX = valeur à afficher
    x_call_lbl($printl)
    retour 0
  }
  retour x_fail("op non couverte : " + $op)
}

fn x_compile_fonction($f: entier, $principal: entier, $printl: entier) -> entier {
  x_mark($x_flbl[$f])
  x_prologue(x_frame())
  $i = 0
  tant_que ($i < $x_fparam[$f] et $i < 4) {
    x_mem(137, $argregs[$i], x_slot_off($i))
    $i = $i + 1
  }
  $i = 0
  tant_que ($i < $x_fnop[$f]) {
    x_mark($x_oplbl[$x_fop[$f] + $i])
    x_op($x_ops[$x_fop[$f] + $i], $f, $principal, $printl)
    si (longueur($x_err) > 0) { retour -1 }
    $i = $i + 1
  }
  x_mark($x_endlbl[$f])
  si ($f == $principal) {
    xb(49); xb(201)                      # xor ecx, ecx
    x_call_iat(2)                        # ExitProcess(0)
    xb(195)                              # ret (non atteint)
  } sinon {
    x_epilogue()
  }
  retour 0
}

# print_i64 — RAX = entier signé ; WriteFile(GetStdHandle(-11), buf, len, &n, 0).
fn x_emit_print($lbl: entier) -> entier {
  $SIGN = -136
  $HANDLE = -144
  $WRITTEN = -152
  $BUFEND = -96                          # tampon 32 octets : -128..-97
  $Lz = x_new()
  $Lp = x_new()
  $Lc = x_new()
  $Lloop = x_new()
  $Ldone = x_new()
  $Lwrite = x_new()
  x_mark($lbl)
  x_prologue(x_frame())
  # r11d = 0 ; [SIGN] = 0
  xb(69); xb(49); xb(219)                # xor r11d, r11d
  x_mem(137, 11, $SIGN)
  xb(72); xb(133); xb(192)               # test rax, rax
  x_branch(132, $Lz)                     # jz zéro
  x_branch(137, $Lp)                     # jns positif
  xb(72); xb(247); xb(216)               # neg rax
  x_movimm(11, 1)
  x_mem(137, 11, $SIGN)
  x_branch(233, $Lc)
  x_mark($Lz)
  x_byte_imm($BUFEND - 1, 48)            # '0'
  x_movimm(10, 1)                        # r10 = pointeur début
  x_movimm(9, 1)                         # r9 = longueur
  x_branch(233, $Lwrite)
  x_mark($Lp)
  x_mark($Lc)
  x_mem(141, 10, $BUFEND)                # lea r10, [rbp+BUFEND]
  xb(69); xb(49); xb(201)                # xor r9d, r9d
  x_mark($Lloop)
  xb(72); xb(133); xb(192)               # test rax, rax
  x_branch(132, $Ldone)
  xb(72); xb(49); xb(210)                # xor rdx, rdx
  x_movimm(8, 10)
  xb(73); xb(247); xb(240)               # div r8
  xb(128); xb(194); xb(48)               # add dl, '0'
  x_subi(10, 1)
  xb(65); xb(136); xb(18)                # mov [r10], dl
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Ldone)
  xb(72); xb(131); xb(189); x_imm32($SIGN); xb(0)  # cmp qword [SIGN], 0
  x_branch(132, $Lwrite)
  x_subi(10, 1)
  xb(65); xb(198); xb(2); xb(45)         # mov byte [r10], 0x2D  ('-')
  x_addi(9, 1)
  x_mark($Lwrite)
  # GetStdHandle(STD_OUTPUT_HANDLE = -11)
  xb(185); xb(245); xb(255); xb(255); xb(255)      # mov ecx, -11
  x_call_iat(0)
  x_mem(137, 0, $HANDLE)
  # WriteFile(handle, r10, len, &written, NULL)
  x_mem(139, 1, $HANDLE)
  x_mov(2, 10)                           # rdx = tampon
  x_mov(8, 9)                            # r8 = longueur
  x_mem(141, 9, $WRITTEN)                # lea r9, [rbp+WRITTEN]
  xb(72); xb(199); xb(68); xb(36); xb(32); x_imm32(0)  # mov qword [rsp+32], 0
  x_call_iat(1)
  x_epilogue()
  retour 0
}

# ── Runtime des valeurs étiquetées x64 ─────────────────────────────────────
fn x_utf8_of($cp: entier) -> liste<entier> {
  $r = [0 : entier]
  si ($cp < 128) {
    joindre($r, $cp)
  } sinon si ($cp < 2048) {
    joindre($r, 192 + partie_entiere($cp / 64))
    joindre($r, 128 + ($cp % 64))
  } sinon si ($cp < 65536) {
    joindre($r, 224 + partie_entiere($cp / 4096))
    joindre($r, 128 + (partie_entiere($cp / 64) % 64))
    joindre($r, 128 + ($cp % 64))
  } sinon {
    joindre($r, 240 + partie_entiere($cp / 262144))
    joindre($r, 128 + (partie_entiere($cp / 4096) % 64))
    joindre($r, 128 + (partie_entiere($cp / 64) % 64))
    joindre($r, 128 + ($cp % 64))
  }
  retour $r
}
fn x_unescape($tok: chaine) -> chaine {
  $n = longueur($tok)
  si ($n < 2) { retour "" }
  $s = sous_chaine($tok, 1, $n - 1)
  $parts = [""]
  $i = 0
  $ln = longueur($s)
  tant_que ($i < $ln) {
    $c = sous_chaine($s, $i, $i + 1)
    si ($c == "\\") {
      $i = $i + 1
      si ($i < $ln) {
        $d = sous_chaine($s, $i, $i + 1)
        si ($d == "n") { joindre($parts, caractere(10))
        } sinon si ($d == "t") { joindre($parts, caractere(9))
        } sinon si ($d == "r") { joindre($parts, caractere(13))
        } sinon si ($d == "0") { joindre($parts, caractere(0))
        } sinon { joindre($parts, $d) }
      }
    } sinon { joindre($parts, $c) }
    $i = $i + 1
  }
  retour pe_join($parts, 1, longueur($parts))
}
# Émet le code qui construit un descripteur de chaîne pour un littéral RIR.
fn x_emit_chaine_lit($tok: chaine) -> entier {
  $s = x_unescape($tok)
  $oct = [0 : entier]
  $i = 0
  $ncp = longueur($s)
  tant_que ($i < $ncp) {
    $part = x_utf8_of(ordre(sous_chaine($s, $i, $i + 1)))
    $j = 0
    tant_que ($j < longueur($part)) { joindre($oct, $part[$j]); $j = $j + 1 }
    $i = $i + 1
  }
  $nb = longueur($oct)
  $sz = partie_entiere((24 + $nb + 7) / 8) * 8
  x_call_iat(3)                              # GetProcessHeap
  x_mov(1, 0)                                # RCX = heap
  xb(72); xb(49); xb(210)                    # xor rdx, rdx
  x_movimm(8, $sz)                           # R8 = taille
  x_call_iat(4)                              # HeapAlloc -> RAX
  x_movimm(10, 1)
  x_stq_rax(0, 10)                           # [0] = tag 1
  x_movimm(10, $ncp)
  x_stq_rax(8, 10)                           # [8] = points de code
  x_movimm(10, $nb)
  x_stq_rax(16, 10)                          # [16] = octets
  $k = 0
  tant_que ($k < $nb) { x_stb_rax(24 + $k, $oct[$k]); $k = $k + 1 }
  xb(72); xb(131); xb(200); xb(1)            # or rax, 1
  retour 0
}
# x_alloc(RCX = taille) -> RAX = pointeur brut aligné 8
fn x_emit_alloc($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_mem(137, 1, -8)                          # sauvegarde taille
  x_call_iat(3)                              # GetProcessHeap
  x_mov(1, 0)
  xb(72); xb(49); xb(210)
  x_mem(139, 8, -8)
  x_call_iat(4)                              # HeapAlloc
  x_epilogue()
  retour 0
}
# x_free(RCX = pointeur) -> vide
fn x_emit_free($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_mem(137, 1, -8)
  x_call_iat(3)
  x_mov(1, 0)
  x_mov(2, 0)                                # dwFlags = 0
  x_mem(139, 8, -8)
  x_call_iat(5)                              # HeapFree
  x_epilogue()
  retour 0
}
# x_make_str(RCX=src, RDX=ncp, R8=noct) -> RAX = chaîne étiquetée
fn x_emit_make_str($lbl: entier, $alloc: entier) -> entier {
  x_mark($lbl)
  x_prologue(80)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mem(137, 8, -24)
  x_mov(0, 8)
  x_mem(139, 10, -24)
  x_add(0, 10)                               # 8 + noct
  x_addi(0, 7)
  xb(72); xb(131); xb(224); xb(248)          # and rax, -8
  x_mem(137, 0, -32)
  x_mem(139, 1, -32)
  x_call_lbl($alloc)
  x_mem(137, 0, -40)                         # descripteur
  x_movimm(10, 1)
  x_stq_rax(0, 10)
  x_mem(139, 10, -16)
  x_stq_rax(8, 10)
  x_mem(139, 10, -24)
  x_stq_rax(16, 10)
  x_movimm(9, 0)                             # i = 0
  $Lloop = x_new()
  $Ldone = x_new()
  x_mark($Lloop)
  x_mem(139, 10, -24)
  x_cmp(9, 10)
  x_branch(131, $Ldone)                      # jae
  # r10b = [src + i]
  xb(70); xb(138); xb(20); xb(24)            # mov r10b, [rcx+r9]
  # [dst + 24 + i] = r10b
  xb(70); xb(136); xb(84); xb(8); xb(24)     # mov [rax+r9+24], r10b  (disp8 24)
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Ldone)
  x_mem(139, 0, -40)
  xb(72); xb(131); xb(200); xb(1)            # or rax, 1
  x_epilogue()
  retour 0
}
# x_truth(RAX) -> RAX = 0 ou 8
fn x_emit_truth($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_mem(137, 0, -8)
  x_mov(10, 0)
  xb(73); xb(131); xb(226); xb(7)            # and r10, 7
  $Lint = x_new()
  $Lstr = x_new()
  $Llst = x_new()
  $Ltab = x_new()
  $Lvrai = x_new()
  $Lfaux = x_new()
  $Lfin_truth = x_new()
  xb(77); xb(131); xb(250); xb(0)            # cmp r10b, 0
  x_branch(132, $Lint)
  xb(77); xb(131); xb(250); xb(1)
  x_branch(132, $Lstr)
  xb(77); xb(131); xb(250); xb(2)
  x_branch(132, $Llst)
  xb(77); xb(131); xb(250); xb(3)
  x_branch(132, $Ltab)
  x_branch(233, $Lfaux)
  x_mark($Lint)
  x_mem(139, 0, -8)
  xb(72); xb(133); xb(192)
  x_branch(132, $Lfaux)
  x_branch(233, $Lvrai)
  x_mark($Lstr)
  x_mem(139, 0, -8)
  xb(72); xb(131); xb(224); xb(248)          # and rax, -8
  x_ldq_rax(0, 8)
  xb(72); xb(133); xb(192)
  x_branch(132, $Lfaux)
  x_branch(233, $Lvrai)
  x_mark($Llst)
  x_mem(139, 0, -8)
  xb(72); xb(131); xb(224); xb(248)
  x_ldq_rax(0, 8)
  xb(72); xb(133); xb(192)
  x_branch(132, $Lfaux)
  x_branch(233, $Lvrai)
  x_mark($Ltab)
  x_mem(139, 0, -8)
  xb(72); xb(131); xb(224); xb(248)
  x_ldq_rax(0, 8)
  xb(72); xb(133); xb(192)
  x_branch(132, $Lfaux)
  x_mark($Lvrai)
  x_movimm(0, 8)
  x_branch(233, $Lfin_truth)
  x_mark($Lfaux)
  x_movimm(0, 0)
  x_mark($Lfin_truth)
  x_epilogue()
  retour 0
}
# x_len(RAX) -> RAX = longueur étiquetée (ncp / len / 0)
fn x_emit_len($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_mem(137, 0, -8)
  x_mov(10, 0)
  xb(73); xb(131); xb(226); xb(7)
  $Lp = x_new()
  $Lz = x_new()
  $Lf = x_new()
  xb(77); xb(131); xb(250); xb(0)
  x_branch(132, $Lz)
  x_mark($Lp)
  x_mem(139, 0, -8)
  xb(72); xb(131); xb(224); xb(248)
  x_ldq_rax(0, 8)
  x_shl_rax(3)
  x_branch(233, $Lf)
  x_mark($Lz)
  x_movimm(0, 0)
  x_mark($Lf)
  x_epilogue()
  retour 0
}

# x_make_list(RCX=count, RDX=src) -> RAX = liste étiquetée
fn x_emit_make_list($lbl: entier, $alloc: entier) -> entier {
  x_mark($lbl)
  x_prologue(96)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mem(139, 1, -8)
  x_addi(0, 8)                               # capacité = count + 8
  x_mem(137, 0, -24)
  x_mov(1, 0)
  x_call_lbl($alloc)                         # descripteur 32 octets
  x_mem(137, 0, -32)
  x_mem(139, 0, -24)
  x_shl_rax(3)
  x_mem(137, 0, -40)
  x_mem(139, 1, -40)
  x_call_lbl($alloc)                         # tableau de valeurs
  x_mem(137, 0, -48)
  x_mem(139, 0, -32)
  x_movimm(10, 2)
  x_stq_rax(0, 10)
  x_mem(139, 10, -8)
  x_stq_rax(8, 10)
  x_mem(139, 10, -24)
  x_stq_rax(16, 10)
  x_mem(139, 10, -48)
  x_stq_rax(24, 10)
  x_movimm(9, 0)
  $Lloop = x_new()
  $Ldone = x_new()
  x_mark($Lloop)
  x_mem(139, 10, -8)
  x_cmp(9, 10)
  x_branch(131, $Ldone)
  xb(78); xb(139); xb(20); xb(202)           # mov r10, [rdx+r9*8]
  x_mem(139, 0, -48)
  xb(78); xb(137); xb(20); xb(200)           # mov [rax+r9*8], r10
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Ldone)
  x_mem(139, 0, -32)
  xb(72); xb(131); xb(200); xb(2)            # or rax, 2
  x_epilogue()
  retour 0
}
# x_concat(RCX, RDX) -> RAX = concaténation de deux chaînes étiquetées
fn x_emit_concat($lbl: entier, $alloc: entier) -> entier {
  x_mark($lbl)
  x_prologue(96)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  # noct1 / noct2
  x_mov(10, 1); xb(72); xb(131); xb(226); xb(248); x_ldq_rax(10, 16)
  x_mem(137, 10, -24)
  x_mov(10, 2); xb(72); xb(131); xb(226); xb(248); x_ldq_rax(10, 16)
  x_mem(137, 10, -32)
  x_mov(0, 8)
  x_mem(139, 10, -24); x_add(0, 10)
  x_mem(139, 10, -32); x_add(0, 10)
  x_addi(0, 7)
  xb(72); xb(131); xb(224); xb(248)
  x_mem(137, 0, -40)
  x_mem(139, 1, -40)
  x_call_lbl($alloc)
  x_mem(137, 0, -48)                         # descripteur
  x_movimm(10, 1); x_stq_rax(0, 10)
  x_mem(139, 10, -24); x_mem(139, 10, -32); x_add(10, 10)
  x_stq_rax(8, 10)
  x_stq_rax(16, 10)
  # src1 = (rcx & -8) + 24
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248); x_addi(1, 24)
  x_mem(137, 1, -56)
  x_mem(139, 2, -16); xb(72); xb(131); xb(226); xb(248); x_addi(2, 24)
  x_mem(137, 2, -64)
  x_mem(139, 0, -48); x_addi(0, 24)
  x_mem(137, 0, -72)
  $Lloop1 = x_new()
  $Lnxt1 = x_new()
  $Lloop2 = x_new()
  $Ldone = x_new()
  x_movimm(9, 0)
  x_mark($Lloop1)
  x_mem(139, 10, -24); x_cmp(9, 10)
  x_branch(131, $Lnxt1)
  xb(70); xb(138); xb(20); xb(25)            # r10b = [rcx+r9]
  x_mem(139, 0, -72)
  xb(70); xb(136); xb(20); xb(8)             # [rax+r9] = r10b
  x_addi(9, 1)
  x_branch(233, $Lloop1)
  x_mark($Lnxt1)
  x_mem(139, 0, -72)
  x_mem(139, 10, -24); x_add(0, 10)
  x_mem(137, 0, -72)
  x_movimm(9, 0)
  x_mark($Lloop2)
  x_mem(139, 10, -32); x_cmp(9, 10)
  x_branch(131, $Ldone)
  xb(71); xb(138); xb(20); xb(26)            # r10b = [rdx+r9]
  x_mem(139, 0, -72)
  xb(70); xb(136); xb(20); xb(8)
  x_addi(9, 1)
  x_branch(233, $Lloop2)
  x_mark($Ldone)
  x_mem(139, 0, -48)
  xb(72); xb(131); xb(200); xb(1)
  x_epilogue()
  retour 0
}
# x_strcmp(RCX, RDX) -> RAX = différence brute (0 = égaux, signe = ordre)
fn x_emit_strcmp($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mov(10, 1); xb(72); xb(131); xb(226); xb(248); x_ldq_rax(10, 16)
  x_mem(137, 10, -24)
  x_mov(10, 2); xb(72); xb(131); xb(226); xb(248); x_ldq_rax(10, 16)
  x_mem(137, 10, -32)
  x_mem(139, 1, -8); xb(72); xb(131); xb(233); xb(248); x_addi(1, 24)
  x_mem(137, 1, -40)
  x_mem(139, 2, -16); xb(72); xb(131); xb(226); xb(248); x_addi(2, 24)
  x_mem(137, 2, -48)
  x_movimm(9, 0)
  $Lloop = x_new()
  $Ldiff = x_new()
  $Lfin = x_new()
  x_mark($Lloop)
  $Lfin2 = x_new()
  x_mem(139, 10, -24); x_cmp(9, 10)
  x_branch(131, $Lfin)
  x_mem(139, 10, -32); x_cmp(9, 10)
  x_branch(131, $Lfin)
  xb(70); xb(15); xb(182); xb(20); xb(25)    # movzx r10, byte [rcx+r9]
  xb(71); xb(15); xb(182); xb(28); xb(10)    # movzx r11, byte [rdx+r9]
  x_cmp(10, 11)
  x_branch(133, $Ldiff)
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Ldiff)
  x_mov(0, 10)
  x_subreg(0, 11)
  x_branch(233, $Lfin2)
  x_mark($Lfin)
  x_mem(139, 10, -24)
  x_mem(139, 11, -32)
  x_subreg(0, 11)
  x_mark($Lfin2)
  x_epilogue()
  retour 0
}

fn x_cond_code($code: entier) -> entier {
  si ($code == 6) { retour 148 }
  si ($code == 7) { retour 149 }
  si ($code == 8) { retour 156 }
  si ($code == 9) { retour 158 }
  si ($code == 10) { retour 159 }
  si ($code == 11) { retour 157 }
  retour 132
}
# x_bin_helper(RCX, RDX) -> RAX : une étiquette émise par opcode.
fn x_emit_bin_helper($code: entier, $lbl: entier, $truth: entier, $concat: entier, $strcmp: entier, $chaine: entier) -> entier {
  x_mark($lbl)
  x_prologue(80)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  $Lfin = x_new()
  $Llog = x_new()
  $Lstr = x_new()
  $Lint = x_new()
  $Lconcat = x_new()
  $Lcl = x_new()
  $Lcr = x_new()
  $Lpw = x_new()
  $Lpwe = x_new()
  si ($code == 12 ou $code == 13) {
    x_branch(233, $Llog)
  } sinon si ($code >= 6) {
    x_mov(10, 1); xb(73); xb(131); xb(226); xb(7)
    x_cmp(10, 1)
    x_branch(133, $Lint)
    x_mov(10, 2); xb(73); xb(131); xb(226); xb(7)
    x_cmp(10, 1)
    x_branch(133, $Lint)
    x_mem(139, 1, -8)
    x_mov(2, 1)
    x_call_lbl($strcmp)
    x_branch(233, $Lstr)
  } sinon si ($code == 0) {
    x_mov(10, 1); xb(73); xb(131); xb(226); xb(7)
    x_cmp(10, 1)
    x_branch(132, $Lconcat)
    x_mov(10, 2); xb(73); xb(131); xb(226); xb(7)
    x_cmp(10, 1)
    x_branch(132, $Lconcat)
    x_branch(233, $Lint)
  } sinon {
    x_branch(233, $Lint)
  }
  x_mark($Lconcat)
  x_mem(139, 1, -8)
  x_mov(2, 1); xb(73); xb(131); xb(226); xb(7)
  x_cmp(2, 1)
  x_branch(132, $Lcl)
  x_call_lbl($chaine)
  x_mem(137, 0, -8)
  x_mark($Lcl)
  x_mem(139, 2, -16)
  x_mov(2, 1); xb(73); xb(131); xb(226); xb(7)
  x_cmp(2, 1)
  x_branch(132, $Lcr)
  x_call_lbl($chaine)
  x_mem(137, 0, -16)
  x_mark($Lcr)
  x_mem(139, 1, -8)
  x_mov(2, 1)
  x_call_lbl($concat)
  x_branch(233, $Lfin)
  x_mark($Lstr)
  xb(72); xb(133); xb(192)                   # test rax, rax
  $ccs = x_cond_code($code)
  xb(15); xb($ccs); xb(192)                  # setcc al
  xb(15); xb(182); xb(192)                   # movzx rax, al
  x_shl_rax(3)
  x_branch(233, $Lfin)
  x_mark($Lint)
  x_mem(139, 0, -8)
  x_sar_rax(3)
  x_mem(139, 10, -16)
  xb(73); xb(131); xb(250); xb(3)
  si ($code == 0) { x_add(0, 10)
  } sinon si ($code == 1) { x_subreg(0, 10)
  } sinon si ($code == 2) { xb(73); xb(15); xb(175); xb(194)
  } sinon si ($code == 3) { xb(72); xb(153); xb(73); xb(247); xb(250)
  } sinon si ($code == 4) { xb(72); xb(153); xb(73); xb(247); xb(250); x_mov(0, 2)
  } sinon si ($code == 5) {
    x_movimm(11, 1)
    x_mark($Lpw)
    x_cmp(10, 0)
    x_branch(142, $Lpwe)                     # jle
    xb(76); xb(15); xb(175); xb(216)         # imul r11, rax
    x_subi(10, 1)
    x_branch(233, $Lpw)
    x_mark($Lpwe)
    x_mov(0, 11)
  } sinon {
    x_cmp(0, 10)
    $cci = x_cond_code($code)
    xb(15); xb($cci); xb(192)
    xb(15); xb(182); xb(192)
    x_shl_rax(3)
    x_branch(233, $Lfin)
  }
  si ($code < 6) { x_shl_rax(3) }
  x_branch(233, $Lfin)
  x_mark($Llog)
  x_mem(139, 1, -8)
  x_call_lbl($truth)
  x_mem(137, 0, -56)
  x_mem(139, 2, -16)
  x_mem(139, 1, -8)
  x_call_lbl($truth)
  x_mem(137, 0, -64)
  x_mem(139, 0, -56)
  x_mem(139, 9, -64)
  si ($code == 12) { x_rr(33, 9, 0) } sinon { x_rr(9, 9, 0) }
  xb(133); xb(192)
  x_shl_rax(3)
  x_mark($Lfin)
  x_epilogue()
  retour 0
}

# x_sous(RCX=chaîne, RDX=a, R8=b) -> RAX = sous-chaîne (indices en points de code)
fn x_emit_sous($lbl: entier, $make_str: entier) -> entier {
  x_mark($lbl)
  x_prologue(112)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mem(137, 8, -24)
  $Lca = x_new()
  $Lca2 = x_new()
  $Lcb2 = x_new()
  $Lcb3 = x_new()
  $Lscan = x_new()
  $Lone = x_new()
  $Ltwo = x_new()
  $Lthree = x_new()
  $Lfour = x_new()
  $Lnextcp = x_new()
  $Lseto1 = x_new()
  $Lscanend = x_new()
  $Lo1ok = x_new()
  $Lo2ok = x_new()
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_mem(137, 0, -32)                         # descripteur
  x_ldq_rax(10, 8); x_mem(137, 10, -40)      # ncp
  x_ldq_rax(10, 16); x_mem(137, 10, -48)     # noct
  x_mem(139, 2, -16); x_sar_rax(3); x_mem(137, 0, -56)   # a
  x_mem(139, 8, -24); x_sar_rax(3); x_mem(137, 0, -64)   # b
  x_mem(139, 0, -56)
  xb(72); xb(133); xb(192)
  x_branch(141, $Lca)                        # a >= 0
  x_movimm(0, 0); x_mem(137, 0, -56)
  x_mark($Lca)
  x_mem(139, 0, -56); x_mem(139, 10, -40)
  x_cmp(0, 10)
  x_branch(142, $Lca2)
  x_mem(139, 10, -40); x_mem(137, 0, -56)
  x_mark($Lca2)
  x_mem(139, 0, -64); x_mem(139, 10, -40)
  x_cmp(0, 10)
  x_branch(142, $Lcb2)
  x_mem(139, 10, -40); x_mem(137, 0, -64)
  x_mark($Lcb2)
  x_mem(139, 0, -64); x_mem(139, 10, -56)
  x_cmp(0, 10)
  x_branch(141, $Lcb3)
  x_mem(139, 10, -56); x_mem(137, 0, -64)
  x_mark($Lcb3)
  x_mem(139, 0, -32); x_addi(0, 24); x_mem(137, 0, -88)
  x_movimm(9, 0)                             # octet courant
  x_movimm(10, 0)                            # point de code courant
  x_movimm(11, 0)                            # o1
  x_mem(137, 11, -72)
  x_mark($Lscan)
  x_mem(139, 0, -48); x_cmp(9, 0)
  x_branch(131, $Lscanend)                   # i >= noct
  x_mem(139, 0, -64); x_cmp(10, 0)
  x_branch(131, $Lscanend)                   # cp >= b
  x_mem(139, 0, -56); x_cmp(10, 0)
  x_branch(133, $Lseto1)
  x_mem(139, 9, -72); x_mem(137, 11, -72)
  x_mark($Lseto1)
  x_mem(139, 9, -88)
  xb(70); xb(138); xb(20); xb(25)            # r10b = octet de tête
  x_mov(2, 10); xb(72); xb(131); xb(226); xb(248)
  x_cmp(2, 240)
  x_branch(141, $Lfour)
  x_cmp(2, 224)
  x_branch(141, $Lthree)
  x_cmp(2, 192)
  x_branch(141, $Ltwo)
  x_branch(233, $Lone)
  x_mark($Lfour); x_addi(9, 4); x_branch(233, $Lnextcp)
  x_mark($Lthree); x_addi(9, 3); x_branch(233, $Lnextcp)
  x_mark($Ltwo); x_addi(9, 2); x_branch(233, $Lnextcp)
  x_mark($Lone); x_addi(9, 1)
  x_mark($Lnextcp)
  x_addi(10, 1)
  x_branch(233, $Lscan)
  x_mark($Lscanend)
  x_mem(139, 10, -56)
  x_cmp(10, 0)
  x_branch(141, $Lo1ok)
  x_mem(139, 0, -48); x_mem(137, 11, -72)
  x_mark($Lo1ok)
  x_mem(139, 10, -64)
  x_cmp(10, 0)
  x_mem(139, 9, -80)
  x_branch(142, $Lo2ok)
  x_mem(139, 0, -48); x_mem(137, 11, -80)
  x_mark($Lo2ok)
  x_mem(139, 0, -88); x_mem(139, 11, -72); x_add(0, 11)
  x_mem(137, 0, -96)
  x_mem(139, 10, -64); x_mem(139, 11, -56); x_subreg(10, 11)
  x_mem(137, 10, -104)
  x_mem(139, 11, -80); x_mem(139, 10, -72); x_subreg(11, 10)
  x_mem(137, 11, -112)
  x_mem(139, 1, -96)
  x_mem(139, 2, -104)
  x_mem(139, 8, -112)
  x_call_lbl($make_str)
  x_epilogue()
  retour 0
}

# x_idx(RCX=conteneur, RDX=index) -> RAX = élément étiqueté
fn x_emit_idx($lbl: entier, $sous: entier) -> entier {
  x_mark($lbl)
  x_prologue(80)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mov(10, 1); xb(73); xb(131); xb(226); xb(7)
  $Llist = x_new()
  $Ltab = x_new()
  $Lstr = x_new()
  $Lzero = x_new()
  $Lfin = x_new()
  $Ltloop = x_new()
  $Ltfound = x_new()
  x_cmp(10, 2); x_branch(132, $Llist)
  x_cmp(10, 3); x_branch(132, $Ltab)
  x_cmp(10, 1); x_branch(132, $Lstr)
  x_branch(233, $Lzero)
  x_mark($Llist)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_mem(137, 0, -24)
  x_ldq_rax(10, 8); x_mem(137, 10, -32)      # len
  x_mem(139, 2, -16); x_sar_rax(3); x_mem(137, 0, -40)   # i
  x_mem(139, 0, -40)
  xb(72); xb(133); xb(192)
  x_branch(141, $Lzero)
  x_mem(139, 0, -40); x_mem(139, 10, -32)
  x_cmp(0, 10)
  x_branch(141, $Lzero)
  x_ldq_rax(0, 24)
  x_mem(139, 9, -40)
  xb(74); xb(139); xb(4); xb(200)            # mov rax, [rax+r9*8]
  x_branch(233, $Lfin)
  x_mark($Ltab)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_mem(137, 0, -24)
  x_ldq_rax(10, 8); x_mem(137, 10, -32)
  x_ldq_rax(0, 24); x_mem(137, 0, -48)
  x_movimm(9, 0)
  x_mark($Ltloop)
  x_mem(139, 9, -32); x_cmp(9, 0)
  x_branch(141, $Lzero)
  x_mem(139, 0, -48)
  xb(74); xb(139); xb(4); xb(136)            # mov rax, [rax+r9*16]
  x_mem(139, 10, -16)
  x_cmp(0, 10)
  x_branch(132, $Ltfound)
  x_addi(9, 1)
  x_branch(233, $Ltloop)
  x_mark($Ltfound)
  x_mem(139, 0, -48)
  xb(74); xb(139); xb(68); xb(136); xb(8)    # mov rax, [rax+r9*16+8]
  x_branch(233, $Lfin)
  x_mark($Lstr)
  x_mem(139, 2, -16); x_sar_rax(3); x_mem(137, 0, -40)
  x_mem(139, 0, -40)
  x_shl_rax(3)
  x_mov(2, 0)                            # a = i << 3
  x_addi(2, 8)                           # b = (i+1) << 3
  x_mov(8, 2)                            # R8 = b
  x_mem(139, 1, -8)
  x_mov(1, 0)                            # RCX = chaîne
  x_call_lbl($sous)
  x_branch(233, $Lfin)
  x_mark($Lzero)
  x_movimm(0, 0)
  x_mark($Lfin)
  x_epilogue()
  retour 0
}
# x_chaine(RCX) -> RAX = chaîne étiquetée
fn x_emit_chaine($lbl: entier, $make_str: entier) -> entier {
  x_mark($lbl)
  x_prologue(176)
  x_mem(137, 1, -8)
  x_mov(10, 1); xb(73); xb(131); xb(226); xb(7)
  x_cmp(10, 1)
  $Lent = x_new()
  $Lfmt = x_new()
  $Lz = x_new()
  $Lp = x_new()
  $Lloop = x_new()
  $Ldone = x_new()
  $Lfin = x_new()
  $Lfinfmt = x_new()
  x_branch(133, $Lent)
  x_mem(139, 1, -8)
  x_branch(233, $Lfin)
  x_mark($Lent)
  x_mem(139, 1, -8); x_sar_rax(3)
  x_mem(137, 0, -24)
  x_movimm(10, 0)
  x_mem(137, 10, -32)                        # signe
  xb(72); xb(133); xb(192)
  x_branch(132, $Lz)
  x_branch(137, $Lp)
  xb(72); xb(247); xb(216)
  x_movimm(10, 1)
  x_mem(137, 10, -32)
  x_branch(233, $Lfmt)
  x_mark($Lz)
  x_byte_imm(-97, 48)
  x_movimm(10, 1)
  x_movimm(9, 1)
  x_branch(233, $Lfinfmt)
  x_mark($Lp)
  x_mark($Lfmt)
  x_mem(141, 10, -96)
  x_movimm(9, 0)
  x_mark($Lloop)
  x_mem(139, 0, -24)
  xb(72); xb(133); xb(192)
  x_branch(132, $Ldone)
  x_movimm(8, 10)
  xb(73); xb(247); xb(240)
  xb(128); xb(194); xb(48)
  x_subi(10, 1)
  xb(65); xb(136); xb(18)
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Ldone)
  x_mem(139, 10, -32)
  x_cmp(10, 0)
  x_branch(132, $Lfinfmt)
  x_subi(10, 1)
  xb(65); xb(198); xb(2); xb(45)
  x_addi(9, 1)
  x_mark($Lfinfmt)
  x_mem(139, 1, -8)
  x_mov(0, 10)
  x_mov(2, 9)
  x_call_lbl($make_str)
  x_mark($Lfin)
  x_epilogue()
  retour 0
}
# x_entier(RCX) -> RAX = entier étiqueté
fn x_emit_entier($lbl: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_mem(137, 1, -8)
  $Lparse = x_new()
  $Lfin = x_new()
  $Lloop = x_new()
  $Lacc = x_new()
  $Lneg = x_new()
  $Lfin2 = x_new()
  x_mov(10, 1); xb(73); xb(131); xb(226); xb(7)
  x_cmp(10, 0)
  x_branch(133, $Lparse)
  x_mem(139, 1, -8)
  x_branch(233, $Lfin)
  x_mark($Lparse)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_addi(0, 24); x_mem(137, 0, -16)          # données
  x_ldq_rax(10, 16); x_mem(137, 10, -24)     # noct
  x_movimm(9, 0)
  x_movimm(0, 0)
  x_movimm(10, 0)                            # signe
  x_mem(139, 9, -16)
  xb(70); xb(15); xb(182); xb(20); xb(25)
  x_cmp(10, 45)
  x_branch(133, $Lloop)
  x_movimm(10, 1)
  x_addi(9, 1)
  x_mark($Lloop)
  x_mem(139, 9, -24); x_cmp(9, 0)
  x_branch(141, $Lfin)
  x_mem(139, 9, -16)
  xb(70); xb(15); xb(182); xb(28); xb(25)    # movzx r11, byte [rsi+r9]
  x_subi(11, 48)
  x_cmp(11, 9)
  x_branch(143, $Lfin)
  x_movimm(8, 10)
  xb(72); xb(107); xb(192); xb(10)           # imul rax, 10
  x_add(0, 11)
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Lfin)
  x_mem(139, 10, -8)
  xb(73); xb(131); xb(226); xb(7)
  x_cmp(10, 1)
  x_branch(133, $Lfin2)
  xb(72); xb(247); xb(216)                   # neg rax
  x_mark($Lfin2)
  x_shl_rax(3)
  x_epilogue()
  retour 0
}

# x_joindre(RCX=liste, RDX=valeur) -> RAX = vide étiqueté
fn x_emit_joindre($lbl: entier, $alloc: entier, $free: entier) -> entier {
  x_mark($lbl)
  x_prologue(96)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_mem(137, 0, -24)                         # descripteur
  x_ldq_rax(10, 8); x_mem(137, 10, -32)      # len
  x_ldq_rax(10, 16); x_mem(137, 10, -40)     # cap
  x_ldq_rax(0, 24); x_mem(137, 0, -48)       # tableau
  x_mem(139, 10, -32); x_mem(139, 11, -40)
  x_cmp(10, 11)
  $Lgrow = x_new()
  $Lstore = x_new()
  $Lfin = x_new()
  $Lcopy = x_new()
  $Lcopyend = x_new()
  x_branch(141, $Lgrow)
  x_branch(233, $Lstore)
  x_mark($Lgrow)
  x_mem(139, 11, -40)
  x_add(11, 11)                              # nouvelle capacité = 2*cap
  x_mem(137, 11, -56)
  x_shl_rax(3)
  x_mem(137, 0, -64)
  x_mem(139, 1, -64)
  x_call_lbl($alloc)
  x_mem(137, 0, -72)                         # nouveau tableau
  x_movimm(9, 0)
  x_mark($Lcopy)
  x_mem(139, 9, -32); x_cmp(9, 0)
  x_branch(141, $Lcopyend)
  x_mem(139, 0, -48)
  xb(78); xb(139); xb(20); xb(202)           # r10 = [vieux + r9*8]
  x_mem(139, 0, -72)
  xb(79); xb(137); xb(20); xb(203)           # [neuf + r9*8] = r10
  x_addi(9, 1)
  x_branch(233, $Lcopy)
  x_mark($Lcopyend)
  x_mem(139, 0, -24); x_mem(139, 10, -72); x_stq_rax(24, 10)
  x_mem(139, 10, -56); x_stq_rax(16, 10)
  x_mem(139, 1, -48)
  x_call_lbl($free)
  x_mem(139, 10, -72); x_mem(137, 11, -48)
  x_mark($Lstore)
  x_mem(139, 0, -48)
  x_mem(139, 9, -32)
  xb(74); xb(137); xb(20); xb(200)           # [tableau + r9*8] = valeur
  x_mem(139, 10, -32)
  x_addi(10, 1)
  x_mem(139, 0, -24); x_stq_rax(8, 10)
  x_movimm(0, 0)
  x_mark($Lfin)
  x_epilogue()
  retour 0
}
# x_table() -> RAX = table vide étiquetée
fn x_emit_table_new($lbl: entier, $alloc: entier) -> entier {
  x_mark($lbl)
  x_prologue(64)
  x_movimm(1, 32)
  x_call_lbl($alloc)
  x_mem(137, 0, -8)
  x_movimm(1, 128)
  x_call_lbl($alloc)
  x_mem(137, 0, -16)
  x_mem(139, 0, -8)
  x_movimm(10, 3); x_stq_rax(0, 10)
  x_movimm(10, 0); x_stq_rax(8, 10)
  x_movimm(10, 8); x_stq_rax(16, 10)
  x_mem(139, 10, -16); x_stq_rax(24, 10)
  x_mem(139, 0, -8)
  xb(72); xb(131); xb(200); xb(3)
  x_epilogue()
  retour 0
}
# x_inserer(RCX=table, RDX=clé, R8=valeur) -> RAX = vide étiqueté
fn x_emit_inserer($lbl: entier, $alloc: entier, $free: entier) -> entier {
  x_mark($lbl)
  x_prologue(96)
  x_mem(137, 1, -8)
  x_mem(137, 2, -16)
  x_mem(137, 8, -24)
  x_mem(139, 1, -8); xb(72); xb(131); xb(225); xb(248)
  x_mem(137, 0, -32)
  x_ldq_rax(10, 8); x_mem(137, 10, -40)
  x_ldq_rax(10, 16); x_mem(137, 10, -48)
  x_ldq_rax(0, 24); x_mem(137, 0, -56)
  x_movimm(9, 0)
  $Lloop = x_new()
  $Lfound = x_new()
  $Ladd = x_new()
  $Lfin = x_new()
  $Lgrow = x_new()
  $Lstore = x_new()
  $Lcopy = x_new()
  $Lcopyend = x_new()
  x_mark($Lloop)
  x_mem(139, 9, -40); x_cmp(9, 0)
  x_branch(141, $Ladd)
  x_mem(139, 0, -56)
  xb(74); xb(139); xb(4); xb(136)            # clé = [paires + r9*16]
  x_mem(139, 10, -16)
  x_cmp(0, 10)
  x_branch(132, $Lfound)
  x_addi(9, 1)
  x_branch(233, $Lloop)
  x_mark($Lfound)
  x_mem(139, 0, -56)
  x_mem(139, 9, -40)
  x_mem(139, 8, -24)
  xb(74); xb(137); xb(68); xb(136); xb(8)    # [paires + r9*16+8] = valeur
  x_branch(233, $Lfin)
  x_mark($Ladd)
  x_mem(139, 10, -40); x_mem(139, 11, -48)
  x_cmp(10, 11)
  x_branch(141, $Lgrow)
  x_branch(233, $Lstore)
  x_mark($Lgrow)
  x_mem(139, 11, -48); x_add(11, 11); x_mem(137, 11, -64)
  x_mem(139, 11, -64); x_shl_rax(4); x_mem(137, 0, -72)
  x_mem(139, 1, -72); x_call_lbl($alloc); x_mem(137, 0, -80)
  x_movimm(9, 0)
  x_mark($Lcopy)
  x_mem(139, 9, -40); x_shl_rax(4); x_mem(137, 0, -88)
  x_mem(139, 0, -56)
  xb(72); xb(139); xb(4); xb(200)            # rax = [vieux + offset]
  x_mem(137, 0, -96)
  x_mem(139, 9, -40); x_shl_rax(4); x_mem(137, 11, -104)
  x_mem(139, 0, -80); x_add(0, 11)
  x_mem(139, 10, -96); x_stq_rax(0, 10)
  x_mem(139, 0, -88); x_addi(0, 8); x_mem(137, 0, -88)
  x_mem(139, 0, -96); x_addi(0, 8); x_mem(137, 0, -96)
  x_addi(9, 1)
  x_mem(139, 9, -40); x_mem(139, 11, -40); x_cmp(9, 11)
  x_branch(142, $Lcopy)
  x_mem(139, 0, -24); x_mem(139, 10, -80); x_stq_rax(24, 10)
  x_mem(139, 10, -64); x_stq_rax(16, 10)
  x_mem(139, 1, -56); x_call_lbl($free)
  x_mem(139, 10, -80); x_mem(137, 11, -56)
  x_mark($Lstore)
  x_mem(139, 0, -56)
  x_mem(139, 9, -40); x_shl_rax(4); x_add(0, 9)
  x_mem(139, 10, -16); x_stq_rax(0, 10)
  x_mem(139, 8, -24); x_stq_rax(8, 11)
  x_mem(139, 10, -40); x_addi(10, 1)
  x_mem(139, 0, -32); x_stq_rax(8, 10)
  x_movimm(0, 0)
  x_mark($Lfin)
  x_epilogue()
  retour 0
}
# x_cle_existe(RCX=table, RDX=clé) -> RAX = booléen étiqueté
fn x_emit_cle($lbl: entier) -> entier {
  x_mark($lbl)
