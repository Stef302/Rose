fn sw_octet($v: entier) -> chaine {
  retour caractere($v % 256)
}

fn sw_u16le($v: entier) -> chaine {
  retour sw_octet($v % 256) + sw_octet(partie_entiere($v / 256) % 256)
}

fn sw_u32le($v: entier) -> chaine {
  retour sw_octet($v % 256)
       + sw_octet(partie_entiere($v / 256) % 256)
       + sw_octet(partie_entiere($v / 65536) % 256)
       + sw_octet(partie_entiere($v / 16777216) % 256)
}

fn sw_uleb($v: entier) -> chaine {
  $out = ""
  $x = $v
  tant_que ($x > 0) {
    $b = $x % 128
    $x = partie_entiere($x / 128)
    si ($x > 0) { $b = $b + 128 }
    $out = $out + sw_octet($b)
  }
  si (longueur($out) == 0) { $out = sw_octet(0) }
  retour $out
}

fn sw_sleb($v: entier) -> chaine {
  $out = ""
  $x = $v
  $encore = vrai
  tant_que ($encore) {
    $b = $x % 128
    si ($b < 0) { $b = $b + 128 }
    $x = partie_entiere($x / 128)
    $haut = 0
    si ($b >= 64) { $haut = 1 }
    $fini = 0
    si ($x == 0 et $haut == 0) { $fini = 1 }
    si ($x == -1 et $haut == 1) { $fini = 1 }
    si ($fini == 0) { $b = $b + 128 }
    $out = $out + sw_octet($b)
    si ($fini == 1) { $encore = faux }
  }
  retour $out
}

fn sw_chaine($s: chaine) -> chaine {
  retour sw_uleb(longueur($s)) + $s
}

fn sw_section($id: entier, $c: chaine) -> chaine {
  retour sw_octet($id) + sw_uleb(longueur($c)) + $c
}

fn sw_tokens($s: chaine) -> liste<chaine> {
  $brut = [""]
  $cur = ""
  $j = 0
  $n = longueur($s)
  tant_que ($j < $n) {
    $c = $s[$j]
    si ($c == "(" ou $c == ")") {
      si (longueur($cur) > 0) { joindre($brut, $cur); $cur = "" }
      joindre($brut, $c)
    } sinon {
      si ($c == " ") {
        si (longueur($cur) > 0) { joindre($brut, $cur); $cur = "" }
      } sinon { $cur = $cur + $c }
    }
    $j = $j + 1
  }
  si (longueur($cur) > 0) { joindre($brut, $cur) }
  $out = [""]
  $k = 1
  tant_que ($k < longueur($brut)) { joindre($out, $brut[$k]); $k = $k + 1 }
  retour $out
}

fn sw_opbin($op: chaine) -> entier {
  si ($op == "+") { retour 124 }
  si ($op == "-") { retour 125 }
  si ($op == "*") { retour 126 }
  si ($op == "div" ou $op == "÷") { retour 127 }
  retour 124
}

fn sw_expr($t: liste<chaine>, $p: entier, $base: entier, $res: entier) -> chaine {
  $tok = $t[$p]
  $q = $p + 1
  $b = ""
  si ($tok == "(") {
    $head = $t[$q]
    $q = $q + 1
    si ($head == "bin") {
      $op = $t[$q]
      $q = $q + 1
      $r1 = sw_expr($t, $q, $base, $res); $q = entier(sous_chaine($r1, 0, 6)); $b = $b + sous_chaine($r1, 6, longueur($r1))
      $r2 = sw_expr($t, $q, $base, $res); $q = entier(sous_chaine($r2, 0, 6)); $b = $b + sous_chaine($r2, 6, longueur($r2))
      $b = $b + sw_octet(sw_opbin($op))
    }
    si ($head == "n") {
      $v = entier($t[$q])
      $q = $q + 1
      $b = sw_octet(66) + sw_sleb($v)
    }
    si ($head == "v") {
      $nv = $t[$q]
      $q = $q + 1
      $b = sw_octet(66) + sw_sleb(0)
    }
    si ($head != "bin" et $head != "n" et $head != "v") {
      # (app ...) ou forme inconnue : on ignore jusqu'à la ')' fermante.
      $prof = 1
      tant_que ($q < longueur($t) et $prof > 0) {
        si ($t[$q] == "(") { $prof = $prof + 1 }
        si ($t[$q] == ")") { $prof = $prof - 1 }
        $q = $q + 1
      }
      $b = $b + sw_octet(66) + sw_sleb(0)
    }
    si ($q < longueur($t)) {
      si ($t[$q] == ")") { $q = $q + 1 }
    }
  } sinon {
    si ($tok == "entier" ou $tok == "f" ou $tok == "n") {
      $v = entier($t[$q])
      $q = $q + 1
      $b = sw_octet(66) + sw_sleb($v)
    }
    si ($tok == "slot") {
      $s = entier($t[$q])
      $q = $q + 1
      $b = sw_octet(32) + sw_uleb($s + $base)
    }
    si ($tok == "booleen" ou $tok == "vrai") {
      $b = sw_octet(66) + sw_sleb(1)
    }
    si ($tok == "faux") {
      $b = sw_octet(66) + sw_sleb(0)
    }
  }
  $pos = chaine($q)
  tant_que (longueur($pos) < 6) { $pos = "0" + $pos }
  retour $pos + $b
}

fn sw_reste($ligne: chaine, $mot: chaine) -> chaine {
  $n = longueur($ligne)
  $m = longueur($mot)
  $j = 0
  tant_que ($j + $m <= $n) {
    si (sous_chaine($ligne, $j, $j + $m) == $mot) {
      retour sous_chaine($ligne, $j + $m, $n)
    }
    $j = $j + 1
  }
  retour ""
}

fn sw_module($rir: chaine) -> chaine {
  # Découpe le dump en lignes.
  $lignes = [""]
  $cur = ""
  $j = 0
  $n = longueur($rir)
  tant_que ($j < $n) {
    $c = $rir[$j]
    si (ordre($c) == 10) {
      joindre($lignes, $cur)
      $cur = ""
    } sinon { $cur = $cur + $c }
    $j = $j + 1
  }
  si (longueur($cur) > 0) { joindre($lignes, $cur) }

  # On ne sérialise QUE le corps de $principal : les corps de fonctions
  # sont hors du sous-ensemble i64 (Appel/CALL n'est pas émis ici).
  $debut = 1
  $j = 1
  tant_que ($j < longueur($lignes)) {
    $tk = sw_tokens($lignes[$j])
    si (longueur($tk) > 2) {
      si ($tk[1] == "fonction" et $tk[2] == "$principal") {
        $k = $j + 1
        tant_que ($k < longueur($lignes)) {
          $tp = sw_tokens($lignes[$k])
          si (longueur($tp) > 1) {
            si ($tp[1] == "ops") { $debut = $k + 1; $k = 100000 }
          }
          $k = $k + 1
        }
        $j = 100000
      }
    }
    $j = $j + 1
  }

  # Nombre de slots du principal (les variables deviennent des locaux).
  $nslots = 0
  $j = 1
  tant_que ($j < $debut) {
    $tk = sw_tokens($lignes[$j])
    si (longueur($tk) > 1) {
      si ($tk[1] == "n_slots") { $nslots = entier($tk[2]) }
    }
    $j = $j + 1
  }
  # Le compilateur Rust alloue __result EN PREMIER (local 0), puis les
  # slots (local 1, 2, …). On reproduit exactement cet ordre.
  $base = 1
  $res = 0
  $nlocaux = $nslots + 1

  $code = ""
  $j = $debut
  tant_que ($j < longueur($lignes)) {
    $tt = sw_tokens($lignes[$j])
    $kind = ""
    si (longueur($tt) > 2) { $kind = $tt[2] }
    $affiche = 0
    si ($kind == "afficher_abstrait" ou $kind == "afficher" ou $kind == "retour_abstrait" ou $kind == "retour") { $affiche = 1 }
    si ($affiche == 1) {
      $r = sw_expr($tt, 3, $base, $res)
      $code = $code + sous_chaine($r, 6, longueur($r))
      # local.set $res : toute valeur `>>` devient le résultat de rose_main.
      $code = $code + sw_octet(33) + sw_uleb($res)
    }
    si ($kind == "affect") {
      $slot = entier($tt[4])
      $r = sw_expr($tt, 6, $base, $res)
      $code = $code + sous_chaine($r, 6, longueur($r))
      $code = $code + sw_octet(33) + sw_uleb($slot + $base)
    }
    $j = $j + 1
  }

  # Corps de rose_main : [1 groupe de locaux][N i64][code][local.get res][end]
  $corps = sw_uleb(1) + sw_uleb($nlocaux) + sw_octet(126)
         + $code + sw_octet(32) + sw_uleb($res) + sw_octet(11)
  $code_section = sw_uleb(1) + sw_uleb(longueur($corps)) + $corps

  # Type unique : () -> i64
  $types = sw_uleb(1) + sw_octet(96) + sw_uleb(0) + sw_uleb(1) + sw_octet(126)
  $fonctions = sw_uleb(1) + sw_uleb(0)
  $exports = sw_uleb(1) + sw_chaine("rose_main") + sw_octet(0) + sw_uleb(0)

  retour sw_octet(0) + "asm" + sw_u32le(1)
       + sw_section(1, $types)
       + sw_section(3, $fonctions)
       + sw_section(7, $exports)
       + sw_section(10, $code_section)
}

fn sb_octet($v: entier) -> chaine {
  retour caractere($v % 256)
}

fn sb_u32le($v: entier) -> chaine {
  retour sb_octet($v % 256)
       + sb_octet(partie_entiere($v / 256) % 256)
       + sb_octet(partie_entiere($v / 65536) % 256)
       + sb_octet(partie_entiere($v / 16777216) % 256)
}

fn sb_chaine($s: chaine) -> chaine {
  # ⚠ Pas de `retour sb_u32le(...) + $s` direct : le JIT Rust du moteur
  # renvoie alors 2 octets de trop quand la fonction est appelée depuis
  # une autre fonction (mesuré : 12 au lieu de 10 pour "double").
  $n = longueur($s)
  $out = sb_u32le($n)
  $out = $out + $s
  retour $out
}

fn sb_bool($b: entier) -> chaine {
  si ($b == 0) { retour sb_octet(0) }
  retour sb_octet(1)
}

fn sb_tokens($s: chaine) -> liste<chaine> {
  $brut = [""]
  $cur = ""
  $j = 0
  $n = longueur($s)
  tant_que ($j < $n) {
    $c = $s[$j]
    si ($c == "(" ou $c == ")") {
      si (longueur($cur) > 0) { joindre($brut, $cur); $cur = "" }
      joindre($brut, $c)
    } sinon {
      si ($c == " ") {
        si (longueur($cur) > 0) { joindre($brut, $cur); $cur = "" }
      } sinon { $cur = $cur + $c }
    }
    $j = $j + 1
  }
  si (longueur($cur) > 0) { joindre($brut, $cur) }
  $out = [""]
  $k = 1
  tant_que ($k < longueur($brut)) { joindre($out, $brut[$k]); $k = $k + 1 }
  retour $out
}

fn sb_lignes($s: chaine) -> liste<chaine> {
  $lignes = [""]
  $cur = ""
  $j = 0
  $n = longueur($s)
  tant_que ($j < $n) {
    $c = $s[$j]
    si (ordre($c) == 10) {
      joindre($lignes, $cur)
      $cur = ""
    } sinon { $cur = $cur + $c }
    $j = $j + 1
  }
  si (longueur($cur) > 0) { joindre($lignes, $cur) }
  retour $lignes
}

fn sb_nom_slot($ll: liste<chaine>, $slot: entier) -> chaine {
  $j = 1
  tant_que ($j < longueur($ll)) {
    $t = $ll[$j]
    $cherche = "[" + chaine($slot) + "]"
    $n = longueur($t)
    $m = longueur($cherche)
    $k = 0
    tant_que ($k + $m <= $n) {
      si (sous_chaine($t, $k, $k + $m) == $cherche) {
        retour sous_chaine($t, $k + $m, $n)
      }
      $k = $k + 1
    }
    $j = $j + 1
  }
  retour "$s" + chaine($slot)
}

fn sb_expr($t: liste<chaine>, $p: entier, $ll: liste<chaine>, $ligne: entier) -> chaine {
  $tok = $t[$p]
  $q = $p + 1
  $b = ""
  si ($tok == "(") {
    $head = $t[$q]
    $q = $q + 1
    si ($head == "bin") {
      $op = $t[$q]
      $q = $q + 1
      $r1 = sb_expr($t, $q, $ll, $ligne); $q = entier(sous_chaine($r1, 0, 6)); $b = $b + sous_chaine($r1, 6, longueur($r1))
      $r2 = sb_expr($t, $q, $ll, $ligne); $q = entier(sous_chaine($r2, 0, 6)); $b = $b + sous_chaine($r2, 6, longueur($r2))
      $b = sb_octet(7) + sb_chaine($op) + $b + sb_u32le($ligne)
    }
    si ($head == "n") {
      $v = $t[$q]
      $q = $q + 1
      $b = sb_octet(1) + sb_chaine($v) + sb_octet(0) + sb_octet(0) + sb_octet(0)
         + sb_octet(1) + sb_u32le($ligne)
    }
    si ($head == "v") {
      $v = $t[$q]
      $q = $q + 1
      $b = sb_octet(5) + sb_chaine($v) + sb_u32le($ligne)
    }
    si ($head == "app") {
      $fn = $t[$q]
      $q = $q + 1
      $nargs = 0
      $args = ""
      tant_que ($q < longueur($t) et $t[$q] != ")") {
        $r = sb_expr($t, $q, $ll, $ligne)
        $q = entier(sous_chaine($r, 0, 6))
        $args = $args + sous_chaine($r, 6, longueur($r))
        $nargs = $nargs + 1
      }
      $b = sb_octet(6) + sb_chaine($fn) + sb_chaine("") + sb_u32le($nargs)
         + $args + sb_u32le($ligne)
    }
    si ($q < longueur($t)) {
      si ($t[$q] == ")") { $q = $q + 1 }
    }
  } sinon {
    si ($tok == "entier" ou $tok == "f" ou $tok == "n") {
      $v = $t[$q]
      $q = $q + 1
      $b = sb_octet(1) + sb_chaine($v) + sb_octet(0) + sb_octet(0) + sb_octet(0)
         + sb_octet(1) + sb_u32le($ligne)
    }
    si ($tok == "slot") {
      $s = entier($t[$q])
      $q = $q + 1
      $b = sb_octet(5) + sb_chaine(sb_nom_slot($ll, $s)) + sb_u32le($ligne)
    }
    si ($tok == "vrai" ou $tok == "booleen") {
      $b = sb_octet(4) + sb_octet(1) + sb_u32le($ligne)
    }
    si ($tok == "faux") {
      $b = sb_octet(4) + sb_octet(0) + sb_u32le($ligne)
    }
  }
  $pos = chaine($q)
  tant_que (longueur($pos) < 6) { $pos = "0" + $pos }
  retour $pos + $b
}

fn sb_instrs($ll: liste<chaine>, $debut: entier, $fin: entier, $noms: liste<chaine>, $ligne: entier) -> chaine {
  $out = ""
  $j = $debut
  tant_que ($j < $fin) {
    $tt = sb_tokens($ll[$j])
    $kind = ""
    si (longueur($tt) > 2) { $kind = $tt[2] }
    si ($kind == "afficher_abstrait" ou $kind == "afficher") {
      $r = sb_expr($tt, 3, $noms, $ligne)
      $out = $out + sb_octet(1) + sb_u32le(1)
           + sous_chaine($r, 6, longueur($r)) + sb_u32le($ligne)
    }
    si ($kind == "retour_abstrait" ou $kind == "retour") {
      $r = sb_expr($tt, 3, $noms, $ligne)
      $out = $out + sb_octet(8) + sb_octet(1)
           + sous_chaine($r, 6, longueur($r)) + sb_u32le($ligne)
    }
    si ($kind == "affect") {
      $slot = entier($tt[4])
      $nom = sb_nom_slot($noms, $slot)
      $r = sb_expr($tt, 6, $noms, $ligne)
      $out = $out + sb_octet(3) + sb_chaine($nom)
           + sous_chaine($r, 6, longueur($r)) + sb_u32le($ligne)
    }
    $j = $j + 1
  }
  retour $out
}

fn sb_kind($l: chaine) -> chaine {
  $t = sb_tokens($l)
  si (longueur($t) > 1) { retour $t[1] }
  retour ""
}

fn sb_tok($l: chaine, $i: entier) -> chaine {
  $t = sb_tokens($l)
  si (longueur($t) > $i) { retour $t[$i] }
  retour ""
}

fn sb_compte($ll: liste<chaine>, $debut: entier, $fin: entier) -> entier {
  $n = 0
  $j = $debut
  tant_que ($j < $fin) {
    $tt = sb_tokens($ll[$j])
    $kind = ""
    si (longueur($tt) > 2) { $kind = $tt[2] }
    si ($kind == "afficher_abstrait" ou $kind == "afficher" ou $kind == "retour_abstrait" ou $kind == "retour" ou $kind == "affect") { $n = $n + 1 }
    $j = $j + 1
  }
  retour $n
}

fn sb_module($rir: chaine) -> chaine {
  $ll = sb_lignes($rir)
  $noms = [""]
  $ligne = 1

  # Table des noms : ligne `noms ...`.
  $j = 1
  tant_que ($j < longueur($ll)) {
    $tt = sb_tokens($ll[$j])
    si (longueur($tt) > 1) {
      si ($tt[1] == "noms") {
        $k = 2
        tant_que ($k < longueur($tt)) { joindre($noms, $tt[$k]); $k = $k + 1 }
      }
    }
    $j = $j + 1
  }

  # Sous-ensemble « RIR simple » : le snapshot ne contient QUE le principal.
  # Les signatures de fonctions utilisateur (appels, récursion) ne font pas
  # partie du sous-ensemble sérialisé : $nsig reste 0, comme dans la
  # référence Rust pour tout programme sans fonction (contrôle >>7*6).
  $nsig = 0
  $sigs = ""

  # Instructions du principal : après son `ops`.
  $opo = longueur($ll)
  $j = 1
  tant_que ($j < longueur($ll)) {
    $tt = sb_tokens($ll[$j])
    si (longueur($tt) > 2) {
      si ($tt[1] == "fonction" et $tt[2] == "$principal") {
        $k = $j + 1
        tant_que ($k < longueur($ll)) {
          $tk = sb_tokens($ll[$k])
          si (longueur($tk) > 1) {
            si ($tk[1] == "ops") { $opo = $k + 1; $k = 100000 }
          }
          $k = $k + 1
        }
        $j = 100000
      }
    }
    $j = $j + 1
  }
  $principal = sb_instrs($ll, $opo, longueur($ll), $noms, $ligne)

  # Accumulation par petits pas (une chaîne de + longue avec appels
  # déclenche un bug du JIT Rust : des préfixes de longueur disparaissent).
  $out = "ROSEBC"
  $out = $out + sb_u32le(3)
  $out = $out + sb_u32le(0)
  $out = $out + sb_u32le($nsig)
  $out = $out + $sigs
  $out = $out + sb_u32le(sb_compte($ll, $opo, longueur($ll)))
  $out = $out + $principal
  retour $out
}

fn mc_elf_gabarit($imm: entier) -> chaine {
  $chunks = mc_elf_hex()
  $h = ""
  $ci = 0
  tant_que ($ci < longueur($chunks)) {
    $h = $h + $chunks[$ci]
    $ci = $ci + 1
  }
  $n = longueur($h) / 2
  $out = ""
  $k = 0
  tant_que ($k < $n) {
    $v = mc_hex_val(sous_chaine($h, $k * 2, $k * 2 + 2)) * 16
           + mc_hex_val(sous_chaine($h, $k * 2 + 1, $k * 2 + 2))
    $patch = $imm * 32
    si ($k == 236) { $v = $patch % 256 }
    si ($k == 237) { $v = partie_entiere($patch / 256) % 256 }
    $out = $out + octet_brut($v)
    $k = $k + 1
  }
  retour $out
}

fn mc_octets($s: chaine) -> entier {
  $n = longueur($s)
  $k = 0
  $r = 0
  tant_que ($k < $n) {
    $o = ordre(sous_chaine($s, $k, $k + 1))
    si ($o < 128) { $r = $r + 1 }
    sinon si ($o < 2048) { $r = $r + 2 }
    sinon si ($o < 65536) { $r = $r + 3 }
    sinon { $r = $r + 4 }
    $k = $k + 1
  }
  retour $r
}

# ── banc ─────────────────────────────────────────────────────────────────
fn t($nom: chaine, $ok: booleen) -> entier {
  si ($ok) { retour 1 }
  >> "ECHEC " + $nom
  retour 0
}
$tp = 0
$tf = 0

# 1. surfaces fixes (3 tests)
$r = t("banniere", cli_banniere() == "Rose 0.1.73 — langage de programmation en français (maths exactes, JIT, AOT, compilation autonome)\n")
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("info", mc_octets(cli_info()) == 384)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("aide", mc_octets(cli_aide()) == 2948)
$tp = $tp + $r
$tf = $tf + (1 - $r)
# 2. aide détaillée : 9 commandes + inconnue (10 tests)
$r = t("help comp", mc_octets(cli_aide_pour("comp")) == 519)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help methode", mc_octets(cli_aide_pour("methode")) == 486)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help run", mc_octets(cli_aide_pour("run")) == 383)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help jit", mc_octets(cli_aide_pour("jit")) == 507)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help interprete", mc_octets(cli_aide_pour("interprete")) == 385)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help transpile", mc_octets(cli_aide_pour("transpile")) == 692)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help bc", mc_octets(cli_aide_pour("bc")) == 453)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help rvm", mc_octets(cli_aide_pour("rvm")) == 733)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help aot", mc_octets(cli_aide_pour("aot")) == 477)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("help inconnu", cli_aide_pour("inconnu") == "")
$tp = $tp + $r
$tf = $tf + (1 - $r)
# 3. utilitaires de chemin (4 tests)
$r = t("base simple", mc_base("/a/b/prog.rose") == "prog.rose")
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("base racine", mc_base("/prog.rose") == "prog.rose")
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("sans ext", mc_sans_ext("/a/b/prog.rose") == "prog")
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("dossier", mc_dossier("/a/b/prog.rose") == "/a/b/")
$tp = $tp + $r
$tf = $tf + (1 - $r)
# 4. extraction de constante RIR (2 tests)
$mc_r = "rir\nfonction $principal\n  retour vide\n  n_slots 0\n  noms\n  ops\n    0000 afficher_abstrait entier 42\n"
$r = t("const RIR 42", mc_const_rir($mc_r) == "42")
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("const RIR vide", mc_const_rir("rir\n") == "")
$tp = $tp + $r
$tf = $tf + (1 - $r)
# 5. gabarit ELF C0 (2 tests)
$r = t("hex chunks", longueur(mc_elf_hex()) == 90)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("elf gabarit", longueur(mc_elf_gabarit(42)) == 8908)
$tp = $tp + $r
$tf = $tf + (1 - $r)
# 6. sérialiseurs (3 tests)
$rir = "rir\nfonction $principal\n  retour vide\n  n_slots 0\n  noms\n  ops\n    0000 afficher_abstrait entier 42\n"
$w = sw_module($rir)
$b = sb_module($rir)
$r = t("wasm magic", longueur($w) == 48 et ordre(sous_chaine($w, 0, 1)) == 0 et sous_chaine($w, 1, 4) == "asm")
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("wasm rose_main", mc_trouve($w, "rose_main") > 0)
$tp = $tp + $r
$tf = $tf + (1 - $r)$r = t("rosebc magic", longueur($b) == 46 et sous_chaine($b, 0, 6) == "ROSEBC")
$tp = $tp + $r
$tf = $tf + (1 - $r)
>> "TESTS B10 : " + chaine($tp) + " OK, " + chaine($tf) + " ECHEC"
si ($tf > 0) { quitter(1) }
quitter(0)
