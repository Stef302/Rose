# lexeur.rose — jalon M4.1, miroir du tokeniseur Rust (stage0).
#
# Écrit les jetons au format de `rose tokens` :
#   ligne:colonne type texte_échappé
# un jeton par ligne, y compris « eof ».
#
# Règles (miroir de rose/src/front.rs tokeniser) :
# - mot nu (y compris mot-clé) -> type « mot »
# - $nom -> type « ident » (texte sans $)
# - π, φ -> « mot » avec texte π/φ
# - nombres/chaines/flottants comme dans Rust
# - -> émis en deux jetons : « - » puis « > »
# - ! postfixe après expression : « ! » avec texte « ! », « !! »... (MultiFacto)
# - ! préfixe : « ! » (SousFacto)
# - # postfixe après expression : « # » (Diese), sinon commentaire
# - ? postfixe terminal (sauf ?= et si compact « ? (...) » en début d'instruction)
# - $ postfixe superfactorielle si pas suivi d'une lettre
# - ²/³ -> « ^ » puis « nombre 2/3 »

fn est_chiffre(c: entier) -> booleen {
  retour c >= 48 et c <= 57
}

fn est_lettre(c: entier) -> booleen {
  si (c < 128) {
    retour (c >= 65 et c <= 90) ou (c >= 97 et c <= 122) ou c == 95
  }
  retour (c >= 192 et c <= 214) ou (c >= 216 et c <= 246) ou (c >= 248 et c <= 767) ou (c >= 880 et c <= 1279) ou (c >= 7680 et c <= 8191)
}

fn est_suite(c: entier) -> booleen {
  si (c < 128) {
    retour est_lettre(c) ou est_chiffre(c)
  }
  retour est_lettre(c)
}

fn paire(a: entier, b: entier) -> chaine {
  si (a == 60 et b == 61) { retour "<=" }
  si (a == 62 et b == 61) { retour ">=" }
  si (a == 61 et b == 61) { retour "==" }
  si (a == 33 et b == 61) { retour "!=" }
  si (a == 47 et b == 61) { retour "!=" }
  si (a == 63 et b == 61) { retour "≈" }
  si (a == 61 et b == 126) { retour "≈" }
  si (a == 126 et b == 61) { retour "≈" }
  retour ""
}

fn uni(c: entier) -> chaine {
  si (c == 8776) { retour "≈" }
  si (c == 8804) { retour "<=" }
  si (c == 8805) { retour ">=" }
  si (c == 8800) { retour "!=" }
  si (c == 215) { retour "*" }
  si (c == 8901) { retour "*" }
  si (c == 183) { retour "*" }
  si (c == 247) { retour "div" }
  si (c == 8592) { retour "=" }
  si (c == 8594) { retour "->" }
  si (c == 8730) { retour "racine" }
  retour ""
}

fn car(c: entier) -> chaine {
  si (c == 43) { retour "+" }
  si (c == 45) { retour "-" }
  si (c == 42) { retour "*" }
  si (c == 47) { retour "/" }
  si (c == 58) { retour ":" }
  si (c == 37) { retour "%" }
  si (c == 94) { retour "^" }
  si (c == 33) { retour "!" }
  si (c == 46) { retour "." }
  si (c == 44) { retour "," }
  si (c == 63) { retour "?" }
  si (c == 40) { retour "(" }
  si (c == 41) { retour ")" }
  si (c == 123) { retour "{" }
  si (c == 125) { retour "}" }
  si (c == 91) { retour "[" }
  si (c == 93) { retour "]" }
  si (c == 59) { retour ";" }
  si (c == 60) { retour "<" }
  si (c == 62) { retour ">" }
  si (c == 126) { retour "~" }
  si (c == 64) { retour "@" }
  retour ""
}

fn echapper(t: chaine) -> chaine {
  $o = ""
  $j = 0
  $n = longueur(t)
  tant_que ($j < $n) {
    $c = ordre(t[$j])
    si ($c == 92) { $o = $o + "\\" + "\\" }
    sinon si ($c == 10) { $o = $o + "\\" + "n" }
    sinon si ($c == 9) { $o = $o + "\\" + "t" }
    sinon si ($c == 13) { $o = $o + "\\" + "r" }
    sinon si ($c == 31) { $o = $o + "\\" + "u241f" }
    sinon { $o = $o + t[$j] }
    $j = $j + 1
  }
  retour $o
}

$src = ""
si (nb_arguments() > 0) { $src = lire_texte(argument(0)) }
$N = longueur($src)
$i = 0
$ligne = 1
$col = 1
$suiv = -1
$dernier = "debut"

tant_que ($i < $N) {
  $c = ordre($src[$i])
  $suiv = -1
  si ($i + 1 < $N) { $suiv = ordre($src[$i + 1]) }
  $pchar = 10
  si ($i > 0) { $pchar = ordre($src[$i - 1]) }
  $apres = 0
  si ($dernier == "nombre" ou $dernier == "flottant" ou $dernier == "chaine" ou $dernier == "ident" ou $dernier == "mot" ou $dernier == "rparen" ou $dernier == "rbracket" ou $dernier == "multifacto" ou $dernier == "diese" ou $dernier == "terminal" ou $dernier == "superfacto" ou $dernier == "chapeau" ou $dernier == "deuxpts") { $apres = 1 }

  # blancs
  si ($c == 32 ou $c == 9 ou $c == 13 ou $c == 10) {
    si ($c == 10) { $ligne = $ligne + 1; $col = 1 } sinon { $col = $col + 1 }
    $i = $i + 1
  }
  # %% en début de ligne : commentaire LaTeX
  sinon si ($c == 37 et $suiv == 37 et ($i == 0 ou $pchar == 10)) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1; $col = $col + 1 }
    }
  }
  # # : primorielle postfixe si après expression (et pas commentaire), sinon commentaire
  sinon si ($c == 35) {
    si ($apres == 1 et $i > 0 et $pchar != 32 et $pchar != 9 et $pchar != 13 et $pchar != 10) {
      >> chaine($ligne) + ":" + chaine($col) + " # #"
      $i = $i + 1
      $col = $col + 1
      $dernier = "diese"
    } sinon {
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 10) { $ok = 0 }
        sinon { $i = $i + 1; $col = $col + 1 }
      }
    }
  }
  # commentaire //
  sinon si ($c == 47 et $suiv == 47) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1; $col = $col + 1 }
    }
  }
  # chaînes
  sinon si ($c == 34 ou $c == 39) {
    $dl = $ligne
    $dc = $col
    $q = $c
    $i = $i + 1
    $col = $col + 1
    $buf = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon {
        $cc = ordre($src[$i])
        si ($cc == 92) {
          si ($i + 1 >= $N) { $ok = 0 }
          sinon {
            $nx = ordre($src[$i + 1])
            si ($nx == 110) { $buf = $buf + "\n" }
            sinon si ($nx == 116) { $buf = $buf + "\t" }
            sinon si ($nx == 92 ou $nx == 34 ou $nx == 39) { $buf = $buf + $src[$i + 1] }
            sinon { $buf = $buf + "\\"; $buf = $buf + $src[$i + 1] }
            $i = $i + 2
            $col = $col + 2
          }
        }
        sinon si ($cc == $q) {
          $i = $i + 1
          $col = $col + 1
          $ok = 0
        }
        sinon {
          $buf = $buf + $src[$i]
          $i = $i + 1
          $col = $col + 1
        }
      }
    }
    >> chaine($dl) + ":" + chaine($dc) + " chaine " + echapper($buf)
    $dernier = "chaine"
  }
  # nombres
  sinon si (est_chiffre($c)) {
    $dl = $ligne
    $dc = $col
    $flott = 0
    $txt = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_chiffre(ordre($src[$i]))) {
        $txt = $txt + $src[$i]
        $i = $i + 1
        $col = $col + 1
      }
      sinon { $ok = 0 }
    }
    $point_ok = 0
    si ($i + 1 < $N) {
      si (ordre($src[$i]) == 46 et est_chiffre(ordre($src[$i + 1]))) { $point_ok = 1 }
    }
    si ($point_ok == 1) {
      $flott = 1
      $txt = $txt + "."
      $i = $i + 1
      $col = $col + 1
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (est_chiffre(ordre($src[$i]))) {
          $txt = $txt + $src[$i]
          $i = $i + 1
          $col = $col + 1
        }
        sinon { $ok = 0 }
      }
    }
    si ($flott == 1) {
      >> chaine($dl) + ":" + chaine($dc) + " flottant " + $txt
      $dernier = "flottant"
    } sinon {
      >> chaine($dl) + ":" + chaine($dc) + " nombre " + $txt
      $dernier = "nombre"
    }
  }
  # '!' : préfixe SousFacto, ou '!=', ou postfixe MultiFacto
  sinon si ($c == 33) {
    si ($apres == 0) {
      >> chaine($ligne) + ":" + chaine($col) + " ! !"
      $i = $i + 1
      $col = $col + 1
      $dernier = "autre"
    } sinon si ($suiv == 61) {
      >> chaine($ligne) + ":" + chaine($col) + " != !="
      $i = $i + 2
      $col = $col + 2
      $dernier = "autre"
    } sinon {
      $dl = $ligne
      $dc = $col
      $txt = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 33 et non ($i + 1 < $N et ordre($src[$i + 1]) == 61)) {
          $txt = $txt + "!"
          $i = $i + 1
          $col = $col + 1
        } sinon { $ok = 0 }
      }
      >> chaine($dl) + ":" + chaine($dc) + " ! " + $txt
      $dernier = "multifacto"
    }
  }
  # '?' : ?= (environ) ou terminal postfixe / si compact
  sinon si ($c == 63) {
    si ($suiv == 61) {
      >> chaine($ligne) + ":" + chaine($col) + " ≈ ?="
      $i = $i + 2
      $col = $col + 2
      $dernier = "autre"
    } sinon {
      $est_debut = 0
      si ($pchar == 10 ou $pchar == 59 ou $pchar == 62 ou $i == 0) { $est_debut = 1 }
      $j = $i + 1
      $ok = 1
      tant_que ($ok == 1) {
        si ($j >= $N) { $ok = 0 }
        sinon si (ordre($src[$j]) == 32 ou ordre($src[$j]) == 9 ou ordre($src[$j]) == 13) { $j = $j + 1 }
        sinon { $ok = 0 }
      }
      $suit_paren = 0
      si ($j < $N et ordre($src[$j]) == 40) { $suit_paren = 1 }
      $ouvre_si = 0
      si ($est_debut == 1 et $suit_paren == 1) { $ouvre_si = 1 }
      si ($ouvre_si == 0) {
        >> chaine($ligne) + ":" + chaine($col) + " ? ?"
        $dernier = "terminal"
      } sinon {
        # si compact : Rust émet Tk::Question mais notre oracle mappe Question->"?"
        >> chaine($ligne) + ":" + chaine($col) + " ? ?"
        $dernier = "autre"
      }
      $i = $i + 1
      $col = $col + 1
    }
  }
  # π, φ
  sinon si ($c == 960) {
    >> chaine($ligne) + ":" + chaine($col) + " mot π"
    $i = $i + 1
    $col = $col + 1
    $dernier = "mot"
  }
  sinon si ($c == 966) {
    >> chaine($ligne) + ":" + chaine($col) + " mot φ"
    $i = $i + 1
    $col = $col + 1
    $dernier = "mot"
  }
  # $ : superfactorielle postfixe si pas suivi d'une lettre, sinon variable
  sinon si ($c == 36) {
    $est_var = 0
    si ($suiv != -1 et est_lettre($suiv)) { $est_var = 1 }
    si ($est_var == 0) {
      >> chaine($ligne) + ":" + chaine($col) + " $ $"
      $i = $i + 1
      $col = $col + 1
      $dernier = "superfacto"
    } sinon {
      $dl = $ligne
      $dc = $col
      $i = $i + 1
      $col = $col + 1
      $nu = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (est_suite(ordre($src[$i]))) {
          $nu = $nu + $src[$i]
          $i = $i + 1
          $col = $col + 1
        }
        sinon { $ok = 0 }
      }
      >> chaine($dl) + ":" + chaine($dc) + " ident " + $nu
      $dernier = "ident"
    }
  }
  # identifiants/mots nus
  sinon si (est_lettre($c)) {
    $dl = $ligne
    $dc = $col
    $nu = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_suite(ordre($src[$i]))) {
        $nu = $nu + $src[$i]
        $i = $i + 1
        $col = $col + 1
      }
      sinon { $ok = 0 }
    }
    >> chaine($dl) + ":" + chaine($dc) + " mot " + $nu
    $dernier = "mot"
  }
  # paires
  sinon si (paire($c, $suiv) != "") {
    $t = paire($c, $suiv)
    $txt = sous_chaine($src, $i, $i + 2)
    >> chaine($ligne) + ":" + chaine($col) + " " + $t + " " + $txt
    $i = $i + 2
    $col = $col + 2
    $dernier = "autre"
  }
  sinon si ($c == 62 et $suiv == 62) {
    >> chaine($ligne) + ":" + chaine($col) + " >> >>"
    $i = $i + 2
    $col = $col + 2
    $dernier = "autre"
  }
  sinon si ($c == 60 et $suiv == 60) {
    >> chaine($ligne) + ":" + chaine($col) + " << <<"
    $i = $i + 2
    $col = $col + 2
    $dernier = "autre"
  }
  sinon si ($c == 45 et $suiv == 62) {
    >> chaine($ligne) + ":" + chaine($col) + " - -"
    >> chaine($ligne) + ":" + chaine($col + 1) + " > >"
    $i = $i + 2
    $col = $col + 2
    $dernier = "autre"
  }
  sinon si ($c == 61) {
    >> chaine($ligne) + ":" + chaine($col) + " = ="
    $i = $i + 1
    $col = $col + 1
    $dernier = "autre"
  }
  sinon si ($c == 58 et $suiv == 58) {
    >> chaine($ligne) + ":" + chaine($col) + " :: ::"
    $i = $i + 2
    $col = $col + 2
    $dernier = "autre"
  }
  # ² ³
  sinon si ($c == 178) {
    >> chaine($ligne) + ":" + chaine($col) + " ^ ^"
    >> chaine($ligne) + ":" + chaine($col) + " nombre 2"
    $i = $i + 1
    $col = $col + 1
    $dernier = "nombre"
  }
  sinon si ($c == 179) {
    >> chaine($ligne) + ":" + chaine($col) + " ^ ^"
    >> chaine($ligne) + ":" + chaine($col) + " nombre 3"
    $i = $i + 1
    $col = $col + 1
    $dernier = "nombre"
  }
  sinon si (uni($c) != "") {
    $t = uni($c)
    >> chaine($ligne) + ":" + chaine($col) + " " + $t + " " + $src[$i]
    $i = $i + 1
    $col = $col + 1
    $dernier = "autre"
  }
  sinon si (car($c) != "") {
    $t = car($c)
    $ch = $src[$i]
    >> chaine($ligne) + ":" + chaine($col) + " " + $t + " " + $ch
    $i = $i + 1
    $col = $col + 1
    si ($c == 41) { $dernier = "rparen" }
    sinon si ($c == 93) { $dernier = "rbracket" }
    sinon si ($c == 94) { $dernier = "chapeau" }
    sinon si ($c == 58) { $dernier = "deuxpts" }
    sinon { $dernier = "autre" }
  }
  sinon {
    $i = $i + 1
    $col = $col + 1
  }
}

>> chaine($ligne) + ":" + chaine($col) + " eof "
