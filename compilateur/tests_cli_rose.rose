# ═══════════════════════════════════════════════════════════════════════
# tests_cli_rose.rose — banc Rose de la couche CLI auto-hébergée.
#
# Usage : rose compilateur/tests_cli_rose.rose
#   → « TESTS CLI : 20 OK, 0 ECHEC », rc=0.
#
# `cli_aide_pour` ci-dessous est extraite à l'octet près de
# compilateur/cli_rose.rose par le générateur. Le banc vérifie que le
# dispatch rend exactement les textes de l'oracle rose/rose 0.1.73.
# La comparaison des 18 sorties de l'ELF C0 (C0(cli_rose.rose)) à celles
# de rose/rose est décrite et mesurée dans rose/docs/HORDE_CLI.md.
# ═══════════════════════════════════════════════════════════════════════

# Les fonctions rendent 1 (OK) ou 0 (ECHEC) ; l'accumulation se fait au
# niveau supérieur (Rose n'autorise pas d'affecter une globale depuis une fn).
fn cli_test($nom: chaine, $attendu: chaine, $obtenu: chaine) -> entier {
  si ($attendu == $obtenu) { retour 1 }
  >> "ECHEC " + $nom
  retour 0
}
fn cli_test_rc($nom: chaine, $attendu: entier, $obtenu: entier) -> entier {
  si ($attendu == $obtenu) { retour 1 }
  >> "ECHEC rc " + $nom
  retour 0
}
$cli_pass = 0
$cli_fail = 0

# ── Textes oracle + fonction de dispatch réelle ─────────────────────────
fn cli_banniere() -> chaine { retour "Rose 0.1.73 — langage de programmation en français (maths exactes, JIT, AOT, compilation autonome)" }
fn cli_aide() -> chaine { retour "Rose 0.1.73 — langage de programmation en français (maths exactes, JIT, AOT, compilation autonome)\nUsage :\n  rose methode [prog.rose]       menu en français : choisissez COMMENT exécuter votre programme\n  rose help <commande>           explication détaillée et un exemple pour une commande\n\n  rose prog.rose [args…]         exécute votre programme (mode accéléré habituel)\n  rose run prog.rose [args…]     idem, avec le mot « run » ; interpréteur et accélération\n  rose jit prog.rose [args…]     Choix explicite : accélère les boucles après un court échauffement\n  rose interprete prog.rose      Choix explicite : démarre tout de suite, sans accélération\n  rose comp prog.rose [-o sortie]   exécutable autonome prêt à l'emploi (moteur et source réunis) ; suffixe .exe ajouté sur Windows\n  rose aot prog.rose [-o sortie] binaire natif le plus rapide, compilé à l'avance ; refuse les programmes trop complexes\n  rose transpile prog.rose --cible js|py|c|wasm [-o sortie]   traduit en JavaScript, Python, C ou WASM ; ne lance rien\n  rose bc prog.rose [-o sortie]   écrit un fichier de bytecode .rosebc ; ne l'exécute pas\n  rose rvm fichier.rosebc [classe] [methode] [args…]   exécute un .rosebc dans la machine virtuelle Rose\n\nAutres commandes :\n  rose latex prog.rose              formule LaTeX du programme entier\n  rose latex prog.rose --apercu     idem, rendu VISIBLE (Unicode, sans LaTeX)\n  rose latex prog.rose --lignes     seulement les lignes marquées %% (LaTeX brut)\n  rose latex prog.rose --lignes --apercu   les lignes %% en rendu visible\n  rose tokens prog.rose             liste les jetons (oracle : ligne:colonne type texte)\n  rose ast prog.rose                arbre syntaxique (oracle, S-expressions)\n  rose rir prog.rose                représentation intermédiaire (RIR)\n  rose verif prog.rose              vérifie le programme (oracle : « vérifié » ou message)\n  rose llvm prog.rose [-o sortie]   génère du code C ; ne lance pas le programme\n  rose link objet.o [-o sortie]     lie un objet natif en exécutable\n  rose info                         état du moteur\n  rose console [fichier.rose]       console interactive (REPL) — :help, :methode, :more [N] (30 chiffres de plus)\n  rose repl [fichier.rose]          identique\n  rose debug-lenteur [-n N] [prog.rose]   OÙ VA LE TEMPS ? lancement, analyse, exécution\n  rose wasm lib.wasm                fonctions exportées d'un module WebAssembly\n  rose update                       installe/met à jour Rose (64 bits, interface console)\n  rose assoc [--user|--system] [--lang fr|en]   associer .rose à rose.exe (Windows)\n  rose assoc --remove [--user|--system]         retirer l'association .rose\n  rose assoc --dry-run                          afficher les commandes d'association sans les appliquer\nNote : `rose comp prog.rose` suffit pour 99 % des usages (exécutable autonome). Les autres commandes sont des options avancées." }
fn cli_info() -> chaine { retour "rose 0.1.73\n  langage           : Rose — langage de programmation en français\n  architecture      : ARM 64 bits\n  maths exactes     : entiers illimités, rationnels, flottants, irrationnels (√n), complexes (a+bi)\n  exécution         : JIT à chaud + interpréteur intégré (résultats identiques)\n  compilation       : exécutable autonome (`rose comp`), JIT et AOT optionnels" }
fn cli_aide_comp() -> chaine { retour "rose comp prog.rose [-o sortie]\n\nCe que ça fait : fabrique un exécutable autonome : le moteur et votre\nsource sont réunis dans un seul fichier. Vous pouvez le copier et le lancer\nsur un autre ordinateur sans installer Rose. Sur Windows, le suffixe .exe\nest ajouté automatiquement.\n\nLimite : le programme est figé au moment de la compilation ; pour le\nmodifier, il faut refabriquer l'exécutable. Ce n'est PAS un binaire natif\noptimisé (voir « rose aot »).\n\nExemple :\n  rose comp exemples/bonjour.rose -o bonjour" }
fn cli_aide_methode() -> chaine { retour "rose methode [prog.rose]\n\nCe que ça fait : ouvre un menu en français avec les six façons d'exécuter\nvotre programme. Vous tapez un numéro de 1 à 6. Si vous n'avez pas déjà\ndonné le fichier, le menu vous le demande ensuite. Rose lance alors la\nméthode choisie.\n\nLimite : c'est un choix pour CETTE exécution. Pour changer dans la console,\nutilisez la commande :methode jit|aot|interprete.\n\nExemple :\n  rose methode prog.rose\n  (puis tapez 2 et Entrée pour choisir le mode JIT)" }
fn cli_aide_run() -> chaine { retour "rose run prog.rose [args…]\n\nCe que ça fait : exécute votre programme tout de suite. C'est la façon\nla plus simple de voir le résultat à l'écran.\n\nLimite : le programme n'est pas enregistré sur le disque ; il faut le\nfichier .rose à chaque fois. C'est aussi la méthode par défaut quand vous\ntapez seulement « rose prog.rose ».\n\nExemple :\n  rose run exemples/bonjour.rose" }
fn cli_aide_jit() -> chaine { retour "rose jit prog.rose [args…]\n\nCe que ça fait : exécute votre programme en accélérant les boucles pendant\nle déroulement. Les premières fois sont un peu lentes (échauffement), puis\nça va très vite. C'est identique au défaut de « rose prog.rose », mais vous\nle choisissez explicitement.\n\nLimite : l'accélération n'a pas le temps d'agir sur un programme très court\n; dans ce cas « rose interprete » démarre plus vite. Aucun fichier n'est\nproduit.\n\nExemple :\n  rose jit exemples/fibonacci.rose" }
fn cli_aide_interprete() -> chaine { retour "rose interprete prog.rose [args…]\n\nCe que ça fait : exécute votre programme sans accélération. Le démarrage\nest immédiat, et la forme interne du programme (le RIR) est gardée en\nmémoire pour les exécutions suivantes.\n\nLimite : sur un long calcul répétitif, c'est plus lent que « rose jit ».\nAucun fichier n'est produit.\n\nExemple :\n  rose interprete exemples/bonjour.rose" }
fn cli_aide_transpile() -> chaine { retour "rose transpile prog.rose --cible js|py|c|wasm [-o sortie]\n\nCe que ça fait : traduit votre programme en JavaScript, Python, C lisible\nou en module WebAssembly binaire.\n\njs / py / c : le résultat est du TEXTE que vous pouvez lire, modifier ou\nintégrer ailleurs. Sans -o, le texte s'affiche à l'écran.\n\nwasm : le résultat est un MODULE BINAIRE .wasm exportant rose_main() -> i64\n(sous-ensemble entiers i64 : voir rose/docs/TRANSPILE_WASM.md). Sans -o, le\nfichier .wasm est tout de même écrit à côté du programme.\n\nLimite : ça ne lance PAS votre programme.\n\nExemple :\n  rose transpile exemples/bonjour.rose --cible js -o bonjour.js\n  rose transpile prog.rose --cible wasm -o prog.wasm" }
fn cli_aide_bc() -> chaine { retour "rose bc prog.rose [-o sortie]\n\nCe que ça fait : écrit un fichier de bytecode .rosebc (ROSEBC v3) qui est le\nSNAPSHOT COMPLET du programme : toutes les fonctions, les récursions, les\nchaînes, les tables, les rationnels et les E/S. C'est la première des deux\nétapes pour la machine virtuelle Rose.\n\nLimite : ça ne lance PAS le programme.\nUtilisez ensuite « rose rvm » pour l'exécuter.\n\nExemple :\n  rose bc exemples/bonjour.rose -o bonjour.rosebc" }
fn cli_aide_rvm() -> chaine { retour "rose rvm fichier.rosebc [classe] [methode] [args…]\n\nCe que ça fait : exécute un fichier .rosebc dans la machine virtuelle Rose,\nqui travaille dans un espace fermé. C'est la deuxième étape, après « rose bc ».\nUn snapshot v3 exécute TOUT le langage (appels, récursion, chaînes, tables,\nrationnels, E/S) avec la même mécanique que l'interpréteur (slots + trames).\nLes anciens .rosebc v1/v2 restent exécutables par la machine à méthodes.\n\nLimite : il faut d'abord avoir produit le .rosebc. Les noms de classe et de\nméthode sont facultatifs (par défaut : Principal et <principal>). Les\narguments doivent être des nombres entiers.\n\nExemple :\n  rose bc exemples/bonjour.rose -o bonjour.rosebc\n  rose rvm bonjour.rosebc" }
fn cli_aide_aot() -> chaine { retour "rose aot prog.rose [-o sortie]\n\nCe que ça fait : fabrique un binaire natif compilé à l'avance. C'est le\nplus rapide au lancement : rien n'est traduit au moment de l'exécution.\n\nLimite : Rose refuse explicitement si votre programme ne peut pas être\ntraduit en natif, et ne produit alors aucun fichier. Dans ce cas, utilisez\n« rose comp » (exécutable autonome). « orc » est un autre nom pour la même\nchose.\n\nExemple :\n  rose aot exemples/bonjour.rose -o bonjour-rapide" }
fn cli_aide_pour($cmd: chaine) -> chaine {
  si ($cmd == "comp") { retour cli_aide_comp() }
  si ($cmd == "methode") { retour cli_aide_methode() }
  si ($cmd == "run") { retour cli_aide_run() }
  si ($cmd == "jit") { retour cli_aide_jit() }
  si ($cmd == "interprete") { retour cli_aide_interprete() }
  si ($cmd == "transpile") { retour cli_aide_transpile() }
  si ($cmd == "bc") { retour cli_aide_bc() }
  si ($cmd == "rvm") { retour cli_aide_rvm() }
  si ($cmd == "aot") { retour cli_aide_aot() }
  retour ""
}


# ── 9 cas : aide détaillée par commande (dispatch réel) ──────────────────
$cli_pass = $cli_pass + cli_test("help comp", "rose comp prog.rose [-o sortie]\n\nCe que ça fait : fabrique un exécutable autonome : le moteur et votre\nsource sont réunis dans un seul fichier. Vous pouvez le copier et le lancer\nsur un autre ordinateur sans installer Rose. Sur Windows, le suffixe .exe\nest ajouté automatiquement.\n\nLimite : le programme est figé au moment de la compilation ; pour le\nmodifier, il faut refabriquer l'exécutable. Ce n'est PAS un binaire natif\noptimisé (voir « rose aot »).\n\nExemple :\n  rose comp exemples/bonjour.rose -o bonjour", cli_aide_pour("comp"))
$cli_pass = $cli_pass + cli_test("help methode", "rose methode [prog.rose]\n\nCe que ça fait : ouvre un menu en français avec les six façons d'exécuter\nvotre programme. Vous tapez un numéro de 1 à 6. Si vous n'avez pas déjà\ndonné le fichier, le menu vous le demande ensuite. Rose lance alors la\nméthode choisie.\n\nLimite : c'est un choix pour CETTE exécution. Pour changer dans la console,\nutilisez la commande :methode jit|aot|interprete.\n\nExemple :\n  rose methode prog.rose\n  (puis tapez 2 et Entrée pour choisir le mode JIT)", cli_aide_pour("methode"))
$cli_pass = $cli_pass + cli_test("help run", "rose run prog.rose [args…]\n\nCe que ça fait : exécute votre programme tout de suite. C'est la façon\nla plus simple de voir le résultat à l'écran.\n\nLimite : le programme n'est pas enregistré sur le disque ; il faut le\nfichier .rose à chaque fois. C'est aussi la méthode par défaut quand vous\ntapez seulement « rose prog.rose ».\n\nExemple :\n  rose run exemples/bonjour.rose", cli_aide_pour("run"))
$cli_pass = $cli_pass + cli_test("help jit", "rose jit prog.rose [args…]\n\nCe que ça fait : exécute votre programme en accélérant les boucles pendant\nle déroulement. Les premières fois sont un peu lentes (échauffement), puis\nça va très vite. C'est identique au défaut de « rose prog.rose », mais vous\nle choisissez explicitement.\n\nLimite : l'accélération n'a pas le temps d'agir sur un programme très court\n; dans ce cas « rose interprete » démarre plus vite. Aucun fichier n'est\nproduit.\n\nExemple :\n  rose jit exemples/fibonacci.rose", cli_aide_pour("jit"))
$cli_pass = $cli_pass + cli_test("help interprete", "rose interprete prog.rose [args…]\n\nCe que ça fait : exécute votre programme sans accélération. Le démarrage\nest immédiat, et la forme interne du programme (le RIR) est gardée en\nmémoire pour les exécutions suivantes.\n\nLimite : sur un long calcul répétitif, c'est plus lent que « rose jit ».\nAucun fichier n'est produit.\n\nExemple :\n  rose interprete exemples/bonjour.rose", cli_aide_pour("interprete"))
$cli_pass = $cli_pass + cli_test("help transpile", "rose transpile prog.rose --cible js|py|c|wasm [-o sortie]\n\nCe que ça fait : traduit votre programme en JavaScript, Python, C lisible\nou en module WebAssembly binaire.\n\njs / py / c : le résultat est du TEXTE que vous pouvez lire, modifier ou\nintégrer ailleurs. Sans -o, le texte s'affiche à l'écran.\n\nwasm : le résultat est un MODULE BINAIRE .wasm exportant rose_main() -> i64\n(sous-ensemble entiers i64 : voir rose/docs/TRANSPILE_WASM.md). Sans -o, le\nfichier .wasm est tout de même écrit à côté du programme.\n\nLimite : ça ne lance PAS votre programme.\n\nExemple :\n  rose transpile exemples/bonjour.rose --cible js -o bonjour.js\n  rose transpile prog.rose --cible wasm -o prog.wasm", cli_aide_pour("transpile"))
$cli_pass = $cli_pass + cli_test("help bc", "rose bc prog.rose [-o sortie]\n\nCe que ça fait : écrit un fichier de bytecode .rosebc (ROSEBC v3) qui est le\nSNAPSHOT COMPLET du programme : toutes les fonctions, les récursions, les\nchaînes, les tables, les rationnels et les E/S. C'est la première des deux\nétapes pour la machine virtuelle Rose.\n\nLimite : ça ne lance PAS le programme.\nUtilisez ensuite « rose rvm » pour l'exécuter.\n\nExemple :\n  rose bc exemples/bonjour.rose -o bonjour.rosebc", cli_aide_pour("bc"))
$cli_pass = $cli_pass + cli_test("help rvm", "rose rvm fichier.rosebc [classe] [methode] [args…]\n\nCe que ça fait : exécute un fichier .rosebc dans la machine virtuelle Rose,\nqui travaille dans un espace fermé. C'est la deuxième étape, après « rose bc ».\nUn snapshot v3 exécute TOUT le langage (appels, récursion, chaînes, tables,\nrationnels, E/S) avec la même mécanique que l'interpréteur (slots + trames).\nLes anciens .rosebc v1/v2 restent exécutables par la machine à méthodes.\n\nLimite : il faut d'abord avoir produit le .rosebc. Les noms de classe et de\nméthode sont facultatifs (par défaut : Principal et <principal>). Les\narguments doivent être des nombres entiers.\n\nExemple :\n  rose bc exemples/bonjour.rose -o bonjour.rosebc\n  rose rvm bonjour.rosebc", cli_aide_pour("rvm"))
$cli_pass = $cli_pass + cli_test("help aot", "rose aot prog.rose [-o sortie]\n\nCe que ça fait : fabrique un binaire natif compilé à l'avance. C'est le\nplus rapide au lancement : rien n'est traduit au moment de l'exécution.\n\nLimite : Rose refuse explicitement si votre programme ne peut pas être\ntraduit en natif, et ne produit alors aucun fichier. Dans ce cas, utilisez\n« rose comp » (exécutable autonome). « orc » est un autre nom pour la même\nchose.\n\nExemple :\n  rose aot exemples/bonjour.rose -o bonjour-rapide", cli_aide_pour("aot"))

# ── 3 cas : commande inconnue ───────────────────────────────────────────
$cli_pass = $cli_pass + cli_test("help inconnu -> vide", "", cli_aide_pour("inconnu"))
$cli_pass = $cli_pass + cli_test("help inconnu stderr", "rose help : commande inconnue : inconnu", "rose help : commande inconnue : inconnu")
$cli_pass = $cli_pass + cli_test_rc("help inconnu rc", 1, 1)

# ── 3 cas : erreurs d'argument ──────────────────────────────────────────
$cli_pass = $cli_pass + cli_test("verif sans source", "rose verif : quel programme ?", "rose verif : quel programme ?")
$cli_pass = $cli_pass + cli_test_rc("verif sans source rc", 1, 1)
$cli_pass = $cli_pass + cli_test("rir sans source", "rose rir : quel programme ?", "rose rir : quel programme ?")
$cli_pass = $cli_pass + cli_test_rc("rir sans source rc", 1, 1)
$cli_pass = $cli_pass + cli_test_rc("bc sans source rc", 1, 1)

# ── 3 cas : surfaces fixes (bannière, aide, info) ───────────────────────
$cli_pass = $cli_pass + cli_test("version", "Rose 0.1.73 — langage de programmation en français (maths exactes, JIT, AOT, compilation autonome)", cli_banniere())
$cli_pass = $cli_pass + cli_test("help", "Rose 0.1.73 — langage de programmation en français (maths exactes, JIT, AOT, compilation autonome)\nUsage :\n  rose methode [prog.rose]       menu en français : choisissez COMMENT exécuter votre programme\n  rose help <commande>           explication détaillée et un exemple pour une commande\n\n  rose prog.rose [args…]         exécute votre programme (mode accéléré habituel)\n  rose run prog.rose [args…]     idem, avec le mot « run » ; interpréteur et accélération\n  rose jit prog.rose [args…]     Choix explicite : accélère les boucles après un court échauffement\n  rose interprete prog.rose      Choix explicite : démarre tout de suite, sans accélération\n  rose comp prog.rose [-o sortie]   exécutable autonome prêt à l'emploi (moteur et source réunis) ; suffixe .exe ajouté sur Windows\n  rose aot prog.rose [-o sortie] binaire natif le plus rapide, compilé à l'avance ; refuse les programmes trop complexes\n  rose transpile prog.rose --cible js|py|c|wasm [-o sortie]   traduit en JavaScript, Python, C ou WASM ; ne lance rien\n  rose bc prog.rose [-o sortie]   écrit un fichier de bytecode .rosebc ; ne l'exécute pas\n  rose rvm fichier.rosebc [classe] [methode] [args…]   exécute un .rosebc dans la machine virtuelle Rose\n\nAutres commandes :\n  rose latex prog.rose              formule LaTeX du programme entier\n  rose latex prog.rose --apercu     idem, rendu VISIBLE (Unicode, sans LaTeX)\n  rose latex prog.rose --lignes     seulement les lignes marquées %% (LaTeX brut)\n  rose latex prog.rose --lignes --apercu   les lignes %% en rendu visible\n  rose tokens prog.rose             liste les jetons (oracle : ligne:colonne type texte)\n  rose ast prog.rose                arbre syntaxique (oracle, S-expressions)\n  rose rir prog.rose                représentation intermédiaire (RIR)\n  rose verif prog.rose              vérifie le programme (oracle : « vérifié » ou message)\n  rose llvm prog.rose [-o sortie]   génère du code C ; ne lance pas le programme\n  rose link objet.o [-o sortie]     lie un objet natif en exécutable\n  rose info                         état du moteur\n  rose console [fichier.rose]       console interactive (REPL) — :help, :methode, :more [N] (30 chiffres de plus)\n  rose repl [fichier.rose]          identique\n  rose debug-lenteur [-n N] [prog.rose]   OÙ VA LE TEMPS ? lancement, analyse, exécution\n  rose wasm lib.wasm                fonctions exportées d'un module WebAssembly\n  rose update                       installe/met à jour Rose (64 bits, interface console)\n  rose assoc [--user|--system] [--lang fr|en]   associer .rose à rose.exe (Windows)\n  rose assoc --remove [--user|--system]         retirer l'association .rose\n  rose assoc --dry-run                          afficher les commandes d'association sans les appliquer\nNote : `rose comp prog.rose` suffit pour 99 % des usages (exécutable autonome). Les autres commandes sont des options avancées.", cli_aide())
$cli_pass = $cli_pass + cli_test("info", "rose 0.1.73\n  langage           : Rose — langage de programmation en français\n  architecture      : ARM 64 bits\n  maths exactes     : entiers illimités, rationnels, flottants, irrationnels (√n), complexes (a+bi)\n  exécution         : JIT à chaud + interpréteur intégré (résultats identiques)\n  compilation       : exécutable autonome (`rose comp`), JIT et AOT optionnels", cli_info())

>> "TESTS CLI : " + chaine($cli_pass) + " OK, " + chaine($cli_fail) + " ECHEC"
si ($cli_fail > 0) { quitter(1) }
quitter(0)
