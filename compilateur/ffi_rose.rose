# ═══════════════════════════════════════════════════════════════════════════
# ffi_rose.rose — couche FFI / symbolique MINIMALE, écrite en Rose.
# Poste J6 §11. Worktree /tmp/opencode/horde_ffi (HEAD 101b48d).
#
# Ce fichier est un MODULE SOURCE, comme moteur_valeurs.rose / moteur_ops.rose :
# Rose n'a PAS d'instruction `include`. Il est concaténé avec
# compilateur/ffi_syscalls.rose et un pilote, puis compilé par C0 :
#
#   cat compilateur/ffi_rose.rose compilateur/ffi_syscalls.rose pilote.rose \
#       > /tmp/ffi/prog.rose
#   C0 /tmp/ffi/prog.rose > /tmp/ffi/prog.elf && ./prog.elf
#
# Il se vérifie TOUTEFOIS seul : `rose verif compilateur/ffi_rose.rose`.
#
# ── Ce que c'est ──────────────────────────────────────────────────────────
#  1. une TABLE DE SYMBOLES natives (nom, arité, types des paramètres, type
#     de retour), stockée sous forme de FONCTIONS — G5 replie les globales à
#     0 (G5_C0.md §6), donc aucune variable globale ici ;
#  2. un DISPATCHEUR `ffi_appeler(nom, nb, a0, a1)` qui contrôle l'arity et les
#     types avant d'atteindre l'adaptateur natif ;
#  3. une GESTION D'ERREURS explicite : un résultat est une valeur TAGUÉE
#     `liste<entier>` dont le tag 7 porte un code d'erreur (jamais une
#     exception, jamais un type1869 disparate selon le backend) ;
#  4. CINQ primitives réellement appelables depuis un ELF C0 :
#     ecrire_bytes, lire_texte, temps, hasard, chaine (+ graine, eval_expr).
#
# ── Signatures exactes lues dans rose/src/interp.rs (LECTURE SEULE) ────────
#   "ecrire_bytes" : (chaine chemin, chaine octets) -> entier   (interp.rs:6397)
#                    chaque caractère est tronqué à 1 octet (`c as u8`),
#                    std::fs::write, retour Valeur::z(0).
#   "lire_texte"   : (chaine chemin) -> chaine                  (interp.rs:5920)
#                    ChaineRep::depuis_fichier, mmap lecture seule.
#   "temps"        : () -> entier                               (interp.rs:6421)
#                    run::temps_unix_nanos() (u64) retagué Gz.
#   "hasard"       : (entier n) -> entier                       (interp.rs:5654)
#                    run::hasard : splitmix64 + Lemire, n > 0.
#   "chaine"       : (x) -> chaine                              (interp.rs:5126)
#                    Valeur::s(chaine_de(&v)).
#   "graine"       : (entier n) -> vide                         (interp.rs:5651)
#                    graine_de() tire UNE fois (rng_tirer).
#   "eval_expr"    : (chaine expr) -> valeur                    (interp.rs:5940)
#   "charger"      : (chaine chemin) -> entier (poignée dlopen)  (interp.rs:5396)
#   "appeler0"     : (entier h, chaine sym) -> flottant          (interp.rs:5413)
#   "appeler1"     : (entier h, chaine sym, flottant a) -> flottant
#   "appeler2"     : (entier h, chaine sym, flottant a, flottant b) -> flottant
#
# ── Discipline G5 (SELF_HOST_SH3 / G5_C0 / J6) ────────────────────────────
#   • aucune variable globale ; tout voyage en paramètre ;
#   • pas de `[]` littéral : toute liste est rembourrée à l'index 0 ;
#   • `retour [ ... ]` interdit : on construit un local puis `retour $r` ;
#   • pas d'affectation par index sur une liste ;
#   • aucun paramètre nommé `i` (l'imaginaire en Rose) ;
#   • `et` / `ou` sont des ET/OU BIT À BIT non court-circuitants en G5 :
#     on ne les utilise QUE sur des comparaisons d'entiers, jamais pour
#     protéger un accès hors bornes.
#
# ── ABI des valeurs FFI (une valeur = une `liste<entier>` plate) ───────────
#   tag 0 = VIDE       [0]
#   tag 1 = ENTIER     [1, n]
#   tag 2 = BOOLEEN    [2, 0|1]
#   tag 3 = CHAINE     [3, c0, c1, ...]   codes de caractères
#   tag 7 = ERREUR     [7, code]
# ═══════════════════════════════════════════════════════════════════════════

# ── 0. Tags et codes d'erreur ──────────────────────────────────────────────

fn fx_tag_vide() -> entier { retour 0 }
fn fx_tag_ent() -> entier { retour 1 }
fn fx_tag_boo() -> entier { retour 2 }
fn fx_tag_ch() -> entier { retour 3 }
fn fx_tag_err() -> entier { retour 7 }

fn fx_err_inconnu() -> entier { retour 1 }
fn fx_err_arite() -> entier { retour 2 }
fn fx_err_type() -> entier { retour 3 }
fn fx_err_exec() -> entier { retour 4 }
fn fx_err_indispo() -> entier { retour 6 }

fn fx_erreur_texte(c: entier) -> chaine {
  si (c == 1) { retour "symbole inconnu" }
  si (c == 2) { retour "arite incorrecte" }
  si (c == 3) { retour "type incorrect" }
  si (c == 4) { retour "execution impossible" }
  si (c == 6) { retour "primitive non disponible sous G5" }
  retour "erreur inconnue"
}

# ── 1. Constructeurs / accesseurs de valeurs taguées ───────────────────────

fn fx_vide() -> liste<entier> { $r = [0]; retour $r }
fn fx_ent(n: entier) -> liste<entier> { $r = [1, n]; retour $r }
fn fx_boo(b: entier) -> liste<entier> {
  $x = 0
  si (b != 0) { $x = 1 }
  $r = [2, $x]
  retour $r
}

# Même constructeur mais à partir d'un VRAI booléen Rose (comparaison),
# utile au pilote pour éviter `chaine(booléen)`, non conforme sous G5.
fn fx_boo2(b: booleen) -> liste<entier> {
  $x = 0
  si (b) { $x = 1 }
  $r = [2, $x]
  retour $r
}
fn fx_err(c: entier) -> liste<entier> { $r = [7, c]; retour $r }

fn fx_ch(s: chaine) -> liste<entier> {
  $r = [3]
  $k = 0
  $n = longueur(s)
  tant_que ($k < $n) {
    joindre($r, ordre(sous_chaine(s, $k, $k + 1)))
    $k = $k + 1
  }
  retour $r
}

fn fx_tag(v: liste<entier>) -> entier { retour v[0] }
fn fx_ent_val(v: liste<entier>) -> entier { retour v[1] }
fn fx_boo_val(v: liste<entier>) -> entier { retour v[1] }
fn fx_est_vide(v: liste<entier>) -> entier {
  si (v[0] == 0) { retour 1 }
  retour 0
}
fn fx_est_err(v: liste<entier>) -> entier {
  si (v[0] == 7) { retour 1 }
  retour 0
}
fn fx_err_code(v: liste<entier>) -> entier { retour v[1] }
fn fx_ch_long(v: liste<entier>) -> entier { retour longueur(v) - 1 }
fn fx_ch_code(v: liste<entier>, k: entier) -> entier { retour v[1 + k] }

fn fx_ch_de(v: liste<entier>) -> chaine {
  $s = ""
  $k = 0
  $n = longueur(v) - 1
  tant_que ($k < $n) {
    $s = $s + caractere(v[1 + $k])
    $k = $k + 1
  }
  retour $s
}

# Rend une valeur FFI sous forme de chaîne lisible (pour les diagnostics).
fn fx_vers_chaine(v: liste<entier>) -> chaine {
  si (v[0] == 0) { retour "<vide>" }
  si (v[0] == 1) { retour chaine(v[1]) }
  si (v[0] == 2) {
    si (v[1] == 0) { retour "faux" }
    retour "vrai"
  }
  si (v[0] == 3) { retour fx_ch_de(v) }
  si (v[0] == 7) { retour "erreur:" + fx_erreur_texte(v[1]) }
  retour "<?>"
}

# ── 2. TABLE DE SYMBOLES NATIFS ────────────────────────────────────────────
# Encodée en fonctions (pas de globales). Codes de types :
#   c = chaine, e = entier, b = booleen, f = flottant,
#   x = scalaire quelconque, v = vide.

fn fx_nb_symbols() -> entier { retour 11 }

fn fx_sym_nom(k: entier) -> chaine {
  si (k == 0) { retour "ecrire_bytes" }
  si (k == 1) { retour "lire_texte" }
  si (k == 2) { retour "temps" }
  si (k == 3) { retour "hasard" }
  si (k == 4) { retour "chaine" }
  si (k == 5) { retour "graine" }
  si (k == 6) { retour "eval_expr" }
  si (k == 7) { retour "charger" }
  si (k == 8) { retour "appeler0" }
  si (k == 9) { retour "appeler1" }
  si (k == 10) { retour "appeler2" }
  retour ""
}

fn fx_sym_arite(k: entier) -> entier {
  si (k == 0) { retour 2 }
  si (k == 1) { retour 1 }
  si (k == 2) { retour 0 }
  si (k == 3) { retour 1 }
  si (k == 4) { retour 1 }
  si (k == 5) { retour 1 }
  si (k == 6) { retour 1 }
  si (k == 7) { retour 1 }
  si (k == 8) { retour 2 }
  si (k == 9) { retour 3 }
  si (k == 10) { retour 4 }
  retour -1
}

fn fx_sym_params(k: entier) -> chaine {
  si (k == 0) { retour "cc" }
  si (k == 1) { retour "c" }
  si (k == 2) { retour "" }
  si (k == 3) { retour "e" }
  si (k == 4) { retour "x" }
  si (k == 5) { retour "e" }
  si (k == 6) { retour "c" }
  si (k == 7) { retour "c" }
  si (k == 8) { retour "ec" }
  si (k == 9) { retour "ecc" }
  si (k == 10) { retour "eccc" }
  retour ""
}

fn fx_sym_ret(k: entier) -> chaine {
  si (k == 0) { retour "e" }
  si (k == 1) { retour "c" }
  si (k == 2) { retour "e" }
  si (k == 3) { retour "e" }
  si (k == 4) { retour "c" }
  si (k == 5) { retour "v" }
  si (k == 6) { retour "c" }
  si (k == 7) { retour "e" }
  si (k == 8) { retour "f" }
  si (k == 9) { retour "f" }
  si (k == 10) { retour "f" }
  retour "v"
}

fn fx_trouver(nom: chaine) -> entier {
  $k = 0
  $n = fx_nb_symbols()
  tant_que ($k < $n) {
    si (fx_sym_nom($k) == nom) { retour $k }
    $k = $k + 1
  }
  retour -1
}

# ── 3. Contrôle de types ───────────────────────────────────────────────────

fn fx_type_ok(v: liste<entier>, code: chaine) -> entier {
  $t = v[0]
  si (code == "c") {
    si ($t == 3) { retour 1 }
    retour 0
  }
  si (code == "e") {
    si ($t == 1) { retour 1 }
    retour 0
  }
  si (code == "b") {
    si ($t == 2) { retour 1 }
    retour 0
  }
  si (code == "x") {
    si ($t == 0) { retour 1 }
    si ($t == 1) { retour 1 }
    si ($t == 2) { retour 1 }
    si ($t == 3) { retour 1 }
    retour 0
  }
  si (code == "v") { retour 1 }
  retour 0
}

# ── 4. Shim du syscall manquant : horloge ──────────────────────────────────
# `temps()` n'est PAS émis par l'émetteur G5 (recherche confirmée : aucune
# occurrence de "temps" dans compilateur/emetteur_elf.rose) : l'appel tombe
# sur $g5_stub0l, qui rend 0. Le shim lit donc l'horloge noyau via un vrai
# syscall déjà émis (openat/read/close de lire_texte) sur
# /sys/class/rtc/rtc0/since_epoch, puis normalise en SECONDES.
#   • sous Rust : temps() > 0 -> on utilise l'horloge native ;
#   • sous G5   : temps() == 0 -> repli sysfs.
# Normalisation en secondes : un entier G5 est `n<<3`, donc plafonné à 2^60 ;
# les nanosecondes Unix (~1,8e18) déborderaient. `secondes` tient largement.
# La version autonome de ce shim est dans compilateur/ffi_syscalls.rose.

fn fx_sysfs_secondes() -> entier {
  $s = lire_texte("/sys/class/rtc/rtc0/since_epoch")
  $n = entier($s)
  si ($n <= 0) { retour 0 }
  retour $n
}

fn fx_temps_secondes() -> entier {
  $t = temps()
  $sec = 0
  si ($t > 0) { $sec = $t div 1000000000 }
  si ($sec == 0) { $sec = fx_sysfs_secondes() }
  retour $sec
}

# ── 5. Adaptateurs natifs ──────────────────────────────────────────────────

fn fx_nat_ecrire_bytes(a0: liste<entier>, a1: liste<entier>) -> liste<entier> {
  $p = fx_ch_de($a0)
  $d = fx_ch_de($a1)
  ecrire_bytes($p, $d)
  retour fx_ent(0)
}

fn fx_nat_lire_texte(a0: liste<entier>) -> liste<entier> {
  $p = fx_ch_de($a0)
  $s = lire_texte($p)
  si (longueur($s) == 0) { retour fx_err(fx_err_exec()) }
  retour fx_ch($s)
}

fn fx_nat_temps() -> liste<entier> {
  retour fx_ent(fx_temps_secondes())
}

fn fx_nat_hasard(a0: liste<entier>) -> liste<entier> {
  $n = fx_ent_val($a0)
  si ($n <= 0) { retour fx_err(fx_err_exec()) }
  retour fx_ent(hasard($n))
}

fn fx_nat_chaine(a0: liste<entier>) -> liste<entier> {
  $t = fx_tag($a0)
  si ($t == 0) { retour fx_ch("<vide>") }
  si ($t == 2) {
    si (fx_boo_val($a0) == 0) { retour fx_ch("faux") }
    retour fx_ch("vrai")
  }
  si ($t == 3) { retour $a0 }
  si ($t == 1) { retour fx_ch(chaine(fx_ent_val($a0))) }
  retour fx_err(fx_err_type())
}

fn fx_nat_graine(a0: liste<entier>) -> liste<entier> {
  graine(fx_ent_val($a0))
  retour fx_vide()
}

# eval_expr minimal : littéral entier, ou `a+b` / `a-b` sur entiers.
# Le moteur Rust accepte bien plus (voir interp.rs:5940) ; cette couche
# symbolique minimale couvre le sous-ensemble déterministe vérifiable.
fn fx_eval_simple(e: chaine) -> chaine {
  $n = longueur(e)
  $k = 1
  $op = ""
  tant_que ($k < $n) {
    $c = sous_chaine(e, $k, $k + 1)
    si ($c == "+" ou $c == "-") { $op = $c }
    $k = $k + 1
  }
  si ($op == "") { retour e }
  $p = 1
  $g = 0
  $j = 1
  tant_que ($j < $n) {
    $c = sous_chaine(e, $j, $j + 1)
    si ($c == $op) { $g = $j }
    $j = $j + 1
  }
  $a = entier(sous_chaine(e, 0, $g))
  $b = entier(sous_chaine(e, $p + $g, $n))
  si ($op == "+") { retour chaine($a + $b) }
  retour chaine($a - $b)
}

fn fx_nat_eval_expr(a0: liste<entier>) -> liste<entier> {
  retour fx_ch(fx_eval_simple(fx_ch_de($a0)))
}

# ── 6. DISPATCHEUR — ffi_appeler(nom, nb, a0, a1) ─────────────────────────

fn ffi_appeler(nom: chaine, nb: entier, a0: liste<entier>, a1: liste<entier>) -> liste<entier> {
  $k = fx_trouver(nom)
  si ($k < 0) { retour fx_err(fx_err_inconnu()) }

  $ar = fx_sym_arite($k)
  # dlopen/dlsym et appeler1/2 dépassent l'ABI à deux arguments de ce
  # dispatcheur : ils sont déclarés (signature connue) mais non émulables
  # sous G5. C'est une erreur explicite, pas un plantage.
  si ($ar > 2) { retour fx_err(fx_err_indispo()) }

  # `nb` est TRANSMIS explicitement : une valeur VIDE `[0]` peut être un
  # argument réel (ex. chaine(vide)), on ne peut donc pas l'utiliser comme
  # marqueur d'absence (piège détecté par le test ch_vide).
  si ($nb != $ar) { retour fx_err(fx_err_arite()) }

  $types = fx_sym_params($k)
  si ($nb >= 1) {
    si (fx_type_ok($a0, sous_chaine($types, 0, 1)) == 0) {
      retour fx_err(fx_err_type())
    }
  }
  si ($nb >= 2) {
    si (fx_type_ok($a1, sous_chaine($types, 1, 2)) == 0) {
      retour fx_err(fx_err_type())
    }
  }

  si ($k == 0) { retour fx_nat_ecrire_bytes($a0, $a1) }
  si ($k == 1) { retour fx_nat_lire_texte($a0) }
  si ($k == 2) { retour fx_nat_temps() }
  si ($k == 3) { retour fx_nat_hasard($a0) }
  si ($k == 4) { retour fx_nat_chaine($a0) }
  si ($k == 5) { retour fx_nat_graine($a0) }
  si ($k == 6) { retour fx_nat_eval_expr($a0) }
  si ($k == 7) { retour fx_err(fx_err_indispo()) }
  si ($k == 8) { retour fx_err(fx_err_indispo()) }
  retour fx_err(fx_err_inconnu())
}

# ── 7. API publique — 5 primitives réellement appelables ───────────────────

fn ffi_ecrire_bytes(chemin: chaine, octets: chaine) -> liste<entier> {
  retour ffi_appeler("ecrire_bytes", 2, fx_ch(chemin), fx_ch(octets))
}

fn ffi_lire_texte(chemin: chaine) -> liste<entier> {
  retour ffi_appeler("lire_texte", 1, fx_ch(chemin), fx_vide())
}

fn ffi_temps() -> liste<entier> {
  retour ffi_appeler("temps", 0, fx_vide(), fx_vide())
}

fn ffi_hasard(n: entier) -> liste<entier> {
  retour ffi_appeler("hasard", 1, fx_ent(n), fx_vide())
}

fn ffi_chaine(v: liste<entier>) -> liste<entier> {
  retour ffi_appeler("chaine", 1, v, fx_vide())
}

fn ffi_graine(n: entier) -> liste<entier> {
  retour ffi_appeler("graine", 1, fx_ent(n), fx_vide())
}

fn ffi_eval_expr(expr: chaine) -> liste<entier> {
  retour ffi_appeler("eval_expr", 1, fx_ch(expr), fx_vide())
}
