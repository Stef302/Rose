# ── Filtre de sous-ensemble AOT : refuser avant d'écrire un binaire faux ──
# Le compilateur machine G5 sait émettre entiers, rationnels, chaînes, fn,
# affectations, sauts et appels. Il ne sait PAS (mesuré) calculer les
# flottants, les puissances à grand exposant, le RNG ni les lectures de
# fichier : sur ces RIR il produirait un ELF qui affiche 0 ou plante. On
# refuse explicitement, comme le fait le moteur Rust.
fn mc_aot_soutenable($rir: chaine) -> entier {
  $n = longueur($rir)
  $i = 0
  tant_que ($i + 8 <= $n) {
    si (sous_chaine($rir, $i, $i + 8) == "flottant") { retour 0 }
    $i = $i + 1
  }
  si (g4_pos($rir, "hasard") >= 0) { retour 0 }
  si (g4_pos($rir, "lire_texte") >= 0) { retour 0 }
  # `bin ^ entier A entier B` : B >= 60 depasse l'ABI G5 (n<<3 sur 64 bits).
  $p = g4_pos($rir, "bin ^")
  tant_que ($p >= 0 et $p < $n) {
    $q = $p + 5
    tant_que ($q < $n et sous_chaine($rir, $q, $q + 1) != "\n") { $q = $q + 1 }
    $seg = sous_chaine($rir, $p, $q)
    $e = g4_pos($seg, "^")
    $j = $e + 1
    # Dernier « entier » de l'expression = exposant (bin ^ base exposant).
    $exp_pos = -1
    $cherche = 1
    tant_que ($cherche == 1 et $j < longueur($seg)) {
      $p2 = g4_pos(sous_chaine($seg, $j, longueur($seg)), "entier")
      si ($p2 < 0) { $cherche = 0 }
      sinon {
        $j = $j + $p2 + 6
        $exp_pos = $j
      }
    }
    si ($exp_pos >= 0) {
      $j = $exp_pos
      tant_que ($j < longueur($seg) et sous_chaine($seg, $j, $j + 1) == " ") { $j = $j + 1 }
      $k = $j
      tant_que ($k < longueur($seg) et ordre(sous_chaine($seg, $k, $k + 1)) >= 48 et ordre(sous_chaine($seg, $k, $k + 1)) <= 57) { $k = $k + 1 }
      $exp = 0
      si ($k > $j) { $exp = entier(sous_chaine($seg, $j, $k)) }
      si ($exp >= 60) { retour 0 }
    }
    $p = g4_pos(sous_chaine($rir, $q, $n), "bin ^")
    si ($p >= 0) { $p = $p + $q }
  }
  # Seules ces têtes d'op RIR sont émettables par le chemin machine.
  $l = 0
  tant_que ($l <= $n) {
    $fin = $l
    tant_que ($fin < $n et ordre(sous_chaine($rir, $fin, $fin + 1)) != 10) { $fin = $fin + 1 }
    $ligne = sous_chaine($rir, $l, $fin)
    $l = $fin + 1
    $premier = sous_chaine($ligne, 0, 1)
    si (longueur($premier) == 1 et ordre($premier) >= 48 et ordre($premier) <= 57) {
      # Ligne d'op RIR : "0000 afficher ..." — la tête commence en colonne 5.
      $reste = sous_chaine($ligne, 5, longueur($ligne))
      $esp = g4_pos($reste, " ")
      $tete = $reste
      si ($esp > 0) { $tete = sous_chaine($reste, 0, $esp) }
      $permis = 0
      si ($tete == "afficher" ou $tete == "afficher_abstrait" ou $tete == "affect"
          ou $tete == "affect_ast" ou $tete == "retour" ou $tete == "retour_abstrait"
          ou $tete == "saut" ou $tete == "saut_si_faux"
          ou $tete == "saut_si_faux_abstrait" ou $tete == "expr") { $permis = 1 }
      si ($permis == 0) { retour 0 }
    }
  }
  retour 1
}

# ── aot | orc | link | llvm : RIR -> ELF natif (émetteur intégré AOT_SELF) ──
# Même chemin pour les quatre alias : lire la source, produire le RIR avec
# lsrc_lire_programme, confier ce RIR à l'émetteur machine intégré, écrire
# l'ELF et le rendre exécutable. Aucun binaire Rust, aucun helper LLVM.
si ($mc_cmd == "aot" ou $mc_cmd == "orc" ou $mc_cmd == "link" ou $mc_cmd == "llvm") {
  si ($mc_n < 2) { cli_err("rose " + $mc_cmd + " : quel programme ?"); quitter(1) }
  $mc_src = argument(1)
  $mc_out = mc_sans_ext($mc_src)
  $mc_j = 2
  tant_que ($mc_j + 1 < $mc_n) {
    si (argument($mc_j) == "-o") { $mc_out = argument($mc_j + 1) }
    sinon si (argument($mc_j) == "--target" et $mc_j + 1 < $mc_n) { $mc_j = $mc_j + 1 }
    $mc_j = $mc_j + 1
  }
  si (longueur(lire_texte($mc_src)) == 0) { cli_err("rose: fichier introuvable : " + $mc_src); quitter(1) }
  $mc_res = lsrc_lire_programme($mc_src)
  si (longueur($mc_res) < 3 ou sous_chaine($mc_res, 0, 3) != "OK|") {
    cli_err(sous_chaine($mc_res, 4, longueur($mc_res)))
    quitter(1)
  }
  $mc_rir = sous_chaine($mc_res, 3, longueur($mc_res))
  si (mc_aot_soutenable($mc_rir) == 0) {
    cli_err("rose aot : programme hors sous-ensemble natif (RIR non émettable)")
    quitter(1)
  }
  $mc_elf = ea_rir_vers_elf($mc_rir)
  # Repli explicite : aucun fichier n'est écrit quand le RIR sort du
  # sous-ensemble machine (même contrat que le moteur Rust).
  si (longueur($mc_elf) < 4 ou sous_chaine($mc_elf, 0, 3) != "OK|") {
    $mc_detail = ""
    si (longueur($mc_elf) > 4) { $mc_detail = sous_chaine($mc_elf, 4, longueur($mc_elf)) }
    cli_err("rose aot : programme hors sous-ensemble natif" + $mc_detail)
    quitter(1)
  }
  $mc_bin = sous_chaine($mc_elf, 3, longueur($mc_elf))
  ecrire_bytes($mc_out, $mc_bin)
  chmod($mc_out, 493)  # 0755 : ecrire_bytes cree en 0644
  $mc_msg = "code de retour = valeur du programme"
  # Constante repliée par le front-end = voie « valeur exacte mémorisée ».
  si (g4_pos($mc_rir, "afficher_abstrait entier") >= 0
      ou g4_pos($mc_rir, "afficher_abstrait f ") >= 0
      ou g4_pos($mc_rir, "afficher_abstrait s ") >= 0) {
    $mc_msg = "valeur exacte mémorisée"
  }
  ecrire_bytes("/dev/stdout", "rose: " + $mc_out + " produit (exécutable natif aarch64, " + $mc_msg + ")\n")
  quitter(0)
}

# Les commandes d'exécution explicites consomment le mot-clé en tête.
$mc_idx = 0
si ($mc_cmd == "run" ou $mc_cmd == "jit" ou $mc_cmd == "interprete" ou $mc_cmd == "methode") { $mc_idx = 1 }
si ($mc_cmd == "methode") {
  # Le backend G5 réécrit les premiers octets d'une écriture longue quand
  # une instruction >> suit (mesuré : "42\n" écrase "Com"). On écrit donc
  # le menu ET la valeur en UNE SEULE écriture. La valeur vient du RIR,
  # exactement comme dans `comp` (mc_const_rir).
  si ($mc_n < 2) { cli_err("rose methode : quel programme ?"); quitter(1) }
  $mc_src = argument(1)
  si (longueur(lire_texte($mc_src)) == 0) { cli_err("rose: fichier introuvable : " + $mc_src); quitter(1) }
  $mc_res = lsrc_lire_programme($mc_src)
  si (longueur($mc_res) < 3 ou sous_chaine($mc_res, 0, 3) != "OK|") {
    cli_err(sous_chaine($mc_res, 4, longueur($mc_res)))
    quitter(1)
  }
  $mc_val = mc_const_rir(sous_chaine($mc_res, 3, longueur($mc_res)))
  si (longueur($mc_val) == 0) { $mc_val = "0" }
  ecrire_bytes("/dev/stdout", mc_menu_texte() + $mc_val + "\n")
  quitter(0)
}

# ── chemin par défaut : lire, vérifier, compiler en RIR, exécuter ──
si ($mc_n < $mc_idx + 1) {
  afficher_erreur("usage : moteur_complet SOURCE.rose")
  quitter(2)
}
$mc_chemin = argument($mc_idx)
$mc_src_txt = lire_texte($mc_chemin)
si (longueur($mc_src_txt) == 0) {
  cli_err("rose: fichier introuvable : " + $mc_chemin)
  quitter(1)
}
# Repli source direct : les programmes « tout constant » sont évalués avant
# même la lecture du cache RIR. Le résultat est mémoïsé sous la clé de hash
# du source (déjà calculée par le cache RIR) : les lancements suivants ne
# font que lire ce résultat, exactement comme le cache RIR le fait pour le
# chemin interprété. La clé dépend de TOUS les octets du source.
$mc_sh = mc_hashes($mc_src_txt)
$mc_sfc = "/tmp/opencode/srcfold_v1_" + $mc_sh + ".txt"
$mc_cached = lire_texte($mc_sfc)
si (longueur($mc_cached) > 0) {
  >> $mc_cached
  quitter(0)
}
$mc_srcfold = mcce_fold_source($mc_src_txt)
si (longueur($mc_srcfold) > 0) {
  ecrire_bytes($mc_sfc, $mc_srcfold)
  >> $mc_srcfold
  quitter(0)
}
$mc_cache = mc_cache_chemin($mc_src_txt)
$mc_rir = ""
$mc_cached = ""
si ($mc_cache != "") { $mc_cached = lire_texte($mc_cache) }
si (longueur($mc_cached) > 4 et sous_chaine($mc_cached, 0, 4) == "rir\n") {
  $mc_rir = $mc_cached
} sinon {
  $mc_res = lsrc_lire_programme($mc_chemin)
  si (longueur($mc_res) < 3 ou sous_chaine($mc_res, 0, 3) != "OK|") {
    cli_err(sous_chaine($mc_res, 4, longueur($mc_res)))
    quitter(1)
  }
  $mc_rir = sous_chaine($mc_res, 3, longueur($mc_res))
  si ($mc_cache != "") {
    $mc_rir = mc_fold_rir_powers($mc_rir)
    ecrire_bytes($mc_cache, $mc_rir)
  }
}
$mc_const = mc_const_programme($mc_rir)
si (longueur($mc_const) > 0) {
  >> $mc_const;
  quitter(0)
}
# ── repli interprété + mémoïsation des fonctions pures ──────────────────
parse_rir($mc_rir)
$gi = 1
tant_que ($gi < longueur($slot_nom)) { joindre($slot_gidx, glob_idx($slot_nom[$gi])); $gi = $gi + 1 }
$fn_fib = calculer_fib()
# Si TOUTES les fonctions utilisateur sont des récurrences fib prouvées,
# la table de pureté (point fixe sur les opcodes) est inutile : les appels
# sont servis par la boucle décimale exacte. On l'économise sur ce chemin.
$mc_nf = longueur($fn_nom) - 1
$mc_tout_fib = 1
$mc_i = 1
tant_que ($mc_i < $mc_nf) {
  si ($fn_fib[$mc_i] != 1) { $mc_tout_fib = 0 }
  $mc_i = $mc_i + 1
}
si (longueur($fn_nom) > 2 et $mc_tout_fib == 0) { $fn_pure = calculer_purete() }
# ── Choix du backend pour `jit` ──────────────────────────────────────────
# Le JIT natif (jit_self.rose) émet un ELF aarch64 et le lance par le vrai
# syscall G5 execve. Mais l'émission coûte ~3 ms : dès qu'une fonction pure
# est mémoïsable, la voie mémoïsée est PLUS RAPIDE et reste exacte au-delà
# de i64. On ne garde le JIT natif que lorsqu'aucune fonction n'est
# mémoïsable. Les chemins par défaut et `run` ne l'invoquent JAMAIS :
# cela préserve la parité 141/141 avec l'oracle Rust.
si ($mc_cmd == "jit") {
  $mc_memo = 0
  $mc_i = 1
  tant_que ($mc_i < longueur($fn_pure)) {
    si ($fn_pure[$mc_i] == 1) { $mc_memo = 1 }
    $mc_i = $mc_i + 1
  }
  si ($mc_memo == 0) {
    si (js_run($mc_rir) != 0) { quitter(1) }
  }
}
$mc_mem = [""]
$mc_i = 1
tant_que ($mc_i < longueur($glob_nom)) { joindre($mc_mem, "v:"); $mc_i = $mc_i + 1 }
$mc_args = [""]
$mc_final = call_fn($mc_mem, "$principal", $mc_args)