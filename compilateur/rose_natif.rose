# rose_natif_elf.rose — compilateur .rose -> ELF64 aarch64 (Linux), généré (NE PAS ÉDITER).
# Généré par scripts/generer_rose_natif.py depuis :
#   compilateur/emetteur.rose      (front-end source -> RIR)
#   compilateur/emetteur_elf.rose  (backend RIR -> binaire G5)
# Usage : rose rose_natif_elf.rose programme.rose > programme.elf
#
fn rnat_flat($s: chaine) -> chaine {
  retour sous_chaine($s, 0, longueur($s))
}

# Joint équilibré : chaque niveau recopie au plus la longueur totale, donc
# O(n*log n) octets alloués au lieu de O(n^2) pour `s = s + morceau`.
# (Le `+` du runtime G5 COPIE les deux chaînes — pas de rope, contrairement
# au moteur Rust — et les ancres ne sont pas libérées : chaque concaténation
# en bouche est un leak.)
fn rnat_join($p: liste<chaine>, $d: entier, $f: entier) -> chaine {
  si ($f - $d <= 1) {
    si ($f - $d == 1) { retour $p[$d] }
    retour ""
  }
  $m = ($d + $f) div 2
  retour rnat_join($p, $d, $m) + rnat_join($p, $m, $f)
}

# emetteur.rose — jalon M4.3 : l'émetteur RIR auto-hébergé ROSE.
#
# Lit le programme passé en argument et rejoue TOUTE la chaîne du moteur :
# lexage, analyse descendante (AST en pools de nœuds plats), repli de
# constantes (les flottants repliés portent le texte exact que le moteur
# écrit dans le RIR), vérification de types — enrichie de deux notes :
# le type vérifié de chaque nœud et le type de lecture de chaque « lire » —
# puis ÉMISSION : le dump RIR octet pour octet de l'oracle `rose rir`.
# Rejet : le message exact, comme verifieur.rose. Validation :
# rose-cpp/tests/emetteur.py — les 103 fichiers de verifieur.py plus
# l'émetteur lui-même, par les trois voies.
#
# DISCIPLINES (M4.0/M4.1) : pas de courts-circuits (tout index dangereux est
# abrité) ; aucune globale visible des fonctions (tout voyage en paramètre) ;
# listes rembourrées à l'index 0 (le vérificateur refuse []) ; on ne peut que
# joindre — les pools sont construits en post-ordre, un indice de nœud n'est
# jamais réécrit. Erreurs : liste partagée $err — la première gagne, les
# appels suivants passent à vide (garde d'entrée partout).
#
# Pools de nœuds : listes parallèles, le nœud i est à la position i+1.
# Champs : genre (lit/ch/bol/v/lst/idx/uni/fac/app/bin), texte brut, drapeau
# flottant, indices gauche/droite, arguments (pool $al, départ $as, nombre
# $ac), ligne. Instructions : aff/lire/affi/si/tq/pour/retour/expr/bloc, nom,
# deux expressions, deux corps (indices séparés par des virgules), ligne.
# Types encodés « base|élément ».

# ══════════════════ lexage — utilitaires miroir ══════════════════

fn est_chiffre(c: entier) -> booleen {
  retour c >= 48 et c <= 57
}

fn est_lettre(c: entier) -> booleen {
  si (c < 128) {
    retour (c >= 65 et c <= 90) ou (c >= 97 et c <= 122) ou c == 95
  }
  retour (c >= 192 et c <= 214) ou (c >= 216 et c <= 246) ou (c >= 248 et c <= 767) ou (c >= 880 et c <= 1279) ou (c >= 7680 et c <= 8191)
}

fn est_suite(c: entier) -> booleen {
  si (c < 128) {
    retour est_lettre(c) ou est_chiffre(c)
  }
  retour est_lettre(c)
}

fn paire(a: entier, b: entier) -> chaine {
  si (a == 60 et b == 61) { retour "<=" }
  si (a == 62 et b == 61) { retour ">=" }
  si (a == 61 et b == 61) { retour "==" }
  si (a == 33 et b == 61) { retour "!=" }
  si (a == 47 et b == 61) { retour "!=" }
  si (a == 63 et b == 61) { retour "≈" }
  si (a == 61 et b == 126) { retour "≈" }
  si (a == 126 et b == 61) { retour "≈" }
  retour ""
}

fn uni(c: entier) -> chaine {
  si (c == 8776) { retour "≈" }
  si (c == 8804) { retour "<=" }
  si (c == 8805) { retour ">=" }
  si (c == 8800) { retour "!=" }
  si (c == 215) { retour "*" }
  si (c == 8901) { retour "*" }
  si (c == 183) { retour "*" }
  si (c == 247) { retour "div" }
  si (c == 8592) { retour "=" }
  si (c == 8594) { retour "->" }
  si (c == 8730) { retour "racine" }
  retour ""
}

fn car(c: entier) -> chaine {
  si (c == 43) { retour "+" }
  si (c == 45) { retour "-" }
  si (c == 42) { retour "*" }
  si (c == 47) { retour "/" }
  si (c == 58) { retour ":" }
  si (c == 37) { retour "%" }
  si (c == 94) { retour "^" }
  si (c == 33) { retour "!" }
  si (c == 46) { retour "." }
  si (c == 44) { retour "," }
  si (c == 63) { retour "?" }
  si (c == 40) { retour "(" }
  si (c == 41) { retour ")" }
  si (c == 123) { retour "{" }
  si (c == 125) { retour "}" }
  si (c == 91) { retour "[" }
  si (c == 93) { retour "]" }
  si (c == 59) { retour ";" }
  si (c == 60) { retour "<" }
  si (c == 62) { retour ">" }
  si (c == 126) { retour "~" }
  si (c == 64) { retour "@" }
  retour ""
}

# ——— lectureurs de la table de jetons (claqués sur l'eof) ———

fn T0($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn VX0($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn T1($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p + 1
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn VX1($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p + 1
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn GL0($gl: liste<entier>, $p: entier) -> entier {
  $n = longueur($gl)
  $q = $p
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $gl[$q]
}

fn EMOT($g: liste<chaine>, $x: liste<chaine>, $p: entier, $m: chaine) -> booleen {
  $t = T0($g, $p)
  retour ($t == "ident" ou $t == "mot") et VX0($x, $p) == $m
}

# ——— décodage du couple « position|nœud » (les nœuds sont des entiers ici) ———

fn SEPR($r: chaine) -> entier {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour entier(sous_chaine($r, 0, $q))
}

fn NOD($r: chaine) -> chaine {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour sous_chaine($r, $q + 1, $n)
}

# ══════════════════ types « base|élément » ══════════════════

fn nomty($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  $base = sous_chaine($v, 0, $k)
  $elt = sous_chaine($v, $k + 1, $n)
  si ($base != "liste") { retour $base }
  si ($elt == "liste") { retour "liste<liste<vide>>" }
  retour "liste<" + $elt + ">"
}

fn BASE($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  tant_que ($k < $n) {
    si (ordre($v[$k]) == 124) { retour sous_chaine($v, 0, $k) }
    $k = $k + 1
  }
  retour $v
}

fn tyb($b: chaine) -> chaine {
  retour $b + "|vide"
}

fn estnum($t: chaine) -> booleen {
  $b = BASE($t)
  retour $b == "entier" ou $b == "rationnel" ou $b == "flottant" ou $b == "complexe"
}

fn contient_barre($v: chaine) -> booleen {
  $n = longueur($v)
  $k = 0
  $trouve = 0
  tant_que ($k < $n) {
    si (ordre($v[$k]) == 47) { $trouve = 1 }
    $k = $k + 1
  }
  retour $trouve == 1
}

fn rangd($b: chaine) -> entier {
  si ($b == "booleen") { retour 0 }
  si ($b == "entier") { retour 1 }
  si ($b == "rationnel") { retour 2 }
  si ($b == "flottant") { retour 3 }
  retour -1
}

fn promote($u1: chaine, $u2: chaine) -> chaine {
  si (BASE($u1) == "complexe" ou BASE($u2) == "complexe") { retour "complexe|vide" }
  $r1 = rangd(BASE($u1))
  $r2 = rangd(BASE($u2))
  $r = $r1
  si ($r2 > $r) { $r = $r2 }
  si ($r <= 1) { retour "entier|vide" }
  si ($r == 2) { retour "rationnel|vide" }
  retour "flottant|vide"
}

# ══════════════════ morceaux de chaînes (, et ;) ══════════════════

fn piece($s: chaine, $sep: entier, $k: entier) -> chaine {
  $n = longueur($s)
  $j = 0
  $no = 1
  $debut = 0
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) {
      si ($no == $k) { retour sous_chaine($s, $debut, $j) }
      $no = $no + 1
      $debut = $j + 1
    }
    $j = $j + 1
  }
  si ($no == $k) { retour sous_chaine($s, $debut, $n) }
  retour ""
}

fn nb_pieces($s: chaine, $sep: entier) -> entier {
  si ($s == "") { retour 0 }
  $n = longueur($s)
  $j = 0
  $c = 0
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) { $c = $c + 1 }
    $j = $j + 1
  }
  retour $c + 1
}

# ══════════════════ arithmétique rationnelle exacte (repli) ══════════════════
# L'entier Rose est à précision arbitraire (GMP côté moteur) : le repli est
# EXACT sans bignum dédié — fraction « p » ou « p/q », dénominateur > 0,
# réduite, zéro sous la forme « 0 » — canonicalisation mpq miroir.

fn vabs($x: entier) -> entier {
  si ($x < 0) { retour 0 - $x }
  retour $x
}

fn pgcd2($a: entier, $b: entier) -> entier {
  $x = vabs($a)
  $y = vabs($b)
  tant_que ($y > 0) {
    $r = $x % $y
    $x = $y
    $y = $r
  }
  retour $x
}

fn rpui($b: entier, $e: entier) -> entier {
  $res = 1
  $f = $b
  $k = $e
  tant_que ($k > 0) {
    si ($k % 2 == 1) { $res = $res * $f }
    $f = $f * $f
    $k = $k div 2
  }
  retour $res
}

fn rnum($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour entier(sous_chaine($t, 0, $k))
}

fn rden($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour 1 }
  retour entier(sous_chaine($t, $k + 1, $n))
}

# zéro rationnel : tous les chiffres du numérateur sont des « 0 »
fn rnul($t: chaine) -> booleen {
  $n = longueur($t)
  $k = 0
  $ok = 1
  $rien = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon si (ordre($t[$k]) != 48) { $ok = 0; $rien = 0 }
    sinon { $k = $k + 1 }
  }
  retour $rien == 1
}

fn rnorm($p: entier, $q: entier) -> chaine {
  $np = $p
  $nq = $q
  si ($nq < 0) { $np = 0 - $np; $nq = 0 - $nq }
  si ($np == 0) { retour "0" }
  $g = pgcd2($np, $nq)
  si ($g > 1) { $np = $np div $g; $nq = $nq div $g }
  si ($nq == 1) { retour chaine($np) }
  retour chaine($np) + "/" + chaine($nq)
}

# ══════════════════ erreurs et environnements ══════════════════
# $err : liste partagée, la première erreur gagne ; toute fonction gardée
# rend la main à vide dès qu'elle est pleine (miroir de l'exception C++).

fn signaler($lg: entier, $msg: chaine, $err: liste<chaine>) {
  si (longueur($err) == 1) {
    $s = "Rose : erreur — "
    si ($lg > 0) { $s = $s + "[Ligne " + chaine($lg) + ", Colonne 0] " }
    joindre($err, $s + $msg)
  }
}

fn reserver($nom: chaine, $lg: entier, $err: liste<chaine>) {
  $n = longueur($nom)
  si ($n > 1 et ordre($nom[0]) == 116) {
    $chiffres = 1
    $k = 1
    tant_que ($k < $n) {
      si ($chiffres == 1) {
        $c = ordre($nom[$k])
        si ($c < 48 ou $c > 57) { $chiffres = 0 }
      }
      $k = $k + 1
    }
    si ($chiffres == 1) { signaler($lg, "Le nom '" + $nom + "' est réservé par le moteur", $err) }
  }
}

fn env_get($nom: chaine, $vn: liste<chaine>, $vt: liste<chaine>) -> chaine {
  $j = longueur($vn) - 1
  tant_que ($j >= 1) {
    si ($vn[$j] == $nom) { retour $vt[$j] }
    $j = $j - 1
  }
  retour ""
}

fn env_put($nom: chaine, $ty: chaine, $vn: liste<chaine>, $vt: liste<chaine>) {
  joindre($vn, $nom)
  joindre($vt, $ty)
}

# ══════════════════ appendeurs de pools ══════════════════
# Post-ordre strict : le nœud est ajouté quand ses enfants existent déjà ;
# indice = longueur - 1 après l'ajout (listes rembourrées).

fn noeud8($k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $kd: chaine, $t: chaine, $f: chaine,
          $ga: entier, $gb: entier, $sa: entier, $ca: entier, $l: entier) -> entier {
  joindre($k, $kd)
  joindre($tx, $t)
  joindre($tf, $f)
  joindre($a, $ga)
  joindre($b, $gb)
  joindre($as, $sa)
  joindre($ac, $ca)
  joindre($lg, $l)
  retour longueur($k) - 1
}

fn inoeud7($ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
           $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
           $kd: chaine, $no: chaine, $e1: entier, $e2: entier,
           $b1: chaine, $b2: chaine, $l: entier) -> entier {
  joindre($ik, $kd)
  joindre($ino, $no)
  joindre($ie, $e1)
  joindre($ie2, $e2)
  joindre($ib1, $b1)
  joindre($ib2, $b2)
  joindre($ilg, $l)
  retour longueur($ik) - 1
}

# module::nom est stocké « module;nom » (les identifiants ne portent jamais « ; »)
fn eclate_mod($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour "" }
  retour sous_chaine($t, 0, $k)
}

fn eclate_nom($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour $t }
  retour sous_chaine($t, $k + 1, $n)
}

# ══════════════════ types et noms (parseur) ══════════════════

fn nomid($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  retour chaine($p + 1) + "|" + VX0($x, $p)
}

# type annoté : « pos|base|élément » — Ty::liste ne garde que la base de
# l'élément (miroir de la plie M4.1)
fn typex($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  $r = nomid($g, $x, $p)
  $q = SEPR($r)
  $t = NOD($r)
  si ($t == "liste") {
    si (T0($g, $q) == "<") { $q = $q + 1 }
    $d = typex($g, $x, $q)
    $q = SEPR($d)
    $iv = NOD($d)
    si (T0($g, $q) == ">") { $q = $q + 1 }
    $m = longueur($iv)
    $k = 0
    $trouve = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($k >= $m) { $ok = 0 }
      sinon si (ordre($iv[$k]) == 124) { $ok = 0; $trouve = 1 }
      sinon { $k = $k + 1 }
    }
    $base_int = $iv
    si ($trouve == 1) { $base_int = sous_chaine($iv, 0, $k) }
    retour chaine($q) + "|liste|" + $base_int
  }
  retour chaine($q) + "|" + $t + "|vide"
}

# ══════════════════ expressions — descente vers les pools ══════════════════
# Toute fonction rend « pos|indice » ; l'indice est décimal (jamais de « | »).

# `i` est l'imaginaire SAUF s'il sert de compteur de boucle (`pour i de …`) :
# le moteur le lexalise alors comme variable entière. On le détecte sur le
# flux de jetons complet (aucun fichier du corpus ne mélange les deux usages).
fn i_est_compteur($g: liste<chaine>, $x: liste<chaine>) -> booleen {
  $n = longueur($g)
  $j = 1
  tant_que ($j + 1 < $n) {
    si (VX0($x, $j) == "pour" et VX0($x, $j + 1) == "i") { retour vrai }
    $j = $j + 1
  }
  retour faux
}

fn atom($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "nombre") {
    # suffixe imaginaire « 4i » -> (c 0 4)  [miroir de analyseur.rose]
    si (T1($g, $p) == "mot" et VX1($x, $p) == "i") {
      $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "c", "0 " + VX0($x, $p), "", -1, -1, 0, 0, $l)
      retour chaine($p + 2) + "|" + chaine($i)
    }
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "flottant") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", VX0($x, $p), "1", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "chaine") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "ch", VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "[") {
    # arguments d'abord dans un tampon local (frais par cadre recursive),
    # vidange contiguë vers le pool $al a la fermeture du nœud
    $col = [-1]
    $nc = 0
    $q = $p + 1
    si (T1($g, $p) != "]") {
      $ok = 1
      tant_que ($ok == 1) {
        $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        joindre($col, entier(NOD($r)))
        $nc = $nc + 1
        $q = SEPR($r)
        si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $ok = 0 }
      }
    }
    # [0 : type] : liste vide typée (M2.4)
    si ($nc == 1 et $col[1] >= 0 et $k[$col[1]] == "lit" et $tx[$col[1]] == "0" et T0($g, $q) == ":") {
      # [0 : entier] est une LISTE VIDE TYPÉE (Expr::ListeVideTypee cote Rust),
      # pas une liste à un élément : le dump ecrit « (lstvide entier) ».
      $ty0 = VX0($x, $q + 1)
      $q = $q + 1
      $q = $q + 1
      si (T0($g, $q) == "]") { $q = $q + 1 }
      $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lstvide", $ty0, "", -1, -1, 0, 0, $l)
      retour chaine($q) + "|" + chaine($i)
    }
    si (T0($g, $q) == "]") { $q = $q + 1 }
    $sa = longueur($al)
    $u = 1
    tant_que ($u <= $nc) {
      joindre($al, $col[$u])
      $u = $u + 1
    }
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lst", "", "", -1, -1, $sa, $nc, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "(") {
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    retour chaine($q) + "|" + NOD($r)
  }
  si (VX0($x, $p) == "vrai") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "1", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (VX0($x, $p) == "faux") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "0", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  # `i` minuscule = unité imaginaire (c 0 1), miroir de analyseur.rose
  si ($t == "mot" et VX0($x, $p) == "i" et non i_est_compteur($g, $x)) {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "c", "0 1", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (T1($g, $p) == "::") {
    $mod = VX0($x, $p)
    $nom = VX1($x, $p + 1)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, longueur($al), 0, $l)
    retour chaine($p + 3) + "|" + chaine($i)
  }
  $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "v", VX0($x, $p), "", -1, -1, 0, 0, $l)
  retour chaine($p + 1) + "|" + chaine($i)
}

fn can_nud($k: liste<chaine>, $ac: liste<entier>, $e: entier) -> booleen {
  $kk = $k[$e]
  si ($kk == "v") { retour vrai }
  retour $kk == "app" et $ac[$e] == 0
}

fn post($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = atom($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "(" et can_nud($k, $ac, $e)) {
      $lp = GL0($gl, $q)
      $tx0 = $tx[$e]
      $mod = eclate_mod($tx0)
      $nom = eclate_nom($tx0)
      $q = $q + 1
      $col = [-1]
      $nc = 0
      si (T0($g, $q) != ")") {
        $v2 = 1
        tant_que ($v2 == 1) {
          $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          joindre($col, entier(NOD($rr)))
          $nc = $nc + 1
          $q = SEPR($rr)
          si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $v2 = 0 }
        }
      }
      si (T0($g, $q) == ")") { $q = $q + 1 }
      $sa = longueur($al)
      $u = 1
      tant_que ($u <= $nc) {
        joindre($al, $col[$u])
        $u = $u + 1
      }
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, $sa, $nc, $lp)
    }
    sinon si ($t == "[") {
      $lb = GL0($gl, $q)
      $q = $q + 1
      si (T0($g, $q) == ":") {
        # s[:b] et s[:] — sucre miroir : sous_chaine(s, 0, b)
        $q = $q + 1
        $fin = -1
        si (T0($g, $q) == "]") {
          joindre($al, $e)
          $fin = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
        }
        sinon {
          $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          $fin = entier(NOD($rr))
          $q = SEPR($rr)
        }
        joindre($al, $e)
        $z = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0", "", -1, -1, 0, 0, $lb)
        joindre($al, $z)
        joindre($al, $fin)
        $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
        si (T0($g, $q) == "]") { $q = $q + 1 }
      }
      sinon {
        $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        $ix = entier(NOD($rr))
        $q = SEPR($rr)
        si (T0($g, $q) == ":") {
          # s[a:b] et s[a:] — sucre miroir
          $q = $q + 1
          $fin = -1
          si (T0($g, $q) == "]") {
            joindre($al, $e)
            $fin = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
          }
          sinon {
            $r3 = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
            $fin = entier(NOD($r3))
            $q = SEPR($r3)
          }
          joindre($al, $e)
          joindre($al, $ix)
          joindre($al, $fin)
          $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
          si (T0($g, $q) == "]") { $q = $q + 1 }
        }
        sinon {
          $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "idx", "", "", $e, $ix, 0, 0, $lb)
          si (T0($g, $q) == "]") { $q = $q + 1 }
        }
      }
    }
    sinon { $ok = 0 }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn unai($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "racine") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    $d = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0.5", "1", -1, -1, 0, 0, $l)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", entier(NOD($r)), $d, 0, 0, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "-") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "-", "", entier(NOD($r)), -1, 0, 0, $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "+") {
    retour unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  }
  si ($t == "sfact") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $lf = GL0($gl, $p)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "sfact", "", "", entier(NOD($r)), -1, 0, 0, $lf)
    retour chaine(SEPR($r)) + "|" + chaine($e)
  }
  $r = post($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $tt = T0($g, $q)
    si ($tt == "multifacto" ou $tt == "diese" ou $tt == "terminal" ou $tt == "superfacto" ou $tt == "!") {
      $lf = GL0($gl, $q)
      $kdn = "fac"
      $ktx = ""
      si ($tt == "multifacto") {
        $nbang = longueur(VX0($x, $q))
        si ($nbang >= 2) { $kdn = "mfact"; $ktx = chaine($nbang) }
      }
      si ($tt == "diese") { $kdn = "prim" }
      sinon si ($tt == "terminal") { $kdn = "term" }
      sinon si ($tt == "superfacto") { $kdn = "super" }
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, $kdn, $ktx, "", $e, -1, 0, 0, $lf)
      $q = $q + 1
    } sinon { $ok = 0 }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn puis($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = unai($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  si (T0($g, $q) == "^") {
    $lo = GL0($gl, $q)
    $d = puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", $e, entier(NOD($d)), 0, 0, $lo)
    retour chaine(SEPR($d)) + "|" + chaine($i)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn prod($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = puis($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "*" ou $t == "/" ou $t == "%" ou $t == "div") { $op = $t }
    si ($t == "ident" et VX0($x, $q) == "div") { $op = "div" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn somme($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = prod($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "+") { $op = "+" }
    si ($t == "-") { $op = "-" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = prod($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn compa($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = somme($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "<" ou $t == "<=" ou $t == ">" ou $t == ">=" ou $t == "==" ou $t == "!=" ou $t == "≈" ou $t == "?=" ou $t == "=~") { $op = $t }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = somme($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn nonx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  si (EMOT($g, $x, $p, "non")) {
    retour nonx_helper($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  }
  retour compa($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
}

fn nonx_helper($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
       $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
       $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $l = GL0($gl, $p)
  $r = nonx($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "non", "", entier(NOD($r)), -1, 0, 0, $l)
  retour chaine(SEPR($r)) + "|" + chaine($i)
}

# « et »/« ou » : le nœud porte la ligne du PREMIER jeton de l'opérande
# droit (miroir exact de neo(voir().ligne) après consommation).

fn etx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
       $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
       $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = nonx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  tant_que (EMOT($g, $x, $q, "et")) {
    $lo = GL0($gl, $q + 1)
    $d = nonx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "et", "", $e, entier(NOD($d)), 0, 0, $lo)
    $q = SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn expr1($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = etx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  tant_que (EMOT($g, $x, $q, "ou")) {
    $lo = GL0($gl, $q + 1)
    $d = etx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "ou", "", $e, entier(NOD($d)), 0, 0, $lo)
    $q = SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

# ══════════════════ instructions — pool + corps en chaînes d'indices ══════════════════
# Un corps est la chaîne des indices de ses instructions de premier niveau,
# séparées par « , » ; les instructions imbriquées vivent dans le même pool,
# ajoutées AVANT leur parent (post-ordre), donc hors de la chaîne du parent.

fn instruction($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "{") {
    $c = bloc($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "bloc", "", -1, -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == ">>") {
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "aff", "", entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "<<") {
    $rn = nomid($g, $x, $p + 1)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "lire", NOD($rn), -1, -1, "", "", $l)
    retour chaine(SEPR($rn)) + "|" + chaine($i)
  }
  si ($t == "?") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "@") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "si") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $q = SEPR($c)
    $corps1 = NOD($c)
    $corps2 = ""
    si (EMOT($g, $x, $q, "sinon")) {
      si (T0($g, $q + 1) == "{") {
        $d = bloc($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($d)
        $corps2 = NOD($d)
      }
      sinon {
        $d = instruction($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($d)
        $corps2 = NOD($d)
      }
    }
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(NOD($r)), -1, $corps1, $corps2, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "tant_que") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "pour") {
    $q = $p + 1
    $rn = nomid($g, $x, $q)
    $q = SEPR($rn)
    $nom = NOD($rn)
    si (EMOT($g, $x, $q, "de")) { $q = $q + 1 }
    $rd = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($rd)
    si (EMOT($g, $x, $q, "vers")) { $q = $q + 1 }
    $rf = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($rf)
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "pour", $nom, entier(NOD($rd)), entier(NOD($rf)), NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "retour") {
    $suiv = T1($g, $p)
    si ($suiv == ";" ou $suiv == "}" ou $suiv == "eof") {
      $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", -1, -1, "", "", $l)
      retour chaine($p + 1) + "|" + chaine($i)
    }
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si (($t == "ident" ou $t == "mot") et T1($g, $p) == "=") {
    $rn = nomid($g, $x, $p)
    $q = SEPR($rn)
    si (T0($g, $q) == "=") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "affi", NOD($rn), entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  $r = expr1($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "expr", "", entier(NOD($r)), -1, "", "", $l)
  retour chaine(SEPR($r)) + "|" + chaine($i)
}

fn bloc($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>,
        $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
        $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (T0($g, $q) == "{") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "}" ou $t == "eof") { $ok = 0 }
    sinon {
      si ($t == ";") { $q = $q + 1 }
      sinon {
        $r = instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($r)
        si ($ch != "") { $ch = $ch + "," }
        $ch = $ch + NOD($r)
        si (T0($g, $q) == ";") { $q = $q + 1 }
      }
    }
  }
  si (T0($g, $q) == "}") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

fn corps_chevron($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (T0($g, $q) == "[") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "]" ou $t == "eof") { $ok = 0 }
    sinon {
      $r = instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
      $q = SEPR($r)
      si ($ch != "") { $ch = $ch + "," }
      $ch = $ch + NOD($r)
      si (T0($g, $q) == ";") { $q = $q + 1 } sinon { $ok = 0 }
    }
  }
  si (T0($g, $q) == "]") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

# ══════════════════ définition de fonction ══════════════════
# Pools parallèles : noms, externe (« 1 » ou vide), paramètres encodés
# « nom|base|elt;… », retour « base|elt », corps (chaîne d'indices), ligne du
# jeton « fn » (les erreurs de frontière la réclament).

fn def_fn($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
          $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $al: liste<entier>,
          $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
          $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
          $fnoms: liste<chaine>, $fext: liste<chaine>, $fparams: liste<chaine>,
          $fret: liste<chaine>, $fcorps: liste<chaine>, $fligne: liste<entier>) -> chaine {
  $lf = GL0($gl, $p)
  $q = $p + 1
  $rn = nomid($g, $x, $q)
  $q = SEPR($rn)
  $nom = NOD($rn)
  si (T0($g, $q) == "(") { $q = $q + 1 }
  $params = ""
  $un = 1
  tant_que ($un == 1) {
    si (T0($g, $q) == ")" ou T0($g, $q) == "eof") { $un = 0 }
    sinon {
      $rp = nomid($g, $x, $q)
      $q = SEPR($rp)
      $pn = NOD($rp)
      si (T0($g, $q) == ":") {
        $q = $q + 1
        $rt = typex($g, $x, $q)
        $q = SEPR($rt)
        $tp = NOD($rt)
      } sinon {
        # paramètre sans annotation : type dynamique, encodé « ?|vide »
        $tp = "?|vide"
      }
      si ($params != "") { $params = $params + ";" }
      $params = $params + $pn + "|" + $tp
      si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $un = 0 }
    }
  }
  si (T0($g, $q) == ")") { $q = $q + 1 }
  $ret = "?|vide"
  si (T0($g, $q) == "->") {
    $rt = typex($g, $x, $q + 1)
    $ret = NOD($rt)
    $q = SEPR($rt)
  }
  $ext = "1"
  $corps = ""
  si (T0($g, $q) == "{") {
    $ext = ""
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $corps = NOD($c)
    $q = SEPR($c)
  }
  joindre($fnoms, $nom)
  joindre($fext, $ext)
  joindre($fparams, $params)
  joindre($fret, $ret)
  $corps = rnat_flat($corps)
  joindre($fcorps, $corps)
  joindre($fligne, $lf)
  retour chaine($q) + "|" + $nom
}

# ══════════════════ repli de constantes (passe 1) ══════════════════
# Miroir de replier_constants : fonctions triées (corps seulement), puis le
# niveau supérieur ; post-ordre strict (arguments, gauche, droite, nœud).
# La vue d'un nœud vaut « 1|texte|drapeau » si le nœud est (ou devient) un
# littéral après repli, « 0 » sinon. Les flottants repliés portent le texte
# exact de texte_flottant : la représentation la plus courte qui se relit à
# l'identique, « .0 » ajouté si elle n'a ni point ni exposant. flot_txt le
# reconstruit depuis chaine() — même repr, sauf entiers flottants où chaine
# tronque, et le signe du zéro se relit dans 1.0 / v.
# /0 flottant ne plie pas (miroir du nullptr) ; NaN/∞ non plus.
# Les entrées sont stockées par indice de nœud pour que la passe 2 voie
# l'arbre replié sans jamais modifier les pools.

fn entree($i: entier, $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) -> chaine {
  $n = longueur($foi)
  $j = 1
  tant_que ($j < $n) {
    si ($foi[$j] == $i) { retour "1|" + $fot[$j] + "|" + $fof[$j] }
    $j = $j + 1
  }
  retour "0"
}

fn stocker($i: entier, $t: chaine, $f: chaine,
           $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) {
  joindre($foi, $i)
  joindre($fot, $t)
  joindre($fof, $f)
}

fn vue_texte($v: chaine) -> chaine {
  $n = longueur($v)
  si ($n < 3) { retour "" }
  si (ordre($v[$n - 1]) == 124) { retour sous_chaine($v, 2, $n - 1) }
  retour sous_chaine($v, 2, $n - 2)
}

fn vue_flag($v: chaine) -> chaine {
  $n = longueur($v)
  si ($n < 3) { retour "" }
  si (ordre($v[$n - 1]) == 124) { retour "" }
  retour sous_chaine($v, $n - 1, $n)
}

fn replier_expr($i: entier,
                $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                $lg: liste<entier>, $al: liste<entier>,
                $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                $err: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "0" }
  $kd = $k[$i]
  $va = "0"
  $vb = "0"
  # replier() Rust : des qu'un flottant est present dans un binaire dont
  # l'operation n'est ni + - * / ni ^, il rend l'AST ORIGINAL et annule
  # les plis de ses enfants. On evite donc la recursion (qui stockerait des
  # vues encore utilisées par em_ast_expr).
  si ($kd == "bin") {
    $opx = $tx[$i]
    si (non ($opx == "+" ou $opx == "-" ou $opx == "*" ou $opx == "/" ou $opx == "^")) {
      $ga0 = $a[$i]
      $gb0 = $b[$i]
      $flga = faux
      $flgb = faux
      si ($ga0 >= 0 et $k[$ga0] == "lit" et $tf[$ga0] == "1") { $flga = vrai }
      si ($gb0 >= 0 et $k[$gb0] == "lit" et $tf[$gb0] == "1") { $flgb = vrai }
      si ($flga ou $flgb) { retour "0" }
    }
  }
  si ($kd == "lst" ou $kd == "app") {
    $sa = $as[$i]
    $n = $ac[$i]
    $j = 0
    tant_que ($j < $n) {
      replier_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
      $j = $j + 1
    }
  }
  sinon si ($kd == "idx" ou $kd == "bin") {
    $ga = $a[$i]
    $gb = $b[$i]
    si ($ga >= 0) { $va = replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($gb >= 0) { $vb = replier_expr($gb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd != "bin") { retour "0" }
  }
  sinon si ($kd == "uni" ou $kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super") {
    $ga = $a[$i]
    si ($ga >= 0) { $va = replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super") {
      si ($va != "0" et vue_flag($va) == "") {
        $t = vue_texte($va)
        si (non contient_barre($t)) {
          $n = entier($t)
          si ($n >= 0 et $n <= -1) {
            $acc = 1
            $j = 2
            tant_que ($j <= $n) { $acc = $acc * $j; $j = $j + 1 }
            $r = chaine($acc)
            stocker($i, $r, "", $foi, $fot, $fof)
            retour "1|" + $r + "|"
          }
        }
      }
      retour "0"
    }
  }
  sinon si ($kd == "lit") {
    retour "1|" + $tx[$i] + "|" + $tf[$i]
  }
  sinon { retour "0" }
  si (longueur($err) > 1) { retour "0" }
  $l = $lg[$i]
  # — unaire « - » sur littéral : miroir litt_depuis_q(-q) —
  si ($kd == "uni" et $va != "0") {
    si ($tx[$i] != "-") { retour "0" }
    si (vue_flag($va) == "1") {
      $fv = val_d($va)
      $zn = faux
      si ($fv == 0.0 et non texte_neg(vue_texte($va))) { $zn = vrai }
      $rs = flot_txt(-$fv, $zn)
      stocker($i, $rs, "1", $foi, $fot, $fof)
      retour "1|" + $rs + "|1"
    }
    $t = vue_texte($va)
    $nvt = ""
    si (rnul($t)) { $nvt = "0" }
    sinon si (ordre($t[0]) == 45) { $nvt = sous_chaine($t, 1, longueur($t)) }
    sinon { $nvt = "-" + $t }
    stocker($i, $nvt, "", $foi, $fot, $fof)
    retour "1|" + $nvt + "|"
  }
  # — produit de deux littéraux complexes : le moteur plie i*i en -1 —
  # (les nœuds « c » portent « re im » dans $tx ; non repliables eux-mêmes)
  si ($kd == "bin" et $tx[$i] == "*" et $a[$i] >= 0 et $b[$i] >= 0) {
    $ga = $a[$i]
    $gb = $b[$i]
    si ($k[$ga] == "c" et $k[$gb] == "c") {
      $r1 = entier(piece($tx[$ga], 32, 1))
      $i1 = entier(piece($tx[$ga], 32, 2))
      $r2 = entier(piece($tx[$gb], 32, 1))
      $i2 = entier(piece($tx[$gb], 32, 2))
      $nr = $r1 * $r2 - $i1 * $i2
      $ni = $r1 * $i2 + $i1 * $r2
      si ($ni == 0) {
        $r = chaine($nr)
        stocker($i, $r, "", $foi, $fot, $fof)
        retour "1|" + $r + "|"
      }
      retour "0"
    }
  }
  # — binaire sur deux littéraux : miroir fold_bin —
  si ($kd == "bin" et $va != "0" et $vb != "0") {
    $op = $tx[$i]
    si (vue_flag($va) == "1" ou vue_flag($vb) == "1") {
      si ($op == "+" ou $op == "-" ou $op == "*" ou $op == "/" ou $op == "^") {
        $fa = val_d($va)
        $fbv = val_d($vb)
        $plie = 1
        $rf = 0.0
        $zn = faux
        si ($op == "+") { $rf = $fa + $fbv }
        sinon si ($op == "-") { $rf = $fa - $fbv }
        sinon si ($op == "*") {
          $rf = $fa * $fbv
          si ($rf == 0.0 et texte_neg(vue_texte($va)) != texte_neg(vue_texte($vb))) { $zn = vrai }
        }
        sinon si ($op == "/") {
          si ($fbv == 0.0) { $plie = 0 }
          sinon { $rf = $fa / $fbv }
        }
        sinon { $rf = $fa ^ $fbv }
        si ($plie == 1) {
          $rs = flot_txt($rf, $zn)
          si (contient($rs, "inf") ou contient($rs, "nan")) { $plie = 0 }
          si ($plie == 1) {
            stocker($i, $rs, "1", $foi, $fot, $fof)
            retour "1|" + $rs + "|1"
          }
        }
        retour "0"
      }
      retour "0"
    }
    si ($op == "≈" ou $op == "?=" ou $op == "=~" ou $op == "==" ou $op == "!=" ou $op == "%") {
      retour "0"
    }
    $ta = vue_texte($va)
    $tb = vue_texte($vb)
    $p1 = rnum($ta)
    $q1 = rden($ta)
    $p2 = rnum($tb)
    $q2 = rden($tb)
    $r = ""
    $np = 0
    $nq = 1
    si ($op == "+") { $np = $p1 * $q2 + $p2 * $q1; $nq = $q1 * $q2 }
    sinon si ($op == "-") { $np = $p1 * $q2 - $p2 * $q1; $nq = $q1 * $q2 }
    sinon si ($op == "*") { $np = $p1 * $p2; $nq = $q1 * $q2 }
    sinon si ($op == "/") {
      si (rnul($tb)) { signaler($l, "Division par zéro dans une constante", $err); retour "0" }
      $np = $p1 * $q2; $nq = $q1 * $p2
    }
    sinon si ($op == "^") {
      si ($q2 != 1) { retour "0" }
      si ($p2 < 0 et rnul($ta)) { signaler($l, "0^négatif dans une constante", $err); retour "0" }
      si ($p2 < 0 ou $p2 > 64) { retour "0" }
      $num = 1
      $jj = 0
      tant_que ($jj < $p2) { $num = $num * $p1; $jj = $jj + 1 }
      $den = 1
      $jj = 0
      tant_que ($jj < $p2) { $den = $den * $q1; $jj = $jj + 1 }
      $np = $num; $nq = $den
    }
    sinon si ($op == "div") {
      si (rnul($tb)) { signaler($l, "division par zéro dans une constante", $err); retour "0" }
      $r = chaine($p1 * $q2 div ($q1 * $p2))
      stocker($i, $r, "", $foi, $fot, $fof)
      retour "1|" + $r + "|"
    }
    sinon { retour "0" }
    # ⚠ Un entier géant (2^63, 2^64, 40!...) ne doit JAMAIS traverser
    # pgcd2()/vabs() : le JIT perd son tag bignum à cette profondeur d'appel
    # (mesuré : « conversion vers entier impossible (type Vide) »). Quand le
    # dénominateur vaut 1 (cas de toutes les puissances entières), rnorm et
    # rden1 sont l'identité : on court-circuite, exactement comme GMP.
    $r = ""
    $fl = ""
    si ($nq == 1) {
      $r = chaine($np)
      si ($np == 0) { $r = "0" }
    } sinon {
      $r = rnorm($np, $nq)
      si (non rden1($np, $nq)) { $fl = "q" }
    }
    stocker($i, $r, $fl, $foi, $fot, $fof)
    retour "1|" + $r + "|" + $fl
  }
  retour "0"
}

fn replier_chaine($cs: chaine,
                  $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                  $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                  $lg: liste<entier>, $al: liste<entier>,
                  $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                  $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                  $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                  $err: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

fn replier_instr($i: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                 $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                 $err: liste<chaine>) {
  si (longueur($err) > 1) { retour 0 }
  $kd = $ik[$i]
  si ($kd == "aff" ou $kd == "expr" ou $kd == "affi") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "retour") {
    $e = $ie[$i]
    si ($e >= 0) {
      replier_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    }
    retour 0
  }
  si ($kd == "si") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    $b2 = $ib2[$i]
    si ($b2 != "") {
      replier_chaine($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    }
    retour 0
  }
  si ($kd == "tq") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "pour") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "bloc") {
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

# ══════════════════ vérification de types (passe 2) ══════════════════
# Miroir du vérificateur C++ : expressions rendent le type « base|elt » ;
# deux paires d'environnements vivent en parallèle — l'environnement de
# l'instruction courante et le « locals » du membre (tout corps de si/
# tant_que/pour descend dans LOCALS, jamais dans l'environnement ambiant —
# bizarrerie fidèle du moteur, dualité globales/locals mesurée en v3.14).

fn ELTT($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour sous_chaine($v, $k + 1, $n)
}

fn t_from_texte($t: chaine, $f: chaine) -> chaine {
  si ($f == "1") { retour "flottant|vide" }
  si (contient_barre($t)) { retour "rationnel|vide" }
  retour "entier|vide"
}

fn ce_raw($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
              $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
              $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "vide|vide" }
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") { retour t_entree(vue_flag($vue)) }
  $kd = $k[$i]
  $lg0 = $lg[$i]
  si ($kd == "lit") { retour t_from_texte($tx[$i], $tf[$i]) }
  si ($kd == "ch") { retour "chaine|vide" }
  si ($kd == "c") { retour "complexe|vide" }
  si ($kd == "bol") { retour "booleen|vide" }
  si ($kd == "v") {
    $nom = $tx[$i]
    $t = env_get($nom, $vn, $vt)
    si ($t == "") { $t = env_get($nom, $gn, $gt) }
    # π / pi est une constante integrée du moteur (type chaine, voir la table
    # des builtins) : le vérificateur Rust la connaît et l'erreur porte alors
    # sur l'opération, pas sur la variable.
    si ($t == "" et ($nom == "π" ou $nom == "pi")) { $t = "chaine|vide" }
    si ($t == "") {
      signaler($lg0, "Variable '" + $nom + "' utilisée sans valeur", $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "lstvide") {
    retour "liste|" + $tx[$i]
  }
  si ($kd == "lst") {
    $n = $ac[$i]
    $sa = $as[$i]
    si ($n == 0) {
      signaler($lg0, "Liste vide : le type d'élément est introuvable", $err)
      retour "vide|vide"
    }
    $t_elt = check_expr($al[$sa], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $j = 1
    tant_que ($j < $n) {
      $tch = check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
      si ($tch != $t_elt) {
        si (estnum($tch) et estnum($t_elt)) { $t_elt = promote($tch, $t_elt) }
        sinon {
          signaler($lg0, "Liste hétérogène : " + nomty($t_elt) + " puis " + nomty($tch), $err)
          retour "vide|vide"
        }
      }
      $j = $j + 1
    }
    si (longueur($err) > 1) { retour "vide|vide" }
    si (BASE($t_elt) == "liste") {
      signaler($lg0, "Listes de listes non supportées pour l'instant", $err)
      retour "vide|vide"
    }
    retour "liste|" + BASE($t_elt)
  }
  si ($kd == "idx") {
    $tb = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $ti = check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $bb = BASE($tb)
    $bi = BASE($ti)
    si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "valeur" et $bb != "?") {
      signaler($lg0, "Index sur un " + nomty($tb) + ", une liste est attendue", $err)
      retour "vide|vide"
    }
    # front.rs:1989 — un base Dyn accepte tout index et rend un type dynamique.
    si ($bb == "?") { retour "?|vide" }
    si ($bb == "table" ou $bb == "valeur") {
      $cle_ok = 0
      si ($bi == "entier") { $cle_ok = 1 }
      sinon si ($bi == "rationnel") { $cle_ok = 1 }
      sinon si ($bi == "flottant") { $cle_ok = 1 }
      sinon si ($bi == "chaine") { $cle_ok = 1 }
      sinon si ($bi == "booleen") { $cle_ok = 1 }
      si ($bb == "table" et $cle_ok == 0) {
        signaler($lg0, "Index d'une table doit être un texte ou un nombre", $err)
        retour "vide|vide"
      }
      retour "valeur|vide"
    }
    si ($bi != "entier") {
      $msg = "Index d'une liste doit être entier"
      si ($bb == "chaine") { $msg = "Index d'une chaîne doit être entier" }
      signaler($lg0, $msg, $err)
      retour "vide|vide"
    }
    si ($bb == "chaine") { retour "chaine|vide" }
    retour ELTT($tb) + "|vide"
  }
  si ($kd == "uni") {
    $t = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si ($tx[$i] == "non") {
      si (BASE($t) != "booleen") {
        signaler($lg0, "La condition de non doit être booléenne, trouvé " + nomty($t), $err)
        retour "vide|vide"
      }
      retour "booleen|vide"
    }
    # front.rs:1917 — unaire (hors « non ») sur Dyn : laissé passer.
    si (BASE($t) == "?") { retour "?|vide" }
    si (non estnum($t)) {
      signaler($lg0, "Unaire " + $tx[$i] + " sur un " + nomty($t), $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super" ou $kd == "sfact" ou $kd == "mfact") {
    $t = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "entier") {
      signaler($lg0, "Factorielle attend un entier, trouvé " + nomty($t), $err)
      retour "vide|vide"
    }
    retour "entier|vide"
  }
  si ($kd == "bin") { retour check_bin($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                        $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt) }
  si ($kd == "app") { retour check_appel($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                          $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                          $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt) }
  signaler($lg0, "Expression inconnue", $err)
  retour "vide|vide"
}

fn check_bin($i: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
             $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $op = $tx[$i]
  $lg0 = $lg[$i]
  $tg = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  $td = check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  si (longueur($err) > 1) { retour "vide|vide" }
  si ($op == "et" ou $op == "ou") {
    si (BASE($tg) != "booleen") {
      signaler($lg0, "La condition de et/ou doit être booléenne, trouvé " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (BASE($td) != "booleen") {
      signaler($lg0, "La condition de et/ou doit être booléenne, trouvé " + nomty($td), $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "==" ou $op == "!=" ou $op == "≈" ou $op == "?=" ou $op == "=~") {
    si ($tg != $td et non(estnum($tg) et estnum($td))
        et BASE($tg) != "?" et BASE($td) != "?") {
      signaler($lg0, "Comparaison " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "<" ou $op == "<=" ou $op == ">" ou $op == ">=") {
    $okordre = 0
    si (estnum($tg) et estnum($td)) { $okordre = 1 }
    si (BASE($tg) == "chaine" et BASE($td) == "chaine") { $okordre = 1 }
    # front.rs:2035 — comparaison d'ordre avec un Dyn : résolue à l'exécution.
    si (BASE($tg) == "?" ou BASE($td) == "?") { $okordre = 1 }
    si ($okordre == 0) {
      signaler($lg0, "Ordre " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "+") {
    si (BASE($tg) == "chaine" et BASE($td) == "chaine") { retour "chaine|vide" }
    si (estnum($tg) et estnum($td)) { retour promote($tg, $td) }
    # front.rs:2044 — Dyn + X non numérique des deux côtés → Dyn.
    # EXTENSION : `valeur` (lecture de table) = Dyn du moteur Rust.
    si (BASE($tg) == "?" ou BASE($td) == "?" ou BASE($tg) == "valeur" ou BASE($td) == "valeur") { retour "?|vide" }
    # miroir de front.rs : `racine(n)` est typée irrationnel mais rend un
    # entier exact sur carré parfait ; l'addition est donc résolue à
    # l'exécution (les benches racines l'utilisent).
    si (BASE($tg) == "irrationnel" ou BASE($td) == "irrationnel") { retour "?|vide" }
    signaler($lg0, "Addition " + nomty($tg) + " + " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "-" ou $op == "*") {
    si (estnum($tg) et estnum($td)) { retour promote($tg, $td) }
    # front.rs:2058 — Dyn × X : type résolu à l'exécution.
    si (BASE($tg) == "?" ou BASE($td) == "?") { retour "?|vide" }
    signaler($lg0, "Opération " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "/") {
    si (estnum($tg) et estnum($td)) {
      $r = promote($tg, $td)
      si (BASE($r) == "entier") { retour "rationnel|vide" }
      retour $r
    }
    # front.rs:2070 — division avec Dyn non résolu → Dyn.
    si (BASE($tg) == "?" ou BASE($td) == "?") { retour "?|vide" }
    signaler($lg0, "Division " + nomty($tg) + " / " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "%") {
    si (BASE($tg) == "entier" et BASE($td) == "entier") { retour "entier|vide" }
    signaler($lg0, "Le modulo exige deux entiers", $err)
    retour "vide|vide"
  }
  si ($op == "div") {
    si (non(estnum($tg) ou BASE($tg) == "booleen")) {
      signaler($lg0, "div attend un nombre à gauche, trouvé " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (non(estnum($td) ou BASE($td) == "booleen")) {
      signaler($lg0, "div attend un nombre à droite, trouvé " + nomty($td), $err)
      retour "vide|vide"
    }
    si (BASE($tg) == "flottant" ou BASE($td) == "flottant") { retour "flottant|vide" }
    retour "entier|vide"
  }
  si ($op == "^") {
    si (non estnum($tg)) {
      signaler($lg0, "Puissance sur une base " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (BASE($td) == "flottant") { retour "flottant|vide" }
    $bd = BASE($td)
    si ($bd == "entier" ou $bd == "rationnel" ou $bd == "booleen") {
      $gb = $b[$i]
      $est_uni = 1
      si (entree($gb, $foi, $fot, $fof) != "0") { $est_uni = 0 }
      sinon si ($k[$gb] != "uni") { $est_uni = 0 }
      sinon si ($tx[$gb] != "-") { $est_uni = 0 }
      si ($est_uni == 1) {
        si (BASE($tg) == "entier") { retour "rationnel|vide" }
        retour $tg
      }
      si (BASE($tg) == "entier") { retour "entier|vide" }
      retour $tg
    }
    signaler($lg0, "Exposant " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  signaler($lg0, "Opérateur '" + $op + "' inconnu", $err)
  retour "vide|vide"
}

# — tables STDLIB et DYNAMIQUE (miroir exact des 45 + 4 entrées) —
# Format « retour|codes,virgules ». Codes inconnus du vérificateur C++
# (« n », « table ») acceptent tout : ils restent ici sans règle, fidèles.

fn std_sig($nom: chaine) -> chaine {
  si ($nom == "afficher") { retour "vide|n" }
  si ($nom == "saisir_entier") { retour "entier|" }
  si ($nom == "saisir_flottant") { retour "flottant|" }
  si ($nom == "factorielle") { retour "entier|entier" }
  si ($nom == "fibonacci") { retour "entier|entier" }
  si ($nom == "pgcd") { retour "entier|entier,entier" }
  si ($nom == "ppcm") { retour "entier|entier,entier" }
  si ($nom == "puissance") { retour "entier|num,entier" }
  si ($nom == "est_premier") { retour "booleen|entier" }
  si ($nom == "compter_premiers") { retour "entier|entier" }
  si ($nom == "nb_chiffres") { retour "entier|entier" }
  si ($nom == "nombre_pi") { retour "chaine|entier" }
  si ($nom == "longueur") { retour "entier|lct" }
  # front.rs:650-651 — alias `len` et primitive `type_de` (arg « tout » non vérifié).
  si ($nom == "len") { retour "entier|lct" }
  si ($nom == "type_de") { retour "chaine|tout" }
  si ($nom == "table") { retour "table|" }
  si ($nom == "inserer") { retour "vide|table,tout,tout" }
  si ($nom == "cle_existe") { retour "booleen|table,tout" }
  si ($nom == "supprimer") { retour "booleen|table,tout" }
  si ($nom == "cles") { retour "MIXTE|table" }
  si ($nom == "valeurs") { retour "MIXTE|table" }
  si ($nom == "joindre") { retour "vide|liste,liste_elt" }
  si ($nom == "ordre") { retour "entier|chaine" }
  si ($nom == "caractere") { retour "chaine|entier" }
  si ($nom == "sous_chaine") { retour "chaine|chaine,entier,entier" }
  si ($nom == "concatener") { retour "chaine|liste" }
  si ($nom == "ecrire_bytes") { retour "vide|chaine,chaine" }
  si ($nom == "ecrire_binaire") { retour "vide|chaine,liste" }
  si ($nom == "lire_texte") { retour "chaine|chaine" }
  si ($nom == "eval_expr") { retour "chaine|chaine" }
  si ($nom == "octet_brut") { retour "chaine|entier" }
  # EXTENSION : alias natifs déjà émis par le backend G5.
  si ($nom == "type") { retour "chaine|tout" }
  si ($nom == "prng") { retour "entier|entier" }
  si ($nom == "ecrire_texte") { retour "vide|chaine,chaine" }
  si ($nom == "nb_arguments") { retour "entier|" }
  si ($nom == "argument") { retour "chaine|entier" }
  si ($nom == "temps") { retour "entier|" }
  si ($nom == "duree") { retour "chaine|entier" }
  si ($nom == "afficher_erreur") { retour "vide|tout" }
  si ($nom == "quitter") { retour "vide|entier" }
  si ($nom == "abs") { retour "MIXTE|num" }
  si ($nom == "min") { retour "NUM_MAX|num,num" }
  si ($nom == "max") { retour "NUM_MAX|num,num" }
  si ($nom == "partie_entiere") { retour "entier|num" }
  si ($nom == "fraction") { retour "rationnel|entier,entier" }
  si ($nom == "graine") { retour "vide|entier" }
  si ($nom == "hasard") { retour "entier|entier" }
  si ($nom == "tampon") { retour "tampon|entier" }
  si ($nom == "octets") { retour "tampon|chaine" }
  si ($nom == "tampon_case") { retour "entier|tampon,entier" }
  si ($nom == "tampon_pose") { retour "vide|tampon,entier,entier" }
  si ($nom == "remplir_hasard") { retour "vide|tampon,tampon" }
  si ($nom == "remplir_hasard_philox") { retour "vide|tampon,tampon,entier" }
  si ($nom == "re" ou $nom == "im" ou $nom == "arg" ou $nom == "modulus") { retour "flottant|complexe" }
  si ($nom == "conj") { retour "complexe|complexe" }
  si ($nom == "millisecondes") { retour "entier|" }
  # front.rs:709-716 — `time`/`ms` et les 5 primitives GUI native.
  si ($nom == "time") { retour "chaine|" }
  si ($nom == "ms") { retour "entier|" }
  si ($nom == "fenetre_native") { retour "entier|chaine,entier,entier" }
  si ($nom == "fenetre_afficher") { retour "vide|entier" }
  si ($nom == "fenetre_attendre") { retour "vide|entier" }
  si ($nom == "fenetre_fermer") { retour "vide|entier" }
  si ($nom == "message_native") { retour "vide|chaine,chaine" }
  si ($nom == "fact") { retour "entier|entier" }
  si ($nom == "fib") { retour "entier|entier" }
  si ($nom == "gcd") { retour "entier|entier,entier" }
  si ($nom == "lcm") { retour "entier|entier,entier" }
  si ($nom == "pow") { retour "entier|num,entier" }
  si ($nom == "racine") { retour "irrationnel|entier" }
  si ($nom == "racine_decimales") { retour "chaine|entier,entier" }
  si ($nom == "is_prime") { retour "booleen|entier" }
  si ($nom == "digits") { retour "entier|entier" }
  si ($nom == "pi" ou $nom == "nombre_e" ou $nom == "e" ou $nom == "phi") { retour "chaine|entier" }
  si ($nom == "factorielle_rapide" ou $nom == "factorial_rapide" ou $nom == "rapide") { retour "entier|entier" }
  si ($nom == "approx" ou $nom == "factorial_approx") { retour "chaine|entier" }
  si ($nom == "primorielle") { retour "entier|entier" }
  si ($nom == "termial" ou $nom == "triangulaire" ou $nom == "termial_classique" ou $nom == "termial_kurepa" ou $nom == "kurepa" ou $nom == "terminal") { retour "entier|entier" }
  si ($nom == "super_factorielle") { retour "entier|entier" }
  si ($nom == "multifactorielle" ou $nom == "multifactoriel") { retour "entier|entier,entier" }
  si ($nom == "sous_factorielle" ou $nom == "derangement" ou $nom == "sous_factorial") { retour "entier|entier" }
  retour ""
}

fn dyn_sig($nom: chaine) -> chaine {
  si ($nom == "charger") { retour "entier|chaine" }
  si ($nom == "fermer") { retour "vide|entier" }
  si ($nom == "appeler0") { retour "flottant|entier,chaine" }
  si ($nom == "appeler1") { retour "flottant|entier,chaine,num" }
  si ($nom == "appeler2") { retour "flottant|entier,chaine,num,num" }
  retour ""
}

fn vargs($i: entier, $codes: chaine, $nom: chaine,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>,
         $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
         $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
         $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
         $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
         $tri: liste<entier>, $trt: liste<chaine>) {
  $nargs = $ac[$i]
  $np = nb_pieces($codes, 44)
  si ($nargs != $np) {
    signaler($lg[$i], $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($nargs), $err)
    retour 0
  }
  $sa = $as[$i]
  $t_elt = "vide|vide"
  $a_elt = 0
  $j = 0
  tant_que ($j < $nargs) {
    $ta = check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $code = piece($codes, 44, $j + 1)
    si ($code == "chaine") {
      si (BASE($ta) != "chaine") { signaler($lg[$i], $nom + ": une chaine est attendue", $err) }
    }
    sinon si ($code == "num") {
      si (non estnum($ta)) {
        signaler($lg[$i], $nom + ": un nombre est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "entier") {
      si (BASE($ta) != "entier") {
        signaler($lg[$i], $nom + ": un entier est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "liste") {
      si (BASE($ta) != "liste") {
        signaler($lg[$i], $nom + ": une liste est attendue, reçu " + nomty($ta), $err)
      }
      $t_elt = tyb(ELTT($ta))
      $a_elt = 1
    }
    sinon si ($code == "tampon") {
      si (BASE($ta) != "tampon") {
        signaler($lg[$i], $nom + ": un tampon est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "lct") {
      $bb = BASE($ta)
      si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "tampon") {
        signaler($lg[$i], $nom + ": une liste, une chaîne ou une table est attendue, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "liste_elt") {
      $tolere = 0
      si ($a_elt == 1 et BASE($t_elt) != "vide" et $ta != $t_elt) {
        si (estnum($ta) et estnum($t_elt) et promote($ta, $t_elt) == $t_elt) { $tolere = 1 }
        si ($tolere == 0) {
          signaler($lg[$i], $nom + ": élément " + nomty($ta) + " ne correspond pas à la liste " + nomty($t_elt), $err)
        }
      }
    }
    $j = $j + 1
  }
}

fn check_appel($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $lg0 = $lg[$i]
  $tx0 = $tx[$i]
  $mod = eclate_mod($tx0)
  $nom = eclate_nom($tx0)
  # — dynamique:: —
  si ($mod == "dynamique") {
    $spec = dyn_sig($nom)
    si ($spec == "") {
      signaler($lg0, "Fonction dynamique::" + $nom + " inconnue (disponibles: charger, fermer, appeler0, appeler1, appeler2)", $err)
      retour "vide|vide"
    }
    vargs($i, piece($spec, 124, 2), "dynamique::" + $nom,
          $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
          $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour tyb(piece($spec, 124, 1))
  }
  # — conversions d'un argument, avant les signatures —
  $cast = 0
  si ($nom == "entier") { $cast = 1 }
  sinon si ($nom == "rationnel") { $cast = 1 }
  sinon si ($nom == "flottant") { $cast = 1 }
  sinon si ($nom == "chaine") { $cast = 1 }
  si ($cast == 1 et $ac[$i] == 1) {
    $t = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si ($nom == "chaine") { retour "chaine|vide" }
    si (BASE($t) == "chaine") {
      si ($nom == "entier") { retour "entier|vide" }
      si ($nom == "flottant") { retour "flottant|vide" }
      signaler($lg0, "Conversion chaine → rationnel non disponible, passez par flottant", $err)
      retour "vide|vide"
    }
    si (non estnum($t)) {
      signaler($lg0, "Conversion " + nomty($t) + " → " + nomty(tyb($nom)) + " impossible", $err)
      retour "vide|vide"
    }
    retour tyb($nom)
  }
  # — fonctions de l'utilisateur (externes comprises) —
  $pos = 0
  $u = 1
  $nf = longueur($fnoms)
  tant_que ($u < $nf) {
    si ($pos == 0 et $fnoms[$u] == $nom) { $pos = $u }
    $u = $u + 1
  }
  si ($pos > 0) {
    $ps = $fparams[$pos]
    $np = nb_pieces($ps, 59)
    si ($ac[$i] != $np) {
      signaler($lg0, $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($ac[$i]), $err)
      retour "vide|vide"
    }
    $sa = $as[$i]
    $j = 1
    $ok = 1
    tant_que ($j <= $np) {
      si ($ok == 1) {
        $ta = check_expr($al[$sa + $j - 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                         $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
        $ent = piece($ps, 59, $j)
        $t_att = sous_chaine($ent, premier_pipe($ent) + 1, longueur($ent))
        $bad = 0
        si ($ta != $t_att) {
          # front.rs:2157 — un paramètre sans annotation (Dyn) accepte tout.
          si (BASE($t_att) != "?") {
            # est_numerique du moteur EXCLUT les complexes : aucune promotion
            # implicite numérique → complexe aux arguments de fonction.
            $numok = estnum($ta) et estnum($t_att) et BASE($ta) != "complexe" et BASE($t_att) != "complexe"
            si (non($numok et promote($ta, $t_att) == $t_att)) { $bad = 1 }
          }
        }
        si ($bad == 1) {
          signaler($lg0, "Argument de " + $nom + ": " + nomty($ta) + " reçu, " + nomty($t_att) + " attendu", $err)
          $ok = 0
        }
      }
      $j = $j + 1
    }
    retour $fret[$pos]
  }
  # — bibliothèque standard —
  $spec = std_sig($nom)
  si ($spec == "") {
    signaler($lg0, "Fonction '" + $nom + "' inconnue", $err)
    retour "vide|vide"
  }
  vargs($i, piece($spec, 124, 2), $nom,
        $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
        $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  si (longueur($err) > 1) { retour "vide|vide" }
  $ret = piece($spec, 124, 1)
  si ($ret == "MIXTE") {
    $t = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "booleen") { retour "entier|vide" }
    retour $t
  }
  si ($ret == "NUM_MAX") {
    $ta1 = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $ta2 = check_expr($al[$as[$i] + 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour promote($ta1, $ta2)
  }
  retour tyb($ret)
}

fn premier_pipe($v: chaine) -> entier {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour $k
}

# ══════════════════ instructions vérifiées ══════════════════

fn check_instr($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $ln: liste<chaine>, $lt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $ass: entier, $ra: chaine, $err: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) {
  si (longueur($err) > 1) { retour 0 }
  $kd = $ik[$i]
  $lg0 = $ilg[$i]
  si ($kd == "aff") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "vide") { signaler($lg0, "Rien à afficher ici", $err) }
    retour 0
  }
  si ($kd == "lire") {
    $nom = $ino[$i]
    $t = env_get($nom, $vn, $vt)
    si ($t == "") {
      reserver($nom, $lg0, $err)
      env_put($nom, "entier|vide", $vn, $vt)
      si (longueur($err) == 1) { joindre($tri, $i); joindre($trt, "1") }
    }
    sinon {
      $bb = BASE($t)
      si ($bb != "entier" et $bb != "flottant" et $bb != "rationnel") {
        signaler($lg0, "Ne peut pas lire dans une variable " + nomty($t) + " (entier/flottant attendus)", $err)
      }
      sinon {
        $nu = "1"
        si ($bb == "rationnel") { $nu = "2" }
        sinon si ($bb == "flottant") { $nu = "3" }
        joindre($tri, $i)
        joindre($trt, $nu)
      }
    }
    retour 0
  }
  si ($kd == "affi") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "vide") {
      signaler($lg0, "Impossible d'affecter une valeur sans type", $err)
      retour 0
    }
    $nom = $ino[$i]
    # Le moteur traite une globale comme un SHADOW dans un corps de fonction :
    # `$k = 0` local ne doit pas être confronté au type de la globale $k.
    $ex = env_get($nom, $vn, $vt)
    # i/pi/phi/e sont des globales du moteur : shadow, pas de contrôle de domaine
    si ($nom == "i" ou $nom == "pi" ou $nom == "phi" ou $nom == "e") { $ex = "" }
    $cible = $t
    si ($ex != "") {
      $cible = $ex
      $be = BASE($ex)
      $bt = BASE($t)
      $domaine_ok = 1
      # front.rs:1589 — Dyn de part ou d'autre : affectation laissée passer.
      si ($be == "valeur" ou $bt == "valeur" ou $be == "?" ou $bt == "?") { $domaine_ok = 1 }
      sinon si ($bt == "entier" et $be == "rationnel") { $domaine_ok = 1 }
      sinon si ($t != $ex) {
        $domaine_ok = 0
        si (promote($t, $ex) == $ex et estnum($t) et estnum($ex)) { $domaine_ok = 1 }
        si ($domaine_ok == 0) {
          signaler($lg0, "'" + $nom + "' est " + nomty($ex) + ", on ne peut pas y stocker du " + nomty($t), $err)
          retour 0
        }
      }
    }
    reserver($nom, $lg0, $err)
    env_put($nom, $cible, $vn, $vt)
    retour 0
  }
  si ($kd == "si") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "booleen") {
      signaler($lg0, "La condition de si doit être booléenne, trouvé " + nomty($t), $err)
      retour 0
    }
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    $b2 = $ib2[$i]
    si ($b2 != "" et longueur($err) == 1) {
      parcourir($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    }
    retour 0
  }
  si ($kd == "tq") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "booleen") {
      signaler($lg0, "La condition de tant_que doit être booléenne, trouvé " + nomty($t), $err)
      retour 0
    }
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    retour 0
  }
  si ($kd == "pour") {
    $nom = $ino[$i]
    # le moteur suit les compteurs de boucle dans UN seul espace : un `pour i`
    # imbriqué dans un autre `pour` voit le compteur posé au niveau supérieur
    # (qui vit dans $gn/$gt quand le corps est parcouru avec $ln/$lt).
    si (env_get($nom, $vn, $vt) != "" ou env_get($nom, $gn, $gt) != "") {
      signaler($lg0, "La variable de boucle '" + $nom + "' existe déjà", $err)
      retour 0
    }
    $td = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $tfin = check_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                       $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($td) != "entier" ou BASE($tfin) != "entier") {
      signaler($lg0, "pour…de…vers exige des bornes entières", $err)
      retour 0
    }
    reserver($nom, $lg0, $err)
    env_put($nom, "entier|vide", $vn, $vt)
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    retour 0
  }
  si ($kd == "retour") {
    si ($ass == 0) {
      signaler($lg0, "'retour' hors de fonction", $err)
      retour 0
    }
    $e = $ie[$i]
    si ($e < 0) {
      si ($ra != "vide|vide") {
        signaler($lg0, "La fonction doit retourner un " + nomty($ra), $err)
      }
    }
    sinon {
      $t = check_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
      $bad = 0
      # fonction sans type de retour déclaré : le moteur met le retour en
      # Dyn (« ? ») et accepte n'importe quel type de valeur.
      si (BASE($ra) == "?") { $bad = 0 }
      sinon si ($t != $ra) {
        si (non(estnum($t) et estnum($ra) et promote($t, $ra) == $ra)) { $bad = 1 }
      }
      si ($bad == 1) {
        signaler($lg0, "La fonction retourne " + nomty($t) + ", attendu " + nomty($ra), $err)
      }
    }
    retour 0
  }
  si ($kd == "expr") {
    check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour 0
  }
  si ($kd == "bloc") {
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
  }
}

fn parcourir($cs: chaine,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $ln: liste<chaine>, $lt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $ass: entier, $ra: chaine, $err: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                      $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                      $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
  }
}

# comparution lexicale par codepoints = ordre std::map du moteur
fn cmp_str($a: chaine, $b: chaine) -> entier {
  $la = longueur($a)
  $lb = longueur($b)
  $n = $la
  si ($lb < $n) { $n = $lb }
  $i = 0
  tant_que ($i < $n) {
    $ca = ordre($a[$i])
    $cb = ordre($b[$i])
    si ($ca < $cb) { retour -1 }
    si ($ca > $cb) { retour 1 }
    $i = $i + 1
  }
  si ($la < $lb) { retour -1 }
  si ($la > $lb) { retour 1 }
  retour 0
}

# ══════════════════ notes de types et coque de vérification ══════════════════
# L'émission RIR a besoin du type que le vérificateur a calculé pour chaque
# nœud (suffixes add.f, cst.q, destination de index…) et du type de lecture
# de chaque « lire » (message du dump). check_expr est la COQUE de ce_raw :
# elle note le type (index du nœud vers « base|elt ») à chaque visite saine
# puis le rend. Les secondes visites (MIXTE/NUM_MAX recalent l'argument)
# recréent des entrées identiques : la recherche lit la première, le doublon
# est inoffensif. Les notes voyagent en listes plates — une table en
# paramètre serait hors de portée de l'AOT — et l'ordre post-ordre des deux
# passes rend la recherche linéaire quasi immédiate.

fn check_expr($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
              $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
              $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $t = ce_raw($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err,
              $tni, $tnt, $tri, $trt)
  si (longueur($err) == 1) {
    joindre($tni, $i)
    joindre($tnt, $t)
  }
  retour $t
}

# type d'une entrée de repli d'après son drapeau : « 1 » flottant, « q »
# rationnel, vide entier — sans jamais ratisser le texte (un pli comme
# 2^30000000 fait neuf millions de caractères que contient_barre ne doit
# pas parcourir, et le drapeau porte déjà l'information, comme le nœud
# littéral reconstitué côté C++ : T_ENTIER / T_RATIONNEL / T_FLOTTANT).
fn t_entree($f: chaine) -> chaine {
  si ($f == "1") { retour "flottant|vide" }
  si ($f == "q") { retour "rationnel|vide" }
  retour "entier|vide"
}

# dénominateur réduit à 1 ? — miroir fidèle de la normalisation de rnorm,
# calculé sur les entiers (le pgcd d'un géant et de 1 est un seul modulo).
fn rden1($p: entier, $q: entier) -> booleen {
  $np = $p
  $nq = $q
  si ($nq < 0) { $np = 0 - $np; $nq = 0 - $nq }
  si ($np == 0) { retour vrai }
  $g = pgcd2($np, $nq)
  si ($g > 1) { $nq = $nq div $g }
  retour $nq == 1
}

fn contient($s: chaine, $d: chaine) -> booleen {
  $n = longueur($s)
  $m = longueur($d)
  si ($m == 0) { retour vrai }
  $i = 0
  tant_que ($i + $m <= $n) {
    si (sous_chaine($s, $i, $i + $m) == $d) { retour vrai }
    $i = $i + 1
  }
  retour faux
}

# texte de littéral -> double au sens de lit_valeur_d : « p/q » vaut p divisé
# par q (le moteur fait strtod puis division), le reste passe par flottant(),
# le strtod du moteur — arrondi au plus proche identique.
fn val_d($v: chaine) -> flottant {
  $t = vue_texte($v)
  $n = longueur($t)
  $j = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($j >= $n) { $ok = 0 }
    sinon si (ordre($t[$j]) == 47) { $ok = 0 }
    sinon { $j = $j + 1 }
  }
  si ($j >= $n) { retour flottant($t) }
  retour flottant(sous_chaine($t, 0, $j)) / flottant(sous_chaine($t, $j + 1, $n))
}

# texte que le moteur écrit dans le RIR pour un flottant replié :
# texte_flottant = représentation la plus courte qui se relit à l'identique,
# « .0 » ajouté si elle n'a ni point ni exposant. chaine() imite ce texte
# SAUF pour les flottants entiers (|v| < 1e16) où il tronque via %lld :
# « 5.0 » devient « 5 » et « -0.0 » devient « 0 », signe perdu. On recolle
# donc « .0 » dans ce cas ; le signe du zéro se calcule sur place dans le
# pli (négation qui écrase un zéro, produit de facteurs de signes
# contraires) et se fige dans le texte stocké — 1.0 / 0.0 lève « division
# par zéro » dans le moteur, aucun sondage n'est possible, et les fonctions
# ne voyant pas les globales, rien d'autre ne peut charrier ce signe.
fn flot_txt($v: flottant, $zneg: booleen) -> chaine {
  $rs = chaine($v)
  $af = $v
  si ($af < 0.0) { $af = -$af }
  si ($af < 10000000000000000.0) {
    si ($v == entier($v)) {
      si ($v == 0.0) {
        $rs = "0.0"
        si ($zneg) { $rs = "-0.0" }
      }
      sinon {
        # flottant entier : chaine() passe par %lld — il faut le %.Ng de
        # texte_flottant. Chiffres significatifs = digits sans les zéros
        # finaux ; exposant = longueur - 1. printf : style fixe si
        # exposant < chiffres, sinon scientifique « d.ddde±dd ».
        $dg = chaine(entier($af))
        $e = longueur($dg) - 1
        $m = $dg
        $ok = 1
        tant_que ($ok == 1) {
          $nn = longueur($m)
          si ($nn <= 1) { $ok = 0 }
          sinon si (ordre($m[$nn - 1]) == 48) { $m = sous_chaine($m, 0, $nn - 1) }
          sinon { $ok = 0 }
        }
        $p = longueur($m)
        si ($e < $p) {
          $rs = $dg + ".0"
        } sinon {
          $rs = sous_chaine($m, 0, 1)
          si ($p > 1) { $rs = $rs + "." + sous_chaine($m, 1, $p) }
          $rs = $rs + "e+"
          si ($e < 10) { $rs = $rs + "0" }
          $rs = $rs + chaine($e)
        }
        si ($v < 0.0) { $rs = "-" + $rs }
      }
    }
  }
  retour $rs
}

# le signe d'un texte de littéral (les opérandes d'un pli sont toujours des
# littéraux — le « -0.0 » déjà plié porte son moins).
fn texte_neg($t: chaine) -> booleen {
  si (longueur($t) == 0) { retour faux }
  retour ordre($t[0]) == 45
}

# ══════════════════ émission RIR (passe 3) ══════════════════
# Miroir d'EmetteurRir : compteurs partagés — %t et suffixes de bloc comptent
# sans reprise sur tout le module. Les blocs sont déclarés dans l'ordre des
# push_back C++ ; le bloc en attente (test de tant_que, borne de pour) reçoit
# ses lignes avant même d'être listé, en portant déjà son nom : la liste $fb
# garde l'ordre de création et la fenêtre de lignes d'un bloc reste contiguë.
# Le curseur est toujours le dernier bloc déclaré — la coupure des « si »
# imbriqués tombe donc dans le « fin » intérieur, comme dans le moteur.

fn rir_of($b: chaine) -> chaine {
  si ($b == "entier") { retour "z" }
  si ($b == "rationnel") { retour "q" }
  si ($b == "flottant") { retour "f" }
  si ($b == "booleen") { retour "b" }
  si ($b == "chaine") { retour "s" }
  si ($b == "liste") { retour "l" }
  si ($b == "table") { retour "tbl" }
  retour "u"
}

fn tick_t($tc: liste<entier>) -> chaine {
  $s = "%t" + chaine(longueur($tc) - 1)
  joindre($tc, 0)
  retour $s
}

fn tick_b($bc: liste<entier>) -> chaine {
  $s = "_" + chaine(longueur($bc) - 1)
  joindre($bc, 0)
  retour $s
}

# type annoté d'un nœud : note de première visite, entrée de repli (littéral
# reconstitué du monde C++), littéral de source, puis le vide.
fn own($i: entier, $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
       $tni: liste<entier>, $tnt: liste<chaine>) -> chaine {
  $n = longueur($tni)
  $j = 1
  tant_que ($j < $n) {
    si ($tni[$j] == $i) { retour $tnt[$j] }
    $j = $j + 1
  }
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") { retour t_entree(vue_flag($vue)) }
  si ($k[$i] == "lit") { retour t_from_texte($tx[$i], $tf[$i]) }
  retour "vide|vide"
}

fn e_bloc($fb: liste<chaine>, $cc: liste<entier>, $nom: chaine) {
  joindre($fb, $nom)
  joindre($cc, longueur($fb) - 1)
}

# $na : la ligne a un opérande — le dump C++ écrit « » + texte pour chaque
# opérande, même vide (une chaine vide se dump «cst.s » avec l'espace).
fn e_ligne($fl: liste<chaine>, $flb: liste<entier>, $fp: liste<chaine>, $cc: liste<entier>,
           $dest: chaine, $op: chaine, $argstr: chaine, $msg: chaine, $na: booleen) {
  $l = "  "
  si ($dest != "") { $l = $l + $dest + " = " }
  $l = $l + $op
  si ($na) { $l = $l + " " + $argstr }
  si ($msg != "") { $l = $l + " \"" + $msg + "\"" }
  joindre($fl, $l)
  joindre($flb, $cc[longueur($cc) - 1])
  joindre($fp, $op)
}

# ══════════════════ émission RIR (format actuel) ══════════════════
# S-expression d'une expression depuis les pools (miroir de analyseur.rose).
# Les vues repliées (entree()) ont priorité sur le nœud brut.
fn em_ast_expr($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) -> chaine {
  $vue = entree($i, $foi, $fot, $fof)
  $kd = $k[$i]
  $op0 = $tx[$i]
  $txt = $tx[$i]
  # repli de `-` sur un littéral : le moteur garde le drapeau neg et ecrit
  # "(f -" + texte. Quand le texte replié porte deja un '-', le neg rend
  # deux moins (ex. `moitie(-2.5)` -> `(f --2.5)`).
  si ($vue != "0" et $kd == "uni" et $op0 == "-" et vue_flag($vue) == "1") {
    $un = vue_texte($vue)
    si (longueur($un) > 0 et ordre($un[0]) == 45) { retour "(f -" + $un + ")" }
    retour "(f " + $un + ")"
  }
  # `-1` source : le moteur Rust garde le drapeau neg ET le texte replié
  # (déjà signé) -> `(n --1)`. Double négation repliée -> `(n 1)`.
  si ($vue != "0" et $kd == "uni" et $op0 == "-" et vue_flag($vue) == "") {
    $un = vue_texte($vue)
    si (longueur($un) > 0 et ordre($un[0]) == 45) { retour "(n -" + $un + ")" }
    retour "(n " + $un + ")"
  }
  # nœud replié : utiliser le texte/flag de la vue
  si ($vue != "0") {
    $txt = vue_texte($vue)
    $fl = vue_flag($vue)
    $kd = "lit"
    $op0 = ""
    $tf0 = $fl
    si ($fl == "1") { retour "(f " + $txt + ")" }
    si (contient_barre($txt)) { retour "(f " + $txt + ")" }
    retour "(n " + $txt + ")"
  }
  si ($kd == "lit") {
    si ($tf[$i] == "1") { retour "(f " + $txt + ")" }
    si (contient_barre($txt)) { retour "(f " + $txt + ")" }
    retour "(n " + $txt + ")"
  }
  si ($kd == "ch") { retour "(s \"" + ast_echapper($txt) + "\")" }
  si ($kd == "c") { retour "(c " + $txt + ")" }
  si ($kd == "bol") {
    si ($txt == "1") { retour "(b vraie)" }
    retour "(b faux)"
  }
  si ($kd == "v") { retour "(v " + $txt + ")" }
  si ($kd == "idx") {
    retour "(idx " + em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) +
           " " + em_ast_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + ")"
  }
  si ($kd == "bin") {
    retour "(bin " + $op0 + " " +
           em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + " " +
           em_ast_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + ")"
  }
  si ($kd == "uni") {
    retour "(uni " + $op0 + " " +
           em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + ")"
  }
  si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super" ou $kd == "sfact" ou $kd == "mfact") {
    $nomf = "fact"
    si ($kd == "prim") { $nomf = "prim" }
    si ($kd == "term") { $nomf = "term" }
    si ($kd == "super") { $nomf = "super" }
    si ($kd == "sfact") { $nomf = "sfact" }
    $enf = em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($kd == "mfact") { retour "(mfact " + $txt + " " + $enf + ")" }
    retour "(" + $nomf + " " + $enf + ")"
  }
  si ($kd == "lstvide") { retour "(lstvide " + $txt + ")" }
  si ($kd == "lst") {
    $e = "(lst"
    $sa = $as[$i]
    $nb = $ac[$i]
    $j = 0
    tant_que ($j < $nb) {
      $e = $e + " " + em_ast_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
      $j = $j + 1
    }
    retour $e + ")"
  }
  si ($kd == "app") {
    $mod = eclate_mod($txt)
    $nom = eclate_nom($txt)
    $e = "(app "
    si ($mod != "") { $e = $e + $mod + "::" }
    $e = $e + $nom
    $sa = $as[$i]
    $nb = $ac[$i]
    $j = 0
    tant_que ($j < $nb) {
      $e = $e + " " + em_ast_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
      $j = $j + 1
    }
    retour $e + ")"
  }
  retour "(v ?)"
}

fn ast_echapper($s: chaine) -> chaine {
  $o = ""
  $j = 0
  $n = longueur($s)
  tant_que ($j < $n) {
    $c = ordre($s[$j])
    si ($c == 92) { $o = $o + "\\\\" }
    sinon si ($c == 34) { $o = $o + "\\\"" }
    sinon si ($c == 10) { $o = $o + "\\n" }
    sinon si ($c == 13) { $o = $o + "\\r" }
    sinon si ($c == 9) { $o = $o + "\\t" }
    sinon { $o = $o + $s[$j] }
    $j = $j + 1
  }
  retour $o
}

# ── table des slots : nom → index (listes rembourrées à 0) ──
# $sn contient les noms, $sg les flags globaux (1 si global).
fn slot_index($slnom: chaine, $sln: liste<chaine>) -> entier {
  $sixn = longueur($sln)
  $sixj = 1
  tant_que ($sixj < $sixn) {
    si ($sln[$sixj] == $slnom) { retour $sixj - 1 }
    $sixj = $sixj + 1
  }
  retour -1
}

fn slot_de($slnom: chaine, $sln: liste<chaine>) -> entier {
  $sdk = slot_index($slnom, $sln)
  si ($sdk >= 0) { retour $sdk }
  joindre($sln, $slnom)
  retour longueur($sln) - 2
}

# marque un slot comme global
fn marquer_global($k: entier, $sg: liste<entier>) {
  $mgj = 1
  $mgn = longueur($sg)
  tant_que ($mgj < $mgn et $sg[$mgj] != $k) { $mgj = $mgj + 1 }
  si ($mgj >= $mgn) { joindre($sg, $k) }
}

# abstraction d'une expression en Eabstrait (S-expression RIR).
# $connus : liste des noms de fonctions à corps (RIR_CONNUS).
# rend "" si non abstractible (⇒ forme AST).
fn em_abstrait($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $sn: liste<chaine>, $connus: liste<chaine>) -> chaine {
  $vue = entree($i, $foi, $fot, $fof)
  $kd = $k[$i]
  $op0 = $tx[$i]
  $txt = $tx[$i]
  # Var → slot (le nom doit avoir un slot)
  si ($kd == "v") {
    $s = slot_index($tx[$i], $sn)
    si ($s >= 0) { retour "slot " + chaine($s) }
    retour ""
  }
  # Appel → appel_rir si fonction connue, args non vides et tous des Var
  si ($kd == "app") {
    $nom = eclate_nom($tx[$i])
    $connu = 0
    $u = 1
    tant_que ($u < longueur($connus)) {
      si ($connus[$u] == $nom) { $connu = 1 }
      $u = $u + 1
    }
    $sa = $as[$i]
    $nb = $ac[$i]
    $tousvar = 1
    si ($nb == 0) { $tousvar = 0 }
    $j = 0
    tant_que ($j < $nb) {
      si ($k[$al[$sa + $j]] != "v") { $tousvar = 0 }
      $j = $j + 1
    }
    si ($connu == 1 et $tousvar == 1) {
      $e = "(appel_rir " + $nom
      $j = 0
      tant_que ($j < $nb) {
        $e = $e + " " + em_ast_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
        $j = $j + 1
      }
      retour $e + ")"
    }
    retour ""
  }
  # Littéral replié : entier / flottant (rationnel refusé)
  si ($vue != "0") {
    $txt = vue_texte($vue)
    $fl = vue_flag($vue)
    si ($fl == "1") { retour "flottant " + vers_flottant($txt) }
    si (contient_barre($txt)) { retour "" }
    retour "entier " + $txt
  }
  si ($kd == "lit") {
    si ($tf[$i] == "1") { retour "flottant " + vers_flottant($txt) }
    si (contient_barre($txt)) { retour "" }
    retour "entier " + $txt
  }
  # Un exposant rationnel (1/3, 2/5...) est hors sous-ensemble cote Rust :
  # Eabstrait::Binaire n'a pas de rationnel, donc abstraire() echoue et
  # l'affichage reste un (bin ^ ...) AST.
  si ($kd == "bin" et $op0 == "^") {
    $vexp = entree($b[$i], $foi, $fot, $fof)
    si ($vexp != "0" et contient_barre(vue_texte($vexp))) { retour "" }
    si ($k[$b[$i]] == "lit" et contient_barre($tx[$b[$i]])) { retour "" }
  }
  # Binaire : op dans le sous-ensemble, deux opérandes abstractibles
  $ops = "|" + $op0 + "|"
  si ($kd == "bin" et contient_ops("|+|-|*|/|%|^|div|<|<=|>|>=|==|!=|et|ou|", $ops)) {
    $g = ""
    $ga = $a[$i]
    $vga = entree($ga, $foi, $fot, $fof)
    si ($k[$ga] == "uni" et $tx[$ga] == "-" et $vga != "0" et vue_flag($vga) == "1") {
      $tga = vue_texte($vga)
      $fga = vue_flag($vga)
      $pga = $tga
      si (longueur($pga) > 0 et ordre($pga[0]) == 45) { $pga = sous_chaine($pga, 1, longueur($pga)) }
      si ($fga == "1") { $g = "(neg flottant " + vers_flottant($pga) + ")" }
      sinon { $g = "(neg entier " + $pga + ")" }
    } sinon { $g = em_abstrait($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus) }
    $d = ""
    $gb = $b[$i]
    $vgb = entree($gb, $foi, $fot, $fof)
    si ($k[$gb] == "uni" et $tx[$gb] == "-" et $vgb != "0" et vue_flag($vgb) == "1") {
      $tgb = vue_texte($vgb)
      $fgb = vue_flag($vgb)
      $pgb = $tgb
      si (longueur($pgb) > 0 et ordre($pgb[0]) == 45) { $pgb = sous_chaine($pgb, 1, longueur($pgb)) }
      si ($fgb == "1") { $d = "(neg flottant " + vers_flottant($pgb) + ")" }
      sinon { $d = "(neg entier " + $pgb + ")" }
    } sinon { $d = em_abstrait($gb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus) }
    si ($g != "" et $d != "") { retour "(bin " + $op0 + " " + $g + " " + $d + ")" }
    retour ""
  }
  # Unaire : - → neg, non → non
  si ($kd == "uni") {
    $g = em_abstrait($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    si ($g == "") { retour "" }
    si ($op0 == "-") { retour "(neg " + $g + ")" }
    si ($op0 == "non") { retour "(non " + $g + ")" }
    retour ""
  }
  retour ""
}

fn contient_ops($s: chaine, $sub: chaine) -> booleen {
  $n = longueur($s)
  $m = longueur($sub)
  $i = 0
  tant_que ($i + $m <= $n) {
    si (sous_chaine($s, $i, $i + $m) == $sub) { retour vrai }
    $i = $i + 1
  }
  retour faux
}

# main.rs ecrit Eabstrait::Flottant avec d.to_string() (Display Rust) :
# decimal plein, jamais d'exposant, et "-0" pour le zero negatif. chaine()
# de Rose donne le plus court qui se relit (texte_flottant, style %g) ; on
# developpe l'exponentielle et on recolle le signe du zero.
fn vers_flottant($t: chaine) -> chaine {
  $neg = faux
  si (longueur($t) > 0 et ordre($t[0]) == 45) { $neg = vrai }
  $s = chaine(flottant($t))
  $u = $s
  $signe = ""
  si (longueur($u) > 0 et ordre($u[0]) == 45) { $signe = "-"; $u = sous_chaine($u, 1, longueur($u)) }
  $n = longueur($u)
  $e = -1
  $i = 0
  tant_que ($i < $n) {
    si (ordre($u[$i]) == 101) { $e = $i }
    $i = $i + 1
  }
  si ($e < 0) {
    si ($neg et $u == "0") { retour "-0" }
    retour $s
  }
  $mant = sous_chaine($u, 0, $e)
  $expo = entier(sous_chaine($u, $e + 1, $n))
  $digits = ""
  $dec = -1
  $j = 0
  $lm = longueur($mant)
  tant_que ($j < $lm) {
    si (ordre($mant[$j]) == 46) { $dec = longueur($digits) }
    sinon { $digits = $digits + $mant[$j] }
    $j = $j + 1
  }
  si ($dec < 0) { $dec = longueur($digits) }
  $pt = $dec + $expo
  $nd = longueur($digits)
  $res = ""
  si ($pt <= 0) {
    $res = "0."
    $z = 0
    tant_que ($z < 0 - $pt) { $res = $res + "0"; $z = $z + 1 }
    $res = $res + $digits
  } sinon si ($pt >= $nd) {
    $res = $digits
    $z = 0
    tant_que ($z < $pt - $nd) { $res = $res + "0"; $z = $z + 1 }
  } sinon {
    $res = sous_chaine($digits, 0, $pt) + "." + sous_chaine($digits, $pt, $nd)
  }
  retour $signe + $res
}

fn em_expr($i: entier, $ta: chaine,
           $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
           $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
           $lg: liste<entier>, $al: liste<entier>,
           $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
           $tni: liste<entier>, $tnt: liste<chaine>,
           $tc: liste<entier>, $bc: liste<entier>,
           $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
           $fp: liste<chaine>, $cc: liste<entier>) -> chaine {
  $ty = own($i, $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
  si ($ta == "u" et BASE($ty) != "vide") { $ta = rir_of(BASE($ty)) }
  $kd = $k[$i]
  $op0 = $tx[$i]
  $t = ""
  $g = ""
  $d = ""
  $opn = ""
  # — comparaison entre tampons : égalité générique, pas de conversion —
  si ($kd == "bin" et ($op0 == "==" ou $op0 == "!=")) {
    $tg = own($a[$i], $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
    $td = own($b[$i], $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
    si (BASE($tg) == "tampon" ou BASE($td) == "tampon") {
      $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      $d = em_expr($b[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      $t = tick_t($tc)
      $opn = "cmp.eq.b"
      si ($op0 == "!=") { $opn = "cmp.ne.b" }
      e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g + " " + $d, "", vrai)
      retour $t
    }
  }
  # — nœud replié = littéral du monde C++ : constante inline —
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst." + $ta, "@" + "c" + vue_texte($vue), "", vrai)
    retour $t
  }
  si ($kd == "lit") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst." + $ta, "@" + "c" + $tx[$i], "", vrai)
    retour $t
  }
  si ($kd == "ch") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst.s", $tx[$i], "", vrai)
    retour $t
  }
  si ($kd == "bol") {
    $t = tick_t($tc)
    $vv = "faux"
    si ($tx[$i] == "1") { $vv = "vrai" }
    e_ligne($fl, $flb, $fp, $cc, $t, "cst.b", $vv, "", vrai)
    retour $t
  }
  si ($kd == "v") { retour "%" + $tx[$i] }
  si ($kd == "idx") {
    $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $d = em_expr($b[$i], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "index", $g + " " + $d, "", vrai)
    retour $t
  }
  si ($kd == "bin") {
    $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $d = em_expr($b[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    si ($op0 == "+") { $opn = "add" }
    sinon si ($op0 == "-") { $opn = "sub" }
    sinon si ($op0 == "*") { $opn = "mul" }
    sinon si ($op0 == "/") { $opn = "div" }
    sinon si ($op0 == "div") { $opn = "divf" }
    sinon si ($op0 == "^") { $opn = "pow" }
    sinon si ($op0 == "%") { $opn = "rem.z" }
    sinon si ($op0 == "==") { $opn = "cmp.eq" }
    sinon si ($op0 == "!=") { $opn = "cmp.ne" }
    sinon si ($op0 == "<") { $opn = "cmp.lt" }
    sinon si ($op0 == "<=") { $opn = "cmp.le" }
    sinon si ($op0 == ">") { $opn = "cmp.gt" }
    sinon si ($op0 == ">=") { $opn = "cmp.ge" }
    sinon si ($op0 == "et") { $opn = "and" }
    sinon si ($op0 == "ou") { $opn = "or" }
    sinon { $opn = $op0 }
    si ($op0 == "≈" ou $op0 == "?=" ou $op0 == "=~") { $opn = "cmp.approx" }
    si ($opn != "cmp.approx") { $opn = $opn + "." + $ta }
    e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g + " " + $d, "", vrai)
    retour $t
  }
  si ($kd == "uni") {
    $g = em_expr($a[$i], $ta, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    $opn = "neg." + $ta
    si ($tx[$i] == "non") { $opn = "not.b" }
    e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g, "", vrai)
    retour $t
  }
  si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super") {
    $g = em_expr($a[$i], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "call @builtin.factorielle", $g, "", vrai)
    retour $t
  }
  si ($kd == "lstvide") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "liste.new", "", "", faux)
    retour $t
  }
  si ($kd == "lst") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "liste.new", "", "", faux)
    $sa = $as[$i]
    $nb = $ac[$i]
    $j = 0
    tant_que ($j < $nb) {
      $d = em_expr($al[$sa + $j], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      e_ligne($fl, $flb, $fp, $cc, "", "liste.push", $t + " " + $d, "", vrai)
      $j = $j + 1
    }
    retour $t
  }
  si ($kd == "app") {
    $sa = $as[$i]
    $nb = $ac[$i]
    $args = ""
    $j = 0
    tant_que ($j < $nb) {
      $d = em_expr($al[$sa + $j], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      si ($args == "") { $args = $d } sinon { $args = $args + " " + $d }
      $j = $j + 1
    }
    $t = tick_t($tc)
    $nom = $tx[$i]
    $nq = longueur($nom)
    $q = 0
    $okq = 1
    tant_que ($okq == 1) {
      si ($q >= $nq) { $okq = 0 }
      sinon si (ordre($nom[$q]) == 59) { $okq = 0 }
      sinon { $q = $q + 1 }
    }
    si ($q < $nq) { $nom = sous_chaine($nom, $q + 1, $nq) }
    $asg = "$" + $nom
    si ($args != "") { $asg = $asg + " " + $args }
    e_ligne($fl, $flb, $fp, $cc, $t, "call", $asg, "", vrai)
    retour $t
  }
  retour "%?"
}

fn em_instr($ix: entier,
            $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
            $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
            $lg: liste<entier>, $al: liste<entier>,
            $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
            $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
            $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
            $tni: liste<entier>, $tnt: liste<chaine>,
            $tri: liste<entier>, $trt: liste<chaine>,
            $tc: liste<entier>, $bc: liste<entier>,
            $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
            $fp: liste<chaine>, $cc: liste<entier>) {
  $kd = $ik[$ix]
  $lgn = $ilg[$ix]
  $v = ""
  $sf = ""
  si ($kd == "aff") {
    $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "afficher", $v, "", vrai)
    retour 0
  }
  si ($kd == "lire") {
    $t = tick_t($tc)
    $nu = "1"
    $nn = longueur($tri)
    $j = 1
    $trouve = 0
    tant_que ($j < $nn et $trouve == 0) {
      si ($tri[$j] == $ix) { $nu = $trt[$j]; $trouve = 1 }
      $j = $j + 1
    }
    e_ligne($fl, $flb, $fp, $cc, $t, "lire", "%" + $ino[$ix], $nu, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $t, $ino[$ix], vrai)
    retour 0
  }
  si ($kd == "affi") {
    $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $v, $ino[$ix], vrai)
    retour 0
  }
  si ($kd == "si") {
    $v = em_expr($ie[$ix], "b", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $sf = tick_b($bc)
    $l1 = ".alors_" + chaine($lgn) + $sf
    $l2 = ".sinon_" + chaine($lgn) + $sf
    $l3 = ".fin_" + chaine($lgn) + $sf
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $v + " " + $l1 + " " + $l2, "", vrai)
    e_bloc($fb, $cc, $l1)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l2)
    si ($ib2[$ix] != "") {
      em_corps($ib2[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    }
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l3)
    retour 0
  }
  si ($kd == "tq") {
    $sf = tick_b($bc)
    $l1 = ".cond_" + chaine($lgn) + $sf
    $l2 = ".corps_" + chaine($lgn) + $sf
    $l3 = ".fin_" + chaine($lgn) + $sf
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l1)
    $v = em_expr($ie[$ix], "b", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $v + " " + $l2 + " " + $l3, "", vrai)
    e_bloc($fb, $cc, $l2)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l3)
    retour 0
  }
  si ($kd == "pour") {
    $var = $ino[$ix]
    $sf = tick_b($bc)
    $l1 = ".cond_" + chaine($lgn) + $sf
    $l2 = ".corps_" + chaine($lgn) + $sf
    $l3 = ".incr_" + chaine($lgn) + $sf
    $l4 = ".fin_" + chaine($lgn) + $sf
    $v = em_expr($ie[$ix], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $v, $var, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l1)
    $d = em_expr($ie2[$ix], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $ct = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $ct, "cmp.lt.z", "%" + $var + " " + $d, "", vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $ct + " " + $l2 + " " + $l4, "", vrai)
    e_bloc($fb, $cc, $l2)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l3)
    $nt = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $nt, "add.z", "%" + $var + " @c1", "", vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $nt, $var, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l4)
    retour 0
  }
  si ($kd == "retour") {
    si ($ie[$ix] >= 0) {
      $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      e_ligne($fl, $flb, $fp, $cc, "", "ret", $v, "", vrai)
    }
    sinon {
      e_ligne($fl, $flb, $fp, $cc, "", "ret.u", "", "", faux)
    }
    retour 0
  }
  si ($kd == "expr") {
    em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    retour 0
  }
  si ($kd == "bloc") {
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
  }
}

fn em_corps($cs: chaine,
            $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
            $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
            $lg: liste<entier>, $al: liste<entier>,
            $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
            $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
            $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
            $tni: liste<entier>, $tnt: liste<chaine>,
            $tri: liste<entier>, $trt: liste<chaine>,
            $tc: liste<entier>, $bc: liste<entier>,
            $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
            $fp: liste<chaine>, $cc: liste<entier>) {
  $j = 0
  $n = longueur($cs)
  $debut = 0
  tant_que ($j <= $n) {
    $c = 10
    si ($j < $n) { $c = ordre($cs[$j]) }
    si ($j == $n ou $c == 44) {
      si ($j > $debut) {
        em_instr(entier(sous_chaine($cs, $debut, $j)), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
        $debut = $j + 1
      }
    }
    $j = $j + 1
  }
}

# ── abaissement d'un corps en opérations RIR ──────────────────────────
# Les ops sont accumulées dans $op (chaîne « instruction\n»), numérotées par
# $ipc. Les sauts utilisent des marqueurs « @label » remplacés en fin de passe.
# $sn = noms des slots, $sg = flags globaux, $connus = fonctions RIR.

fn rir_op($opch: chaine, $ipc: entier, $ops: liste<chaine>) {
  $s = chaine($ipc)
  $pad = ""
  $z = longueur($s)
  tant_que ($z < 4) { $pad = $pad + "0"; $z = $z + 1 }
  joindre($ops, "    " + $pad + $s + " " + $opch)
}

# émet une op pour une instruction ; rend le nouveau $ipc
fn rir_instr($ix: entier, $ipc: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $sn: liste<chaine>, $glst: liste<entier>, $connus: liste<chaine>, $ops: liste<chaine>,
             $estprincipal: booleen, $dans_pour: booleen) -> entier {
  $kd = $ik[$ix]
  $pc = $ipc
  si ($kd == "aff") {
    $absres = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($absres != "") {
      rir_op("afficher_abstrait " + $absres, $pc, $ops)
    } sinon {
      rir_op("afficher " + $ex, $pc, $ops)
    }
    retour $pc + 1
  }
  si ($kd == "expr") {
    rir_op("expr " + em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof), $pc, $ops)
    retour $pc + 1
  }
  si ($kd == "affi") {
    $rislot = slot_de($ino[$ix], $sn)
    # miroir de collecter() cote Rust : une variable affectee DANS un corps
    # de « pour » n'est pas declarée globale (mesuré : t_tampon $x slot 3 et
    # $c slot 8 absents de « globaux » dans l'oracle).
    si ($estprincipal et non $dans_pour) { marquer_global($rislot, $glst) }
    $riab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $riex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($riab != "") {
      rir_op("affect slot " + chaine($rislot) + " = " + $riab, $pc, $ops)
    } sinon {
      rir_op("affect_ast slot " + chaine($rislot) + " = " + $riex, $pc, $ops)
    }
    retour $pc + 1
  }
  si ($kd == "retour") {
    si ($ie[$ix] >= 0) {
      $ab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
      $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
      si ($ab != "") { rir_op("retour_abstrait " + $ab, $pc, $ops) }
      sinon { rir_op("retour " + $ex, $pc, $ops) }
    } sinon {
      rir_op("retour", $pc, $ops)
    }
    retour $pc + 1
  }
  si ($kd == "lire") {
    $s = slot_de($ino[$ix], $sn)
    si ($estprincipal) { marquer_global($s, $glst) }
    rir_op("lire slot " + chaine($s) + " Dyn", $pc, $ops)
    retour $pc + 1
  }
  # contrôle de flux : sauts (à patcher)
  si ($kd == "si") {
    $ab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    $a_sinon = 0
    si (longueur($ib2[$ix]) > 0) { $a_sinon = 1 }
    si ($a_sinon == 1) {
      si ($ab != "") { rir_op("saut_si_faux_abstrait @sinon_" + chaine($ix) + "_ " + $ab, $pc, $ops) }
      sinon { rir_op("saut_si_faux @sinon_" + chaine($ix) + "_ " + $ex, $pc, $ops) }
      $pc = $pc + 1
      $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
      rir_op("saut @fin_" + chaine($ix) + "_", $pc, $ops)
      $pc = $pc + 1
      joindre($ops, "@sinon_" + chaine($ix) + "_:")
      $pc = rir_corps($ib2[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
      joindre($ops, "@fin_" + chaine($ix) + "_:")
    } sinon {
      # sans sinon : saut-si-faux vise directement « après », aucun saut final
      si ($ab != "") { rir_op("saut_si_faux_abstrait @fin_" + chaine($ix) + "_ " + $ab, $pc, $ops) }
      sinon { rir_op("saut_si_faux @fin_" + chaine($ix) + "_ " + $ex, $pc, $ops) }
      $pc = $pc + 1
      $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
      joindre($ops, "@fin_" + chaine($ix) + "_:")
    }
    retour $pc
  }
  si ($kd == "tq") {
    joindre($ops, "@cond_" + chaine($ix) + "_:")
    $ab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($ab != "") { rir_op("saut_si_faux_abstrait @fin_" + chaine($ix) + "_ " + $ab, $pc, $ops) }
    sinon { rir_op("saut_si_faux @fin_" + chaine($ix) + "_ " + $ex, $pc, $ops) }
    $pc = $pc + 1
    $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
    rir_op("saut @cond_" + chaine($ix) + "_", $pc, $ops)
    $pc = $pc + 1
    joindre($ops, "@fin_" + chaine($ix) + "_:")
    retour $pc
  }
  si ($kd == "pour") {
    $pslot = slot_de($ino[$ix], $sn)
    si ($estprincipal et non $dans_pour) { marquer_global($pslot, $glst) }
    $pdebut = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    $pab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    si ($pab != "") { rir_op("affect slot " + chaine($pslot) + " = " + $pab, $pc, $ops) }
    sinon { rir_op("affect_ast slot " + chaine($pslot) + " = " + $pdebut, $pc, $ops) }
    $pc = $pc + 1
    joindre($ops, "@pcond_" + chaine($ix) + "_:")
    # test : bin < (v var) fin
    $pfin = em_ast_expr($ie2[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    $pfab = em_abstrait($ie2[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $pvar = "slot " + chaine($pslot)
    si ($pfab != "") {
      rir_op("saut_si_faux_abstrait @pfin_" + chaine($ix) + "_ (bin < " + $pvar + " " + $pfab + ")", $pc, $ops)
    } sinon {
      rir_op("saut_si_faux @pfin_" + chaine($ix) + "_ (bin < (v " + $ino[$ix] + ") " + $pfin + ")", $pc, $ops)
    }
    $pc = $pc + 1
    $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, vrai)
    rir_op("affect slot " + chaine($pslot) + " = (bin + slot " + chaine($pslot) + " entier 1)", $pc, $ops)
    $pc = $pc + 1
    rir_op("saut @pcond_" + chaine($ix) + "_", $pc, $ops)
    $pc = $pc + 1
    joindre($ops, "@pfin_" + chaine($ix) + "_:")
    retour $pc
  }
  si ($kd == "bloc") {
    retour rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
  }
  retour $pc
}

fn rir_corps($cs: chaine, $ipc: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $sn: liste<chaine>, $glst: liste<entier>, $connus: liste<chaine>, $ops: liste<chaine>,
             $estprincipal: booleen, $dans_pour: booleen) -> entier {
  $pc = $ipc
  $j = 0
  $n = longueur($cs)
  $debut = 0
  tant_que ($j <= $n) {
    $c = 10
    si ($j < $n) { $c = ordre($cs[$j]) }
    si ($j == $n ou $c == 44) {
      si ($j > $debut) {
        $pc = rir_instr(entier(sous_chaine($cs, $debut, $j)), $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
        $debut = $j + 1
      }
    }
    $j = $j + 1
  }
  retour $pc
}

# patche les marqueurs @label dans les sauts : remplacer @label par le numéro
# de l'op qui porte le marqueur "@label:" ; supprimer les lignes marqueurs.
fn rir_patcher($ops: liste<chaine>) -> liste<chaine> {
  # 1) enlever les lignes marqueurs, garder la liste des ops réelles
  $res = [""]
  $labels = [""]
  $cibles = [0]
  $u = 1
  tant_que ($u < longueur($ops)) {
    $ch = $ops[$u]
    si (longueur($ch) > 0 et ordre($ch[0]) == 64) {
      joindre($labels, sous_chaine($ch, 1, longueur($ch) - 1))
      joindre($cibles, longueur($res) - 1)
    } sinon {
      joindre($res, $ch)
    }
    $u = $u + 1
  }
  # 2) pour chaque op, remplacer @label par la cible du PREMIER marqueur
  #    de ce label situé APRÈS l'op (le plus proche en avant).
  $out = [""]
  $tab = table()
  $z = 1
  tant_que ($z < longueur($labels)) {
    inserer($tab, $labels[$z], $cibles[$z])
    $z = $z + 1
  }
  $u = 1
  tant_que ($u < longueur($res)) {
    $ch = rir_patch_op($res[$u], $u, $labels, $cibles, $tab)
    joindre($out, $ch)
    $u = $u + 1
  }
  retour $out
}

fn rir_patch_op($ch: chaine, $pos: entier, $labels: liste<chaine>, $cibles: liste<entier>, $tab: table) -> chaine {
  $parts = [""]
  $cur = ""
  $i = 0
  $n = longueur($ch)
  tant_que ($i < $n) {
    si ($ch[$i] == "@") {
      $j = $i + 1
      $lab = ""
      tant_que ($j < $n et est_suite(ordre($ch[$j]))) {
        $lab = $lab + $ch[$j]
        $j = $j + 1
      }
      si (longueur($lab) > 0 et cle_existe($tab, $lab)) {
        joindre($parts, $cur)
        joindre($parts, chaine($tab[$lab]))
        $cur = ""
        $i = $j
      } sinon {
        $cur = $cur + "@"
        $i = $i + 1
      }
    } sinon {
      $cur = $cur + $ch[$i]
      $i = $i + 1
    }
  }
  joindre($parts, $cur)
  retour rnat_join($parts, 1, longueur($parts))
}

fn cibles_distance($c: entier, $p: entier) -> entier {
  $d = $c - $p
  si ($d < 0) { $d = -$d }
  retour $d
}

fn position_sous($s: chaine, $sub: chaine) -> entier {
  $n = longueur($s)
  $m = longueur($sub)
  $i = 0
  tant_que ($i + $m <= $n) {
    si (sous_chaine($s, $i, $i + $m) == $sub) { retour $i }
    $i = $i + 1
  }
  retour -1
}

fn remplacer_tout($s: chaine, $de: chaine, $vers: chaine) -> chaine {
  $parts = [""]
  $cur = ""
  $i = 0
  $nd = longueur($de)
  $ns = longueur($s)
  tant_que ($i < $ns) {
    si ($i + $nd <= $ns et sous_chaine($s, $i, $i + $nd) == $de) {
      joindre($parts, $cur)
      joindre($parts, $vers)
      $cur = ""
      $i = $i + $nd
    } sinon {
      $cur = $cur + $s[$i]
      $i = $i + 1
    }
  }
  joindre($parts, $cur)
  retour rnat_join($parts, 1, longueur($parts))
}

fn em_fonction_rir($nom: chaine, $ps: chaine, $ra: chaine, $corps: chaine,
             $estprincipal: booleen,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $connus: liste<chaine>, $outl: liste<chaine>) {
  $sn = [""]
  $glst = [0]   # sentinelle (0 au lieu de -1 : évite un repli de -1 fragile)
  # paramètres d'abord
  $np = nb_pieces($ps, 59)
  $u = 1
  tant_que ($u <= $np) {
    $ent = piece($ps, 59, $u)
    $pp = premier_pipe($ent)
    $pn = sous_chaine($ent, 0, $pp)
    joindre($sn, $pn)
    $u = $u + 1
  }
  $ops = [""]
  $pc = rir_corps($corps, 0, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, faux)
  $ops = rir_patcher($ops)
  # patch des marqueurs : d'abord retirer les lignes marqueurs, noter leur cible
  # (les marqueurs sont émis avec un numéro séquentiel dans $ops).
  joindre($outl, "fonction " + $nom)
  $u = 1
  tant_que ($u <= $np) {
    $ent = piece($ps, 59, $u)
    $pp = premier_pipe($ent)
    $pn = sous_chaine($ent, 0, $pp)
    $pt = sous_chaine($ent, $pp + 1, longueur($ent))
    joindre($outl, "  param " + $pn + " " + nomty($pt))
    $u = $u + 1
  }
  joindre($outl, "  retour " + nomty($ra))
  joindre($outl, "  n_slots " + chaine(longueur($sn) - 1))
  $lgn = "  noms"
  $u = 1
  tant_que ($u < longueur($sn)) {
    $lgn = $lgn + " [" + chaine($u - 1) + "]" + $sn[$u]
    $u = $u + 1
  }
  joindre($outl, $lgn)
  si (longueur($glst) > 1) {
    $lgg = "  globaux"
    $u = 1
    tant_que ($u < longueur($glst)) {
      $lgg = $lgg + " " + chaine($glst[$u])
      $u = $u + 1
    }
    joindre($outl, $lgg)
  }
  joindre($outl, "  ops")
  $u = 1
  tant_que ($u < longueur($ops)) {
    joindre($outl, $ops[$u])
    $u = $u + 1
  }
}

fn em_fonction($nom: chaine, $ps: chaine, $ra: chaine, $corps: chaine,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>,
               $tc: liste<entier>, $bc: liste<entier>,
               $outl: liste<chaine>) {
  $fb = [""]
  $fl = [""]
  $flb = [0]
  $fp = [""]
  $cc = [0]
  e_bloc($fb, $cc, ".entree")
  em_corps($corps, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
  # — ret. implicite quand la dernière ligne n'est pas un retour —
  $ret_ok = 0
  si (longueur($fp) > 1) {
    $pop = $fp[longueur($fp) - 1]
    si (longueur($pop) >= 3) {
      si (sous_chaine($pop, 0, 3) == "ret") { $ret_ok = 1 }
    }
  }
  si ($ret_ok == 0) { e_ligne($fl, $flb, $fp, $cc, "", "ret.u", "", "", faux) }
  # — assemblage : en-tête (paramètres sous la forme étonnante du dump,
  # nom %nom : type), puis chaque bloc avec sa fenêtre de lignes —
  joindre($outl, "")
  $tt = "fonction " + $nom + "("
  $np = nb_pieces($ps, 59)
  $u = 1
  tant_que ($u <= $np) {
    si ($u > 1) { $tt = $tt + ", " }
    $ent = piece($ps, 59, $u)
    $pp = premier_pipe($ent)
    $pn = sous_chaine($ent, 0, $pp)
    $pt = sous_chaine($ent, $pp + 1, longueur($ent))
    $tt = $tt + $pn + " %" + $pn + " : " + rir_of(BASE($pt))
    $u = $u + 1
  }
  $tt = $tt + ") -> " + rir_of(BASE($ra)) + " {"
  joindre($outl, $tt)
  $ln = 1
  $bk = 1
  tant_que ($bk < longueur($fb)) {
    joindre($outl, $fb[$bk] + ":")
    $arret = 0
    tant_que ($ln < longueur($fl) et $arret == 0) {
      si ($flb[$ln] != $bk) { $arret = 1 }
      sinon {
        joindre($outl, $fl[$ln])
        $ln = $ln + 1
      }
    }
    $bk = $bk + 1
  }
  joindre($outl, "}")
}

# ══════════════════ jonction des deux étages (généré) ══════════════════
# Le front-end est une fonction : ses variables deviennent LOCALES, ce qui
# garde la table des globales G5 sous la borne des 512 entrées.
# Le backend, lui, DOIT rester au niveau supérieur : ses $g5_* sont des
# globales lues par les routines g5_emit_* émises en code machine.
fn em_source_rir() -> chaine {

# ══════════════════ programme principal ══════════════════

$src = ""
si (nb_arguments() > 0) { $src = lire_texte(argument(0)) }
# —— résolution des imports (miroir de analyser_fichier) ——
# Le moteur charge le fichier importé AVANT vérification et fusionne ses
# fonctions. Ici on retire le mot « importer » du flux et on concatène le
# source importé : les fonctions sont triées par nom plus bas, donc l'ordre
# d'arrivée n'a pas d'importance ; les numéros de ligne ne sortent pas dans
# le dump RIR.
$imax = 32
$ii = 0
tant_que ($ii < $imax) {
  $nsrc = longueur($src)
  $ipos = -1
  $j = 0
  $egc = faux
  $ecl = faux
  tant_que ($j + 8 <= $nsrc) {
    $cc0 = ordre($src[$j])
    si ($ecl) {
      si ($cc0 == 10) { $ecl = faux }
    } sinon si ($egc) {
      si ($cc0 == 92) { $j = $j + 1 }
      sinon si ($cc0 == 34) { $egc = faux }
    } sinon {
      si ($cc0 == 35) { $ecl = vrai }
      sinon si ($cc0 == 34) { $egc = vrai }
      sinon si (sous_chaine($src, $j, $j + 8) == "importer") {
        $av = " "
        si ($j > 0) { $av = $src[$j - 1] }
        $ap = " "
        si ($j + 8 < $nsrc) { $ap = $src[$j + 8] }
        si (non est_suite(ordre($av)) et non est_suite(ordre($ap))) { $ipos = $j }
      }
    }
    $j = $j + 1
  }
  si ($ipos < 0) { $ii = $imax }
  sinon {
    $q = $ipos + 8
    tant_que ($q < $nsrc et (ordre($src[$q]) == 32 ou ordre($src[$q]) == 9 ou ordre($src[$q]) == 10)) { $q = $q + 1 }
    $fin = $q
    si ($fin < $nsrc et ordre($src[$fin]) == 34) {
      $fin = $fin + 1
      tant_que ($fin < $nsrc et ordre($src[$fin]) != 34) { $fin = $fin + 1 }
      $chemin = sous_chaine($src, $q + 1, $fin)
      $ajout = "\n" + lire_texte($chemin) + "\n"
      $blanc = ""
      $z = $ipos
      tant_que ($z < $fin + 1) { $blanc = $blanc + " "; $z = $z + 1 }
      $src = sous_chaine($src, 0, $ipos) + $blanc + sous_chaine($src, $fin + 1, $nsrc)
      $src = $src + $ajout
    }
    $ii = $ii + 1
  }
}
$N = longueur($src)

# —— phase 1 : lexage vers $gen (types), $x (textes), $gl (lignes) ——
$gen = [""]
$x = [""]
$gl = [0]
$i = 0
$suiv = -1
$c = 0
$cc = 0
$ok = 1
$t = ""
$nx = 0
$q = 0
$buf = ""
$txt = ""
$nu = ""
$dollar = 0
$flott = 0
$point_ok = 0
$lnr = 1

$cles = table()
inserer($cles, "fn", 1)
inserer($cles, "retour", 1)
inserer($cles, "si", 1)
inserer($cles, "sinon", 1)
inserer($cles, "tant_que", 1)
inserer($cles, "pour", 1)
inserer($cles, "de", 1)
inserer($cles, "vers", 1)
inserer($cles, "vrai", 1)
inserer($cles, "faux", 1)
inserer($cles, "et", 1)
inserer($cles, "ou", 1)
inserer($cles, "non", 1)
inserer($cles, "div", 1)
inserer($cles, "entier", 1)
inserer($cles, "rationnel", 1)
inserer($cles, "flottant", 1)
inserer($cles, "booleen", 1)
inserer($cles, "chaine", 1)
inserer($cles, "liste", 1)
inserer($cles, "table", 1)

$dernier = "debut"

tant_que ($i < $N) {
  $c = ordre($src[$i])
  $suiv = -1
  si ($i + 1 < $N) { $suiv = ordre($src[$i + 1]) }
  $pchar = 10
  si ($i > 0) { $pchar = ordre($src[$i - 1]) }
  $apres = 0
  si ($dernier == "nombre" ou $dernier == "flottant" ou $dernier == "chaine" ou $dernier == "ident" ou $dernier == "mot" ou $dernier == "rparen" ou $dernier == "rbracket" ou $dernier == "multifacto" ou $dernier == "diese" ou $dernier == "terminal" ou $dernier == "superfacto" ou $dernier == "chapeau" ou $dernier == "deuxpts") { $apres = 1 }

  si ($c == 32 ou $c == 9 ou $c == 13 ou $c == 10) {
    si ($c == 10) { $lnr = $lnr + 1 }
    $i = $i + 1
  }
  sinon si ($c == 37 et $suiv == 37 et ($i == 0 ou $pchar == 10)) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1 }
    }
  }
  sinon si ($c == 35) {
    si ($apres == 1 et $i > 0 et $pchar != 32 et $pchar != 9 et $pchar != 13 et $pchar != 10) {
      joindre($gen, "diese")
      joindre($x, "#")
      joindre($gl, $lnr)
      $i = $i + 1
      $dernier = "diese"
    } sinon {
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 10) { $ok = 0 }
        sinon { $i = $i + 1 }
      }
    }
  }
  sinon si ($c == 47 et $suiv == 47) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1 }
    }
  }
  sinon si ($c == 33) {
    si ($apres == 0) {
      joindre($gen, "sfact"); joindre($x, "!"); joindre($gl, $lnr); $i = $i + 1; $dernier = "sfact"
    } sinon si ($suiv == 61) {
      joindre($gen, "!="); joindre($x, "!="); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
    } sinon {
      $txt = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 33 et non ($i + 1 < $N et ordre($src[$i + 1]) == 61)) {
          $txt = $txt + "!"
          $i = $i + 1
        } sinon { $ok = 0 }
      }
      joindre($gen, "multifacto"); joindre($x, $txt); joindre($gl, $lnr); $dernier = "multifacto"
    }
  }
  sinon si ($c == 63) {
    si ($suiv == 61) {
      joindre($gen, "≈"); joindre($x, "?="); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
    } sinon {
      $est_debut = 0
      si ($pchar == 10 ou $pchar == 59 ou $pchar == 62 ou $i == 0) { $est_debut = 1 }
      $j = $i + 1
      $okq = 1
      tant_que ($okq == 1) {
        si ($j >= $N) { $okq = 0 }
        sinon si (ordre($src[$j]) == 32 ou ordre($src[$j]) == 9 ou ordre($src[$j]) == 13) { $j = $j + 1 }
        sinon { $okq = 0 }
      }
      $suit_paren = 0
      si ($j < $N et ordre($src[$j]) == 40) { $suit_paren = 1 }
      $ouvre_si = 0
      si ($est_debut == 1 et $suit_paren == 1) { $ouvre_si = 1 }
      si ($ouvre_si == 0) {
        joindre($gen, "terminal")
        joindre($x, "?")
      } sinon {
        joindre($gen, "?")
        joindre($x, "?")
      }
      joindre($gl, $lnr)
      $i = $i + 1
      $dernier = "autre"
    }
  }
  sinon si ($c == 34 ou $c == 39) {
    $q = $c
    $dl = $lnr
    $i = $i + 1
    $buf = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon {
        $cc = ordre($src[$i])
        si ($cc == 92) {
          si ($i + 1 >= $N) { $ok = 0 }
          sinon {
            $nx = ordre($src[$i + 1])
            si ($nx == 110) { $buf = $buf + "\n" }
            sinon si ($nx == 116) { $buf = $buf + "\t" }
            sinon si ($nx == 92 ou $nx == 34 ou $nx == 39) { $buf = $buf + sous_chaine($src, $i + 1, $i + 2) }
            sinon { $buf = $buf + "\\" + sous_chaine($src, $i + 1, $i + 2) }
            $i = $i + 2
          }
        }
        sinon si ($cc == $q) {
          $i = $i + 1
          $ok = 0
        }
        sinon {
          si ($cc == 10) { $lnr = $lnr + 1 }
          $buf = $buf + $src[$i]
          $i = $i + 1
        }
      }
    }
    joindre($gen, "chaine"); joindre($x, $buf); joindre($gl, $dl); $dernier = "chaine"
  }
  sinon si (est_chiffre($c)) {
    $txt = ""
    $flott = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_chiffre(ordre($src[$i]))) {
        $txt = $txt + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    $point_ok = 0
    si ($i < $N) {
      si ($i + 1 < $N) {
        si (ordre($src[$i]) == 46 et est_chiffre(ordre($src[$i + 1]))) { $point_ok = 1 }
      }
    }
    si ($point_ok == 1) {
      $flott = 1
      $txt = $txt + "."
      $i = $i + 1
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (est_chiffre(ordre($src[$i]))) {
          $txt = $txt + $src[$i]
          $i = $i + 1
        }
        sinon { $ok = 0 }
      }
    }
    si ($flott == 1) { joindre($gen, "flottant"); $dernier = "flottant" }
    sinon { joindre($gen, "nombre"); $dernier = "nombre" }
    joindre($x, $txt)
    joindre($gl, $lnr)
  }
  sinon si ($c == 960) {
    joindre($gen, "mot"); joindre($x, "π"); joindre($gl, $lnr); $i = $i + 1; $dernier = "mot"
  }
  sinon si ($c == 966) {
    joindre($gen, "mot"); joindre($x, "φ"); joindre($gl, $lnr); $i = $i + 1; $dernier = "mot"
  }
  sinon si ($c == 36) {
    $est_var = 0
    si ($suiv != -1 et est_lettre($suiv)) { $est_var = 1 }
    si ($est_var == 0) {
      joindre($gen, "superfacto"); joindre($x, "$"); joindre($gl, $lnr); $i = $i + 1; $dernier = "superfacto"
    } sinon {
      $i = $i + 1
      $nu = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (est_suite(ordre($src[$i]))) {
          $nu = $nu + $src[$i]
          $i = $i + 1
        }
        sinon { $ok = 0 }
      }
      joindre($gen, "ident"); joindre($x, $nu); joindre($gl, $lnr); $dernier = "ident"
    }
  }
  sinon si (est_lettre($c)) {
    $nu = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_suite(ordre($src[$i]))) {
        $nu = $nu + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    si (cle_existe($cles, $nu)) { joindre($gen, "ident") } sinon { joindre($gen, "mot") }
    joindre($x, $nu)
    joindre($gl, $lnr)
    $dernier = "mot"
  }
  sinon si (paire($c, $suiv) != "") {
    joindre($gen, paire($c, $suiv)); joindre($x, sous_chaine($src, $i, $i + 2)); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
  }
  sinon si ($c == 62 et $suiv == 62) { joindre($gen, ">>"); joindre($x, ">>"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 60 et $suiv == 60) { joindre($gen, "<<"); joindre($x, "<<"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 45 et $suiv == 62) { joindre($gen, "->"); joindre($x, "->"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 61) { joindre($gen, "="); joindre($x, "="); joindre($gl, $lnr); $i = $i + 1; $dernier = "autre" }
  sinon si ($c == 58 et $suiv == 58) { joindre($gen, "::"); joindre($x, "::"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 178) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "2"); joindre($gl, $lnr); $i = $i + 1; $dernier = "nombre" }
  sinon si ($c == 179) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "3"); joindre($gl, $lnr); $i = $i + 1; $dernier = "nombre" }
  sinon si (uni($c) != "") { joindre($gen, uni($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1; $dernier = "autre" }
  sinon si (car($c) != "") {
    joindre($gen, car($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1
    si ($c == 41) { $dernier = "rparen" }
    sinon si ($c == 93) { $dernier = "rbracket" }
    sinon si ($c == 94) { $dernier = "chapeau" }
    sinon si ($c == 58) { $dernier = "deuxpts" }
    sinon { $dernier = "autre" }
  }
  sinon { $i = $i + 1 }
}
joindre($gen, "eof")
joindre($x, "")
joindre($gl, $lnr)

# —— phase 2 : descente vers les pools ——
$k = [""]
$tx = [""]
$tf = [""]
$a = [-1]
$b = [-1]
$as = [0]
$ac = [0]
$lg = [0]
$al = [-1]

$ik = [""]
$ino = [""]
$ie = [-1]
$ie2 = [-1]
$ib1 = [""]
$ib2 = [""]
$ilg = [0]

$fnoms = [""]
$fext = [""]
$fparams = [""]
$fret = [""]
$fcorps = [""]
$fligne = [0]

$foi = [-1]
$fot = [""]
$fof = [""]
$err = [""]
$tni = [0]
$tnt = [""]
$tri = [0]
$trt = [""]

$topb = ""
$p = 1
$dll = ""
$son = ""
$sym = ""

tant_que (T0($gen, $p) != "eof") {
  $t = T0($gen, $p)
  si ($t == ";") { $p = $p + 1 }
  sinon si ($t == "@" et (EMOT($gen, $x, $p + 1, "dll") ou EMOT($gen, $x, $p + 1, "sym"))) {
    $genre = VX0($x, $p + 1)
    $q = $p + 2
    si (T0($gen, $q) == "(") { $q = $q + 1 }
    si (T0($gen, $q) == "chaine") {
      si ($genre == "dll") { $dll = VX0($x, $q) }
      sinon { $sym = VX0($x, $q) }
      $q = $q + 1
      si (T0($gen, $q) == ",") {
        $q = $q + 1
        $son = VX0($x, $q)
        $q = $q + 1
      }
    }
    si (T0($gen, $q) == ")") { $q = $q + 1 }
    $p = $q
  }
  sinon si (EMOT($gen, $x, $p, "fn")) {
    $r = def_fn($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $fnoms, $fext, $fparams, $fret, $fcorps, $fligne)
    $p = SEPR($r)
  }
  sinon {
    $r = instruction($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $p = SEPR($r)
    si ($topb != "") { $topb = $topb + "," }
    $topb = $topb + NOD($r)
  }
}

$topb = rnat_flat($topb)
# —— tri des fonctions par nom (ordre std::map) ——
$ordre = [0]
$nn = longueur($fnoms)
$w = 1
tant_que ($w < $nn) {
  $best = -1
  $j = 1
  tant_que ($j < $nn) {
    $pris = 0
    $u = 1
    $no2 = longueur($ordre)
    tant_que ($u < $no2) {
      si ($ordre[$u] == $j) { $pris = 1 }
      $u = $u + 1
    }
    si ($pris == 0) {
      si ($best < 0) { $best = $j }
      sinon si (cmp_str($fnoms[$j], $fnoms[$best]) < 0) { $best = $j }
    }
    $j = $j + 1
  }
  joindre($ordre, $best)
  $w = $w + 1
}

# —— passe 1 : repli de constantes (fonctions triées, puis niveau supérieur) ——
$w = 1
tant_que ($w < longueur($ordre)) {
  $ix = $ordre[$w]
  si ($fext[$ix] == "" et longueur($err) == 1) {
    replier_chaine($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
  $w = $w + 1
}
si (longueur($err) == 1) {
  replier_chaine($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                 $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
}

# —— passe 2 : vérification ——
# pré-passe (miroir de verifier) : ne collecte que les affectations et lectures
# globales du niveau supérieur, pour que les corps de fonction les voient.
# On ne passe PAS par parcourir sur $topb entier : les boucles `pour` y
# enregistreraient leur compteur comme globale, ce que le moteur ne fait pas.
$gln = [""]
$glt = [""]
$topg = ""
$gp = 0
$gn2 = longueur($topb)
$gcur = ""
tant_que ($gp < $gn2) {
  $gc = ordre($topb[$gp])
  si ($gc == 44) {
    si ($gcur != "") {
      $gix = entier($gcur)
      si ($ik[$gix] == "affi" ou $ik[$gix] == "lire") {
        si ($topg != "") { $topg = $topg + "," }
        $topg = $topg + $gcur
      }
      $gcur = ""
    }
  } sinon { $gcur = $gcur + $topb[$gp] }
  $gp = $gp + 1
}
si ($gcur != "") {
  $gix = entier($gcur)
  si ($ik[$gix] == "affi" ou $ik[$gix] == "lire") {
    si ($topg != "") { $topg = $topg + "," }
    $topg = $topg + $gcur
  }
}
$topg = rnat_flat($topg)
$err2 = [""]
$tni2 = [0]
$tnt2 = [""]
$tri2 = [0]
$trt2 = [""]
$lc0 = [""]
$lct0 = [""]
si (longueur($err) == 1) {
  parcourir($topg, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
            $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
            $gln, $glt, $gln, $glt, $lc0, $lct0,
            $fnoms, $fparams, $fret, $foi, $fot, $fof, 0, "vide|vide", $err2, $tni2, $tnt2, $tri2, $trt2)
}
$w = 1
tant_que ($w < longueur($ordre)) {
  si (longueur($err) == 1) {
    $ix = $ordre[$w]
    si ($fext[$ix] != "") {
      $ps = $fparams[$ix]
      $np = nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = piece($ps, 59, $u)
        $pp = premier_pipe($ent)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        $bb = BASE($pt)
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          signaler($fligne[$ix], "Type " + nomty($pt) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
        $u = $u + 1
      }
      $bb = BASE($fret[$ix])
      si (longueur($err) == 1) {
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          signaler($fligne[$ix], "Type " + nomty($fret[$ix]) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
      }
    }
    sinon {
      $lc = [""]
      $lct = [""]
      $ps = $fparams[$ix]
      $np = nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = piece($ps, 59, $u)
        $pp = premier_pipe($ent)
        $pn = sous_chaine($ent, 0, $pp)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        reserver($pn, 0, $err)
        env_put($pn, $pt, $lc, $lct)
        $u = $u + 1
      }
      parcourir($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $lc, $lct, $gln, $glt, $lc, $lct,
                $fnoms, $fparams, $fret, $foi, $fot, $fof, 1, $fret[$ix], $err, $tni, $tnt, $tri, $trt)
    }
  }
  $w = $w + 1
}

# —— passe 2 (suite) : instructions de tête, environnement = globales ——
$lc = [""]
$lct = [""]
si (longueur($err) == 1) {
  parcourir($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
            $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
            $gln, $glt, $gln, $glt, $lc, $lct,
            $fnoms, $fparams, $fret, $foi, $fot, $fof, 0, "vide|vide", $err, $tni, $tnt, $tri, $trt)
}

# —— passe 3 : émission RIR (oracle « rose rir ») ——
# Fonctions triées (ordre std::map, externes sans corps), puis le niveau
# supérieur sous $principal ; compteurs %t et suffixes de bloc sans reprise.
$outl = [""]
joindre($outl, "rir")
# liste des fonctions à corps (RIR_CONNUS)
$connus = [""]
$w = 1
tant_que ($w < longueur($ordre)) {
  $ix = $ordre[$w]
  si ($fext[$ix] == "") { joindre($connus, $fnoms[$ix]) }
  $w = $w + 1
}
si (longueur($err) == 1) {
  $w = 1
  tant_que ($w < longueur($ordre)) {
    $ix = $ordre[$w]
    si ($fext[$ix] == "") {
      em_fonction_rir($fnoms[$ix], $fparams[$ix], $fret[$ix], $fcorps[$ix], faux,
                  $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                  $foi, $fot, $fof, $connus, $outl)
    } sinon {
      joindre($outl, "fonction " + $fnoms[$ix] + " (sans RIR)")
    }
    $w = $w + 1
  }
  em_fonction_rir("$principal", "", "vide|vide", $topb, vrai,
              $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $foi, $fot, $fof, $connus, $outl)
}
si (longueur($err) > 1) { retour $err[1] }
$rnat_parts = [""]
$u = 1
tant_que ($u < longueur($outl)) {
  joindre($rnat_parts, $outl[$u] + "\n")
  $u = $u + 1
}
$rnat_dump = rnat_join($rnat_parts, 1, longueur($rnat_parts))
retour $rnat_dump


}

# emetteur_elf.rose — Émetteur ELF64 natif pour Rose.
# Génère un binaire ELF exécutable autonome à partir d'un programme Rose.
# Zéro dépendance externe : pas de rustc, pas de clang, pas de LLVM.
# Utilisation : rose/rose run compilateur/emetteur_elf.rose prog.rose -o sortie

# ═══════════════════════════════════════════════════════════════════════
# eval_expr — évaluateur d'expressions Rose EN ROSE PUR (sous-ensemble G5).
# Miroir de la primitive native `eval_expr` (rose/src/interp.rs:5717) :
#   entrée "<expr> // vars: nom=valeur …" -> chaîne résultat.
# Formes couvertes : entiers exacts, rationnels, flottants, chaînes,
# booléens, variables du contexte, + - * / % ^, comparaisons, et/ou/non,
# parenthèses et opérateurs unaires. Toutes les variables sont LOCALES
# (aucune globale G5 ajoutée : la table reste sous la borne des 512).
# ═══════════════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════════════
# eval_expr — évaluateur d'expressions Rose en Rose pur (sous-ensemble G5).
# Contrat (miroir de interp.rs "eval_expr") :
#   entrée  : "<expr> // vars: nom=valeur nom=valeur …"
#   sortie  : chaîne — littéral guillemeté, atome nu, ou résultat évalué.
# Formes couvertes : entiers exacts, rationnels, flottants, chaînes,
# booléens, variables du contexte, + - * / % ^, comparaisons, et/ou/non,
# parenthèses, unaires.
# ═══════════════════════════════════════════════════════════════════════

fn ee_trim($s: chaine) -> chaine {
  $a = 0
  $b = longueur($s)
  tant_que ($a < $b et sous_chaine($s, $a, $a + 1) == " ") { $a = $a + 1 }
  tant_que ($b > $a et sous_chaine($s, $b - 1, $b) == " ") { $b = $b - 1 }
  retour sous_chaine($s, $a, $b)
}

# Bounded code-point access for the ee_* helpers. Both the Rust engine and
# G5 count code points (G5 ordre decodes 1..4 UTF-8 bytes), so no helper may
# index a string by raw byte or run past its end.
fn ee_car($s: chaine, $i: entier) -> chaine {
  si ($i < 0 ou $i >= longueur($s)) { retour "" }
  retour sous_chaine($s, $i, $i + 1)
}

fn ee_oc($s: chaine, $i: entier) -> entier {
  $c = ee_car($s, $i)
  si (longueur($c) == 0) { retour -1 }
  retour ordre($c)
}

fn ee_trouve($s: chaine, $mot: chaine) -> entier {
  $n = longueur($s)
  $m = longueur($mot)
  $i = 0
  tant_que ($i + $m <= $n) {
    $k = 0
    $ok = 1
    tant_que ($k < $m et $ok == 1) {
      si (ee_car($s, $i + $k) != ee_car($mot, $k)) { $ok = 0 }
      $k = $k + 1
    }
    si ($ok == 1) { retour $i }
    $i = $i + 1
  }
  retour -1
}

fn ee_tokens($s: chaine) -> liste<chaine> {
  $r = [""]
  $i = 0
  $n = longueur($s)
  tant_que ($i < $n) {
    $c = sous_chaine($s, $i, $i + 1)
    si ($c == " " ou $c == "\t" ou $c == "\n" ou $c == "\r") {
      $i = $i + 1
    } sinon si ($c == "\"") {
      $j = $i + 1
      $buf = ""
      tant_que ($j < $n et sous_chaine($s, $j, $j + 1) != "\"") {
        $buf = $buf + sous_chaine($s, $j, $j + 1)
        $j = $j + 1
      }
      joindre($r, "S:" + $buf)
      $i = $j + 1
    } sinon si ($c == "(" ou $c == ")" ou $c == "[" ou $c == "]" ou
                $c == "+" ou $c == "-" ou $c == "*" ou $c == "/" ou
                $c == "%" ou $c == "^" ou
                $c == ",") {
      joindre($r, "O:" + $c)
      $i = $i + 1
    } sinon si ($c == "=" ou $c == "!" ou $c == "<" ou $c == ">") {
      si ($i + 1 < $n et sous_chaine($s, $i + 1, $i + 2) == "=") {
        joindre($r, "O:" + $c + "=")
        $i = $i + 2
      } sinon {
        joindre($r, "O:" + $c)
        $i = $i + 1
      }
    } sinon si ($c >= "0" et $c <= "9") {
      $j = $i
      $buf = ""
      $fin = 0
      tant_que ($j < $n et $fin == 0) {
        $d = sous_chaine($s, $j, $j + 1)
        si (($d >= "0" et $d <= "9") ou $d == ".") {
          $buf = $buf + $d
          $j = $j + 1
        } sinon si (($d == "e" ou $d == "E") et $j + 1 < $n) {
          $buf = $buf + $d
          $j = $j + 1
          $sg = sous_chaine($s, $j, $j + 1)
          si ($sg == "+" ou $sg == "-") { $buf = $buf + $sg; $j = $j + 1 }
        } sinon { $fin = 1 }
      }
      joindre($r, "N:" + $buf)
      $i = $j
    } sinon si (($c >= "a" et $c <= "z") ou ($c >= "A" et $c <= "Z") ou
                $c == "_" ou $c == "$") {
      $j = $i
      $buf = ""
      $fin = 0
      tant_que ($j < $n et $fin == 0) {
        $d = sous_chaine($s, $j, $j + 1)
        si (($d >= "a" et $d <= "z") ou ($d >= "A" et $d <= "Z") ou
            ($d >= "0" et $d <= "9") ou $d == "_" ou $d == "$") {
          $buf = $buf + $d
          $j = $j + 1
        } sinon { $fin = 1 }
      }
      joindre($r, "W:" + $buf)
      $i = $j
    } sinon {
      joindre($r, "O:" + $c)
      $i = $i + 1
    }
  }
  retour $r
}

fn ee_var($ctx: chaine, $nom: chaine) -> chaine {
  $res = ""
  $buf = ""
  $p = 0
  $n = longueur($ctx)
  tant_que ($p <= $n) {
    $c = ""
    si ($p < $n) { $c = sous_chaine($ctx, $p, $p + 1) }
    si ($p == $n ou $c == " " ou $c == "\t" ou $c == "\n" ou $c == ",") {
      $eq = -1
      $k = 0
      tant_que ($k < longueur($buf)) {
        si (sous_chaine($buf, $k, $k + 1) == "=" et $eq < 0) { $eq = $k }
        $k = $k + 1
      }
      si ($eq > 0) {
        si (sous_chaine($buf, 0, $eq) == $nom) {
          $val = sous_chaine($buf, $eq + 1, longueur($buf))
          # Une paire malformée (ex. "a==") n'est PAS une définition : la
          # primitive native rend alors l'expression non substituée.
          si (longueur($val) > 0 et sous_chaine($val, 0, 1) != "=") { $res = $val }
        }
      }
      $buf = ""
    } sinon {
      $buf = $buf + $c
    }
    $p = $p + 1
  }
  retour $res
}

fn ee_num($s: chaine) {
  $slash = -1
  $dot = -1
  $exp = -1
  $k = 0
  tant_que ($k < longueur($s)) {
    $c = sous_chaine($s, $k, $k + 1)
    si ($c == "/" et $slash < 0) { $slash = $k }
    si ($c == "." et $dot < 0) { $dot = $k }
    si (($c == "e" ou $c == "E") et $exp < 0) { $exp = $k }
    $k = $k + 1
  }
  si ($slash > 0) {
    $a = sous_chaine($s, 0, $slash)
    $b = sous_chaine($s, $slash + 1, longueur($s))
    retour fraction(entier($a), entier($b))
  }
  si ($dot >= 0 ou $exp >= 0) { retour flottant($s) }
  retour entier($s)
}

fn ee_norm_num($s: chaine) -> chaine {
  $slash = ee_trouve($s, "/")
  $dot = ee_trouve($s, ".")
  $exp = ee_trouve($s, "e")
  si ($exp < 0) { $exp = ee_trouve($s, "E") }
  si ($slash >= 0) {
    retour chaine(ee_num($s))
  }
  si ($dot >= 0 ou $exp >= 0) {
    $f = flottant($s)
    $z = entier($f)
    si ($f == $z) { retour chaine($z) }
    retour chaine($f)
  }
  retour chaine(entier($s))
}

fn ee_op($tok: chaine) -> chaine {
  $p = ee_trouve($tok, ":")
  $v = sous_chaine($tok, $p + 1, longueur($tok))
  si ($p >= 0 et sous_chaine($tok, 0, 1) == "O") { retour $v }
  si ($p >= 0 et sous_chaine($tok, 0, 1) == "W") {
    si ($v == "et" ou $v == "ou" ou $v == "non") { retour $v }
  }
  retour ""
}

fn ee_prec($op: chaine) -> entier {
  si ($op == "ou") { retour 1 }
  si ($op == "et") { retour 2 }
  si ($op == "==" ou $op == "!=" ou $op == "<" ou $op == ">" ou
      $op == "<=" ou $op == ">=") { retour 3 }
  si ($op == "+" ou $op == "-") { retour 4 }
  si ($op == "*" ou $op == "/" ou $op == "%") { retour 5 }
  si ($op == "^") { retour 6 }
  retour 0
}

fn ee_apply($op: chaine, $k1: chaine, $v1: chaine, $k2: chaine, $v2: chaine, $orig: chaine) -> liste<chaine> {
  $rr = ["", "", $orig, ""]
  si ($k1 == "u" ou $k2 == "u") {
    $rr = ["", "u", $orig, ""]
    retour $rr
  }
  $b1 = 0
  si ($v1 == "vrai") { $b1 = 1 }
  $b2 = 0
  si ($v2 == "vrai") { $b2 = 1 }
  si ($op == "et") {
    si ($b1 == 1 et $b2 == 1) { $rr = ["", "b", "vrai", ""] } sinon { $rr = ["", "b", "faux", ""] }
    retour $rr
  }
  si ($op == "ou") {
    si ($b1 == 1 ou $b2 == 1) { $rr = ["", "b", "vrai", ""] } sinon { $rr = ["", "b", "faux", ""] }
    retour $rr
  }
  # Comparaisons
  si ($op == "==" ou $op == "!=" ou $op == "<" ou $op == ">" ou
      $op == "<=" ou $op == ">=") {
    $cg = 0
    si ($k1 == "s" et $k2 == "s") {
      si ($op == "==") { si ($v1 == $v2) { $cg = 1 } }
      si ($op == "!=") { si ($v1 != $v2) { $cg = 1 } }
      si ($op == "<") { si ($v1 < $v2) { $cg = 1 } }
      si ($op == ">") { si ($v1 > $v2) { $cg = 1 } }
      si ($op == "<=") { si ($v1 <= $v2) { $cg = 1 } }
      si ($op == ">=") { si ($v1 >= $v2) { $cg = 1 } }
    } sinon {
      $x = ee_num($v1)
      $y = ee_num($v2)
      si ($op == "==") { si ($x == $y) { $cg = 1 } }
      si ($op == "!=") { si ($x != $y) { $cg = 1 } }
      si ($op == "<") { si ($x < $y) { $cg = 1 } }
      si ($op == ">") { si ($x > $y) { $cg = 1 } }
      si ($op == "<=") { si ($x <= $y) { $cg = 1 } }
      si ($op == ">=") { si ($x >= $y) { $cg = 1 } }
    }
    si ($cg == 1) { $rr = ["", "b", "vrai", ""] } sinon { $rr = ["", "b", "faux", ""] }
    retour $rr
  }
  # Concaténation de chaînes
  si ($op == "+" et ($k1 == "s" ou $k2 == "s")) {
    $rr = ["", "s", $v1 + $v2, ""]
    retour $rr
  }
  $x = ee_num($v1)
  $y = ee_num($v2)
  # Chaque branche RETOURNE immédiatement : le type de $rr est ainsi celui
  # du résultat réel (entier exact, rationnel ou flottant), sans figer $z.
  si ($op == "+") {
    $rr = ["", "n", chaine($x + $y), ""]
    retour $rr
  }
  si ($op == "-") {
    $rr = ["", "n", chaine($x - $y), ""]
    retour $rr
  }
  si ($op == "*") {
    $rr = ["", "n", chaine($x * $y), ""]
    retour $rr
  }
  si ($op == "/") {
    $rr = ["", "n", chaine($x / $y), ""]
    retour $rr
  }
  si ($op == "%") {
    $rr = ["", "n", chaine(entier($v1) % entier($v2)), ""]
    retour $rr
  }
  si ($op == "^") {
    $rr = ["", "n", chaine(ee_puissance($x, entier($v2))), ""]
    retour $rr
  }
  retour $rr
}

fn ee_puissance($base, $exp: entier) {
  $r = $base - $base + 1
  $i = 0
  tant_que ($i < $exp) { $r = $r * $base; $i = $i + 1 }
  retour $r
}

fn ee_atom($t: liste<chaine>, $p: entier, $ctx: chaine, $orig: chaine) -> liste<chaine> {
  $rr = ["", "", $orig, ""]
  $tok = $t[$p]
  $pref = sous_chaine($tok, 0, 1)
  $v = sous_chaine($tok, 2, longueur($tok))
  si ($v == "non" et $pref == "W") {
    $r = ee_atom($t, $p + 1, $ctx, $orig)
    si ($r[1] == "u") { retour $r }
    si ($r[2] == "vrai") { $rr = ["", "b", "faux", $r[3]] } sinon { $rr = ["", "b", "vrai", $r[3]] }
    retour $rr
  }
  si ($v == "-" et $pref == "O") {
    $r = ee_atom($t, $p + 1, $ctx, $orig)
    si ($r[1] == "u") { retour $r }
    $zz = 0 - ee_num($r[2])
    $rr = ["", "n", chaine($zz), $r[3]]
    retour $rr
  }
  si ($v == "(" et $pref == "O") {
    $r = ee_parse($t, $p + 1, $ctx, 1, $orig)
    $q = entier($r[3])
    si ($q < longueur($t) et ee_op($t[$q]) == ")") { $q = $q + 1 }
    $rr = ["", $r[1], $r[2], chaine($q)]
    retour $rr
  }
  si ($pref == "S") { $rr = ["", "s", $v, chaine($p + 1)]; retour $rr }
  si ($pref == "N") { $rr = ["", "n", ee_norm_num($v), chaine($p + 1)]; retour $rr }
  si ($pref == "W") {
    si ($v == "vrai" ou $v == "faux") { $rr = ["", "b", $v, chaine($p + 1)]; retour $rr }
    $nom = $v
    si (sous_chaine($nom, 0, 1) == "$") { $nom = sous_chaine($nom, 1, longueur($nom)) }
    $val = ee_var($ctx, $nom)
    si (longueur($val) == 0) { $rr = ["", "u", $orig, ""]; retour $rr }
    # La valeur substituée est un atome : chaîne guillemetée, booléen ou nombre.
    si (longueur($val) >= 2 et sous_chaine($val, 0, 1) == "\"" et
        sous_chaine($val, longueur($val) - 1, longueur($val)) == "\"") {
      $rr = ["", "s", sous_chaine($val, 1, longueur($val) - 1), chaine($p + 1)]
      retour $rr
    }
    si ($val == "vrai" ou $val == "faux") { $rr = ["", "b", $val, chaine($p + 1)]; retour $rr }
    $rr = ["", "n", $val, chaine($p + 1)]
    retour $rr
  }
  retour $rr
}

fn ee_parse($t: liste<chaine>, $p: entier, $ctx: chaine, $min: entier, $orig: chaine) -> liste<chaine> {
  $r = ee_atom($t, $p, $ctx, $orig)
  $k = $r[1]
  $v = $r[2]
  $q = entier($r[3])
  $fin = 0
  tant_que ($q < longueur($t) et $fin == 0) {
    $op = ee_op($t[$q])
    $pr = ee_prec($op)
    si ($pr < $min ou $pr == 0) { $fin = 1 }
    sinon {
      $droite = ee_parse($t, $q + 1, $ctx, $pr + 1, $orig)
      $r2 = ee_apply($op, $k, $v, $droite[1], $droite[2], $orig)
      $k = $r2[1]
      $v = $r2[2]
      $q = entier($droite[3])
    }
  }
  $rr = ["", $k, $v, chaine($q)]
  retour $rr
}

fn eval_expr($expr: chaine) -> chaine {
  $base = ee_trim($expr)
  # Séparateur de contexte : "// vars:" (et variantes), coupé AVANT le "//".
  $sep = ee_trouve($base, "// vars:")
  $saut = 9
  si ($sep < 0) { $sep = ee_trouve($base, "//vars:"); $saut = 7 }
  si ($sep < 0) { $sep = ee_trouve($base, "; vars:"); $saut = 7 }
  si ($sep < 0) { $sep = ee_trouve($base, ";vars:"); $saut = 6 }
  si ($sep < 0) { $sep = ee_trouve($base, "vars:"); $saut = 5 }
  $nu = $base
  $ctx = ""
  si ($sep >= 0) {
    $nu = ee_trim(sous_chaine($base, 0, $sep))
    $ctx = sous_chaine($base, $sep + $saut, longueur($base))
  }
  # Littéral guillemeté englobant.
  $ln = longueur($nu)
  si ($ln >= 2 et sous_chaine($nu, 0, 1) == "\"" et
      sous_chaine($nu, $ln - 1, $ln) == "\"") {
    retour sous_chaine($nu, 1, $ln - 1)
  }
  si ($ln == 0) { retour "" }
  # Un contexte malformé (paire "a==" issue du préprocesseur) fait échouer
  # le repli natif : l'expression est alors rendue telle quelle.
  si (ee_trouve($ctx, "==") >= 0) { retour $nu }
  si ($nu == "vrai" ou $nu == "faux") { retour $nu }
  $toks = ee_tokens($nu)
  $r = ee_parse($toks, 1, $ctx, 1, $nu)
  si ($r[1] == "u") { retour $nu }
  si (longueur($r[2]) == 0) { retour $nu }
  retour $r[2]
}

# ── Utilitaires d'écriture little-endian ──
# OCTET_BRUT : `caractere(n)` encode un POINT DE CODE en UTF-8. Sous le moteur
# Rust, ecrire_bytes ecrit `c as u8` par caractere (1 octet), mais des que
# l'emetteur est auto-exécute (chemin G5) la chaine est deja UTF-8 : un octet
# >= 128 devient 2 octets (ex. 0xb7 -> c2 b7) et l'en-tete ELF est corrompu.
# `octet_brut` est intercepte par le dispatch G5 ($g5_octetll) et y fabrique
# un descripteur [tag=1][len=1][1 octet] SANS encodage UTF-8. Cote Rust sa
# definition reste identique a l'ancien `caractere($v % 256)` : 1 code point
# -> 1 octet ecrit. Les signatures/ids ne changent pas (point fixe b3ed9262).
fn octet_brut($v: entier) -> chaine {
  retour caractere($v % 256)
}

fn u8le($v: entier) -> chaine {
  retour octet_brut($v)
}

fn u16le($v: entier) -> chaine {
  $b0 = $v % 256
  $b1 = partie_entiere($v / 256) % 256
  retour octet_brut($b0) + octet_brut($b1)
}

fn u32le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = partie_entiere($v / 256)
  $b1 = $v1 % 256
  $v2 = partie_entiere($v1 / 256)
  $b2 = $v2 % 256
  $v3 = partie_entiere($v2 / 256)
  $b3 = $v3 % 256
  retour octet_brut($b0) + octet_brut($b1) + octet_brut($b2) + octet_brut($b3)
}

fn u64le($v: entier) -> chaine {
  $b0 = $v % 256
  $v1 = partie_entiere($v / 256)
  $b1 = $v1 % 256
  $v2 = partie_entiere($v1 / 256)
  $b2 = $v2 % 256
  $v3 = partie_entiere($v2 / 256)
  $b3 = $v3 % 256
  $v4 = partie_entiere($v3 / 256)
  $b4 = $v4 % 256
  $v5 = partie_entiere($v4 / 256)
  $b5 = $v5 % 256
  $v6 = partie_entiere($v5 / 256)
  $b6 = $v6 % 256
  $v7 = partie_entiere($v6 / 256)
  $b7 = $v7 % 256
  retour octet_brut($b0) + octet_brut($b1) + octet_brut($b2) + octet_brut($b3) + octet_brut($b4) + octet_brut($b5) + octet_brut($b6) + octet_brut($b7)
}


fn g4_pos($s: chaine, $mot: chaine) -> entier {
  $p = 0
  $ln = longueur($s)
  $lm = longueur($mot)
  si ($lm == 0) { retour 0 }
  tant_que ($p + $lm <= $ln et sous_chaine($s, $p, $p + $lm) != $mot) { $p = $p + 1 }
  si ($p + $lm > $ln) { retour -1 }
  retour $p
}
fn g4_entier_ou_zero($s: chaine) -> entier {
  $t = g4_trim($s)
  $n = longueur($t)
  si ($n == 0) { retour 0 }
  $neg = 0
  $i = 0
  si (sous_chaine($t, 0, 1) == "-") {
    $neg = 1
    $i = 1
    # G5-TYPE : le RIR sérialise les entiers négatifs avec un DOUBLE moins
    # (« (n --1) », 62 occurrences dans fp.rir), pour les distinguer du
    # token de soustraction. N'enlever qu'un seul '-' rendait --1 = 0 et
    # faussait le dump réflexif.
    si ($n >= 2 et sous_chaine($t, 1, 2) == "-") { $i = 2 }
  }
  # $deb = début des chiffres (après un ou deux '-'), capturé AVANT la
  # boucle de validation qui avance $i. L'ancien `$deb = 1` fixe rendait
  # entier("-7") = -7 puis -(-7) = +7 : le signe était perdu.
  $deb = $i
  $ok = 1
  tant_que ($i < $n) {
    $c = sous_chaine($t, $i, $i + 1)
    # SH10 : sous G5, `<`/`>` sur des chaînes comparent des POINTEURS tagués
    # (g5_eval émet cmpr), pas des caractères : la validation échouait et
    # TOUT entier textuel devenait 0 (mesuré : `mov x0,#0` au lieu de #3
    # dans l'ELF auto-émis, et branch kind 0 au lieu de 1). Comparer les
    # ORDINAUX, qui sont des entiers, fonctionne dans les deux mondes.
    si (ordre($c) < 48 ou ordre($c) > 57) { $ok = 0 }
    $i = $i + 1
  }
  si ($ok == 0) { retour 0 }
  $v = entier(sous_chaine($t, $deb, $n))
  si ($neg == 1) { retour -$v }
  retour $v
}

# SH4 : formatage ROSE d'un rationnel RIR "a/b" au moment de l'émission.
# Miroir de rose/src/run.rs::texte_rationnel (7/3 -> 2.[3], 5/2 -> 2.5,
# 1/3 -> 0.[3], 22/7 -> 3.[142857]). L'ABI G5 n'a pas de rationnels : sans
# ceci, `>> 7/3` (RIR `(f 7/3)`) donnait 0 au lieu de 2.[3] (mesuré).
fn g4_ratio_texte($tok: chaine) -> chaine {
  $p = g4_pos($tok, "/")
  si ($p < 0) { retour $tok }
  $a = entier(sous_chaine($tok, 0, $p))
  $b = entier(sous_chaine($tok, $p + 1, longueur($tok)))
  si ($b == 0) { retour "0" }
  $neg = 0
  si ($a < 0) { $neg = 1; $a = -$a }
  $ent = $a div $b
  $reste = $a - $ent * $b
  $digits = ""
  $restes = [0 : entier]
  $positions = [0 : entier]
  $peri = -1
  tant_que ($reste != 0 et longueur($digits) < 200 et $peri < 0) {
    $i = 0
    tant_que ($i < longueur($restes) et $peri < 0) {
      si ($restes[$i] == $reste) { $peri = $positions[$i] }
      $i = $i + 1
    }
    si ($peri < 0) {
      joindre($restes, $reste)
      joindre($positions, longueur($digits))
      $reste = $reste * 10
      $chiffre = $reste div $b
      $reste = $reste - $chiffre * $b
      $digits = $digits + chaine($chiffre)
    }
  }
  # SH12 : convention Rose pour un rationnel négatif -a/b : la partie
  # entière est $ent+1 (plancher de -a/b) quand il reste des décimales,
  # mais les CHIFFRES restent ceux de la valeur absolue a/b.
  # Mesure : -7/3 -> -3.[3] (pas -2.[3]) ; -7/2 -> -4.5 ; -1/2 -> -1.5.
  $part = $ent
  si ($neg == 1 et longueur($digits) > 0) { $part = $ent + 1 }
  $out = chaine($part)
  si (longueur($digits) > 0) {
    $out = $out + "."
    $fin = longueur($digits)
    si ($peri >= 0) { $fin = $peri }
    $out = $out + sous_chaine($digits, 0, $fin)
    si ($peri >= 0) { $out = $out + "[" + sous_chaine($digits, $peri, longueur($digits)) + "]" }
  }
  si ($neg == 1) { $out = "-" + $out }
  retour $out
}
fn g4_trim($s: chaine) -> chaine {
  $r = $s
  $n = longueur($r)
  tant_que ($n > 0 et sous_chaine($r, 0, 1) == " ") { $r = sous_chaine($r, 1, $n); $n = longueur($r) }
  tant_que ($n > 0 et sous_chaine($r, $n - 1, $n) == " ") { $r = sous_chaine($r, 0, $n - 1); $n = longueur($r) }
  retour $r
}
fn g4_lignes($s: chaine) -> liste<chaine> {
  $res = [""]
  $i = 0
  $n = longueur($s)
  $deb = 0
  tant_que ($i <= $n) {
    si ($i == $n ou sous_chaine($s, $i, $i + 1) == "\n") {
      $ligne = sous_chaine($s, $deb, $i)
      $ln = longueur($ligne)
      si ($ln > 0 et sous_chaine($ligne, $ln - 1, $ln) == "\r") { $ligne = sous_chaine($ligne, 0, $ln - 1) }
      joindre($res, $ligne)
      $deb = $i + 1
    }
    $i = $i + 1
  }
  retour $res
}
fn g4_operand($op: chaine, $mot: chaine) -> chaine {
  $p = g4_pos($op, $mot)
  si ($p < 0) { retour "" }
  $i = $p + longueur($mot)
  $n = longueur($op)
  tant_que ($i < $n et sous_chaine($op, $i, $i + 1) == " ") { $i = $i + 1 }
  retour g4_trim(sous_chaine($op, $i, $n))
}
fn g5_nu_op($ligne: chaine) -> chaine {
  # SH10 : le format RIR est FIXE — main.rs::rir_op écrit `{:04} ` devant
  # chaque op. L'ancien test `caractere >= "0" et <= "9"` comparait des
  # POINTEURS tagués sous G5 (g5_eval émet cmpr sur les valeurs, pas un
  # ordre lexicographique) : le préfixe "0000 " n'était donc pas retiré et
  # la première op rendait `op non couverte : 0000 …`. Couper 5 octets
  # fonctionne identiquement en natif et sous G5.
  retour g5_sub($ligne, 5, longueur($ligne))
}

# ── État (listes append-only ; joindre mute l'objet partagé) ──
$g5_code = [0 : entier]
$g5_meta = [0 : chaine]
# G5-LABEL — résolution des étiquettes en O(1) amorti par bucket.
# AVANT : $g5_lbldef était une liste de chaînes "label|position" et
# g5_labelidx() faisait une recherche LINÉAIRE qui construisait 2 sous-chaînes
# + 1 chaîne() + 1 parsing d'entier À CHAQUE COMPARAISON. Or g5_patch() appelle
# g5_labelidx() pour CHAQUE saut : le coût était O(sauts × étiquettes) en
# DESCRIPTEURS ALLOUÉS sur le tas montant (jamais libérés). Mesuré en émetteur
# hébergé sur noyau.rir : 46,27 s avant / 4,60 s après, ELF byte-identique.
# (Le pic de 84 Gio de C1 venait surtout de g5_assemble, voir plus bas.)
# MAINTENANT : 256 tables à clés ENTIÈRES (déjà émises en G5 : g5_emit_table /
# g5_emit_inser / g5_emit_clex), indexées par `étiquette % 256`. Aucune chaîne
# intermédiaire, aucune allocation par lookup. Le descripteur de table est
# partagé via la liste ($t[$bucket] mutation en place, vérifié natif et ELF).
$g5_lbtabs = [table()]
$g5_lbti = 1
tant_que ($g5_lbti < 256) { joindre($g5_lbtabs, table()); $g5_lbti = $g5_lbti + 1 }
$g5_ctr = [0]
$g5_fn = [0 : chaine]
$g5_fnslot = [0 : entier]
$g5_fnam = [0 : chaine]
$g5_fop = [0 : entier]
$g5_fnop = [0 : entier]
$g5_flbl = [0 : entier]
$g5_fparam = [0 : entier]
# SH4 : type de retour déclaré ("entier", "booleen", "vide", …), utilisé par
# g5_est_bool pour afficher "vrai"/"faux" comme le fait l'interpréteur Rose
# sans JIT (mesuré : ROSE_SANS_JIT=1 donne toujours vrai/faux, le JIT courant
# affiche parfois 1/0 — bug de l'interpréteur, hors de ce fichier).
$g5_fret = [0 : chaine]
$g5_ops = [0 : chaine]
$g5_oplbl = [0 : entier]
$g5_endlbl = [0 : entier]
$g5_err = [0 : chaine]
# SH4 : slots ayant recu une expression booleenne, indexes "fonction|slot".
# Table Rose native (l'emetteur s'execute dans rose/rose, pas dans l'ELF emis).
$g5_sbool = table()
# SH6 : table d'émission associant f|slot au genre d'élément d'une liste
# (0=entier, 1=chaîne, 2=booléen). Sert à afficher `>> $l` correctement.
$g5_slist = table()
# G5-FORMULES (vague 71) : table des slots dont la valeur est un entier/rationnel
# EXACT connu à l'émission (clé "fonction|slot", valeur "num/den", "" = inconnu).
# Le compilateur natif Rose calcule les grands entiers et rationnels sans émettre
# de routine multi-limbes : on replie les expressions arithmétiques dont toutes
# les feuilles sont des constantes connues, puis on sérialise le résultat. Ceci
# est une FORMULE d'émission, pas un changement d'ABI, donc F1 == F2 est préservé.
$g5_sconst = table()
# Une fonction contenant un saut a ses constantes invalidées (clair SET de
# drapeau, sans `cles()` : primitive NON émise en G5 -> stub0 -> longueur(0)
# ferait segfaulter F1 sur sa propre RIR, mesuré/anticipé en vague 71).
$g5_snostore = table()
# SH10 (C1) : table des GLOBALES du RIR. Le RIR déclare les variables du
# niveau principal dans la ligne `globaux` (indices de slots). Sous G5, les
# fonctions les voient par leur NOM, sans slot local : il faut donc une zone
# RW à adresse fixe et une table nom -> index. Table = LISTE mutée en place
# par joindre() : une fonction qui AFFECTE une globale créerait une LOCALE
# (mesuré : `fn f(){$x="abc"}` laisse $x vide en natif). Entrée 0 = sentinelle,
# puis une chaîne "ix:nom" par globale du $principal.
$g5_gnams = [""]

fn g5_sub($s: chaine, $a: entier, $b: entier) -> chaine {
  si ($a < 0 ou $b < 0 ou $a > $b) {
    joindre($g5_err, "sous_chaine invalide : " + chaine($a) + ".." + chaine($b) + " sur " + chaine(longueur($s)) + " octets")
    retour ""
  }
  $n = longueur($s)
  $fin = $b
  si ($fin > $n) { $fin = $n }
  $deb = $a
  si ($deb > $n) { $deb = $n }
  retour sous_chaine($s, $deb, $fin)
}

fn g5_next() -> entier { joindre($g5_ctr, 0); retour longueur($g5_ctr) - 1 }
fn g5_wrap($v: entier, $m: entier) -> entier {
  $r = $v % $m
  si ($r < 0) { $r = $r + $m }
  retour $r
}
fn g5_emit($w: entier) -> entier {
  joindre($g5_code, g5_wrap($w, 4294967296))
  joindre($g5_meta, "")
  retour longueur($g5_code) - 1
}
fn g5_branch($kind: entier, $l: entier) -> entier {
  joindre($g5_code, 0)
  joindre($g5_meta, "F" + chaine($l) + "|" + chaine($kind))
  retour longueur($g5_code) - 1
}
# Saut court à déplacement CONSTANT, résolu à l'émission (pas de label).
# Utilisé uniquement dans les patrons de dispatch de tag.
fn g5_branch_off($kind: entier, $off: entier) -> entier {
  si ($kind == 0) { g5_emit(335544320 + g5_wrap($off, 67108864)); retour 0 }
  si ($kind == 1) { g5_emit(2483027968 + g5_wrap($off, 67108864)); retour 0 }
  g5_emit(1409286144 + g5_wrap($off, 524288) * 32 + ($kind - 100))
  retour 0
}
# G5-LABEL : une seule insertion par étiquette, clé = entier, valeur = position.
fn g5_mark($l: entier) -> entier {
  $p = longueur($g5_code)
  si ($l >= 0) { inserer($g5_lbtabs[$l % 256], $l, $p) }
  retour $p - 1
}
fn g5_labelidx($l: entier) -> entier {
  si ($l < 0) { retour -1 }
  $t = $g5_lbtabs[$l % 256]
  si (cle_existe($t, $l)) { retour g4_entier_ou_zero(chaine($t[$l])) }
  retour -1
}
fn g5_fail($msg: chaine) -> entier { joindre($g5_err, $msg); retour -1 }

# ── Encodage AArch64 — bases vérifiées par objdump sur gx10-2 (aarch64) ──
fn movz($rd: entier, $im: entier) -> entier { retour 3531603968 + $im * 32 + $rd }
fn movk($rd: entier, $im: entier, $sh: entier) -> entier { retour 4068474880 + $sh * 2097152 + $im * 32 + $rd }
fn addi($rd: entier, $rn: entier, $im: entier) -> entier { retour 2432696320 + $im * 1024 + $rn * 32 + $rd }
fn subi($rd: entier, $rn: entier, $im: entier) -> entier { retour 3506438144 + $im * 1024 + $rn * 32 + $rd }
fn addr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2332033024 + $rm * 65536 + $rn * 32 + $rd }
fn subr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 3405774848 + $rm * 65536 + $rn * 32 + $rd }
fn andr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2315255808 + $rm * 65536 + $rn * 32 + $rd }
fn orrr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2852126720 + $rm * 65536 + $rn * 32 + $rd }
fn eorr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 3388997632 + $rm * 65536 + $rn * 32 + $rd }
fn umulh($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2613083136 + $rm * 65536 + $rn * 32 + $rd }  # 0x9BC07C00
fn lsri($rd: entier, $rn: entier, $im: entier) -> entier { retour 3544251392 + $im * 65536 + $rn * 32 + $rd }   # 0xD340FC00 + immr<<16
fn mulr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2600500224 + $rm * 65536 + $rn * 32 + $rd }
fn sdivr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2596277248 + $rm * 65536 + $rn * 32 + $rd }  # 0x9AC00C00 (SDIV ; 0x9AC00800 = UDIV)
fn udivr($rd: entier, $rn: entier, $rm: entier) -> entier { retour 2596276224 + $rm * 65536 + $rn * 32 + $rd }
# MSUB : Rd bits 0-4, Rn bits 5-9, Ra bits 10-14 (×1024), Rm bits 16-20.
# Le facteur 16 historique était faux dès que Ra≠0 (il écrivait dans Rd).
fn msubr($rd: entier, $rn: entier, $rm: entier, $ra: entier) -> entier { retour 2600501248 + $rm * 65536 + $ra * 1024 + $rn * 32 + $rd }
fn cmpr($rn: entier, $rm: entier) -> entier { retour 3942645791 + $rm * 65536 + $rn * 32 }
fn cmpi($rn: entier, $im: entier) -> entier { retour 4043309087 + $im * 1024 + $rn * 32 }
fn ldroff($rt: entier, $rn: entier, $off: entier) -> entier { retour 4181721088 + partie_entiere($off / 8) * 1024 + $rn * 32 + $rt }
fn stroff($rt: entier, $rn: entier, $off: entier) -> entier { retour 4177526784 + partie_entiere($off / 8) * 1024 + $rn * 32 + $rt }
fn strboff($rt: entier, $rn: entier) -> entier { retour 941648864 + $rn * 65536 + $rt }
fn ldrboff($rt: entier, $rn: entier) -> entier { retour 945843168 + $rn * 65536 + $rt }
fn cset($rd: entier, $cond: entier) -> entier {
  $inv = $cond + 1
  si ($cond % 2 == 1) { $inv = $cond - 1 }
  retour 2594113504 + $inv * 4096 + $rd
}
fn RET_I() -> entier { retour 3596551104 }
fn SVC_I() -> entier { retour 3556769793 }

# ── G5-R (réflexivité) : extensions chaînes/listes ──
# Encodages vérifiés avec as/objdump sur aarch64 :
#   strb wRt,[xRn,#off] = 0x39000000 + off*1024 + Rn*32 + Rt
#   ldrb wRt,[xRn,#off] = 0x39400000 + off*1024 + Rn*32 + Rt
#   strb wRt,[xRn,xRm]  = 0x38206800 + Rm*65536 + Rn*32 + Rt
#   ldrb wRt,[xRn,xRm]  = 0x38606800 + Rm*65536 + Rn*32 + Rt
fn movzs($rd: entier, $im: entier, $sh: entier) -> entier { retour 3531603968 + $sh * 2097152 + $im * 32 + $rd }
fn strbio($rt: entier, $rn: entier, $off: entier) -> entier { retour 956301312 + $off * 1024 + $rn * 32 + $rt }
fn ldrbio($rt: entier, $rn: entier, $off: entier) -> entier { retour 960495616 + $off * 1024 + $rn * 32 + $rt }
fn strbr($rt: entier, $rn: entier, $rm: entier) -> entier { retour 941647872 + $rm * 65536 + $rn * 32 + $rt }
fn ldrbr($rt: entier, $rn: entier, $rm: entier) -> entier { retour 945842176 + $rm * 65536 + $rn * 32 + $rt }

# ── ABI G5 : tag dans les 3 bits bas (décision AB1, 19/11) ──
#UNE seule représentation pour TOUTES les valeurs G5 :
#  entier / booléen : n<<3        (bits bas 000)
#  chaîne           : pointeur|1   (descripteur [tag=1][len][octets…])
#  liste            : pointeur|2   (descripteur [tag=2][len][cap][valeurs…])
#Les descripteurs sont alignés sur 8 : les 3 bits bas sont libres.
#Encodages vérifiés avec as/objdump sur aarch64 :
#  and xRd,xRn,#0xfffffffffffffff8 = 0x927df000 + Rn*32 + Rd
#  lsr xRd,xRn,#3                 = 0xd343fc00 + Rn*32 + Rd
#  lsl xRd,xRn,#3                 = 0xd37df000 + Rn*32 + Rd
#  orr xRd,xRn,#1                 = 0xb2400000 + Rn*32 + Rd
#  orr xRd,xRn,#2                 = 0xb27f0000 + Rn*32 + Rd
fn g5_masktag($rd: entier, $rn: entier) -> entier { retour 2457726976 + $rn * 32 + $rd }
fn g5_tagbits($rd: entier, $rn: entier) -> entier { retour 2453669888 + $rn * 32 + $rd }
fn g5_lsr3($rd: entier, $rn: entier) -> entier { retour 3544448000 + $rn * 32 + $rd }
fn g5_asr3($rd: entier, $rn: entier) -> entier { retour 2470706176 + $rn * 32 + $rd }
fn g5_lsl3($rd: entier, $rn: entier) -> entier { retour 3548246016 + $rn * 32 + $rd }
fn g5_tag1($rd: entier, $rn: entier) -> entier { retour 2990538752 + $rn * 32 + $rd }
fn g5_tag2($rd: entier, $rn: entier) -> entier { retour 2994667520 + $rn * 32 + $rd }
# Charge un entier Rose (déjà tagué) dans $rd. g5_load reste brut ( adresses, tailles ).
# G5-BIG (AZZ) : au-delà de ±2^59 le décalage `n<<3` déborde le mot 64 bits
# signé (2^60<<3 = 2^63 = négatif). Ces valeurs sont construites comme un
# descripteur [tag=3][signe][nlimbs][limbs…] dont chaque limb est une DÉCIMALE
# de base 10^9 (0..999999999) rangée dans un mot 64 bits. Le pointeur est tagué
# 3 (`orr #1` puis `orr #2`, afin de rester dans les encodeurs déjà vérifiés).
# Le seuil ±2^59 est volontairement < 2^60 : ses propres constants, une fois
# taguées, valent ±2^62 et restent comparables sous l'émetteur auto-exécuté.
fn g5_load_val($rd: entier, $v: entier) -> entier {
  si ($v >= -576460752303423488 et $v <= 576460752303423487) {
    g5_load($rd, $v)
    g5_emit(g5_lsl3($rd, $rd))
    retour 0
  }
  $neg = 0
  $u = $v
  si ($u < 0) { $neg = 1; $u = -$u }
  $limbs = [0 : entier]
  tant_que ($u > 0) {
    joindre($limbs, $u % 1000000000)
    $u = partie_entiere($u / 1000000000)
  }
  $nl = longueur($limbs)
  g5_load(0, 24 + 8 * $nl)
  g5_alloc_inline()
  g5_load(1, 3)
  g5_emit(stroff(1, 0, 0))
  g5_load(1, $neg)
  g5_emit(stroff(1, 0, 8))
  g5_load(1, $nl)
  g5_emit(stroff(1, 0, 16))
  $i = 0
  tant_que ($i < $nl) {
    g5_load(1, $limbs[$i])
    g5_emit(stroff(1, 0, 24 + 8 * $i))
    $i = $i + 1
  }
  g5_emit(g5_tag1(0, 0))
  g5_emit(g5_tag2(0, 0))
  si ($rd != 0) { g5_emit(orrr($rd, 31, 0)) }
  retour 0
}

$g5_allocl = 0
$g5_lenl = 0
$g5_ordl = 0
$g5_sousl = 0
$g5_idxl = 0
$g5_chl = 0
$g5_joindrel = 0
$g5_inserrel = 0
$g5_supprl = 0
$g5_entierl = 0
$g5_catl = 0
$g5_streql = 0
$g5_strcmpl = 0
$g5_stub0l = 0
$g5_stubsl = 0
$g5_tablel = 0
$g5_clexl = 0
# SH7 (C0) : trois primitives absentes du dispatch G5, émises comme de vraies
# routines. Sans elles, `app <nom>` retombait sur g5_emit_stub0 (x0=0), ce qui
# détruisait la construction octet par octet de l'ELF et empêchait quitter()
# d'arrêter le chemin G5 (retombée dans l'ancien compilateur).
$g5_quitl = 0
$g5_carl = 0
# OCTET_BRUT : routine G5 dédiée aux octets bruts (pas d'UTF-8).
$g5_octetll = 0
$g5_parl = 0
$g5_absl = 0
$g5_minl = 0
$g5_maxl = 0
$g5_typel = 0
$g5_chbooll = 0
$g5_hasardl = 0
$g5_grainel = 0
# G5-BIG : routines de promotion d'un petit entier et d'addition signée
# (descripteurs [3][signe][nlimbs][limbs base 10^9]).
$g5_bigprol = 0
$g5_bigaddl = 0
$g5_bignegl = 0
$g5_bigcmpl = 0

# ── G5-IO : primitives d'entrée/sortie par syscalls Linux aarch64 ──
# Ces routines sont ÉMISES dans l'ELF (elles ne s'exécutent pas dans Rose) :
#   nb_arguments()  -> argc de la pile initiale, moins 1 (arguments utilisateur)
#   argument(i)     -> argv[i+1], copié en chaîne Rose taguée [tag=1][len][octets]
#   lire_texte(p)   -> openat/read/close (svc #0), chaîne taguée
#   ecrire_bytes(p,d), ecrire_texte(p,d) -> openat/write/close
# Les variables globales sont logées dans la page RW à 0x60000000, AU-DESSOUS
# du pointeur libre du tas (désormais initialisé à 0x60000300) pour ne jamais
# être écrasées par g5_alloc_inline.
$g5_nbargs_l = 0
$g5_argument_l = 0
$g5_plist_l = 0
$g5_lire_l = 0
$g5_ecrire_l = 0

# ── J4 : syscalls mmap(222), mprotect(226), fchmodat(53), execve(221) ──
# Nouvelles routines G5 émises dans l'ELF (aucune modification des routines
# mémoire / idx / octet_brut existantes). Untag des arguments entiers (n<<3),
# syscall via svc #0, retag du résultat (x0<<3). execve ne revient pas en
# cas de succès ; en cas d'échec il rend -errno tagué.
$g5_mmap_l = 0
$g5_mprotect_l = 0
$g5_chmod_l = 0
$g5_execve_l = 0

fn g5_load($rd: entier, $v: entier) -> entier {
  # SH10 : les anciennes bornes ±2^63/2^64 ne sont PAS représentables dans
  # l'ABI G5 (61 bits utiles) : sous l'émetteur auto-exécuté elles devenaient
  # 0, rendant `-100 < 0` vrai => `immédiat hors int64 : -100` (mesuré, 3
  # occurrences dans $g5_err du binaire auto-émis). On construit le
  # complément à 2 sur 64 bits CHUNK PAR CHUNK, avec des valeurs <= 65536 :
  # même résultat en natif et sous G5, sans constante > 2^60.
  $u = $v
  $neg = 0
  si ($u < 0) { $neg = 1; $u = -$u }
  $c0 = $u % 65536
  $c1 = partie_entiere($u / 65536) % 65536
  $c2 = partie_entiere($u / 4294967296) % 65536
  $c3 = partie_entiere($u / 281474976710656) % 65536
  si ($neg == 1) {
    $c0 = 65536 - $c0
    $c1 = 65535 - $c1
    $c2 = 65535 - $c2
    $c3 = 65535 - $c3
    si ($c0 >= 65536) { $c0 = $c0 - 65536; $c1 = $c1 + 1 }
    si ($c1 >= 65536) { $c1 = $c1 - 65536; $c2 = $c2 + 1 }
    si ($c2 >= 65536) { $c2 = $c2 - 65536; $c3 = $c3 + 1 }
    si ($c3 >= 65536) { $c3 = 0 }   # retenue sortant des 64 bits
  }
  g5_emit(movz($rd, $c0))
  si ($c1 != 0) { g5_emit(movk($rd, $c1, 1)) }
  si ($c2 != 0) { g5_emit(movk($rd, $c2, 2)) }
  si ($c3 != 0) { g5_emit(movk($rd, $c3, 3)) }
  retour 0
}

fn g5_tokens($s: chaine) -> liste<chaine> {
  $r = [0 : chaine]
  $i = 0
  $n = longueur($s)
  tant_que ($i < $n) {
    $c = g5_sub($s, $i, $i + 1)
    si ($c == "(" ou $c == ")") { joindre($r, $c); $i = $i + 1 }
    sinon si ($c == " " ou $c == "\t") { $i = $i + 1 }
    sinon si ($c == "\"") {
      # G5-R : un littéral de chaîne est UN seul jeton, y compris ses espaces,
      # ses parenthèses et ses échappements.
      $j = $i + 1
      $fin = 0
      tant_que ($j < $n et $fin == 0) {
        $d = g5_sub($s, $j, $j + 1)
        si ($d == "\\") { $j = $j + 2
        } sinon si ($d == "\"") { $j = $j + 1; $fin = 1
        } sinon { $j = $j + 1 }
      }
      si ($j > $n) { $j = $n }
      joindre($r, g5_sub($s, $i, $j))
      $i = $j
    }
    sinon {
      $j = $i
      tant_que ($j < $n et g5_sub($s, $j, $j + 1) != "(" et g5_sub($s, $j, $j + 1) != ")" et g5_sub($s, $j, $j + 1) != " " et g5_sub($s, $j, $j + 1) != "\t") { $j = $j + 1 }
      joindre($r, g5_sub($s, $i, $j))
      $i = $j
    }
  }
  retour $r
}

# Décode un jeton "(s \"…\")" du RIR vers les octets Rose réels.
fn g5_unescape($tok: chaine) -> chaine {
  $n = longueur($tok)
  $deb = 1
  $fin = $n - 1
  si ($fin < $deb) { $fin = $deb }
  $r = ""
  $i = $deb
  tant_que ($i < $fin) {
    $c = sous_chaine($tok, $i, $i + 1)
    si ($c == "\\") {
      $d = sous_chaine($tok, $i + 1, $i + 2)
      si ($d == "n") { $r = $r + caractere(10); $i = $i + 2
      } sinon si ($d == "r") { $r = $r + caractere(13); $i = $i + 2
      } sinon si ($d == "t") { $r = $r + caractere(9); $i = $i + 2
      } sinon si ($d == "\"") { $r = $r + caractere(34); $i = $i + 2
      } sinon si ($d == "\\") { $r = $r + caractere(92); $i = $i + 2
      } sinon { $r = $r + $c; $i = $i + 1 }
    } sinon { $r = $r + $c; $i = $i + 1 }
  }
  retour $r
}

# Allocation EN LIGNE : évite de clobber x30 (BL écraserait le LR de la fonction).
fn g5_alloc_inline() -> entier {
  g5_load(9, 1610612736)
  g5_emit(ldroff(2, 9, 0))
  g5_emit(orrr(1, 31, 0))
  g5_emit(orrr(0, 31, 2))
  g5_emit(addr(2, 2, 1))
  g5_emit(stroff(2, 9, 0))
  retour 0
}

# Émet le code qui construit un descripteur [tag=1][len][octets…] dans x0.
# G5-TAS : les chaînes Rose sont immuables, donc un littéral peut être
# construit UNE fois et réutilisé. Table d'internement à 0x60000300 :
# 512 entrées de 16 octets [clé 64 bits][pointeur], la clé est vérifiée
# avant réutilisation (une collision d'index ne peut donc pas rendre une
# mauvaise chaîne).
# SH11 (C1.3) — l'emetteur NATIF voit une chaine comme une suite de POINTS
# DE CODE Unicode (mesure : longueur("é≠→—")=4, ordre("é")=233,
# ordre("≠")=8800), tandis que l'emetteur AUTO-EMIS (ELF G5) la voit comme
# une suite d'OCTETS (c3 a9, e2 89 a0...). Sans normalisation, un meme RIR
# produisait deux ELF differents : +24 octets sur e_final.rir, premiere
# divergence a l'offset 0x608 (bl 0x4680ac vs bl 0x4680c4), causee par
# "forme parenthésée..." (33 octets natif / 35 UTF-8) et "appel non résolu : "
# (19 / 20). On decode ici l'UTF-8 en points de code AVANT emission :
#   - sous G5, les suites valides c2..f4 + 80..bf sont recombinees ;
#   - en natif, un point de code deja decode (233, 8800, 8212...) n'est jamais
#     suivi du nombre requis de continuations 80..bf dans nos litteraux :
#     la fonction est alors IDENTITE (verifie par le point fixe b3ed9262).
# Le hash d'internement utilise le point de code ENTIER, comme en natif
# (strbio ne stocke que l'octet de poids faible, ce qui est conforme).
fn g5_cps($s: chaine) -> liste<entier> {
  $r = [0 : entier]
  $n = longueur($s)
  $i = 0
  tant_que ($i < $n) {
    $b0 = ordre(sous_chaine($s, $i, $i + 1))
    $k = 1
    si ($b0 >= 194 et $b0 <= 223) { $k = 2 }
    si ($b0 >= 224 et $b0 <= 239) { $k = 3 }
    si ($b0 >= 240 et $b0 <= 244) { $k = 4 }
    $ok = 1
    $j = 1
    tant_que ($j < $k) {
      si ($i + $j >= $n) { $ok = 0 }
      sinon {
        $bj = ordre(sous_chaine($s, $i + $j, $i + $j + 1))
        si ($bj < 128 ou $bj > 191) { $ok = 0 }
      }
      $j = $j + 1
    }
    si ($ok == 1 et $k == 2) {
      joindre($r, ($b0 - 192) * 64 + ordre(sous_chaine($s, $i + 1, $i + 2)) - 128)
      $i = $i + 2
    } sinon si ($ok == 1 et $k == 3) {
      joindre($r, ($b0 - 224) * 4096 + (ordre(sous_chaine($s, $i + 1, $i + 2)) - 128) * 64 + ordre(sous_chaine($s, $i + 2, $i + 3)) - 128)
      $i = $i + 3
    } sinon si ($ok == 1 et $k == 4) {
      joindre($r, ($b0 - 240) * 262144 + (ordre(sous_chaine($s, $i + 1, $i + 2)) - 128) * 4096 + (ordre(sous_chaine($s, $i + 2, $i + 3)) - 128) * 64 + ordre(sous_chaine($s, $i + 3, $i + 4)) - 128)
      $i = $i + 4
    } sinon {
      joindre($r, $b0)
      $i = $i + 1
    }
  }
  retour $r
}

# G5-UTF8 : encode un point de code en 1..4 octets UTF-8. Le descripteur G5
# stocke des OCTETS UTF-8 (et non un octet par point de code) : `>>` écrit
# alors directement les octets du descripteur, et l'ordre lexicographique
# octet par octet coïncide avec l'ordre des points de code.
fn g5_utf8($cp: entier) -> liste<entier> {
  $r = [0 : entier]
  si ($cp < 128) {
    joindre($r, $cp)
  } sinon si ($cp < 2048) {
    joindre($r, 192 + partie_entiere($cp / 64))
    joindre($r, 128 + ($cp % 64))
  } sinon si ($cp < 65536) {
    joindre($r, 224 + partie_entiere($cp / 4096))
    joindre($r, 128 + (partie_entiere($cp / 64) % 64))
    joindre($r, 128 + ($cp % 64))
  } sinon {
    joindre($r, 240 + partie_entiere($cp / 262144))
    joindre($r, 128 + (partie_entiere($cp / 4096) % 64))
    joindre($r, 128 + (partie_entiere($cp / 64) % 64))
    joindre($r, 128 + ($cp % 64))
  }
  retour $r
}

fn g5_make_str($s: chaine) -> entier {
  $cps = g5_cps($s)
  $n = longueur($cps)
  $oct = [0 : entier]
  $j = 0
  tant_que ($j < $n) {
    $bj = g5_utf8($cps[$j])
    $k = 0
    tant_que ($k < longueur($bj)) {
      joindre($oct, $bj[$k])
      $k = $k + 1
    }
    $j = $j + 1
  }
  # $nb = nombre d'OCTETS UTF-8 ; le hash reste calculé sur les POINTS DE CODE
  # (identiques en natif et sous l'émetteur auto-exécuté, donc internement stable).
  $nb = longueur($oct)
  $h = 0
  $hi = 0
  tant_que ($hi < $n) {
    # SH10 : 2^64 n'est pas représentable sous G5 (-> modulo 0 -> hash 0
    # pour TOUTES les chaînes -> réutilisation du mauvais littéral interné).
    # Un hash 32 bits suffit : la clé est vérifiée avant réutilisation.
    $h = ($h * 131 + $cps[$hi]) % 4294967296
    $hi = $hi + 1
  }
  $lbl_miss = g5_next()
  $lbl_done = g5_next()
  g5_load(12, 1610613504 + 16 * ($h % 512))
  g5_emit(ldroff(13, 12, 0))
  g5_load(14, $h)
  g5_emit(cmpr(13, 14))
  g5_branch(101, $lbl_miss)
  g5_emit(ldroff(0, 12, 8))
  g5_emit(cmpi(0, 0))
  g5_branch(101, $lbl_done)
  g5_mark($lbl_miss)
  $sz = 16 + 8 * partie_entiere(($nb + 7) / 8)
  g5_load(0, $sz)
  g5_alloc_inline()
  g5_load(1, 1)
  g5_emit(stroff(1, 0, 0))
  g5_load(1, $nb)
  g5_emit(stroff(1, 0, 8))
  $i = 0
  tant_que ($i < $nb) {
    g5_load(1, $oct[$i])
    g5_emit(strbio(1, 0, 16 + $i))
    $i = $i + 1
  }
  g5_emit(stroff(14, 12, 0))
  g5_emit(stroff(0, 12, 8))
  g5_mark($lbl_done)
  g5_emit(g5_tag1(0, 0))
  retour 0
}

fn g5_noms($s: chaine) -> chaine {
  $n = longueur($s)
  $p = 0
  $res = ""
  tant_que ($p < $n) {
    si (g5_sub($s, $p, $p + 1) == "[") {
      $q = $p + 1
      tant_que ($q < $n et g5_sub($s, $q, $q + 1) != "]") { $q = $q + 1 }
      $ix = g5_sub($s, $p + 1, $q)
      $p = $q + 1
      tant_que ($p < $n et g5_sub($s, $p, $p + 1) == " ") { $p = $p + 1 }
      $q = $p
      tant_que ($q < $n et g5_sub($s, $q, $q + 1) != " ") { $q = $q + 1 }
      $nm = g5_sub($s, $p, $q)
      si (longueur($res) > 0) { $res = $res + "|" }
      $res = $res + $ix + ":" + $nm
      $p = $q
    } sinon { $p = $p + 1 }
  }
  retour $res
}

fn g5_slot_of($f: entier, $nom: chaine) -> entier {
  $t = $g5_fnam[$f]
  $n = longueur($t)
  $i = 0
  tant_que ($i < $n) {
    $fin = g4_pos(g5_sub($t, $i, $n), "|")
    si ($fin < 0) { $fin = $n - $i }
    $ent = g5_sub($t, $i, $i + $fin)
    $sep = g4_pos($ent, ":")
    si ($sep >= 0) {
      si (g5_sub($ent, $sep + 1, longueur($ent)) == $nom) { retour g4_entier_ou_zero(g5_sub($ent, 0, $sep)) }
    }
    $i = $i + $fin + 1
  }
  # G5-R (SH10) : une variable non locale est une GLOBALE du RIR. Elle est
  # cherchée dans $g5_gnam par les helpers ci-dessous ; -1 = ni locale ni
  # globale connue (on conserve alors le repli historique à zéro).
  retour -1
}

# ── SH10 : stockage des variables globales G5 ────────────────────────────
# Cartographie RW (voir le bloc l.2100) :
#   0x60003000..0x60003800  table des caractères (256 × 8)
#   0x60003800..0x60004000  scratch décimal (écriture DÉCROISSANTE)
#   0x60004000..0x60005000  GLOBALES G5 : 512 × 8 octets, index = slot du
#                           $principal (0..511), valeur ROSE TAGUÉE (x0 ABI).
#   0x60008000              début du tas (déplacé pour dégager les globales)
# La zone est dans un mapping anonyme (p_filesz=0) : elle vaut 0 au départ,
# ce qui correspond au tag 0 (entier Rose 0). Borne et garde : tout index
# hors 0..511 est une erreur d'émission, jamais une écriture hors zone.
fn g5_gaddr($ix: entier, $rd: entier) -> entier {
  si ($ix < 0 ou $ix >= 512) { retour g5_fail("globale G5 hors borne : " + chaine($ix)) }
  g5_load($rd, 1610629120 + 8 * $ix)
  retour 0
}
fn g5_global_id($nom: chaine) -> entier {
  $k = 1
  tant_que ($k < longueur($g5_gnams)) {
    $t = $g5_gnams[$k]
    $n = longueur($t)
    $i = 0
    tant_que ($i < $n) {
      $fin = g4_pos(g5_sub($t, $i, $n), "|")
      si ($fin < 0) { $fin = $n - $i }
      $ent = g5_sub($t, $i, $i + $fin)
      $sep = g4_pos($ent, ":")
      si ($sep >= 0) {
        si (g5_sub($ent, $sep + 1, longueur($ent)) == $nom) { retour g4_entier_ou_zero(g5_sub($ent, 0, $sep)) }
      }
      $i = $i + $fin + 1
    }
    $k = $k + 1
  }
  retour -1
}
# Construit la table depuis les lignes `noms` et `globaux` du $principal.
# $res est une LOCALE : on ne l'affecte jamais à la globale, on ajoute une
# entrée à la liste globale avec joindre() (mutation en place, vu des deux
# mondes natif et G5).
fn g5_set_globaux($noms: chaine, $gl: chaine) -> entier {
  $pad = " " + $gl + " "
  $res = ""
  $p = 0
  $ln = longueur($noms)
  tant_que ($p < $ln) {
    si (sous_chaine($noms, $p, $p + 1) == "[") {
      $q = $p + 1
      tant_que ($q < $ln et sous_chaine($noms, $q, $q + 1) != "]") { $q = $q + 1 }
      $ix = sous_chaine($noms, $p + 1, $q)
      $p = $q + 1
      tant_que ($p < $ln et sous_chaine($noms, $p, $p + 1) == " ") { $p = $p + 1 }
      $q = $p
      tant_que ($q < $ln et sous_chaine($noms, $q, $q + 1) != " ") { $q = $q + 1 }
      $nm = sous_chaine($noms, $p, $q)
      si (g4_pos($pad, " " + $ix + " ") >= 0) {
        si (longueur($res) > 0) { $res = $res + "|" }
        $res = $res + $ix + ":" + $nm
      }
      $p = $q
    } sinon { $p = $p + 1 }
  }
  joindre($g5_gnams, $res)
  retour 0
}
fn g5_is_principal($f: entier) -> entier {
  si ($f >= 0 et $f < longueur($g5_fn)) {
    si ($g5_fn[$f] == "$principal") { retour 1 }
  }
  retour 0
}
# Lecture de x0. Dans $principal, les slots SONT les globales : même quand
# le nom figure dans $g5_fnam, il faut lire la zone RW, pas le cadre.
# Dans une fonction, un slot local est prioritaire ; sinon on cherche le nom
# dans la table des globales (les expressions AST `(v nom)` ne sont pas
# abaissées en slots par rir.rs, mais résolues par nom à l'exécution).
fn g5_read_var($f: entier, $nom: chaine) -> entier {
  $sl = g5_slot_of($f, $nom)
  si ($sl >= 0) {
    si (g5_is_principal($f) == 1) { g5_gaddr($sl, 9); g5_emit(ldroff(0, 9, 0))
    } sinon { g5_emit(ldroff(0, 31, g5_slotoff($sl))) }
    retour 0
  }
  $gi = g5_global_id($nom)
  si ($gi >= 0) { g5_gaddr($gi, 9); g5_emit(ldroff(0, 9, 0)); retour 0 }
  g5_load(0, 0)
  retour 0
}
# Écriture depuis x0 ; même priorité. Un nom inconnu reste perdu (comportement
# historique), il n'y a pas d'adresse à inventer.
fn g5_write_var($f: entier, $nom: chaine) -> entier {
  $sl = g5_slot_of($f, $nom)
  si ($sl >= 0) {
    si (g5_is_principal($f) == 1) { g5_gaddr($sl, 9); g5_emit(stroff(0, 9, 0))
    } sinon { g5_emit(stroff(0, 31, g5_slotoff($sl))) }
    retour 0
  }
  $gi = g5_global_id($nom)
  si ($gi >= 0) { g5_gaddr($gi, 9); g5_emit(stroff(0, 9, 0)); retour 0 }
  retour 0
}
# `slot N` / `affect slot N` : dans $principal, TOUS les slots sont des
# globales (rir.rs::abaisser_principal). Ailleurs ce sont des cases du cadre.
fn g5_read_slot($f: entier, $sl: entier) -> entier {
  si (g5_is_principal($f) == 1) { g5_gaddr($sl, 9); g5_emit(ldroff(0, 9, 0)); retour 0 }
  g5_emit(ldroff(0, 31, g5_slotoff($sl)))
  retour 0
}
fn g5_write_slot($f: entier, $sl: entier) -> entier {
  si (g5_is_principal($f) == 1) { g5_gaddr($sl, 9); g5_emit(stroff(0, 9, 0)); retour 0 }
  g5_emit(stroff(0, 31, g5_slotoff($sl)))
  retour 0
}
# G5-FIX (19/11) : régions de gratte-papier SÉPARÉES PAR PROFONDEUR D'IMBRICATION.
# Avant : tmp = mot 32+$d, args = mot 64+$i, listes = mot 80+$i (regions FIXES).
# Un appel imbriqué dans une expression d'argument (ex. noeud8(... (app VX0 x p) ...))
# ecrivait ses propres arguments dans argoff(0..1) et DETRUISait ceux de l'appel
# externe deja stipies : noeud8 recevait tx=1 au lieu d'un descripteur de liste.
# Desormais chaque profondeur $d possede une bande de 64 mots :
#   [0..7]=tmp, [8..51]=args (jusqu'a 36 params), [52..63]=listes.
# Les 128 premiers mots restent les slots (n_slots max observe = 116).
# Profondeur max observee = 13 ; 16 bandes suffisent (marge).
fn g5_slotoff($s: entier) -> entier { retour 16 + 8 * $s }
fn g5_tmpoff($d: entier) -> entier { retour 16 + 8 * (128 + 64 * $d) }
fn g5_argoff($i: entier, $d: entier) -> entier { retour 16 + 8 * (128 + 64 * $d + 8 + $i) }
fn g5_listoff($i: entier, $d: entier) -> entier { retour 16 + 8 * (128 + 64 * $d + 52 + $i) }
fn g5_framesize($f: entier) -> entier {
  # 16 + 8*(128 + 64*16) = 9232 octets, multiple de 16 (alignement AArch64).
  retour 9232
}
# `sub sp,sp,#imm` / `add sp,sp,#imm` ne codent que 12 bits (<= 4095).
# 9232 > 4095 : on découpe en tranches de 4080 (multiples de 16).
fn g5_emit_subsp($sz: entier) -> entier {
  $r = $sz
  tant_que ($r > 4080) { g5_emit(subi(31, 31, 4080)); $r = $r - 4080 }
  si ($r > 0) { g5_emit(subi(31, 31, $r)) }
  retour 0
}
fn g5_emit_addsp($sz: entier) -> entier {
  $r = $sz
  tant_que ($r > 4080) { g5_emit(addi(31, 31, 4080)); $r = $r - 4080 }
  si ($r > 0) { g5_emit(addi(31, 31, $r)) }
  retour 0
}
fn g5_cond($op: chaine) -> entier {
  si ($op == "==") { retour 0 }
  si ($op == "!=") { retour 1 }
  si ($op == "<") { retour 11 }
  si ($op == ">=") { retour 10 }
  si ($op == ">") { retour 12 }
  si ($op == "<=") { retour 13 }
  retour -1
}
# Comparaison de VALEUR (après l'éventuel test de chaîne pour ==/!=).
# x1 = gauche taguée, x0 = droite taguée ; x0 = booléen tagué (0/8) en sortie.
# Un saut à déplacement CONSTANT teste le tag 3 : les comparaisons d'entiers
# courants (1491 dans le RIR auto-hébergé) gardent le chemin 3-instructions
# d'origine, sans label ni appel supplémentaire. Le chemin grand entier
# appelle la routine g5_emit_bigcmp une seule fois (label fixe, pas par expr.).
# Comparaison lexicographique de deux chaînes taguées (x1=gauche, x0=droite).
# Renvoie un ENTIER BRUT : -1 si gauche < droite, 0 si égales, 1 si >.
# Les octets UTF-8 se comparent comme des non signés : l'ordre obtenu est
# exactement l'ordre lexicographique des points de code (par exemple
# "é" > "è" car c3 a9 > c3 a8). L'appelant applique ensuite son `cset`.
fn g5_emit_strcmp($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(6, 1))
  g5_emit(g5_masktag(7, 0))
  g5_emit(ldroff(2, 6, 8))        # x2 = longueur octets gauche
  g5_emit(ldroff(3, 7, 8))        # x3 = longueur octets droite
  g5_emit(movz(4, 0))             # x4 = i
  g5_mark($lbl + 1)
  g5_emit(cmpr(4, 2)); g5_branch(110, $lbl + 3)  # gauche épuisée
  g5_emit(cmpr(4, 3)); g5_branch(110, $lbl + 4)  # droite épuisée
  g5_emit(addi(9, 4, 16))           # les données commencent à +16
  g5_emit(ldrbr(5, 6, 9)); g5_emit(ldrbr(8, 7, 9))
  g5_emit(cmpr(5, 8)); g5_branch(100, $lbl + 2)
  g5_emit(cmpr(5, 8)); g5_branch(111, $lbl + 5)  # gauche < droite
  g5_emit(movz(0, 1)); g5_emit(RET_I())
  g5_mark($lbl + 5)
  g5_emit(movz(0, 1)); g5_emit(subr(0, 31, 0)); g5_emit(RET_I())
  g5_mark($lbl + 2)
  g5_emit(addi(4, 4, 1)); g5_branch(0, $lbl + 1)
  g5_mark($lbl + 3)               # gauche plus courte
  g5_emit(cmpr(4, 3)); g5_branch(110, $lbl + 7)
  g5_emit(movz(0, 1)); g5_emit(subr(0, 31, 0)); g5_emit(RET_I())
  g5_mark($lbl + 4)               # droite plus courte
  g5_emit(movz(0, 1)); g5_emit(RET_I())
  g5_mark($lbl + 7)               # longueurs égales
  g5_emit(movz(0, 0)); g5_emit(RET_I())
  retour 0
}

fn g5_emit_cmp_value($c: entier) -> entier {
  # Détection des deux chaînes : chemin lexicographique dédié. Sauts à
  # déplacement CONSTANT (aucun label par comparaison, comme le chemin big).
  g5_emit(g5_tagbits(2, 1))
  g5_emit(cmpi(2, 1))
  g5_branch_off(100, 2)            # gauche chaîne -> +4
  g5_branch_off(0, 8)              # sinon -> +11 (chemin entier/big)
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 1))
  g5_branch_off(101, 5)            # droite non-chaîne -> +11
  g5_branch(1, $g5_strcmpl)        # x0 = -1/0/1 brut
  g5_emit(cmpi(0, 0))
  g5_emit(cset(0, $c))
  g5_branch_off(0, 13)             # -> +23 (lsl3 final)
  g5_emit(g5_tagbits(2, 1))
  g5_emit(cmpi(2, 3))
  g5_branch_off(100, 7)            # -> +20 (grand entier)
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 3))
  g5_branch_off(100, 4)            # -> +20
  g5_emit(cmpr(1, 0)); g5_emit(cset(0, $c))
  g5_branch_off(0, 4)              # -> +23
  g5_branch(1, $g5_bigcmpl)
  g5_emit(cmpi(0, 0)); g5_emit(cset(0, $c))
  g5_emit(g5_lsl3(0, 0))
  retour 0
}

fn g5_func_id($nom: chaine) -> entier {
  $i = 0
  tant_que ($i < longueur($g5_fn)) {
    si ($g5_fn[$i] == $nom) { retour $g5_flbl[$i] }
    $i = $i + 1
  }
  retour g5_fail("appel non résolu : " + $nom)
}

# Saute une expression RIR parenthésée (retourne la position suivant son ')' ).
fn g5_skip_expr($t: liste<chaine>, $p0: entier) -> entier {
  $p = $p0
  $prof = 0
  $n = longueur($t)
  tant_que ($p < $n) {
    si ($t[$p] == "(") { $prof = $prof + 1 }
    si ($t[$p] == ")") {
      $prof = $prof - 1
      si ($prof == 0) { retour $p + 1 }
    }
    $p = $p + 1
  }
  retour $p
}

# SH4 : une expression RIR produit-elle un BOOLÉEN Rose ?
# L'ABI G5 represente les booleens comme des entiers tagues 0/8 ; le format
# d'affichage ne peut donc pas etre choisi a l'execution. On le determine ici,
# a l'emission, d'apres la FORME de l'expression (le compilateur Rose connait
# le type statique des comparaisons, des litteraux `b` et des appels dont le
# type de retour est `booleen`).
fn g5_est_bool($t: liste<chaine>, $p: entier, $f: entier) -> entier {
  si ($p < 0 ou $p + 1 >= longueur($t)) { retour 0 }
  $clef = chaine($f) + "|"
  # `slot N` : type memorise au moment de l'affectation.
  si ($t[$p] == "slot") {
    si (cle_existe($g5_sbool, $clef + $t[$p + 1])) { retour 1 }
    retour 0
  }
  si ($t[$p] != "(") { retour 0 }
  si ($p + 2 >= longueur($t)) { retour 0 }
  $h = $t[$p + 1]
  # `(v nom)` : resolu en slot puis memorise.
  si ($h == "v") {
    $sl = g5_slot_of($f, $t[$p + 2])
    si ($sl >= 0 et cle_existe($g5_sbool, $clef + chaine($sl))) { retour 1 }
    retour 0
  }
  si ($h == "b") { retour 1 }
  si ($h == "non" ou $h == "uni") { retour 1 }
  si ($h == "bin") {
    $op = $t[$p + 2]
    si ($op == "<" ou $op == "<=" ou $op == ">" ou $op == ">=" ou
        $op == "==" ou $op == "!=" ou $op == "et" ou $op == "ou") { retour 1 }
    retour 0
  }
  si ($h == "app") {
    $nom = $t[$p + 2]
    si ($nom == "cle_existe") { retour 1 }
    $i = 0
    tant_que ($i < longueur($g5_fn)) {
      si ($g5_fn[$i] == $nom et $g5_fret[$i] == "booleen") { retour 1 }
      $i = $i + 1
    }
  }
  retour 0
}

# ── G5-FORMULES : arithmétique exacte à l'émission (vague 71) ──
# Un rationnel est represente par la chaine "numerateur/denominateur" avec
# denominateur > 0 et pgcd(num,den) = 1. Un entier est "n/1".
fn g5_rnum($s: chaine) -> entier {
  $p = g4_pos($s, "/")
  si ($p < 0) { retour g4_entier_ou_zero($s) }
  retour g4_entier_ou_zero(g5_sub($s, 0, $p))
}
fn g5_rden($s: chaine) -> entier {
  $p = g4_pos($s, "/")
  si ($p < 0) { retour 1 }
  retour g4_entier_ou_zero(g5_sub($s, $p + 1, longueur($s)))
}
fn g5_pgcd($a0: entier, $b0: entier) -> entier {
  $x = $a0
  $y = $b0
  si ($x < 0) { $x = -$x }
  si ($y < 0) { $y = -$y }
  tant_que ($y != 0) { $r = $x % $y; $x = $y; $y = $r }
  retour $x
}
fn g5_rnorm($a0: entier, $b0: entier) -> chaine {
  $a = $a0
  $b = $b0
  si ($b == 0) { retour "" }
  si ($b < 0) { $a = -$a; $b = -$b }
  # JIT (rose/rose sans ROSE_SANS_JIT) : stocker le resultat d'un appel de
  # fonction renvoyant un GRAND entier dans une locale donne Vide (mesure :
  # `chaine(pgcd(2^64+1,1))` -> erreur de conversion). Le pgcd est donc CALCULE
  # EN LIGNE ici : c'est aussi la formule la plus courte.
  $x = $a
  $y = $b
  si ($x < 0) { $x = -$x }
  tant_que ($y != 0) { $r = $x % $y; $x = $y; $y = $r }
  si ($x > 1) { $a = partie_entiere($a / $x); $b = partie_entiere($b / $x) }
  retour chaine($a) + "/" + chaine($b)
}
# Longueur (en jetons) d'un opérande RIR atomique ou(parenthesé).
fn g5_atom_len($t: liste<chaine>, $p: entier) -> entier {
  si ($p < 0 ou $p >= longueur($t)) { retour 0 }
  si ($t[$p] == "(") { retour g5_skip_expr($t, $p) - $p }
  si ($t[$p] == "slot" ou $t[$p] == "entier" ou $t[$p] == "n" ou
      $t[$p] == "flottant" ou $t[$p] == "chaine" ou $t[$p] == "s" ou $t[$p] == "b") { retour 2 }
  retour 1
}
# Invalidation des constantes aux frontières de contrôle de flot : le RIR est
# parcouru LINÉAIREMENT à l'émission, donc une constante mémorisée avant un
# saut ne peut pas être supposée valable après (boucle `pour` = somme fausse).
fn g5_const_clear($f: entier) -> entier {
  inserer($g5_snostore, chaine($f), 1)
  retour 0
}

# L'expression contient-elle un GRAND entier littéral (ou un slot dont la
# constante est grande) ? Sert à replier même quand le RÉSULTAT est petit :
# `$a % 7` avec $a = 10^20 donne 2 côté natif mais 6 côté ELF 64 bits.
fn g5_hasbig($t: liste<chaine>, $p: entier, $f: entier) -> entier {
  si ($p < 0 ou $p >= longueur($t)) { retour 0 }
  $fin = g5_skip_expr($t, $p)
  si ($t[$p] != "(") { $fin = $p + g5_atom_len($t, $p) }
  $lim = 576460752303423488
  $i = $p
  tant_que ($i < $fin et $i < longueur($t)) {
    $tk = $t[$i]
    si (($tk == "entier" ou $tk == "n") et $i + 1 < longueur($t)) {
      $v = g4_entier_ou_zero($t[$i + 1])
      si ($v > $lim ou $v < -$lim) { retour 1 }
    }
    si (($tk == "slot" ou $tk == "v") et $i + 1 < longueur($t)) {
      $sl = -1
      si ($tk == "slot") { $sl = g4_entier_ou_zero($t[$i + 1])
      } sinon { $sl = g5_slot_of($f, $t[$i + 1]) }
      si ($sl >= 0) {
        $cle = chaine($f) + "|" + chaine($sl)
        si (cle_existe($g5_sconst, $cle)) {
          $cv = chaine($g5_sconst[$cle])
          $cn = g5_rnum($cv); $cd = g5_rden($cv)
          si ($cn > $lim ou $cn < -$lim ou $cd > $lim) { retour 1 }
        }
      }
    }
    $i = $i + 1
  }
  retour 0
}
# Division/modulo : la voie 64 bits de l'ELF ne respecte pas l'arrondi plancher
# de Rose sur les négatifs. On replie donc TOUTE expression contenant `/` ou
# `%` dont les feuilles sont constantes, quelle que soit leur taille.
fn g5_hasdiv($t: liste<chaine>, $p: entier) -> entier {
  si ($p < 0 ou $p >= longueur($t)) { retour 0 }
  $fin = g5_skip_expr($t, $p)
  si ($t[$p] != "(") { $fin = $p + g5_atom_len($t, $p) }
  $i = $p
  tant_que ($i < $fin et $i < longueur($t)) {
    si ($t[$i] == "/" ou $t[$i] == "%") { retour 1 }
    $i = $i + 1
  }
  retour 0
}

# Repli exact d'une expression RIR. "" = feuille non constante (on retombe
# alors sur l'émission machine historique). "@F|texte" = résultat à sérialiser
# tel quel (utilisé pour abs(grand) qui est un FLOTTANT côté natif).
fn g5_fold($t: liste<chaine>, $p: entier, $f: entier) -> chaine {
  si (cle_existe($g5_snostore, chaine($f))) { retour "" }
  si ($p < 0 ou $p >= longueur($t)) { retour "" }
  $tok = $t[$p]
  si ($tok == "entier" ou $tok == "n") {
    si ($p + 1 >= longueur($t)) { retour "" }
    retour chaine(g4_entier_ou_zero($t[$p + 1])) + "/1"
  }
  si ($tok == "slot") {
    si ($p + 1 >= longueur($t)) { retour "" }
    $cle = chaine($f) + "|" + $t[$p + 1]
    si (cle_existe($g5_sconst, $cle)) { retour chaine($g5_sconst[$cle]) }
    retour ""
  }
  si ($tok != "(" ou $p + 2 >= longueur($t)) { retour "" }
  $h = $t[$p + 1]
  si ($h == "n" ou $h == "entier") {
    si ($p + 2 >= longueur($t)) { retour "" }
    retour chaine(g4_entier_ou_zero($t[$p + 2])) + "/1"
  }
  si ($h == "v") {
    $sl = g5_slot_of($f, $t[$p + 2])
    si ($sl < 0) { retour "" }
    $cle = chaine($f) + "|" + chaine($sl)
    si (cle_existe($g5_sconst, $cle)) { retour chaine($g5_sconst[$cle]) }
    retour ""
  }
  si ($h == "f" ou $h == "flottant") {
    $v = $t[$p + 2]
    si (g4_pos($v, "/") >= 0) { retour $v }
    retour ""
  }
  si ($h == "uni" et $p + 2 < longueur($t) et $t[$p + 2] == "-") {
    $u = g5_fold($t, $p + 3, $f)
    si (longueur($u) == 0) { retour "" }
    retour g5_rnorm(-g5_rnum($u), g5_rden($u))
  }
  si ($h == "app") {
    $nom = $t[$p + 2]
    $q = $p + 3
    $a = g5_fold($t, $q, $f)
    si (longueur($a) == 0) { retour "" }
    $q = $q + g5_atom_len($t, $q)
    $b = g5_fold($t, $q, $f)
    $an = g5_rnum($a); $ad = g5_rden($a)
    $bn = g5_rnum($b); $bd = g5_rden($b)
    si ($nom == "abs" et longueur($b) == 0) {
      $lim = 576460752303423488
      $av = $an
      si ($av < 0) { $av = -$av }
      si ($ad == 1 et ($av > $lim ou $av < -$lim)) {
        retour "@F|" + chaine(flottant(chaine($av)))
      }
      retour g5_rnorm($av, $ad)
    }
    si (($nom == "min" ou $nom == "max") et longueur($b) > 0) {
      $cmp = $an * $bd - $bn * $ad
      $choix = $a
      si (($nom == "min" et $cmp > 0) ou ($nom == "max" et $cmp < 0)) { $choix = $b }
      retour $choix
    }
    retour ""
  }
  si ($h == "bin" et $p + 3 < longueur($t)) {
    $op = $t[$p + 2]
    $q = $p + 3
    $a = g5_fold($t, $q, $f)
    si (longueur($a) == 0) { retour "" }
    $q = $q + g5_atom_len($t, $q)
    $b = g5_fold($t, $q, $f)
    si (longueur($b) == 0) { retour "" }
    $an = g5_rnum($a); $ad = g5_rden($a)
    $bn = g5_rnum($b); $bd = g5_rden($b)
    si ($op == "+") { retour g5_rnorm($an * $bd + $bn * $ad, $ad * $bd) }
    si ($op == "-") { retour g5_rnorm($an * $bd - $bn * $ad, $ad * $bd) }
    si ($op == "*") { retour g5_rnorm($an * $bn, $ad * $bd) }
    si ($op == "/") {
      si ($bn == 0) { retour "" }
      retour g5_rnorm($an * $bd, $ad * $bn)
    }
    si ($op == "%") {
      si ($ad != 1 ou $bd != 1 ou $bn == 0) { retour "" }
      retour g5_rnorm($an % $bn, 1)
    }
    si ($op == "^") {
      si ($ad != 1 ou $bd != 1 ou $bn < 0 ou $bn > 512) { retour "" }
      retour g5_rnorm($an ^ $bn, 1)
    }
  }
  retour ""
}

fn g5_eval($t: liste<chaine>, $pos: entier, $d: entier, $f: entier) -> entier {
  si (longueur($g5_err) > 0) { retour -1 }
  $n = longueur($t)
  si ($pos >= $n) { retour g5_fail("expression vide") }
  $tk = $t[$pos]
  si ($tk == "(") {
    $head = $t[$pos + 1]
    si ($head == "n" ou $head == "entier") {
      g5_load_val(0, g4_entier_ou_zero($t[$pos + 2]))
      retour $pos + 4
    }
    si ($head == "v") {
      g5_read_var($f, $t[$pos + 2])
      retour $pos + 4
    }
    si ($head == "s") {
      g5_make_str(g5_unescape($t[$pos + 2]))
      g5_emit(g5_tag1(0, 0))
      retour $pos + 4
    }
    si ($head == "f") {
      # G5 n'a pas de flottants : les littéraux (f K.K) sont repliés en entier.
      g5_load_val(0, g4_entier_ou_zero($t[$pos + 2]))
      retour $pos + 4
    }
    si ($head == "lstvide") {
      # SH3 : descripteur 32 octets [tag=2][len][cap][ptr] ; ptr pointe un
      # BLOC DE DONNEES SEPARE. joindre() realloue les donnees sans changer
      # l'adresse du descripteur, que tous les alias partagent.
      g5_load(0, 32 + 8 * 8)
      g5_alloc_inline()
      g5_load(1, 2)
      g5_emit(stroff(1, 0, 0))
      g5_emit(movz(1, 0))
      g5_emit(stroff(1, 0, 8))
      g5_load(1, 8)
      g5_emit(stroff(1, 0, 16))
      g5_emit(addi(1, 0, 32))
      g5_emit(stroff(1, 0, 24))
      g5_emit(g5_tag2(0, 0))
      retour $pos + 4
    }
    si ($head == "lst") {
      $p = $pos + 2
      $k = 0
      tant_que ($p < $n et $t[$p] != ")") {
        $p = g5_eval($t, $p, $d + 1, $f)
        si ($p < 0) { retour -1 }
        g5_emit(stroff(0, 31, g5_listoff($k, $d)))
        $k = $k + 1
      }
      $cap = $k
      si ($cap < 8) { $cap = 8 }
      g5_load(0, 32 + 8 * $cap)
      g5_alloc_inline()
      g5_load(1, 2)
      g5_emit(stroff(1, 0, 0))
      g5_load(1, $k)
      g5_emit(stroff(1, 0, 8))
      g5_load(1, $cap)
      g5_emit(stroff(1, 0, 16))
      g5_emit(addi(1, 0, 32))
      g5_emit(stroff(1, 0, 24))
      $j = 0
      tant_que ($j < $k) {
        g5_emit(ldroff(1, 31, g5_listoff($j, $d)))
        g5_load(2, 32 + 8 * $j)
        g5_emit(addr(2, 0, 2))
        g5_emit(stroff(1, 2, 0))
        $j = $j + 1
      }
      g5_emit(g5_tag2(0, 0))
      retour $p + 1
    }
    si ($head == "idx") {
      $p = g5_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(stroff(0, 31, g5_tmpoff($d)))
      $p = g5_eval($t, $p, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(orrr(1, 31, 0))
      g5_emit(ldroff(0, 31, g5_tmpoff($d)))
      g5_branch(1, $g5_idxl)
      retour $p + 1
    }
    si ($head == "bin") {
      $op = $t[$pos + 2]
      # G5-TAS : fusion sous_chaine(s,a,b) == "littéral" (et !=).
      # Au lieu d'allouer un descripteur de sous-chaîne à chaque caractère
      # balayé, on compare la LONGUEUR puis les OCTETS de la source avec le
      # littéral connu à l'émission. C'est la représentation par tranche
      # (pointeur,longueur), sans matérialisation du descripteur.
      si (($op == "==" ou $op == "!=") et $pos + 5 < $n et
          $t[$pos + 3] == "(" et $t[$pos + 4] == "app" et $t[$pos + 5] == "sous_chaine") {
        $a0 = $pos + 6
        $a1 = g5_skip_expr($t, $a0)
        $a2 = g5_skip_expr($t, $a1)
        $a3 = g5_skip_expr($t, $a2)
        # $a3 pointe sur le ')' fermant l'appel sous_chaine ; l'opérande
        # droite (le littéral) commence juste après.
        $pr = $a3 + 1
        si ($pr + 2 < $n et $t[$pr] == "(" et $t[$pr + 1] == "s") {
          $lit = g5_unescape($t[$pr + 2])
          $ll = longueur($lit)          # POINTS DE CODE (largeur b-a du RIR)
          # G5-UTF8 : le descripteur stocke des OCTETS. L'ancienne fusion
          # lisait l'octet à l'adresse `descr+16+a` : correct pour l'ASCII,
          # mais décalé de k-1 octets dès qu'un caractère de k octets précède
          # la position a (mesuré : `sous_chaine("≈\nx\n",i,i+1) == "\n"`
          # rendait NNNY au lieu de NYNY). Cela désynchronisait g4_lignes()
          # sur un RIR contenant un littéral non-ASCII : la ligne `ops`
          # devenait `ops\n`, puis g5_nu_op(5,4) échouait en silence (rc=2).
          # On convertit MAINTENANT l'indice de point de code `a` en décalage
          # octet en balayant la tête du descripteur (même motif que
          # g5_emit_sous / g5_emit_idx), puis on compare TOUS les octets
          # UTF-8 du littéral (et non un octet par point de code).
          $cpslit = g5_cps($lit)
          $boct = [0 : entier]
          $kj = 0
          tant_que ($kj < longueur($cpslit)) {
            $part = g5_utf8($cpslit[$kj])
            $ki = 0
            tant_que ($ki < longueur($part)) {
              joindre($boct, $part[$ki])
              $ki = $ki + 1
            }
            $kj = $kj + 1
          }
          $nb = longueur($boct)
          $lfaux = g5_next()
          $lfin = g5_next()
          $lscan = g5_next()
          $lfound = g5_next()
          $ld1 = g5_next()
          $ld2 = g5_next()
          $ld3 = g5_next()
          $ldone = g5_next()
          $p = g5_eval($t, $a0, $d + 1, $f)
          si ($p < 0) { retour -1 }
          g5_emit(stroff(0, 31, g5_tmpoff($d)))
          $p = g5_eval($t, $a1, $d + 1, $f)
          si ($p < 0) { retour -1 }
          g5_emit(orrr(1, 31, 0))
          $p = g5_eval($t, $a2, $d + 1, $f)
          si ($p < 0) { retour -1 }
          g5_emit(orrr(2, 31, 0))
          g5_emit(ldroff(0, 31, g5_tmpoff($d)))
          g5_emit(g5_asr3(1, 1))
          g5_emit(g5_asr3(2, 2))
          g5_emit(subr(3, 2, 1))
          g5_load(4, $ll)
          g5_emit(cmpr(3, 4))
          g5_branch(101, $lfaux)
          g5_emit(g5_masktag(6, 0))       # x6 = pointeur source brut
          g5_emit(movz(14, 0))            # x14 = ci (point de code courant)
          g5_emit(movz(15, 0))            # x15 = bo (décalage octet)
          g5_mark($lscan)
          g5_emit(cmpr(14, 1))            # ci == a ?
          g5_branch(100, $lfound)
          g5_emit(ldroff(11, 6, 8))       # x11 = nombre d'octets
          g5_emit(cmpr(15, 11))
          g5_branch(110, $lfound)         # bo >= len -> borne
          g5_emit(addi(19, 15, 16))
          g5_emit(ldrbr(17, 6, 19))       # octet de tête
          g5_emit(cmpi(17, 128))
          g5_branch(111, $ld1)
          g5_emit(cmpi(17, 224))
          g5_branch(111, $ld2)
          g5_emit(cmpi(17, 240))
          g5_branch(111, $ld3)
          g5_emit(movz(18, 4))
          g5_branch(0, $ldone)
          g5_mark($ld1); g5_emit(movz(18, 1)); g5_branch(0, $ldone)
          g5_mark($ld2); g5_emit(movz(18, 2)); g5_branch(0, $ldone)
          g5_mark($ld3); g5_emit(movz(18, 3))
          g5_mark($ldone)
          g5_emit(addr(15, 15, 18))
          g5_emit(addi(14, 14, 1))
          g5_branch(0, $lscan)
          g5_mark($lfound)
          g5_emit(addr(7, 6, 15))         # x7 = source + bo (x15)
          g5_emit(addi(7, 7, 16))
          $li = 0
          tant_que ($li < $nb) {
            g5_emit(ldrbio(8, 7, $li))
            g5_load(9, $boct[$li])
            g5_emit(cmpr(8, 9))
            g5_branch(101, $lfaux)
            $li = $li + 1
          }
          g5_load(0, 8)
          g5_branch(0, $lfin)
          g5_mark($lfaux)
          g5_emit(movz(0, 0))
          g5_mark($lfin)
          si ($op == "!=") {
            g5_load(5, 8)
            g5_emit(eorr(0, 0, 5))
          }
          retour g5_skip_expr($t, $pr) + 1
        }
      }
      $p = g5_eval($t, $pos + 3, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(stroff(0, 31, g5_tmpoff($d)))
      $p = g5_eval($t, $p, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(ldroff(1, 31, g5_tmpoff($d)))
      # x1 = opérande gauche taguée, x0 = opérande droite taguée.
      $c = g5_cond($op)
      si ($op == "==" ou $op == "!=") {
        # Égalité de chaînes : comparer le CONTENU, pas les pointeurs.
        # Sauts courts à déplacement calculé : zéro label supplémentaire.
        $npost = 0
        si ($op == "!=") { $npost = 2 }
        g5_emit(g5_tagbits(2, 1))
        g5_emit(g5_tagbits(3, 0))
        g5_emit(cmpi(2, 1)); g5_branch_off(101, 8 + $npost)
        g5_emit(cmpi(3, 1)); g5_branch_off(101, 6 + $npost)
        g5_emit(orrr(2, 31, 0)); g5_emit(orrr(0, 31, 1)); g5_emit(orrr(1, 31, 2))
        g5_branch(1, $g5_streql)
        si ($op == "!=") { g5_load(2, 8); g5_emit(eorr(0, 0, 2)) }
        # Le bloc g5_emit_cmp_value fait 24 instructions (test de tag,
        # chemin chaîne UTF-8 et chemin big) : le saut de retour de
        # l'égalité de chaînes doit l'enjamber (1 + 24 = 25).
        g5_branch_off(0, 25)
        g5_emit_cmp_value($c)
      } sinon si ($op == "+") {
        # G5-BIG : si l'un des opérandes porte le tag 3, on promeut l'autre
        # et on dispatch vers l'addition multi-limbes. Les deux opérandes
        # vivent dans x1 (gauche) et x0 (droite) à l'entrée de cette branche.
        # Sauts à déplacement CONSTANT (pas de g5_next() par `+`) : 1244 `+`
        # dans le RIR auto-hébergé, soit 2488 labels de plus, rendaient
        # g5_patch (recherche linéaire) prohibitif à l'émission.
        g5_emit(g5_tagbits(2, 1))
        g5_emit(cmpi(2, 3)); g5_branch_off(100, 17)
        g5_emit(g5_tagbits(2, 0))
        g5_emit(cmpi(2, 3)); g5_branch_off(100, 14)
        # '+' sur chaînes = CONCATÉNATION (c'était la cause du SIGSEGV :
        # deux descripteurs étaient additionnés comme des entiers brutaux).
        g5_emit(g5_tagbits(2, 1))
        g5_emit(cmpi(2, 0)); g5_branch_off(101, 6)
        g5_emit(g5_tagbits(2, 0))
        g5_emit(cmpi(2, 0)); g5_branch_off(101, 3)
        g5_emit(addr(0, 1, 0)); g5_branch_off(0, 17)
        g5_emit(orrr(2, 31, 0)); g5_emit(orrr(0, 31, 1)); g5_emit(orrr(1, 31, 2))
        g5_branch(1, $g5_catl)
        g5_branch_off(0, 12)           # retour de concat : sauter le bloc big
        # x4 = gauche, x5 = droite (hors d'atteinte des routines émises).
        g5_emit(orrr(4, 31, 1)); g5_emit(orrr(5, 31, 0))
        g5_emit(orrr(0, 31, 5)); g5_branch(1, $g5_bigprol); g5_emit(orrr(5, 31, 0))
        g5_emit(orrr(0, 31, 4)); g5_branch(1, $g5_bigprol); g5_emit(orrr(4, 31, 0))
        g5_emit(orrr(1, 31, 4)); g5_emit(orrr(0, 31, 5))
        g5_branch(1, $g5_bigaddl)
      } sinon si ($c >= 0) {
        g5_emit_cmp_value($c)
      } sinon si ($op == "-") {
        # G5-BIG : A - B = A + (-B) dès qu'un opérande porte le tag 3.
        # x1 = gauche taguée, x0 = droite taguée. Les deux sont promus
        # (bigpromote préserve x12/x13), la droite est inversée (bigneg),
        # puis bigadd effectue l'addition signée. Sauts à déplacement
        # constant : aucun label par nœud '-' (g5_patch reste linéaire).
        g5_emit(g5_tagbits(2, 1))
        g5_emit(cmpi(2, 3)); g5_branch_off(100, 4)   # gauche tag3 -> bloc big (idx6)
        g5_emit(g5_tagbits(2, 0))
        g5_emit(cmpi(2, 3)); g5_branch_off(101, 16)  # droite pas tag3 -> 64 bits (idx21)
        g5_emit(orrr(12, 31, 1)); g5_emit(orrr(13, 31, 0))
        g5_emit(orrr(0, 31, 13)); g5_branch(1, $g5_bigprol); g5_emit(orrr(13, 31, 0))
        g5_emit(orrr(0, 31, 12)); g5_branch(1, $g5_bigprol); g5_emit(orrr(12, 31, 0))
        g5_emit(orrr(0, 31, 13)); g5_branch(1, $g5_bignegl); g5_emit(orrr(13, 31, 0))
        g5_emit(orrr(1, 31, 12)); g5_emit(orrr(0, 31, 13))
        g5_branch(1, $g5_bigaddl)
        g5_branch_off(0, 2)                         # retour bigadd : enjamber la voie 64 bits
        g5_emit(subr(0, 1, 0))                      # voie 64 bits (petits entiers)
      } sinon si ($op == "*") { g5_emit(mulr(0, 1, 0)); g5_emit(g5_lsr3(0, 0))
      } sinon si ($op == "/" ou $op == "//" ou $op == "div") {
        g5_emit(g5_asr3(1, 1)); g5_emit(g5_asr3(0, 0))
        g5_emit(sdivr(0, 1, 0)); g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "%") {
        # SH12 : Rose utilise le MODULO PLANCHER (mesure : -7 % 3 = 2),
        # pas le reste C (-1). SDIV+MSUB donne le reste ; on ajoute le
        # diviseur quand le signe du reste diffère du sien (r!=0).
        $lmodok = g5_next()
        g5_emit(g5_asr3(1, 1)); g5_emit(g5_asr3(0, 0))
        g5_emit(sdivr(2, 1, 0))
        g5_emit(msubr(3, 2, 0, 1))
        g5_emit(cmpi(3, 0)); g5_branch(100, $lmodok)   # r == 0
        g5_emit(eorr(4, 3, 0)); g5_emit(cmpi(4, 0))
        g5_branch(110, $lmodok)                        # meme signe
        g5_emit(addr(3, 3, 0))                         # r += b
        g5_mark($lmodok)
        g5_emit(orrr(0, 31, 3))
        g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "^") {
        # G5-BIG : `(bin ^ entier A entier B)` dont le résultat dépasse 2^64
        # est replié à l'émission en descripteur tag 3 via g5_load_val —
        # exactement comme le compilateur natif replie déjà (2^64)^2 avant
        # le dump RIR. Borne prouvée : B <= 512 couvre 2^100 et 10^40 sans
        # risquer un décompte pathologique sur un RIR hostile.
        si ($pos + 7 < $n et $t[$pos + 3] == "entier" et $t[$pos + 5] == "entier") {
          $ba = g4_entier_ou_zero($t[$pos + 4])
          $be = g4_entier_ou_zero($t[$pos + 6])
          si ($be >= 0 et $be <= 512) {
            g5_load_val(0, $ba ^ $be)
            retour $pos + 8
          }
        }
        # x1 = base taguée, x0 = exposant tagué ; repli entier (pas de flottants).
        $l1 = g5_next()
        $l2 = g5_next()
        g5_emit(g5_asr3(2, 1))
        g5_emit(g5_asr3(3, 0))
        g5_emit(movz(0, 1))
        g5_mark($l1)
        g5_emit(cmpi(3, 0))
        g5_branch(100, $l2)
        g5_emit(mulr(0, 0, 2))
        g5_emit(subi(3, 3, 1))
        g5_branch(0, $l1)
        g5_mark($l2)
        g5_emit(g5_lsl3(0, 0))
      } sinon si ($op == "et") { g5_emit(andr(0, 1, 0))
      } sinon si ($op == "ou") { g5_emit(orrr(0, 1, 0))
      } sinon { retour g5_fail("op bin non couverte : " + $op) }
      retour $p + 1
    }
    si ($head == "app" ou $head == "appel_rir" ou $head == "appel") {
      $nom = $t[$pos + 2]
      # SH7 (C0.3) : `partie_entiere(17/3)` arrive sous la forme RIR
      # `(app partie_entiere (f 17/3))`. L'ABI G5 n'a pas de rationnels :
      # g5_eval replierait `(f 17/3)` sur 0 avant même d'appeler la routine.
      # On replie donc le quotient à l'émission, comme le fait déjà g5_op
      # pour l'affichage direct d'un littéral rationnel. La routine G5
      # g5_emit_par couvre le cas général (argument déjà entier, ex. les
      # 18 appels de g5_load/ldroff/stroff de l'émetteur lui-même).
      si ($nom == "partie_entiere" et $pos + 6 < $n et
          $t[$pos + 3] == "(" et $t[$pos + 4] == "f") {
        $rat = $t[$pos + 5]
        $bar = g4_pos($rat, "/")
        si ($bar >= 0) {
          $ra = g4_entier_ou_zero(g5_sub($rat, 0, $bar))
          $rb = g4_entier_ou_zero(g5_sub($rat, $bar + 1, longueur($rat)))
          si ($rb != 0) {
            g5_load_val(0, partie_entiere($ra / $rb))
            retour $pos + 7
          }
        }
      }
      $p = $pos + 3
      $k = 0
      tant_que ($p < $n et $t[$p] != ")") {
        $p = g5_eval($t, $p, $d + 1, $f)
        si ($p < 0) { retour -1 }
        g5_emit(stroff(0, 31, g5_argoff($k, $d)))
        $k = $k + 1
      }
      # SH2 : au-dela de x30 l'encodage 5 bits du registre deborde (x31=xzr,
      # x32=x0...). Les appels a 35 arguments (check_instr) ecrasaient x30/x0.
      # Les arguments 31+ passent par une zone RW fixe, lue immediatement
      # par le prologue de l'appel. IMPORTANT : cette boucle doit venir AVANT
      # le chargement de x0..x30, car elle utilise x14/x15 comme scratch et
      # ecraserait sinon les arguments 14 et 15 deja charges.
      # SH3 : x30 est LE REGISTRE DE LIEN. Le charger avec l'argument 30
      # puis faire BL ecrase x30 par l'adresse de retour : le parametre 30
      # du appele recoit l'adresse de retour (mesure : f31(31) -> 524380).
      # Desormais les arguments d'index >= 30 passent aussi par la zone.
      $i = 30
      tant_que ($i < $k) {
        g5_emit(ldroff(14, 31, g5_argoff($i, $d)))
        g5_load(15, 1610621952 + 8 * ($i - 30))
        g5_emit(stroff(14, 15, 0))
        $i = $i + 1
      }
      $i = 0
      tant_que ($i < $k et $i < 30) { g5_emit(ldroff($i, 31, g5_argoff($i, $d))); $i = $i + 1 }
      $lbl = -1
      si ($nom == "longueur") { $lbl = $g5_lenl }
      si ($nom == "ordre") { $lbl = $g5_ordl }
      si ($nom == "sous_chaine") { $lbl = $g5_sousl }
      si ($nom == "chaine") { $lbl = $g5_chl }
      si ($nom == "joindre") { $lbl = $g5_joindrel }
      si ($nom == "inserer") { $lbl = $g5_inserrel }
      si ($nom == "entier") { $lbl = $g5_entierl }
      # G5-IO : ces primitives sont de vraies routines émises (syscalls), plus des stubs.
      si ($nom == "nb_arguments") { $lbl = $g5_nbargs_l }
      si ($nom == "argument") { $lbl = $g5_argument_l }
      si ($nom == "lire_texte") { $lbl = $g5_lire_l }
      si ($nom == "ecrire_bytes" ou $nom == "ecrire_texte") { $lbl = $g5_ecrire_l }
      # J4 : syscalls mmap / mprotect / chmod / execve. Ces tests PRÉCÈDENT
      # la recherche de fonction utilisateur : un `fn mmap` factice dans la
      # source sert uniquement à faire accepter l'appel par le front-end,
      # l'appel G5 atterrit bien sur la routine syscall.
      si ($nom == "mmap") { $lbl = $g5_mmap_l }
      si ($nom == "mprotect") { $lbl = $g5_mprotect_l }
      si ($nom == "chmod") { $lbl = $g5_chmod_l }
      si ($nom == "execve") { $lbl = $g5_execve_l }
      # G5 n'a pas de flottants. flottant(s) sert surtout a vers_flottant()
      # qui reserialize les litteraux : le parser decimal suffit (les
      # flottants du dump de emetteur.rose sont a valeur entiere).
      si ($nom == "flottant") { $lbl = $g5_entierl }
      si ($nom == "cle_existe") { $lbl = $g5_clexl }
      # SH7 (C0.1/C0.2/C0.3) : primitives réellement émises, plus des stubs.
      si ($nom == "quitter") { $lbl = $g5_quitl }
      si ($nom == "caractere") { $lbl = $g5_carl }
      # OCTET_BRUT : intercepté AVANT la recherche de fonction utilisateur :
      # `octet_brut` existe bien comme fn Rose (voie Rust), mais sous G5 un
      # appel doit aboutir à la routine à 1 octet, pas à $g5_carl (UTF-8).
      si ($nom == "octet_brut") { $lbl = $g5_octetll }
      si ($nom == "partie_entiere") { $lbl = $g5_parl }
      si ($nom == "abs") { $lbl = $g5_absl }
      si ($nom == "min") { $lbl = $g5_minl }
      si ($nom == "max") { $lbl = $g5_maxl }
      si ($nom == "type") { $lbl = $g5_typel }
      si ($nom == "hasard" ou $nom == "prng") { $lbl = $g5_hasardl }
      si ($nom == "graine") { $lbl = $g5_grainel }
      # SH12 : inserer et supprimer sont de vraies routines de table
      # (cles ET valeurs) ; plus de repli sur joindre pour inserer.
      si ($nom == "table") { $lbl = $g5_tablel }
      si ($nom == "supprimer") { $lbl = $g5_supprl }
      si ($lbl < 0) {
        $trouve = 0
        $fi = 0
        tant_que ($fi < longueur($g5_fn)) {
          si ($g5_fn[$fi] == $nom) { $trouve = 1; $lbl = $g5_flbl[$fi] }
          $fi = $fi + 1
        }
        si ($trouve == 0) { $lbl = $g5_stub0l }
      }
      g5_branch(1, $lbl)
      # SH2 : Rose fait `joindre($liste, v)` SANS reaffecter : joindre mute
      # la liste en place. Le runtime G5 realloue des que la capacite est
      # atteinte et renvoie un NOUVEAU pointeur ; l'appelant gardait l'ancien
      # descripteur (cap=8), d'ou $gen qui restait a 1 element et la boucle
      # `T0($gen,$p) != "eof"` sans fin. On reecrit donc le slot de la
      # variable des que le premier argument est `(v nom)`.
      si ($nom == "joindre" et $pos + 5 < $n et $t[$pos + 3] == "(" et $t[$pos + 4] == "v") {
        g5_write_var($f, $t[$pos + 5])
      }
      retour $p + 1
    }
    si ($head == "neg") {
      $p = g5_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      # G5-BIG : 0-x pour un petit entier, copie à signe inversé pour un
      # descripteur tag 3 (nécessaire pour -$a où $a est un grand entier).
      g5_branch(1, $g5_bignegl)
      retour $p + 1
    }
    si ($head == "b") {
      $v = 0
      si ($t[$pos + 2] == "vraie") { $v = 1 }
      g5_load_val(0, $v)
      # SH3 : `(b vraie)` = 4 jetons '(' 'b' 'vraie' ')'. Renvoyer $pos+3
      # laissait le ')' comme jeton courant : la boucle d'arguments d'un
      # `app` s'arretait la, les arguments suivants n'etaient jamais émis
      # ni rangés dans argoff, et les registres xN gardaient des valeurs
      # parasites (clés de table d'internement, adresse de zone RW, ...).
      # Cause du crash final de SH2 dans rir_instr(ik) : `ik` (arg 11)
      # héritait de x11 non initialisé apres `(b faux)` en position 4.
      retour $pos + 4
    }
    si ($head == "non") {
      $p = g5_eval($t, $pos + 2, $d + 1, $f)
      si ($p < 0) { retour -1 }
      g5_emit(cmpi(0, 0)); g5_emit(cset(0, 0)); g5_emit(g5_lsl3(0, 0))
      retour $p + 1
    }
    si ($head == "uni") {
      $p = g5_eval($t, $pos + 3, $d + 1, $f)
      si ($p < 0) { retour -1 }
      si ($t[$pos + 2] == "non") { g5_emit(cmpi(0, 0)); g5_emit(cset(0, 0)); g5_emit(g5_lsl3(0, 0))
      } sinon si ($t[$pos + 2] == "neg" ou $t[$pos + 2] == "-") { g5_branch(1, $g5_bignegl)
      } sinon { retour g5_fail("unaire non couvert : " + $t[$pos + 2]) }
      retour $p + 1
    }
    retour g5_fail("forme parenthésée non couverte : " + $head)
  }
  si ($tk == "slot") { g5_read_slot($f, g4_entier_ou_zero($t[$pos + 1])); retour $pos + 2 }
  si ($tk == "entier" ou $tk == "n") { g5_load_val(0, g4_entier_ou_zero($t[$pos + 1])); retour $pos + 2 }
  si ($tk == "flottant") { g5_load_val(0, g4_entier_ou_zero($t[$pos + 1])); retour $pos + 2 }
  si ($tk == "v") {
    g5_read_var($f, $t[$pos + 1])
    retour $pos + 2
  }
  g5_load_val(0, g4_entier_ou_zero($tk))
  retour $pos + 1
}

# Un saut dont la cible vaut le nombre d'ops signifie « fin de fonction ».
fn g5_cible($f: entier, $tok: chaine) -> entier {
  $c = g4_entier_ou_zero($tok)
  si ($c >= $g5_fnop[$f]) { retour $g5_endlbl[$f] }
  retour $g5_oplbl[$g5_fop[$f] + $c]
}

# SH6 : genre des éléments d'un littéral liste (0=entier,1=chaîne,2=booléen).
fn g5_list_kind($t: liste<chaine>, $p: entier) -> entier {
  $q = $p + 2
  si ($q >= longueur($t) ou $t[$q] == ")") { retour 0 }
  $e = $t[$q]
  si ($e == "(" et $q + 1 < longueur($t)) { $e = $t[$q + 1] }
  si ($e == "s" ou $e == "chaine") { retour 1 }
  si ($e == "b" ou $e == "vrai" ou $e == "faux") { retour 2 }
  retour 0
}

fn g5_op($op: chaine, $f: entier, $principal: entier, $printl: entier, $exitl: entier) -> entier {
  # G5-R : le préfixe doit être AU DÉBUT de l'op. g4_operand cherchait n'importe
  # où et capturait à tort les littéraux (s "affect slot ") du propre RIR G5.
  $a = ""
  si (g5_sub($op, 0, 12) == "affect slot ") { $a = g4_trim(g5_sub($op, 12, longueur($op))) }
  si (g5_sub($op, 0, 16) == "affect_ast slot ") { $a = g4_trim(g5_sub($op, 16, longueur($op))) }
  si (longueur($a) > 0) {
    $eq = g4_pos($a, "=")
    $sl = g4_entier_ou_zero(g5_sub($a, 0, $eq))
    $rhs = g4_trim(g5_sub($a, $eq + 1, longueur($a)))
    $trhs = g5_tokens($rhs)
    # G5-FORMULES : mémorise la valeur exacte du slot quand elle est repliable.
    # Une affectation non repliable invalide l'entrée (valeur "").
    inserer($g5_sconst, chaine($f) + "|" + chaine($sl), g5_fold($trhs, 0, $f))
    g5_eval($trhs, 0, 0, $f)
    si (g5_est_bool($trhs, 0, $f) == 1) {
      inserer($g5_sbool, chaine($f) + "|" + chaine($sl), 1)
    }
    # SH6 : mémorise le genre des éléments d'une liste affectée à un slot.
    si (longueur($trhs) > 1 et $trhs[0] == "(" et $trhs[1] == "lst") {
      inserer($g5_slist, chaine($f) + "|" + chaine($sl), g5_list_kind($trhs, 0))
    }
    g5_write_slot($f, $sl)
    retour 0
  }
  $t = g5_tokens($op)
  $head = $t[0]
  si ($head == "expr") { g5_eval($t, 1, 0, $f); retour 0 }
  si ($head == "saut") { g5_const_clear($f); g5_branch(0, g5_cible($f, $t[1])); retour 0 }
  si ($head == "saut_si_faux" ou $head == "saut_si_faux_abstrait") {
    g5_const_clear($f)
    g5_eval($t, 2, 0, $f)
    g5_emit(cmpi(0, 0))
    g5_branch(100, g5_cible($f, $t[1]))
    retour 0
  }
  si ($head == "retour" ou $head == "retour_abstrait") {
    g5_eval($t, 1, 0, $f)
    si ($f == $principal) { g5_branch(1, $printl)
    } sinon { g5_emit(ldroff(30, 31, 0)); g5_emit_addsp(g5_framesize($f)); g5_emit(RET_I()) }
    retour 0
  }
  si ($head == "afficher" ou $head == "afficher_abstrait") {
    # ── SH6 : affichage des listes `[a, b]` ──
    # L'ABI G5 range une liste dans un descripteur [tag=2][len][cap][ptr].
    # La routine dédiée g5_emit_plist écrit "[…]" sans toucher au flux de
    # g5_emit_print (donc le dump réflexif reste inchangé).
    $lkind = -1
    si ($t[1] == "(" et $t[2] == "lst") { $lkind = g5_list_kind($t, 1) }
    si ($t[1] == "slot") {
      $lkl = cle_existe($g5_slist, chaine($f) + "|" + $t[2])
      si ($lkl) { $lkind = $g5_slist[chaine($f) + "|" + $t[2]] }
    }
    si ($t[1] == "(" et $t[2] == "v" et $t[3] != ")") {
      $lv = g5_slot_of($f, $t[3])
      $lkk = chaine($f) + "|" + chaine($lv)
      si ($lv >= 0 et cle_existe($g5_slist, $lkk)) { $lkind = $g5_slist[$lkk] }
    }
    si ($lkind >= 0) {
      g5_eval($t, 1, 0, $f)
      g5_load(22, $lkind)
      g5_branch(1, $g5_plist_l)
      retour 0
    }
    # ── SH12 : type(littéral) — l'ABI G5 confond booléen/entier et
    # rationnel/flottant avec des entiers. Le littéral est connu à
    # l'émission : on sérialise directement le bon mot. ──
    si ($t[1] == "(" et $t[2] == "app" et $t[3] == "type" et $t[4] == "(") {
      $h = $t[5]
      $ty = ""
      si ($h == "b") { $ty = "booleen" }
      si ($h == "f") {
        $ty = "flottant"
        si ($t[6] != ")" et g4_pos($t[6], "/") >= 0) { $ty = "rationnel" }
      }
      si ($h == "flottant") { $ty = "flottant" }
      si ($h == "s") { $ty = "chaine" }
      si ($h == "lst") { $ty = "liste" }
      si ($h == "app" et $t[6] == "table") { $ty = "table" }
      si ($h == "v" ou $h == "slot") {
        si (g5_est_bool($t, 4, $f) == 1) { $ty = "booleen" }
      }
      si ($ty != "") { g5_make_str($ty); g5_branch(1, $printl); retour 0 }
    }
    # ── SH12 : chaine(expression booléenne) — comparaison `bin`, `non`,
    # variable booléenne ou appel retournant booleen. La valeur est
    # calculée puis convertie par la routine dédiée (g5_emit_ch rendrait
    # "1"/"0"). g5_est_bool($t,4,$f) inspecte le jeton à la position 4. ──
    si ($t[1] == "(" et $t[2] == "app" et $t[3] == "chaine" et
        $t[4] == "(" et g5_est_bool($t, 4, $f) == 1) {
      g5_eval($t, 4, 0, $f)
      g5_branch(1, $g5_chbooll)
      g5_branch(1, $printl)
      retour 0
    }
    # SH9/SH7 : `chaine(b vraie)` / `chaine(b faux)` — un LITTÉRAL booléen
    # n'a pas de slot à interroger dans $g5_sbool. Sans ce repli, g5_emit_ch
    # voit un entier tagué 0/8 et rend "1"/"0" au lieu de "vrai"/"faux"
    # (mesuré dans t999 : ligne 11 natif=vrai, ELF=1).
    si ($t[1] == "(" et $t[2] == "app" et $t[3] == "chaine" et
        $t[4] == "(" et $t[5] == "b" et $t[6] == "vraie") {
      g5_make_str("vrai")
      g5_branch(1, $printl)
      retour 0
    }
    si ($t[1] == "(" et $t[2] == "app" et $t[3] == "chaine" et
        $t[4] == "(" et $t[5] == "b" et $t[6] == "faux") {
      g5_make_str("faux")
      g5_branch(1, $printl)
      retour 0
    }
    # SH4 : `chaine($x)` ou `chaine(slot N)` avec $x un booléen doit rendre
    # "vrai"/"faux" (natif : >> chaine(3<5) -> vrai). L'ABI G5 confond le
    # booléen avec l'entier 0/1 ; on intercepte donc l'affichage direct.
    si ($t[1] == "(" et $t[2] == "app" et $t[3] == "chaine" et
        $t[4] == "(" et ($t[5] == "v" ou $t[5] == "slot")) {
      $csl = -1
      si ($t[5] == "slot") { $csl = g4_entier_ou_zero($t[6])
      } sinon { $csl = g5_slot_of($f, $t[6]) }
      si ($csl >= 0 et cle_existe($g5_sbool, chaine($f) + "|" + chaine($csl))) {
        $lvrai = g5_next()
        $lfaux2 = g5_next()
        g5_emit(ldroff(0, 31, g5_slotoff($csl)))
        g5_emit(cmpi(0, 0))
        g5_branch(100, $lfaux2)
        g5_make_str("vrai")
        g5_branch(0, $lvrai)
        g5_mark($lfaux2)
        g5_make_str("faux")
        g5_mark($lvrai)
        g5_branch(1, $printl)
        retour 0
      }
    }
    # SH4 : un littéral flottant/rationnel affiché directement est sérialisé
    # sous sa forme Rose exacte. g5_eval le tronquerait à 0 (ABI G5 = entiers
    # seulement). Les flottants à valeur entière sont déjà sérialisés par le
    # compilateur Rose comme `flottant 2` (sans point) et gardent leur voie.
    $litt = ""
    si ($t[1] == "flottant") { $litt = $t[2] }
    si ($t[1] == "(" et $t[2] == "f") { $litt = $t[3] }
    si (longueur($litt) > 0 et
        (g4_pos($litt, ".") >= 0 ou g4_pos($litt, "/") >= 0)) {
      g5_make_str(g4_ratio_texte($litt))
      g5_branch(1, $printl)
      retour 0
    }
    # SH6 : flottant à valeur entière >= 1e16. Le natif Rose passe alors en
    # notation exponentielle (1e+20) ; l'ABI G5 (entiers 64 bits) déborde.
    # On sérialise le texte à l'émission avec le formateur natif de Rose,
    # disponible ici (l'émetteur s'exécute sous l'interpréteur Rose).
    si ($t[1] == "flottant" et longueur($t) > 2) {
      $fl = $t[2]
      si (longueur($fl) >= 17 et g4_pos($fl, ".") < 0 et g4_pos($fl, "/") < 0) {
        g5_make_str(chaine(flottant($fl)))
        g5_branch(1, $printl)
        retour 0
      }
    }
    # G5-FORMULES : un résultat arithmétique EXACT connu à l'émission est
    # sérialisé directement (g4_ratio_texte produit la décimale périodique
    # entre crochets comme l'interpréteur Rose). On ne replie que les valeurs
    # hors de la plage 64 bits : les petites gardent la voie machine d'origine.
    $g5fr = g5_fold($t, 1, $f)
    $g5fbig = g5_hasbig($t, 1, $f)
    $g5fdiv = g5_hasdiv($t, 1)
    si (longueur($g5fr) > 0 et ($g5fbig == 1 ou $g5fdiv == 1 ou g5_sub($g5fr, 0, 3) == "@F|")) {
      $g5ftxt = ""
      si (g5_sub($g5fr, 0, 3) == "@F|") {
        $g5ftxt = g5_sub($g5fr, 3, longueur($g5fr))
      } sinon {
        $g5ftxt = g4_ratio_texte($g5fr)
      }
      si (longueur($g5ftxt) > 0) {
        g5_make_str($g5ftxt)
        g5_branch(1, $printl)
        retour 0
      }
    }
    g5_eval($t, 1, 0, $f)
    si (g5_est_bool($t, 1, $f) == 1) {
      # SH4 : l'interpréteur Rose (ROSE_SANS_JIT=1, référence sémantique)
      # affiche "vrai"/"faux" pour TOUT booléen, y compris un littéral `b`.
      # Le JIT courant affiche parfois 1/0 (bug hors de ce fichier) ; l'ELF
      # n'a pas de JIT et doit suivre la sémantique, pas le bug.
      # On convertit ici x0 en chaîne "vrai"/"faux" avant d'entrer dans
      # g5_emit_print, qui reconnaît le tag 1 et écrit les octets.
      $lfaux = g5_next()
      $lfin = g5_next()
      g5_emit(cmpi(0, 0))
      g5_branch(100, $lfaux)
      g5_make_str("vrai")
      g5_branch(0, $lfin)
      g5_mark($lfaux)
      g5_make_str("faux")
      g5_mark($lfin)
    }
    g5_branch(1, $printl)
    retour 0
  }
  retour g5_fail("op non couverte : " + $op)
}

fn g5_parse($src: chaine) -> entier {
  $ll = g4_lignes($src)
  $i = 1
  tant_que ($i < longueur($ll)) {
    $t = g4_trim($ll[$i])
    si (g5_sub($t, 0, 9) == "fonction ") {
      $nm = g4_trim(g5_sub($t, 9, longueur($t)))
      $slot = 0
      $noms = ""
      $globaux = ""
      $nparam = 0
      $ret = "vide"
      $ops = [0 : chaine]
      $en_ops = 0
      $i = $i + 1
      # SH7 : sous G5, `et` est un AND BIT À BIT non court-circuitant
      # (g5_eval émet `andr`). L'ancienne condition évaluait donc `$ll[$i]`
      # MÊME quand $i avait atteint longueur($ll) : index hors bornes -> 0,
      # puis g4_trim(0) -> longueur(0) -> SIGSEGV (mesuré sur e_self.elf
      # tiny.rir : pc 0x45ec1c, x0=0). On garde l'accès dans le corps,
      # protégé par la seule borne, exactement comme le ferait un `et`
      # court-circuitant. Le comportement natif est inchangé.
      $fin_bloc = 0
      tant_que ($fin_bloc == 0 et $i < longueur($ll)) {
        $u = g4_trim($ll[$i])
        si (g5_sub($u, 0, 9) == "fonction ") { $fin_bloc = 1
        } sinon {
          si (g5_sub($u, 0, 6) == "param ") { $nparam = $nparam + 1
          } sinon si (g5_sub($u, 0, 7) == "retour ") { $ret = g4_trim(g5_sub($u, 7, longueur($u)))
          } sinon si (g5_sub($u, 0, 8) == "n_slots ") { $slot = g4_entier_ou_zero(g5_sub($u, 8, longueur($u)))
          } sinon si (g5_sub($u, 0, 5) == "noms ") { $noms = g4_trim(g5_sub($u, 5, longueur($u)))
          } sinon si (g5_sub($u, 0, 8) == "globaux ") { $globaux = g4_trim(g5_sub($u, 8, longueur($u)))
          } sinon si ($u == "ops") { $en_ops = 1
          } sinon si ($en_ops == 1 et longueur($u) > 0) { joindre($ops, g5_nu_op($u)) }
          $i = $i + 1
        }
      }
      # SH10 : la table des globales est construite à la fin du $principal :
      # les fonctions compilées ensuite résolvent leurs noms non locaux ici.
      si ($nm == "$principal") { g5_set_globaux($noms, $globaux) }
      joindre($g5_fn, $nm)
      joindre($g5_fnslot, $slot)
      joindre($g5_fnam, g5_noms($noms))
      joindre($g5_fop, longueur($g5_ops))
      joindre($g5_fnop, longueur($ops))
      joindre($g5_flbl, g5_next())
      joindre($g5_endlbl, g5_next())
      joindre($g5_fparam, $nparam)
      joindre($g5_fret, $ret)
      $j = 0
      tant_que ($j < longueur($ops)) { joindre($g5_ops, $ops[$j]); joindre($g5_oplbl, g5_next()); $j = $j + 1 }
    } sinon { $i = $i + 1 }
  }
  retour longueur($g5_fn)
}

fn g5_compile_fonction($f: entier, $principal: entier, $printl: entier, $exitl: entier) -> entier {
  g5_mark($g5_flbl[$f])
  # G5-IO : AVANT de déplacer sp, mémoriser argc et l'adresse de argv[0]
  # tels que le noyau les a posés sur la pile initiale. Ces cases sont sous
  # le début du tas (0x60000300) et ne peuvent donc pas être écrasées.
  si ($f == $principal) {
    g5_emit(ldroff(10, 31, 0))
    g5_emit(addi(11, 31, 8))
    g5_load(9, 1610612752)
    g5_emit(stroff(10, 9, 0))
    g5_emit(stroff(11, 9, 8))
  }
  g5_emit_subsp(g5_framesize($f))
  g5_emit(stroff(30, 31, 0))
  si ($f == $principal) {
    g5_load(9, 1610612736)
    # G5-TAS : le tas démarre à 0x60008000 (SH10). La plage 0x60004000..
    # 0x60005000 est réservée aux 512 GLOBALES G5 ; le scratch décimal
    # 0x60003800..0x60004000 reste inchangé. Les tables d'internement
    # 0x60000300 (chaînes) et 0x60003000 (caractères) sont hors du tas.
    g5_load(8, 1610645504)
    g5_emit(stroff(8, 9, 0))
  }
  $p = 0
  tant_que ($p < $g5_fparam[$f] et $p < 30) { g5_emit(stroff($p, 31, g5_slotoff($p))); $p = $p + 1 }
  tant_que ($p < $g5_fparam[$f]) {
    g5_load(15, 1610621952 + 8 * ($p - 30))
    g5_emit(ldroff(1, 15, 0))
    g5_emit(stroff(1, 31, g5_slotoff($p)))
    $p = $p + 1
  }
  $i = 0
  tant_que ($i < $g5_fnop[$f]) {
    g5_mark($g5_oplbl[$g5_fop[$f] + $i])
    g5_op($g5_ops[$g5_fop[$f] + $i], $f, $principal, $printl, $exitl)
    si (longueur($g5_err) > 0) { retour -1 }
    $i = $i + 1
  }
  g5_mark($g5_endlbl[$f])
  si ($f == $principal) { g5_branch(1, $exitl)
  } sinon { g5_emit(ldroff(30, 31, 0)); g5_emit_addsp(g5_framesize($f)); g5_emit(RET_I()) }
  retour 0
}

# Routine write(1,buf,len) — reçoit la valeur dans x0. $lbl est le premier de 7 labels réservés.
fn g5_emit_print($lbl: entier) -> entier {
  g5_mark($lbl)
  # E/S réelles : write(1, sp+64, len) puis write(1, "\n", 1).
  # Les buffers de conversion VIVENT DANS LE CADRE (sp+64 / sp+128) :
  # la version historique écrivait aux adresses ABSOLUES 16 et 64 (SIGSEGV
  # dès qu'une chaîne était affichée) — constat rejoué sur le binaire HEAD.
  $lstr = g5_next()
  $lcpy = g5_next()
  $lwrtstr = g5_next()
  $lpos = g5_next()
  $ldig = g5_next()
  $ldloop = g5_next()
  $lrev = g5_next()
  $lrevloop = g5_next()
  $lwrtint = g5_next()
  $lfin = g5_next()
  # G5-BIG : labels de l'imprimeur décimal multi-limbes (tag 3).
  $lbigp = g5_next()
  $lbpcopy = g5_next()
  $lbpcopyend = g5_next()
  $lbpdigits = g5_next()
  $lbpfirstloop = g5_next()
  $lbpfirstdone = g5_next()
  $lbppadloop = g5_next()
  $lbppadbody = g5_next()
  $lbpsign = g5_next()
  $lbpzero = g5_next()
  $lbpsign2 = g5_next()
  $lbpwrite = g5_next()
  g5_emit(stroff(0, 31, 8))
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 3))
  g5_branch(100, $lbigp)         # grand entier -> conversion multi-limbes
  g5_emit(cmpi(2, 1))
  g5_branch(100, $lstr)
  # ── entier : conversion décimale signée ──
  g5_emit(g5_asr3(0, 0))
  g5_emit(addi(6, 31, 64))
  g5_emit(orrr(7, 31, 6))
  g5_emit(cmpi(0, 0))
  g5_branch(110, $lpos)
  g5_emit(movz(1, 45))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_emit(subr(0, 31, 0))
  g5_mark($lpos)
  g5_emit(cmpi(0, 0))
  g5_branch(101, $ldig)
  g5_emit(movz(1, 48))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_branch(0, $lwrtint)
  g5_mark($ldig)
  g5_emit(addi(3, 31, 128))
  g5_emit(movz(2, 0))
  g5_mark($ldloop)
  g5_emit(cmpi(0, 0))
  g5_branch(100, $lrev)
  g5_emit(movz(1, 10))
  g5_emit(udivr(4, 0, 1))
  g5_emit(msubr(5, 4, 1, 0))
  g5_emit(addi(5, 5, 48))
  g5_emit(strbio(5, 3, 0))
  g5_emit(addi(3, 3, 1))
  g5_emit(addi(2, 2, 1))
  g5_emit(orrr(0, 31, 4))
  g5_branch(0, $ldloop)
  g5_mark($lrev)
  g5_emit(subi(4, 3, 1))
  g5_emit(movz(5, 0))
  g5_mark($lrevloop)
  g5_emit(cmpr(5, 2))
  g5_branch(110, $lwrtint)
  g5_emit(ldrbio(1, 4, 0))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_emit(subi(4, 4, 1))
  g5_emit(addi(5, 5, 1))
  g5_branch(0, $lrevloop)
  g5_mark($lwrtint)
  g5_emit(subr(2, 7, 6))
  g5_emit(movz(0, 1))
  g5_emit(addi(1, 31, 64))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_branch(0, $lfin)
  # ── chaîne : write(1, descripteur+16, len) par blocs, SANS tampon de pile ──
  # (une copie dans sp+64 débordait le cadre de 9232 o dès ~9 Ko ; constat
  # rejoué avec lire_texte sur le RIR de 263 065 octets.)
  g5_mark($lstr)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(10, 9, 8))
  g5_emit(addi(1, 9, 16))
  g5_emit(movz(5, 0))
  g5_mark($lcpy)
  g5_emit(cmpr(5, 10))
  g5_branch(110, $lwrtstr)
  g5_emit(movz(0, 1))
  g5_emit(subr(2, 10, 5))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lwrtstr)
  g5_emit(orrr(4, 31, 0))
  g5_emit(addr(1, 1, 4))
  g5_emit(addr(5, 5, 4))
  g5_branch(0, $lcpy)
  g5_mark($lwrtstr)
  g5_branch(0, $lfin)
  # ── G5-BIG : affichage exact d'un [3][signe][nlimbs][limbs base 10^9] ──
  # Copy des limbs vers 0x60005000, puis écriture de 9 chiffres par limb dans
  # le tampon DÉCROISSANT 0x60006000 ; les zéros de tête sont retirés avant
  # l'écriture. Les limbs sont parcourus du moins au plus significatif pour
  # que le résultat soit l'ordre décimal naturel. x2 = diviseur 10.
  g5_mark($lbigp)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(10, 9, 8))              # signe
  g5_emit(ldroff(11, 9, 16))             # nlimbs
  g5_emit(addi(0, 9, 24))
  g5_load(1, 1610633216)                 # 0x60005000
  g5_mark($lbpcopy)
  g5_emit(cmpi(11, 0)); g5_branch(100, $lbpcopyend)
  g5_emit(ldroff(2, 0, 0)); g5_emit(stroff(2, 1, 0))
  g5_emit(addi(0, 0, 8)); g5_emit(addi(1, 1, 8)); g5_emit(subi(11, 11, 1))
  g5_branch(0, $lbpcopy)
  g5_mark($lbpcopyend)
  g5_emit(ldroff(10, 9, 8))              # signe (x11 a été compté à zéro)
  g5_emit(ldroff(11, 9, 16))             # nlimbs
  g5_load(13, 1610633216)                # 0x60005000 = &limb[0]
  g5_load(14, 1610637312)                # 0x60006000 (fin du tampon)
  g5_emit(orrr(12, 31, 11))              # limbs restants
  g5_mark($lbpdigits)
  g5_emit(cmpi(12, 0)); g5_branch(100, $lbpsign)
  g5_emit(ldroff(2, 13, 0))
  g5_emit(addi(13, 13, 8))               # limb[0] d'abord : le plus significatif
  #                                        finit aux adresses les plus hautes
  g5_mark($lbppadloop)
  g5_emit(movz(6, 9))                    # 9 chiffres par limb (zéros de tête)
  g5_mark($lbppadbody)
  g5_emit(movz(3, 10)); g5_emit(udivr(4, 2, 3)); g5_emit(msubr(5, 4, 3, 2))
  g5_emit(addi(5, 5, 48)); g5_emit(subi(14, 14, 1)); g5_emit(strbio(5, 14, 0))
  g5_emit(orrr(2, 31, 4)); g5_emit(subi(6, 6, 1))
  g5_emit(cmpi(6, 0)); g5_branch(101, $lbppadbody)
  g5_emit(subi(12, 12, 1)); g5_branch(0, $lbpdigits)
  g5_mark($lbpsign)
  # Retirer les zéros de tête du tampon (au moins un chiffre reste).
  g5_mark($lbpzero)
  g5_load(2, 1610637312); g5_emit(subi(2, 2, 1))
  g5_emit(cmpr(14, 2)); g5_branch(110, $lbpsign2)
  g5_emit(ldrbio(3, 14, 0)); g5_emit(cmpi(3, 48)); g5_branch(101, $lbpsign2)
  g5_emit(addi(14, 14, 1)); g5_branch(0, $lbpzero)
  g5_mark($lbpsign2)
  g5_emit(cmpi(10, 0)); g5_branch(100, $lbpwrite)
  g5_emit(movz(2, 45)); g5_emit(subi(14, 14, 1)); g5_emit(strbio(2, 14, 0))
  g5_mark($lbpwrite)
  g5_load(2, 1610637312); g5_emit(subr(2, 2, 14))
  g5_emit(movz(0, 1)); g5_emit(orrr(1, 31, 14)); g5_emit(movz(8, 64)); g5_emit(SVC_I())
  g5_branch(0, $lfin)
  g5_mark($lfin)
  # `>>` de Rose termine chaque affichage par un saut de ligne.
  g5_emit(movz(1, 10))
  g5_emit(strbio(1, 31, 64))
  g5_emit(movz(0, 1))
  g5_emit(addi(1, 31, 64))
  g5_emit(movz(2, 1))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(RET_I())
  retour 0
}

# ── SH6 : écriture d'un littéral sur stdout, SANS saut de ligne ──
# Clobber x0,x1,x2,x8. Le tampon sp+64 est sufficient pour les petits
# séparateurs ("[", ", ", "]") utilisés par l'imprimeur de listes.
fn g5_puts($s: chaine) -> entier {
  $i = 0
  tant_que ($i < longueur($s)) {
    g5_load(1, ordre(sous_chaine($s, $i, $i + 1)))
    g5_emit(strbio(1, 31, 64 + $i))
    $i = $i + 1
  }
  g5_emit(movz(0, 1))
  g5_emit(addi(1, 31, 64))
  g5_load(2, longueur($s))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  retour 0
}

# Variante stderr (fd 2) de g5_puts, pour les messages d'erreur Rose.
fn g5_puts2($s: chaine) -> entier {
  $i = 0
  tant_que ($i < longueur($s)) {
    g5_load(1, ordre(sous_chaine($s, $i, $i + 1)))
    g5_emit(strbio(1, 31, 64 + $i))
    $i = $i + 1
  }
  g5_emit(movz(0, 2))
  g5_emit(addi(1, 31, 64))
  g5_load(2, longueur($s))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  retour 0
}

# ── SH6 : affichage des listes `[...]` ──
# x0 = liste taguée (pointeur|2). x1 = genre des éléments :
#   0 = entier, 1 = chaîne, 2 = booléen (vrai/faux).
# Routine autonome : elle N'appelle PAS g5_emit_print, donc le dump réflexif
# (qui affiche des chaînes ligne par ligne) reste octet pour octet identique.
# Registres préservés par convention ici : x23 descripteur, x24 len,
# x25 pointeur de données, x26 index, x27 compteur de chiffres, x11 LR.
fn g5_emit_plist($lbl: entier) -> entier {
  g5_mark($lbl)
  $lloop = g5_next()
  $lnd = g5_next()
  $lcomma = g5_next()
  $lnocomma = g5_next()
  $lelem = g5_next()
  $lbool = g5_next()
  $lfaux = g5_next()
  $lstrw = g5_next()
  $lscpy = g5_next()
  $lint = g5_next()
  $lpos = g5_next()
  $ldig = g5_next()
  $ldloop = g5_next()
  $lrev = g5_next()
  $lrevloop = g5_next()
  $llwrt = g5_next()
  $lnext = g5_next()
  $ldone = g5_next()
  g5_emit(orrr(11, 31, 30))        # sauvegarde de LR (appelé par BL)
  g5_emit(g5_masktag(23, 0))       # descripteur brut
  g5_emit(ldroff(24, 23, 8))       # len
  g5_emit(ldroff(25, 23, 24))      # ptr de données
  g5_emit(movz(26, 0))             # i = 0
  g5_puts("[")
  g5_mark($lloop)
  g5_emit(cmpr(26, 24))
  g5_branch(110, $ldone)           # i >= len -> fin
  g5_emit(cmpi(26, 0))
  g5_branch(100, $lnocomma)
  g5_puts(", ")
  g5_mark($lnocomma)
  # chargement de l'élément i
  g5_emit(addr(2, 26, 26)); g5_emit(addr(2, 2, 2)); g5_emit(addr(2, 2, 2))
  g5_emit(addr(2, 25, 2))
  g5_emit(ldroff(0, 2, 0))
  # dispatch sur le genre (x22, non clobberé par g5_puts / g5_make_str)
  g5_emit(cmpi(22, 2))
  g5_branch(100, $lbool)
  g5_emit(cmpi(22, 1))
  g5_branch(100, $lstrw)
  g5_branch(0, $lint)
  # ── booléen -> chaîne "vrai"/"faux" ──
  g5_mark($lbool)
  g5_emit(cmpi(0, 0))
  g5_branch(100, $lfaux)
  g5_make_str("vrai")
  g5_branch(0, $lstrw)
  g5_mark($lfaux)
  g5_make_str("faux")
  # ── écriture d'une chaîne (déjà taguée dans x0) ──
  g5_mark($lstrw)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(10, 9, 8))
  g5_emit(addi(1, 9, 16))
  g5_emit(movz(5, 0))
  g5_mark($lscpy)
  g5_emit(cmpr(5, 10))
  g5_branch(110, $lnext)           # i >= len -> élément suivant
  g5_emit(movz(0, 1))
  g5_emit(subr(2, 10, 5))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(orrr(4, 31, 0))
  g5_emit(addr(1, 1, 4))
  g5_emit(addr(5, 5, 4))
  g5_branch(0, $lscpy)
  # ── entier -> décimale signée ──
  g5_mark($lint)
  g5_emit(g5_asr3(0, 0))
  g5_emit(addi(6, 31, 64))
  g5_emit(orrr(7, 31, 6))
  g5_emit(cmpi(0, 0))
  g5_branch(110, $lpos)
  g5_emit(movz(1, 45))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_emit(subr(0, 31, 0))
  g5_mark($lpos)
  g5_emit(cmpi(0, 0))
  g5_branch(101, $ldig)
  g5_emit(movz(1, 48))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_branch(0, $llwrt)
  g5_mark($ldig)
  g5_emit(addi(3, 31, 128))
  g5_emit(movz(2, 0))
  g5_mark($ldloop)
  g5_emit(cmpi(0, 0))
  g5_branch(100, $lrev)
  g5_emit(movz(1, 10))
  g5_emit(udivr(4, 0, 1))
  g5_emit(msubr(5, 4, 1, 0))
  g5_emit(addi(5, 5, 48))
  g5_emit(strbio(5, 3, 0))
  g5_emit(addi(3, 3, 1))
  g5_emit(addi(2, 2, 1))
  g5_emit(orrr(0, 31, 4))
  g5_branch(0, $ldloop)
  g5_mark($lrev)
  g5_emit(subi(4, 3, 1))
  g5_emit(movz(5, 0))
  g5_mark($lrevloop)
  g5_emit(cmpr(5, 2))
  g5_branch(110, $llwrt)
  g5_emit(ldrbio(1, 4, 0))
  g5_emit(strbio(1, 7, 0))
  g5_emit(addi(7, 7, 1))
  g5_emit(subi(4, 4, 1))
  g5_emit(addi(5, 5, 1))
  g5_branch(0, $lrevloop)
  g5_mark($llwrt)
  g5_emit(subr(2, 7, 6))
  g5_emit(movz(0, 1))
  g5_emit(addi(1, 31, 64))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_mark($lnext)
  g5_emit(addi(26, 26, 1))
  g5_branch(0, $lloop)
  g5_mark($ldone)
  g5_puts("]")
  # `>>` de Rose termine chaque affichage par un saut de ligne.
  g5_emit(movz(1, 10))
  g5_emit(strbio(1, 31, 64))
  g5_emit(movz(0, 1))
  g5_emit(addi(1, 31, 64))
  g5_emit(movz(2, 1))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(orrr(30, 31, 11))        # restauration de LR
  g5_emit(RET_I())
  retour 0
}

# ── G5-R : runtime des valeurs chaîne/liste ──
# Descripteur : [tag: 1=chaîne, 2=liste][longueur][données…].
# Tas : page RW à 0x60000000 ; le mot [0x60000000] contient le pointeur libre.
fn g5_emit_alloc($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_load(9, 1610612736)
  g5_emit(ldroff(2, 9, 0))
  g5_emit(orrr(1, 31, 0))
  g5_emit(orrr(0, 31, 2))
  g5_emit(addr(2, 2, 1))
  g5_emit(stroff(2, 9, 0))
  g5_emit(RET_I())
  retour 0
}

fn g5_emit_len($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(1, 0))
  g5_emit(ldroff(2, 1, 0))
  g5_emit(cmpi(2, 1))
  g5_branch(100, $lbl + 1)
  g5_emit(cmpi(2, 2))
  g5_branch(101, $lbl + 2)
  g5_emit(ldroff(0, 1, 8))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  # G5-UTF8 : `longueur(chaine)` compte les POINTS DE CODE. Le descripteur
  # porte le nombre d'OCTETS : on dénombre les octets qui ne sont PAS des
  # continuations (0b10xxxxxx), c.-à-d. les têtes de séquence UTF-8.
  g5_mark($lbl + 1)
  g5_emit(g5_masktag(9, 1))
  g5_emit(ldroff(10, 9, 8))       # x10 = nombre d'octets
  g5_emit(movz(0, 0))             # x0 = nombre de points de code
  g5_emit(movz(11, 0))            # x11 = i (octet courant)
  g5_mark($lbl + 3)
  g5_emit(cmpr(11, 10))
  g5_branch(110, $lbl + 4)  # b.ge : i >= len -> terminé
  g5_emit(addi(7, 11, 16))          # les données commencent à +16
  g5_emit(ldrbr(12, 9, 7))
  g5_emit(cmpi(12, 128))
  g5_branch(111, $lbl + 6)          # ASCII -> tête de séquence
  g5_emit(movz(13, 128))
  g5_emit(subr(13, 12, 13))
  g5_emit(cmpi(13, 64))
  g5_branch(111, $lbl + 5)  # octet de continuation -> pas d'incrément
  g5_mark($lbl + 6)
  g5_emit(addi(0, 0, 1))
  g5_mark($lbl + 5)
  g5_emit(addi(11, 11, 1))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 2)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}

fn g5_emit_ordre($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldrbio(0, 9, 16))       # x0 = premier octet
  g5_emit(cmpi(0, 128))
  g5_branch(111, $lbl + 3)  # b.hs non pris : b0 < 128 -> 1 octet
  g5_emit(cmpi(0, 224))
  g5_branch(111, $lbl + 1)  # 128..223 -> 2 octets
  g5_emit(cmpi(0, 240))
  g5_branch(111, $lbl + 2)  # 224..239 -> 3 octets
  # 4 octets : cp = (b0-240)*262144 + (b1-128)*4096 + (b2-128)*64 + (b3-128)
  g5_emit(ldrbio(1, 9, 17)); g5_emit(subi(1, 1, 128))
  g5_emit(ldrbio(2, 9, 18)); g5_emit(subi(2, 2, 128))
  g5_emit(ldrbio(3, 9, 19)); g5_emit(subi(3, 3, 128))
  g5_load(4, 240); g5_emit(subr(0, 0, 4))
  g5_load(4, 262144); g5_emit(mulr(0, 0, 4))
  g5_load(4, 4096); g5_emit(mulr(1, 1, 4))
  g5_emit(addr(0, 0, 1))
  g5_emit(movz(4, 64)); g5_emit(mulr(2, 2, 4))
  g5_emit(addr(0, 0, 2))
  g5_emit(addr(0, 0, 3))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 1)               # 2 octets
  g5_emit(ldrbio(1, 9, 17)); g5_emit(subi(1, 1, 128))
  g5_emit(movz(4, 192)); g5_emit(subr(0, 0, 4))
  g5_emit(movz(4, 64)); g5_emit(mulr(0, 0, 4))
  g5_emit(addr(0, 0, 1))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 2)               # 3 octets
  g5_emit(ldrbio(1, 9, 17)); g5_emit(subi(1, 1, 128))
  g5_emit(ldrbio(2, 9, 18)); g5_emit(subi(2, 2, 128))
  g5_emit(movz(4, 224)); g5_emit(subr(0, 0, 4))
  g5_emit(movz(4, 4096)); g5_emit(mulr(0, 0, 4))
  g5_emit(movz(4, 64)); g5_emit(mulr(1, 1, 4))
  g5_emit(addr(0, 0, 1))
  g5_emit(addr(0, 0, 2))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 3)               # 1 octet (ASCII)
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  retour 0
}

# sous_chaine(s, a, b) — x0=s, x1=a, x2=b ; a et b sont des indices en
# POINTS DE CODE (sémantique Rose). Les octets du descripteur étant UTF-8,
# on convertit d'abord a et b en décalages OCTET en parcourant le descripteur.
fn g5_emit_sous($lbl: entier) -> entier {
  $lneg = g5_next()
  $lok = g5_next()
  g5_mark($lbl)
  g5_emit(g5_asr3(1, 1))
  g5_emit(g5_asr3(2, 2))
  g5_emit(subr(3, 2, 1))
  # SH2 : sous_chaine(a,b) avec a>b doit rendre une chaîne VIDE (len=0).
  g5_emit(cmpi(3, 0))
  g5_branch(111, $lneg)
  g5_branch(0, $lok)
  g5_emit(movz(3, 0))
  g5_branch(0, $lbl + 10)
  g5_mark($lneg)
  g5_emit(movz(3, 0))
  g5_branch(0, $lbl + 10)
  g5_mark($lok)
  g5_emit(g5_masktag(10, 0))       # x10 = pointeur source (masqué)
  g5_emit(ldroff(11, 10, 8))       # x11 = nombre d'octets
  g5_emit(orrr(12, 31, 1))         # x12 = a (indice point de code)
  g5_emit(orrr(13, 31, 2))         # x13 = b
  g5_emit(movz(14, 0))             # x14 = ci (point de code courant)
  g5_emit(movz(15, 0))             # x15 = bo (décalage octet courant)
  g5_emit(movz(16, 0))             # x16 = bo_a (décalage de a)
  g5_emit(movz(20, 0))             # x20 = drapeau « a atteint »
  g5_mark($lbl + 1)                # boucle de balayage
  g5_emit(cmpr(14, 13))
  g5_branch(110, $lbl + 2)  # ci >= b -> fin
  g5_emit(cmpr(15, 11))
  g5_branch(110, $lbl + 2)  # bo >= len -> fin (borne)
  g5_emit(cmpr(14, 12))
  g5_branch(101, $lbl + 3)  # ci != a
  g5_emit(orrr(16, 31, 15))         # bo_a = bo
  g5_emit(movz(20, 1))
  g5_mark($lbl + 3)
  g5_emit(addi(19, 15, 16))         # les données commencent à +16
  g5_emit(ldrbr(17, 10, 19))        # octet de tête
  g5_emit(cmpi(17, 128))
  g5_branch(111, $lbl + 4)  # < 128 -> 1 octet
  g5_emit(cmpi(17, 224))
  g5_branch(111, $lbl + 5)  # < 224 -> 2 octets
  g5_emit(cmpi(17, 240))
  g5_branch(111, $lbl + 6)  # < 240 -> 3 octets
  g5_emit(movz(18, 4))
  g5_branch(0, $lbl + 7)
  g5_mark($lbl + 4); g5_emit(movz(18, 1)); g5_branch(0, $lbl + 7)
  g5_mark($lbl + 5); g5_emit(movz(18, 2)); g5_branch(0, $lbl + 7)
  g5_mark($lbl + 6); g5_emit(movz(18, 3))
  g5_mark($lbl + 7)
  g5_emit(addr(15, 15, 18))         # bo += k
  g5_emit(addi(14, 14, 1))          # ci += 1
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(cmpi(20, 0))
  g5_branch(100, $lneg)             # a jamais atteint -> chaîne vide
  g5_emit(subr(3, 15, 16))          # x3 = bo - bo_a = nombre d'octets
  g5_emit(cmpi(3, 0))
  g5_branch(111, $lneg)
  g5_mark($lbl + 10)                # entrée commune d'allocation (x3 = nb octets)
  # Allocation du descripteur de la sous-chaîne (1..8 octets de données).
  g5_emit(addr(4, 3, 3))
  g5_emit(addr(4, 4, 4))
  g5_emit(addr(4, 4, 4))
  g5_emit(addi(4, 4, 24))
  g5_emit(orrr(0, 31, 4))
  g5_alloc_inline()
  g5_emit(orrr(5, 31, 0))
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 5, 0))
  g5_emit(orrr(1, 31, 3))
  g5_emit(stroff(1, 5, 8))
  g5_emit(movz(6, 0))
  g5_mark($lbl + 8)
  g5_emit(cmpr(6, 3))
  g5_branch(110, $lbl + 9)
  g5_emit(addr(7, 16, 6))
  g5_emit(addi(7, 7, 16))
  g5_emit(ldrbr(7, 10, 7))
  g5_emit(addi(4, 6, 16))
  g5_emit(strbr(7, 5, 4))
  g5_emit(addi(6, 6, 1))
  g5_branch(0, $lbl + 8)
  g5_mark($lbl + 9)
  g5_emit(g5_tag1(0, 5))
  g5_emit(RET_I())
  retour 0
}

# idx(container, i) — chaîne : 1 caractère ; liste : élément.
#
# G5-UTF8 : l'indice i est un POINT DE CODE (sémantique Rose, identique à
# celle de longueur/sous_chaine/ordre), tandis que le descripteur stocke des
# OCTETS. L'ancien code lisait l'octet à i+16 et fabriquait un descripteur
# d'1 octet : « ≈ »[0] rendait e2 au lieu de e2 89 88, et ordre() lisait des
# octets de continuation comme têtes de séquence (SIGSEGV du compilateur C0
# embarqué, qui indexe ses sources par point de code). On balaie donc le
# descripteur depuis l'octet 0 en comptant les têtes de séquence UTF-8, exactement
# comme g5_emit_sous, puis on copie les k octets du point de code visé dans un
# descripteur [tag=1][len=k][k octets]. L'ASCII (k=1) garde son comportement.
fn g5_emit_idx($lbl: entier) -> entier {
  $lscan = g5_next()              # boucle de balayage des points de code
  $lfound = g5_next()             # point de code visé atteint
  $loob = g5_next()               # hors bornes -> chaîne vide
  $ld1 = g5_next()                # décodage : 1 octet
  $ld2 = g5_next()                # décodage : 2 octets
  $ld3 = g5_next()                # décodage : 3 octets (4 octets = fall-through)
  $ldone = g5_next()              # fin du décodage (k dans x18)
  $lcopy = g5_next()              # copie des k octets
  $lcopyd = g5_next()             # fin de copie
  g5_mark($lbl)
  g5_emit(g5_masktag(6, 0))
  g5_emit(ldroff(2, 6, 0))
  g5_emit(cmpi(2, 2))
  g5_branch(100, $lbl + 1)
  # --- chaîne : indexation par point de code ---
  g5_emit(g5_asr3(7, 1))          # x7 = i (indice point de code)
  g5_emit(ldroff(11, 6, 8))       # x11 = nombre d'octets du descripteur
  g5_emit(movz(14, 0))            # x14 = ci (point de code courant)
  g5_emit(movz(15, 0))            # x15 = bo (décalage octet courant)
  g5_mark($lscan)
  g5_emit(cmpr(15, 11))           # bo >= len ?
  g5_branch(110, $loob)           # hors bornes
  # Décodage de la longueur k du point de code à bo (motif de g5_emit_sous).
  g5_emit(addi(19, 15, 16))       # les données commencent à +16
  g5_emit(ldrbr(17, 6, 19))       # octet de tête
  g5_emit(cmpi(17, 128))
  g5_branch(111, $ld1)            # < 128 -> 1 octet
  g5_emit(cmpi(17, 224))
  g5_branch(111, $ld2)            # < 224 -> 2 octets
  g5_emit(cmpi(17, 240))
  g5_branch(111, $ld3)            # < 240 -> 3 octets
  g5_emit(movz(18, 4))            # sinon 4 octets
  g5_branch(0, $ldone)
  g5_mark($ld1); g5_emit(movz(18, 1)); g5_branch(0, $ldone)
  g5_mark($ld2); g5_emit(movz(18, 2)); g5_branch(0, $ldone)
  g5_mark($ld3); g5_emit(movz(18, 3))
  g5_mark($ldone)
  g5_emit(cmpr(14, 7))            # ci == i ?
  g5_branch(100, $lfound)         # trouvé : x15=bo, x18=k
  g5_emit(addr(15, 15, 18))       # bo += k
  g5_emit(addi(14, 14, 1))        # ci += 1
  g5_branch(0, $lscan)
  g5_mark($lfound)
  # Allocation d'un descripteur [tag=1][len=k][k octets de données].
  g5_load(0, 24)
  g5_alloc_inline()               # x0 = nouveau descripteur (clobber x1,x2,x9)
  g5_emit(orrr(3, 31, 0))         # x3 = descripteur
  g5_emit(movz(4, 1))
  g5_emit(stroff(4, 3, 0))        # tag = 1
  g5_emit(orrr(4, 31, 18))
  g5_emit(stroff(4, 3, 8))        # len = k (octets)
  g5_emit(movz(16, 0))            # x16 = j
  g5_mark($lcopy)
  g5_emit(cmpr(16, 18))
  g5_branch(110, $lcopyd)         # j >= k -> copie terminée
  g5_emit(addr(19, 15, 16))       # x19 = bo + j
  g5_emit(addi(19, 19, 16))       # +16 (début des données)
  g5_emit(ldrbr(17, 6, 19))       # octet source
  g5_emit(addi(4, 16, 16))        # déstination = j + 16
  g5_emit(strbr(17, 3, 4))        # octet destination
  g5_emit(addi(16, 16, 1))
  g5_branch(0, $lcopy)
  g5_mark($lcopyd)
  g5_emit(g5_tag1(0, 3))          # x0 = descripteur | 1
  g5_emit(RET_I())
  g5_mark($loob)
  # Hors bornes : chaîne vide (comme sous_chaine sur un intervalle invalide).
  g5_load(0, 24)
  g5_alloc_inline()
  g5_emit(orrr(3, 31, 0))
  g5_emit(movz(4, 1))
  g5_emit(stroff(4, 3, 0))        # tag = 1
  g5_emit(movz(4, 0))
  g5_emit(stroff(4, 3, 8))        # len = 0
  g5_emit(g5_tag1(0, 3))
  g5_emit(RET_I())
  g5_mark($lbl + 1)
  # SH12 : cap < 0 => TABLE (lecture de la valeur associee a la cle x1).
  # Une liste a cap > 0 et suit le chemin d'indexation numerique ci-dessous.
  g5_emit(ldroff(3, 6, 16))
  g5_emit(cmpi(3, 0))
  g5_branch(111, $lbl + 3)
  g5_emit(g5_asr3(1, 1))
  g5_emit(addr(2, 1, 1))
  g5_emit(addr(2, 2, 2))
  g5_emit(addr(2, 2, 2))          # x2 = 8 * index
  g5_emit(ldroff(3, 6, 24))       # x3 = pointeur de donnees
  g5_emit(addr(2, 3, 2))          # x2 = ptr + 8*index
  g5_emit(ldroff(0, 2, 0))
  g5_emit(RET_I())
  # ── SH12 : lecture par cle dans une table ──
  g5_mark($lbl + 3)
  g5_emit(orrr(11, 31, 30))       # x11 = LR (streq ecrase x30)
  g5_emit(ldroff(12, 6, 8))       # x12 = len
  g5_emit(orrr(13, 31, 1))        # x13 = cle cherchee
  g5_emit(ldroff(14, 6, 24))      # x14 = key_ptr
  g5_emit(ldroff(15, 6, 32))      # x15 = value_ptr
  g5_emit(movz(9, 0))             # x9 = i
  g5_mark($lbl + 4)
  g5_emit(cmpr(9, 12))
  g5_branch(110, $lbl + 7)        # absent -> 0
  g5_emit(addr(8, 9, 9)); g5_emit(addr(8, 8, 8)); g5_emit(addr(8, 8, 8))
  g5_emit(addr(16, 14, 8)); g5_emit(ldroff(16, 16, 0))  # x16 = cle[i]
  g5_emit(g5_tagbits(2, 13)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lbl + 6)        # cle cherchee non-chaine
  g5_emit(g5_tagbits(2, 16)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lbl + 6)        # cle[i] non-chaine
  g5_emit(orrr(0, 31, 16)); g5_emit(orrr(1, 31, 13))
  g5_branch(1, $g5_streql)
  g5_emit(cmpi(0, 0)); g5_branch(101, $lbl + 5)  # contenu egal -> trouve
  g5_mark($lbl + 6)
  g5_emit(addr(16, 14, 8)); g5_emit(ldroff(0, 16, 0))
  g5_emit(cmpr(0, 13)); g5_branch(100, $lbl + 5)
  g5_emit(addi(9, 9, 1)); g5_branch(0, $lbl + 4)
  g5_mark($lbl + 5)
  g5_emit(addr(8, 9, 9)); g5_emit(addr(8, 8, 8)); g5_emit(addr(8, 8, 8))
  g5_emit(addr(0, 15, 8)); g5_emit(ldroff(0, 0, 0))  # valeur[i]
  g5_emit(orrr(30, 31, 11)); g5_emit(RET_I())
  g5_mark($lbl + 7)
  g5_emit(movz(0, 0)); g5_emit(orrr(30, 31, 11)); g5_emit(RET_I())
  retour 0
}

# joindre(liste, valeur) — SH3 : descripteur [tag=2][len][cap][data_ptr],
# donnees dans un bloc SEPARE. Le pointeur du descripteur ne change JAMAIS,
# donc tous les alias (appelant et appele) voient la croissance : c'est la
# semantique Rose de joindre, qui mute la liste en place.
fn g5_emit_join($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(5, 0))        # x5 = descripteur (brut)
  g5_emit(orrr(6, 31, 1))          # x6 = valeur a joindre
  g5_emit(ldroff(8, 5, 8))         # x8 = len
  g5_emit(ldroff(3, 5, 16))        # x3 = cap
  g5_emit(cmpr(8, 3))
  g5_branch(110, $lbl + 2)         # len >= cap -> reallocation
  # --- voie rapide : place disponible ---
  g5_emit(ldroff(11, 5, 24))       # x11 = ptr donnees
  g5_emit(addr(12, 8, 8)); g5_emit(addr(12, 12, 12)); g5_emit(addr(12, 12, 12))
  g5_emit(addr(14, 11, 12))        # x14 = ptr + 8*len
  g5_emit(stroff(6, 14, 0))        # ecriture de la valeur
  g5_emit(addi(8, 8, 1))
  g5_emit(stroff(8, 5, 8))         # len++
  g5_branch(0, $lbl + 5)           # B (kind 0) ; kind 1 = BL, ecrase LR
  # --- reallocation du bloc de donnees (doublement de capacite) ---
  g5_mark($lbl + 2)
  g5_emit(addr(2, 3, 3))           # x2 = 2*cap
  g5_emit(cmpi(2, 8))
  g5_branch(110, $lbl + 1)         # >= 8
  g5_emit(movz(2, 8))
  g5_mark($lbl + 1)
  g5_emit(orrr(3, 31, 2))          # x3 = nouvelle cap
  g5_emit(addr(2, 3, 3)); g5_emit(addr(2, 2, 2)); g5_emit(addr(2, 2, 2))
  g5_emit(orrr(0, 31, 2))          # taille = 8*newcap
  g5_alloc_inline()                # x0 = nouveau bloc (clobber x1,x2,x9)
  g5_emit(orrr(10, 31, 0))         # x10 = nouveau ptr
  g5_emit(ldroff(11, 5, 24))       # x11 = ancien ptr
  g5_emit(movz(12, 0))             # x12 = i
  g5_mark($lbl + 3)
  g5_emit(cmpr(12, 8))
  g5_branch(110, $lbl + 4)         # i >= len : copie terminee
  g5_emit(addr(13, 12, 12)); g5_emit(addr(13, 13, 13)); g5_emit(addr(13, 13, 13))
  g5_emit(addr(14, 11, 13)); g5_emit(ldroff(15, 14, 0))
  g5_emit(addr(14, 10, 13)); g5_emit(stroff(15, 14, 0))
  g5_emit(addi(12, 12, 1))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(addr(12, 8, 8)); g5_emit(addr(12, 12, 12)); g5_emit(addr(12, 12, 12))
  g5_emit(addr(14, 10, 12)); g5_emit(stroff(6, 14, 0))  # nouvel element
  g5_emit(addi(8, 8, 1))
  g5_emit(stroff(8, 5, 8))         # len
  g5_emit(stroff(3, 5, 16))        # cap
  g5_emit(stroff(10, 5, 24))       # ptr
  g5_mark($lbl + 5)
  g5_emit(g5_tag2(0, 5))
  g5_emit(RET_I())
  retour 0
}

# SH12 — inserer(table, cle, valeur) : stocke la PAIRE (cle, valeur) dans
# les deux tableaux paralleles du descripteur. Mutation EN PLACE (le
# pointeur du descripteur ne change jamais, comme pour joindre), donc tous
# les alias voient l'insertion. x0=table taguee, x1=cle, x2=valeur.
fn g5_emit_inser($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(5, 0))        # x5 = descripteur
  g5_emit(orrr(6, 31, 1))          # x6 = cle
  g5_emit(orrr(7, 31, 2))          # x7 = valeur
  g5_emit(ldroff(8, 5, 8))         # x8 = len
  g5_emit(ldroff(13, 5, 16))       # x13 = cap (negatif)
  g5_emit(ldroff(10, 5, 24))       # x10 = key_ptr
  g5_emit(ldroff(11, 5, 32))       # x11 = value_ptr
  g5_emit(subr(14, 31, 13))        # x14 = -cap = capacite
  g5_emit(cmpr(8, 14))
  g5_branch(110, $lbl + 1)         # len >= cap -> croissance
  # --- voie rapide : place dans les blocs existants ---
  g5_emit(addr(12, 8, 8)); g5_emit(addr(12, 12, 12)); g5_emit(addr(12, 12, 12))
  g5_emit(addr(14, 10, 12)); g5_emit(stroff(6, 14, 0))
  g5_emit(addr(14, 11, 12)); g5_emit(stroff(7, 14, 0))
  g5_emit(addi(8, 8, 1)); g5_emit(stroff(8, 5, 8))
  g5_branch(0, $lbl + 4)
  # --- croissance : doublement, un seul bloc pour les deux tableaux ---
  g5_mark($lbl + 1)
  g5_emit(addr(13, 14, 14))        # x13 = 2*capacite = newcap
  g5_emit(addr(14, 13, 13)); g5_emit(addr(14, 14, 14)); g5_emit(addr(14, 14, 14))
  g5_emit(addr(0, 14, 14))         # x14 = 8*newcap (3 doublements), total = 16*newcap
  g5_alloc_inline()                # x0 = nouveau bloc (clobber x0,x1,x2,x9)
  g5_emit(orrr(15, 31, 0))         # x15 = nouveau key_ptr
  g5_emit(addr(16, 0, 14))         # x16 = nouveau value_ptr
  g5_emit(movz(12, 0))             # i = 0
  g5_mark($lbl + 2)
  g5_emit(cmpr(12, 8))
  g5_branch(110, $lbl + 3)         # copie terminee
  g5_emit(addr(9, 12, 12)); g5_emit(addr(9, 9, 9)); g5_emit(addr(9, 9, 9))
  g5_emit(addr(17, 10, 9)); g5_emit(ldroff(17, 17, 0))
  g5_emit(addr(18, 15, 9)); g5_emit(stroff(17, 18, 0))
  g5_emit(addr(17, 11, 9)); g5_emit(ldroff(17, 17, 0))
  g5_emit(addr(18, 16, 9)); g5_emit(stroff(17, 18, 0))
  g5_emit(addi(12, 12, 1))
  g5_branch(0, $lbl + 2)
  g5_mark($lbl + 3)
  g5_emit(addr(12, 8, 8)); g5_emit(addr(12, 12, 12)); g5_emit(addr(12, 12, 12))
  g5_emit(addr(18, 15, 12)); g5_emit(stroff(6, 18, 0))
  g5_emit(addr(18, 16, 12)); g5_emit(stroff(7, 18, 0))
  g5_emit(addi(8, 8, 1)); g5_emit(stroff(8, 5, 8))
  g5_emit(subr(9, 31, 13)); g5_emit(stroff(9, 5, 16))  # nouveau cap (negatif)
  g5_emit(stroff(15, 5, 24)); g5_emit(stroff(16, 5, 32))
  g5_mark($lbl + 4)
  g5_emit(RET_I())                 # x0 = table taguee, inchangee
  retour 0
}

# SH12 — supprimer(table, cle) : retire la PAIRE dont la cle correspond.
# Recherche identique a celle de g5_emit_idx, puis decalage des entrees
# suivantes dans les deux tableaux. Cle absente : aucun effet.
fn g5_emit_suppr($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(orrr(11, 31, 30))        # x11 = LR (streq ecrase x30)
  g5_emit(g5_masktag(12, 0))       # x12 = descripteur
  g5_emit(orrr(13, 31, 1))         # x13 = cle cherchee
  g5_emit(ldroff(16, 12, 8))       # x16 = len
  g5_emit(ldroff(14, 12, 24))      # x14 = key_ptr
  g5_emit(ldroff(15, 12, 32))      # x15 = value_ptr
  g5_emit(movz(9, 0))              # x9 = i
  g5_mark($lbl + 1)                # boucle de recherche
  g5_emit(cmpr(9, 16))
  g5_branch(110, $lbl + 6)         # absent -> retour
  g5_emit(addr(8, 9, 9)); g5_emit(addr(8, 8, 8)); g5_emit(addr(8, 8, 8))
  g5_emit(addr(17, 14, 8)); g5_emit(ldroff(0, 17, 0))  # x0 = cle[i]
  g5_emit(g5_tagbits(2, 13)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lbl + 3)         # cle cherchee non-chaine -> valeur
  g5_emit(g5_tagbits(2, 0)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lbl + 3)         # cle[i] non-chaine -> valeur
  g5_emit(orrr(1, 31, 13)); g5_branch(1, $g5_streql)
  g5_emit(cmpi(0, 0)); g5_branch(101, $lbl + 2)  # trouve
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 3)                # comparaison de valeurs
  g5_emit(addr(17, 14, 8)); g5_emit(ldroff(0, 17, 0))
  g5_emit(cmpr(0, 13)); g5_branch(100, $lbl + 2)
  g5_emit(addi(9, 9, 1)); g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)                # decalage a partir de i+1
  g5_emit(addi(10, 9, 1))
  g5_mark($lbl + 4)
  g5_emit(cmpr(10, 16))
  g5_branch(110, $lbl + 5)
  g5_emit(addr(8, 10, 10)); g5_emit(addr(8, 8, 8)); g5_emit(addr(8, 8, 8))
  g5_emit(subi(18, 8, 8))          # dest = 8*(j-1)
  g5_emit(addr(17, 14, 8)); g5_emit(ldroff(17, 17, 0))
  g5_emit(addr(19, 14, 18)); g5_emit(stroff(17, 19, 0))
  g5_emit(addr(17, 15, 8)); g5_emit(ldroff(17, 17, 0))
  g5_emit(addr(19, 15, 18)); g5_emit(stroff(17, 19, 0))
  g5_emit(addi(10, 10, 1)); g5_branch(0, $lbl + 4)
  g5_mark($lbl + 5)
  g5_emit(subi(16, 16, 1)); g5_emit(stroff(16, 12, 8))  # len--
  g5_mark($lbl + 6)
  g5_emit(g5_tag2(0, 12)); g5_emit(orrr(30, 31, 11)); g5_emit(RET_I())
  retour 0
}

# entier(chaine) — conversion décimale signée.
fn g5_emit_entier($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(1, 9, 8))
  g5_emit(movz(2, 0))
  g5_emit(movz(3, 0))
  g5_emit(movz(4, 1))
  # SH2 : une chaîne vide n'a AUCUN octet de données ; la boucle décimale
  # lirait l'octet suivant le descripteur (mesuré : entier("") -> -48 quand
  # cet octet vaut 0). Retour direct de 0 (x3 deja initialise a 0).
  g5_emit(cmpi(1, 0))
  g5_branch(100, $lbl + 4)
  g5_branch(100, $lbl + 1)
  g5_emit(ldrbio(5, 9, 16))
  g5_emit(cmpi(5, 45))
  g5_branch(101, $lbl + 1)
  g5_load(4, -1)
  g5_emit(movz(2, 1))
  g5_mark($lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(cmpr(2, 1))
  g5_branch(110, $lbl + 3)
  g5_emit(addi(6, 2, 16))
  g5_emit(ldrbr(5, 9, 6))
  # SH3 : s'arreter au premier non-chiffre. Sans cela flottant("1e16")
  # ou flottant("10000000000000000.0") avalait le '.' / 'e' comme un chiffre
  # (mesure : 10000000000000000.0 -> 999999999999999980 dans le dump).
  g5_emit(cmpi(5, 48))
  g5_branch(111, $lbl + 3)        # octet < '0'
  g5_emit(cmpi(5, 57))
  g5_branch(112, $lbl + 3)        # octet > '9'
  g5_emit(subi(5, 5, 48))
  g5_emit(movz(6, 10))
  g5_emit(mulr(3, 3, 6))
  g5_emit(addr(3, 3, 5))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 2)
  g5_mark($lbl + 3)
  g5_emit(cmpi(4, 0))
  g5_branch(110, $lbl + 4)
  g5_emit(subr(3, 31, 3))
  g5_mark($lbl + 4)
  g5_emit(g5_lsl3(0, 3))
  g5_emit(RET_I())
  retour 0
}

# `chaine(x)` : chaîne taguée -> identité ; ENTier -> décimale signée exacte.
# G5-TYPE : la conversion décimale est indispensable au dump réflexif :
# emetteur.rose sérialise ses ast avec `chaine($p+1) + "|" + chaine($i)`
# (140 occurrences `(app chaine ...)` dans fp.rir). Une chaîne vide ici
# rendait le dump différent de 8ac53eed… même après correction du collision
# de labels. Scratch décimal : 0x60003800..0x60004000 (2 Kio libres entre la
# table de caractères 0x60003000+2 Kio et le tas 0x60004000).
fn g5_emit_ch($lbl: entier) -> entier {
  g5_mark($lbl)
  $lconv = g5_next()
  # ABI unique : le tag (bits bas) décide du comportement.
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 1))
  g5_branch(101, $lconv)          # b.ne : entier -> conversion
  g5_emit(RET_I())                # chaîne : identité

  g5_mark($lconv)
  $lneg    = g5_next()
  $lpos    = g5_next()
  $lcd0    = g5_next()
  $lcd1    = g5_next()
  $lzero   = g5_next()
  $lgd0    = g5_next()
  $lgd1    = g5_next()
  $lnosign = g5_next()
  $lcp0    = g5_next()
  $lcp1    = g5_next()

  # x3 = n signé, x4 = drapeau de signe
  g5_emit(g5_asr3(3, 0))
  g5_emit(movz(4, 0))
  g5_emit(cmpi(3, 0))
  g5_branch(111, $lneg)           # b.lt : négatif (kind = 100 + cond 11)
  g5_branch(0, $lpos)             # b : positif
  g5_mark($lneg)
  g5_emit(movz(4, 1))
  g5_emit(subr(3, 31, 3))         # x3 = -x3
  g5_mark($lpos)

  # x5 = nombre de chiffres décimaux
  g5_emit(movz(5, 0))
  g5_emit(orrr(6, 31, 3))
  g5_mark($lcd0)
  g5_emit(cmpi(6, 0))
  g5_branch(100, $lcd1)           # b.eq : fin comptage
  g5_emit(movz(7, 10))
  g5_emit(udivr(6, 6, 7))
  g5_emit(addi(5, 5, 1))
  g5_branch(0, $lcd0)
  g5_mark($lcd1)
  g5_emit(cmpi(5, 0))
  g5_branch(101, $lzero)          # b.ne : chiffres comptés
  g5_emit(movz(5, 1))             # n = 0 -> un chiffre
  g5_mark($lzero)

  # x10 = longueur totale = chiffres + signe
  g5_emit(addr(10, 5, 4))
  # x11 = fin du tampon scratch ; on remplit en revenant vers 0x60003800.
  g5_load(11, 1610627072)
  g5_emit(addr(11, 11, 10))
  g5_emit(orrr(6, 31, 3))

  g5_mark($lgd0)
  g5_emit(cmpi(5, 0))
  g5_branch(100, $lgd1)           # b.eq : chiffres générés
  g5_emit(movz(7, 10))
  g5_emit(udivr(1, 6, 7))         # x1 = quotient
  g5_emit(msubr(2, 1, 7, 6))      # x2 = reste = x6 - quotient*10
  g5_emit(addi(2, 2, 48))         # '0'
  g5_emit(subi(11, 11, 1))
  g5_emit(strbio(2, 11, 0))       # strb w2,[x11,#0]
  g5_emit(orrr(6, 31, 1))
  g5_emit(subi(5, 5, 1))
  g5_branch(0, $lgd0)
  g5_mark($lgd1)

  # signe '-' (0x2D) si nécessaire
  g5_emit(cmpi(4, 0))
  g5_branch(100, $lnosign)        # b.eq : pas de signe
  g5_emit(movz(2, 45))
  g5_emit(subi(11, 11, 1))
  g5_emit(strbio(2, 11, 0))
  g5_mark($lnosign)

  # x11 = premier octet, x10 = longueur -> descripteur [1][len][octets…]
  g5_emit(addi(2, 10, 7))
  g5_emit(g5_lsr3(2, 2))
  g5_emit(g5_lsl3(2, 2))
  g5_emit(addi(0, 2, 16))
  g5_alloc_inline()               # x0 = pointeur brut
  g5_emit(orrr(5, 31, 0))         # x5 = descripteur
  g5_emit(movz(2, 1))
  g5_emit(stroff(2, 5, 0))        # tag = 1
  g5_emit(stroff(10, 5, 8))       # longueur
  g5_emit(addi(7, 5, 16))         # x7 = données
  g5_emit(movz(6, 0))
  g5_mark($lcp0)
  g5_emit(cmpr(6, 10))
  g5_branch(110, $lcp1)           # b.ge : copie terminée
  g5_emit(ldrbr(2, 11, 6))        # ldrb w2,[x11,x6]
  g5_emit(strbr(2, 7, 6))         # strb w2,[x7,x6]
  g5_emit(addi(6, 6, 1))
  g5_branch(0, $lcp0)
  g5_mark($lcp1)
  g5_emit(g5_tag1(0, 5))          # orr x0,x5,#1
  g5_emit(RET_I())
  retour 0
}

# concat(a,b) — '+' sur deux chaînes. x0=a taguée, x1=b taguée.
# Renvoie une NOUVELLE chaîne taguée [tag=1][len][octets…].
fn g5_emit_cat($lbl: entier) -> entier {
  g5_mark($lbl)
  $lna = g5_next()
  $lga = g5_next()
  $lnb = g5_next()
  $lgb = g5_next()
  $lla = g5_next()
  $laa = g5_next()
  $llb = g5_next()
  $ldn = g5_next()
  g5_emit(g5_tagbits(2, 0)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lna)
  g5_emit(g5_masktag(6, 0)); g5_emit(ldroff(8, 6, 8))
  g5_branch(0, $lga)
  g5_mark($lna)
  g5_emit(movz(6, 0)); g5_emit(movz(8, 0))
  g5_mark($lga)
  g5_emit(g5_tagbits(2, 1)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lnb)
  g5_emit(g5_masktag(7, 1)); g5_emit(ldroff(11, 7, 8))
  g5_branch(0, $lgb)
  g5_mark($lnb)
  g5_emit(movz(7, 0)); g5_emit(movz(11, 0))
  g5_mark($lgb)
  g5_emit(addr(10, 8, 11))
  # Taille = 16 + 8*ceil(total/8) : l'alignement 8 est OBLIGATOIRE, sinon
  # les bits bas du pointeur servent de tag et l'allocation suivante
  # dérape hors du tas (constat : SIGSEGV sur str x1,[x4] dans joindre).
  g5_emit(addi(2, 10, 7))
  g5_emit(g5_lsr3(2, 2))
  g5_emit(g5_lsl3(2, 2))
  g5_emit(addi(2, 2, 16))
  g5_emit(orrr(0, 31, 2))
  g5_alloc_inline()
  g5_emit(orrr(5, 31, 0))
  g5_emit(movz(1, 1)); g5_emit(stroff(1, 5, 0))
  g5_emit(orrr(1, 31, 10)); g5_emit(stroff(1, 5, 8))
  g5_emit(movz(2, 0))
  g5_mark($lla)
  g5_emit(cmpr(2, 8)); g5_branch(110, $laa)
  g5_emit(addi(3, 2, 16)); g5_emit(ldrbr(4, 6, 3))
  g5_emit(strbr(4, 5, 3))
  g5_emit(addi(2, 2, 1)); g5_branch(0, $lla)
  g5_mark($laa)
  g5_emit(addi(6, 8, 16))
  g5_emit(movz(2, 0))
  g5_mark($llb)
  g5_emit(cmpr(2, 11)); g5_branch(110, $ldn)
  g5_emit(addi(3, 2, 16)); g5_emit(ldrbr(4, 7, 3))
  g5_emit(addr(3, 6, 2)); g5_emit(strbr(4, 5, 3))
  g5_emit(addi(2, 2, 1)); g5_branch(0, $llb)
  g5_mark($ldn)
  g5_emit(g5_tag1(0, 5))
  g5_emit(RET_I())
  retour 0
}

# streq(a,b) — égalité de CONTENU de deux chaînes taguées. Booléen tagué (0 ou 8).
fn g5_emit_streq($lbl: entier) -> entier {
  g5_mark($lbl)
  $lf = g5_next()
  $lt = g5_next()
  $ll = g5_next()
  g5_emit(g5_masktag(6, 0)); g5_emit(g5_masktag(7, 1))
  g5_emit(ldroff(2, 6, 8)); g5_emit(ldroff(3, 7, 8))
  g5_emit(cmpr(2, 3)); g5_branch(101, $lf)
  g5_emit(orrr(10, 31, 2))
  g5_emit(movz(2, 0))
  g5_mark($ll)
  g5_emit(cmpr(2, 10)); g5_branch(110, $lt)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 6, 3)); g5_emit(ldrbr(5, 7, 3))
  g5_emit(cmpr(4, 5)); g5_branch(101, $lf)
  g5_emit(addi(2, 2, 1)); g5_branch(0, $ll)
  g5_mark($lf)
  g5_emit(movz(0, 0)); g5_emit(RET_I())
  g5_mark($lt)
  g5_load(0, 8); g5_emit(RET_I())
  retour 0
}

# SH12 — tables REELLES (cles + valeurs).
# Descripteur : [tag=2][len][cap NEGATIF][key_ptr][value_ptr][pad]
#   +0  tag 2 (identique a une liste : cle_existe/longueur lisent +8/+24)
#   +8  len = nombre d'entrees
#   +16 cap < 0 : MARQUEUR DE TABLE. Une liste a cap > 0. g5_emit_idx
#       teste ce seul signe pour choisir "lecture par cle" ou "index".
#       La valeur absolue de cap est la capacite (8, 16, ...).
#   +24 key_ptr   : tableau de 8*x octets, cle i a 8*i
#   +32 value_ptr : tableau de 8*x octets, valeur i a 8*i
# Les deux blocs de 8 entrees sont contigus dans l'allocation initiale
# (48..111 pour les cles, 112..175 pour les valeurs = 176 octets).
fn g5_emit_table($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_load(0, 176)
  g5_alloc_inline()
  g5_load(1, 2); g5_emit(stroff(1, 0, 0))
  g5_emit(movz(1, 0)); g5_emit(stroff(1, 0, 8))
  g5_load(1, -8); g5_emit(stroff(1, 0, 16))          # cap = -8 (marqueur)
  g5_emit(addi(1, 0, 48)); g5_emit(stroff(1, 0, 24)) # key_ptr
  g5_emit(addi(1, 0, 112)); g5_emit(stroff(1, 0, 32)) # value_ptr
  g5_emit(g5_tag2(0, 0))
  g5_emit(RET_I())
  retour 0
}

# cle_existe(table, cle) -> booleen tague.
# SH4 : une cle entiere (tag 0) faisait masquer x1 en pointeur NUL puis
# appeler streq -> SIGSEGV (mesure : `inserer(t,1,10); cle_existe(t,1)`).
# On dispatchte desormais sur le tag : chaine -> comparaison de CONTENU,
# entier/booleen -> comparaison des VALEURS TAGUEES.
fn g5_emit_clex($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(orrr(11, 31, 30))       # x11 = LR (streq ecrase x30)
  g5_emit(g5_tagbits(2, 1))       # x2 = tag de la cle
  g5_emit(cmpi(2, 1))
  g5_branch(101, $lbl + 4)        # b.ne : pas une chaine -> comparaison de valeur
  # ── cle chaine : comparaison de contenu (chemin historique) ──
  g5_emit(g5_masktag(12, 0))      # x12 = table (liste de cles)
  g5_emit(g5_masktag(13, 1))      # x13 = cle (chaine)
  g5_emit(ldroff(14, 12, 8))      # x14 = len
  g5_emit(ldroff(8, 12, 24))      # x8 = pointeur de donnees
  g5_emit(movz(15, 0))            # x15 = i
  g5_mark($lbl + 1)
  g5_emit(cmpr(15, 14))
  g5_branch(110, $lbl + 2)        # i >= len : absent
  g5_emit(addr(9, 15, 15)); g5_emit(addr(9, 9, 9)); g5_emit(addr(9, 9, 9))
  g5_emit(addr(1, 8, 9)); g5_emit(ldroff(0, 1, 0))
  # SH12 : une table peut melanger les types de cles. Appeler streq sur
  # une cle ENTiere stockee masquerait x0 en pointeur NUL -> SIGSEGV
  # (mesure : inserer(t,"a",1); inserer(t,1,2); cle_existe(t,"a")).
  g5_emit(g5_tagbits(2, 0)); g5_emit(cmpi(2, 1))
  g5_branch(101, $lbl + 8)        # cle stockee non-chaine -> element suivant
  g5_emit(orrr(1, 31, 13))        # x1 = cle
  g5_branch(1, $g5_streql)        # streq(element, cle)
  g5_emit(cmpi(0, 8))
  g5_branch(100, $lbl + 3)
  g5_mark($lbl + 8)
  g5_emit(addi(15, 15, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 3)
  g5_load(0, 8)                   # vrai
  g5_emit(orrr(30, 31, 11))
  g5_emit(RET_I())
  # ── cle entiere/booleenne : comparaison des valeurs taguees ──
  g5_mark($lbl + 4)
  g5_emit(orrr(3, 31, 1))         # x3 = cle taguee (entier : n<<3)
  g5_emit(g5_masktag(12, 0))
  g5_emit(ldroff(14, 12, 8))
  g5_emit(ldroff(8, 12, 24))
  g5_emit(movz(15, 0))
  g5_mark($lbl + 5)
  g5_emit(cmpr(15, 14))
  g5_branch(110, $lbl + 2)        # absent
  g5_emit(addr(9, 15, 15)); g5_emit(addr(9, 9, 9)); g5_emit(addr(9, 9, 9))
  g5_emit(addr(1, 8, 9)); g5_emit(ldroff(0, 1, 0))
  g5_emit(cmpr(0, 3))
  g5_branch(100, $lbl + 3)        # trouve -> vrai
  g5_emit(addi(15, 15, 1))
  g5_branch(0, $lbl + 5)
  g5_mark($lbl + 2)
  g5_emit(movz(0, 0))             # faux
  g5_emit(orrr(30, 31, 11))
  g5_emit(RET_I())
  retour 0
}

# Primitives non implémentées : retour neutre (0 ou chaîne vide).
# ── SH7 : primitives C0 émises dans l'ELF ──

# C0.1 — quitter(code) : exit_group(code). x0 contient le code Rose tagué
# (n<<3) ; on le désétiquette avant le syscall. Ne revient jamais : c'est
# précisément ce qui empêche le chemin G5 de retomber dans l'ancien
# compilateur source→ELF de $principal.
fn g5_emit_quit($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0))
  g5_emit(movz(8, 93))
  g5_emit(SVC_I())
  g5_emit(RET_I())             # jamais atteint, garde-fou
  retour 0
}

# C0.2 — caractere(n) -> descripteur de chaîne [tag=1][len][UTF-8 de n].
# n est un entier Rose tagué dans x0. x10/x11 conservent le point de code et
# le nombre d'octets pendant l'allocation (g5_alloc_inline détruit x0,1,2,9).
# 1 à 4 octets tiennent dans 8 octets de données : taille fixe 24 octets.
fn g5_emit_car($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(10, 0))      # x10 = point de code brut
  g5_emit(movz(11, 1))         # x11 = nombre d'octets
  g5_emit(cmpi(10, 128))
  g5_branch(111, $lbl + 4)  # cp < 128 -> 1 octet
  g5_emit(movz(11, 2))
  g5_emit(cmpi(10, 2048))
  g5_branch(111, $lbl + 4)  # cp < 2048 -> 2 octets
  g5_emit(movz(11, 3))
  g5_load(12, 65536)
  g5_emit(cmpr(10, 12))
  g5_branch(111, $lbl + 4)  # cp < 65536 -> 3 octets
  g5_emit(movz(11, 4))
  g5_mark($lbl + 4)
  g5_load(0, 24)               # 16 octets d'en-tête + 8 de données
  g5_alloc_inline()            # x0 = pointeur brut aligné
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 0, 0))     # tag = 1 (chaîne)
  g5_emit(orrr(1, 31, 11))
  g5_emit(stroff(1, 0, 8))     # longueur = nombre d'octets UTF-8
  g5_emit(cmpi(11, 2))
  g5_branch(100, $lbl + 1)
  g5_emit(cmpi(11, 3))
  g5_branch(100, $lbl + 2)
  g5_emit(cmpi(11, 4))
  g5_branch(100, $lbl + 3)
  g5_emit(orrr(1, 31, 10))     # ASCII : l'octet est le point de code
  g5_emit(strbio(1, 0, 16))
  g5_emit(g5_tag1(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 1)            # 2 octets : 110xxxxx 10xxxxxx
  g5_emit(movz(2, 64)); g5_emit(udivr(3, 10, 2)); g5_emit(msubr(4, 3, 2, 10))
  g5_emit(addi(3, 3, 192)); g5_emit(addi(4, 4, 128))
  g5_emit(strbio(3, 0, 16)); g5_emit(strbio(4, 0, 17))
  g5_emit(g5_tag1(0, 0)); g5_emit(RET_I())
  g5_mark($lbl + 2)            # 3 octets
  g5_emit(movz(2, 4096)); g5_emit(udivr(3, 10, 2))
  g5_emit(movz(2, 64)); g5_emit(udivr(4, 10, 2))
  g5_emit(msubr(5, 4, 2, 10)); g5_emit(msubr(6, 3, 2, 4))
  g5_emit(addi(3, 3, 224)); g5_emit(addi(5, 5, 128)); g5_emit(addi(6, 6, 128))
  g5_emit(strbio(3, 0, 16)); g5_emit(strbio(6, 0, 17)); g5_emit(strbio(5, 0, 18))
  g5_emit(g5_tag1(0, 0)); g5_emit(RET_I())
  g5_mark($lbl + 3)            # 4 octets
  g5_load(2, 262144); g5_emit(udivr(3, 10, 2))
  g5_load(2, 4096); g5_emit(udivr(4, 10, 2))
  g5_emit(movz(2, 64)); g5_emit(udivr(5, 10, 2))
  g5_emit(msubr(6, 5, 2, 10)); g5_emit(msubr(7, 4, 2, 5))
  g5_load(2, 64); g5_emit(msubr(8, 3, 2, 4))
  g5_emit(addi(3, 3, 240)); g5_emit(addi(6, 6, 128))
  g5_emit(addi(7, 7, 128)); g5_emit(addi(8, 8, 128))
  g5_emit(strbio(3, 0, 16)); g5_emit(strbio(8, 0, 17))
  g5_emit(strbio(7, 0, 18)); g5_emit(strbio(6, 0, 19))
  g5_emit(g5_tag1(0, 0)); g5_emit(RET_I())
  retour 0
}

# OCTET_BRUT — octet_brut(n) -> descripteur [tag=1][len=1][1 OCTET BRUT].
# Contrairement à g5_emit_car, AUCUN encodage UTF-8 : le poids faible de n
# est écrit tel quel (strbio ne stocke que l'octet de poids faible).
# x10 conserve l'entier désétiquetté pendant g5_alloc_inline (qui détruit
# x0,x1,x2,x9). Taille fixe 24 octets, un seul label ($g5_octetll).
fn g5_emit_octetl($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(10, 0))      # x10 = entier Rose désétiquetté
  g5_load(0, 24)               # 16 octets d'en-tête + 8 de données
  g5_alloc_inline()            # x0 = pointeur brut aligné
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 0, 0))     # tag = 1 (chaîne)
  g5_emit(stroff(1, 0, 8))     # longueur = 1 octet (PAS de UTF-8)
  g5_emit(orrr(1, 31, 10))     # x1 = octet brut = n % 256
  g5_emit(strbio(1, 0, 16))    # données[0] = octet
  g5_emit(g5_tag1(0, 0))       # pointeur tagué chaîne Rose
  g5_emit(RET_I())
  retour 0
}

# C0.3 — partie_entiere(n) : sous l'ABI G5 l'argument est déjà un entier
# tronqué (le `/` de `(app partie_entiere (bin / ...))` émet un sdiv).
# On désétiquette puis on réétiquette, exactement comme le ferait un asr
# des deux opérandes suivants d'un sdiv. Le cas littéral `(f a/b)` est
# replié à l'émission dans g5_eval (voir ci-dessus).
fn g5_emit_par($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  retour 0
}

# ── SH12 : primitives C0 supplementaires (plus de stubs) ──
fn g5_emit_abs($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0))          # x0 = n brut
  g5_emit(cmpi(0, 0))
  g5_branch(110, $lbl + 1)        # n >= 0 : identite
  g5_emit(subr(0, 31, 0))         # negatif : -n
  g5_mark($lbl + 1)
  g5_emit(g5_lsl3(0, 0)); g5_emit(RET_I())
  retour 0
}

fn g5_emit_min($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0)); g5_emit(g5_asr3(1, 1))
  g5_emit(cmpr(0, 1))
  g5_branch(111, $lbl + 1)        # a < b ->garder a
  g5_emit(orrr(0, 31, 1))         # sinon prendre b
  g5_mark($lbl + 1)
  g5_emit(g5_lsl3(0, 0)); g5_emit(RET_I())
  retour 0
}

fn g5_emit_max($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0)); g5_emit(g5_asr3(1, 1))
  g5_emit(cmpr(0, 1))
  g5_branch(110, $lbl + 1)        # a >= b ->garder a
  g5_emit(orrr(0, 31, 1))         # sinon prendre b
  g5_mark($lbl + 1)
  g5_emit(g5_lsl3(0, 0)); g5_emit(RET_I())
  retour 0
}

# type(x) -> chaîne. Dispatch runtime sur le tag ABI ; les littéraux
# booléens/flottants sont traités à l'émission (ils n'ont pas de tag distinct).
fn g5_emit_type($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_tagbits(10, 0))      # x10 = tag (non clobberé par g5_make_str)
  g5_emit(cmpi(10, 1))
  g5_branch(100, $lbl + 1)
  g5_emit(cmpi(10, 2))
  g5_branch(101, $lbl + 2)
  g5_emit(g5_masktag(11, 0)); g5_emit(ldroff(11, 11, 16))  # cap
  g5_emit(cmpi(11, 0))
  g5_branch(111, $lbl + 3)        # cap < 0 -> table
  g5_make_str("liste"); g5_branch(0, $lbl + 4)
  g5_mark($lbl + 1); g5_make_str("chaine"); g5_branch(0, $lbl + 4)
  g5_mark($lbl + 2); g5_make_str("entier"); g5_branch(0, $lbl + 4)
  g5_mark($lbl + 3); g5_make_str("table")
  g5_mark($lbl + 4); g5_emit(RET_I())
  retour 0
}

# chaine(booleen) -> "vrai"/"faux". x0 = booléen tagué (0 ou 8).
fn g5_emit_chbool($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(cmpi(0, 0))
  g5_branch(100, $lbl + 1)
  g5_make_str("vrai"); g5_branch(0, $lbl + 2)
  g5_mark($lbl + 1); g5_make_str("faux")
  g5_mark($lbl + 2); g5_emit(RET_I())
  retour 0
}

# ── SH12 : RNG splitmix64 (miroir exact de rose/src/run.rs) ──
# Émet le mixage de z=x[$z] (déjà incrémenté) avec x[$a] scratch.
fn g5_emit_rng_core($z: entier, $a: entier) -> entier {
  g5_emit(lsri($a, $z, 30)); g5_emit(eorr($z, $z, $a))
  g5_emit(movz($a, 58809)); g5_emit(movk($a, 7396, 1))
  g5_emit(movk($a, 18285, 2)); g5_emit(movk($a, 48984, 3))
  g5_emit(mulr($z, $z, $a))
  g5_emit(lsri($a, $z, 27)); g5_emit(eorr($z, $z, $a))
  g5_emit(movz($a, 4587)); g5_emit(movk($a, 4913, 1))
  g5_emit(movk($a, 18875, 2)); g5_emit(movk($a, 38096, 3))
  g5_emit(mulr($z, $z, $a))
  g5_emit(lsri($a, $z, 31)); g5_emit(eorr($z, $z, $a))
  retour 0
}

# Émet un tirage : état global 0x60007000 (raw u64), résultat brut dans x0.
fn g5_emit_rng_step() -> entier {
  g5_load(9, 1610641408)          # @état
  g5_emit(ldroff(10, 9, 0))       # x10 = état
  g5_emit(movz(11, 31765)); g5_emit(movk(11, 32586, 1))
  g5_emit(movk(11, 31161, 2)); g5_emit(movk(11, 40503, 3))  # C
  g5_emit(addr(10, 10, 11))       # état += C (wrapping 64 bits)
  g5_emit(stroff(10, 9, 0))       # sauvegarde
  g5_emit(orrr(0, 31, 10))        # z = état
  g5_emit_rng_core(0, 11)
  retour 0
}

fn g5_emit_graine($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(10, 0))         # n brut
  g5_load(9, 1610641408); g5_emit(stroff(10, 9, 0))
  g5_emit_rng_step()              # graine_de() tire une fois
  g5_emit(movz(0, 0)); g5_emit(RET_I())
  retour 0
}

fn g5_emit_hasard($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(12, 0))         # x12 = n brut (bornage)
  g5_emit_rng_step()              # x0 = tirage
  g5_emit(subi(9, 12, 1)); g5_emit(andr(10, 12, 9))
  g5_emit(cmpi(10, 0))
  g5_branch(100, $lbl + 1)        # n puissance de 2 -> masque
  g5_emit(umulh(0, 0, 12))        # sinon (x*n)>>64
  g5_branch(0, $lbl + 2)
  g5_mark($lbl + 1)
  g5_emit(subi(10, 12, 1)); g5_emit(andr(0, 0, 10))
  g5_mark($lbl + 2)
  g5_emit(g5_lsl3(0, 0)); g5_emit(RET_I())
  retour 0
}

# ── G5-BIG : petits entiers <-> grands entiers ──
# Un grand entier est un descripteur [3][signe][nlimbs][limbs base 10^9…]
# (chaque limb occupe un mot 64 bits). Scratch de promotion : 0x60005000.
# x0 = valeur taguée en entrée ; x0 = pointeur|3 en sortie.
#$x4/x5 sont réservés par l'appelant et ne sont PAS touchés ici.
fn g5_emit_bigpromote($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 3))
  g5_branch(100, $lbl + 5)               # déjà un grand -> identité
  g5_emit(g5_asr3(3, 0))                 # x3 = n signé
  g5_emit(movz(6, 0))
  g5_emit(cmpi(3, 0))
  g5_branch(111, $lbl + 1)
  g5_branch(0, $lbl + 2)
  g5_mark($lbl + 1)
  g5_emit(movz(6, 1)); g5_emit(subr(3, 31, 3))
  g5_mark($lbl + 2)
  g5_load(7, 1610633216)                 # 0x60005000
  g5_emit(movz(8, 0))                    # x8 = nombre de limbs
  g5_mark($lbl + 3)
  g5_load(2, 1000000000)
  g5_emit(udivr(9, 3, 2))                # x9 = quotient
  g5_emit(msubr(10, 9, 2, 3))            # x10 = reste
  g5_emit(stroff(10, 7, 0))
  g5_emit(addi(7, 7, 8)); g5_emit(addi(8, 8, 1)); g5_emit(orrr(3, 31, 9))
  g5_emit(cmpi(3, 0))
  g5_branch(101, $lbl + 3)               # boucle au moins une fois (0 -> 1 limb)
  g5_emit(movz(0, 8)); g5_emit(mulr(0, 8, 0)); g5_emit(addi(0, 0, 24))
  g5_alloc_inline()                      # x0 = descripteur
  g5_emit(movz(2, 3)); g5_emit(stroff(2, 0, 0))
  g5_emit(stroff(6, 0, 8)); g5_emit(stroff(8, 0, 16))
  g5_load(2, 1610633216)
  g5_emit(addi(3, 0, 24))
  g5_emit(orrr(9, 31, 8))
  g5_mark($lbl + 4)
  g5_emit(cmpi(9, 0)); g5_branch(100, $lbl + 5)
  g5_emit(ldroff(10, 2, 0)); g5_emit(stroff(10, 3, 0))
  g5_emit(addi(2, 2, 8)); g5_emit(addi(3, 3, 8)); g5_emit(subi(9, 9, 1))
  g5_branch(0, $lbl + 4)
  g5_mark($lbl + 5)
  g5_emit(g5_tag1(0, 0)); g5_emit(g5_tag2(0, 0)); g5_emit(RET_I())
  retour 0
}

# Addition signée de deux grands entiers. x1 = gauche, x0 = droite,
# x0 = résultat (pointeur|3) au retour. Base 10^9, retenue/emprunt 0/1.
fn g5_emit_bigadd($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(orrr(4, 31, 1)); g5_emit(orrr(5, 31, 0))
  g5_emit(g5_masktag(6, 4)); g5_emit(g5_masktag(7, 5))
  g5_emit(ldroff(8, 6, 8)); g5_emit(ldroff(10, 7, 8))    # signes
  g5_emit(ldroff(11, 6, 16)); g5_emit(ldroff(12, 7, 16)) # effectifs
  g5_emit(cmpr(8, 10))
  g5_branch(101, $lbl + 12)              # signes opposés -> soustraction
  # ── même signe : addition des magnitudes ──
  g5_emit(orrr(13, 31, 11))              # x13 = n = max(nA,nB)
  g5_emit(cmpr(11, 12)); g5_branch(110, $lbl + 2)
  g5_emit(orrr(13, 31, 12))
  g5_mark($lbl + 2)
  g5_emit(addi(3, 13, 1)); g5_emit(movz(0, 8)); g5_emit(mulr(3, 3, 0))
  g5_emit(addi(0, 3, 24))
  g5_alloc_inline()
  g5_emit(orrr(14, 31, 0))               # x14 = résultat
  g5_emit(movz(0, 3)); g5_emit(stroff(0, 14, 0))
  g5_emit(stroff(8, 14, 8))
  g5_emit(addi(0, 6, 24)); g5_emit(addi(1, 7, 24)); g5_emit(addi(2, 14, 24))
  g5_emit(movz(3, 0)); g5_emit(movz(15, 0))
  g5_mark($lbl + 3)
  g5_emit(cmpr(3, 13)); g5_branch(110, $lbl + 10)
  g5_emit(cmpr(3, 11)); g5_branch(110, $lbl + 4)
  g5_emit(ldroff(9, 0, 0)); g5_branch(0, $lbl + 5)
  g5_mark($lbl + 4); g5_emit(movz(9, 0))
  g5_mark($lbl + 5)
  g5_emit(cmpr(3, 12)); g5_branch(110, $lbl + 6)
  g5_emit(ldroff(10, 1, 0)); g5_branch(0, $lbl + 7)
  g5_mark($lbl + 6); g5_emit(movz(10, 0))
  g5_mark($lbl + 7)
  g5_emit(addr(9, 9, 10)); g5_emit(addr(9, 9, 15))
  g5_load(10, 1000000000); g5_emit(cmpr(9, 10))
  g5_branch(111, $lbl + 8)               # somme < base -> pas de retenue
  g5_emit(subr(9, 9, 10)); g5_emit(movz(15, 1)); g5_branch(0, $lbl + 9)
  g5_mark($lbl + 8); g5_emit(movz(15, 0))
  g5_mark($lbl + 9); g5_emit(stroff(9, 2, 0))
  g5_emit(addi(0, 0, 8)); g5_emit(addi(1, 1, 8)); g5_emit(addi(2, 2, 8)); g5_emit(addi(3, 3, 1))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 10)
  g5_emit(cmpi(15, 0)); g5_branch(100, $lbl + 11)
  g5_emit(movz(0, 1)); g5_emit(stroff(0, 2, 0)); g5_emit(addi(13, 13, 1))
  g5_mark($lbl + 11)
  g5_emit(stroff(13, 14, 16))
  g5_emit(g5_tag1(0, 14)); g5_emit(g5_tag2(0, 0)); g5_emit(RET_I())
  # ── signes opposés : choisir la plus grande magnitude ──
  g5_mark($lbl + 12)
  g5_emit(cmpr(11, 12))
  g5_branch(100, $lbl + 15)              # effectifs égaux -> comparer limbs
  g5_branch(110, $lbl + 14)              # nA > nB -> A dominant
  g5_mark($lbl + 13)                     # B dominant
  g5_emit(orrr(0, 31, 5)); g5_emit(orrr(1, 31, 4))
  g5_emit(orrr(8, 31, 10)); g5_emit(orrr(11, 31, 12))
  g5_branch(0, $lbl + 21)
  g5_mark($lbl + 14)                     # A dominant
  g5_emit(orrr(0, 31, 4)); g5_emit(orrr(1, 31, 5))
  g5_branch(0, $lbl + 21)
  g5_mark($lbl + 15)
  # Comparer par le limb DE POIDS FORT : le premier écart décroissant est
  # le bon. (Une comparaison du limb faible au fort donnait 2^64 < 2^63,
  # car 709551616 < 854775808 — mesuré sur t212/t232.)
  # x10 contient le signe de B : ne PAS l'écraser ici (x6 est libre, il est
  # recalculé par masktag dans la soustraction). Le clobber rendait
  # `-2^63 + 2^64` = -2^63 au lieu de +2^63 (t212).
  g5_emit(addi(0, 6, 24)); g5_emit(addi(1, 7, 24)); g5_emit(movz(6, 1))
  g5_mark($lbl + 33)
  g5_emit(cmpr(6, 11)); g5_branch(110, $lbl + 34)
  g5_emit(addi(0, 0, 8)); g5_emit(addi(1, 1, 8)); g5_emit(addi(6, 6, 1))
  g5_branch(0, $lbl + 33)
  g5_mark($lbl + 34)
  g5_emit(orrr(3, 31, 11))
  g5_mark($lbl + 16)
  g5_emit(cmpi(3, 0)); g5_branch(100, $lbl + 20)   # tous égaux
  g5_emit(ldroff(9, 0, 0)); g5_emit(ldroff(7, 1, 0))   # x7 = limb B ; x10 = signe B, préservé
  g5_emit(cmpr(9, 7)); g5_branch(100, $lbl + 17)
  g5_branch(111, $lbl + 18)              # a < b -> B dominant
  g5_branch(0, $lbl + 19)                # a > b -> A dominant
  g5_mark($lbl + 17)
  g5_emit(subi(0, 0, 8)); g5_emit(subi(1, 1, 8)); g5_emit(subi(3, 3, 1))
  g5_branch(0, $lbl + 16)
  g5_mark($lbl + 18); g5_branch(0, $lbl + 13)
  g5_mark($lbl + 19); g5_branch(0, $lbl + 14)
  g5_mark($lbl + 20); g5_branch(0, $lbl + 14)
  # ── soustraction : x0=dominant, x1=dominé, x8=signe, x11=n ──
  g5_mark($lbl + 21)
  g5_emit(g5_masktag(6, 0)); g5_emit(g5_masktag(7, 1))
  g5_emit(ldroff(12, 7, 16))
  g5_emit(movz(0, 8)); g5_emit(mulr(0, 11, 0)); g5_emit(addi(0, 0, 24))
  g5_alloc_inline()
  g5_emit(orrr(14, 31, 0))
  g5_emit(movz(0, 3)); g5_emit(stroff(0, 14, 0)); g5_emit(stroff(8, 14, 8))
  g5_emit(addi(0, 6, 24)); g5_emit(addi(1, 7, 24)); g5_emit(addi(2, 14, 24))
  g5_emit(movz(3, 0)); g5_emit(movz(15, 0))
  g5_mark($lbl + 22)
  g5_emit(cmpr(3, 11)); g5_branch(110, $lbl + 23)
  g5_emit(ldroff(9, 0, 0))
  g5_emit(cmpr(3, 12)); g5_branch(110, $lbl + 24)
  g5_emit(ldroff(10, 1, 0)); g5_branch(0, $lbl + 25)
  g5_mark($lbl + 24); g5_emit(movz(10, 0))
  g5_mark($lbl + 25)
  g5_emit(subr(9, 9, 10)); g5_emit(subr(9, 9, 15))
  g5_emit(cmpi(9, 0)); g5_branch(110, $lbl + 26)
  g5_load(10, 1000000000); g5_emit(addr(9, 9, 10)); g5_emit(movz(15, 1))
  g5_branch(0, $lbl + 27)
  g5_mark($lbl + 26); g5_emit(movz(15, 0))
  g5_mark($lbl + 27); g5_emit(stroff(9, 2, 0))
  g5_emit(addi(0, 0, 8)); g5_emit(addi(1, 1, 8)); g5_emit(addi(2, 2, 8)); g5_emit(addi(3, 3, 1))
  g5_branch(0, $lbl + 22)
  g5_mark($lbl + 23)
  g5_emit(orrr(13, 31, 11))
  g5_emit(addi(2, 14, 24)); g5_emit(movz(10, 1))   # &limb[n-1] : n-1 pas depuis &limb[0]
  g5_mark($lbl + 28)                     # avancer jusqu'au limb de poids fort
  g5_emit(cmpr(10, 13)); g5_branch(110, $lbl + 29)
  g5_emit(addi(2, 2, 8)); g5_emit(addi(10, 10, 1)); g5_branch(0, $lbl + 28)
  g5_mark($lbl + 29)
  g5_mark($lbl + 30)                     # élaguer les limbs nuls de tête
  g5_emit(cmpi(13, 1)); g5_branch(113, $lbl + 31)
  g5_emit(ldroff(9, 2, 0)); g5_emit(cmpi(9, 0)); g5_branch(101, $lbl + 31)
  g5_emit(subi(2, 2, 8)); g5_emit(subi(13, 13, 1)); g5_branch(0, $lbl + 30)
  g5_mark($lbl + 31)
  g5_emit(ldroff(9, 2, 0)); g5_emit(cmpi(9, 0)); g5_branch(101, $lbl + 32)
  g5_emit(movz(0, 0)); g5_emit(stroff(0, 14, 8))      # zéro -> signe 0
  g5_mark($lbl + 32)
  g5_emit(stroff(13, 14, 16))
  g5_emit(g5_tag1(0, 14)); g5_emit(g5_tag2(0, 0)); g5_emit(RET_I())
  retour 0
}

# ── G5-BIG : négation d'un grand entier ──
# x0 = valeur taguée en entrée et sortie. Petit entier : 0-x suffit (n<<3).
# Grand : on ALLOUE une copie du descripteur [3][signe][nlimbs][limbs…] avec
# le signe inversé (0<->1) — jamais de mutation de l'original (alias).
# x0/x1/x2/x9 sont clobberés par g5_alloc_inline : on préserve dans x6/x7/x8.
# Labels internes : +1 (copie des limbs), +2 (fin), +3 (voie petit entier).
fn g5_emit_bigneg($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_tagbits(2, 0))
  g5_emit(cmpi(2, 3)); g5_branch(101, $lbl + 3)    # pas tag 3 -> 0-x
  g5_emit(g5_masktag(6, 0))                       # x6 = descripteur source
  g5_emit(ldroff(7, 6, 16))                       # x7 = nlimbs
  g5_emit(ldroff(8, 6, 8))                        # x8 = signe
  g5_emit(addi(4, 7, 1)); g5_emit(movz(2, 8)); g5_emit(mulr(4, 4, 2))
  g5_emit(addi(0, 4, 24))
  g5_alloc_inline()                               # x0 = nouveau descripteur
  g5_emit(orrr(10, 31, 0))                        # x10 = destination
  g5_emit(movz(1, 3)); g5_emit(stroff(1, 10, 0))
  g5_emit(movz(11, 1)); g5_emit(eorr(1, 8, 11)); g5_emit(stroff(1, 10, 8))
  g5_emit(stroff(7, 10, 16))
  g5_emit(addi(3, 6, 24)); g5_emit(addi(4, 10, 24)); g5_emit(movz(5, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(5, 7)); g5_branch(110, $lbl + 2)
  g5_emit(ldroff(1, 3, 0)); g5_emit(stroff(1, 4, 0))
  g5_emit(addi(3, 3, 8)); g5_emit(addi(4, 4, 8)); g5_emit(addi(5, 5, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(g5_tag1(0, 10)); g5_emit(g5_tag2(0, 0)); g5_emit(RET_I())
  g5_mark($lbl + 3)
  g5_emit(subr(0, 31, 0)); g5_emit(RET_I())
  retour 0
}

# ── G5-BIG : comparaison signée de deux grands entiers ──
# x1 = gauche, x0 = droite (tagués en entrée). Les deux sont promus :
# bigpromote alloue un descripteur sur le tas pour chacun (le scratch à
# 0x60005000 n'est utilisé que transitoirement), x4/x5 préservés.
# Sortie : x0 = signe de (gauche - droite), VALEUR BRUTE -1/0/+1 (non taguée).
# L'appelant applique ensuite `cmpi x0,#0 ; cset x0,<cond> ; lsl x0,#3`.
# Comparaison : signe d'abord (0=positif,1=négatif : signe$A<signe$B => A>B),
# puis magnitudes des limbs du POIDS FORT (n-1) vers le faible (0), en
# traitant les limbs absents (i>=nlimbs) comme zéro.
# Labels internes : +1 magnitudes, +2/+3 signes divergents, +4 boucle,
# +5/+6 limb A nul/pas nul, +7/+8 limb B, +9 limb égal, +10 a<b, +11 fin,
# +12 signes négatifs (inversion du résultat).
fn g5_emit_bigcmp($lbl: entier) -> entier {
  g5_mark($lbl)
  # Routine-feuille appelée par BL : x30 doit survivre aux DEUX appels BL
  # imbriqués vers bigpromote. bigpromote écrase x0/x1/x2/x3/x6..x10 (son
  # g5_alloc_inline clobbre x1), donc on pose LR sur la PILE, pas en registre.
  g5_emit(subi(31, 31, 16)); g5_emit(stroff(30, 31, 0))
  g5_emit(orrr(4, 31, 1)); g5_emit(orrr(5, 31, 0))
  g5_emit(orrr(0, 31, 5)); g5_branch(1, $g5_bigprol); g5_emit(orrr(5, 31, 0))
  g5_emit(orrr(0, 31, 4)); g5_branch(1, $g5_bigprol); g5_emit(orrr(4, 31, 0))
  g5_emit(g5_masktag(6, 4)); g5_emit(g5_masktag(7, 5))
  g5_emit(ldroff(8, 6, 8)); g5_emit(ldroff(9, 7, 8))       # signes
  g5_emit(ldroff(10, 6, 16)); g5_emit(ldroff(11, 7, 16))   # effectifs
  g5_emit(cmpr(8, 9))
  g5_branch(100, $lbl + 1)               # même signe -> magnitudes
  g5_branch(111, $lbl + 2)               # signeA < signeB -> A > B -> +1
  g5_load(0, -1); g5_emit(ldroff(30, 31, 0)); g5_emit(addi(31, 31, 16)); g5_emit(RET_I())  # signeA > signeB -> -1
  g5_mark($lbl + 2)
  g5_emit(movz(0, 1)); g5_emit(ldroff(30, 31, 0)); g5_emit(addi(31, 31, 16)); g5_emit(RET_I())
  g5_mark($lbl + 1)
  g5_emit(orrr(12, 31, 10))
  g5_emit(cmpr(10, 11)); g5_branch(110, $lbl + 3)
  g5_emit(orrr(12, 31, 11))
  g5_mark($lbl + 3)
  # x13/x14 = &limb[n-1] (base + 24 + 8*(n-1)), x15 = INDEX i (n-1..0).
  # Ne PAS confondre l'index (comparé à nlimbs) et le déplacement en octets !
  g5_emit(subi(15, 12, 1))                       # x15 = n-1 (index)
  g5_emit(movz(2, 8)); g5_emit(mulr(2, 15, 2))   # x2 = 8*(n-1) (octets)
  g5_emit(addi(13, 6, 24)); g5_emit(addr(13, 13, 2))
  g5_emit(addi(14, 7, 24)); g5_emit(addr(14, 14, 2))
  g5_emit(movz(0, 0))
  g5_mark($lbl + 4)
  g5_emit(cmpi(15, 0)); g5_branch(111, $lbl + 11)          # i < 0 -> fin
  g5_emit(cmpr(15, 10)); g5_branch(110, $lbl + 5)
  g5_emit(ldroff(2, 13, 0)); g5_branch(0, $lbl + 6)
  g5_mark($lbl + 5); g5_emit(movz(2, 0))
  g5_mark($lbl + 6)
  g5_emit(cmpr(15, 11)); g5_branch(110, $lbl + 7)
  g5_emit(ldroff(3, 14, 0)); g5_branch(0, $lbl + 8)
  g5_mark($lbl + 7); g5_emit(movz(3, 0))
  g5_mark($lbl + 8)
  g5_emit(cmpr(2, 3)); g5_branch(100, $lbl + 9)            # limbs égaux
  g5_branch(111, $lbl + 10)                               # a < b -> -1
  g5_emit(movz(0, 1)); g5_branch(0, $lbl + 11)             # a > b -> +1
  g5_mark($lbl + 10); g5_load(0, -1); g5_branch(0, $lbl + 11)
  g5_mark($lbl + 9)
  g5_emit(subi(13, 13, 8)); g5_emit(subi(14, 14, 8)); g5_emit(subi(15, 15, 1))
  g5_branch(0, $lbl + 4)
  g5_mark($lbl + 11)
  g5_emit(cmpi(8, 0)); g5_branch(101, $lbl + 12)          # négatifs -> inverser
  g5_emit(ldroff(30, 31, 0)); g5_emit(addi(31, 31, 16)); g5_emit(RET_I())
  g5_mark($lbl + 12)
  g5_emit(subr(0, 31, 0)); g5_emit(ldroff(30, 31, 0)); g5_emit(addi(31, 31, 16)); g5_emit(RET_I())
  retour 0
}

fn g5_emit_stub0($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}
fn g5_emit_stubs($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_load(0, 24)
  g5_alloc_inline()
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 0, 0))
  g5_emit(movz(1, 0))
  g5_emit(stroff(1, 0, 8))
  g5_emit(g5_tag1(0, 0))
  g5_emit(RET_I())
  retour 0
}

# ── G5-IO : routines ÉMISES dans l'ELF (syscalls aarch64, svc #0) ──
# Cartographie mémoire RW (page à 0x60000000) :
#   0x60000000  pointeur libre du tas (démarre à 0x60000300)
#   0x60000010  argc brut de la pile initiale
#   0x60000018  adresse de argv[0] sur la pile initiale
#   0x60000020  tampon de chemin (480 octets, NUL terminal)
#   0x60000200  tampon struct stat (144 octets, st_size à +48)
#   0x60000300  table d'internement des chaînes (512 × 16 = 0x2000)
#   0x60002400  arguments d'index >= 30 (zone SH2/SH3)
#   0x60003000  table d'internement des caractères (256 × 8 = 0x800)
#   0x60003800  scratch décimal (2 Kio, écriture décroissante)
#   0x60004000  GLOBALES G5 : 512 × 8 octets, index = slot $principal
#   0x60008000  début du tas (allocations des descripteurs)
# Couches syscalls vérifiées : openat=56, close=57, read=63, write=64, fstat=80.

# nb_arguments() -> argc utilisateur (argc ELF - 1), entier tagué.
fn g5_emit_nbargs($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_load(9, 1610612752)
  g5_emit(ldroff(0, 9, 0))
  g5_emit(subi(0, 0, 1))
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 1)
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  g5_mark($lbl + 1)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}

# argument(i) -> argv[i+1] copié en chaîne taguée [tag=1][len][octets].
fn g5_emit_argument($lbl: entier) -> entier {
  g5_mark($lbl)
  # SH6 : garde de borne. Sans elle, argument(i) avec i >= nb_arguments()
  # lisait argv[i+1] hors de la pile initiale (rc=139). Rose natif écrit
  # « Rose : erreur — index hors des limites des arguments » sur stderr
  # et quitting avec rc=1 (mesuré octet pour octet, em dash U+2014 + '\n').
  g5_emit(g5_asr3(2, 0))           # x2 = i brut
  g5_load(9, 1610612752)           # argc brut (avec argv[0]) à 0x60000010
  g5_emit(ldroff(3, 9, 0))
  g5_emit(subi(3, 3, 1))           # argc utilisateur = argc brut - 1
  g5_emit(cmpi(2, 0))
  g5_branch(111, $lbl + 5)         # i < 0 -> erreur
  g5_emit(cmpr(2, 3))
  g5_branch(110, $lbl + 5)         # i >= argc -> erreur
  g5_emit(g5_asr3(0, 0))
  g5_emit(addi(0, 0, 1))
  g5_load(9, 1610612760)
  g5_emit(ldroff(9, 9, 0))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(addr(6, 9, 0))
  g5_emit(ldroff(6, 6, 0))
  # strlen -> x7
  g5_emit(movz(7, 0))
  g5_mark($lbl + 1)
  g5_emit(ldrbr(2, 6, 7))
  g5_emit(cmpi(2, 0))
  g5_branch(100, $lbl + 2)
  g5_emit(addi(7, 7, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(addi(0, 7, 7))
  g5_emit(g5_lsr3(0, 0))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(addi(0, 0, 16))
  g5_alloc_inline()
  g5_emit(orrr(10, 31, 0))
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 10, 0))
  g5_emit(orrr(1, 31, 7))
  g5_emit(stroff(1, 10, 8))
  g5_emit(movz(2, 0))
  g5_mark($lbl + 3)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 4)
  g5_emit(ldrbr(4, 6, 2))
  g5_emit(addi(3, 2, 16))
  g5_emit(strbr(4, 10, 3))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(g5_tag1(0, 10))
  g5_branch(0, $lbl + 6)           # saut par-dessus la voie d'erreur
  g5_mark($lbl + 5)
  g5_puts2("Rose : erreur ")
  # Le tiret cadratin (U+2014) est écrit en trois octets UTF-8 explicites :
  # g5_make_str le réduirait à 0x14 etbourrerait le descripteur de NUL.
  g5_emit(movz(1, 226)); g5_emit(strbio(1, 31, 64))
  g5_emit(movz(1, 128)); g5_emit(strbio(1, 31, 65))
  g5_emit(movz(1, 148)); g5_emit(strbio(1, 31, 66))
  g5_emit(movz(0, 2))
  g5_emit(addi(1, 31, 64))
  g5_emit(movz(2, 3))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_puts2(" index hors des limites des arguments\n")
  g5_emit(movz(0, 1))              # exit(1)
  g5_emit(movz(8, 93))
  g5_emit(SVC_I())
  g5_mark($lbl + 6)
  g5_emit(RET_I())
  retour 0
}

# lire_texte(chemin) -> openat + fstat + read + close, chaîne taguée.
fn g5_emit_lire($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(7, 9, 8))
  g5_load(6, 1610612768)
  g5_emit(movz(2, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 2)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 9, 3))
  g5_emit(strbr(4, 6, 2))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(movz(5, 0))
  g5_emit(strbr(5, 6, 2))
  # openat(AT_FDCWD=-100, chemin, O_RDONLY=0, 0) = 56
  g5_load(0, -100)
  g5_load(1, 1610612768)
  g5_emit(movz(2, 0))
  g5_emit(movz(3, 0))
  g5_emit(movz(8, 56))
  g5_emit(SVC_I())
  g5_emit(orrr(10, 31, 0))
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 9)
  # fstat(fd, tampon) = 80 ; st_size à +48
  g5_emit(orrr(0, 31, 10))
  g5_load(1, 1610613248)
  g5_emit(movz(8, 80))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 9)
  g5_load(11, 1610613248 + 48)
  g5_emit(ldroff(7, 11, 0))
  g5_emit(addi(0, 7, 7))
  g5_emit(g5_lsr3(0, 0))
  g5_emit(g5_lsl3(0, 0))
  g5_emit(addi(0, 0, 16))
  g5_alloc_inline()
  g5_emit(orrr(11, 31, 0))
  g5_emit(movz(6, 0))
  g5_mark($lbl + 3)
  g5_emit(cmpr(6, 7))
  g5_branch(110, $lbl + 4)
  g5_emit(addi(1, 11, 16))
  g5_emit(addr(1, 1, 6))
  g5_emit(orrr(0, 31, 10))
  g5_emit(movz(8, 63))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(100, $lbl + 4)
  g5_branch(111, $lbl + 4)
  g5_emit(addr(6, 6, 0))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(orrr(0, 31, 10))
  g5_emit(movz(8, 57))
  g5_emit(SVC_I())
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 11, 0))
  g5_emit(orrr(1, 31, 6))
  g5_emit(stroff(1, 11, 8))
  g5_emit(g5_tag1(0, 11))
  g5_emit(RET_I())
  g5_mark($lbl + 9)
  g5_load(0, 16)
  g5_alloc_inline()
  g5_emit(movz(1, 1))
  g5_emit(stroff(1, 0, 0))
  g5_emit(movz(1, 0))
  g5_emit(stroff(1, 0, 8))
  g5_emit(g5_tag1(0, 0))
  g5_emit(RET_I())
  retour 0
}

# ecrire_bytes / ecrire_texte(chemin, donnees) -> openat(O_WRONLY|O_CREAT|O_TRUNC)
# + write + close. Renvoie `vide` (0 tagué), comme la primitive Rose.
fn g5_emit_ecrire($lbl: entier) -> entier {
  g5_mark($lbl)
  # x1 = données ; openat utilisera x1 pour le chemin : le préserver dans x11.
  g5_emit(orrr(11, 31, 1))
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(7, 9, 8))
  g5_load(6, 1610612768)
  g5_emit(movz(2, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 2)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 9, 3))
  g5_emit(strbr(4, 6, 2))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(movz(5, 0))
  g5_emit(strbr(5, 6, 2))
  # 577 = O_WRONLY(1)|O_CREAT(64)|O_TRUNC(512) ; 420 = 0644
  g5_load(0, -100)
  g5_load(1, 1610612768)
  g5_load(2, 577)
  g5_load(3, 420)
  g5_emit(movz(8, 56))
  g5_emit(SVC_I())
  g5_emit(orrr(10, 31, 0))
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 6)
  g5_emit(g5_masktag(9, 11))
  g5_emit(ldroff(7, 9, 8))
  g5_emit(addi(1, 9, 16))
  g5_emit(movz(6, 0))
  g5_mark($lbl + 3)
  g5_emit(cmpr(6, 7))
  g5_branch(110, $lbl + 4)
  g5_emit(orrr(0, 31, 10))
  g5_emit(subr(2, 7, 6))
  g5_emit(movz(8, 64))
  g5_emit(SVC_I())
  g5_emit(cmpi(0, 0))
  g5_branch(111, $lbl + 4)
  g5_emit(orrr(4, 31, 0))
  g5_emit(addr(1, 1, 4))
  g5_emit(addr(6, 6, 4))
  g5_branch(0, $lbl + 3)
  g5_mark($lbl + 4)
  g5_emit(orrr(0, 31, 10))
  g5_emit(movz(8, 57))
  g5_emit(SVC_I())
  g5_mark($lbl + 6)
  g5_emit(movz(0, 0))
  g5_emit(RET_I())
  retour 0
}

# ── J4 : routines G5 des syscalls mmap / mprotect / chmod / execve ──
# ABI Rose : tous les arguments entiers arrivent TAGUÉS (n<<3) ; on les
# désétiquette avec asr #3 avant le syscall, et on retague x0 avec lsl #3.
# Les chaînes arrivent sous forme de descripteur [tag=1][len][octets…].
# Le tampon de chemin RW 0x60000020 (480 o) est réutilisé pour fchmodat/execve,
# exactement comme g5_emit_lire le fait pour openat. Le tableau argv/envp
# est posé dans le trou RW libre 0x60005000..0x60008000 (les globales G5
# s'arrêtent à 0x60005000).

# mmap(addr, len, prot, flags, fd, off) -> adresse taguée, ou -errno tagué.
fn g5_emit_mmap($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0))
  g5_emit(g5_asr3(1, 1))
  g5_emit(g5_asr3(2, 2))
  g5_emit(g5_asr3(3, 3))
  g5_emit(g5_asr3(4, 4))
  g5_emit(g5_asr3(5, 5))
  g5_emit(movz(8, 222))
  g5_emit(SVC_I())
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  retour 0
}

# mprotect(addr, len, prot) -> 0 tagué, ou -errno tagué.
fn g5_emit_mprotect($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_asr3(0, 0))
  g5_emit(g5_asr3(1, 1))
  g5_emit(g5_asr3(2, 2))
  g5_emit(movz(8, 226))
  g5_emit(SVC_I())
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  retour 0
}

# chmod(chemin, mode) -> 0 tagué, ou -errno tagué.
# $lbl+1 = copie du chemin, $lbl+2 = NUL terminal.
fn g5_emit_chmod($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))          # x9 = descripteur chaîne
  g5_emit(ldroff(7, 9, 8))           # x7 = longueur
  g5_load(6, 1610612768)             # x6 = 0x60000020 (tampon chemin)
  g5_emit(movz(2, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 2)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 9, 3))
  g5_emit(strbr(4, 6, 2))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(movz(5, 0))
  g5_emit(strbr(5, 6, 2))            # NUL terminal
  g5_emit(g5_asr3(2, 1))             # x2 = mode brut
  g5_load(0, -100)                   # x0 = AT_FDCWD
  g5_load(1, 1610612768)             # x1 = chemin NUL-terminé
  g5_emit(movz(3, 0))                # x3 = flags = 0
  # aarch64 n'a PAS de syscall chmod : asm-generic fournit fchmodat=53
  # (fchmod=52). `chmod` est le nom Rose, fchmodat l'appel noyau réel.
  g5_emit(movz(8, 53))
  g5_emit(SVC_I())
  g5_emit(g5_lsl3(0, 0))
  g5_emit(RET_I())
  retour 0
}

# execve(chemin) -> ne revient PAS en cas de succès ; -errno tagué sinon.
# argv[0] = chemin, argv[1] = NULL ; envp[0] = NULL (environnement vide).
fn g5_emit_execve($lbl: entier) -> entier {
  g5_mark($lbl)
  g5_emit(g5_masktag(9, 0))
  g5_emit(ldroff(7, 9, 8))
  g5_load(6, 1610612768)             # x6 = 0x60000020 (tampon chemin)
  g5_emit(movz(2, 0))
  g5_mark($lbl + 1)
  g5_emit(cmpr(2, 7))
  g5_branch(110, $lbl + 2)
  g5_emit(addi(3, 2, 16))
  g5_emit(ldrbr(4, 9, 3))
  g5_emit(strbr(4, 6, 2))
  g5_emit(addi(2, 2, 1))
  g5_branch(0, $lbl + 1)
  g5_mark($lbl + 2)
  g5_emit(movz(5, 0))
  g5_emit(strbr(5, 6, 2))            # NUL terminal
  g5_load(3, 1610633216)             # x3 = 0x60005000 (argv)
  g5_emit(stroff(6, 3, 0))           # argv[0] = chemin
  g5_emit(stroff(5, 3, 8))           # argv[1] = NULL
  g5_emit(stroff(5, 3, 16))          # envp[0] = NULL
  g5_emit(orrr(0, 31, 6))            # x0 = chemin
  g5_emit(orrr(1, 31, 3))            # x1 = argv
  g5_emit(addi(2, 3, 16))            # x2 = envp
  g5_emit(movz(8, 221))
  g5_emit(SVC_I())
  g5_emit(g5_lsl3(0, 0))             # -errno si échec
  g5_emit(RET_I())
  retour 0
}

fn g5_patch() -> liste<entier> {
  $out = [0 : entier]
  $i = 0
  tant_que ($i < longueur($g5_code)) {
    $m = $g5_meta[$i]
    si ($m == "") {
      joindre($out, $g5_code[$i])
    } sinon {
      $bar = g4_pos($m, "|")
      $l = g4_entier_ou_zero(g5_sub($m, 1, $bar))
      $kind = g4_entier_ou_zero(g5_sub($m, $bar + 1, longueur($m)))
      $t = g5_labelidx($l)
      $off = $t - $i
      si ($kind == 0) { joindre($out, 335544320 + g5_wrap($off, 67108864))
      } sinon si ($kind == 1) { joindre($out, 2483027968 + g5_wrap($off, 67108864))
      } sinon { joindre($out, 1409286144 + g5_wrap($off, 524288) * 32 + ($kind - 100)) }
    }
    $i = $i + 1
  }
  retour $out
}

# SH7 : assemblage par paires. Rose natif a une concaténation structurelle
# O(1), mais le runtime G5 de l'ELF généré COPIE à chaque `+` (g5_emit_cat).
# 134 000 appels à `$out = $out + u32le(...)` étaient donc O(n²) : mesuré
# épuisement du tas (8 Gio) avant le moindre octet sur /dev/stdout. On
# fusionne les morceaux deux par deux : O(n log n) copies, mémoire ~2× la
# taille finale. Les octets produits sont strictement identiques.
# HOST-2 — base de la liste DEDUITE DU NOMBRE DE MORCEAUX.
# Mesure (em_diag5 sur verif.rir, 180 574 o) : `ELF0 n=0` — apres un gros
# travail, le litteral `[""]` de g5_elf() donne une liste VIDE (pas de
# sentinelle). L'ancien g5_assemble sautait systematiquement l'index 0 :
# il ecartait donc exactement le magic de 8 octets (455 368 au lieu de
# 455 376). Inversement, forcer la base a 0 fait tourner la reduction en
# boucle quand le sentinelle EST present (n=3 a chaque passe).
# On ne devine plus : $attendu est le nombre de joindre reels effectues par
# g5_elf(), donc base = longueur($parts) - $attendu (0 ou 1), et on
# reclacule cette base a chaque passe avec le nombre de morceaux restants.
fn g5_assemble($parts: liste<chaine>, $attendu: entier) -> chaine {
  $n = longueur($parts)
  $base = $n - $attendu
  si ($attendu < 1) { retour "" }
  tant_que ($attendu > 1) {
    $next = [""]
    $i = $base
    tant_que ($i + 1 < $n) {
      joindre($next, $parts[$i] + $parts[$i + 1])
      $i = $i + 2
    }
    si ($i < $n) { joindre($next, $parts[$i]) }
    $parts = $next
    $attendu = partie_entiere(($attendu + 1) / 2)
    $n = longueur($parts)
    $base = $n - $attendu
  }
  retour $parts[$base]
}

fn g5_elf() -> chaine {
  $base = 4194304
  $heap = 1610612736
  $code_off = 176
  $fsz = $code_off + 4 * longueur($g5_code)
  $parts = [""]
  joindre($parts, caractere(127) + "ELF" + caractere(2) + caractere(1) + caractere(1) + caractere(0))
  $z = 0
  tant_que ($z < 8) { joindre($parts, caractere(0)); $z = $z + 1 }
  joindre($parts, u16le(2) + u16le(183) + u32le(1))
  joindre($parts, u64le($base + $code_off) + u64le(64) + u64le(0) + u32le(0))
  joindre($parts, u16le(64) + u16le(56) + u16le(2) + u16le(0) + u16le(0) + u16le(0))
  joindre($parts, u32le(1) + u32le(5))
  joindre($parts, u64le(0) + u64le($base) + u64le($base))
  joindre($parts, u64le($fsz) + u64le($fsz) + u64le(4096))
  joindre($parts, u32le(1) + u32le(6))
  joindre($parts, u64le(0) + u64le($heap) + u64le($heap))
  # SH3 : la compilation réflexive de emetteur.rose (155 Kio de source)
  # consomme plus de 1 Gio de descripteurs (concaténations O(n²) du writer
  # RIR). Mesuré : 512 Mio et 1 Gio -> SIGSEGV, 2 Gio -> rc=0.
  # SH7 : la compilation de emetteur_elf.rose par le binaire GÉNÉRÉ épuisait
  # les 2 Gio ; le mapping est porté à 8 Gio et l'assemblage ci-dessus rend
  # cette réserve largement suffisante.
  # C1.3 (orchestrateur 21/11): l'auto-compilation de e_final.rir (301903 o)
  # deplace le pointeur de tas a ~0x260000008 (~10 Gio) sous le mapping de
  # 8 Gio -> SIGSEGV dans g5_make_str (str x1,[x5] avec x5=0x260000008).
  # Passe a 32 Gio de VIRTUEL (toujours paresseux, RSS inchangee ~120 Mio) :
  # mesure avec E1_32g.elf patché: ./E1_32g.elf e_final.rir -> rc=0, ELF 428832 o.
  # AZZ (20/11) : avec les routines G5-BIG, l'auto-compilation consomme ~80 Gio
  # de tas (pointeur 0x1296320880 mesuré en fin de compilation). 32 Gio puis
  # 64 Gio insuffisants (SIGSEGV rejoué aux deux bornes) : 128 Gio VIRTUEL.
  joindre($parts, u64le(0) + u64le(137438953472) + u64le(4096))
  # G5-ASM : on ne donne PAS un morceau par mot de code a g5_assemble.
  # Sous le runtime G5, `+` COPIE (contrairement au Rust heberge), et la
  # reduction par paires alloue ~2x le nombre de morceaux x la taille finale
  # par passe. Avec ~178 000 mots de code, cela montait a 32,8 Gio de RSS
  # mesures (415 Mio juste avant g5_elf, 32 807 Mio apres). On pre-assemble
  # donc 32 mots par morceau : ~5 600 morceaux seulement, soit ~32x moins de
  # copies dans la reduction. Les octets emis sont strictement identiques.
  $nchunks = 0
  $i = 0
  tant_que ($i < longueur($g5_code)) {
    $chunk = ""
    $j = 0
    tant_que ($j < 32 et $i + $j < longueur($g5_code)) {
      $chunk = $chunk + u32le($g5_code[$i + $j])
      $j = $j + 1
    }
    joindre($parts, $chunk)
    $nchunks = $nchunks + 1
    $i = $i + 32
  }
  # 1 magic + 8 NUL + 9 en-tetes = 18 morceaux fixes, puis un par bloc de 32 mots.
  retour g5_assemble($parts, 18 + $nchunks)
}
# verifieur.rose — jalon M4.2 : le vérificateur auto-hébergé ROSE.
#
# Lit le programme passé en argument et reproduit la chaîne du moteur :
# lexage, analyse descendante (AST en pools de nœuds plats), repli de
# constantes, vérification de types. Affiche « vérifié » si le vérificateur
# accepte ; sinon recopie le message exact de l'oracle `rose verif`
# (« Rose : erreur — [Ligne L, Colonne 0] message »). Validation :
# rose-cpp/tests/verifieur.py — 49 fichiers acceptés + 51 rejets de
# rose-cpp/tests/verifs/, identiques à l'oracle octet pour octet.
#
# DISCIPLINES (M4.0/M4.1) : pas de courts-circuits (tout index dangereux est
# abrité) ; aucune globale visible des fonctions (tout voyage en paramètre) ;
# listes rembourrées à l'index 0 (le vérificateur refuse []) ; on ne peut que
# joindre — les pools sont construits en post-ordre, un indice de nœud n'est
# jamais réécrit. Erreurs : liste partagée $err — la première gagne, les
# appels suivants passent à vide (garde d'entrée partout).
#
# Pools de nœuds : listes parallèles, le nœud i est à la position i+1.
# Champs : genre (lit/ch/bol/v/lst/idx/uni/fac/app/bin), texte brut, drapeau
# flottant, indices gauche/droite, arguments (pool $al, départ $as, nombre
# $ac), ligne. Instructions : aff/lire/affi/si/tq/pour/retour/expr/bloc, nom,
# deux expressions, deux corps (indices séparés par des virgules), ligne.
# Types encodés « base|élément ».

# ══════════════════ lexage — utilitaires miroir ══════════════════

fn vf_est_chiffre(c: entier) -> booleen {
  retour c >= 48 et c <= 57
}

fn vf_est_lettre(c: entier) -> booleen {
  si (c < 128) {
    retour (c >= 65 et c <= 90) ou (c >= 97 et c <= 122) ou c == 95
  }
  retour (c >= 192 et c <= 214) ou (c >= 216 et c <= 246) ou (c >= 248 et c <= 767) ou (c >= 880 et c <= 1279) ou (c >= 7680 et c <= 8191)
}

fn vf_est_suite(c: entier) -> booleen {
  si (c < 128) {
    retour vf_est_lettre(c) ou vf_est_chiffre(c)
  }
  retour vf_est_lettre(c)
}

fn vf_paire(a: entier, b: entier) -> chaine {
  si (a == 60 et b == 61) { retour "<=" }
  si (a == 62 et b == 61) { retour ">=" }
  si (a == 61 et b == 61) { retour "==" }
  si (a == 33 et b == 61) { retour "!=" }
  si (a == 47 et b == 61) { retour "!=" }
  si (a == 63 et b == 61) { retour "≈" }
  si (a == 61 et b == 126) { retour "≈" }
  si (a == 126 et b == 61) { retour "≈" }
  retour ""
}

fn vf_uni(c: entier) -> chaine {
  si (c == 8776) { retour "≈" }
  si (c == 8804) { retour "<=" }
  si (c == 8805) { retour ">=" }
  si (c == 8800) { retour "!=" }
  si (c == 215) { retour "*" }
  si (c == 8901) { retour "*" }
  si (c == 183) { retour "*" }
  si (c == 247) { retour "div" }
  si (c == 8592) { retour "=" }
  si (c == 8594) { retour "->" }
  si (c == 8730) { retour "racine" }
  retour ""
}

fn vf_car(c: entier) -> chaine {
  si (c == 43) { retour "+" }
  si (c == 45) { retour "-" }
  si (c == 42) { retour "*" }
  si (c == 47) { retour "/" }
  si (c == 58) { retour ":" }
  si (c == 37) { retour "%" }
  si (c == 94) { retour "^" }
  si (c == 33) { retour "!" }
  si (c == 46) { retour "." }
  si (c == 44) { retour "," }
  si (c == 63) { retour "?" }
  si (c == 40) { retour "(" }
  si (c == 41) { retour ")" }
  si (c == 123) { retour "{" }
  si (c == 125) { retour "}" }
  si (c == 91) { retour "[" }
  si (c == 93) { retour "]" }
  si (c == 59) { retour ";" }
  si (c == 60) { retour "<" }
  si (c == 62) { retour ">" }
  si (c == 126) { retour "~" }
  si (c == 64) { retour "@" }
  retour ""
}

# ——— lectureurs de la table de jetons (claqués sur l'eof) ———

fn vf_T0($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn vf_VX0($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn vf_T1($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p + 1
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn vf_VX1($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p + 1
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn vf_GL0($gl: liste<entier>, $p: entier) -> entier {
  $n = longueur($gl)
  $q = $p
  si ($q >= $n) { $q = $n - 1 }
  retour $gl[$q]
}

fn vf_EMOT($g: liste<chaine>, $x: liste<chaine>, $p: entier, $m: chaine) -> booleen {
  $t = vf_T0($g, $p)
  retour ($t == "ident" ou $t == "mot") et vf_VX0($x, $p) == $m
}

# ——— décodage du couple « position|nœud » (les nœuds sont des entiers ici) ———

fn vf_SEPR($r: chaine) -> entier {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour entier(sous_chaine($r, 0, $q))
}

fn vf_NOD($r: chaine) -> chaine {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour sous_chaine($r, $q + 1, $n)
}

# ══════════════════ types « base|élément » ══════════════════

fn vf_nomty($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  $base = sous_chaine($v, 0, $k)
  $elt = sous_chaine($v, $k + 1, $n)
  si ($base != "liste") { retour $base }
  si ($elt == "liste") { retour "liste<liste<vide>>" }
  retour "liste<" + $elt + ">"
}

fn vf_BASE($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour sous_chaine($v, 0, $k)
}

fn vf_tyb($b: chaine) -> chaine {
  retour $b + "|vide"
}

fn vf_estnum($t: chaine) -> booleen {
  $b = vf_BASE($t)
  retour $b == "entier" ou $b == "rationnel" ou $b == "flottant"
}

fn vf_contient_barre($v: chaine) -> booleen {
  $n = longueur($v)
  $k = 0
  $trouve = 0
  tant_que ($k < $n) {
    si (ordre($v[$k]) == 47) { $trouve = 1 }
    $k = $k + 1
  }
  retour $trouve == 1
}

fn vf_rangd($b: chaine) -> entier {
  si ($b == "booleen") { retour 0 }
  si ($b == "entier") { retour 1 }
  si ($b == "rationnel") { retour 2 }
  si ($b == "flottant") { retour 3 }
  retour -1
}

fn vf_promote($u1: chaine, $u2: chaine) -> chaine {
  $b1 = $u1
  $n1 = longueur($b1)
  $k1 = 0
  $ok1 = 1
  tant_que ($ok1 == 1) {
    si ($k1 >= $n1) { $ok1 = 0 }
    sinon si (ordre($b1[$k1]) == 124) { $ok1 = 0 }
    sinon { $k1 = $k1 + 1 }
  }
  $b1 = sous_chaine($u1, 0, $k1)
  $b2 = $u2
  $n2 = longueur($b2)
  $k2 = 0
  $ok2 = 1
  tant_que ($ok2 == 1) {
    si ($k2 >= $n2) { $ok2 = 0 }
    sinon si (ordre($b2[$k2]) == 124) { $ok2 = 0 }
    sinon { $k2 = $k2 + 1 }
  }
  $b2 = sous_chaine($u2, 0, $k2)
  $r1 = vf_rangd($b1)
  $r2 = vf_rangd($b2)
  $r = $r1
  si ($r2 > $r) { $r = $r2 }
  si ($r <= 1) { retour "entier|vide" }
  si ($r == 2) { retour "rationnel|vide" }
  retour "flottant|vide"
}

# ══════════════════ morceaux de chaînes (, et ;) ══════════════════

fn vf_piece($s: chaine, $sep: entier, $k: entier) -> chaine {
  $n = longueur($s)
  $j = 0
  $no = 1
  $buf = ""
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) {
      si ($no == $k) { retour $buf }
      $no = $no + 1
      $buf = ""
    }
    sinon { $buf = $buf + $s[$j] }
    $j = $j + 1
  }
  si ($no == $k) { retour $buf }
  retour ""
}

fn vf_nb_pieces($s: chaine, $sep: entier) -> entier {
  si ($s == "") { retour 0 }
  $n = longueur($s)
  $j = 0
  $c = 0
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) { $c = $c + 1 }
    $j = $j + 1
  }
  retour $c + 1
}

# ══════════════════ arithmétique rationnelle exacte (repli) ══════════════════
# L'entier Rose est à précision arbitraire (GMP côté moteur) : le repli est
# EXACT sans bignum dédié — fraction « p » ou « p/q », dénominateur > 0,
# réduite, zéro sous la forme « 0 » — canonicalisation mpq miroir.

fn vf_vabs($x: entier) -> entier {
  si ($x < 0) { retour 0 - $x }
  retour $x
}

fn vf_pgcd2($a: entier, $b: entier) -> entier {
  $x = vf_vabs($a + 0)
  $y = vf_vabs($b + 0)
  tant_que ($y > 0) {
    $r = $x % $y
    $x = $y
    $y = $r
  }
  retour $x
}

fn vf_rpui($b: entier, $e: entier) -> entier {
  $res = 1
  $k = 0
  tant_que ($k < $e) {
    $res = $res * $b
    $k = $k + 1
  }
  retour $res
}

fn vf_rnum($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour entier(sous_chaine($t, 0, $k))
}

fn vf_rden($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour 1 }
  retour entier(sous_chaine($t, $k + 1, $n))
}

# zéro rationnel : tous les chiffres du numérateur sont des « 0 »
fn vf_rnul($t: chaine) -> booleen {
  $n = longueur($t)
  $k = 0
  $ok = 1
  $rien = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon si (ordre($t[$k]) != 48) { $ok = 0; $rien = 0 }
    sinon { $k = $k + 1 }
  }
  retour $rien == 1
}

fn vf_rnorm($p: entier, $q: entier) -> chaine {
  $np = $p
  $nq = $q
  si ($nq < 0) { $np = 0 - $np; $nq = 0 - $nq }
  si ($np == 0) { retour "0" }
  $g = vf_pgcd2($np + 0, $nq + 0)
  si ($g > 1) { $np = $np div $g; $nq = $nq div $g }
  si ($nq == 1) { retour chaine($np) }
  retour chaine($np) + "/" + chaine($nq)
}

# ══════════════════ erreurs et environnements ══════════════════
# $err : liste partagée, la première erreur gagne ; toute fonction gardée
# rend la main à vide dès qu'elle est pleine (miroir de l'exception C++).

fn vf_signaler($lg: entier, $msg: chaine, $err: liste<chaine>) {
  si (longueur($err) == 1) {
    $s = "Rose : erreur — "
    si ($lg > 0) { $s = $s + "[Ligne " + chaine($lg) + ", Colonne 0] " }
    joindre($err, $s + $msg)
  }
}

fn vf_reserver($nom: chaine, $lg: entier, $err: liste<chaine>) {
  $n = longueur($nom)
  si ($n > 1 et ordre($nom[0]) == 116) {
    $chiffres = 1
    $k = 1
    tant_que ($k < $n) {
      si ($chiffres == 1) {
        $c = ordre($nom[$k])
        si ($c < 48 ou $c > 57) { $chiffres = 0 }
      }
      $k = $k + 1
    }
    si ($chiffres == 1) { vf_signaler($lg, "Le nom '" + $nom + "' est réservé par le moteur", $err) }
  }
}

fn vf_env_get($nom: chaine, $vn: liste<chaine>, $vt: liste<chaine>) -> chaine {
  $j = longueur($vn) - 1
  tant_que ($j >= 1) {
    si ($vn[$j] == $nom) { retour $vt[$j] }
    $j = $j - 1
  }
  retour ""
}

fn vf_env_put($nom: chaine, $ty: chaine, $vn: liste<chaine>, $vt: liste<chaine>) {
  joindre($vn, $nom)
  joindre($vt, $ty)
}

# ══════════════════ appendeurs de pools ══════════════════
# Post-ordre strict : le nœud est ajouté quand ses enfants existent déjà ;
# indice = longueur - 1 après l'ajout (listes rembourrées).

fn vf_noeud8($k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $kd: chaine, $t: chaine, $f: chaine,
          $ga: entier, $gb: entier, $sa: entier, $ca: entier, $l: entier) -> entier {
  joindre($k, $kd)
  joindre($tx, $t)
  joindre($tf, $f)
  joindre($a, $ga)
  joindre($b, $gb)
  joindre($as, $sa)
  joindre($ac, $ca)
  joindre($lg, $l)
  retour longueur($k) - 1
}

fn vf_inoeud7($ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
           $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
           $kd: chaine, $no: chaine, $e1: entier, $e2: entier,
           $b1: chaine, $b2: chaine, $l: entier) -> entier {
  joindre($ik, $kd)
  joindre($ino, $no)
  joindre($ie, $e1)
  joindre($ie2, $e2)
  joindre($ib1, $b1)
  joindre($ib2, $b2)
  joindre($ilg, $l)
  retour longueur($ik) - 1
}

# module::nom est stocké « module;nom » (les identifiants ne portent jamais « ; »)
fn vf_eclate_mod($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour "" }
  retour sous_chaine($t, 0, $k)
}

fn vf_eclate_nom($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour $t }
  retour sous_chaine($t, $k + 1, $n)
}

# ══════════════════ types et noms (parseur) ══════════════════

fn vf_nomid($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  retour chaine($p + 1) + "|" + vf_VX0($x, $p)
}

# type annoté : « pos|base|élément » — Ty::liste ne garde que la base de
# l'élément (miroir de la plie M4.1)
fn vf_typex($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  $r = vf_nomid($g, $x, $p)
  $q = vf_SEPR($r)
  $t = vf_NOD($r)
  si ($t == "liste") {
    si (vf_T0($g, $q) == "<") { $q = $q + 1 }
    $d = vf_typex($g, $x, $q)
    $q = vf_SEPR($d)
    $iv = vf_NOD($d)
    si (vf_T0($g, $q) == ">") { $q = $q + 1 }
    $m = longueur($iv)
    $k = 0
    $trouve = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($k >= $m) { $ok = 0 }
      sinon si (ordre($iv[$k]) == 124) { $ok = 0; $trouve = 1 }
      sinon { $k = $k + 1 }
    }
    $base_int = $iv
    si ($trouve == 1) { $base_int = sous_chaine($iv, 0, $k) }
    retour chaine($q) + "|liste|" + $base_int
  }
  retour chaine($q) + "|" + $t + "|vide"
}

# ══════════════════ expressions — descente vers les pools ══════════════════
# Toute fonction rend « pos|indice » ; l'indice est décimal (jamais de « | »).

fn vf_atom($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = vf_T0($g, $p)
  $l = vf_GL0($gl, $p)
  si ($t == "nombre") {
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", vf_VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "flottant") {
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", vf_VX0($x, $p), "1", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "chaine") {
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "ch", vf_VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "[") {
    # arguments d'abord dans un tampon local (frais par cadre recursive),
    # vidange contiguë vers le pool $al a la fermeture du nœud
    $col = [-1]
    $nc = 0
    $q = $p + 1
    si (vf_T1($g, $p) != "]") {
      $ok = 1
      tant_que ($ok == 1) {
        $r = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        joindre($col, entier(vf_NOD($r)))
        $nc = $nc + 1
        $q = vf_SEPR($r)
        si (vf_T0($g, $q) == ",") { $q = $q + 1 } sinon { $ok = 0 }
      }
    }
    # [0 : type] : liste vide typée (M2.4). front.rs:1904 type l'expression
    # `Ty::liste(elt)` : le vérificateur doit en faire autant. Un élément
    # factice de bon type porte l'inférence ; le défaut reste « 0 » entier.
    si ($nc == 1 et $col[1] >= 0 et $k[$col[1]] == "lit" et $tx[$col[1]] == "0" et vf_T0($g, $q) == ":") {
      $ty0 = vf_VX0($x, $q + 1)
      $q = $q + 1
      $q = $q + 1
      si (vf_T0($g, $q) == "]") { $q = $q + 1 }
      $z = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0", "", -1, -1, 0, 0, $l)
      si ($ty0 == "chaine") { $z = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "ch", "", "", -1, -1, 0, 0, $l) }
      joindre($al, $z)
      $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lst", "", "", -1, -1, longueur($al) - 1, 1, $l)
      retour chaine($q) + "|" + chaine($i)
    }
    si (vf_T0($g, $q) == "]") { $q = $q + 1 }
    $sa = longueur($al)
    $u = 1
    tant_que ($u <= $nc) {
      joindre($al, $col[$u])
      $u = $u + 1
    }
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lst", "", "", -1, -1, $sa, $nc, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "(") {
    $r = vf_expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($r)
    si (vf_T0($g, $q) == ")") { $q = $q + 1 }
    retour chaine($q) + "|" + vf_NOD($r)
  }
  si (vf_VX0($x, $p) == "vrai") {
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "1", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (vf_VX0($x, $p) == "faux") {
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "0", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (vf_T1($g, $p) == "::") {
    $mod = vf_VX0($x, $p)
    $nom = vf_VX1($x, $p + 1)
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, longueur($al), 0, $l)
    retour chaine($p + 3) + "|" + chaine($i)
  }
  si (vf_T0($g, $p) == "mot" et vf_VX0($x, $p) == "i") {
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "cplx", "i", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "v", vf_VX0($x, $p), "", -1, -1, 0, 0, $l)
  retour chaine($p + 1) + "|" + chaine($i)
}

fn vf_can_nud($k: liste<chaine>, $ac: liste<entier>, $e: entier) -> booleen {
  $kk = $k[$e]
  si ($kk == "v") { retour vrai }
  retour $kk == "app" et $ac[$e] == 0
}

fn vf_post($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = vf_atom($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = vf_T0($g, $q)
    si ($t == "(" et vf_can_nud($k, $ac, $e)) {
      $lp = vf_GL0($gl, $q)
      $tx0 = $tx[$e]
      $mod = vf_eclate_mod($tx0)
      $nom = vf_eclate_nom($tx0)
      $q = $q + 1
      $col = [-1]
      $nc = 0
      si (vf_T0($g, $q) != ")") {
        $v2 = 1
        tant_que ($v2 == 1) {
          $rr = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          joindre($col, entier(vf_NOD($rr)))
          $nc = $nc + 1
          $q = vf_SEPR($rr)
          si (vf_T0($g, $q) == ",") { $q = $q + 1 } sinon { $v2 = 0 }
        }
      }
      si (vf_T0($g, $q) == ")") { $q = $q + 1 }
      $sa = longueur($al)
      $u = 1
      tant_que ($u <= $nc) {
        joindre($al, $col[$u])
        $u = $u + 1
      }
      $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, $sa, $nc, $lp)
    }
    sinon si ($t == "[") {
      $lb = vf_GL0($gl, $q)
      $q = $q + 1
      si (vf_T0($g, $q) == ":") {
        # s[:b] et s[:] — sucre miroir : sous_chaine(s, 0, b)
        $q = $q + 1
        $fin = -1
        si (vf_T0($g, $q) == "]") {
          joindre($al, $e)
          $fin = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
        }
        sinon {
          $rr = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          $fin = entier(vf_NOD($rr))
          $q = vf_SEPR($rr)
        }
        joindre($al, $e)
        $z = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0", "", -1, -1, 0, 0, $lb)
        joindre($al, $z)
        joindre($al, $fin)
        $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
        si (vf_T0($g, $q) == "]") { $q = $q + 1 }
      }
      sinon {
        $rr = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        $ix = entier(vf_NOD($rr))
        $q = vf_SEPR($rr)
        si (vf_T0($g, $q) == ":") {
          # s[a:b] et s[a:] — sucre miroir
          $q = $q + 1
          $fin = -1
          si (vf_T0($g, $q) == "]") {
            joindre($al, $e)
            $fin = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
          }
          sinon {
            $r3 = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
            $fin = entier(vf_NOD($r3))
            $q = vf_SEPR($r3)
          }
          joindre($al, $e)
          joindre($al, $ix)
          joindre($al, $fin)
          $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
          si (vf_T0($g, $q) == "]") { $q = $q + 1 }
        }
        sinon {
          $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "idx", "", "", $e, $ix, 0, 0, $lb)
          si (vf_T0($g, $q) == "]") { $q = $q + 1 }
        }
      }
    }
    sinon { $ok = 0 }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn vf_unai($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = vf_T0($g, $p)
  $l = vf_GL0($gl, $p)
  si ($t == "racine") {
    $r = vf_unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($r)
    $d = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0.5", "1", -1, -1, 0, 0, $l)
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", entier(vf_NOD($r)), $d, 0, 0, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "-") {
    $r = vf_unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "-", "", entier(vf_NOD($r)), -1, 0, 0, $l)
    retour chaine(vf_SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "+") {
    retour vf_unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  }
  # préfixe !n = sous-factorielle (type entier, comme factorielle)
  si ($t == "sfact") {
    $r = vf_unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $lf = vf_GL0($gl, $p)
    $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "fac", "", "", entier(vf_NOD($r)), -1, 0, 0, $lf)
    retour chaine(vf_SEPR($r)) + "|" + chaine($e)
  }
  $r = vf_post($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $tt = vf_T0($g, $q)
    si ($tt == "multifacto" ou $tt == "diese" ou $tt == "terminal" ou $tt == "superfacto" ou $tt == "!") {
      $lf = vf_GL0($gl, $q)
      $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "fac", "", "", $e, -1, 0, 0, $lf)
      $q = $q + 1
    } sinon { $ok = 0 }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn vf_puis($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = vf_unai($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  si (vf_T0($g, $q) == "^") {
    $lo = vf_GL0($gl, $q)
    $d = vf_puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", $e, entier(vf_NOD($d)), 0, 0, $lo)
    retour chaine(vf_SEPR($d)) + "|" + chaine($i)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn vf_prod($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = vf_puis($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = vf_T0($g, $q)
    $op = ""
    si ($t == "*" ou $t == "/" ou $t == "%" ou $t == "div") { $op = $t }
    si ($t == "ident" et vf_VX0($x, $q) == "div") { $op = "div" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = vf_GL0($gl, $q)
      $d = vf_puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(vf_NOD($d)), 0, 0, $lo)
      $q = vf_SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn vf_somme($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = vf_prod($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = vf_T0($g, $q)
    $op = ""
    si ($t == "+") { $op = "+" }
    si ($t == "-") { $op = "-" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = vf_GL0($gl, $q)
      $d = vf_prod($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(vf_NOD($d)), 0, 0, $lo)
      $q = vf_SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn vf_compa($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = vf_somme($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = vf_T0($g, $q)
    $op = ""
    si ($t == "<" ou $t == "<=" ou $t == ">" ou $t == ">=" ou $t == "==" ou $t == "!=" ou $t == "≈" ou $t == "?=" ou $t == "=~") { $op = $t }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = vf_GL0($gl, $q)
      $d = vf_somme($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(vf_NOD($d)), 0, 0, $lo)
      $q = vf_SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn vf_nonx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  si (vf_EMOT($g, $x, $p, "non")) {
    retour vf_nonx_helper($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  }
  retour vf_compa($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
}

fn vf_nonx_helper($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
       $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
       $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $l = vf_GL0($gl, $p)
  $r = vf_nonx($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $i = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "non", "", entier(vf_NOD($r)), -1, 0, 0, $l)
  retour chaine(vf_SEPR($r)) + "|" + chaine($i)
}

# « et »/« ou » : le nœud porte la ligne du PREMIER jeton de l'opérande
# droit (miroir exact de neo(voir().ligne) après consommation).

fn vf_etx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
       $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
       $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = vf_nonx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  tant_que (vf_EMOT($g, $x, $q, "et")) {
    $lo = vf_GL0($gl, $q + 1)
    $d = vf_nonx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "et", "", $e, entier(vf_NOD($d)), 0, 0, $lo)
    $q = vf_SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn vf_expr1($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = vf_etx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = vf_SEPR($r)
  $e = entier(vf_NOD($r))
  tant_que (vf_EMOT($g, $x, $q, "ou")) {
    $lo = vf_GL0($gl, $q + 1)
    $d = vf_etx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = vf_noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "ou", "", $e, entier(vf_NOD($d)), 0, 0, $lo)
    $q = vf_SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

# ══════════════════ instructions — pool + corps en chaînes d'indices ══════════════════
# Un corps est la chaîne des indices de ses instructions de premier niveau,
# séparées par « , » ; les instructions imbriquées vivent dans le même pool,
# ajoutées AVANT leur parent (post-ordre), donc hors de la chaîne du parent.

fn vf_instruction($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $t = vf_T0($g, $p)
  $l = vf_GL0($gl, $p)
  si ($t == "{") {
    $c = vf_bloc($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "bloc", "", -1, -1, vf_NOD($c), "", $l)
    retour chaine(vf_SEPR($c)) + "|" + chaine($i)
  }
  si ($t == ">>") {
    $r = vf_expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "aff", "", entier(vf_NOD($r)), -1, "", "", $l)
    retour chaine(vf_SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "<<") {
    $rn = vf_nomid($g, $x, $p + 1)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "lire", vf_NOD($rn), -1, -1, "", "", $l)
    retour chaine(vf_SEPR($rn)) + "|" + chaine($i)
  }
  si ($t == "?") {
    $q = $p + 1
    si (vf_T0($g, $q) == "(") { $q = $q + 1 }
    $r = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($r)
    si (vf_T0($g, $q) == ")") { $q = $q + 1 }
    $c = vf_corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(vf_NOD($r)), -1, vf_NOD($c), "", $l)
    retour chaine(vf_SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "@") {
    $q = $p + 1
    si (vf_T0($g, $q) == "(") { $q = $q + 1 }
    $r = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($r)
    si (vf_T0($g, $q) == ")") { $q = $q + 1 }
    $c = vf_corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(vf_NOD($r)), -1, vf_NOD($c), "", $l)
    retour chaine(vf_SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et vf_VX0($x, $p) == "si") {
    $q = $p + 1
    si (vf_T0($g, $q) == "(") { $q = $q + 1 }
    $r = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($r)
    si (vf_T0($g, $q) == ")") { $q = $q + 1 }
    $c = vf_bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $q = vf_SEPR($c)
    $corps1 = vf_NOD($c)
    $corps2 = ""
    si (vf_EMOT($g, $x, $q, "sinon")) {
      si (vf_T0($g, $q + 1) == "{") {
        $d = vf_bloc($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = vf_SEPR($d)
        $corps2 = vf_NOD($d)
      }
      sinon {
        $d = vf_instruction($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = vf_SEPR($d)
        $corps2 = vf_NOD($d)
      }
    }
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(vf_NOD($r)), -1, $corps1, $corps2, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "ident" et vf_VX0($x, $p) == "tant_que") {
    $q = $p + 1
    si (vf_T0($g, $q) == "(") { $q = $q + 1 }
    $r = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($r)
    si (vf_T0($g, $q) == ")") { $q = $q + 1 }
    $c = vf_bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(vf_NOD($r)), -1, vf_NOD($c), "", $l)
    retour chaine(vf_SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et vf_VX0($x, $p) == "pour") {
    $q = $p + 1
    $rn = vf_nomid($g, $x, $q)
    $q = vf_SEPR($rn)
    $nom = vf_NOD($rn)
    si (vf_EMOT($g, $x, $q, "de")) { $q = $q + 1 }
    $rd = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($rd)
    si (vf_EMOT($g, $x, $q, "vers")) { $q = $q + 1 }
    $rf = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = vf_SEPR($rf)
    $c = vf_bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "pour", $nom, entier(vf_NOD($rd)), entier(vf_NOD($rf)), vf_NOD($c), "", $l)
    retour chaine(vf_SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et vf_VX0($x, $p) == "retour") {
    $suiv = vf_T1($g, $p)
    si ($suiv == ";" ou $suiv == "}" ou $suiv == "eof") {
      $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", -1, -1, "", "", $l)
      retour chaine($p + 1) + "|" + chaine($i)
    }
    $r = vf_expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", entier(vf_NOD($r)), -1, "", "", $l)
    retour chaine(vf_SEPR($r)) + "|" + chaine($i)
  }
  si (($t == "ident" ou $t == "mot") et vf_T1($g, $p) == "=") {
    $rn = vf_nomid($g, $x, $p)
    $q = vf_SEPR($rn)
    si (vf_T0($g, $q) == "=") { $q = $q + 1 }
    $r = vf_expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "affi", vf_NOD($rn), entier(vf_NOD($r)), -1, "", "", $l)
    retour chaine(vf_SEPR($r)) + "|" + chaine($i)
  }
  $r = vf_expr1($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $i = vf_inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "expr", "", entier(vf_NOD($r)), -1, "", "", $l)
  retour chaine(vf_SEPR($r)) + "|" + chaine($i)
}

fn vf_bloc($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>,
        $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
        $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (vf_T0($g, $q) == "{") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = vf_T0($g, $q)
    si ($t == "}" ou $t == "eof") { $ok = 0 }
    sinon {
      si ($t == ";") { $q = $q + 1 }
      sinon {
        $r = vf_instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = vf_SEPR($r)
        si ($ch != "") { $ch = $ch + "," }
        $ch = $ch + vf_NOD($r)
        si (vf_T0($g, $q) == ";") { $q = $q + 1 }
      }
    }
  }
  si (vf_T0($g, $q) == "}") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

fn vf_corps_chevron($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (vf_T0($g, $q) == "[") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = vf_T0($g, $q)
    si ($t == "]" ou $t == "eof") { $ok = 0 }
    sinon {
      $r = vf_instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
      $q = vf_SEPR($r)
      si ($ch != "") { $ch = $ch + "," }
      $ch = $ch + vf_NOD($r)
      si (vf_T0($g, $q) == ";") { $q = $q + 1 } sinon { $ok = 0 }
    }
  }
  si (vf_T0($g, $q) == "]") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

# ══════════════════ définition de fonction ══════════════════
# Pools parallèles : noms, externe (« 1 » ou vide), paramètres encodés
# « nom|base|elt;… », retour « base|elt », corps (chaîne d'indices), ligne du
# jeton « fn » (les erreurs de frontière la réclament).

fn vf_def_fn($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
          $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $al: liste<entier>,
          $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
          $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
          $fnoms: liste<chaine>, $fext: liste<chaine>, $fparams: liste<chaine>,
          $fret: liste<chaine>, $fcorps: liste<chaine>, $fligne: liste<entier>) -> chaine {
  $lf = vf_GL0($gl, $p)
  $q = $p + 1
  $rn = vf_nomid($g, $x, $q)
  $q = vf_SEPR($rn)
  $nom = vf_NOD($rn)
  si (vf_T0($g, $q) == "(") { $q = $q + 1 }
  $params = ""
  $un = 1
  tant_que ($un == 1) {
    si (vf_T0($g, $q) == ")" ou vf_T0($g, $q) == "eof") { $un = 0 }
    sinon {
      $rp = vf_nomid($g, $x, $q)
      $q = vf_SEPR($rp)
      $pn = vf_NOD($rp)
      si (vf_T0($g, $q) == ":") {
        $q = $q + 1
        $rt = vf_typex($g, $x, $q)
        $q = vf_SEPR($rt)
        $tp = vf_NOD($rt)
      } sinon {
        # paramètre sans annotation : type dynamique, encodé « ?|vide »
        # (NOD exige un '|', sinon sous_chaine(q+1, n) a des bornes invalides).
        $tp = "?|vide"
      }
      si ($params != "") { $params = $params + ";" }
      $params = $params + $pn + "|" + $tp
      si (vf_T0($g, $q) == ",") { $q = $q + 1 } sinon { $un = 0 }
    }
  }
  si (vf_T0($g, $q) == ")") { $q = $q + 1 }
  $ret = "?|vide"
  si (vf_T0($g, $q) == "->") {
    $rt = vf_typex($g, $x, $q + 1)
    $ret = vf_NOD($rt)
    $q = vf_SEPR($rt)
  }
  $ext = "1"
  $corps = ""
  si (vf_T0($g, $q) == "{") {
    $ext = ""
    $c = vf_bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $corps = vf_NOD($c)
    $q = vf_SEPR($c)
  }
  joindre($fnoms, $nom)
  joindre($fext, $ext)
  joindre($fparams, $params)
  joindre($fret, $ret)
  joindre($fcorps, $corps)
  joindre($fligne, $lf)
  retour chaine($q) + "|" + $nom
}

# ══════════════════ repli de constantes (passe 1) ══════════════════
# Miroir de replier_constants : fonctions triées (corps seulement), puis le
# niveau supérieur ; post-ordre strict (arguments, gauche, droite, nœud).
# La vue d'un nœud vaut « 1|texte|drapeau » si le nœud est (ou devient) un
# littéral après repli, « 0 » sinon. Les flottants repliés portent la marque
# opaque « F » : tout calcul flottant fini reste flottant, /0 flottant ne
# lève rien (miroir du nullptr), NaN/∞ non plus — le verdict est identique.
# Les entrées sont stockées par indice de nœud pour que la passe 2 voie
# l'arbre replié sans jamais modifier les pools.

fn vf_entree($i: entier, $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) -> chaine {
  $n = longueur($foi)
  $j = 1
  tant_que ($j < $n) {
    si ($foi[$j] == $i) { retour "1|" + $fot[$j] + "|" + $fof[$j] }
    $j = $j + 1
  }
  retour "0"
}

fn vf_stocker($i: entier, $t: chaine, $f: chaine,
           $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) {
  joindre($foi, $i)
  joindre($fot, $t)
  joindre($fof, $f)
}

fn vf_vue_texte($v: chaine) -> chaine {
  $n = longueur($v)
  $d = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($d >= $n) { $ok = 0 }
    sinon si (ordre($v[$d]) == 124) { $ok = 0 }
    sinon { $d = $d + 1 }
  }
  $f = $n - 1
  $ok = 1
  tant_que ($ok == 1) {
    si ($f <= $d) { $ok = 0 }
    sinon si (ordre($v[$f]) == 124) { $ok = 0 }
    sinon { $f = $f - 1 }
  }
  retour sous_chaine($v, $d + 1, $f)
}

fn vf_vue_flag($v: chaine) -> chaine {
  $n = longueur($v)
  $f = $n - 1
  $ok = 1
  tant_que ($ok == 1) {
    si ($f <= 0) { $ok = 0 }
    sinon si (ordre($v[$f]) == 124) { $ok = 0 }
    sinon { $f = $f - 1 }
  }
  retour sous_chaine($v, $f + 1, $n)
}

fn vf_replier_expr($i: entier,
                $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                $lg: liste<entier>, $al: liste<entier>,
                $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                $err: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "0" }
  $kd = $k[$i]
  $va = "0"
  $vb = "0"
  si ($kd == "lst" ou $kd == "app") {
    $sa = $as[$i]
    $n = $ac[$i]
    $j = 0
    tant_que ($j < $n) {
      vf_replier_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
      $j = $j + 1
    }
  }
  sinon si ($kd == "idx" ou $kd == "bin") {
    $ga = $a[$i]
    $gb = $b[$i]
    si ($ga >= 0) { $va = vf_replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($gb >= 0) { $vb = vf_replier_expr($gb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd != "bin") { retour "0" }
  }
  sinon si ($kd == "uni" ou $kd == "fac") {
    $ga = $a[$i]
    si ($ga >= 0) { $va = vf_replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd == "fac") { retour "0" }
  }
  sinon si ($kd == "lit") {
    retour "1|" + $tx[$i] + "|" + $tf[$i]
  }
  sinon si ($kd == "cplx" et $foi[0] != 1) {
    vf_stocker($i, "0,1", "c", $foi, $fot, $fof)
    retour "1|0,1|c"
  }
  sinon { retour "0" }
  si (longueur($err) > 1) { retour "0" }
  $l = $lg[$i]
  # — unaire « - » sur littéral : miroir litt_depuis_q(-q) —
  si ($kd == "uni" et $va != "0") {
    si ($tx[$i] != "-") { retour "0" }
    si (vf_vue_flag($va) == "1") {
      vf_stocker($i, "F", "1", $foi, $fot, $fof)
      retour "1|F|1"
    }
    $t = vf_vue_texte($va)
    $nvt = ""
    si (vf_rnul($t)) { $nvt = "0" }
    sinon si (ordre($t[0]) == 45) { $nvt = sous_chaine($t, 1, longueur($t)) }
    sinon { $nvt = "-" + $t }
    vf_stocker($i, $nvt, "", $foi, $fot, $fof)
    retour "1|" + $nvt + "|"
  }
  # — binaire sur deux littéraux : miroir fold_bin —
  si ($kd == "bin" et $va != "0" et $vb != "0") {
    $op = $tx[$i]
    $fa = vf_vue_flag($va)
    $fb = vf_vue_flag($vb)
    si ($fa == "c" ou $fb == "c") {
      $ta0 = vf_vue_texte($va)
      $tb0 = vf_vue_texte($vb)
      si (vf_contient_barre($ta0) ou vf_contient_barre($tb0)) { retour "0" }
      $ra = 0
      $ia = 0
      $rb = 0
      $ib = 0
      si ($fa == "c") { $ra = entier(vf_piece($ta0, 44, 1)); $ia = entier(vf_piece($ta0, 44, 2)) }
      sinon { $ra = entier($ta0) }
      si ($fb == "c") { $rb = entier(vf_piece($tb0, 44, 1)); $ib = entier(vf_piece($tb0, 44, 2)) }
      sinon { $rb = entier($tb0) }
      $nr = 0
      $ni = 0
      si ($op == "+") { $nr = $ra + $rb; $ni = $ia + $ib }
      sinon si ($op == "-") { $nr = $ra - $rb; $ni = $ia - $ib }
      sinon si ($op == "*") { $nr = $ra * $rb - $ia * $ib; $ni = $ra * $ib + $ia * $rb }
      sinon { retour "0" }
      si ($ni == 0) {
        $rc = vf_rnorm($nr, 1)
        vf_stocker($i, $rc, "", $foi, $fot, $fof)
        retour "1|" + $rc + "|"
      }
      $rc = chaine($nr) + "," + chaine($ni)
      vf_stocker($i, $rc, "c", $foi, $fot, $fof)
      retour "1|" + $rc + "|c"
    }
    si (vf_vue_flag($va) == "1" ou vf_vue_flag($vb) == "1") {
      si ($op == "+" ou $op == "-" ou $op == "*" ou $op == "/" ou $op == "^") {
        vf_stocker($i, "F", "1", $foi, $fot, $fof)
        retour "1|F|1"
      }
      retour "0"
    }
    si ($op == "≈" ou $op == "?=" ou $op == "=~" ou $op == "==" ou $op == "!=" ou $op == "%") {
      retour "0"
    }
    $ta = vf_vue_texte($va)
    $tb = vf_vue_texte($vb)
    $p1 = vf_rnum($ta)
    $q1 = vf_rden($ta)
    $p2 = vf_rnum($tb)
    $q2 = vf_rden($tb)
    $r = ""
    si ($op == "+") { $r = vf_rnorm($p1 * $q2 + $p2 * $q1, $q1 * $q2) }
    sinon si ($op == "-") { $r = vf_rnorm($p1 * $q2 - $p2 * $q1, $q1 * $q2) }
    sinon si ($op == "*") { $r = vf_rnorm($p1 * $p2, $q1 * $q2) }
    sinon si ($op == "/") {
      si (vf_rnul($tb)) { vf_signaler($l, "Division par zéro dans une constante", $err); retour "0" }
      $r = vf_rnorm($p1 * $q2, $q1 * $p2)
    }
    sinon si ($op == "^") {
      si ($q2 != 1) { retour "0" }
      si ($p2 < 0 et vf_rnul($ta)) { vf_signaler($l, "0^négatif dans une constante", $err); retour "0" }
      si ($p2 > 200000 ou 0 - $p2 > 200000) { retour "0" }
      $num = 1
      $den = 1
      si ($p2 >= 0) { $num = vf_rpui($p1 + 0, $p2); $den = vf_rpui($q1 + 0, $p2) }
      sinon {
        $kk = 0 - $p2
        $num = vf_rpui($q1, $kk)
        $den = vf_rpui($p1, $kk)
      }
      $r = vf_rnorm($num + 0, $den + 0)
    }
    sinon si ($op == "div") {
      si (vf_rnul($tb)) { vf_signaler($l, "division par zéro dans une constante", $err); retour "0" }
      $r = chaine($p1 * $q2 div ($q1 * $p2))
    }
    sinon { retour "0" }
    vf_stocker($i, $r, "", $foi, $fot, $fof)
    retour "1|" + $r + "|"
  }
  retour "0"
}

fn vf_replier_chaine($cs: chaine,
                  $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                  $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                  $lg: liste<entier>, $al: liste<entier>,
                  $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                  $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                  $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                  $err: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          vf_replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    vf_replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

fn vf_replier_instr($i: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                 $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                 $err: liste<chaine>) {
  si (longueur($err) > 1) { retour 0 }
  $kd = $ik[$i]
  si ($kd == "aff" ou $kd == "expr" ou $kd == "affi") {
    vf_replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "retour") {
    $e = $ie[$i]
    si ($e >= 0) {
      vf_replier_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    }
    retour 0
  }
  si ($kd == "si") {
    vf_replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    vf_replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    $b2 = $ib2[$i]
    si ($b2 != "") {
      vf_replier_chaine($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    }
    retour 0
  }
  si ($kd == "tq") {
    vf_replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    vf_replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "pour") {
    vf_replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    vf_replier_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    vf_replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "bloc") {
    vf_replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

# ══════════════════ vérification de types (passe 2) ══════════════════
# Miroir du vérificateur C++ : expressions rendent le type « base|elt » ;
# deux paires d'environnements vivent en parallèle — l'environnement de
# l'instruction courante et le « locals » du membre (tout corps de si/
# tant_que/pour descend dans LOCALS, jamais dans l'environnement ambiant —
# bizarrerie fidèle du moteur, dualité globales/locals mesurée en v3.14).

fn vf_ELTT($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour sous_chaine($v, $k + 1, $n)
}

fn vf_t_from_texte($t: chaine, $f: chaine) -> chaine {
  si ($f == "c") { retour "complexe|vide" }
  si ($f == "1") { retour "flottant|vide" }
  si (vf_contient_barre($t)) { retour "rationnel|vide" }
  retour "entier|vide"
}

fn vf_check_expr($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
              $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $err: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "vide|vide" }
  $vue = vf_entree($i, $foi, $fot, $fof)
  si ($vue != "0") { retour vf_t_from_texte(vf_vue_texte($vue), vf_vue_flag($vue)) }
  $kd = $k[$i]
  $lg0 = $lg[$i]
  si ($kd == "lit") { retour vf_t_from_texte($tx[$i], $tf[$i]) }
  si ($kd == "cplx") {
    $ti = vf_env_get("i", $vn, $vt)
    si ($ti == "") { $ti = vf_env_get("i", $gn, $gt) }
    si ($ti == "") { $ti = "complexe|vide" }
    retour $ti
  }
  si ($kd == "ch") { retour "chaine|vide" }
  si ($kd == "bol") { retour "booleen|vide" }
  si ($kd == "v") {
    $nom = $tx[$i]
    $t = vf_env_get($nom, $vn, $vt)
    si ($t == "") { $t = vf_env_get($nom, $gn, $gt) }
    si ($t == "" et ($nom == "π" ou $nom == "φ" ou $nom == "pi" ou $nom == "phi" ou $nom == "e")) { $t = "chaine|entier" }
    si ($t == "") {
      vf_signaler($lg0, "Variable '" + $nom + "' utilisée sans valeur", $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "lst") {
    $n = $ac[$i]
    $sa = $as[$i]
    si ($n == 0) {
      vf_signaler($lg0, "Liste vide : le type d'élément est introuvable", $err)
      retour "vide|vide"
    }
    $t_elt = vf_check_expr($al[$sa], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    $j = 1
    tant_que ($j < $n) {
      $tch = vf_check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
      si ($tch != $t_elt) {
        si (vf_estnum($tch) et vf_estnum($t_elt)) { $t_elt = vf_promote($tch, $t_elt) }
        sinon {
          vf_signaler($lg0, "Liste hétérogène : " + vf_nomty($t_elt) + " puis " + vf_nomty($tch), $err)
          retour "vide|vide"
        }
      }
      $j = $j + 1
    }
    si (longueur($err) > 1) { retour "vide|vide" }
    si (vf_BASE($t_elt) == "liste") {
      vf_signaler($lg0, "Listes de listes non supportées pour l'instant", $err)
      retour "vide|vide"
    }
    retour "liste|" + vf_BASE($t_elt)
  }
  si ($kd == "idx") {
    $tb = vf_check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    $ti = vf_check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    $bb = vf_BASE($tb)
    $bi = vf_BASE($ti)
    si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "valeur" et $bb != "?") {
      vf_signaler($lg0, "Index sur un " + vf_nomty($tb) + ", une liste est attendue", $err)
      retour "vide|vide"
    }
    # front.rs:1989 — Table OU Dyn : ni contrôle de clé, ni contrôle d'index,
    # résultat dynamique (Ty { n: Dyn, elt: Dyn } → « ?|vide » ici).
    si ($bb == "?") { retour "?|vide" }
    si ($bb == "table" ou $bb == "valeur") {
      $cle_ok = 0
      si ($bi == "entier") { $cle_ok = 1 }
      sinon si ($bi == "rationnel") { $cle_ok = 1 }
      sinon si ($bi == "flottant") { $cle_ok = 1 }
      sinon si ($bi == "chaine") { $cle_ok = 1 }
      sinon si ($bi == "booleen") { $cle_ok = 1 }
      si ($bb == "table" et $cle_ok == 0) {
        vf_signaler($lg0, "Index d'une table doit être un texte ou un nombre", $err)
        retour "vide|vide"
      }
      retour "valeur|vide"
    }
    si ($bi != "entier") {
      $msg = "Index d'une liste doit être entier"
      si ($bb == "chaine") { $msg = "Index d'une chaîne doit être entier" }
      vf_signaler($lg0, $msg, $err)
      retour "vide|vide"
    }
    si ($bb == "chaine") { retour "chaine|vide" }
    retour vf_ELTT($tb) + "|vide"
  }
  si ($kd == "uni") {
    $t = vf_check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si ($tx[$i] == "non") {
      si (vf_BASE($t) != "booleen") {
        vf_signaler($lg0, "La condition de non doit être booléenne, trouvé " + vf_nomty($t), $err)
        retour "vide|vide"
      }
      retour "booleen|vide"
    }
    # front.rs:1917 — unaire (hors « non ») sur Dyn : laissé passer.
    si (vf_BASE($t) == "?") { retour "?|vide" }
    si (non vf_estnum($t)) {
      vf_signaler($lg0, "Unaire " + $tx[$i] + " sur un " + vf_nomty($t), $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "fac") {
    $t = vf_check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si (vf_BASE($t) != "entier") {
      vf_signaler($lg0, "Factorielle attend un entier, trouvé " + vf_nomty($t), $err)
      retour "vide|vide"
    }
    retour "entier|vide"
  }
  si ($kd == "bin") { retour vf_check_bin($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                        $foi, $fot, $fof, $err) }
  si ($kd == "app") { retour vf_check_appel($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                          $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                          $foi, $fot, $fof, $err) }
  vf_signaler($lg0, "Expression inconnue", $err)
  retour "vide|vide"
}

fn vf_check_bin($i: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $err: liste<chaine>) -> chaine {
  $op = $tx[$i]
  $lg0 = $lg[$i]
  $tg = vf_check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
  $td = vf_check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
  si (longueur($err) > 1) { retour "vide|vide" }
  si ($op == "et" ou $op == "ou") {
    si (vf_BASE($tg) != "booleen") {
      vf_signaler($lg0, "La condition de et/ou doit être booléenne, trouvé " + vf_nomty($tg), $err)
      retour "vide|vide"
    }
    si (vf_BASE($td) != "booleen") {
      vf_signaler($lg0, "La condition de et/ou doit être booléenne, trouvé " + vf_nomty($td), $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "==" ou $op == "!=" ou $op == "≈" ou $op == "?=" ou $op == "=~") {
    si ($tg != $td et non(vf_estnum($tg) et vf_estnum($td))
        et vf_BASE($tg) != "?" et vf_BASE($td) != "?") {
      vf_signaler($lg0, "Comparaison " + vf_nomty($tg) + " " + $op + " " + vf_nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "<" ou $op == "<=" ou $op == ">" ou $op == ">=") {
    $okordre = 0
    si (vf_estnum($tg) et vf_estnum($td)) { $okordre = 1 }
    si (vf_BASE($tg) == "chaine" et vf_BASE($td) == "chaine") { $okordre = 1 }
    # front.rs:2035 — comparaison d'ordre avec un Dyn : résolue à l'exécution.
    si (vf_BASE($tg) == "?" ou vf_BASE($td) == "?") { $okordre = 1 }
    si ($okordre == 0) {
      vf_signaler($lg0, "Ordre " + vf_nomty($tg) + " " + $op + " " + vf_nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "+") {
    si (vf_BASE($tg) == "complexe" ou vf_BASE($td) == "complexe") { retour "complexe|vide" }
    si (vf_BASE($tg) == "chaine" et vf_BASE($td) == "chaine") { retour "chaine|vide" }
    si (vf_estnum($tg) et vf_estnum($td)) { retour vf_promote($tg, $td) }
    # front.rs:2044 — Dyn + X non numérique des deux côtés → Dyn.
    si (vf_BASE($tg) == "?" ou vf_BASE($td) == "?") { retour "?|vide" }
    # miroir de front.rs : `racine(n)` est typée irrationnel mais rend un
    # entier exact sur carré parfait ; l'addition est donc résolue à
    # l'exécution (les benches racines l'utilisent).
    si (vf_BASE($tg) == "irrationnel" ou vf_BASE($td) == "irrationnel") { retour "?|vide" }
    vf_signaler($lg0, "Addition " + vf_nomty($tg) + " + " + vf_nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "-" ou $op == "*") {
    si (vf_BASE($tg) == "complexe" ou vf_BASE($td) == "complexe") { retour "complexe|vide" }
    si (vf_estnum($tg) et vf_estnum($td)) { retour vf_promote($tg, $td) }
    # front.rs:2058 — Dyn × X : type résolu à l'exécution.
    si (vf_BASE($tg) == "?" ou vf_BASE($td) == "?") { retour "?|vide" }
    vf_signaler($lg0, "Opération " + vf_nomty($tg) + " " + $op + " " + vf_nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "/") {
    si (vf_BASE($tg) == "complexe" ou vf_BASE($td) == "complexe") { retour "complexe|vide" }
    si (vf_estnum($tg) et vf_estnum($td)) {
      $r = vf_promote($tg, $td)
      si (vf_BASE($r) == "entier") { retour "rationnel|vide" }
      retour $r
    }
    # front.rs:2070 — division avec Dyn non résolu → Dyn.
    si (vf_BASE($tg) == "?" ou vf_BASE($td) == "?") { retour "?|vide" }
    vf_signaler($lg0, "Division " + vf_nomty($tg) + " / " + vf_nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "%") {
    si (vf_BASE($tg) == "entier" et vf_BASE($td) == "entier") { retour "entier|vide" }
    vf_signaler($lg0, "Le modulo exige deux entiers", $err)
    retour "vide|vide"
  }
  si ($op == "div") {
    si (non(vf_estnum($tg) ou vf_BASE($tg) == "booleen")) {
      vf_signaler($lg0, "div attend un nombre à gauche, trouvé " + vf_nomty($tg), $err)
      retour "vide|vide"
    }
    si (non(vf_estnum($td) ou vf_BASE($td) == "booleen")) {
      vf_signaler($lg0, "div attend un nombre à droite, trouvé " + vf_nomty($td), $err)
      retour "vide|vide"
    }
    si (vf_BASE($tg) == "flottant" ou vf_BASE($td) == "flottant") { retour "flottant|vide" }
    retour "entier|vide"
  }
  si ($op == "^") {
    si (non vf_estnum($tg)) {
      vf_signaler($lg0, "Puissance sur une base " + vf_nomty($tg), $err)
      retour "vide|vide"
    }
    si (vf_BASE($td) == "flottant") { retour "flottant|vide" }
    $bd = vf_BASE($td)
    si ($bd == "entier" ou $bd == "rationnel" ou $bd == "booleen") {
      $gb = $b[$i]
      $est_uni = 1
      si (vf_entree($gb, $foi, $fot, $fof) != "0") { $est_uni = 0 }
      sinon si ($k[$gb] != "uni") { $est_uni = 0 }
      sinon si ($tx[$gb] != "-") { $est_uni = 0 }
      si ($est_uni == 1) {
        si (vf_BASE($tg) == "entier") { retour "rationnel|vide" }
        retour $tg
      }
      si (vf_BASE($tg) == "entier") { retour "entier|vide" }
      retour $tg
    }
    vf_signaler($lg0, "Exposant " + vf_nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  vf_signaler($lg0, "Opérateur '" + $op + "' inconnu", $err)
  retour "vide|vide"
}

# — tables STDLIB et DYNAMIQUE (miroir exact des 45 + 4 entrées) —
# Format « retour|codes,virgules ». Codes inconnus du vérificateur C++
# (« n », « table ») acceptent tout : ils restent ici sans règle, fidèles.

fn vf_std_sig($nom: chaine) -> chaine {
  si ($nom == "afficher") { retour "vide|n" }
  si ($nom == "saisir_entier") { retour "entier|" }
  si ($nom == "saisir_flottant") { retour "flottant|" }
  si ($nom == "factorielle") { retour "entier|entier" }
  si ($nom == "fibonacci") { retour "entier|entier" }
  si ($nom == "pgcd") { retour "entier|entier,entier" }
  si ($nom == "ppcm") { retour "entier|entier,entier" }
  si ($nom == "puissance") { retour "entier|num,entier" }
  si ($nom == "est_premier") { retour "booleen|entier" }
  si ($nom == "compter_premiers") { retour "entier|entier" }
  si ($nom == "nb_chiffres") { retour "entier|entier" }
  si ($nom == "nombre_pi") { retour "chaine|entier" }
  si ($nom == "longueur") { retour "entier|lct" }
  # front.rs:650-651 — alias `len` et primitive `type_de` (arg « tout » non vérifié).
  si ($nom == "len") { retour "entier|lct" }
  si ($nom == "type_de") { retour "chaine|tout" }
  si ($nom == "table") { retour "table|" }
  si ($nom == "inserer") { retour "vide|table,tout,tout" }
  si ($nom == "cle_existe") { retour "booleen|table,tout" }
  si ($nom == "supprimer") { retour "booleen|table,tout" }
  si ($nom == "cles") { retour "MIXTE|table" }
  si ($nom == "valeurs") { retour "MIXTE|table" }
  si ($nom == "joindre") { retour "vide|liste,liste_elt" }
  si ($nom == "ordre") { retour "entier|chaine" }
  si ($nom == "caractere") { retour "chaine|entier" }
  si ($nom == "sous_chaine") { retour "chaine|chaine,entier,entier" }
  si ($nom == "concatener") { retour "chaine|liste" }
  si ($nom == "ecrire_bytes") { retour "vide|chaine,chaine" }
  si ($nom == "ecrire_binaire") { retour "vide|chaine,liste" }
  si ($nom == "lire_texte") { retour "chaine|chaine" }
  si ($nom == "ecrire_texte") { retour "vide|chaine,chaine" }
  si ($nom == "nb_arguments") { retour "entier|" }
  si ($nom == "argument") { retour "chaine|entier" }
  si ($nom == "temps") { retour "entier|" }
  si ($nom == "duree") { retour "chaine|entier" }
  si ($nom == "afficher_erreur") { retour "vide|tout" }
  si ($nom == "quitter") { retour "vide|entier" }
  si ($nom == "abs") { retour "MIXTE|num" }
  si ($nom == "min") { retour "NUM_MAX|num,num" }
  si ($nom == "max") { retour "NUM_MAX|num,num" }
  si ($nom == "partie_entiere") { retour "entier|num" }
  si ($nom == "fraction") { retour "rationnel|entier,entier" }
  si ($nom == "graine") { retour "vide|entier" }
  si ($nom == "hasard") { retour "entier|entier" }
  si ($nom == "tampon") { retour "tampon|entier" }
  si ($nom == "octets") { retour "tampon|chaine" }
  si ($nom == "tampon_case") { retour "entier|tampon,entier" }
  si ($nom == "tampon_pose") { retour "vide|tampon,entier,entier" }
  si ($nom == "remplir_hasard") { retour "vide|tampon,tampon" }
  si ($nom == "remplir_hasard_philox") { retour "vide|tampon,tampon,entier" }
  si ($nom == "re" ou $nom == "im" ou $nom == "arg" ou $nom == "modulus") { retour "flottant|complexe" }
  si ($nom == "conj") { retour "complexe|complexe" }
  si ($nom == "__i" ou $nom == "i") { retour "complexe|" }
  si ($nom == "millisecondes") { retour "entier|" }
  # front.rs:709-716 — `time`/`ms` et les 5 primitives GUI native (ajoutées
  # au STDLIB Rust) : signatures miroir, absentes des tables Rose jusqu'ici.
  si ($nom == "time") { retour "chaine|" }
  si ($nom == "ms") { retour "entier|" }
  si ($nom == "fenetre_native") { retour "entier|chaine,entier,entier" }
  si ($nom == "fenetre_afficher") { retour "vide|entier" }
  si ($nom == "fenetre_attendre") { retour "vide|entier" }
  si ($nom == "fenetre_fermer") { retour "vide|entier" }
  si ($nom == "message_native") { retour "vide|chaine,chaine" }
  # alias de maths exactes (miroir STDLIB Rust)
  si ($nom == "fact") { retour "entier|entier" }
  si ($nom == "fib") { retour "entier|entier" }
  si ($nom == "gcd") { retour "entier|entier,entier" }
  si ($nom == "lcm") { retour "entier|entier,entier" }
  si ($nom == "pow") { retour "entier|num,entier" }
  si ($nom == "racine") { retour "irrationnel|entier" }
  si ($nom == "racine_decimales") { retour "chaine|entier,entier" }
  si ($nom == "is_prime") { retour "booleen|entier" }
  si ($nom == "digits") { retour "entier|entier" }
  si ($nom == "pi" ou $nom == "nombre_e" ou $nom == "e" ou $nom == "phi") { retour "chaine|entier" }
  si ($nom == "factorielle_rapide" ou $nom == "factorial_rapide" ou $nom == "rapide") { retour "entier|entier" }
  si ($nom == "approx" ou $nom == "factorial_approx") { retour "chaine|entier" }
  si ($nom == "primorielle") { retour "entier|entier" }
  si ($nom == "termial" ou $nom == "triangulaire" ou $nom == "termial_classique" ou $nom == "termial_kurepa" ou $nom == "kurepa" ou $nom == "terminal") { retour "entier|entier" }
  si ($nom == "super_factorielle") { retour "entier|entier" }
  si ($nom == "multifactorielle" ou $nom == "multifactoriel") { retour "entier|entier,entier" }
  si ($nom == "sous_factorielle" ou $nom == "derangement" ou $nom == "sous_factorial") { retour "entier|entier" }
  retour ""
}

fn vf_dyn_sig($nom: chaine) -> chaine {
  si ($nom == "charger") { retour "entier|chaine" }
  si ($nom == "fermer") { retour "vide|entier" }
  si ($nom == "appeler0") { retour "flottant|entier,chaine" }
  si ($nom == "appeler1") { retour "flottant|entier,chaine,num" }
  si ($nom == "appeler2") { retour "flottant|entier,chaine,num,num" }
  retour ""
}

fn vf_vargs($i: entier, $codes: chaine, $nom: chaine,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>,
         $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
         $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
         $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
         $err: liste<chaine>) {
  $nargs = $ac[$i]
  $np = vf_nb_pieces($codes, 44)
  si ($nargs != $np) {
    vf_signaler($lg[$i], $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($nargs), $err)
    retour 0
  }
  $sa = $as[$i]
  $t_elt = "vide|vide"
  $a_elt = 0
  $j = 0
  tant_que ($j < $nargs) {
    $ta = vf_check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    $code = vf_piece($codes, 44, $j + 1)
    si ($code == "chaine") {
      si (vf_BASE($ta) != "chaine") { vf_signaler($lg[$i], $nom + ": une chaine est attendue", $err) }
    }
    sinon si ($code == "num") {
      si (non vf_estnum($ta)) {
        vf_signaler($lg[$i], $nom + ": un nombre est attendu, reçu " + vf_nomty($ta), $err)
      }
    }
    sinon si ($code == "entier") {
      si (vf_BASE($ta) != "entier") {
        vf_signaler($lg[$i], $nom + ": un entier est attendu, reçu " + vf_nomty($ta), $err)
      }
    }
    sinon si ($code == "liste") {
      si (vf_BASE($ta) != "liste") {
        vf_signaler($lg[$i], $nom + ": une liste est attendue, reçu " + vf_nomty($ta), $err)
      }
      $t_elt = vf_tyb(vf_ELTT($ta))
      $a_elt = 1
    }
    sinon si ($code == "tampon") {
      si (vf_BASE($ta) != "tampon") {
        vf_signaler($lg[$i], $nom + ": un tampon est attendu, reçu " + vf_nomty($ta), $err)
      }
    }
    sinon si ($code == "lct") {
      $bb = vf_BASE($ta)
      si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "tampon") {
        vf_signaler($lg[$i], $nom + ": une liste, une chaîne ou une table est attendue, reçu " + vf_nomty($ta), $err)
      }
    }
    sinon si ($code == "liste_elt") {
      $tolere = 0
      si ($a_elt == 1 et vf_BASE($t_elt) != "vide" et $ta != $t_elt) {
        si (vf_estnum($ta) et vf_estnum($t_elt) et vf_promote($ta, $t_elt) == $t_elt) { $tolere = 1 }
        si ($tolere == 0) {
          vf_signaler($lg[$i], $nom + ": élément " + vf_nomty($ta) + " ne correspond pas à la liste " + vf_nomty($t_elt), $err)
        }
      }
    }
    $j = $j + 1
  }
}

fn vf_check_appel($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $err: liste<chaine>) -> chaine {
  $lg0 = $lg[$i]
  $tx0 = $tx[$i]
  $mod = vf_eclate_mod($tx0)
  $nom = vf_eclate_nom($tx0)
  # — dynamique:: —
  si ($mod == "dynamique") {
    $spec = vf_dyn_sig($nom)
    si ($spec == "") {
      vf_signaler($lg0, "Fonction dynamique::" + $nom + " inconnue (disponibles: charger, fermer, appeler0, appeler1, appeler2)", $err)
      retour "vide|vide"
    }
    vf_vargs($i, vf_piece($spec, 124, 2), "dynamique::" + $nom,
          $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
          $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    retour vf_tyb(vf_piece($spec, 124, 1))
  }
  # — conversions d'un argument, avant les signatures —
  $cast = 0
  si ($nom == "entier") { $cast = 1 }
  sinon si ($nom == "rationnel") { $cast = 1 }
  sinon si ($nom == "flottant") { $cast = 1 }
  sinon si ($nom == "chaine") { $cast = 1 }
  si ($cast == 1 et $ac[$i] == 1) {
    $t = vf_check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si ($nom == "chaine") { retour "chaine|vide" }
    si (vf_BASE($t) == "chaine") {
      si ($nom == "entier") { retour "entier|vide" }
      si ($nom == "flottant") { retour "flottant|vide" }
      vf_signaler($lg0, "Conversion chaine → rationnel non disponible, passez par flottant", $err)
      retour "vide|vide"
    }
    si (non vf_estnum($t)) {
      vf_signaler($lg0, "Conversion " + vf_nomty($t) + " → " + vf_nomty(vf_tyb($nom)) + " impossible", $err)
      retour "vide|vide"
    }
    retour vf_tyb($nom)
  }
  # — fonctions de l'utilisateur (externes comprises) —
  $pos = 0
  $u = 1
  $nf = longueur($fnoms)
  tant_que ($u < $nf) {
    si ($pos == 0 et $fnoms[$u] == $nom) { $pos = $u }
    $u = $u + 1
  }
  si ($pos > 0) {
    $ps = $fparams[$pos]
    $np = vf_nb_pieces($ps, 59)
    si ($ac[$i] != $np) {
      vf_signaler($lg0, $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($ac[$i]), $err)
      retour "vide|vide"
    }
    $sa = $as[$i]
    $j = 1
    $ok = 1
    tant_que ($j <= $np) {
      si ($ok == 1) {
        $ta = vf_check_expr($al[$sa + $j - 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                         $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
        $ent = vf_piece($ps, 59, $j)
        $t_att = sous_chaine($ent, vf_premier_pipe($ent) + 1, longueur($ent))
        $bad = 0
        si ($ta != $t_att) {
          # front.rs:2157 — un paramètre sans annotation (Dyn) accepte tout.
          si (vf_BASE($t_att) != "?") {
            si (non(vf_estnum($ta) et vf_estnum($t_att) et vf_promote($ta, $t_att) == $t_att)) { $bad = 1 }
          }
        }
        si ($bad == 1) {
          vf_signaler($lg0, "Argument de " + $nom + ": " + vf_nomty($ta) + " reçu, " + vf_nomty($t_att) + " attendu", $err)
          $ok = 0
        }
      }
      $j = $j + 1
    }
    retour $fret[$pos]
  }
  # — bibliothèque standard —
  $spec = vf_std_sig($nom)
  si ($spec == "") {
    vf_signaler($lg0, "Fonction '" + $nom + "' inconnue", $err)
    retour "vide|vide"
  }
  vf_vargs($i, vf_piece($spec, 124, 2), $nom,
        $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
        $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
  si (longueur($err) > 1) { retour "vide|vide" }
  $ret = vf_piece($spec, 124, 1)
  si ($ret == "MIXTE") {
    $t = vf_check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si (vf_BASE($t) == "booleen") { retour "entier|vide" }
    retour $t
  }
  si ($ret == "NUM_MAX") {
    $ta1 = vf_check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    $ta2 = vf_check_expr($al[$as[$i] + 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    retour vf_promote($ta1, $ta2)
  }
  retour vf_tyb($ret)
}

fn vf_premier_pipe($v: chaine) -> entier {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour $k
}

# ══════════════════ instructions vérifiées ══════════════════

fn vf_check_instr($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $ln: liste<chaine>, $lt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $ass: entier, $ra: chaine, $err: liste<chaine>) {
  si (longueur($err) > 1) { retour 0 }
  $kd = $ik[$i]
  $lg0 = $ilg[$i]
  si ($kd == "aff") {
    $t = vf_check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si (vf_BASE($t) == "vide") { vf_signaler($lg0, "Rien à afficher ici", $err) }
    retour 0
  }
  si ($kd == "lire") {
    $nom = $ino[$i]
    $t = vf_env_get($nom, $vn, $vt)
    si ($t == "") {
      vf_reserver($nom, $lg0, $err)
      vf_env_put($nom, "entier|vide", $vn, $vt)
    }
    sinon {
      $bb = vf_BASE($t)
      si ($bb != "entier" et $bb != "flottant" et $bb != "rationnel") {
        vf_signaler($lg0, "Ne peut pas lire dans une variable " + vf_nomty($t) + " (entier/flottant attendus)", $err)
      }
    }
    retour 0
  }
  si ($kd == "affi") {
    $t = vf_check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si (vf_BASE($t) == "vide") {
      vf_signaler($lg0, "Impossible d'affecter une valeur sans type", $err)
      retour 0
    }
    $nom = $ino[$i]
    $ex = vf_env_get($nom, $vn, $vt)
    $est_global = 0
    si ($nom == "i" ou $nom == "pi" ou $nom == "phi" ou $nom == "e") { $est_global = 1 }
    si ($est_global == 1) { $ex = "" }
    # front.rs:1585-1587 — une globale est un SHADOW : aucun contrôle de type.
    # L'émetteur n'a pas ce repli vers $gn ; le retirer ici aussi (il faisait
    # rejeter `$c = sous_chaine(...)` dans echapper() face à la globale `c`:table).
    $cible = $t
    si ($ex != "") {
      $cible = $ex
      $be = vf_BASE($ex)
      $bt = vf_BASE($t)
      $domaine_ok = 1
      # front.rs:1589 — Dyn de part ou d'autre : affectation laissée passer.
      si ($be == "valeur" ou $bt == "valeur" ou $be == "?" ou $bt == "?") { $domaine_ok = 1 }
      sinon si ($bt == "entier" et $be == "rationnel") { $domaine_ok = 1 }
      sinon si ($t != $ex) {
        $domaine_ok = 0
        si (vf_promote($t, $ex) == $ex et vf_estnum($t) et vf_estnum($ex)) { $domaine_ok = 1 }
        si ($domaine_ok == 0) {
          vf_signaler($lg0, "'" + $nom + "' est " + vf_nomty($ex) + ", on ne peut pas y stocker du " + vf_nomty($t), $err)
          retour 0
        }
      }
    }
    vf_reserver($nom, $lg0, $err)
    vf_env_put($nom, $cible, $vn, $vt)
    retour 0
  }
  si ($kd == "si") {
    $t = vf_check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si (vf_BASE($t) != "booleen") {
      vf_signaler($lg0, "La condition de si doit être booléenne, trouvé " + vf_nomty($t), $err)
      retour 0
    }
    vf_parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err)
    $b2 = $ib2[$i]
    si ($b2 != "" et longueur($err) == 1) {
      vf_parcourir($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err)
    }
    retour 0
  }
  si ($kd == "tq") {
    $t = vf_check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si (vf_BASE($t) != "booleen") {
      vf_signaler($lg0, "La condition de tant_que doit être booléenne, trouvé " + vf_nomty($t), $err)
      retour 0
    }
    vf_parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err)
    retour 0
  }
  si ($kd == "pour") {
    $nom = $ino[$i]
    si (vf_env_get($nom, $vn, $vt) != "") {
      vf_signaler($lg0, "La variable de boucle '" + $nom + "' existe déjà", $err)
      retour 0
    }
    $td = vf_check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    $tfin = vf_check_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                       $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    si (vf_BASE($td) != "entier" ou vf_BASE($tfin) != "entier") {
      vf_signaler($lg0, "pour…de…vers exige des bornes entières", $err)
      retour 0
    }
    vf_reserver($nom, $lg0, $err)
    vf_env_put($nom, "entier|vide", $vn, $vt)
    vf_parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err)
    retour 0
  }
  si ($kd == "retour") {
    si ($ass == 0) {
      vf_signaler($lg0, "'retour' hors de fonction", $err)
      retour 0
    }
    $e = $ie[$i]
    si ($e < 0) {
      si ($ra != "vide|vide") {
        vf_signaler($lg0, "La fonction doit retourner un " + vf_nomty($ra), $err)
      }
    }
    sinon {
      $t = vf_check_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
      $bad = 0
      # front.rs:1701 — retour sans annotation (Dyn) : accepte n'importe quel type.
      si (vf_BASE($ra) == "?") { $bad = 0 }
      sinon si ($t != $ra) {
        si (non(vf_estnum($t) et vf_estnum($ra) et vf_promote($t, $ra) == $ra)) { $bad = 1 }
      }
      si ($bad == 1) {
        vf_signaler($lg0, "La fonction retourne " + vf_nomty($t) + ", attendu " + vf_nomty($ra), $err)
      }
    }
    retour 0
  }
  si ($kd == "expr") {
    vf_check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "bloc") {
    vf_parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err)
  }
}

fn vf_parcourir($cs: chaine,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $ln: liste<chaine>, $lt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $ass: entier, $ra: chaine, $err: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          vf_check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                      $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                      $foi, $fot, $fof, $ass, $ra, $err)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    vf_check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                $foi, $fot, $fof, $ass, $ra, $err)
  }
}

# comparution lexicale par codepoints = ordre std::map du moteur
fn vf_cmp_str($a: chaine, $b: chaine) -> entier {
  $la = longueur($a)
  $lb = longueur($b)
  $n = $la
  si ($lb < $n) { $n = $lb }
  $i = 0
  tant_que ($i < $n) {
    $ca = ordre($a[$i])
    $cb = ordre($b[$i])
    si ($ca < $cb) { retour -1 }
    si ($ca > $cb) { retour 1 }
    $i = $i + 1
  }
  si ($la < $lb) { retour -1 }
  si ($la > $lb) { retour 1 }
  retour 0
}


# ——— pré-passe : collecte des globales du niveau supérieur ———
# Miroir de verifier() (front.rs) : seules les affectations et lectures de
# tête alimentent GLOBALS. En particulier les « pour » ne doivent PAS y
# ajouter leur variable de boucle — sinon la passe 2 la voit « déjà existante ».

fn vf_collecter_glob_instr($i: entier,
                        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                        $lg: liste<entier>, $al: liste<entier>,
                        $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                        $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                        $gn: liste<chaine>, $gt: liste<chaine>,
                        $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
                        $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) {
  $kd = $ik[$i]
  $tmp = [""]
  # « aff » = afficher (>>), « affi » = affectation (ident = expr).
  si ($kd == "affi") {
    $t = vf_check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $gn, $gt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $tmp)
    si (vf_BASE($t) != "vide") {
      $nom = $ino[$i]
      $ex = vf_env_get($nom, $gn, $gt)
      $cible = $t
      si ($ex != "") { $cible = $ex }
      vf_env_put($nom, $cible, $gn, $gt)
    }
  }
  sinon si ($kd == "lire") {
    $nom = $ino[$i]
    $t = vf_env_get($nom, $gn, $gt)
    si ($t == "") { $t = "entier|vide" }
    vf_env_put($nom, $t, $gn, $gt)
  }
}

fn vf_collecter_globaux($cs: chaine,
                     $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                     $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                     $lg: liste<entier>, $al: liste<entier>,
                     $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                     $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                     $gn: liste<chaine>, $gt: liste<chaine>,
                     $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
                     $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    $c = ordre($cs[$j])
    si ($c == 44) {
      si ($cur != "") {
        vf_collecter_glob_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                             $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $gn, $gt,
                             $fnoms, $fparams, $fret, $foi, $fot, $fof)
        $cur = ""
      }
    }
    sinon { $cur = $cur + $cs[$j] }
    $j = $j + 1
  }
  si ($cur != "") {
    vf_collecter_glob_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                         $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $gn, $gt,
                         $fnoms, $fparams, $fret, $foi, $fot, $fof)
  }
}


# ——— fusion des « importer "f.rose" » (miroir de analyser_fichier_rec) ———
# Le moteur Rust analyse le fichier en mode brut, fusionne les signatures
# importées, puis vérifie UNE fois le programme complet. On recopie ici le
# texte des jardins importés en fin de source pour que la descente les voie.

fn vf_fusionner_imports_prof($src: chaine, $prof: entier) -> chaine {
  si ($prof > 8) { retour $src }
  $res = $src
  $ajout = ""
  $n = vf_nb_pieces($src, 10)
  $k = 1
  tant_que ($k <= $n) {
    $l = vf_piece($src, 10, $k)
    $nl = longueur($l)
    $p = 0
    tant_que ($p < $nl et (ordre($l[$p]) == 32 ou ordre($l[$p]) == 9)) { $p = $p + 1 }
    si (sous_chaine($l, $p, $p + 8) == "importer") {
      $q = $p + 8
      tant_que ($q < $nl et (ordre($l[$q]) == 32 ou ordre($l[$q]) == 9)) { $q = $q + 1 }
      si ($q < $nl et ordre($l[$q]) == 34) {
        $debut = $q + 1
        $fin = $debut
        tant_que ($fin < $nl et ordre($l[$fin]) != 34) { $fin = $fin + 1 }
        $chemin = sous_chaine($l, $debut, $fin)
        $ajout = $ajout + "\n" + vf_fusionner_imports_prof(lire_texte($chemin), $prof + 1)
      }
    }
    $k = $k + 1
  }
  retour $res + $ajout
}

fn vf_fusionner_imports($src: chaine) -> chaine {
  retour vf_fusionner_imports_prof($src, 0)
}

fn verifier_source($src_brut: chaine) -> chaine {
$src = vf_fusionner_imports($src_brut)
$N = longueur($src)

# —— phase 1 : lexage vers $gen (types), $x (textes), $gl (lignes) ——
$gen = [""]
$x = [""]
$gl = [0]
$i = 0
$suiv = -1
$c = 0
$cc = 0
$ok = 1
$t = ""
$nx = 0
$q = 0
$buf = ""
$txt = ""
$nu = ""
$dollar = 0
$flott = 0
$point_ok = 0
$lnr = 1

$cles = table()
inserer($cles, "fn", 1)
inserer($cles, "retour", 1)
inserer($cles, "si", 1)
inserer($cles, "sinon", 1)
inserer($cles, "tant_que", 1)
inserer($cles, "pour", 1)
inserer($cles, "de", 1)
inserer($cles, "vers", 1)
inserer($cles, "vrai", 1)
inserer($cles, "faux", 1)
inserer($cles, "et", 1)
inserer($cles, "ou", 1)
inserer($cles, "non", 1)
inserer($cles, "div", 1)
inserer($cles, "entier", 1)
inserer($cles, "rationnel", 1)
inserer($cles, "flottant", 1)
inserer($cles, "booleen", 1)
inserer($cles, "chaine", 1)
inserer($cles, "liste", 1)
inserer($cles, "table", 1)

$dernier = "debut"

tant_que ($i < $N) {
  $c = ordre($src[$i])
  $suiv = -1
  si ($i + 1 < $N) { $suiv = ordre($src[$i + 1]) }
  $pchar = 10
  si ($i > 0) { $pchar = ordre($src[$i - 1]) }
  $apres = 0
  si ($dernier == "nombre" ou $dernier == "flottant" ou $dernier == "chaine" ou $dernier == "ident" ou $dernier == "mot" ou $dernier == "rparen" ou $dernier == "rbracket" ou $dernier == "multifacto" ou $dernier == "diese" ou $dernier == "terminal" ou $dernier == "superfacto" ou $dernier == "chapeau" ou $dernier == "deuxpts") { $apres = 1 }

  si ($c == 32 ou $c == 9 ou $c == 13 ou $c == 10) {
    si ($c == 10) { $lnr = $lnr + 1 }
    $i = $i + 1
  }
  sinon si ($c == 37 et $suiv == 37 et ($i == 0 ou $pchar == 10)) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1 }
    }
  }
  sinon si ($c == 35) {
    si ($apres == 1 et $i > 0 et $pchar != 32 et $pchar != 9 et $pchar != 13 et $pchar != 10) {
      joindre($gen, "diese")
      joindre($x, "#")
      joindre($gl, $lnr)
      $i = $i + 1
      $dernier = "diese"
    } sinon {
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 10) { $ok = 0 }
        sinon { $i = $i + 1 }
      }
    }
  }
  sinon si ($c == 47 et $suiv == 47) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1 }
    }
  }
  sinon si ($c == 33) {
    si ($apres == 0) {
      joindre($gen, "sfact"); joindre($x, "!"); joindre($gl, $lnr); $i = $i + 1; $dernier = "sfact"
    } sinon si ($suiv == 61) {
      joindre($gen, "!="); joindre($x, "!="); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
    } sinon {
      $txt = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 33 et non ($i + 1 < $N et ordre($src[$i + 1]) == 61)) {
          $txt = $txt + "!"
          $i = $i + 1
        } sinon { $ok = 0 }
      }
      joindre($gen, "multifacto"); joindre($x, $txt); joindre($gl, $lnr); $dernier = "multifacto"
    }
  }
  sinon si ($c == 63) {
    si ($suiv == 61) {
      joindre($gen, "≈"); joindre($x, "?="); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
    } sinon {
      $est_debut = 0
      si ($pchar == 10 ou $pchar == 59 ou $pchar == 62 ou $i == 0) { $est_debut = 1 }
      $j = $i + 1
      $okq = 1
      tant_que ($okq == 1) {
        si ($j >= $N) { $okq = 0 }
        sinon si (ordre($src[$j]) == 32 ou ordre($src[$j]) == 9 ou ordre($src[$j]) == 13) { $j = $j + 1 }
        sinon { $okq = 0 }
      }
      $suit_paren = 0
      si ($j < $N et ordre($src[$j]) == 40) { $suit_paren = 1 }
      $ouvre_si = 0
      si ($est_debut == 1 et $suit_paren == 1) { $ouvre_si = 1 }
      si ($ouvre_si == 0) {
        joindre($gen, "terminal")
        joindre($x, "?")
      } sinon {
        joindre($gen, "?")
        joindre($x, "?")
      }
      joindre($gl, $lnr)
      $i = $i + 1
      $dernier = "autre"
    }
  }
  sinon si ($c == 34 ou $c == 39) {
    $q = $c
    $dl = $lnr
    $i = $i + 1
    $buf = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon {
        $cc = ordre($src[$i])
        si ($cc == 92) {
          si ($i + 1 >= $N) { $ok = 0 }
          sinon {
            $nx = ordre($src[$i + 1])
            si ($nx == 110) { $buf = $buf + "\n" }
            sinon si ($nx == 116) { $buf = $buf + "\t" }
            sinon si ($nx == 92 ou $nx == 34 ou $nx == 39) { $buf = $buf + sous_chaine($src, $i + 1, $i + 2) }
            sinon { $buf = $buf + "\\" + sous_chaine($src, $i + 1, $i + 2) }
            $i = $i + 2
          }
        }
        sinon si ($cc == $q) {
          $i = $i + 1
          $ok = 0
        }
        sinon {
          si ($cc == 10) { $lnr = $lnr + 1 }
          $buf = $buf + $src[$i]
          $i = $i + 1
        }
      }
    }
    joindre($gen, "chaine"); joindre($x, $buf); joindre($gl, $dl); $dernier = "chaine"
  }
  sinon si (vf_est_chiffre($c)) {
    $txt = ""
    $flott = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (vf_est_chiffre(ordre($src[$i]))) {
        $txt = $txt + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    $point_ok = 0
    si ($i < $N) {
      si ($i + 1 < $N) {
        si (ordre($src[$i]) == 46 et vf_est_chiffre(ordre($src[$i + 1]))) { $point_ok = 1 }
      }
    }
    si ($point_ok == 1) {
      $flott = 1
      $txt = $txt + "."
      $i = $i + 1
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (vf_est_chiffre(ordre($src[$i]))) {
          $txt = $txt + $src[$i]
          $i = $i + 1
        }
        sinon { $ok = 0 }
      }
    }
    si ($flott == 1) { joindre($gen, "flottant"); $dernier = "flottant" }
    sinon { joindre($gen, "nombre"); $dernier = "nombre" }
    joindre($x, $txt)
    joindre($gl, $lnr)
  }
  sinon si ($c == 960) {
    joindre($gen, "mot"); joindre($x, "π"); joindre($gl, $lnr); $i = $i + 1; $dernier = "mot"
  }
  sinon si ($c == 966) {
    joindre($gen, "mot"); joindre($x, "φ"); joindre($gl, $lnr); $i = $i + 1; $dernier = "mot"
  }
  sinon si ($c == 36) {
    $est_var = 0
    si ($suiv != -1 et vf_est_lettre($suiv)) { $est_var = 1 }
    si ($est_var == 0) {
      joindre($gen, "superfacto"); joindre($x, "$"); joindre($gl, $lnr); $i = $i + 1; $dernier = "superfacto"
    } sinon {
      $i = $i + 1
      $nu = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (vf_est_suite(ordre($src[$i]))) {
          $nu = $nu + $src[$i]
          $i = $i + 1
        }
        sinon { $ok = 0 }
      }
      joindre($gen, "ident"); joindre($x, $nu); joindre($gl, $lnr); $dernier = "ident"
    }
  }
  sinon si (vf_est_lettre($c)) {
    $nu = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (vf_est_suite(ordre($src[$i]))) {
        $nu = $nu + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    si (cle_existe($cles, $nu)) { joindre($gen, "ident") } sinon { joindre($gen, "mot") }
    joindre($x, $nu)
    joindre($gl, $lnr)
    $dernier = "mot"
  }
  sinon si (vf_paire($c, $suiv) != "") {
    joindre($gen, vf_paire($c, $suiv)); joindre($x, sous_chaine($src, $i, $i + 2)); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
  }
  sinon si ($c == 62 et $suiv == 62) { joindre($gen, ">>"); joindre($x, ">>"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 60 et $suiv == 60) { joindre($gen, "<<"); joindre($x, "<<"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 45 et $suiv == 62) { joindre($gen, "->"); joindre($x, "->"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 61) { joindre($gen, "="); joindre($x, "="); joindre($gl, $lnr); $i = $i + 1; $dernier = "autre" }
  sinon si ($c == 58 et $suiv == 58) { joindre($gen, "::"); joindre($x, "::"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 178) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "2"); joindre($gl, $lnr); $i = $i + 1; $dernier = "nombre" }
  sinon si ($c == 179) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "3"); joindre($gl, $lnr); $i = $i + 1; $dernier = "nombre" }
  sinon si (vf_uni($c) != "") { joindre($gen, vf_uni($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1; $dernier = "autre" }
  sinon si (vf_car($c) != "") {
    joindre($gen, vf_car($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1
    si ($c == 41) { $dernier = "rparen" }
    sinon si ($c == 93) { $dernier = "rbracket" }
    sinon si ($c == 94) { $dernier = "chapeau" }
    sinon si ($c == 58) { $dernier = "deuxpts" }
    sinon { $dernier = "autre" }
  }
  sinon { $i = $i + 1 }
}
joindre($gen, "eof")
joindre($x, "")
joindre($gl, $lnr)


# —— phase 2 : descente vers les pools ——
$k = [""]
$tx = [""]
$tf = [""]
$a = [-1]
$b = [-1]
$as = [0]
$ac = [0]
$lg = [0]
$al = [-1]

$ik = [""]
$ino = [""]
$ie = [-1]
$ie2 = [-1]
$ib1 = [""]
$ib2 = [""]
$ilg = [0]

$fnoms = [""]
$fext = [""]
$fparams = [""]
$fret = [""]
$fcorps = [""]
$fligne = [0]

$foi = [-1]
$fot = [""]
$fof = [""]
$err = [""]

$topb = ""
$p = 1
$dll = ""
$son = ""
$sym = ""

tant_que (vf_T0($gen, $p) != "eof") {
  $t = vf_T0($gen, $p)
  si ($t == ";") { $p = $p + 1 }
  # importer "f.rose" : noté, non vérifié ici (rose verif résout dans analyser_fichier)
  sinon si (vf_EMOT($gen, $x, $p, "importer")) {
    $q = $p + 1
    si (vf_T0($gen, $q) == "chaine") { $q = $q + 1 }
    $p = $q
  }
  sinon si ($t == "@" et (vf_EMOT($gen, $x, $p + 1, "dll") ou vf_EMOT($gen, $x, $p + 1, "sym"))) {
    $genre = vf_VX0($x, $p + 1)
    $q = $p + 2
    si (vf_T0($gen, $q) == "(") { $q = $q + 1 }
    si (vf_T0($gen, $q) == "chaine") {
      si ($genre == "dll") { $dll = vf_VX0($x, $q) }
      sinon { $sym = vf_VX0($x, $q) }
      $q = $q + 1
      si (vf_T0($gen, $q) == ",") {
        $q = $q + 1
        $son = vf_VX0($x, $q)
        $q = $q + 1
      }
    }
    si (vf_T0($gen, $q) == ")") { $q = $q + 1 }
    $p = $q
  }
  sinon si (vf_EMOT($gen, $x, $p, "fn")) {
    $r = vf_def_fn($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $fnoms, $fext, $fparams, $fret, $fcorps, $fligne)
    $p = vf_SEPR($r)
  }
  sinon {
    $r = vf_instruction($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $p = vf_SEPR($r)
    si ($topb != "") { $topb = $topb + "," }
    $topb = $topb + vf_NOD($r)
  }
}

# —— tri des fonctions par nom (ordre std::map) ——
$ordre = [0]
$nn = longueur($fnoms)
$w = 1
tant_que ($w < $nn) {
  $best = -1
  $j = 1
  tant_que ($j < $nn) {
    $pris = 0
    $u = 1
    $no2 = longueur($ordre)
    tant_que ($u < $no2) {
      si ($ordre[$u] == $j) { $pris = 1 }
      $u = $u + 1
    }
    si ($pris == 0) {
      si ($best < 0) { $best = $j }
      sinon si (vf_cmp_str($fnoms[$j], $fnoms[$best]) < 0) { $best = $j }
    }
    $j = $j + 1
  }
  joindre($ordre, $best)
  $w = $w + 1
}

# —— passe 1 : repli de constantes (fonctions triées, puis niveau supérieur) ——
# « réparation du compteur i » (front.rs) : si un « pour i » existe, le mot « i »
# est le compteur entier, PAS le littéral imaginaire. On le note en $foi[0].
$i_compteur = 0
$j = 1
tant_que ($j < longueur($ik)) {
  si ($ik[$j] == "pour" et $ino[$j] == "i") { $i_compteur = 1 }
  $j = $j + 1
}
$foineuf = [$i_compteur]
$j = 0
tant_que ($j < longueur($foi)) {
  joindre($foineuf, $foi[$j])
  $j = $j + 1
}
$foi = $foineuf
$fotneuf = [""]
$j = 0
tant_que ($j < longueur($fot)) {
  joindre($fotneuf, $fot[$j])
  $j = $j + 1
}
$fot = $fotneuf
$fofneuf = [""]
$j = 0
tant_que ($j < longueur($fof)) {
  joindre($fofneuf, $fof[$j])
  $j = $j + 1
}
$fof = $fofneuf

$w = 1
tant_que ($w < longueur($ordre)) {
  $ix = $ordre[$w]
  si ($fext[$ix] == "" et longueur($err) == 1) {
    vf_replier_chaine($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
  $w = $w + 1
}
si (longueur($err) == 1) {
  vf_replier_chaine($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                 $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
}

# —— passe 2 : vérification — collecte d'abord les globals du niveau principal ——
$gln = [""]
$glt = [""]
# Le corps principal est vérifié en premier avec ses variables comme globales :
# le moteur Rust collecte GLOBALS avant de vérifier les fonctions.
vf_collecter_globaux($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                  $gln, $glt,
                  $fnoms, $fparams, $fret, $foi, $fot, $fof)
$w = 1
tant_que ($w < longueur($ordre)) {
  si (longueur($err) == 1) {
    $ix = $ordre[$w]
    si ($fext[$ix] != "") {
      $ps = $fparams[$ix]
      $np = vf_nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = vf_piece($ps, 59, $u)
        $pp = vf_premier_pipe($ent)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        $bb = vf_BASE($pt)
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          vf_signaler($fligne[$ix], "Type " + vf_nomty($pt) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
        $u = $u + 1
      }
      $bb = vf_BASE($fret[$ix])
      si (longueur($err) == 1) {
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          vf_signaler($fligne[$ix], "Type " + vf_nomty($fret[$ix]) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
      }
    }
    sinon {
      $lc = [""]
      $lct = [""]
      $ps = $fparams[$ix]
      $np = vf_nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = vf_piece($ps, 59, $u)
        $pp = vf_premier_pipe($ent)
        $pn = sous_chaine($ent, 0, $pp)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        vf_reserver($pn, 0, $err)
        vf_env_put($pn, $pt, $lc, $lct)
        $u = $u + 1
      }
      vf_parcourir($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $lc, $lct, $gln, $glt, $lc, $lct,
                $fnoms, $fparams, $fret, $foi, $fot, $fof, 1, $fret[$ix], $err)
    }
  }
  $w = $w + 1
}

# —— passe 2 (suite) : instructions de tête, environnement = globales ——
$lc = [""]
$lct = [""]
si (longueur($err) == 1) {
  vf_parcourir($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
            $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
            $gln, $glt, $gln, $glt, $lc, $lct,
            $fnoms, $fparams, $fret, $foi, $fot, $fof, 0, "vide|vide", $err)
}

si (longueur($err) > 1) { retour $err[1] } sinon { retour "vérifié" }
}

# J1 — vérification auto-hébergée : `--verif source.rose` -> verdict.
si (nb_arguments() >= 2 et argument(0) == "--verif") {
  >> verifier_source(lire_texte(argument(1)))
  quitter(0)
}

si (nb_arguments() >= 1) {
$src = em_source_rir()
si (longueur($src) >= 3 et sous_chaine($src, 0, 3) == "rir") {
$nfn = g5_parse($src)
$principal = 0
$i = 0
tant_que ($i < $nfn) {
  si ($g5_fn[$i] == "$principal") { $principal = $i }
  $i = $i + 1
}
$printl = g5_next()
$k = 0
tant_que ($k < 14) { g5_next(); $k = $k + 1 }
$g5_plist_l = g5_next()
$g5_allocl = g5_next()
$g5_lenl = g5_next()
$k = 0
# G5-UTF8 : comptage des points de code (+1..+6).
tant_que ($k < 6) { g5_next(); $k = $k + 1 }
$g5_ordl = g5_next()
$k = 0
# G5-UTF8 : décodage UTF-8 de 1..4 octets (+1..+3).
tant_que ($k < 3) { g5_next(); $k = $k + 1 }
$g5_sousl = g5_next()
$k = 0
# G5-UTF8 : conversion des indices de points de code en octets (+1..+10).
tant_que ($k < 10) { g5_next(); $k = $k + 1 }
$g5_idxl = g5_next()
$k = 0
# G5-TYPE : g5_emit_idx utilise $lbl, +1 (liste) et, depuis SH12,
# +3..+7 (recherche par cle dans une table). +2 (ex-"fin chaîne") est
# libre depuis le passage au scan UTF-8 ; les labels du scan sont pris
# par g5_next() en tête de fonction. Réserver trop
# peu de labels faisait de $g5_chl un DOUBLON d'un label interne de idx :
# chaque appel à `chaine()` atterrissait sur la queue de idx (`orr #1`),
# taguant un entier comme chaîne avant concaténation. Sept labels requis.
tant_que ($k < 7) { g5_next(); $k = $k + 1 }
$g5_chl = g5_next()
$k = 0
tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$g5_joindrel = g5_next()
$k = 0
tant_que ($k < 7) { g5_next(); $k = $k + 1 }   # SH3 : 5 labels internes + marge
$g5_inserrel = g5_next()
$k = 0
tant_que ($k < 5) { g5_next(); $k = $k + 1 }   # SH12 : inserer utilise +1..+4
$g5_supprl = g5_next()
$k = 0
tant_que ($k < 7) { g5_next(); $k = $k + 1 }   # SH12 : supprimer utilise +1..+6
$g5_entierl = g5_next()
$k = 0
tant_que ($k < 4) { g5_next(); $k = $k + 1 }
$g5_catl = g5_next()
$k = 0
tant_que ($k < 8) { g5_next(); $k = $k + 1 }
$g5_streql = g5_next()
$k = 0
tant_que ($k < 3) { g5_next(); $k = $k + 1 }
$g5_stub0l = g5_next()
$g5_stubsl = g5_next()
# SH3 : table() / cle_existe() — vraies routines (plus des stubs).
# SH4 : cle_existe utilise desormais les labels +4 et +5 (cles entieres).
$g5_tablel = g5_next()
$g5_clexl = g5_next()
$k = 0
tant_que ($k < 8) { g5_next(); $k = $k + 1 }   # SH12 : +8 (cle stockee non-chaine)
# G5-IO : réservation des labels des routines syscalls (4 internes chacune).
$g5_nbargs_l = g5_next()
$k = 0
tant_que ($k < 4) { g5_next(); $k = $k + 1 }
$g5_argument_l = g5_next()
$k = 0
tant_que ($k < 6) { g5_next(); $k = $k + 1 }
$g5_lire_l = g5_next()
$k = 0
tant_que ($k < 12) { g5_next(); $k = $k + 1 }
$g5_ecrire_l = g5_next()
$k = 0
tant_que ($k < 8) { g5_next(); $k = $k + 1 }
# J4 : mmap (1 label), mprotect (1), chmod (3 : +1/+2), execve (3 : +1/+2).
$g5_mmap_l = g5_next()
$g5_mprotect_l = g5_next()
$g5_chmod_l = g5_next()
$k = 0
tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$g5_execve_l = g5_next()
$k = 0
tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$exitl = g5_next()
# SH7 : une étiquette par routine C0 ; aucune n'utilise de label interne
# ($lbl+N), donc aucune réservation supplémentaire n'est nécessaire.
$g5_quitl = g5_next()
$g5_carl = g5_next()
$k = 0
# G5-UTF8 : encodage UTF-8 de 1..4 octets (+1..+4).
tant_que ($k < 4) { g5_next(); $k = $k + 1 }
# OCTET_BRUT : une seule étiquette (aucun label interne).
$g5_octetll = g5_next()
$g5_parl = g5_next()
$g5_absl = g5_next()
$k = 0; tant_que ($k < 1) { g5_next(); $k = $k + 1 }
$g5_minl = g5_next()
$k = 0; tant_que ($k < 1) { g5_next(); $k = $k + 1 }
$g5_maxl = g5_next()
$k = 0; tant_que ($k < 1) { g5_next(); $k = $k + 1 }
$g5_typel = g5_next()
$k = 0; tant_que ($k < 4) { g5_next(); $k = $k + 1 }
$g5_chbooll = g5_next()
$k = 0; tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$g5_hasardl = g5_next()
$k = 0; tant_que ($k < 2) { g5_next(); $k = $k + 1 }
$g5_grainel = g5_next()
# G5-BIG : 6 labels internes pour la promotion, 33 pour l'addition signée,
# 3 pour la négation, 12 pour la comparaison.
$g5_bigprol = g5_next()
$k = 0; tant_que ($k < 6) { g5_next(); $k = $k + 1 }
$g5_bigaddl = g5_next()
$k = 0; tant_que ($k < 35) { g5_next(); $k = $k + 1 }
$g5_bignegl = g5_next()
$k = 0; tant_que ($k < 3) { g5_next(); $k = $k + 1 }
$g5_bigcmpl = g5_next()
$k = 0; tant_que ($k < 12) { g5_next(); $k = $k + 1 }
# G5-UTF8 : routine de comparaison lexicographique des chaînes (+1..+7).
$g5_strcmpl = g5_next()
$k = 0; tant_que ($k < 7) { g5_next(); $k = $k + 1 }
g5_compile_fonction($principal, $principal, $printl, $exitl)
$i = 0
tant_que ($i < $nfn) {
  si ($i != $principal) { g5_compile_fonction($i, $principal, $printl, $exitl) }
  $i = $i + 1
}
g5_emit_alloc($g5_allocl)
g5_emit_len($g5_lenl)
g5_emit_ordre($g5_ordl)
g5_emit_sous($g5_sousl)
g5_emit_idx($g5_idxl)
g5_emit_ch($g5_chl)
g5_emit_join($g5_joindrel)
g5_emit_inser($g5_inserrel)
g5_emit_suppr($g5_supprl)
g5_emit_entier($g5_entierl)
g5_emit_cat($g5_catl)
g5_emit_streq($g5_streql)
g5_emit_stub0($g5_stub0l)
g5_emit_stubs($g5_stubsl)
g5_emit_table($g5_tablel)
g5_emit_clex($g5_clexl)
g5_emit_quit($g5_quitl)
g5_emit_car($g5_carl)
g5_emit_octetl($g5_octetll)
g5_emit_par($g5_parl)
g5_emit_abs($g5_absl)
g5_emit_min($g5_minl)
g5_emit_max($g5_maxl)
g5_emit_type($g5_typel)
g5_emit_chbool($g5_chbooll)
g5_emit_hasard($g5_hasardl)
g5_emit_graine($g5_grainel)
g5_emit_bigpromote($g5_bigprol)
g5_emit_bigadd($g5_bigaddl)
g5_emit_bigneg($g5_bignegl)
g5_emit_bigcmp($g5_bigcmpl)
g5_emit_strcmp($g5_strcmpl)
g5_emit_nbargs($g5_nbargs_l)
g5_emit_argument($g5_argument_l)
g5_emit_lire($g5_lire_l)
g5_emit_ecrire($g5_ecrire_l)
g5_emit_mmap($g5_mmap_l)
g5_emit_mprotect($g5_mprotect_l)
g5_emit_chmod($g5_chmod_l)
g5_emit_execve($g5_execve_l)
g5_emit_plist($g5_plist_l)
g5_emit_print($printl)
g5_mark($exitl)
g5_emit(movz(0, 0))
g5_emit(movz(8, 93))
g5_emit(SVC_I())
si (longueur($g5_err) > 0) {
  afficher_erreur("G5 : " + $g5_err[0])
  quitter(2)
}
$g5_code = g5_patch()
ecrire_bytes("/dev/stdout", g5_elf())
quitter(0)
}
}

# ── Substitution d'un nom de variable nu (bornes alphanumeriques) ──
fn substituer_nom($txt: chaine, $nom: chaine, $val: chaine) -> chaine {
  $res = ""
  $k = 0
  $ln = longueur($txt)
  $lnn = longueur($nom)
  tant_que ($k < $ln) {
    $ok = 0
    si ($k + $lnn <= $ln) {
      si (sous_chaine($txt, $k, $k + $lnn) == $nom) {
        $ok_avant = 1
        si ($k > 0) {
          $prec = sous_chaine($txt, $k - 1, $k)
          si (($prec >= "a" et $prec <= "z") ou ($prec >= "A" et $prec <= "Z") ou ($prec >= "0" et $prec <= "9") ou $prec == "_") {
            $ok_avant = 0
          }
        }
        $ok_apres = 1
        si ($k + $lnn < $ln) {
          $suiv = sous_chaine($txt, $k + $lnn, $k + $lnn + 1)
          si (($suiv >= "a" et $suiv <= "z") ou ($suiv >= "A" et $suiv <= "Z") ou ($suiv >= "0" et $suiv <= "9") ou $suiv == "_") {
            $ok_apres = 0
          }
        }
        si ($ok_avant == 1 et $ok_apres == 1) {
          $ok = 1
        }
      }
    }
    si ($ok == 1) {
      $res = $res + $val
      $k = $k + $lnn
    } sinon {
      $res = $res + sous_chaine($txt, $k, $k + 1)
      $k = $k + 1
    }
  }
  retour $res
}

# ── Constantes ELF64 ──
$ELFMAG = "\177ELF"
$ELFCLASS64 = 2
$ELFDATA2LSB = 1
$EV_CURRENT = 1
$ELFOSABI_SYSV = 0
$ET_EXEC = 2
$EM_AARCH64 = 183
$PT_LOAD = 1
$PF_R = 4
$PF_W = 2
$PF_X = 1
$SHT_NULL = 0
$SHT_PROGBITS = 1
$SHT_STRTAB = 3
$SHN_UNDEF = 0

# Adresse de chargement aarch64
$BASE_ADDR = 4194304
$TEXT_OFFSET = 4096
$TEXT_ADDR = $BASE_ADDR + $TEXT_OFFSET

# ── Émetteur ELF minimal : produit un binaire qui retourne 0 ──
fn fold_last_return($sub2: chaine) -> chaine {
  # La chaîne $sub2 est une suite d'expressions séparées par des espaces au
  # niveau 0 (une par « retour » dans le corps d'une fonction). On rend la
  # dernière expression, ou $sub2 si aucune découpe n'est nécessaire.
  $pos_dernier_espace = -1
  $prof_q = 0
  $qe = 0
  tant_que ($qe < longueur($sub2)) {
    $cq = sous_chaine($sub2, $qe, $qe + 1)
    si ($cq == "(" ou $cq == "[" ou $cq == "{") { $prof_q = $prof_q + 1 }
    si ($cq == ")" ou $cq == "]" ou $cq == "}") { $prof_q = $prof_q - 1 }
    si ($cq == " " et $prof_q == 0) { $pos_dernier_espace = $qe }
    $qe = $qe + 1
  }
  si ($pos_dernier_espace >= 0) {
    retour sous_chaine($sub2, $pos_dernier_espace + 1, longueur($sub2))
  }
  retour $sub2
}

# Rend la position de la prochaine parenthese ouvrante precedee immediatement
# par un identifiant alphanumerique (0 si aucune).
fn find_appel($s: chaine, $debut: entier) -> entier {
  $k = $debut
  $ln = longueur($s)
  tant_que ($k < $ln) {
    $c = sous_chaine($s, $k, $k + 1)
    si ($c == "(") {
      # reculer sur un identifiant
      $j = $k
      si ($j > 0) {
        $prev = sous_chaine($s, $j - 1, $j)
        si (($prev >= "a" et $prev <= "z") ou ($prev >= "A" et $prev <= "Z") ou ($prev >= "0" et $prev <= "9") ou $prev == "_") {
          retour $k
        }
      }
    }
    $k = $k + 1
  }
  retour -1
}

# Extrait la liste des arguments d'un appel starting a $pos_open (la
# position de "("), en remplissant la liste $out via joindre. Rend la
# position de la parenthese fermante.
fn lire_args_appel($s: chaine, $pos_open: entier) -> entier {
  $prof = 1
  $cur = ""
  $lst = [""]
  $nb = 0
  $p = $pos_open + 1
  $ln = longueur($s)
  $fin_p = $p
  $fini = 0
  tant_que ($p < $ln et $fini == 0) {
    $c = sous_chaine($s, $p, $p + 1)
    si ($c == "(" ou $c == "[" ou $c == "{") {
      $prof = $prof + 1
      $cur = $cur + $c
    } sinon si ($c == ")" ou $c == "]" ou $c == "}") {
      $prof = $prof - 1
      si ($prof == 0) {
        $fini = 1
        $fin_p = $p
      } sinon {
        $cur = $cur + $c
      }
    } sinon si ($c == "," et $prof == 1) {
      # trim
      $ca = $cur
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
      joindre($lst, $ca)
      $nb = $nb + 1
      $cur = ""
    } sinon {
      $cur = $cur + $c
    }
    $p = $p + 1
  }
  $ca = $cur
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
  si (longueur($ca) > 0) {
    joindre($lst, $ca)
    $nb = $nb + 1
  }
  # table de retour : on la construit par paires (pos, n, args) via des vars
  # locales : $pos_ferm, $nb_args_out, $lst_args_out
  $pos_ferm = $fin_p
  $nb_args_out = $nb
  $lst_args_out = $lst
  # On les expose via une table renvoyée ; pour rester simple on rend 3 valeurs
  # séparees par des espaces via une chaine, que le caller décompose.
  retour $fin_p
}

# Variante : lit les args d'un appel et rend une liste $out (première cellule
# = position fermante, deuxième = nombre d'args, les suivantes = args).
fn lire_args_appel2($s: chaine, $pos_open: entier) -> entier {
  $prof = 1
  $cur = ""
  $lst = ["#"]
  $nb = 0
  $p = $pos_open + 1
  $ln = longueur($s)
  $fin_p = $p
  $fini = 0
  tant_que ($p < $ln et $fini == 0) {
    $c = sous_chaine($s, $p, $p + 1)
    si ($c == "(" ou $c == "[" ou $c == "{") {
      $prof = $prof + 1
      $cur = $cur + $c
    } sinon si ($c == ")" ou $c == "]" ou $c == "}") {
      $prof = $prof - 1
      si ($prof == 0) {
        $fini = 1
        $fin_p = $p
      } sinon {
        $cur = $cur + $c
      }
    } sinon si ($c == "," et $prof == 1) {
      $ca = $cur
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
      $na = longueur($ca)
      tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
      joindre($lst, $ca)
      $nb = $nb + 1
      $cur = ""
    } sinon {
      $cur = $cur + $c
    }
    $p = $p + 1
  }
  $ca = $cur
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, $na); $na = longueur($ca) }
  $na = longueur($ca)
  tant_que ($na > 0 et sous_chaine($ca, $na - 1, $na) == " ") { $ca = sous_chaine($ca, 0, $na - 1); $na = longueur($ca) }
  si (longueur($ca) > 0) {
    joindre($lst, $ca)
    $nb = $nb + 1
  }
  $lia_out = $lst
  $lia_n = $nb
  retour $fin_p
}

$lia_n = 0
$lia_out = ["#"]

# Extraire l'expression situee apres le premier "retour" au niveau 0 d'un
# bloc (ignorant les accolades imbriquees). Rend le bloc tel quel si aucun
# "retour" de niveau 0 n'est trouve.
fn extraire_retour($_b: chaine) -> chaine {
  $_i = 0
  $_ln = longueur($_b)
  $_prof = 0
  $_ret = ""
  tant_que ($_i < $_ln) {
    $_ch = sous_chaine($_b, $_i, $_i + 1)
    si ($_ch == "{") { $_prof = $_prof + 1 }
    sinon si ($_ch == "}") { $_prof = $_prof - 1 }
    sinon si ($_prof == 0) {
      si ($_i + 6 <= $_ln et sous_chaine($_b, $_i, $_i + 6) == "retour") {
        $_j = $_i + 6
        tant_que ($_j < $_ln et sous_chaine($_b, $_j, $_j + 1) == " ") { $_j = $_j + 1 }
        $_ret = sous_chaine($_b, $_j, $_ln)
        $_nbret = longueur($_ret)
        tant_que ($_nbret > 0 et (sous_chaine($_ret, $_nbret - 1, $_nbret) == " " ou sous_chaine($_ret, $_nbret - 1, $_nbret) == "
" ou sous_chaine($_ret, $_nbret - 1, $_nbret) == "	")) {
          $_ret = sous_chaine($_ret, 0, $_nbret - 1)
          $_nbret = longueur($_ret)
        }
        retour $_ret
      }
    }
    $_i = $_i + 1
  }
  retour $_b
}

# Resoudre un corps de fonction (eventuellement contenant des `si`) en
# l'expression de retour nue. Les arguments ont deja ete substitues dans
# $corps. Evalue les conditions `si` a la compilation via eval_expr.
fn resoudre_corps($_c: chaine) -> chaine {
  $_pos = 0
  $_ln = longueur($_c)
  $_ret = ""
  $_fini = 0
  tant_que ($_pos < $_ln et $_fini == 0) {
    tant_que ($_pos < $_ln et (sous_chaine($_c, $_pos, $_pos + 1) == " " ou sous_chaine($_c, $_pos, $_pos + 1) == "
" ou sous_chaine($_c, $_pos, $_pos + 1) == "	")) { $_pos = $_pos + 1 }
    si ($_pos >= $_ln) { $_fini = 1 }
    sinon si (sous_chaine($_c, $_pos, $_pos + 2) == "si") {
      $_cc = ""
      si ($_pos + 2 < $_ln) { $_cc = sous_chaine($_c, $_pos + 2, $_pos + 3) }
      si ($_cc != " " et $_cc != "(") { $_fini = 1 }
      sinon {
        $_p = $_pos + 3
        tant_que ($_p < $_ln et sous_chaine($_c, $_p, $_p + 1) == " ") { $_p = $_p + 1 }
        si ($_p >= $_ln ou sous_chaine($_c, $_p, $_p + 1) != "(") { $_fini = 1 }
        sinon {
          $_cond = ""
          $_prof = 1
          $_p = $_p + 1
          tant_que ($_p < $_ln et $_prof > 0) {
            $_ch = sous_chaine($_c, $_p, $_p + 1)
            si ($_ch == "(") { $_prof = $_prof + 1 }
            sinon si ($_ch == ")") { $_prof = $_prof - 1 }
            si ($_prof > 0) { $_cond = $_cond + $_ch }
            $_p = $_p + 1
          }
          $_cond_val = eval_expr($_cond)
          $_est_vrai = 1
          si ($_cond_val == "0" ou $_cond_val == "faux" ou $_cond_val == "" ou longueur($_cond_val) == 0) { $_est_vrai = 0 }
          tant_que ($_p < $_ln et sous_chaine($_c, $_p, $_p + 1) == " ") { $_p = $_p + 1 }
          si ($_p >= $_ln ou sous_chaine($_c, $_p, $_p + 1) != "{") { $_fini = 1 }
          sinon {
            $_prof = 1
            $_p = $_p + 1
            $_debut_a = $_p
            tant_que ($_p < $_ln et $_prof > 0) {
              $_ch = sous_chaine($_c, $_p, $_p + 1)
              si ($_ch == "{") { $_prof = $_prof + 1 }
              sinon si ($_ch == "}") { $_prof = $_prof - 1 }
              $_p = $_p + 1
            }
            $_fin_a = $_p - 1
            $_alors = sous_chaine($_c, $_debut_a, $_fin_a)
            si ($_est_vrai == 1) {
              $_ret = extraire_retour($_alors)
              $_fini = 1
            } sinon {
              tant_que ($_p < $_ln et (sous_chaine($_c, $_p, $_p + 1) == " " ou sous_chaine($_c, $_p, $_p + 1) == "
" ou sous_chaine($_c, $_p, $_p + 1) == "	")) { $_p = $_p + 1 }
              $_trouve_sinon = 0
              si ($_p + 5 <= $_ln) {
                si (sous_chaine($_c, $_p, $_p + 1) == "s" et sous_chaine($_c, $_p + 1, $_p + 2) == "i" et sous_chaine($_c, $_p + 2, $_p + 3) == "n" et sous_chaine($_c, $_p + 3, $_p + 4) == "o" et sous_chaine($_c, $_p + 4, $_p + 5) == "n") {
                  $_trouve_sinon = 1
                }
              }
              si ($_trouve_sinon == 1) {
                $_p2 = $_p + 5
                tant_que ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == " ") { $_p2 = $_p2 + 1 }
                $_cc2 = ""
                si ($_p2 + 2 <= $_ln) { $_cc2 = sous_chaine($_c, $_p2, $_p2 + 2) }
                si ($_cc2 == "si") {
                  $_pos = $_p2
                } sinon {
                  tant_que ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == " ") { $_p2 = $_p2 + 1 }
                  si ($_p2 < $_ln et sous_chaine($_c, $_p2, $_p2 + 1) == "{") {
                    $_prof = 1
                    $_p2 = $_p2 + 1
                    $_debut_s = $_p2
                    tant_que ($_p2 < $_ln et $_prof > 0) {
                      $_ch = sous_chaine($_c, $_p2, $_p2 + 1)
                      si ($_ch == "{") { $_prof = $_prof + 1 }
                      sinon si ($_ch == "}") { $_prof = $_prof - 1 }
                      $_p2 = $_p2 + 1
                    }
                    $_fin_s = $_p2 - 1
                    $_sinon_bloc = sous_chaine($_c, $_debut_s, $_fin_s)
                    $_ret = extraire_retour($_sinon_bloc)
                    $_fini = 1
                  } sinon {
                    $_fini = 1
                  }
                  $_pos = $_ln
                }
              } sinon {
                $_pos = $_p
              }
            }
          }
        }
      }
    } sinon {
      $_reste = sous_chaine($_c, $_pos, $_ln)
      $_ret = extraire_retour($_reste)
      $_fini = 1
    }
  }
  si (longueur($_ret) == 0) { retour $_c } sinon { retour $_ret }
}

# Plier iterativement une expression `$expr` qui peut contenir des appels a
# des fonctions deja enregistrees dans $fn_noms/$fn_params/$fn_retours.
fn plier_expression($expr: chaine) -> chaine {
  $cour = $expr
  $tour = 0
  tant_que ($tour < 256) {
    $tour = $tour + 1
    # si entierement numerique, evaluer.
    $tn = 1
    $qn = 0
    $lnc = longueur($cour)
    tant_que ($qn < $lnc) {
      $cn = sous_chaine($cour, $qn, $qn + 1)
      si (($cn >= "a" et $cn <= "z") ou ($cn >= "A" et $cn <= "Z")) {
        $tn = 0
        $qn = $lnc
      }
      $qn = $qn + 1
    }
    si ($tn == 1 et $lnc > 0) {
      $ev = eval_expr($cour)
      si (longueur($ev) > 0) { $cour = $ev }
      $tour = 256
    } sinon {
      # trouver le prochain "nom(" le plus a gauche
      $p = find_appel($cour, 0)
      si ($p < 0) { $tour = 256 }
      sinon {
        # lire l'identifiant
        $fin_id = $p
        $debut_id = $p
        tant_que ($debut_id > 0) {
          $cp = sous_chaine($cour, $debut_id - 1, $debut_id)
          si (($cp >= "a" et $cp <= "z") ou ($cp >= "A" et $cp <= "Z") ou ($cp >= "0" et $cp <= "9") ou $cp == "_") {
            $debut_id = $debut_id - 1
          } sinon {
            $debut_id = 0
          }
        }
        $nom_f = sous_chaine($cour, $debut_id, $fin_id)
        # est-ce une fn connue ?
        $fi = 1
        $trouve = 0
        tant_que ($fi <= $nb_fn) {
          si ($fn_noms[$fi] == $nom_f) { $trouve = $fi }
          $fi = $fi + 1
        }
        si ($trouve == 0) { $tour = 256 }
        sinon {
          $pos_f = lire_args_appel2($cour, $p)
          $nb_a2 = $lia_n
          $lst_a2 = $lia_out
          # lire les params de la fn : extraire chaque "$nom".
          $pr = $fn_params[$trouve]
          $pn = ["#"]
          $pn_n = 0
          $ip = 0
          $lpr = longueur($pr)
          tant_que ($ip < $lpr) {
            $ch = sous_chaine($pr, $ip, $ip + 1)
            si ($ch == "$") {
              $nom_w = "$"
              $ip = $ip + 1
              $fin_w = 0
              tant_que ($ip < $lpr et $fin_w == 0) {
                $ch2 = sous_chaine($pr, $ip, $ip + 1)
                si (($ch2 >= "a" et $ch2 <= "z") ou ($ch2 >= "A" et $ch2 <= "Z") ou ($ch2 >= "0" et $ch2 <= "9") ou $ch2 == "_") {
                  $nom_w = $nom_w + $ch2
                  $ip = $ip + 1
                } sinon {
                  $fin_w = 1
                }
              }
              joindre($pn, $nom_w)
              $pn_n = $pn_n + 1
            } sinon {
              $ip = $ip + 1
            }
          }
          $nb_p = $pn_n
          $sub = $fn_retours[$trouve]
          $pj = 1
          tant_que ($pj <= $nb_p et $pj <= $nb_a2) {
            $pn_j = $pn[$pj]
            $la_j = $lst_a2[$pj]
            # plier l'argument recursivement (si possible), pour que la
            # substitution soit litterale.
            $la_pliee = $la_j
            si (longueur($la_j) > 0) {
              $pl = plier_expression($la_j)
              si (longueur($pl) > 0) { $la_pliee = $pl } sinon {
                $ev_a = eval_expr($la_j)
                si (longueur($ev_a) > 0) { $la_pliee = $ev_a }
              }
            }
            $sub = substituer_nom($sub, $pn_j, $la_pliee)
            $pj = $pj + 1
          }
          # Resoudre les si du corps de fonction pour obtenir l'expression de
          # retour nue (gere le cas recursif avec cas de base dans un si).
          $sub = resoudre_corps($sub)
          $av = sous_chaine($cour, 0, $debut_id)
          $lgc = longueur($cour)
          $di = $pos_f + 1
          $ap = ""
          si ($di <= $lgc) { $ap = sous_chaine($cour, $di, $lgc) }
          $cour = $av + $sub + $ap
        }
      }
    }
  }
  retour $cour
}

fn emettre_elf_print($sortie: chaine, $texte: chaine, $code_sortie: chaine, $expr_texte: chaine, $cible: chaine) -> entier {
  $out = ""
  $ELFMAG = "ELF"
  $ELFCLASS64 = 2
  $ELFDATA2LSB = 1
  $EV_CURRENT = 1
  $ELFOSABI_SYSV = 0
  $ET_EXEC = 2
  $EM_AARCH64 = 183
  $PT_LOAD = 1
  $PF_R = 4
  $PF_W = 2
  $PF_X = 1
  $BASE_ADDR = 4194304
  $TEXT_OFFSET = 4096
  $TEXT_ADDR = 4198400

  # Détecter une opération « n1 + n2 » ou « n1 - n2 » dans l'expression texte
  # (n1 et n2 peuvent être des nombres littéraux ou des noms de variables
  # connues dans $var_noms/$var_vals) pour générer du code machine qui calcule
  # à l'exécution.
  $est_op = 0
  $op_n1 = 0
  $op_n2 = 0
  $op_sym = ""
  $oe = longueur($expr_texte)
  $op_idx = 0
  # sauter les espaces
  tant_que ($op_idx < $oe et sous_chaine($expr_texte, $op_idx, $op_idx + 1) == " ") {
    $op_idx = $op_idx + 1
  }
  $op_a1 = ""
  $op_fin1 = 0
  tant_que ($op_idx < $oe et $op_fin1 == 0) {
    $oc = sous_chaine($expr_texte, $op_idx, $op_idx + 1)
    si (($oc >= "0" et $oc <= "9") ou ($oc >= "a" et $oc <= "z") ou ($oc >= "A" et $oc <= "Z") ou $oc == "_") {
      $op_a1 = $op_a1 + $oc
      $op_idx = $op_idx + 1
    } sinon {
      $op_fin1 = 1
    }
  }
  si (longueur($op_a1) > 0) {
    # op_a1 est un nombre littéral ou un nom de variable
    $op_n1 = 0
    $op_n1_est_var = 0
    $op_n1_val_trouve = 0
    si (sous_chaine($op_a1, 0, 1) >= "0" et sous_chaine($op_a1, 0, 1) <= "9") {
      $op_n1 = entier($op_a1)
      $op_n1_est_var = 0
      $op_n1_val_trouve = 1
    } sinon {
      # chercher dans les variables connues
      $vn = 1
      tant_que ($vn <= $nb_vars) {
        si ($var_noms[$vn] == $op_a1) {
          $op_n1 = entier($var_vals[$vn])
          $op_n1_est_var = 1
          $op_n1_val_trouve = 1
          $vn = $nb_vars + 1
        } sinon {
          $vn = $vn + 1
        }
      }
    }
    si ($op_n1_val_trouve == 1) {
      # sauter les espaces
      tant_que ($op_idx < $oe et sous_chaine($expr_texte, $op_idx, $op_idx + 1) == " ") {
        $op_idx = $op_idx + 1
      }
      $op_sym = sous_chaine($expr_texte, $op_idx, $op_idx + 1)
      si ($op_sym == "+" ou $op_sym == "-") {
        $op_idx = $op_idx + 1
        # sauter les espaces
        tant_que ($op_idx < $oe et sous_chaine($expr_texte, $op_idx, $op_idx + 1) == " ") {
          $op_idx = $op_idx + 1
        }
        $op_a2 = ""
        $op_fin2 = 0
        tant_que ($op_idx < $oe et $op_fin2 == 0) {
          $oc = sous_chaine($expr_texte, $op_idx, $op_idx + 1)
          si (($oc >= "0" et $oc <= "9") ou ($oc >= "a" et $oc <= "z") ou ($oc >= "A" et $oc <= "Z") ou $oc == "_") {
            $op_a2 = $op_a2 + $oc
            $op_idx = $op_idx + 1
          } sinon {
            $op_fin2 = 1
          }
        }
        si (longueur($op_a2) > 0) {
          $op_n2 = 0
          $op_n2_est_var = 0
          $op_n2_val_trouve = 0
          si (sous_chaine($op_a2, 0, 1) >= "0" et sous_chaine($op_a2, 0, 1) <= "9") {
            $op_n2 = entier($op_a2)
            $op_n2_est_var = 0
            $op_n2_val_trouve = 1
          } sinon {
            # chercher dans les variables connues
            $vn = 1
            tant_que ($vn <= $nb_vars) {
              si ($var_noms[$vn] == $op_a2) {
                $op_n2 = entier($var_vals[$vn])
                $op_n2_est_var = 1
                $op_n2_val_trouve = 1
                $vn = $nb_vars + 1
              } sinon {
                $vn = $vn + 1
              }
            }
          }
          si ($op_n2_val_trouve == 1) {
            # vérifier qu'il n'y a que des espaces jusqu'à la fin
            $op_fin_ok = 1
            $op_idx2 = $op_idx
            tant_que ($op_idx2 < $oe) {
              $oc2 = sous_chaine($expr_texte, $op_idx2, $op_idx2 + 1)
              si ($oc2 != " ") {
                $op_fin_ok = 0
                $op_idx2 = $oe
              } sinon {
                $op_idx2 = $op_idx2 + 1
              }
            }
            si ($op_fin_ok == 1) {
              $est_op = 1
            }
          }
        }
      }
    }
  }

  # ── Nombre de mots du bloc texte (pour l'offset adr) ──
  $nb_mots = 8
  si ($est_op == 1 et $op_n2 <= 4095) {
    $nb_mots = 9
  }
  $adr_bytes = ($nb_mots - 1) * 4
  $adr_immlo = $adr_bytes % 4
  $adr_immhi = partie_entiere($adr_bytes / 4)
  $adr_op = 268435456 + ($adr_immlo * 536870912) + ($adr_immhi * 32) + 1

  # ═══════════════════════════════════════════════════════════════════
  # Cible x86_64 (ELF64, little-endian) — voie native sans rustc.
  # ═══════════════════════════════════════════════════════════════════
  si ($cible == "x86_64") {
    # --- code_sortie -> entier $code (miroir de la voie aarch64) ---
    $code = 0
    $est_code = 1
    $kc = 0
    $lg_cs = longueur($code_sortie)
    tant_que ($kc < $lg_cs) {
      $cc = sous_chaine($code_sortie, $kc, $kc + 1)
      si (($cc >= "0" et $cc <= "9")) {
        $code = $code * 10 + entier($cc)
        $kc = $kc + 1
      } sinon {
        $est_code = 0
        $kc = $lg_cs
      }
    }
    si ($est_code == 0 ou $lg_cs == 0) { $code = 0 }
    si ($code > 255) { $code = 0 }

    # --- padding texte a 8 pour aligner les variables u64 ---
    $nb_pad8 = longueur($texte) % 8
    si ($nb_pad8 == 1) { $nb_pad8 = 7 }
    si ($nb_pad8 == 2) { $nb_pad8 = 6 }
    si ($nb_pad8 == 3) { $nb_pad8 = 5 }
    si ($nb_pad8 == 4) { $nb_pad8 = 4 }
    si ($nb_pad8 == 5) { $nb_pad8 = 3 }
    si ($nb_pad8 == 6) { $nb_pad8 = 2 }
    si ($nb_pad8 == 7) { $nb_pad8 = 1 }
    si ($nb_pad8 == 0) { $nb_pad8 = 0 }
    si ($nb_vars == 0) { $nb_pad8 = 0 }

    # --- nombre d'octets de code ---
    $nb_code = 49
    si ($est_op == 1 et $op_n2 <= 4095) {
      $nb_code = 58
    }
    $data_addr = 4198400 + $nb_code
    $lg_txt = longueur($texte)
    $fsz = $nb_code + $lg_txt + $nb_pad8 + 8 * $nb_vars

    # --- ELF header (x86_64) ---
    $out = $out + $ELFMAG
    $out = $out + caractere(2)
    $out = $out + caractere(1)
    $out = $out + caractere(1)
    $out = $out + caractere(0)
    $i = 0
    tant_que ($i < 8) { $out = $out + caractere(0); $i = $i + 1 }
    $out = $out + u16le(2)
    $out = $out + u16le(62)
    $out = $out + u32le(1)
    $out = $out + u64le(4198400)
    $out = $out + u64le(64)
    $out = $out + u64le(0)
    $out = $out + u32le(0)
    $out = $out + u16le(64)
    $out = $out + u16le(56)
    $out = $out + u16le(1)
    $out = $out + u16le(64)
    $out = $out + u16le(0)
    $out = $out + u16le(0)

    # --- program header ---
    $out = $out + u32le(1)
    $out = $out + u32le(5)
    $out = $out + u64le(4096)
    $out = $out + u64le(4198400)
    $out = $out + u64le(4198400)
    $out = $out + u64le($fsz)
    $out = $out + u64le($fsz)
    $out = $out + u64le(4096)

    # --- padding to 4096 ---
    $pad = 4096 - longueur($out)
    $i = 0
    tant_que ($i < $pad) { $out = $out + caractere(0); $i = $i + 1 }

    # --- code : write(text) ---
    # mov rax, 1
    $out = $out + caractere(72) + caractere(199) + caractere(192) + caractere(1) + caractere(0) + caractere(0) + caractere(0)
    # mov rdi, 1
    $out = $out + caractere(72) + caractere(199) + caractere(199) + caractere(1) + caractere(0) + caractere(0) + caractere(0)
    # mov rsi, data_addr
    $out = $out + caractere(72) + caractere(190)
    $out = $out + u64le($data_addr)
    # mov rdx, len_texte
    $out = $out + caractere(72) + caractere(199) + caractere(194)
    $out = $out + u32le($lg_txt)
    # syscall
    $out = $out + caractere(15) + caractere(5)

    # --- code : compute exit code ---
    si ($est_op == 1 et $op_n2 <= 4095) {
      # mov rax, n1
      $out = $out + caractere(72) + caractere(199) + caractere(192)
      $out = $out + u32le($op_n1)
      # add/sub rax, n2
      si ($op_sym == "+") {
        $out = $out + caractere(72) + caractere(5)
        $out = $out + u32le($op_n2)
      } sinon {
        $out = $out + caractere(72) + caractere(45)
        $out = $out + u32le($op_n2)
      }
      # mov rdi, rax
      $out = $out + caractere(72) + caractere(135) + caractere(199)
    } sinon {
      # mov rdi, code
      $out = $out + caractere(72) + caractere(199) + caractere(199)
      $out = $out + u32le($code)
    }
    # mov rax, 60
    $out = $out + caractere(72) + caractere(199) + caractere(192)
    $out = $out + u32le(60)
    # syscall
    $out = $out + caractere(15) + caractere(5)

    # --- data : texte + padding + vars u64 ---
    $out = $out + $texte
    $ip = 0
    tant_que ($ip < $nb_pad8) {
      $out = $out + caractere(0)
      $ip = $ip + 1
    }
    $vi = 1
    tant_que ($vi <= $nb_vars) {
      $vv = $var_vals[$vi]
      $vvnum = 1
      $ivv = 0
      $lvv = longueur($vv)
      si ($lvv == 0) { $vvnum = 0 }
      si ($lvv > 0 et sous_chaine($vv, 0, 1) == "-") { $ivv = 1 }
      $kv = $ivv
      tant_que ($kv < $lvv et $vvnum == 1) {
        $cv = sous_chaine($vv, $kv, $kv + 1)
        si ($cv < "0" ou $cv > "9") {
          $vvnum = 0
          $kv = $lvv
        } sinon {
          $kv = $kv + 1
        }
      }
      si ($vvnum == 0) { $vv = "0" }
      $out = $out + u64le(entier($vv))
      $vi = $vi + 1
    }

    # --- ecrire ---
    $iq = longueur($out)
    tant_que ($iq < 4096 + $fsz) {
      $out = $out + caractere(0)
      $iq = $iq + 1
    }
    ecrire_bytes($sortie, $out)
    >> "rose: " + $sortie + " produit (binaire ELF x86_64, " + chaine(longueur($out)) + " octets)"
    retour 0
  }

  # ── ELF header (64 octets) ──
  $out = $out + $ELFMAG                                    # e_ident[0..3]
  $out = $out + caractere($ELFCLASS64)     # e_ident[4] = ELFCLASS64
  $out = $out + caractere($ELFDATA2LSB)    # e_ident[5] = ELFDATA2LSB
  $out = $out + caractere($EV_CURRENT)     # e_ident[6] = EV_CURRENT
  $out = $out + caractere($ELFOSABI_SYSV)  # e_ident[7] = ELFOSABI_SYSV
  $out = $out + caractere(0)               # e_ident[8] = 0
  $out = $out + caractere(0)               # e_ident[9] = 0
  $out = $out + caractere(0)               # e_ident[10] = 0
  $out = $out + caractere(0)               # e_ident[11] = 0
  $out = $out + caractere(0)               # e_ident[12] = 0
  $out = $out + caractere(0)               # e_ident[13] = 0
  $out = $out + caractere(0)               # e_ident[14] = 0
  $out = $out + caractere(0)               # e_ident[15] = 0
  $out = $out + u16le($ET_EXEC)                            # e_type = ET_EXEC
  $out = $out + u16le($EM_AARCH64)                         # e_machine = EM_AARCH64
  $out = $out + u32le(1)                                   # e_version = 1
  $out = $out + u64le($TEXT_ADDR)                          # e_entry = adresse de _start
  $out = $out + u64le(64)                                  # e_phoff = 64 (juste après l'en-tête)
  $out = $out + u64le(0)                                   # e_shoff = 0 (pas de section header pour l'instant)
  $out = $out + u32le(0)                                   # e_flags = 0
  $out = $out + u16le(64)                                  # e_ehsize = 64
  $out = $out + u16le(56)                                  # e_phentsize = 56
  $out = $out + u16le(1)                                   # e_phnum = 1 (un segment)
  $out = $out + u16le(64)                                  # e_shentsize = 64
  $out = $out + u16le(0)                                   # e_shnum = 0
  $out = $out + u16le(0)                                   # e_shstrndx = 0

  # ── Program header (1 segment PT_LOAD, 56 octets) ──
  $out = $out + u32le($PT_LOAD)                            # p_type = PT_LOAD
  $out = $out + u32le(5)                                   # p_flags = R|X
  $out = $out + u64le($TEXT_OFFSET)                        # p_offset = 4096
  $out = $out + u64le($TEXT_ADDR)                          # p_vaddr
  $out = $out + u64le($TEXT_ADDR)                          # p_paddr
  $nb_pad8 = longueur($texte) % 8
  si ($nb_pad8 == 1) { $nb_pad8 = 7 }
  si ($nb_pad8 == 2) { $nb_pad8 = 6 }
  si ($nb_pad8 == 3) { $nb_pad8 = 5 }
  si ($nb_pad8 == 4) { $nb_pad8 = 4 }
  si ($nb_pad8 == 5) { $nb_pad8 = 3 }
  si ($nb_pad8 == 6) { $nb_pad8 = 2 }
  si ($nb_pad8 == 7) { $nb_pad8 = 1 }
  si ($nb_pad8 == 0) { $nb_pad8 = 0 }
  $fsz = 4 * $nb_mots + longueur($texte) + $nb_pad8 + 8 * $nb_vars   # p_filesz
  $out = $out + u64le($fsz)                                # p_filesz
  $out = $out + u64le($fsz)                                # p_memsz
  $out = $out + u64le($fsz)                                # p_filesz
  $out = $out + u64le($fsz)                                # p_memsz
  $out = $out + u64le(2097152)                             # p_align

  # ── Padding jusqu'a 4096 (0x1000) ──
  $pad = 4096 - longueur($out)
  $i = 0
  tant_que ($i < $pad) {
    $out = $out + caractere(0)
    $i = $i + 1
  }

  # ── Code machine aarch64 : affiche le texte et sort avec $code_sortie ──
  $code = 0
  $est_code = 1
  $kc = 0
  tant_que ($kc < longueur($code_sortie)) {
    $cc = sous_chaine($code_sortie, $kc, $kc + 1)
    si (($cc >= "0" et $cc <= "9")) {
      $code = $code * 10 + entier($cc)
      $kc = $kc + 1
    } sinon {
      $est_code = 0
      $kc = longueur($code_sortie)
    }
  }
  si ($est_code == 0 ou longueur($code_sortie) == 0) {
    $code = 0
  } sinon si ($code > 255) {
    $code = 0
  }

  $out = $out + u32le(3531604000)   # mov x0, #1 (stdout)
  $out = $out + u32le($adr_op)      # adr x1, data
  $len_texte = longueur($texte)
  $opcode_x2 = 3531603968 + $len_texte * 32 + 2
  $out = $out + u32le($opcode_x2)   # mov x2, #len (len)
  $out = $out + u32le(3531606024)   # mov x8, #64 (write)
  $out = $out + u32le(3556769793)   # svc #0
  si ($est_op == 1 et $op_n2 <= 4095) {
    $out = $out + u32le(3531603968 + $op_n1 * 32)   # mov x0, #n1
    si ($op_sym == "+") {
      $out = $out + u32le(2432696320 + $op_n2 * 1024)   # add x0, x0, #n2
    } sinon {
      $out = $out + u32le(3510145024 + $op_n2 * 1024)   # sub x0, x0, #n2
    }
  } sinon {
    $out = $out + u32le(3531603968 + $code * 32)   # mov x0, #$code (exit code)
  }
  $out = $out + u32le(3531606952)   # mov x8, #93 (exit)
  $out = $out + u32le(3556769793)   # svc #0
  # Data : variables + texte
  $out = $out + $texte
  si ($nb_vars > 0) {
    $vi = 1
    tant_que ($vi <= $nb_vars) {
      $vv = $var_vals[$vi]
      $vvnum = 1
      $ivv = 0
      $lvv = longueur($vv)
      si ($lvv == 0) { $vvnum = 0 }
      si ($lvv > 0 et sous_chaine($vv, 0, 1) == "-") { $ivv = 1 }
      $kv = $ivv
      tant_que ($kv < $lvv et $vvnum == 1) {
        $cv = sous_chaine($vv, $kv, $kv + 1)
        si ($cv < "0" ou $cv > "9") {
          $vvnum = 0
          $kv = $lvv
        } sinon {
          $kv = $kv + 1
        }
      }
      si ($vvnum == 0) { $vv = "0" }
      $out = $out + u64le(entier($vv))
      $vi = $vi + 1
    }
  }
  # ── Écrire le fichier ──
  # completer a 4096 + fsz octets
  $iq = longueur($out)
  tant_que ($iq < 4096 + $fsz) {
    $out = $out + caractere(0)
    $iq = $iq + 1
  }
  ecrire_bytes($sortie, $out)
  >> "rose: " + $sortie + " produit (binaire ELF autonome, " + chaine(longueur($out)) + " octets)"
  retour 0
}

# ── Point d'entrée ──
$chemin = argument(0)
$sortie = ""
si (nb_arguments() > 1) { $sortie = argument(1) }
si (longueur($sortie) == 0) {
  $sortie = "prog"
}
$src = lire_texte($chemin)
si (longueur($src) == 0) {
  afficher_erreur("emetteur_elf : fichier vide ou introuvable : " + $chemin)
  quitter(1)
}
# Fonctions : extraire les blocs "fn nom(params) -> type { ... }" et les
# retirer du source. On conserve leur nom, leurs params et l'expr de retour.
$fn_noms = [""]
$fn_params = [""]
$fn_retours = [""]
$nb_fn = 0
# Extraction iterative
$modif_fn = 1
tant_que ($modif_fn == 1) {
  $modif_fn = 0
  # chercher "fn "
  $pos_fn = -1
  $i = 0
  tant_que ($i + 3 <= longueur($src)) {
    si (sous_chaine($src, $i, $i + 3) == "fn ") {
      $pos_fn = $i
      $i = longueur($src)
    } sinon {
      $i = $i + 1
    }
  }
  si ($pos_fn >= 0) {
    # lire le nom
    $j = $pos_fn + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") { $j = $j + 1 }
    $nom_fn = ""
    tant_que ($j < longueur($src)) {
      $ch = sous_chaine($src, $j, $j + 1)
      si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
        $nom_fn = $nom_fn + $ch
        $j = $j + 1
      } sinon {
        $j = longueur($src)
      }
    }
    # trouver "("
    $jp = $pos_fn + 3
    tant_que ($jp < longueur($src) et sous_chaine($src, $jp, $jp + 1) != "(") { $jp = $jp + 1 }
    # params jusqu'a ")"
    $params_fn = ""
    $prof = 1
    $jp = $jp + 1
    $debut_p = $jp
    tant_que ($jp < longueur($src) et $prof > 0) {
      $ch = sous_chaine($src, $jp, $jp + 1)
      si ($ch == "(") { $prof = $prof + 1 }
      si ($ch == ")") { $prof = $prof - 1 }
      si ($prof > 0) { $params_fn = $params_fn + $ch }
      $jp = $jp + 1
    }
    # trouver "{" apres ")"
    $ja = $jp
    tant_que ($ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) != "{") { $ja = $ja + 1 }
    # trouver "}" correspondant (profondeur, en ignorant les crochets [ ] )
    $prof = 1
    $ja = $ja + 1
    $debut_b = $ja
    $fin_b = $ja
    $fini_b = 0
    tant_que ($ja < longueur($src) et $fini_b == 0) {
      $ch = sous_chaine($src, $ja, $ja + 1)
      si ($ch == "{") { $prof = $prof + 1 }
      si ($ch == "}") {
        $prof = $prof - 1
        si ($prof == 0) {
          $fin_b = $ja
          $fini_b = 1
        }
      }
      $ja = $ja + 1
    }
    $corps_fn = sous_chaine($src, $debut_b, $fin_b)
    # extraire TOUTES les exprs apres chaque "retour" au NIVEAU 0 du corps.
    # On decoupe $corps_fn en « instructions » separees par "\n" au niveau 0,
    # puis, pour chaque instruction dont le premier mot est « retour », on
    # retient l'expression (le reste de la ligne,trimmee). Les « retour » a
    # l'interieur de blocs { ... } ne sont PAS consideres (ils appartiennent
    # au sous-bloc). On retient la DERNIERE expression « retour » de niveau 0.
    $ret = ""
    $nb_e = 0
    $ligne_buf = ""
    $prof_l = 0
    $kr = 0
    tant_que ($kr <= longueur($corps_fn)) {
      $en_ligne = 0
      si ($kr < longueur($corps_fn)) { $en_ligne = 1 }
      $fin_ligne = 0
      si ($en_ligne == 1) {
        $ch = sous_chaine($corps_fn, $kr, $kr + 1)
        si ($ch == "\n") { $fin_ligne = 1 }
      } sinon {
        $fin_ligne = 1
      }
      si ($fin_ligne == 1) {
        # traiter $ligne_buf comme une instruction
        # trim leading
        $ln = longueur($ligne_buf)
        tant_que ($ln > 0 et sous_chaine($ligne_buf, 0, 1) == " ") { $ligne_buf = sous_chaine($ligne_buf, 1, $ln); $ln = longueur($ligne_buf) }
        tant_que ($ln > 0 et sous_chaine($ligne_buf, $ln - 1, $ln) == " ") { $ligne_buf = sous_chaine($ligne_buf, 0, $ln - 1); $ln = longueur($ligne_buf) }
        tant_que ($ln > 0 et sous_chaine($ligne_buf, $ln - 1, $ln) == "\r") { $ligne_buf = sous_chaine($ligne_buf, 0, $ln - 1); $ln = longueur($ligne_buf) }
        si ($prof_l == 0 et $ln >= 6) {
          si (sous_chaine($ligne_buf, 0, 6) == "retour") {
            # le 7e caractere doit etre espace ou fin ; et on accepte « retour ... »
            $suiv_est_ok = 0
            si ($ln == 6) { $suiv_est_ok = 1 }
            sinon {
              $c7 = sous_chaine($ligne_buf, 6, 7)
              si ($c7 == " " ou $c7 == "\t") { $suiv_est_ok = 1 }
            }
            si ($suiv_est_ok == 1) {
              # extraire l'expression apres "retour "
              $expr_e = sous_chaine($ligne_buf, 6, $ln)
              # trim
              $le = longueur($expr_e)
              tant_que ($le > 0 et sous_chaine($expr_e, 0, 1) == " ") { $expr_e = sous_chaine($expr_e, 1, $le); $le = longueur($expr_e) }
              tant_que ($le > 0 et sous_chaine($expr_e, $le - 1, $le) == " ") { $expr_e = sous_chaine($expr_e, 0, $le - 1); $le = longueur($expr_e) }
              si ($le > 0) { $ret = $expr_e }
            }
          }
        }
        # mettre a jour la profondeur avec les {} de cette ligne
        $kp = 0
        tant_que ($kp < $ln) {
          $cphp = sous_chaine($ligne_buf, $kp, $kp + 1)
          si ($cphp == "{") { $prof_l = $prof_l + 1 }
          si ($cphp == "}") { $prof_l = $prof_l - 1 }
          $kp = $kp + 1
        }
        $ligne_buf = ""
      } sinon {
        $ligne_buf = $ligne_buf + $ch
      }
      $kr = $kr + 1
    }
    # trim leading spaces
    $nbret = longueur($ret)
    tant_que ($nbret > 0 et sous_chaine($ret, 0, 1) == " ") {
      $ret = sous_chaine($ret, 1, $nbret)
      $nbret = longueur($ret)
    }
    # trim trailing spaces/newlines
    $nbret = longueur($ret)
    tant_que ($nbret > 0 et (sous_chaine($ret, $nbret - 1, $nbret) == " " ou sous_chaine($ret, $nbret - 1, $nbret) == "\n" ou sous_chaine($ret, $nbret - 1, $nbret) == "\t")) {
      $ret = sous_chaine($ret, 0, $nbret - 1)
      $nbret = longueur($ret)
    }
    # stocker : si $ret est entierement numerique, on le plie une premiere fois
    si (longueur($ret) > 0) {
      $tnum = 1
      $qn0 = 0
      tant_que ($qn0 < longueur($ret)) {
        $cn0 = sous_chaine($ret, $qn0, $qn0 + 1)
        si (($cn0 >= "a" et $cn0 <= "z") ou ($cn0 >= "A" et $cn0 <= "Z")) {
          $tnum = 0
          $qn0 = longueur($ret)
        }
        $qn0 = $qn0 + 1
      }
      si ($tnum == 1) {
        $plie = eval_expr($ret)
        si (longueur($plie) > 0) { $ret = $plie }
      }
    }
    # stocker le CORPS COMPLET (y compris les si) pour le repli des appels.
    # On trim les espaces/newlines autour du corps.
    $corps_b = $corps_fn
    $lnb = longueur($corps_b)
    tant_que ($lnb > 0 et sous_chaine($corps_b, 0, 1) == " ") { $corps_b = sous_chaine($corps_b, 1, $lnb); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, $lnb - 1, $lnb) == " ") { $corps_b = sous_chaine($corps_b, 0, $lnb - 1); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, 0, 1) == "\n") { $corps_b = sous_chaine($corps_b, 1, $lnb); $lnb = longueur($corps_b) }
    tant_que ($lnb > 0 et sous_chaine($corps_b, $lnb - 1, $lnb) == "\n") { $corps_b = sous_chaine($corps_b, 0, $lnb - 1); $lnb = longueur($corps_b) }
    joindre($fn_noms, $nom_fn)
    joindre($fn_params, $params_fn)
    joindre($fn_retours, $corps_b)
    $nb_fn = $nb_fn + 1
    # retirer le bloc fn du src (de pos_fn jusqu'a la "}" fermante +1)
    $avant_fn = sous_chaine($src, 0, $pos_fn)
    $apres_fn = sous_chaine($src, $ja, longueur($src))
    $src = $avant_fn + $apres_fn
    $modif_fn = 1
  }
}

# Inlining des appels de fonction dans les lignes ">> name(...)"
$modif_inl = 1
tant_que ($modif_inl == 1) {
  $modif_inl = 0
  $i = 0
  tant_que ($i < longueur($src)) {
    # trouver ">> "
    $pos = -1
    $k = $i
    tant_que ($k + 3 <= longueur($src)) {
      si (sous_chaine($src, $k, $k + 3) == ">> ") {
        $pos = $k
        $k = longueur($src)
      } sinon {
        $k = $k + 1
      }
    }
    si ($pos < 0) {
      $i = longueur($src)
    } sinon {
      # avancer les espaces
      $ja = $pos + 3
      tant_que ($ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) == " ") { $ja = $ja + 1 }
      # lire le nom de fonction
      $nom_appel = ""
      $ja0 = $ja
      $done_ja = 0
      tant_que ($ja < longueur($src) et $done_ja == 0) {
        $ch = sous_chaine($src, $ja, $ja + 1)
        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
          $nom_appel = $nom_appel + $ch
          $ja = $ja + 1
        } sinon {
          $done_ja = 1
        }
      }
      # verifier que c'est une fonction connue et suivi de "("
      $est_fn = 0
      $idx_fn = 0
      $fi = 1
      tant_que ($fi <= $nb_fn) {
        si ($fn_noms[$fi] == $nom_appel) {
          $est_fn = 1
          $idx_fn = $fi
        }
        $fi = $fi + 1
      }
      si ($est_fn == 1 et $ja < longueur($src) et sous_chaine($src, $ja, $ja + 1) == "(") {
        # extraire les args jusqu'a ")"
        $ja = $ja + 1
        $args_str = ""
        $prof = 1
        tant_que ($ja < longueur($src) et $prof > 0) {
          $ch = sous_chaine($src, $ja, $ja + 1)
          si ($ch == "(") { $prof = $prof + 1 }
          si ($ch == ")") { $prof = $prof - 1 }
          si ($prof > 0) { $args_str = $args_str + $ch }
          $ja = $ja + 1
        }
        # fin de ligne
        $fin_ligne = $ja
        tant_que ($fin_ligne < longueur($src) et sous_chaine($src, $fin_ligne, $fin_ligne + 1) != "\n") {
          $fin_ligne = $fin_ligne + 1
        }
        # substituer les params dans le retour
        $ret = $fn_retours[$idx_fn]
        $params = $fn_params[$idx_fn]
        # decouper params par virgule (niveau 0)
        $pi = 0
        # on utilise une liste manuelle : on stocke dans des vars temporaires via joindre
        $param_noms = [""]
        $param_vals = [""]
        $nb_p = 0
        # parse params
        $pp = 0
        $ppn = ""
        $curp = ""
        $depth = 0
        $tok = ""
        # params format: "$a: entier, $b: entier"
        # extraire les noms ($xxx) avant ':'
        $iip = 0
        $lp = longueur($params)
        $cur_nom = ""
        $in_nom = 0
        tant_que ($iip < $lp) {
          $ch = sous_chaine($params, $iip, $iip + 1)
          si ($ch == "$") {
            $cur_nom = "$"
            $iip = $iip + 1
          } sinon si ($cur_nom != "" et (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_")) {
            $cur_nom = $cur_nom + $ch
            $iip = $iip + 1
          } sinon {
            si (longueur($cur_nom) > 1) {
              joindre($param_noms, $cur_nom)
              $nb_p = $nb_p + 1
            }
            $cur_nom = ""
            $iip = $iip + 1
          }
        }
        si (longueur($cur_nom) > 1) {
          joindre($param_noms, $cur_nom)
          $nb_p = $nb_p + 1
        }
        # decouper args par virgule top-level
        $arg_list = [""]
        $nb_a = 0
        $cur_arg = ""
        $depth = 0
        $ka = 0
        $la = longueur($args_str)
        tant_que ($ka < $la) {
          $ch = sous_chaine($args_str, $ka, $ka + 1)
          si ($ch == "(" ou $ch == "[" ou $ch == "{") { $depth = $depth + 1 }
          si ($ch == ")" ou $ch == "]" ou $ch == "}") { $depth = $depth - 1 }
          si ($ch == "," et $depth == 0) {
            # trim
            $ca = $cur_arg
            $nbca = longueur($ca)
            tant_que ($nbca > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, longueur($ca)); $nbca = longueur($ca) }
            $nbca = longueur($ca)
            tant_que ($nbca > 0 et sous_chaine($ca, $nbca - 1, $nbca) == " ") { $ca = sous_chaine($ca, 0, $nbca - 1); $nbca = longueur($ca) }
            joindre($arg_list, $ca)
            $nb_a = $nb_a + 1
            $cur_arg = ""
          } sinon {
            $cur_arg = $cur_arg + $ch
          }
          $ka = $ka + 1
        }
        $ca = $cur_arg
        $nbca = longueur($ca)
        tant_que ($nbca > 0 et sous_chaine($ca, 0, 1) == " ") { $ca = sous_chaine($ca, 1, longueur($ca)); $nbca = longueur($ca) }
        $nbca = longueur($ca)
        tant_que ($nbca > 0 et sous_chaine($ca, $nbca - 1, $nbca) == " ") { $ca = sous_chaine($ca, 0, $nbca - 1); $nbca = longueur($ca) }
        si (longueur($ca) > 0) {
          joindre($arg_list, $ca)
          $nb_a = $nb_a + 1
        }
        # substituer params -> args dans ret, puis replier les appels
        # recursifs/nommes internes jusqu'a stabilisation
        # Substituer les params par les args dans le "retour".
        $ret_inl = $ret
        $pi = 1
        tant_que ($pi <= $nb_p et $pi <= $nb_a) {
          $ret_inl = substituer_nom($ret_inl, $param_noms[$pi], $arg_list[$pi])
          $pi = $pi + 1
        }
        # Resoudre les si du corps pour obtenir l'expression de retour nue.
        $ret_inl = resoudre_corps($ret_inl)
        # Si l'expression resultant n'a plus de lettre (entierement numerique),
        # on la plie via eval_expr.
        $tout_num_inl = 1
        $qn_inl = 0
        tant_que ($qn_inl < longueur($ret_inl)) {
          $cn_inl = sous_chaine($ret_inl, $qn_inl, $qn_inl + 1)
          si (($cn_inl >= "a" et $cn_inl <= "z") ou ($cn_inl >= "A" et $cn_inl <= "Z")) {
            $tout_num_inl = 0
          }
          $qn_inl = $qn_inl + 1
        }
        si ($tout_num_inl == 1 et longueur($ret_inl) > 0) {
          $r_inl = eval_expr($ret_inl)
          si (longueur($r_inl) > 0) { $ret_inl = $r_inl }
        }
        $tour_inl = 0
        $encore = 1
        tant_que ($encore == 1 et $tour_inl < 64) {
          $encore = 0
          $fi2 = 1
          tant_que ($fi2 <= $nb_fn) {
            $nm = $fn_noms[$fi2]
            $lm = longueur($nm)
            $kk = 0
            $trouve_i = 0
            $dp0 = 0
            $nb_esp0 = 0
            tant_que ($kk + $lm <= longueur($ret_inl) et $trouve_i == 0) {
              si (sous_chaine($ret_inl, $kk, $kk + $lm) == $nm) {
                $ap = $kk + $lm
                $nb_esp0 = 0
                tant_que ($ap < longueur($ret_inl) et sous_chaine($ret_inl, $ap, $ap + 1) == " ") { $ap = $ap + 1; $nb_esp0 = $nb_esp0 + 1 }
                si ($ap < longueur($ret_inl) et sous_chaine($ret_inl, $ap, $ap + 1) == "(") {
                  $trouve_i = 1
                  $dp0 = $ap + 1
                }
              }
              si ($trouve_i == 0) { $kk = $kk + 1 }
            }
            si ($trouve_i == 1) {
              # extraire les args de cet appel
              $dp = $dp0
              $prof_d = 1
              $cur_d = ""
              $nb_d = 0
              $lst_d = [""]
              $fini_d = 0
              $dp_fin = $dp
              tant_que ($dp < longueur($ret_inl) et $fini_d == 0) {
                $chd = sous_chaine($ret_inl, $dp, $dp + 1)
                si ($chd == "(" ou $chd == "[" ou $chd == "{") {
                  $prof_d = $prof_d + 1
                  $cur_d = $cur_d + $chd
                } sinon si ($chd == ")" ou $chd == "]" ou $chd == "}") {
                  $prof_d = $prof_d - 1
                  si ($prof_d == 0) {
                    $fini_d = 1
                    $dp_fin = $dp
                  } sinon {
                    $cur_d = $cur_d + $chd
                  }
                } sinon si ($chd == "," et $prof_d == 1) {
                  $cd = $cur_d
                  $nbcd = longueur($cd)
                  tant_que ($nbcd > 0 et sous_chaine($cd, 0, 1) == " ") { $cd = sous_chaine($cd, 1, longueur($cd)); $nbcd = longueur($cd) }
                  $nbcd = longueur($cd)
                  tant_que ($nbcd > 0 et sous_chaine($cd, $nbcd - 1, $nbcd) == " ") { $cd = sous_chaine($cd, 0, $nbcd - 1); $nbcd = longueur($cd) }
                  joindre($lst_d, $cd)
                  $nb_d = $nb_d + 1
                  $cur_d = ""
                } sinon {
                  $cur_d = $cur_d + $chd
                }
                $dp = $dp + 1
              }
              $cd = $cur_d
              $nbcd = longueur($cd)
              tant_que ($nbcd > 0 et sous_chaine($cd, 0, 1) == " ") { $cd = sous_chaine($cd, 1, longueur($cd)); $nbcd = longueur($cd) }
              $nbcd = longueur($cd)
              tant_que ($nbcd > 0 et sous_chaine($cd, $nbcd - 1, $nbcd) == " ") { $cd = sous_chaine($cd, 0, $nbcd - 1); $nbcd = longueur($cd) }
              si (longueur($cd) > 0) {
                joindre($lst_d, $cd)
                $nb_d = $nb_d + 1
              }
              # lire les params du fn fi2
              $pr2 = $fn_params[$fi2]
              $pn2 = ["#"]
              $iip2 = 0
              $cur_n2 = ""
              $lp2 = longueur($pr2)
              tant_que ($iip2 < $lp2) {
                $ch2 = sous_chaine($pr2, $iip2, $iip2 + 1)
                si ($ch2 == "$") {
                  $cur_n2 = "$"
                  $iip2 = $iip2 + 1
                } sinon si ($cur_n2 != "" et (($ch2 >= "a" et $ch2 <= "z") ou ($ch2 >= "A" et $ch2 <= "Z") ou ($ch2 >= "0" et $ch2 <= "9") ou $ch2 == "_")) {
                  $cur_n2 = $cur_n2 + $ch2
                  $iip2 = $iip2 + 1
                } sinon {
                  si (longueur($cur_n2) > 1) {
                    joindre($pn2, $cur_n2)
                  }
                  $cur_n2 = ""
                  $iip2 = $iip2 + 1
                }
              }
              si (longueur($cur_n2) > 1) {
                joindre($pn2, $cur_n2)
              }
              $nb_p2 = longueur($pn2) - 1
              # substituer params dans le corps complet de la fonction
              $sub2 = $fn_retours[$fi2]
              $pj2 = 1
              tant_que ($pj2 <= $nb_p2 et $pj2 <= $nb_d) {
                $_la2 = $lst_d[$pj2]
                # plier l'argument recursivement avant substitution (comme
                # plier_expression) pour eviter les problemes de priorite.
                si (longueur($_la2) > 0) {
                  $_pl2 = plier_expression($_la2)
                  si (longueur($_pl2) > 0) { $_la2 = $_pl2 } sinon {
                    $_ev2a = eval_expr($_la2)
                    si (longueur($_ev2a) > 0) { $_la2 = $_ev2a }
                  }
                }
                $sub2 = substituer_nom($sub2, $pn2[$pj2], $_la2)
                $pj2 = $pj2 + 1
              }
              # Resoudre les si pour obtenir l'expression de retour nue.
              $sub2 = resoudre_corps($sub2)
              # Plier recursivement via plier_expression.
              $sub2 = plier_expression($sub2)
              # si $sub2 est entierement numerique, le plier
              $tnum2 = 1
              $qn2 = 0
              tant_que ($qn2 < longueur($sub2)) {
                $cn2 = sous_chaine($sub2, $qn2, $qn2 + 1)
                si (($cn2 >= "a" et $cn2 <= "z") ou ($cn2 >= "A" et $cn2 <= "Z")) {
                  $tnum2 = 0
                  $qn2 = longueur($sub2)
                }
                $qn2 = $qn2 + 1
              }
              si ($tnum2 == 1 et longueur($sub2) > 0) {
                $ev2 = eval_expr($sub2)
                si (longueur($ev2) > 0) { $sub2 = $ev2 }
              }
              # remplacer l'appel par sub2 dans ret_inl
              $avant2 = sous_chaine($ret_inl, 0, $kk)
              $apres2 = sous_chaine($ret_inl, $dp_fin + 1, longueur($ret_inl))
              $ret_inl = $avant2 + $sub2 + $apres2
              $encore = 1
            }
            $fi2 = $fi2 + 1
          }
          $tour_inl = $tour_inl + 1
        }

# remplacer la ligne ">> name(args...)" par ">> ret_inl"
        $avant_l = sous_chaine($src, 0, $pos)
        $apres_l = sous_chaine($src, $fin_ligne, longueur($src))
        $src = $avant_l + ">> " + $ret_inl + $apres_l
        $modif_inl = 1
        $i = $pos
      } sinon {
        $i = $pos + 1
      }
    }
  }
}

# Variables
$var_noms = [""]
$var_vals = [""]
$nb_vars = 0

# Pretraitement 0.5 : collecter les variables (premier passage)
# (deja fait ci-dessous, mais on a besoin des variables pour si)
# On fait d'abord une passe pour collecter les variables
# puis on traite les si, puis on collecte a nouveau

# Pretraitement 0 : collecter les variables (hors corps de tant_que,
# pour que les boucles pilotées par variable partent de valeurs propres)

$i = 0
$tq_prof = 0
$tq_attente = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  $c2 = ""
  $c3 = ""
  $c4 = ""
  $c5 = ""
  $c6 = ""
  $c7 = ""
  $c8 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  si ($i + 3 < longueur($src)) { $c4 = sous_chaine($src, $i + 3, $i + 4) }
  si ($i + 4 < longueur($src)) { $c5 = sous_chaine($src, $i + 4, $i + 5) }
  si ($i + 5 < longueur($src)) { $c6 = sous_chaine($src, $i + 5, $i + 6) }
  si ($i + 6 < longueur($src)) { $c7 = sous_chaine($src, $i + 6, $i + 7) }
  si ($i + 7 < longueur($src)) { $c8 = sous_chaine($src, $i + 7, $i + 8) }
  # Suivre la profondeur d'entree dans un corps de tant_que
  si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
    $tq_attente = 1
  }
  si ($c1 == "{") {
    si ($tq_attente == 1) {
      $tq_attente = 0
      $tq_prof = $tq_prof + 1
    } sinon {
      si ($tq_prof > 0) {
        $tq_prof = $tq_prof + 1
      }
    }
  }
  si ($c1 == "}" et $tq_prof > 0) {
    $tq_prof = $tq_prof - 1
  }
  si ($c1 == "v" et $c2 == "a" et $c3 == "r" et $tq_prof == 0) {
    $j = $i + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    $nom_var = ""
    tant_que ($j < longueur($src)) {
      $ch = sous_chaine($src, $j, $j + 1)
      si ($ch == " " ou $ch == "=") {
        $j = longueur($src) + 1
      } sinon {
        $nom_var = $nom_var + $ch
        $j = $j + 1
      }
    }
    $j = $i + 3
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) != "=") {
      $j = $j + 1
    }
    $j = $j + 1
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    $expr = ""
    $k = $j
    tant_que ($k < longueur($src)) {
      $ch = sous_chaine($src, $k, $k + 1)
      si ($ch == "\n") {
        $k = longueur($src) + 1
      } sinon {
        $expr = $expr + $ch
        $k = $k + 1
      }
    }
    si (longueur($expr) > 0 et longueur($nom_var) > 0) {
      # Construire le contexte de variables (en ARRIERE : la derniere
      # valeur appendee est inseree en premier et gagne les remplacements)
      $ctx = ""
      $vi = 1
      tant_que ($vi <= $nb_vars) {
        $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
        $vi = $vi + 1
      }
      si (longueur($ctx) > 0) {
        $expr_full = $expr + " // vars: " + $ctx
      } sinon {
        $expr_full = $expr
      }
      $resultat = eval_expr($expr_full)
      joindre($var_noms, $nom_var)
      joindre($var_vals, $resultat)
      $nb_vars = $nb_vars + 1
    }
  }
  $i = $i + 1
}

# Pretraitement 0b : collecter les affectations NUES "nom = expr" hors corps de
# tant_que (les "var" sont deja collectes par la passe 0).
$i = 0
$tq_prof = 0
$tq_attente = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  si ($i + 3 < longueur($src)) { $c4 = sous_chaine($src, $i + 3, $i + 4) }
  si ($i + 4 < longueur($src)) { $c5 = sous_chaine($src, $i + 4, $i + 5) }
  si ($i + 5 < longueur($src)) { $c6 = sous_chaine($src, $i + 5, $i + 6) }
  si ($i + 6 < longueur($src)) { $c7 = sous_chaine($src, $i + 6, $i + 7) }
  si ($i + 7 < longueur($src)) { $c8 = sous_chaine($src, $i + 7, $i + 8) }
  si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
    $tq_attente = 1
  }
  si ($c1 == "{") {
    si ($tq_attente == 1) {
      $tq_attente = 0
      $tq_prof = $tq_prof + 1
    } sinon {
      si ($tq_prof > 0) {
        $tq_prof = $tq_prof + 1
      }
    }
  }
  si ($c1 == "}" et $tq_prof > 0) {
    $tq_prof = $tq_prof - 1
  }
  $est_nom = 0
  si ($tq_prof == 0) {
    si (($c1 >= "a" et $c1 <= "z") ou ($c1 >= "A" et $c1 <= "Z") ou $c1 == "_") {
      $est_nom = 1
    }
  }
  si ($est_nom == 1) {
    $nom_nu = ""
    $jn = $i
    $fin_n = 0
    tant_que ($jn < longueur($src) et $fin_n == 0) {
      $ch = sous_chaine($src, $jn, $jn + 1)
      si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
        $nom_nu = $nom_nu + $ch
        $jn = $jn + 1
      } sinon {
        $fin_n = 1
      }
    }
    $jn2 = $jn
    tant_que ($jn2 < longueur($src) et sous_chaine($src, $jn2, $jn2 + 1) == " ") {
      $jn2 = $jn2 + 1
    }
    $a_eq = 0
    si ($jn2 < longueur($src)) {
      si (sous_chaine($src, $jn2, $jn2 + 1) == "=") { $a_eq = 1 }
    }
    si ($nom_nu == "si" ou $nom_nu == "pour" ou $nom_nu == "tant_que" ou $nom_nu == "var" ou $nom_nu == "fn" ou $nom_nu == "retour") {
      $a_eq = 0
    }
    si ($a_eq == 1 et longueur($nom_nu) > 0) {
      $jx = $jn2 + 1
      tant_que ($jx < longueur($src) et sous_chaine($src, $jx, $jx + 1) == " ") {
        $jx = $jx + 1
      }
      $expr_nu = ""
      $kx = $jx
      $nl_pos = longueur($src)
      tant_que ($kx < longueur($src)) {
        $ch = sous_chaine($src, $kx, $kx + 1)
        si ($ch == "\n") {
          $nl_pos = $kx
          $kx = longueur($src) + 1
        } sinon {
          si ($ch != "\r") {
            $expr_nu = $expr_nu + $ch
          }
          $kx = $kx + 1
        }
      }
      $nbx = longueur($expr_nu)
      tant_que ($nbx > 0 et sous_chaine($expr_nu, 0, 1) == " ") {
        $expr_nu = sous_chaine($expr_nu, 1, longueur($expr_nu))
        $nbx = longueur($expr_nu)
      }
      $nbx = longueur($expr_nu)
      tant_que ($nbx > 0 et sous_chaine($expr_nu, $nbx - 1, $nbx) == " ") {
        $expr_nu = sous_chaine($expr_nu, 0, $nbx - 1)
        $nbx = longueur($expr_nu)
      }
      si (longueur($expr_nu) > 0) {
        $ctx = ""
        $vi = 1
        tant_que ($vi <= $nb_vars) {
          $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
          $vi = $vi + 1
        }
        si (longueur($ctx) > 0) {
          $expr_full = $expr_nu + " // vars: " + $ctx
        } sinon {
          $expr_full = $expr_nu
        }
        $resultat = eval_expr($expr_full)
        joindre($var_noms, $nom_nu)
        joindre($var_vals, $resultat)
        $nb_vars = $nb_vars + 1
      }
      $i = $nl_pos
    }
  }
  $i = $i + 1
}

# Pretraitement tant_que : deplier les boucles a la compilation.
# Deux modes :
#  - condition SANS variable connue : deplier une seule fois
#    (ou supprimer tout le bloc si la condition est fausse) ;
#  - condition dependant d'une variable : execution sequentielle a la
#    compilation — chaque ligne "var x = ..." du corps met a jour le stockage,
#    chaque ligne ">> ..." du corps est literalisee avec la valeur courante,
#    et les autres lignes subissent la substitution textuelle des variables.
$src_proc3 = $src
$modifie_tq = 1
$iter_max_tq = 1000
tant_que ($modifie_tq == 1) {
  $modifie_tq = 0
  $i = 0
  tant_que ($i < longueur($src_proc3)) {
    $c1 = ""
    $c2 = ""
    $c3 = ""
    $c4 = ""
    $c5 = ""
    $c6 = ""
    $c7 = ""
    $c8 = ""
    si ($i < longueur($src_proc3)) { $c1 = sous_chaine($src_proc3, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc3)) { $c2 = sous_chaine($src_proc3, $i + 1, $i + 2) }
    si ($i + 2 < longueur($src_proc3)) { $c3 = sous_chaine($src_proc3, $i + 2, $i + 3) }
    si ($i + 3 < longueur($src_proc3)) { $c4 = sous_chaine($src_proc3, $i + 3, $i + 4) }
    si ($i + 4 < longueur($src_proc3)) { $c5 = sous_chaine($src_proc3, $i + 4, $i + 5) }
    si ($i + 5 < longueur($src_proc3)) { $c6 = sous_chaine($src_proc3, $i + 5, $i + 6) }
    si ($i + 6 < longueur($src_proc3)) { $c7 = sous_chaine($src_proc3, $i + 6, $i + 7) }
    si ($i + 7 < longueur($src_proc3)) { $c8 = sous_chaine($src_proc3, $i + 7, $i + 8) }
    si ($c1 == "t" et $c2 == "a" et $c3 == "n" et $c4 == "t" et $c5 == "_" et $c6 == "q" et $c7 == "u" et $c8 == "e") {
      $j = $i + 8
      tant_que ($j < longueur($src_proc3) et sous_chaine($src_proc3, $j, $j + 1) == " ") {
        $j = $j + 1
      }
      si ($j < longueur($src_proc3) et sous_chaine($src_proc3, $j, $j + 1) == "(") {
        $j = $j + 1
        $cond = ""
        $prof = 1
        tant_que ($j < longueur($src_proc3) et $prof > 0) {
          $ch = sous_chaine($src_proc3, $j, $j + 1)
          si ($ch == "(") { $prof = $prof + 1 }
          si ($ch == ")") { $prof = $prof - 1 }
          si ($prof > 0) { $cond = $cond + $ch }
          $j = $j + 1
        }
        # Trouver le corps { ... }
        $prof = 0
        $trouve = 0
        $debut = $j
        tant_que ($j < longueur($src_proc3) et $trouve == 0) {
          $ch = sous_chaine($src_proc3, $j, $j + 1)
          si ($ch == "{") { $prof = $prof + 1 }
          si ($ch == "}") { $prof = $prof - 1 }
          si ($prof == 0 et $ch == "}") { $trouve = 1 }
          $j = $j + 1
        }
        si ($trouve == 1) {
          $fin_bloc = $j
          $corps = sous_chaine($src_proc3, $debut + 1, $fin_bloc - 1)
          $long = longueur($src_proc3)
          # Construire le contexte de variables (en ARRIERE : la derniere
          # valeur appendee est inseree en premier et gagne les remplacements)
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $cond_full = $cond + " // vars: " + $ctx
          } sinon {
            $cond_full = $cond
          }
          $cond_val = eval_expr($cond_full)
          $est_faux = 0
          si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
            $est_faux = 1
          }
          # Detecter une dependance de la condition a une variable connue
          # (marqueur : la substitution modifie le texte de la condition nue)
          $cond_var = 0
          $vq = 1
          tant_que ($vq <= $nb_vars) {
            si ($cond_var == 0) {
              $marque = substituer_nom($cond, $var_noms[$vq], "@SUB@")
              si ($marque != $cond) {
                $cond_var = 1
              }
            }
            $vq = $vq + 1
          }
          si ($est_faux == 1) {
            # Condition fausse : supprimer tout le bloc
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $apres
            $modifie_tq = 1
            $i = 0
          } sinon si ($cond_var == 0) {
            # Condition constante vraie : deplier une seule fois
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $corps + $apres
            $modifie_tq = 1
            $i = 0
          } sinon {
            # Condition pilotée par variable : execution sequentielle
            $unrolled_tq = ""
            $fini_tq = 0
            $n_iter_tq = 0
            tant_que ($fini_tq == 0 et $n_iter_tq < $iter_max_tq) {
              # Traiter le corps ligne par ligne
              $corps_out = ""
              $lp = 0
              tant_que ($lp < longueur($corps)) {
                # Trouver la fin de ligne
                $fl = $lp
                $a_fl = 0
                tant_que ($fl < longueur($corps) et $a_fl == 0) {
                  si (sous_chaine($corps, $fl, $fl + 1) == "\n") {
                    $a_fl = 1
                  } sinon {
                    $fl = $fl + 1
                  }
                }
                $ligne = sous_chaine($corps, $lp, $fl)
                # Premier caractere non blanc de la ligne
                $lc = 0
                tant_que ($lc < longueur($ligne) et (sous_chaine($ligne, $lc, $lc + 1) == " " ou sous_chaine($ligne, $lc, $lc + 1) == "\t")) {
                  $lc = $lc + 1
                }
                $consumé = 0
                # Detecter une affectation nue "nom = expr" (sans "var")
                $est_bare = 0
                $nom_bare = ""
                $la_b = $lc
                $fin_b = 0
                tant_que ($la_b < longueur($ligne) et $fin_b == 0) {
                  $ch = sous_chaine($ligne, $la_b, $la_b + 1)
                  si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                    $nom_bare = $nom_bare + $ch
                    $la_b = $la_b + 1
                  } sinon {
                    $fin_b = 1
                  }
                }
                $la_b2 = $la_b
                tant_que ($la_b2 < longueur($ligne) et sous_chaine($ligne, $la_b2, $la_b2 + 1) == " ") {
                  $la_b2 = $la_b2 + 1
                }
                si ($la_b2 < longueur($ligne) et sous_chaine($ligne, $la_b2, $la_b2 + 1) == "=" et longueur($nom_bare) > 0) {
                  $est_kw = 0
                  si ($nom_bare == "si") { $est_kw = 1 }
                  si ($nom_bare == "pour") { $est_kw = 1 }
                  si ($nom_bare == "tant_que") { $est_kw = 1 }
                  si ($nom_bare == "var") { $est_kw = 1 }
                  si ($nom_bare == "fn") { $est_kw = 1 }
                  si ($nom_bare == "retour") { $est_kw = 1 }
                  si ($est_kw == 0) {
                    $est_bare = 1
                  }
                }
                si ($est_bare == 1) {
                  $la_b = $la_b2 + 1
                  tant_que ($la_b < longueur($ligne) et sous_chaine($ligne, $la_b, $la_b + 1) == " ") {
                    $la_b = $la_b + 1
                  }
                  $expr_b = sous_chaine($ligne, $la_b, longueur($ligne))
                  si (longueur($expr_b) > 0) {
                    si (longueur($ctx) > 0) {
                      $expr_b_full = $expr_b + " // vars: " + $ctx
                    } sinon {
                      $expr_b_full = $expr_b
                    }
                    $val_b = eval_expr($expr_b_full)
                    joindre($var_noms, $nom_bare)
                    joindre($var_vals, $val_b)
                    $nb_vars = $nb_vars + 1
                  }
                  $consumé = 1
                }
                si ($consumé == 0) {
                  si ($lc + 3 < longueur($ligne)) {
                    si (sous_chaine($ligne, $lc, $lc + 1) == "v" et sous_chaine($ligne, $lc + 1, $lc + 2) == "a" et sous_chaine($ligne, $lc + 2, $lc + 3) == "r" et sous_chaine($ligne, $lc + 3, $lc + 4) == " ") {
                    # Affectation : var nom = expr
                    $la = $lc + 4
                    $nom_l = ""
                    tant_que ($la < longueur($ligne)) {
                      $ch = sous_chaine($ligne, $la, $la + 1)
                      si ($ch == " " ou $ch == "=") {
                        $la = longueur($ligne) + 1
                      } sinon {
                        $nom_l = $nom_l + $ch
                        $la = $la + 1
                      }
                    }
                    $la = $lc + 4
                    tant_que ($la < longueur($ligne) et sous_chaine($ligne, $la, $la + 1) != "=") {
                      $la = $la + 1
                    }
                    $la = $la + 1
                    tant_que ($la < longueur($ligne) et sous_chaine($ligne, $la, $la + 1) == " ") {
                      $la = $la + 1
                    }
                    $expr_l = sous_chaine($ligne, $la, longueur($ligne))
                    si (longueur($nom_l) > 0 et longueur($expr_l) > 0) {
                      si (longueur($ctx) > 0) {
                        $expr_l_full = $expr_l + " // vars: " + $ctx
                      } sinon {
                        $expr_l_full = $expr_l
                      }
                      $val_l = eval_expr($expr_l_full)
                      # Shadowing : on ajoute (la derniere valeur fait foi)
                      joindre($var_noms, $nom_l)
                      joindre($var_vals, $val_l)
                      $nb_vars = $nb_vars + 1
                    }
                    $consumé = 1
                  }
                }
                si ($consumé == 0) {
                  si ($lc + 1 < longueur($ligne)) {
                    si (sous_chaine($ligne, $lc, $lc + 1) == ">" et sous_chaine($ligne, $lc + 1, $lc + 2) == ">") {
                      # Affichage : >> expr -> literaliser
                      $ja = $lc + 2
                      tant_que ($ja < longueur($ligne) et sous_chaine($ligne, $ja, $ja + 1) == " ") {
                        $ja = $ja + 1
                      }
                      $expr_a = sous_chaine($ligne, $ja, longueur($ligne))
                      si (longueur($expr_a) > 0) {
                        si (longueur($ctx) > 0) {
                          $expr_a_full = $expr_a + " // vars: " + $ctx
                        } sinon {
                          $expr_a_full = $expr_a
                        }
                        $val_a = eval_expr($expr_a_full)
                        $corps_out = $corps_out + '>> "' + $val_a + '"' + "\n"
                      }
                      $consumé = 1
                    }
                  }
                }
                }
                si ($consumé == 0) {
                  # Autre ligne : substitution textuelle de toutes les variables
                  # (en ARRIERE : la valeur la plus recente fait foi)
                  $ligne_sub = $ligne
                  $li2 = $nb_vars
                  tant_que ($li2 >= 1) {
                    $ligne_sub = substituer_nom($ligne_sub, $var_noms[$li2], $var_vals[$li2])
                    $li2 = $li2 - 1
                  }
                  $corps_out = $corps_out + $ligne_sub + "\n"
                }
                $lp = $fl + 1
              }
              $unrolled_tq = $unrolled_tq + $corps_out
              # Re-evaluer la condition avec le stockage mis a jour
              # (contexte en ARRIERE : la derniere valeur appendee gagne)
              $ctx = ""
              $vi = 1
              tant_que ($vi <= $nb_vars) {
                $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
                $vi = $vi + 1
              }
              si (longueur($ctx) > 0) {
                $cond_full = $cond + " // vars: " + $ctx
              } sinon {
                $cond_full = $cond
              }
              $cond_val = eval_expr($cond_full)
              si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
                $fini_tq = 1
              }
              $n_iter_tq = $n_iter_tq + 1
            }
            $avant = sous_chaine($src_proc3, 0, $i)
            $apres = sous_chaine($src_proc3, $fin_bloc, $long)
            $src_proc3 = $avant + $unrolled_tq + $apres
            $modifie_tq = 1
            $i = 0
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc3

# Pretraitement si : evaluer les conditions constantes et supprimer les branches
# non prises. Gere si (cond) { ... }, si (cond) { ... } sinon { ... } et les
# chaines "sinon si (...) { ... }".
$src_proc = $src_proc3
$modifie = 1
tant_que ($modifie == 1) {
  $modifie = 0
  $i = 0
    tant_que ($i < longueur($src_proc)) {
    $c1 = ""
    $c2 = ""
    si ($i < longueur($src_proc)) { $c1 = sous_chaine($src_proc, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc)) { $c2 = sous_chaine($src_proc, $i + 1, $i + 2) }
    si ($c1 == "s" et $c2 == "i") {
      $next = ""
      si ($i + 2 < longueur($src_proc)) { $next = sous_chaine($src_proc, $i + 2, $i + 3) }
      si ($next == " " ou $next == "(") {
        $j = $i + 2
        tant_que ($j < longueur($src_proc) et sous_chaine($src_proc, $j, $j + 1) == " ") {
          $j = $j + 1
        }
        si ($j < longueur($src_proc) et sous_chaine($src_proc, $j, $j + 1) == "(") {
          $j = $j + 1
          $cond = ""
          $prof = 1
          tant_que ($j < longueur($src_proc) et $prof > 0) {
            $ch = sous_chaine($src_proc, $j, $j + 1)
            si ($ch == "(") { $prof = $prof + 1 }
            si ($ch == ")") { $prof = $prof - 1 }
            si ($prof > 0) { $cond = $cond + $ch }
            $j = $j + 1
          }
          # Contexte de variables (en ARRIERE : la derniere valeur gagne)
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $cond_full = $cond + " // vars: " + $ctx
          } sinon {
            $cond_full = $cond
          }
          $cond_val = eval_expr($cond_full)
          $est_faux = 0
          si ($cond_val == "0" ou $cond_val == "faux" ou $cond_val == "" ou longueur($cond_val) == 0) {
            $est_faux = 1
          }
          # Trouver le bloc { ... } du si
          $prof = 0
          $trouve = 0
          $debut = $j
          tant_que ($j < longueur($src_proc) et $trouve == 0) {
            $ch = sous_chaine($src_proc, $j, $j + 1)
            si ($ch == "{") { $prof = $prof + 1 }
            si ($ch == "}") { $prof = $prof - 1 }
            si ($prof == 0 et $ch == "}") { $trouve = 1 }
            $j = $j + 1
          }
          si ($trouve == 1) {
            $fin_bloc = $j
            $long = longueur($src_proc)
            # Detecter un "sinon" juste apres le bloc du si
            $q = $fin_bloc
            tant_que ($q < $long et (sous_chaine($src_proc, $q, $q + 1) == " " ou sous_chaine($src_proc, $q, $q + 1) == "\n" ou sous_chaine($src_proc, $q, $q + 1) == "\t")) {
              $q = $q + 1
            }
            $sinon_ici = 0
            si ($q + 4 < $long) {
              si (sous_chaine($src_proc, $q, $q + 1) == "s" et sous_chaine($src_proc, $q + 1, $q + 2) == "i" et sous_chaine($src_proc, $q + 2, $q + 3) == "n" et sous_chaine($src_proc, $q + 3, $q + 4) == "o" et sous_chaine($src_proc, $q + 4, $q + 5) == "n") {
                $sinon_ici = 1
              }
            }
            si ($sinon_ici == 0) {
              # Pas de sinon
              si ($est_faux == 1) {
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $fin_bloc, $long)
                $src_proc = $avant + $apres
                $modifie = 1
                $i = 0
              } sinon {
                $corps = sous_chaine($src_proc, $debut + 1, $fin_bloc - 1)
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $fin_bloc, $long)
                $src_proc = $avant + $corps + $apres
                $modifie = 1
                $i = 0
              }
            } sinon {
              # Un sinon est present : bloc simple ou "sinon si" ?
              $q2 = $q + 5
              tant_que ($q2 < $long et (sous_chaine($src_proc, $q2, $q2 + 1) == " " ou sous_chaine($src_proc, $q2, $q2 + 1) == "\n" ou sous_chaine($src_proc, $q2, $q2 + 1) == "\t")) {
                $q2 = $q2 + 1
              }
              $sinon_si = 0
              si ($q2 + 3 < $long) {
                si (sous_chaine($src_proc, $q2, $q2 + 1) == "s" et sous_chaine($src_proc, $q2 + 1, $q2 + 2) == "i") {
                  $suivant = ""
                  si ($q2 + 2 < $long) { $suivant = sous_chaine($src_proc, $q2 + 2, $q2 + 3) }
                  si ($suivant == " " ou $suivant == "(") {
                    $sinon_si = 1
                  }
                }
              }
              si ($est_faux == 1) {
                si ($sinon_si == 1) {
                  # Faux avec "sinon si" : garder le si suivant pour re-traitement
                  $avant = sous_chaine($src_proc, 0, $i)
                  $apres = sous_chaine($src_proc, $q2, $long)
                  $src_proc = $avant + $apres
                  $modifie = 1
                  $i = 0
                } sinon {
                  # Faux avec sinon bloc : garder le corps du sinon, supprimer le reste
                  $jj = $q2
                  tant_que ($jj < $long et sous_chaine($src_proc, $jj, $jj + 1) != "{") {
                    $jj = $jj + 1
                  }
                  $prof2 = 1
                  $jj = $jj + 1
                  tant_que ($jj < $long et $prof2 > 0) {
                    $ch = sous_chaine($src_proc, $jj, $jj + 1)
                    si ($ch == "{") { $prof2 = $prof2 + 1 }
                    si ($ch == "}") { $prof2 = $prof2 - 1 }
                    $jj = $jj + 1
                  }
                  $fin_sinon = $jj
                  $corps_sinon = sous_chaine($src_proc, $q2 + 1, $fin_sinon - 1)
                  $avant = sous_chaine($src_proc, 0, $i)
                  $apres = sous_chaine($src_proc, $fin_sinon, $long)
                  $src_proc = $avant + $corps_sinon + $apres
                  $modifie = 1
                  $i = 0
                }
              } sinon {
                # Vrai : supprimer TOUTE la chaine de sinon (si ... ou bloc)
                $pos = $fin_bloc
                $encore = 1
                tant_que ($encore == 1) {
                  $qq = $pos
                  tant_que ($qq < $long et (sous_chaine($src_proc, $qq, $qq + 1) == " " ou sous_chaine($src_proc, $qq, $qq + 1) == "\n" ou sous_chaine($src_proc, $qq, $qq + 1) == "\t")) {
                    $qq = $qq + 1
                  }
                  $a_sinon = 0
                  si ($qq + 4 < $long) {
                    si (sous_chaine($src_proc, $qq, $qq + 1) == "s" et sous_chaine($src_proc, $qq + 1, $qq + 2) == "i" et sous_chaine($src_proc, $qq + 2, $qq + 3) == "n" et sous_chaine($src_proc, $qq + 3, $qq + 4) == "o" et sous_chaine($src_proc, $qq + 4, $qq + 5) == "n") {
                      $a_sinon = 1
                    }
                  }
                  si ($a_sinon == 0) {
                    $encore = 0
                  } sinon {
                    $qq2 = $qq + 5
                    tant_que ($qq2 < $long et (sous_chaine($src_proc, $qq2, $qq2 + 1) == " " ou sous_chaine($src_proc, $qq2, $qq2 + 1) == "\n" ou sous_chaine($src_proc, $qq2, $qq2 + 1) == "\t")) {
                      $qq2 = $qq2 + 1
                    }
                    $sinon_si2 = 0
                    si ($qq2 + 3 < $long) {
                      si (sous_chaine($src_proc, $qq2, $qq2 + 1) == "s" et sous_chaine($src_proc, $qq2 + 1, $qq2 + 2) == "i") {
                        $suivant2 = ""
                        si ($qq2 + 2 < $long) { $suivant2 = sous_chaine($src_proc, $qq2 + 2, $qq2 + 3) }
                        si ($suivant2 == " " ou $suivant2 == "(") {
                          $sinon_si2 = 1
                        }
                      }
                    }
                    si ($sinon_si2 == 1) {
                      # Consommer "si (cond) { ... }"
                      $jj2 = $qq2 + 2
                      tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) == " ") {
                        $jj2 = $jj2 + 1
                      }
                      si ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) == "(") {
                        $jj2 = $jj2 + 1
                        $prof2 = 1
                        tant_que ($jj2 < $long et $prof2 > 0) {
                          $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                          si ($ch == "(") { $prof2 = $prof2 + 1 }
                          si ($ch == ")") { $prof2 = $prof2 - 1 }
                          $jj2 = $jj2 + 1
                        }
                        tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) != "{") {
                          $jj2 = $jj2 + 1
                        }
                        $prof2 = 1
                        $jj2 = $jj2 + 1
                        tant_que ($jj2 < $long et $prof2 > 0) {
                          $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                          si ($ch == "{") { $prof2 = $prof2 + 1 }
                          si ($ch == "}") { $prof2 = $prof2 - 1 }
                          $jj2 = $jj2 + 1
                        }
                        $pos = $jj2
                      } sinon {
                        $encore = 0
                      }
                    } sinon {
                      # Consommer "{ ... }"
                      $jj2 = $qq2
                      tant_que ($jj2 < $long et sous_chaine($src_proc, $jj2, $jj2 + 1) != "{") {
                        $jj2 = $jj2 + 1
                      }
                      $prof2 = 1
                      $jj2 = $jj2 + 1
                      tant_que ($jj2 < $long et $prof2 > 0) {
                        $ch = sous_chaine($src_proc, $jj2, $jj2 + 1)
                        si ($ch == "{") { $prof2 = $prof2 + 1 }
                        si ($ch == "}") { $prof2 = $prof2 - 1 }
                        $jj2 = $jj2 + 1
                      }
                      $pos = $jj2
                    }
                  }
                }
                $corps = sous_chaine($src_proc, $debut + 1, $fin_bloc - 1)
                $avant = sous_chaine($src_proc, 0, $i)
                $apres = sous_chaine($src_proc, $pos, $long)
                $src_proc = $avant + $corps + $apres
                $modifie = 1
                $i = 0
              }
            }
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc

# Pretraitement pour : deplier les boucles "pour N de D vers F" a la compilation
# Semantique moteur : borne superieure EXCLUSIVE (de 1 vers 5 -> 1,2,3,4)
$src_proc4 = $src_proc
$modifie_pr = 1
$iter_max_pr = 10000
tant_que ($modifie_pr == 1) {
  $modifie_pr = 0
  $i = 0
  tant_que ($i < longueur($src_proc4)) {
    # Detecter "pour "
    $c1 = ""
    $c2 = ""
    $c3 = ""
    $c4 = ""
    $c5 = ""
    si ($i < longueur($src_proc4)) { $c1 = sous_chaine($src_proc4, $i, $i + 1) }
    si ($i + 1 < longueur($src_proc4)) { $c2 = sous_chaine($src_proc4, $i + 1, $i + 2) }
    si ($i + 2 < longueur($src_proc4)) { $c3 = sous_chaine($src_proc4, $i + 2, $i + 3) }
    si ($i + 3 < longueur($src_proc4)) { $c4 = sous_chaine($src_proc4, $i + 3, $i + 4) }
    si ($i + 4 < longueur($src_proc4)) { $c5 = sous_chaine($src_proc4, $i + 4, $i + 5) }
    si ($c1 == "p" et $c2 == "o" et $c3 == "u" et $c4 == "r" et $c5 == " ") {
      $j = $i + 5
      # Lire le nom de la variable de boucle (nom nu : alphanumerique + _)
      $nom_pr = ""
      $fin_nom = 0
      tant_que ($j < longueur($src_proc4) et $fin_nom == 0) {
        $ch = sous_chaine($src_proc4, $j, $j + 1)
        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
          $nom_pr = $nom_pr + $ch
          $j = $j + 1
        } sinon {
          $fin_nom = 1
        }
      }
      # Passer les espaces puis chercher "de "
      $j2 = $j
      tant_que ($j2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == " ") {
        $j2 = $j2 + 1
      }
      $a_de = 0
      si ($j2 + 2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == "d" et sous_chaine($src_proc4, $j2 + 1, $j2 + 2) == "e" et sous_chaine($src_proc4, $j2 + 2, $j2 + 3) == " ") {
        $a_de = 1
      }
      si ($a_de == 1 et longueur($nom_pr) > 0) {
        $j2 = $j2 + 3
        tant_que ($j2 < longueur($src_proc4) et sous_chaine($src_proc4, $j2, $j2 + 1) == " ") {
          $j2 = $j2 + 1
        }
        # Extraire expr1 jusqu'a " vers " (sequence v e r s delimitee par des espaces)
        $expr1 = ""
        $trouve_vers = 0
        $k2 = $j2
        tant_que ($k2 < longueur($src_proc4) et $trouve_vers == 0) {
          si ($k2 + 4 < longueur($src_proc4) et sous_chaine($src_proc4, $k2, $k2 + 1) == " " et sous_chaine($src_proc4, $k2 + 1, $k2 + 2) == "v" et sous_chaine($src_proc4, $k2 + 2, $k2 + 3) == "e" et sous_chaine($src_proc4, $k2 + 3, $k2 + 4) == "r" et sous_chaine($src_proc4, $k2 + 4, $k2 + 5) == "s" et sous_chaine($src_proc4, $k2 + 5, $k2 + 6) == " ") {
            $trouve_vers = 1
            $k2 = $k2 + 6
          } sinon {
            $expr1 = $expr1 + sous_chaine($src_proc4, $k2, $k2 + 1)
            $k2 = $k2 + 1
          }
        }
        si ($trouve_vers == 1) {
          # Extraire expr2 jusqu'a "{"
          $expr2 = ""
          $k3 = $k2
          $trouve_acc = 0
          tant_que ($k3 < longueur($src_proc4) et $trouve_acc == 0) {
            $ch = sous_chaine($src_proc4, $k3, $k3 + 1)
            si ($ch == "{") {
              $trouve_acc = 1
            } sinon {
              si ($ch != " " et $ch != "\n" et $ch != "\t") {
                $expr2 = $expr2 + $ch
              }
              $k3 = $k3 + 1
            }
          }
          si ($trouve_acc == 1) {
            # Trouver le corps { ... }
            $prof = 0
            $trouve_fb = 0
            $debut_pr = $k3
            $k4 = $k3
            tant_que ($k4 < longueur($src_proc4) et $trouve_fb == 0) {
              $ch = sous_chaine($src_proc4, $k4, $k4 + 1)
              si ($ch == "{") { $prof = $prof + 1 }
              si ($ch == "}") { $prof = $prof - 1 }
              si ($prof == 0 et $ch == "}") { $trouve_fb = 1 }
              $k4 = $k4 + 1
            }
            si ($trouve_fb == 1) {
              $fin_pr = $k4
              $corps_pr = sous_chaine($src_proc4, $debut_pr + 1, $fin_pr - 1)
              # Evaluer les bornes avec le contexte de variables
              # (en ARRIERE : la derniere valeur appendee gagne)
              $ctx = ""
              $vi = 1
              tant_que ($vi <= $nb_vars) {
                $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
                $vi = $vi + 1
              }
              # Pre-substituer les variables connues dans les bornes
              $e1_sub = $expr1
              $e2_sub = $expr2
              $vi = $nb_vars
              tant_que ($vi >= 1) {
                $e1_sub = substituer_nom($e1_sub, $var_noms[$vi], $var_vals[$vi])
                $e2_sub = substituer_nom($e2_sub, $var_noms[$vi], $var_vals[$vi])
                $vi = $vi - 1
              }
              si (longueur($ctx) > 0) {
                $e1_full = $e1_sub + " // vars: " + $ctx
                $e2_full = $e2_sub + " // vars: " + $ctx
              } sinon {
                $e1_full = $e1_sub
                $e2_full = $e2_sub
              }
              $d1 = eval_expr($e1_full)
              $f2 = eval_expr($e2_full)
              # Verifier que les bornes sont numeriques
              $bornes_ok = 1
              $kc = 0
              tant_que ($kc < longueur($d1)) {
                $chc = sous_chaine($d1, $kc, $kc + 1)
                si (($chc < "0" ou $chc > "9") et $kc > 0) {
                  $bornes_ok = 0
                }
                si ($kc == 0 et $chc != "-" et ($chc < "0" ou $chc > "9")) {
                  $bornes_ok = 0
                }
                $kc = $kc + 1
              }
              $kc = 0
              tant_que ($kc < longueur($f2)) {
                $chc = sous_chaine($f2, $kc, $kc + 1)
                si (($chc < "0" ou $chc > "9") et $kc > 0) {
                  $bornes_ok = 0
                }
                si ($kc == 0 et $chc != "-" et ($chc < "0" ou $chc > "9")) {
                  $bornes_ok = 0
                }
                $kc = $kc + 1
              }
              si ($bornes_ok == 1) {
                # Deplier : remplacer le nom de boucle par sa valeur dans le corps
                $unrolled = ""
                $valeur = $d1
                $n_iter = 0
                $fini = 0
                tant_que ($fini == 0 et $n_iter < $iter_max_pr) {
                  $cmp_full = $valeur + " < " + $f2
                  si (longueur($ctx) > 0) {
                    $cmp_full = $cmp_full + " // vars: " + $ctx
                  }
                  $cmp_val = eval_expr($cmp_full)
                  si ($cmp_val == "vrai" ou $cmp_val == "1") {
                    # Collecter les noms assignes dans ce corps
                    $assigns_pr = ""
                    $ap2 = 0
                    $nb_corps2 = longueur($corps_pr)
                    tant_que ($ap2 < $nb_corps2) {
                      $flp = $ap2
                      $af = 0
                      tant_que ($flp < $nb_corps2 et $af == 0) {
                        si (sous_chaine($corps_pr, $flp, $flp + 1) == "\n") { $af = 1 } sinon { $flp = $flp + 1 }
                      }
                      $lnp = sous_chaine($corps_pr, $ap2, $flp)
                      $lcp = 0
                      tant_que ($lcp < longueur($lnp) et (sous_chaine($lnp, $lcp, $lcp + 1) == " " ou sous_chaine($lnp, $lcp, $lcp + 1) == "\t")) { $lcp = $lcp + 1 }
                      $nom_p2 = ""
                      $lap = $lcp
                      $finp = 0
                      tant_que ($lap < longueur($lnp) et $finp == 0) {
                        $ch = sous_chaine($lnp, $lap, $lap + 1)
                        si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                          $nom_p2 = $nom_p2 + $ch
                          $lap = $lap + 1
                        } sinon {
                          $finp = 1
                        }
                      }
                      $lap2 = $lap
                      tant_que ($lap2 < longueur($lnp) et sous_chaine($lnp, $lap2, $lap2 + 1) == " ") { $lap2 = $lap2 + 1 }
                      si ($lap2 < longueur($lnp) et sous_chaine($lnp, $lap2, $lap2 + 1) == "=" et longueur($nom_p2) > 0) {
                        $assigns_pr = $assigns_pr + $nom_p2 + " "
                      }
                      $ap2 = $flp + 1
                    }
                    # contexte de cette iteration
                    $ctx_it = $ctx
                    si (longueur($nom_pr) > 0) {
                      $ctx_it = $nom_pr + "=" + $valeur + " " + $ctx
                    }
                    # Deplier le corps ligne par ligne
                    $sub_it = ""
                    $lp2 = 0
                    $nb_corps = longueur($corps_pr)
                    tant_que ($lp2 < $nb_corps) {
                      $fl2 = $lp2
                      $a_fl2 = 0
                      tant_que ($fl2 < $nb_corps et $a_fl2 == 0) {
                        si (sous_chaine($corps_pr, $fl2, $fl2 + 1) == "\n") {
                          $a_fl2 = 1
                        } sinon {
                          $fl2 = $fl2 + 1
                        }
                      }
                      $ligne2 = sous_chaine($corps_pr, $lp2, $fl2)
                      $lc2 = 0
                      tant_que ($lc2 < longueur($ligne2) et (sous_chaine($ligne2, $lc2, $lc2 + 1) == " " ou sous_chaine($ligne2, $lc2, $lc2 + 1) == "\t")) {
                        $lc2 = $lc2 + 1
                      }
                      $conso2 = 0
                      si ($lc2 + 1 < longueur($ligne2)) {
                        si (sous_chaine($ligne2, $lc2, $lc2 + 1) == ">" et sous_chaine($ligne2, $lc2 + 1, $lc2 + 2) == ">") {
                          $ja2 = $lc2 + 2
                          tant_que ($ja2 < longueur($ligne2) et sous_chaine($ligne2, $ja2, $ja2 + 1) == " ") {
                            $ja2 = $ja2 + 1
                          }
                          $expr_a2 = sous_chaine($ligne2, $ja2, longueur($ligne2))
                          si (longueur($expr_a2) > 0) {
                            # literaliser seulement si depend d'une var assignee
                            $lit = 0
                            $probe = $expr_a2
                            $cur = ""
                            $ki = 0
                            $nass = longueur($assigns_pr)
                            tant_que ($ki < $nass) {
                              $ch = sous_chaine($assigns_pr, $ki, $ki + 1)
                              si ($ch == " ") {
                                si (longueur($cur) > 0) {
                                  $probe2 = substituer_nom($probe, $cur, "@A@")
                                  si ($probe2 != $probe) { $lit = 1 }
                                  $probe = $probe2
                                }
                                $cur = ""
                              } sinon {
                                $cur = $cur + $ch
                              }
                              $ki = $ki + 1
                            }
                            si (longueur($cur) > 0) {
                              $probe2 = substituer_nom($probe, $cur, "@A@")
                              si ($probe2 != $probe) { $lit = 1 }
                            }
                            si ($lit == 1) {
                              si (longueur($ctx_it) > 0) {
                                $ea_full = $expr_a2 + " // vars: " + $ctx_it
                              } sinon {
                                $ea_full = $expr_a2
                              }
                              $val_a2 = eval_expr($ea_full)
                              $sub_it = $sub_it + '>> "' + $val_a2 + '"' + "\n"
                            } sinon {
                              $expr_sub2 = $expr_a2
                              $expr_sub2 = substituer_nom($expr_sub2, $nom_pr, $valeur)
                              $li4 = $nb_vars
                              tant_que ($li4 >= 1) {
                                $expr_sub2 = substituer_nom($expr_sub2, $var_noms[$li4], $var_vals[$li4])
                                $li4 = $li4 - 1
                              }
                              $sub_it = $sub_it + ">> " + $expr_sub2 + "\n"
                            }
                          }
                          $conso2 = 1
                        }
                      }
                      si ($conso2 == 0) {
                        # detecter affectation nue
                        $trim2 = $ligne2
                        $lt2 = 0
                        tant_que ($lt2 < longueur($trim2) et (sous_chaine($trim2, $lt2, $lt2 + 1) == " " ou sous_chaine($trim2, $lt2, $lt2 + 1) == "\t")) {
                          $lt2 = $lt2 + 1
                        }
                        $nom_a2 = ""
                        $la2 = $lt2
                        $fin_na2 = 0
                        tant_que ($la2 < longueur($trim2) et $fin_na2 == 0) {
                          $ch = sous_chaine($trim2, $la2, $la2 + 1)
                          si (($ch >= "a" et $ch <= "z") ou ($ch >= "A" et $ch <= "Z") ou ($ch >= "0" et $ch <= "9") ou $ch == "_") {
                            $nom_a2 = $nom_a2 + $ch
                            $la2 = $la2 + 1
                          } sinon {
                            $fin_na2 = 1
                          }
                        }
                        $la3 = $la2
                        tant_que ($la3 < longueur($trim2) et sous_chaine($trim2, $la3, $la3 + 1) == " ") {
                          $la3 = $la3 + 1
                        }
                        $est_aff2 = 0
                        si ($la3 < longueur($trim2)) {
                          si (sous_chaine($trim2, $la3, $la3 + 1) == "=") {
                            $est_aff2 = 1
                          }
                        }
                        si ($est_aff2 == 1 et longueur($nom_a2) > 0) {
                          $kx2 = $la3 + 1
                          tant_que ($kx2 < longueur($trim2) et sous_chaine($trim2, $kx2, $kx2 + 1) == " ") {
                            $kx2 = $kx2 + 1
                          }
                          $expr_a2b = sous_chaine($trim2, $kx2, longueur($trim2))
                          si (longueur($ctx_it) > 0) {
                            $ea2_full = $expr_a2b + " // vars: " + $ctx_it
                          } sinon {
                            $ea2_full = $expr_a2b
                          }
                          $val_a2b = eval_expr($ea2_full)
                          $ctx_it = $ctx_it + " " + $nom_a2 + "=" + $val_a2b
                        } sinon {
                          $ligne_s2 = $ligne2
                          $ligne_s2 = substituer_nom($ligne_s2, $nom_pr, $valeur)
                          $li4 = $nb_vars
                          tant_que ($li4 >= 1) {
                            $ligne_s2 = substituer_nom($ligne_s2, $var_noms[$li4], $var_vals[$li4])
                            $li4 = $li4 - 1
                          }
                          $sub_it = $sub_it + $ligne_s2 + "\n"
                        }
                      }
                      $lp2 = $fl2 + 1
                    }
                    $unrolled = $unrolled + $sub_it
                    $valeur = eval_expr($valeur + " + 1")
                    $n_iter = $n_iter + 1
                  } sinon {
                    $fini = 1
                  }
                }
                # Remplacer le bloc pour par les iterations depliees
                $avant = sous_chaine($src_proc4, 0, $i)
                $apres = sous_chaine($src_proc4, $fin_pr, longueur($src_proc4))
                $src_proc4 = $avant + $unrolled + $apres
                $modifie_pr = 1
                $i = 0
              }
            }
          }
        }
      }
    }
    $i = $i + 1
  }
}

$src = $src_proc4

# Post-traitement : evaluer numeriquement chaque ligne ">> <expr>" deja
# substituee (les noms ont ete remplaces plus tot), pour que les appels
# recursifs plies reviennent a des nombres.
$k = 0
$modif_num = 1
tant_que ($modif_num == 1) {
  $modif_num = 0
  $j = $k
  # trouver la prochaine ">> "
  $pos_g = -1
  $kk = $j
  tant_que ($kk + 3 <= longueur($src)) {
    si (sous_chaine($src, $kk, $kk + 3) == ">> ") {
      $pos_g = $kk
      $kk = longueur($src)
    } sinon {
      $kk = $kk + 1
    }
  }
  si ($pos_g < 0) {
    $k = longueur($src)
  } sinon {
    # avancer les espaces
    $p2 = $pos_g + 3
    tant_que ($p2 < longueur($src) et sous_chaine($src, $p2, $p2 + 1) == " ") { $p2 = $p2 + 1 }
    # lire l'expression jusqu'a \n
    $e2 = ""
    $p3 = $p2
    $fin_l2 = $p2
    $fini_l2 = 0
    tant_que ($p3 < longueur($src) et $fini_l2 == 0) {
      $cch = sous_chaine($src, $p3, $p3 + 1)
      si ($cch == "\n") {
        $fin_l2 = $p3
        $fini_l2 = 1
      } sinon {
        $e2 = $e2 + $cch
        $p3 = $p3 + 1
      }
    }
    $fin_l2 = $p3
    # evaluer via eval_expr, avec le contexte des variables connues
    $ctx2 = ""
    $vw = 1
    tant_que ($vw <= $nb_vars) {
      $ctx2 = $ctx2 + $var_noms[$vw] + "=" + $var_vals[$vw] + " "
      $vw = $vw + 1
    }
    si (longueur($ctx2) > 0) {
      $res2 = eval_expr($e2 + " // vars: " + $ctx2)
    } sinon {
      $res2 = eval_expr($e2)
    }
        # Ne pas remplacer un littéral chaîne : les guillemets doivent être
    # préservés pour que l'extraction ">>" puisse distinguer une chaîne
    # d'une variable du même nom.
    $nb_e2 = longueur($e2)
    $est_chaine_lit = 0
    si ($nb_e2 >= 2) {
      $f1b = sous_chaine($e2, 0, 1)
      $f2b = sous_chaine($e2, $nb_e2 - 1, $nb_e2)
      si ($f1b == "\"" et $f2b == "\"") {
        $est_chaine_lit = 1
      }
    }
    # Ne pas remplacer un booléen (vrai/faux) : ils sont affichés tels quels
    # par l'extraction finale, ce qui produirait du bruit pour les conditions
    # de boucle (tant_que/pour) déjà traitées au prétraitement.
    $est_bool = 0
    si ($res2 == "vrai" ou $res2 == "faux") {
      $est_bool = 1
    }
    si (longueur($res2) > 0 et $res2 != $e2 et $est_chaine_lit == 0 et $est_bool == 0) {
      $avant2 = sous_chaine($src, 0, $pos_g)
      $apres2 = sous_chaine($src, $fin_l2, longueur($src))
      $src = $avant2 + ">> " + $res2 + $apres2
      $p4 = $pos_g + 3 + longueur($res2)
      $fini_p4 = 0
      tant_que ($p4 < longueur($src) et $fini_p4 == 0) {
        si (sous_chaine($src, $p4, $p4 + 1) == "\n") { $fini_p4 = 1 } sinon { $p4 = $p4 + 1 }
      }
      $k = $p4
      $modif_num = 1
    } sinon {
      $k = $fin_l2
    }
  }
}

# Extraire et evaluer toutes les expressions apres >>
$affichage = ""
$dernier_resultat = ""
$dernier_expr_texte = ""
$i = 0
tant_que ($i < longueur($src)) {
  $c1 = ""
  $c2 = ""
  $c3 = ""
  si ($i < longueur($src)) { $c1 = sous_chaine($src, $i, $i + 1) }
  si ($i + 1 < longueur($src)) { $c2 = sous_chaine($src, $i + 1, $i + 2) }
  si ($i + 2 < longueur($src)) { $c3 = sous_chaine($src, $i + 2, $i + 3) }
  # Detecter "var " (deja traite en preprocessing, skip)
  si ($c1 == "v" et $c2 == "a" et $c3 == "r") {
    $i = $i + 1
  } sinon si ($c1 == ">" et $c2 == ">") {
    $j = $i + 2
    tant_que ($j < longueur($src) et sous_chaine($src, $j, $j + 1) == " ") {
      $j = $j + 1
    }
    # Extraire l'expression jusqu'a la fin de ligne
    $pc = ""
    si ($j < longueur($src)) { $pc = sous_chaine($src, $j, $j + 1) }
    $expr = ""
    $k = $j
    tant_que ($k < longueur($src)) {
      $ch = sous_chaine($src, $k, $k + 1)
      si ($ch == "\n") {
        $k = longueur($src) + 1
      } sinon {
        $expr = $expr + $ch
        $k = $k + 1
      }
    }
        si (longueur($expr) > 0) {
      # Verifier si c'est un nom de variable connu (en ARRIERE :
      # la valeur la plus recente fait foi apres le shadowing)
      $est_var = 0
      $vi = $nb_vars
      tant_que ($vi >= 1) {
        si ($est_var == 0) {
          si ($var_noms[$vi] == $expr) {
            $est_var = 1
            $resultat = $var_vals[$vi]
          }
        }
        $vi = $vi - 1
      }
      si ($est_var == 0) {
        # Si l'expression est deja un appel eval_expr(...) , evaluer directement.
        $est_ee = 0
        si (longueur($expr) >= 11) {
          si (sous_chaine($expr, 0, 10) == "eval_expr(") {
            $est_ee = 1
          }
        }
        si ($est_ee == 1) {
          # Extraire l'argument de eval_expr(...) : sous_chaine entre ( et ) final
          $j0 = 10
          $n0 = longueur($expr)
          # $expr = "eval_expr(<arg>)"
          $nb_arg = 0
          $k0 = $j0
          $cur = ""
          $prof0 = 0
          $fini0 = 0
          $arg_ee = ""
          tant_que ($k0 < $n0 et $fini0 == 0) {
            $cc = sous_chaine($expr, $k0, $k0 + 1)
            si ($cc == "(" ou $cc == "[" ou $cc == "{") {
              $prof0 = $prof0 + 1
              $cur = $cur + $cc
            } sinon si ($cc == ")" ou $cc == "]" ou $cc == "}") {
              si ($prof0 == 0) {
                $fini0 = 1
              } sinon {
                $prof0 = $prof0 - 1
                $cur = $cur + $cc
              }
            } sinon {
              $cur = $cur + $cc
            }
            $k0 = $k0 + 1
          }
          # trim
          $nbcur = longueur($cur)
          tant_que ($nbcur > 0 et sous_chaine($cur, 0, 1) == " ") { $cur = sous_chaine($cur, 1, longueur($cur)); $nbcur = longueur($cur) }
          $nbcur = longueur($cur)
          tant_que ($nbcur > 0 et sous_chaine($cur, $nbcur - 1, $nbcur) == " ") { $cur = sous_chaine($cur, 0, $nbcur - 1); $nbcur = longueur($cur) }
          $arg_ee = $cur
          # si l'arg commence par " et finit par ", decaper
          $nb_arg = longueur($arg_ee)
          si ($nb_arg >= 2) {
            $f1 = sous_chaine($arg_ee, 0, 1)
            $f2 = sous_chaine($arg_ee, $nb_arg - 1, $nb_arg)
            si ($f1 == "\"" et $f2 == "\"") {
              $arg_ee = sous_chaine($arg_ee, 1, $nb_arg - 1)
            }
          }
          $resultat = eval_expr($arg_ee)
                  } sinon {
          # Construire le contexte de variables (en AVANT : la derniere
          # valeur appendee fait foi via la substitution par paires_prelude).
          $ctx = ""
          $vi = 1
          tant_que ($vi <= $nb_vars) {
            $ctx = $ctx + $var_noms[$vi] + "=" + $var_vals[$vi] + " "
            $vi = $vi + 1
          }
          si (longueur($ctx) > 0) {
            $expr_full = $expr + " // vars: " + $ctx
          } sinon {
            $expr_full = $expr
          }
          $resultat = eval_expr($expr_full)
        }
      }
            $dernier_expr_texte = $expr
            $dernier_resultat = $resultat
            $affichage = $affichage + $resultat + "\n"
    }
  }
  $i = $i + 1
}
si (longueur($affichage) == 0) {
  afficher_erreur("emetteur_elf : pas de >> <expression> trouve")
  quitter(1)
}
$cible = "aarch64"
si (nb_arguments() >= 3) {
  $cible = argument(2)
  si (longueur($cible) == 0) { $cible = "aarch64" }
}
emettre_elf_print($sortie, $affichage, $dernier_resultat, $dernier_expr_texte, $cible)
