# tests_valeurs_types.rose — HORDE VALEURS : 53 assertions sur les 7 types
# Valeur ajoutés à `compilateur/moteur_valeurs.rose` (tags 8..14).
#
# Ce fichier est un MODULE SOURCE : Rose n'a pas d'instruction `include`.
# Il se concatène avec `compilateur/moteur_valeurs.rose` :
#
#   cat compilateur/moteur_valeurs.rose compilateur/tests_valeurs_types.rose \
#       > /tmp/opencode/horde_val_artifacts/tests_prog.rose
#   ROSE_SANS_JIT=1 rose interprete tests_prog.rose     # référence Rust
#   C0 tests_prog.rose > tests.elf && ./tests.elf        # sans Rust
#   diff nat.out elf.out
#
# Les chaînes ATTENDU ont été mesurées sur le moteur Rust de référence
# (`ROSE_SANS_JIT=1 rose interprete`, 23/11/2026) avec les littéraux natifs
# correspondants : 1.5, 1/3, (3+4i), racine(2), table(), rope, listes.
# Aucune primitive Rust n'est appelée ici : le même source tourne dans les
# deux moteurs. Convention : 1 ligne OK/ECHEC par assertion + TOTAL.

# Raccourcis de construction (réduisent le bruit, aucun état global).
fn tt_cpl(re: chaine, im: chaine) -> liste<entier> {
  retour v_cpl(v_flt_ch(re), v_flt_ch(im))
}

fn tt_ok(obtenu: chaine, attendu: chaine) -> entier {
  si (obtenu == attendu) { retour 1 }
  retour 0
}

fn tt_res(n: entier, nom: chaine, obtenu: chaine, attendu: chaine) -> chaine {
  si (obtenu == attendu) { retour "OK " + chaine(n) + " " + nom }
  retour "ECHEC " + chaine(n) + " " + nom + " | obtenu=[" + obtenu + "] attendu=[" + attendu + "]"
}

$total = 0

# ── A. FLOTTANT (tag 8) — 10 assertions ────────────────────────────────────
$o = tv_valeur_texte(v_flt_ch("1.5"))
$a = "1.5"
>> tt_res(1, "flt_1_5", $o, $a)
$total = $total + tt_ok($o, $a)

$o = tv_valeur_texte(v_flt_ch("1000000.0"))
$a = "1000000"
>> tt_res(2, "flt_million", $o, $a)
$total = $total + tt_ok($o, $a)

$o = tv_valeur_texte(v_flt_ch("-0.0"))
