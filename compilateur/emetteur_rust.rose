// emetteur_rust.rose — V4 : traducteur RIR -> Rust (entiers + chaines + globals + fonctions).

// ---------- utilitaires chaînes ----------
fn trim($s: chaine) -> chaine {
  $n = longueur($s)
  $i_t = 0
  $stop = faux
  tant_que ($i_t < $n et $stop == faux) {
    $c = $s[$i_t]
    si ($c == ' ' ou $c == '\t') { $i_t = $i_t + 1 } sinon { $stop = vrai }
  }
  $j = $n
  $stop = faux
  tant_que ($j > $i_t et $stop == faux) {
    $c = $s[$j-1]
    si ($c == ' ' ou $c == '\t') { $j = $j - 1 } sinon { $stop = vrai }
  }
  retour sous_chaine($s, $i_t, $j)
}

fn cpp_type_name($t: chaine) -> chaine {
  si ($t == "h") { retour "i64" }
  si ($t == "s") { retour "String" }
  si ($t == "b") { retour "bool" }
  si ($t == "f") { retour "f64" }
  si ($t == "q") { retour "i64" }
  si ($t == "g") { retour "i64" }
  si ($t == "l") { retour "Vec<i64>" }
  si ($t == "t") { retour "Vec<u8>" }
  si ($t == "y") { retour "i64" }
  retour "i64"
}

fn chaine_cpp($v: chaine) -> chaine {
  $out = "\""
  $i = 0
  $n = longueur($v)
  tant_que ($i < $n) {
    $c = $v[$i]
    si (ordre($c) == 10) { $out = $out + "\\n" }
    sinon si (ordre($c) == 9) { $out = $out + "\\t" }
    sinon { $out = $out + $c }
    $i = $i + 1
  }
  $out = $out + "\".to_string()"
  retour $out
}

fn c_name($nom: chaine) -> chaine {
  $out = $nom
  si (commence_par($out, "$")) { $out = sous_chaine($out, 1, longueur($out)) }
  retour $out
}

fn premier_car($x: chaine) -> chaine {
  si (longueur($x) == 0) { retour "" }
  retour sous_chaine($x, 0, 1)
}

fn est_vide($s: chaine) -> booleen {
  retour longueur($s) == 0
}

fn commence_par($s: chaine, $p: chaine) -> booleen {
  si (longueur($p) > longueur($s)) { retour faux }
  retour sous_chaine($s, 0, longueur($p)) == $p
}

fn contient($s: chaine, $p: chaine) -> booleen {
  $i = 0
  tant_que ($i + longueur($p) <= longueur($s)) {
    si (sous_chaine($s, $i, $i + longueur($p)) == $p) { retour vrai }
    $i = $i + 1
  }
  retour faux
}

fn premier_espace($s: chaine) -> entier {
  $i = 0
  $n = longueur($s)
  tant_que ($i < $n) {
    si ($s[$i] == ' ') { retour $i }
    $i = $i + 1
  }
  retour $n
}

fn nom_fonction($l: chaine) -> chaine {
  $s = trim($l)
  $s = sous_chaine($s, 9, longueur($s))
  $i = premier_espace($s)
  si ($i < longueur($s)) { $s = sous_chaine($s, 0, $i) }
  retour $s
}

fn nom_type($t: chaine) -> chaine {
  $t = trim($t)
  si (longueur($t) == 0) { retour "entier" }
  retour $t
}

fn cpp_entete() -> chaine {
  $out = ""
  $out = $out + "fn main() {\\n"
  retour $out
}

fn cpp_pied() -> chaine {
  retour "}\\n"
}

fn cpp_affiche_entier($expr: chaine) -> chaine {
  retour "println!(\\\"{}\\\", " + $expr + ");\\n"
}

fn cpp_affiche_chaine($expr: chaine) -> chaine {
  retour "println!(\\\"{}\\\", " + $expr + ");\\n"
}

fn cpp_retour($expr: chaine) -> chaine {
  si ($expr == "") { retour "return;\\n" }
  retour "return " + $expr + ";\\n"
}

fn cpp_si($cond: chaine, $alors: chaine, $sinon: chaine) -> chaine {
  $out = "if " + $cond + " {\\n" + $alors + "}"
  si ($sinon != "") { $out = $out + " else {\\n" + $sinon + "}" }
  $out = $out + "\\n"
  retour $out
}

fn cpp_tant_que($cond: chaine, $corps: chaine) -> chaine {
  retour "while " + $cond + " {\\n" + $corps + "}\\n"
}

fn cpp_pour($var: chaine, $debut: chaine, $fin: chaine, $corps: chaine) -> chaine {
  retour "for " + $var + " in " + $debut + "..=" + $fin + " {\\n" + $corps + "}\\n"
}

fn cpp_fonction($nom: chaine, $params: chaine, $retour: chaine, $corps: chaine) -> chaine {
  $out = "fn " + $nom + "(" + $params + ") -> " + $retour + " {\\n"
  $out = $out + $corps
  $out = $out + "}\\n"
  retour $out
}

fn cpp_affect($nom: chaine, $expr: chaine) -> chaine {
  retour "let mut " + $nom + " = " + $expr + ";\\n"
}

fn cpp_affect_global($nom: chaine, $expr: chaine) -> chaine {
  retour "let mut " + $nom + " = " + $expr + ";\\n"
}
