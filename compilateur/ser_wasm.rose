# ser_wasm.rose — sérialiseur WASM écrit en Rose (sous-ensemble G5).
# Émet un module WebAssembly binaire valide depuis un dump RIR simple.
# ABI : rose_main() -> i64, exportée (index 0). Sous-ensemble i64 :
#   constantes, + - * (div), afficher / rose_main.
#
# Contrôle : >>7*6  ->  module de 48 octets, Node WebAssembly.instantiate
#                       renvoie 42n (identique à rose/src/transpile.rs).
#
# Ce fichier est autonome : `rose ser_wasm.rose dump.rir > out.wasm`.
# Le composite ne garde QUE les fonctions (avant le marqueur de fin),
# afin d'offrir `--cible wasm` sans dupliquer de main.

# ── primitives d'octets (1 caractere Rose = 1 octet) ──────────────────────
# Sous le MOTEUR RUST, `caractere(n)` est un OCTET BRUT (les chaînes Rose y
# sont byte-oriented, y compris pour n >= 128). Sous le COMPOSÉ C0, la copie
# de cette fonction utilise `octet_brut(n)` : `caractere(n)` y encoderait en
# UTF-8 (ex. 195 -> c3 83) et produirait des LEB128 surlongs. Les deux copies
# écrivent exactement le même octet ; seul le primitive diffère.
fn sw_octet($v: entier) -> chaine {
  retour caractere($v % 256)
}

fn sw_u16le($v: entier) -> chaine {
  retour sw_octet($v % 256) + sw_octet(partie_entiere($v / 256) % 256)
}

fn sw_u32le($v: entier) -> chaine {
  retour sw_octet($v % 256)
       + sw_octet(partie_entiere($v / 256) % 256)
       + sw_octet(partie_entiere($v / 65536) % 256)
       + sw_octet(partie_entiere($v / 16777216) % 256)
}

# LEB128 non signé (longueurs, index de sections).
fn sw_uleb($v: entier) -> chaine {
  $out = ""
  $x = $v
  tant_que ($x > 0) {
    $b = $x % 128
    $x = partie_entiere($x / 128)
    si ($x > 0) { $b = $b + 128 }
    $out = $out + sw_octet($b)
  }
  si (longueur($out) == 0) { $out = sw_octet(0) }
  retour $out
}

# SLEB128 signé (constantes i64), ENCODAGE MINIMAL.
# Ancienne forme : on divisait `$x` (négatif) par 128 puis on testait
# `$x == -1`. Sous le composé C0, ce test échouait sur les négatifs et
# émettait un octet de plus (ex. -7 -> f9 00 au lieu de 79).
# Forme retenue : on ne fait JAMAIS d'arithmétique sur un négatif.
#   v >= 0 : SLEB128 usuel, arrêt dès que le reste < 64 (bit de signe 0).
#   v < 0  : on code u = ~v = -v-1 >= 0, puis on COMPLEMENTE les 7 bits
#            de chaque octet. C'est l'identité SLEB(v) = ~SLEB(~v) sur 7 bits.
# Exemples vérifiés : -1 -> 7f, -7 -> 79, -64 -> 40, -65 -> bf 7f,
#                    64 -> c0 00, 579 -> c3 04, 2^31 -> 80 80 80 80 08.
fn sw_sleb($v: entier) -> chaine {
  $neg = 0
  $u = $v
  si ($v < 0) { $neg = 1; $u = -$v - 1 }
  $out = ""
  tant_que ($u >= 64) {
    $b = $u % 128
    $u = partie_entiere($u / 128)
    si ($neg == 1) { $b = 127 - $b }
    $out = $out + sw_octet($b + 128)
  }
  $b = $u
  si ($neg == 1) { $b = 127 - $b }
  $out = $out + sw_octet($b)
  retour $out
}

# Longueurs en OCTETS (longueur() compte des points de code : sous C0 les
# octets bruts >= 128 invalident UTF-8 et sont sous-comptés).
fn sw_uleb_len($v: entier) -> entier {
  $n = 1
  $x = $v
  tant_que ($x > 127) { $x = partie_entiere($x / 128); $n = $n + 1 }
  retour $n
}

fn sw_sleb_len($v: entier) -> entier {
  $neg = 0
  $u = $v
  si ($v < 0) { $neg = 1; $u = -$v - 1 }
  $n = 0
  tant_que ($u >= 64) { $u = partie_entiere($u / 128); $n = $n + 1 }
  retour $n + 1
}

# Chaîne WASM : u32 de longueur (octets UTF-8) puis les octets.
fn sw_chaine($s: chaine) -> chaine {
  retour sw_uleb(longueur($s)) + $s
}

# Section WASM : id, taille LEB128, contenu.
fn sw_section($id: entier, $c: chaine) -> chaine {
  retour sw_octet($id) + sw_uleb(longueur($c)) + $c
}

# Découpe une expression RIR en jetons : '(' et ')' deviennent des jetons
# séparés, les blancs sont des séparateurs.
fn sw_tokens($s: chaine) -> liste<chaine> {
  $brut = [""]
  $cur = ""
  $j = 0
  $n = longueur($s)
  tant_que ($j < $n) {
    $c = $s[$j]
    si ($c == "(" ou $c == ")") {
      si (longueur($cur) > 0) { joindre($brut, $cur); $cur = "" }
      joindre($brut, $c)
    } sinon {
      si ($c == " ") {
        si (longueur($cur) > 0) { joindre($brut, $cur); $cur = "" }
      } sinon { $cur = $cur + $c }
    }
    $j = $j + 1
  }
  si (longueur($cur) > 0) { joindre($brut, $cur) }
  $out = [""]
  $k = 1
  tant_que ($k < longueur($brut)) { joindre($out, $brut[$k]); $k = $k + 1 }
  retour $out
}

#_CODE_WASM des opcodes i64 :
#  i64.const = 0x42, local.get = 0x20, local.set = 0x21
#  i64.add = 0x7C, i64.sub = 0x7D, i64.mul = 0x7E, i64.div_s = 0x7F
fn sw_opbin($op: chaine) -> entier {
  si ($op == "+") { retour 124 }
  si ($op == "-") { retour 125 }
  si ($op == "*") { retour 126 }
  si ($op == "div" ou $op == "÷") { retour 127 }
  retour 124
}

# Parse une expression à partir du jeton $p (index 1-based dans $t).
# Retourne [position_6_chiffres, octets, nb_octets] : une LISTE de chaînes.
# ⚠ sous_chaine() compte en POINTS DE CODE et casse les octets bruts >= 128
# sous C0 (mesuré : "000005"+42+80*4+08 -> sous_chaine(.,6,longueur) rend
# seulement 42 80 80). La liste évite TOUT découpage d'une chaîne d'octets.
# $base = index du premier local (nombre de slots), $res = index de __result.
fn sw_expr($t: liste<chaine>, $p: entier, $base: entier, $res: entier) -> liste<chaine> {
  $tok = $t[$p]
  $q = $p + 1
  $b = ""
  $nb = 0
  si ($tok == "(") {
    $head = $t[$q]
    $q = $q + 1
    si ($head == "bin") {
      $op = $t[$q]
      $q = $q + 1
      $r1 = sw_expr($t, $q, $base, $res); $q = entier($r1[0]); $b = $b + $r1[1]; $nb = $nb + entier($r1[2])
      $r2 = sw_expr($t, $q, $base, $res); $q = entier($r2[0]); $b = $b + $r2[1]; $nb = $nb + entier($r2[2])
      $b = $b + sw_octet(sw_opbin($op))
      $nb = $nb + 1
    }
    si ($head == "n") {
      $v = entier($t[$q])
      $q = $q + 1
      $b = sw_octet(66) + sw_sleb($v)
      $nb = 1 + sw_sleb_len($v)
    }
    si ($head == "v") {
      $nv = $t[$q]
      $q = $q + 1
      $b = sw_octet(66) + sw_sleb(0)
      $nb = 2
    }
    si ($head != "bin" et $head != "n" et $head != "v") {
      $prof = 1
      tant_que ($q < longueur($t) et $prof > 0) {
        si ($t[$q] == "(") { $prof = $prof + 1 }
        si ($t[$q] == ")") { $prof = $prof - 1 }
        $q = $q + 1
      }
      $b = $b + sw_octet(66) + sw_sleb(0)
      $nb = $nb + 2
    }
    si ($q < longueur($t)) {
      si ($t[$q] == ")") { $q = $q + 1 }
    }
  } sinon {
    si ($tok == "entier" ou $tok == "f" ou $tok == "n") {
      $v = entier($t[$q])
      $q = $q + 1
      $b = sw_octet(66) + sw_sleb($v)
      $nb = 1 + sw_sleb_len($v)
    }
    si ($tok == "slot") {
      $sl = entier($t[$q])
      $q = $q + 1
      $b = sw_octet(32) + sw_uleb($sl + $base)
      $nb = 1 + sw_uleb_len($sl + $base)
    }
    si ($tok == "booleen" ou $tok == "vrai") {
      $b = sw_octet(66) + sw_sleb(1)
      $nb = 2
    }
    si ($tok == "faux") {
      $b = sw_octet(66) + sw_sleb(0)
      $nb = 2
    }
  }
  $pos = chaine($q)
  tant_que (longueur($pos) < 6) { $pos = "0" + $pos }
  $r = [$pos]
  joindre($r, $b)
  joindre($r, chaine($nb))
  retour $r
}

# Prend la sous-chaine d'une ligne d'op RIR après le mot-clé.
fn sw_reste($ligne: chaine, $mot: chaine) -> chaine {
  $n = longueur($ligne)
  $m = longueur($mot)
  $j = 0
  tant_que ($j + $m <= $n) {
    si (sous_chaine($ligne, $j, $j + $m) == $mot) {
      retour sous_chaine($ligne, $j + $m, $n)
    }
    $j = $j + 1
  }
  retour ""
}

# Assemble le module complet depuis un dump RIR.
fn sw_module($rir: chaine) -> chaine {
  # Découpe le dump en lignes.
  $lignes = [""]
  $cur = ""
  $j = 0
  $n = longueur($rir)
  tant_que ($j < $n) {
    $c = $rir[$j]
    si (ordre($c) == 10) {
      joindre($lignes, $cur)
      $cur = ""
    } sinon { $cur = $cur + $c }
    $j = $j + 1
  }
  si (longueur($cur) > 0) { joindre($lignes, $cur) }

  # On ne sérialise QUE le corps de $principal : les corps de fonctions
  # sont hors du sous-ensemble i64 (Appel/CALL n'est pas émis ici).
  $debut = 1
  $j = 1
  tant_que ($j < longueur($lignes)) {
    $tk = sw_tokens($lignes[$j])
    si (longueur($tk) > 2) {
      si ($tk[1] == "fonction" et $tk[2] == "$principal") {
        $k = $j + 1
        tant_que ($k < longueur($lignes)) {
          $tp = sw_tokens($lignes[$k])
          si (longueur($tp) > 1) {
            si ($tp[1] == "ops") { $debut = $k + 1; $k = 100000 }
          }
          $k = $k + 1
        }
        $j = 100000
      }
    }
    $j = $j + 1
  }

  # Nombre de slots du principal (les variables deviennent des locaux).
  $nslots = 0
  $j = 1
  tant_que ($j < $debut) {
    $tk = sw_tokens($lignes[$j])
    si (longueur($tk) > 1) {
      si ($tk[1] == "n_slots") { $nslots = entier($tk[2]) }
    }
    $j = $j + 1
  }
  # Le compilateur Rust alloue __result EN PREMIER (local 0), puis les
  # slots (local 1, 2, …). On reproduit exactement cet ordre.
  $base = 1
  $res = 0
  $nlocaux = $nslots + 1

  $code = ""
  $ncode = 0
  $j = $debut
  tant_que ($j < longueur($lignes)) {
    $tt = sw_tokens($lignes[$j])
    $kind = ""
    si (longueur($tt) > 2) { $kind = $tt[2] }
    $affiche = 0
    si ($kind == "afficher_abstrait" ou $kind == "afficher" ou $kind == "retour_abstrait" ou $kind == "retour") { $affiche = 1 }
    si ($affiche == 1) {
      $r = sw_expr($tt, 3, $base, $res)
      $code = $code + $r[1]
      $ncode = $ncode + entier($r[2])
      # local.set $res : toute valeur `>>` devient le résultat de rose_main.
      $code = $code + sw_octet(33) + sw_uleb($res)
      $ncode = $ncode + 1 + sw_uleb_len($res)
    }
    si ($kind == "affect") {
      $slot = entier($tt[4])
      $r = sw_expr($tt, 6, $base, $res)
      $code = $code + $r[1]
      $ncode = $ncode + entier($r[2])
      $code = $code + sw_octet(33) + sw_uleb($slot + $base)
      $ncode = $ncode + 1 + sw_uleb_len($slot + $base)
    }
    $j = $j + 1
  }

  # Corps de rose_main : [1 groupe de locaux][N i64][code][local.get res][end]
  $corps = sw_uleb(1) + sw_uleb($nlocaux) + sw_octet(126)
         + $code + sw_octet(32) + sw_uleb($res) + sw_octet(11)
  $ncorps = sw_uleb_len(1) + sw_uleb_len($nlocaux) + 1 + $ncode
          + 1 + sw_uleb_len($res) + 1
  $code_section = sw_uleb(1) + sw_uleb($ncorps) + $corps
  $ncs = 1 + sw_uleb_len($ncorps) + $ncorps

  # Type unique : () -> i64
  $types = sw_uleb(1) + sw_octet(96) + sw_uleb(0) + sw_uleb(1) + sw_octet(126)
  $fonctions = sw_uleb(1) + sw_uleb(0)
  $exports = sw_uleb(1) + sw_chaine("rose_main") + sw_octet(0) + sw_uleb(0)

  retour sw_octet(0) + "asm" + sw_u32le(1)
       + sw_section(1, $types)
       + sw_section(3, $fonctions)
       + sw_section(7, $exports)
       + sw_octet(10) + sw_uleb($ncs) + $code_section
}

# ═══ FIN DES FONCTIONS (le composite ne garde que ce qui précède) ═══
si (nb_arguments() > 0) {
  $rir = lire_texte(argument(0))
  ecrire_bytes("/dev/stdout", sw_module($rir))
}
