# lecteur_source.rose — jalon J6.5 : LECTEUR DE SOURCE auto-hébergé.
#
# API publique :
#   lire_programme(chemin)                     -> chaine
#   lire_programme_reg(chemin, noms, sources)  -> chaine
#
# Réponse : "OK|" + dump RIR octet pour octet de `rose rir`, ou
#           "ERR|" + diagnostic exact (une seule ligne, la première erreur).
#
# Ce fichier réutilise INTÉGRALEMENT le front-end de compilateur/emetteur.rose
# (lexage, descente, repli, vérification, émission RIR). Il n'ajoute que ce
# qu'un lecteur runtime doit faire et que le composite ne faisait pas :
#   1. imports RÉCURSIFS, résolus d'abord tels quels puis À CÔTÉ du fichier
#      importateur (règle des jardins, rose/src/front.rs:2938-3012) ;
#   2. déduplication par chemin normalisé (cycles coupés) et garde de profondeur ;
#   3. diagnostics d'import exacts quand un registre de sources est fourni ;
#   4. registre de sources injectable (pas de système de fichiers requis :
#      WASM / navigateur) ; `lire_programme()` lit le disque via lire_texte.
#   5. encodage : les chaînes Rose sont indexées en POINTS DE CODE dans le
#      moteur Rust ET dans le binaire G5 (mesuré, voir rose/docs/HORDE_SOURCE.md).
#
# Généré depuis compilateur/emetteur.rose — NE PAS ÉDITER LE FRONT-END CI-DESSOUS.

# ────────────────── utilitaires de chemin (préfixe ls_) ──────────────────

fn ls_est_absolu($p: chaine) -> booleen {
  si (longueur($p) == 0) { retour faux }
  retour ordre($p[0]) == 47
}

fn ls_dossier($p: chaine) -> chaine {
  $n = longueur($p)
  $j = $n - 1
  tant_que ($j >= 0 et ordre($p[$j]) != 47) { $j = $j - 1 }
  si ($j < 0) { retour "" }
  si ($j == 0) { retour "/" }
  retour sous_chaine($p, 0, $j)
}

fn ls_jointure($d: chaine, $r: chaine) -> chaine {
  si (ls_est_absolu($r)) { retour $r }
  si ($d == "") { retour $r }
  si ($d == "/") { retour "/" + $r }
  retour $d + "/" + $r
}

# Chemin canonique léger : écrase "x/./y" et "x/../y", garde le '/' initial.
fn ls_norm($p: chaine) -> chaine {
  $n = longueur($p)
  $abs = 0
  si ($n > 0) { si (ordre($p[0]) == 47) { $abs = 1 } }
  $r = ""
  si ($abs == 1) { $r = "/" }
  $cur = ""
  $i = 0
  tant_que ($i < $n) {
    $c = ordre($p[$i])
    si ($c == 47) {
      si ($cur == ".") {
        $cur = ""
      } sinon si ($cur == "..") {
        $cur = ""
        $k = longueur($r) - 1
        tant_que ($k > 0 et ordre($r[$k]) != 47) { $k = $k - 1 }
        $r = ""
        si ($abs == 1) { $r = "/" }
        si ($k > 0) {
          $r = sous_chaine($r, 0, $k)
          si ($abs == 1) { $r = "/" + sous_chaine($r, 1, longueur($r)) }
        }
      } sinon {
        si ($cur != "") {
          si ($r == "") { $r = $cur }
          sinon si ($r == "/") { $r = "/" + $cur }
          sinon { $r = $r + "/" + $cur }
        }
        $cur = ""
      }
    } sinon { $cur = $cur + $p[$i] }
    $i = $i + 1
  }
  si ($cur == "..") {
    $k = longueur($r) - 1
    tant_que ($k > 0 et ordre($r[$k]) != 47) { $k = $k - 1 }
    $r = ""
    si ($abs == 1) { $r = "/" }
    si ($k > 0) {
      $r = sous_chaine($r, 0, $k)
      si ($abs == 1) { $r = "/" + sous_chaine($r, 1, longueur($r)) }
    }
  } sinon si ($cur != "" et $cur != ".") {
    si ($r == "") { $r = $cur }
    sinon si ($r == "/") { $r = "/" + $cur }
    sinon { $r = $r + "/" + $cur }
  }
  si ($r == "") { $r = "." }
  retour $r
}

fn ls_cherche($p: chaine, $noms: liste<chaine>) -> entier {
  $i = 1
  $nn = longueur($noms)
  tant_que ($i < $nn) {
    si ($noms[$i] == $p) { retour $i }
    $i = $i + 1
  }
  retour -1
}

fn ls_lire($chemin: chaine, $noms: liste<chaine>, $srcs: liste<chaine>) -> chaine {
  $i = ls_cherche(ls_norm($chemin), $noms)
  si ($i > 0) { retour $srcs[$i] }
  $i = ls_cherche($chemin, $noms)
  si ($i > 0) { retour $srcs[$i] }
  retour lire_texte($chemin)
}

# Renvoie "pos|fin|nom" du PROCHAIN importer (hors commentaires et chaînes),
# ou "-1|-1|" s'il n'y en a plus. $fin = index de la closing quote.
fn ls_import_suivant($src: chaine, $debut: entier) -> chaine {
  $n = longueur($src)
  $j = $debut
  $egc = faux
  $ecl = faux
  tant_que ($j < $n) {
    $c = ordre($src[$j])
    si ($ecl) {
      si ($c == 10) { $ecl = faux }
    } sinon si ($egc) {
      si ($c == 92) { $j = $j + 1 }
      sinon si ($c == 34) { $egc = faux }
    } sinon {
      si ($c == 35) { $ecl = vrai }
      sinon si ($c == 34) { $egc = vrai }
      sinon si (sous_chaine($src, $j, $j + 8) == "importer") {
        $av = " "
        si ($j > 0) { $av = $src[$j - 1] }
        $ap = " "
        si ($j + 8 < $n) { $ap = $src[$j + 8] }
        si ((non est_suite(ordre($av))) et (non est_suite(ordre($ap)))) {
          $q = $j + 8
          tant_que ($q < $n et (ordre($src[$q]) == 32 ou ordre($src[$q]) == 9 ou ordre($src[$q]) == 10 ou ordre($src[$q]) == 13)) { $q = $q + 1 }
          si ($q < $n et ordre($src[$q]) == 34) {
            $fin = $q + 1
            tant_que ($fin < $n et ordre($src[$fin]) != 34) { $fin = $fin + 1 }
            si ($fin < $n) {
              retour chaine($j) + "|" + chaine($fin) + "|" + sous_chaine($src, $q + 1, $fin)
            }
          }
        }
      }
    }
    $j = $j + 1
  }
  retour "-1|-1|"
}

fn ls_champ($r: chaine, $k: entier) -> chaine {
  $n = longueur($r)
  $p = 0
  $part = 0
  $debut = 0
  tant_que ($p < $n et $part < $k) {
    si (ordre($r[$p]) == 124) {
      $part = $part + 1
      $debut = $p + 1
    }
    $p = $p + 1
  }
  $fin = $debut
  tant_que ($fin < $n et ordre($r[$fin]) != 124) { $fin = $fin + 1 }
  retour sous_chaine($r, $debut, $fin)
}

# Charge un fichier et fusionne ses imports. $visites = chemins déjà chargés.
fn ls_charger($chemin: chaine, $inclu: chaine, $noms: liste<chaine>,
              $srcs: liste<chaine>, $visites: liste<chaine>, $prof: entier,
              $err: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "" }
  si ($prof > 32) {
    joindre($err, "Rose : erreur — importer : profondeur maximale dépassée")
    retour ""
  }
  $cn = ls_norm($chemin)
  si (ls_cherche($cn, $visites) > 0) { retour "" }
  joindre($visites, $cn)
  # Avec registre, la racine doit y être : diagnostic exact si absente.
  si ($prof == 0 et longueur($noms) > 1 et ls_cherche($cn, $noms) < 0) {
    joindre($err, "Rose : erreur — importer : impossible de lire '" + $chemin + "' (No such file or directory (os error 2))")
    retour ""
  }
  $src = ls_lire($chemin, $noms, $srcs)
  $ii = 0
  tant_que ($ii < 32 et longueur($err) == 1) {
    $r = ls_import_suivant($src, 0)
    $pos = entier(ls_champ($r, 0))
    si ($pos < 0) { $ii = 32 }
    sinon {
      $fin = entier(ls_champ($r, 1))
      $nom = ls_champ($r, 2)
      $cand = $nom
      $registre = longueur($noms)
      si (ls_cherche(ls_norm($nom), $noms) > 0) {
        $cand = $nom
      } sinon si (ls_cherche(ls_norm(ls_jointure(ls_dossier($chemin), $nom)), $noms) > 0) {
        $cand = ls_jointure(ls_dossier($chemin), $nom)
      } sinon si (non ls_est_absolu($nom)) {
        $cand = ls_jointure(ls_dossier($chemin), $nom)
      }
      # Un registre non vide est l'autorité : un chemin absent = fichier introuvable.
      si ($registre > 1 et ls_cherche(ls_norm($cand), $noms) < 0) {
        joindre($err, "Rose : erreur — importer : fichier introuvable '" + $nom + "' (depuis '" + $chemin + "')")
        retour ""
      }
      $enfant = ls_charger($cand, $chemin, $noms, $srcs, $visites, $prof + 1, $err)
      si (longueur($err) > 1) { retour "" }
      $blanc = ""
      $z = $pos
      tant_que ($z <= $fin + 1) { $blanc = $blanc + " "; $z = $z + 1 }
      $src = sous_chaine($src, 0, $pos) + $blanc + sous_chaine($src, $fin + 1, longueur($src))
      $src = $src + "\n" + $enfant + "\n"
      $ii = $ii + 1
    }
  }
  retour $src
}

fn rnat_flat($s: chaine) -> chaine {
  retour sous_chaine($s, 0, longueur($s))
}

# Joint équilibré : chaque niveau recopie au plus la longueur totale, donc
# O(n*log n) octets alloués au lieu de O(n^2) pour `s = s + morceau`.
# (Le `+` du runtime G5 COPIE les deux chaînes — pas de rope, contrairement
# au moteur Rust — et les ancres ne sont pas libérées : chaque concaténation
# en bouche est un leak.)
fn rnat_join($p: liste<chaine>, $d: entier, $f: entier) -> chaine {
  si ($f - $d <= 1) {
    si ($f - $d == 1) { retour $p[$d] }
    retour ""
  }
  $m = ($d + $f) div 2
  retour rnat_join($p, $d, $m) + rnat_join($p, $m, $f)
}

# emetteur.rose — jalon M4.3 : l'émetteur RIR auto-hébergé ROSE.
#
# Lit le programme passé en argument et rejoue TOUTE la chaîne du moteur :
# lexage, analyse descendante (AST en pools de nœuds plats), repli de
# constantes (les flottants repliés portent le texte exact que le moteur
# écrit dans le RIR), vérification de types — enrichie de deux notes :
# le type vérifié de chaque nœud et le type de lecture de chaque « lire » —
# puis ÉMISSION : le dump RIR octet pour octet de l'oracle `rose rir`.
# Rejet : le message exact, comme verifieur.rose. Validation :
# rose-cpp/tests/emetteur.py — les 103 fichiers de verifieur.py plus
# l'émetteur lui-même, par les trois voies.
#
# DISCIPLINES (M4.0/M4.1) : pas de courts-circuits (tout index dangereux est
# abrité) ; aucune globale visible des fonctions (tout voyage en paramètre) ;
# listes rembourrées à l'index 0 (le vérificateur refuse []) ; on ne peut que
# joindre — les pools sont construits en post-ordre, un indice de nœud n'est
# jamais réécrit. Erreurs : liste partagée $err — la première gagne, les
# appels suivants passent à vide (garde d'entrée partout).
#
# Pools de nœuds : listes parallèles, le nœud i est à la position i+1.
# Champs : genre (lit/ch/bol/v/lst/idx/uni/fac/app/bin), texte brut, drapeau
# flottant, indices gauche/droite, arguments (pool $al, départ $as, nombre
# $ac), ligne. Instructions : aff/lire/affi/si/tq/pour/retour/expr/bloc, nom,
# deux expressions, deux corps (indices séparés par des virgules), ligne.
# Types encodés « base|élément ».

# ══════════════════ lexage — utilitaires miroir ══════════════════

fn est_chiffre(c: entier) -> booleen {
  retour c >= 48 et c <= 57
}

fn est_lettre(c: entier) -> booleen {
  si (c < 128) {
    retour (c >= 65 et c <= 90) ou (c >= 97 et c <= 122) ou c == 95
  }
  retour (c >= 192 et c <= 214) ou (c >= 216 et c <= 246) ou (c >= 248 et c <= 767) ou (c >= 880 et c <= 1279) ou (c >= 7680 et c <= 8191)
}

fn est_suite(c: entier) -> booleen {
  si (c < 128) {
    retour est_lettre(c) ou est_chiffre(c)
  }
  retour est_lettre(c)
}

fn paire(a: entier, b: entier) -> chaine {
  si (a == 60 et b == 61) { retour "<=" }
  si (a == 62 et b == 61) { retour ">=" }
  si (a == 61 et b == 61) { retour "==" }
  si (a == 33 et b == 61) { retour "!=" }
  si (a == 47 et b == 61) { retour "!=" }
  si (a == 63 et b == 61) { retour "≈" }
  si (a == 61 et b == 126) { retour "≈" }
  si (a == 126 et b == 61) { retour "≈" }
  retour ""
}

fn uni(c: entier) -> chaine {
  si (c == 8776) { retour "≈" }
  si (c == 8804) { retour "<=" }
  si (c == 8805) { retour ">=" }
  si (c == 8800) { retour "!=" }
  si (c == 215) { retour "*" }
  si (c == 8901) { retour "*" }
  si (c == 183) { retour "*" }
  si (c == 247) { retour "div" }
  si (c == 8592) { retour "=" }
  si (c == 8594) { retour "->" }
  si (c == 8730) { retour "racine" }
  retour ""
}

fn car(c: entier) -> chaine {
  si (c == 43) { retour "+" }
  si (c == 45) { retour "-" }
  si (c == 42) { retour "*" }
  si (c == 47) { retour "/" }
  si (c == 58) { retour ":" }
  si (c == 37) { retour "%" }
  si (c == 94) { retour "^" }
  si (c == 33) { retour "!" }
  si (c == 46) { retour "." }
  si (c == 44) { retour "," }
  si (c == 63) { retour "?" }
  si (c == 40) { retour "(" }
  si (c == 41) { retour ")" }
  si (c == 123) { retour "{" }
  si (c == 125) { retour "}" }
  si (c == 91) { retour "[" }
  si (c == 93) { retour "]" }
  si (c == 59) { retour ";" }
  si (c == 60) { retour "<" }
  si (c == 62) { retour ">" }
  si (c == 126) { retour "~" }
  si (c == 64) { retour "@" }
  retour ""
}

# ——— lectureurs de la table de jetons (claqués sur l'eof) ———

fn T0($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn VX0($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn T1($g: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($g)
  $q = $p + 1
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $g[$q]
}

fn VX1($x: liste<chaine>, $p: entier) -> chaine {
  $n = longueur($x)
  $q = $p + 1
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $x[$q]
}

fn GL0($gl: liste<entier>, $p: entier) -> entier {
  $n = longueur($gl)
  $q = $p
  si ($q < 0) { $q = 0 }
  si ($q >= $n) { $q = $n - 1 }
  retour $gl[$q]
}

fn EMOT($g: liste<chaine>, $x: liste<chaine>, $p: entier, $m: chaine) -> booleen {
  $t = T0($g, $p)
  retour ($t == "ident" ou $t == "mot") et VX0($x, $p) == $m
}

# ——— décodage du couple « position|nœud » (les nœuds sont des entiers ici) ———

fn SEPR($r: chaine) -> entier {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour entier(sous_chaine($r, 0, $q))
}

fn NOD($r: chaine) -> chaine {
  $n = longueur($r)
  $q = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($q >= $n) { $ok = 0 }
    sinon si (ordre($r[$q]) == 124) { $ok = 0 }
    sinon { $q = $q + 1 }
  }
  retour sous_chaine($r, $q + 1, $n)
}

# ══════════════════ types « base|élément » ══════════════════

fn nomty($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  $base = sous_chaine($v, 0, $k)
  $elt = sous_chaine($v, $k + 1, $n)
  si ($base != "liste") { retour $base }
  si ($elt == "liste") { retour "liste<liste<vide>>" }
  retour "liste<" + $elt + ">"
}

fn BASE($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  tant_que ($k < $n) {
    si (ordre($v[$k]) == 124) { retour sous_chaine($v, 0, $k) }
    $k = $k + 1
  }
  retour $v
}

fn tyb($b: chaine) -> chaine {
  retour $b + "|vide"
}

fn estnum($t: chaine) -> booleen {
  $b = BASE($t)
  retour $b == "entier" ou $b == "rationnel" ou $b == "flottant" ou $b == "complexe"
}

fn contient_barre($v: chaine) -> booleen {
  $n = longueur($v)
  $k = 0
  $trouve = 0
  tant_que ($k < $n) {
    si (ordre($v[$k]) == 47) { $trouve = 1 }
    $k = $k + 1
  }
  retour $trouve == 1
}

fn rangd($b: chaine) -> entier {
  si ($b == "booleen") { retour 0 }
  si ($b == "entier") { retour 1 }
  si ($b == "rationnel") { retour 2 }
  si ($b == "flottant") { retour 3 }
  retour -1
}

fn promote($u1: chaine, $u2: chaine) -> chaine {
  si (BASE($u1) == "complexe" ou BASE($u2) == "complexe") { retour "complexe|vide" }
  $r1 = rangd(BASE($u1))
  $r2 = rangd(BASE($u2))
  $r = $r1
  si ($r2 > $r) { $r = $r2 }
  si ($r <= 1) { retour "entier|vide" }
  si ($r == 2) { retour "rationnel|vide" }
  retour "flottant|vide"
}

# ══════════════════ morceaux de chaînes (, et ;) ══════════════════

fn piece($s: chaine, $sep: entier, $k: entier) -> chaine {
  $n = longueur($s)
  $j = 0
  $no = 1
  $debut = 0
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) {
      si ($no == $k) { retour sous_chaine($s, $debut, $j) }
      $no = $no + 1
      $debut = $j + 1
    }
    $j = $j + 1
  }
  si ($no == $k) { retour sous_chaine($s, $debut, $n) }
  retour ""
}

fn nb_pieces($s: chaine, $sep: entier) -> entier {
  si ($s == "") { retour 0 }
  $n = longueur($s)
  $j = 0
  $c = 0
  tant_que ($j < $n) {
    si (ordre($s[$j]) == $sep) { $c = $c + 1 }
    $j = $j + 1
  }
  retour $c + 1
}

# ══════════════════ arithmétique rationnelle exacte (repli) ══════════════════
# L'entier Rose est à précision arbitraire (GMP côté moteur) : le repli est
# EXACT sans bignum dédié — fraction « p » ou « p/q », dénominateur > 0,
# réduite, zéro sous la forme « 0 » — canonicalisation mpq miroir.

fn vabs($x: entier) -> entier {
  si ($x < 0) { retour 0 - $x }
  retour $x
}

fn pgcd2($a: entier, $b: entier) -> entier {
  $x = vabs($a)
  $y = vabs($b)
  tant_que ($y > 0) {
    $r = $x % $y
    $x = $y
    $y = $r
  }
  retour $x
}

fn rpui($b: entier, $e: entier) -> entier {
  $res = 1
  $f = $b
  $k = $e
  tant_que ($k > 0) {
    si ($k % 2 == 1) { $res = $res * $f }
    $f = $f * $f
    $k = $k div 2
  }
  retour $res
}

fn rnum($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour entier(sous_chaine($t, 0, $k))
}

fn rden($t: chaine) -> entier {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour 1 }
  retour entier(sous_chaine($t, $k + 1, $n))
}

# zéro rationnel : tous les chiffres du numérateur sont des « 0 »
fn rnul($t: chaine) -> booleen {
  $n = longueur($t)
  $k = 0
  $ok = 1
  $rien = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 47) { $ok = 0 }
    sinon si (ordre($t[$k]) != 48) { $ok = 0; $rien = 0 }
    sinon { $k = $k + 1 }
  }
  retour $rien == 1
}

fn rnorm($p: entier, $q: entier) -> chaine {
  $np = $p
  $nq = $q
  si ($nq < 0) { $np = 0 - $np; $nq = 0 - $nq }
  si ($np == 0) { retour "0" }
  $g = pgcd2($np, $nq)
  si ($g > 1) { $np = $np div $g; $nq = $nq div $g }
  si ($nq == 1) { retour chaine($np) }
  retour chaine($np) + "/" + chaine($nq)
}

# ══════════════════ erreurs et environnements ══════════════════
# $err : liste partagée, la première erreur gagne ; toute fonction gardée
# rend la main à vide dès qu'elle est pleine (miroir de l'exception C++).

fn signaler($lg: entier, $msg: chaine, $err: liste<chaine>) {
  si (longueur($err) == 1) {
    $s = "Rose : erreur — "
    si ($lg > 0) { $s = $s + "[Ligne " + chaine($lg) + ", Colonne 0] " }
    joindre($err, $s + $msg)
  }
}

fn reserver($nom: chaine, $lg: entier, $err: liste<chaine>) {
  $n = longueur($nom)
  si ($n > 1 et ordre($nom[0]) == 116) {
    $chiffres = 1
    $k = 1
    tant_que ($k < $n) {
      si ($chiffres == 1) {
        $c = ordre($nom[$k])
        si ($c < 48 ou $c > 57) { $chiffres = 0 }
      }
      $k = $k + 1
    }
    si ($chiffres == 1) { signaler($lg, "Le nom '" + $nom + "' est réservé par le moteur", $err) }
  }
}

fn env_get($nom: chaine, $vn: liste<chaine>, $vt: liste<chaine>) -> chaine {
  $j = longueur($vn) - 1
  tant_que ($j >= 1) {
    si ($vn[$j] == $nom) { retour $vt[$j] }
    $j = $j - 1
  }
  retour ""
}

fn env_put($nom: chaine, $ty: chaine, $vn: liste<chaine>, $vt: liste<chaine>) {
  joindre($vn, $nom)
  joindre($vt, $ty)
}

# ══════════════════ appendeurs de pools ══════════════════
# Post-ordre strict : le nœud est ajouté quand ses enfants existent déjà ;
# indice = longueur - 1 après l'ajout (listes rembourrées).

fn noeud8($k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $kd: chaine, $t: chaine, $f: chaine,
          $ga: entier, $gb: entier, $sa: entier, $ca: entier, $l: entier) -> entier {
  joindre($k, $kd)
  joindre($tx, $t)
  joindre($tf, $f)
  joindre($a, $ga)
  joindre($b, $gb)
  joindre($as, $sa)
  joindre($ac, $ca)
  joindre($lg, $l)
  retour longueur($k) - 1
}

fn inoeud7($ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
           $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
           $kd: chaine, $no: chaine, $e1: entier, $e2: entier,
           $b1: chaine, $b2: chaine, $l: entier) -> entier {
  joindre($ik, $kd)
  joindre($ino, $no)
  joindre($ie, $e1)
  joindre($ie2, $e2)
  joindre($ib1, $b1)
  joindre($ib2, $b2)
  joindre($ilg, $l)
  retour longueur($ik) - 1
}

# module::nom est stocké « module;nom » (les identifiants ne portent jamais « ; »)
fn eclate_mod($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour "" }
  retour sous_chaine($t, 0, $k)
}

fn eclate_nom($t: chaine) -> chaine {
  $n = longueur($t)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($t[$k]) == 59) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  si ($k >= $n) { retour $t }
  retour sous_chaine($t, $k + 1, $n)
}

# ══════════════════ types et noms (parseur) ══════════════════

fn nomid($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  retour chaine($p + 1) + "|" + VX0($x, $p)
}

# type annoté : « pos|base|élément » — Ty::liste ne garde que la base de
# l'élément (miroir de la plie M4.1)
fn typex($g: liste<chaine>, $x: liste<chaine>, $p: entier) -> chaine {
  $r = nomid($g, $x, $p)
  $q = SEPR($r)
  $t = NOD($r)
  si ($t == "liste") {
    si (T0($g, $q) == "<") { $q = $q + 1 }
    $d = typex($g, $x, $q)
    $q = SEPR($d)
    $iv = NOD($d)
    si (T0($g, $q) == ">") { $q = $q + 1 }
    $m = longueur($iv)
    $k = 0
    $trouve = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($k >= $m) { $ok = 0 }
      sinon si (ordre($iv[$k]) == 124) { $ok = 0; $trouve = 1 }
      sinon { $k = $k + 1 }
    }
    $base_int = $iv
    si ($trouve == 1) { $base_int = sous_chaine($iv, 0, $k) }
    retour chaine($q) + "|liste|" + $base_int
  }
  retour chaine($q) + "|" + $t + "|vide"
}

# ══════════════════ expressions — descente vers les pools ══════════════════
# Toute fonction rend « pos|indice » ; l'indice est décimal (jamais de « | »).

# `i` est l'imaginaire SAUF s'il sert de compteur de boucle (`pour i de …`) :
# le moteur le lexalise alors comme variable entière. On le détecte sur le
# flux de jetons complet (aucun fichier du corpus ne mélange les deux usages).
fn i_est_compteur($g: liste<chaine>, $x: liste<chaine>) -> booleen {
  $n = longueur($g)
  $j = 1
  tant_que ($j + 1 < $n) {
    si (VX0($x, $j) == "pour" et VX0($x, $j + 1) == "i") { retour vrai }
    $j = $j + 1
  }
  retour faux
}

fn atom($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "nombre") {
    # suffixe imaginaire « 4i » -> (c 0 4)  [miroir de analyseur.rose]
    si (T1($g, $p) == "mot" et VX1($x, $p) == "i") {
      $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "c", "0 " + VX0($x, $p), "", -1, -1, 0, 0, $l)
      retour chaine($p + 2) + "|" + chaine($i)
    }
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "flottant") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", VX0($x, $p), "1", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "chaine") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "ch", VX0($x, $p), "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si ($t == "[") {
    # arguments d'abord dans un tampon local (frais par cadre recursive),
    # vidange contiguë vers le pool $al a la fermeture du nœud
    $col = [-1]
    $nc = 0
    $q = $p + 1
    si (T1($g, $p) != "]") {
      $ok = 1
      tant_que ($ok == 1) {
        $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        joindre($col, entier(NOD($r)))
        $nc = $nc + 1
        $q = SEPR($r)
        si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $ok = 0 }
      }
    }
    # [0 : type] : liste vide typée (M2.4)
    si ($nc == 1 et $col[1] >= 0 et $k[$col[1]] == "lit" et $tx[$col[1]] == "0" et T0($g, $q) == ":") {
      # [0 : entier] est une LISTE VIDE TYPÉE (Expr::ListeVideTypee cote Rust),
      # pas une liste à un élément : le dump ecrit « (lstvide entier) ».
      $ty0 = VX0($x, $q + 1)
      $q = $q + 1
      $q = $q + 1
      si (T0($g, $q) == "]") { $q = $q + 1 }
      $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lstvide", $ty0, "", -1, -1, 0, 0, $l)
      retour chaine($q) + "|" + chaine($i)
    }
    si (T0($g, $q) == "]") { $q = $q + 1 }
    $sa = longueur($al)
    $u = 1
    tant_que ($u <= $nc) {
      joindre($al, $col[$u])
      $u = $u + 1
    }
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lst", "", "", -1, -1, $sa, $nc, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "(") {
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    retour chaine($q) + "|" + NOD($r)
  }
  si (VX0($x, $p) == "vrai") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "1", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (VX0($x, $p) == "faux") {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bol", "0", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  # `i` minuscule = unité imaginaire (c 0 1), miroir de analyseur.rose
  si ($t == "mot" et VX0($x, $p) == "i" et non i_est_compteur($g, $x)) {
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "c", "0 1", "", -1, -1, 0, 0, $l)
    retour chaine($p + 1) + "|" + chaine($i)
  }
  si (T1($g, $p) == "::") {
    $mod = VX0($x, $p)
    $nom = VX1($x, $p + 1)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, longueur($al), 0, $l)
    retour chaine($p + 3) + "|" + chaine($i)
  }
  $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "v", VX0($x, $p), "", -1, -1, 0, 0, $l)
  retour chaine($p + 1) + "|" + chaine($i)
}

fn can_nud($k: liste<chaine>, $ac: liste<entier>, $e: entier) -> booleen {
  $kk = $k[$e]
  si ($kk == "v") { retour vrai }
  retour $kk == "app" et $ac[$e] == 0
}

fn post($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = atom($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "(" et can_nud($k, $ac, $e)) {
      $lp = GL0($gl, $q)
      $tx0 = $tx[$e]
      $mod = eclate_mod($tx0)
      $nom = eclate_nom($tx0)
      $q = $q + 1
      $col = [-1]
      $nc = 0
      si (T0($g, $q) != ")") {
        $v2 = 1
        tant_que ($v2 == 1) {
          $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          joindre($col, entier(NOD($rr)))
          $nc = $nc + 1
          $q = SEPR($rr)
          si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $v2 = 0 }
        }
      }
      si (T0($g, $q) == ")") { $q = $q + 1 }
      $sa = longueur($al)
      $u = 1
      tant_que ($u <= $nc) {
        joindre($al, $col[$u])
        $u = $u + 1
      }
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", $mod + ";" + $nom, "", -1, -1, $sa, $nc, $lp)
    }
    sinon si ($t == "[") {
      $lb = GL0($gl, $q)
      $q = $q + 1
      si (T0($g, $q) == ":") {
        # s[:b] et s[:] — sucre miroir : sous_chaine(s, 0, b)
        $q = $q + 1
        $fin = -1
        si (T0($g, $q) == "]") {
          joindre($al, $e)
          $fin = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
        }
        sinon {
          $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
          $fin = entier(NOD($rr))
          $q = SEPR($rr)
        }
        joindre($al, $e)
        $z = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0", "", -1, -1, 0, 0, $lb)
        joindre($al, $z)
        joindre($al, $fin)
        $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
        si (T0($g, $q) == "]") { $q = $q + 1 }
      }
      sinon {
        $rr = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
        $ix = entier(NOD($rr))
        $q = SEPR($rr)
        si (T0($g, $q) == ":") {
          # s[a:b] et s[a:] — sucre miroir
          $q = $q + 1
          $fin = -1
          si (T0($g, $q) == "]") {
            joindre($al, $e)
            $fin = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";longueur", "", -1, -1, longueur($al) - 1, 1, $lb)
          }
          sinon {
            $r3 = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
            $fin = entier(NOD($r3))
            $q = SEPR($r3)
          }
          joindre($al, $e)
          joindre($al, $ix)
          joindre($al, $fin)
          $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "app", ";sous_chaine", "", -1, -1, longueur($al) - 3, 3, $lb)
          si (T0($g, $q) == "]") { $q = $q + 1 }
        }
        sinon {
          $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "idx", "", "", $e, $ix, 0, 0, $lb)
          si (T0($g, $q) == "]") { $q = $q + 1 }
        }
      }
    }
    sinon { $ok = 0 }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn unai($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "racine") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    $d = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "lit", "0.5", "1", -1, -1, 0, 0, $l)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", entier(NOD($r)), $d, 0, 0, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "-") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "-", "", entier(NOD($r)), -1, 0, 0, $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "+") {
    retour unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  }
  si ($t == "sfact") {
    $r = unai($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $lf = GL0($gl, $p)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "sfact", "", "", entier(NOD($r)), -1, 0, 0, $lf)
    retour chaine(SEPR($r)) + "|" + chaine($e)
  }
  $r = post($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $tt = T0($g, $q)
    si ($tt == "multifacto" ou $tt == "diese" ou $tt == "terminal" ou $tt == "superfacto" ou $tt == "!") {
      $lf = GL0($gl, $q)
      $kdn = "fac"
      $ktx = ""
      si ($tt == "multifacto") {
        $nbang = longueur(VX0($x, $q))
        si ($nbang >= 2) { $kdn = "mfact"; $ktx = chaine($nbang) }
      }
      si ($tt == "diese") { $kdn = "prim" }
      sinon si ($tt == "terminal") { $kdn = "term" }
      sinon si ($tt == "superfacto") { $kdn = "super" }
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, $kdn, $ktx, "", $e, -1, 0, 0, $lf)
      $q = $q + 1
    } sinon { $ok = 0 }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn puis($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = unai($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  si (T0($g, $q) == "^") {
    $lo = GL0($gl, $q)
    $d = puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "^", "", $e, entier(NOD($d)), 0, 0, $lo)
    retour chaine(SEPR($d)) + "|" + chaine($i)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn prod($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = puis($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "*" ou $t == "/" ou $t == "%" ou $t == "div") { $op = $t }
    si ($t == "ident" et VX0($x, $q) == "div") { $op = "div" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = puis($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn somme($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = prod($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "+") { $op = "+" }
    si ($t == "-") { $op = "-" }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = prod($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn compa($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = somme($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    $op = ""
    si ($t == "<" ou $t == "<=" ou $t == ">" ou $t == ">=" ou $t == "==" ou $t == "!=" ou $t == "≈" ou $t == "?=" ou $t == "=~") { $op = $t }
    si ($op == "") { $ok = 0 }
    sinon {
      $lo = GL0($gl, $q)
      $d = somme($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
      $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", $op, "", $e, entier(NOD($d)), 0, 0, $lo)
      $q = SEPR($d)
    }
  }
  retour chaine($q) + "|" + chaine($e)
}

fn nonx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>) -> chaine {
  si (EMOT($g, $x, $p, "non")) {
    retour nonx_helper($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  }
  retour compa($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
}

fn nonx_helper($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
       $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
       $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $l = GL0($gl, $p)
  $r = nonx($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $i = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "uni", "non", "", entier(NOD($r)), -1, 0, 0, $l)
  retour chaine(SEPR($r)) + "|" + chaine($i)
}

# « et »/« ou » : le nœud porte la ligne du PREMIER jeton de l'opérande
# droit (miroir exact de neo(voir().ligne) après consommation).

fn etx($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
       $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
       $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = nonx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  tant_que (EMOT($g, $x, $q, "et")) {
    $lo = GL0($gl, $q + 1)
    $d = nonx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "et", "", $e, entier(NOD($d)), 0, 0, $lo)
    $q = SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

fn expr1($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>) -> chaine {
  $r = etx($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $q = SEPR($r)
  $e = entier(NOD($r))
  tant_que (EMOT($g, $x, $q, "ou")) {
    $lo = GL0($gl, $q + 1)
    $d = etx($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $e = noeud8($k, $tx, $tf, $a, $b, $as, $ac, $lg, "bin", "ou", "", $e, entier(NOD($d)), 0, 0, $lo)
    $q = SEPR($d)
  }
  retour chaine($q) + "|" + chaine($e)
}

# ══════════════════ instructions — pool + corps en chaînes d'indices ══════════════════
# Un corps est la chaîne des indices de ses instructions de premier niveau,
# séparées par « , » ; les instructions imbriquées vivent dans le même pool,
# ajoutées AVANT leur parent (post-ordre), donc hors de la chaîne du parent.

fn instruction($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $t = T0($g, $p)
  $l = GL0($gl, $p)
  si ($t == "{") {
    $c = bloc($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "bloc", "", -1, -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == ">>") {
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "aff", "", entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si ($t == "<<") {
    $rn = nomid($g, $x, $p + 1)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "lire", NOD($rn), -1, -1, "", "", $l)
    retour chaine(SEPR($rn)) + "|" + chaine($i)
  }
  si ($t == "?") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "@") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = corps_chevron($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "si") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $q = SEPR($c)
    $corps1 = NOD($c)
    $corps2 = ""
    si (EMOT($g, $x, $q, "sinon")) {
      si (T0($g, $q + 1) == "{") {
        $d = bloc($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($d)
        $corps2 = NOD($d)
      }
      sinon {
        $d = instruction($g, $x, $gl, $q + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($d)
        $corps2 = NOD($d)
      }
    }
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "si", "", entier(NOD($r)), -1, $corps1, $corps2, $l)
    retour chaine($q) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "tant_que") {
    $q = $p + 1
    si (T0($g, $q) == "(") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($r)
    si (T0($g, $q) == ")") { $q = $q + 1 }
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "tq", "", entier(NOD($r)), -1, NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "pour") {
    $q = $p + 1
    $rn = nomid($g, $x, $q)
    $q = SEPR($rn)
    $nom = NOD($rn)
    si (EMOT($g, $x, $q, "de")) { $q = $q + 1 }
    $rd = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($rd)
    si (EMOT($g, $x, $q, "vers")) { $q = $q + 1 }
    $rf = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $q = SEPR($rf)
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "pour", $nom, entier(NOD($rd)), entier(NOD($rf)), NOD($c), "", $l)
    retour chaine(SEPR($c)) + "|" + chaine($i)
  }
  si ($t == "ident" et VX0($x, $p) == "retour") {
    $suiv = T1($g, $p)
    si ($suiv == ";" ou $suiv == "}" ou $suiv == "eof") {
      $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", -1, -1, "", "", $l)
      retour chaine($p + 1) + "|" + chaine($i)
    }
    $r = expr1($g, $x, $gl, $p + 1, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "retour", "", entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  si (($t == "ident" ou $t == "mot") et T1($g, $p) == "=") {
    $rn = nomid($g, $x, $p)
    $q = SEPR($rn)
    si (T0($g, $q) == "=") { $q = $q + 1 }
    $r = expr1($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
    $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "affi", NOD($rn), entier(NOD($r)), -1, "", "", $l)
    retour chaine(SEPR($r)) + "|" + chaine($i)
  }
  $r = expr1($g, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al)
  $i = inoeud7($ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, "expr", "", entier(NOD($r)), -1, "", "", $l)
  retour chaine(SEPR($r)) + "|" + chaine($i)
}

fn bloc($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
        $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
        $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
        $lg: liste<entier>, $al: liste<entier>,
        $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
        $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (T0($g, $q) == "{") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "}" ou $t == "eof") { $ok = 0 }
    sinon {
      si ($t == ";") { $q = $q + 1 }
      sinon {
        $r = instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                          $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
        $q = SEPR($r)
        si ($ch != "") { $ch = $ch + "," }
        $ch = $ch + NOD($r)
        si (T0($g, $q) == ";") { $q = $q + 1 }
      }
    }
  }
  si (T0($g, $q) == "}") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

fn corps_chevron($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>) -> chaine {
  $q = $p
  si (T0($g, $q) == "[") { $q = $q + 1 }
  $ch = ""
  $ok = 1
  tant_que ($ok == 1) {
    $t = T0($g, $q)
    si ($t == "]" ou $t == "eof") { $ok = 0 }
    sinon {
      $r = instruction($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
      $q = SEPR($r)
      si ($ch != "") { $ch = $ch + "," }
      $ch = $ch + NOD($r)
      si (T0($g, $q) == ";") { $q = $q + 1 } sinon { $ok = 0 }
    }
  }
  si (T0($g, $q) == "]") { $q = $q + 1 }
  retour chaine($q) + "|" + $ch
}

# ══════════════════ définition de fonction ══════════════════
# Pools parallèles : noms, externe (« 1 » ou vide), paramètres encodés
# « nom|base|elt;… », retour « base|elt », corps (chaîne d'indices), ligne du
# jeton « fn » (les erreurs de frontière la réclament).

fn def_fn($g: liste<chaine>, $x: liste<chaine>, $gl: liste<entier>, $p: entier,
          $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
          $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
          $lg: liste<entier>, $al: liste<entier>,
          $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
          $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
          $fnoms: liste<chaine>, $fext: liste<chaine>, $fparams: liste<chaine>,
          $fret: liste<chaine>, $fcorps: liste<chaine>, $fligne: liste<entier>) -> chaine {
  $lf = GL0($gl, $p)
  $q = $p + 1
  $rn = nomid($g, $x, $q)
  $q = SEPR($rn)
  $nom = NOD($rn)
  si (T0($g, $q) == "(") { $q = $q + 1 }
  $params = ""
  $un = 1
  tant_que ($un == 1) {
    si (T0($g, $q) == ")" ou T0($g, $q) == "eof") { $un = 0 }
    sinon {
      $rp = nomid($g, $x, $q)
      $q = SEPR($rp)
      $pn = NOD($rp)
      si (T0($g, $q) == ":") {
        $q = $q + 1
        $rt = typex($g, $x, $q)
        $q = SEPR($rt)
        $tp = NOD($rt)
      } sinon {
        # paramètre sans annotation : type dynamique, encodé « ?|vide »
        $tp = "?|vide"
      }
      si ($params != "") { $params = $params + ";" }
      $params = $params + $pn + "|" + $tp
      si (T0($g, $q) == ",") { $q = $q + 1 } sinon { $un = 0 }
    }
  }
  si (T0($g, $q) == ")") { $q = $q + 1 }
  $ret = "?|vide"
  si (T0($g, $q) == "->") {
    $rt = typex($g, $x, $q + 1)
    $ret = NOD($rt)
    $q = SEPR($rt)
  }
  $ext = "1"
  $corps = ""
  si (T0($g, $q) == "{") {
    $ext = ""
    $c = bloc($g, $x, $gl, $q, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $corps = NOD($c)
    $q = SEPR($c)
  }
  joindre($fnoms, $nom)
  joindre($fext, $ext)
  joindre($fparams, $params)
  joindre($fret, $ret)
  $corps = rnat_flat($corps)
  joindre($fcorps, $corps)
  joindre($fligne, $lf)
  retour chaine($q) + "|" + $nom
}

# ══════════════════ repli de constantes (passe 1) ══════════════════
# Miroir de replier_constants : fonctions triées (corps seulement), puis le
# niveau supérieur ; post-ordre strict (arguments, gauche, droite, nœud).
# La vue d'un nœud vaut « 1|texte|drapeau » si le nœud est (ou devient) un
# littéral après repli, « 0 » sinon. Les flottants repliés portent le texte
# exact de texte_flottant : la représentation la plus courte qui se relit à
# l'identique, « .0 » ajouté si elle n'a ni point ni exposant. flot_txt le
# reconstruit depuis chaine() — même repr, sauf entiers flottants où chaine
# tronque, et le signe du zéro se relit dans 1.0 / v.
# /0 flottant ne plie pas (miroir du nullptr) ; NaN/∞ non plus.
# Les entrées sont stockées par indice de nœud pour que la passe 2 voie
# l'arbre replié sans jamais modifier les pools.

fn entree($i: entier, $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) -> chaine {
  $n = longueur($foi)
  $j = 1
  tant_que ($j < $n) {
    si ($foi[$j] == $i) { retour "1|" + $fot[$j] + "|" + $fof[$j] }
    $j = $j + 1
  }
  retour "0"
}

fn stocker($i: entier, $t: chaine, $f: chaine,
           $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) {
  joindre($foi, $i)
  joindre($fot, $t)
  joindre($fof, $f)
}

fn vue_texte($v: chaine) -> chaine {
  $n = longueur($v)
  si ($n < 3) { retour "" }
  si (ordre($v[$n - 1]) == 124) { retour sous_chaine($v, 2, $n - 1) }
  retour sous_chaine($v, 2, $n - 2)
}

fn vue_flag($v: chaine) -> chaine {
  $n = longueur($v)
  si ($n < 3) { retour "" }
  si (ordre($v[$n - 1]) == 124) { retour "" }
  retour sous_chaine($v, $n - 1, $n)
}

fn replier_expr($i: entier,
                $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                $lg: liste<entier>, $al: liste<entier>,
                $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                $err: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "0" }
  $kd = $k[$i]
  $va = "0"
  $vb = "0"
  # replier() Rust : des qu'un flottant est present dans un binaire dont
  # l'operation n'est ni + - * / ni ^, il rend l'AST ORIGINAL et annule
  # les plis de ses enfants. On evite donc la recursion (qui stockerait des
  # vues encore utilisées par em_ast_expr).
  si ($kd == "bin") {
    $opx = $tx[$i]
    si (non ($opx == "+" ou $opx == "-" ou $opx == "*" ou $opx == "/" ou $opx == "^")) {
      $ga0 = $a[$i]
      $gb0 = $b[$i]
      $flga = faux
      $flgb = faux
      si ($ga0 >= 0 et $k[$ga0] == "lit" et $tf[$ga0] == "1") { $flga = vrai }
      si ($gb0 >= 0 et $k[$gb0] == "lit" et $tf[$gb0] == "1") { $flgb = vrai }
      si ($flga ou $flgb) { retour "0" }
    }
  }
  si ($kd == "lst" ou $kd == "app") {
    $sa = $as[$i]
    $n = $ac[$i]
    $j = 0
    tant_que ($j < $n) {
      replier_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
      $j = $j + 1
    }
  }
  sinon si ($kd == "idx" ou $kd == "bin") {
    $ga = $a[$i]
    $gb = $b[$i]
    si ($ga >= 0) { $va = replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($gb >= 0) { $vb = replier_expr($gb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd != "bin") { retour "0" }
  }
  sinon si ($kd == "uni" ou $kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super") {
    $ga = $a[$i]
    si ($ga >= 0) { $va = replier_expr($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err) }
    si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super") {
      si ($va != "0" et vue_flag($va) == "") {
        $t = vue_texte($va)
        si (non contient_barre($t)) {
          $n = entier($t)
          si ($n >= 0 et $n <= -1) {
            $acc = 1
            $j = 2
            tant_que ($j <= $n) { $acc = $acc * $j; $j = $j + 1 }
            $r = chaine($acc)
            stocker($i, $r, "", $foi, $fot, $fof)
            retour "1|" + $r + "|"
          }
        }
      }
      retour "0"
    }
  }
  sinon si ($kd == "lit") {
    retour "1|" + $tx[$i] + "|" + $tf[$i]
  }
  sinon { retour "0" }
  si (longueur($err) > 1) { retour "0" }
  $l = $lg[$i]
  # — unaire « - » sur littéral : miroir litt_depuis_q(-q) —
  si ($kd == "uni" et $va != "0") {
    si ($tx[$i] != "-") { retour "0" }
    si (vue_flag($va) == "1") {
      $fv = val_d($va)
      $zn = faux
      si ($fv == 0.0 et non texte_neg(vue_texte($va))) { $zn = vrai }
      $rs = flot_txt(-$fv, $zn)
      stocker($i, $rs, "1", $foi, $fot, $fof)
      retour "1|" + $rs + "|1"
    }
    $t = vue_texte($va)
    $nvt = ""
    si (rnul($t)) { $nvt = "0" }
    sinon si (ordre($t[0]) == 45) { $nvt = sous_chaine($t, 1, longueur($t)) }
    sinon { $nvt = "-" + $t }
    stocker($i, $nvt, "", $foi, $fot, $fof)
    retour "1|" + $nvt + "|"
  }
  # — produit de deux littéraux complexes : le moteur plie i*i en -1 —
  # (les nœuds « c » portent « re im » dans $tx ; non repliables eux-mêmes)
  si ($kd == "bin" et $tx[$i] == "*" et $a[$i] >= 0 et $b[$i] >= 0) {
    $ga = $a[$i]
    $gb = $b[$i]
    si ($k[$ga] == "c" et $k[$gb] == "c") {
      $r1 = entier(piece($tx[$ga], 32, 1))
      $i1 = entier(piece($tx[$ga], 32, 2))
      $r2 = entier(piece($tx[$gb], 32, 1))
      $i2 = entier(piece($tx[$gb], 32, 2))
      $nr = $r1 * $r2 - $i1 * $i2
      $ni = $r1 * $i2 + $i1 * $r2
      si ($ni == 0) {
        $r = chaine($nr)
        stocker($i, $r, "", $foi, $fot, $fof)
        retour "1|" + $r + "|"
      }
      retour "0"
    }
  }
  # — binaire sur deux littéraux : miroir fold_bin —
  si ($kd == "bin" et $va != "0" et $vb != "0") {
    $op = $tx[$i]
    si (vue_flag($va) == "1" ou vue_flag($vb) == "1") {
      si ($op == "+" ou $op == "-" ou $op == "*" ou $op == "/" ou $op == "^") {
        $fa = val_d($va)
        $fbv = val_d($vb)
        $plie = 1
        $rf = 0.0
        $zn = faux
        si ($op == "+") { $rf = $fa + $fbv }
        sinon si ($op == "-") { $rf = $fa - $fbv }
        sinon si ($op == "*") {
          $rf = $fa * $fbv
          si ($rf == 0.0 et texte_neg(vue_texte($va)) != texte_neg(vue_texte($vb))) { $zn = vrai }
        }
        sinon si ($op == "/") {
          si ($fbv == 0.0) { $plie = 0 }
          sinon { $rf = $fa / $fbv }
        }
        sinon { $rf = $fa ^ $fbv }
        si ($plie == 1) {
          $rs = flot_txt($rf, $zn)
          si (contient($rs, "inf") ou contient($rs, "nan")) { $plie = 0 }
          si ($plie == 1) {
            stocker($i, $rs, "1", $foi, $fot, $fof)
            retour "1|" + $rs + "|1"
          }
        }
        retour "0"
      }
      retour "0"
    }
    si ($op == "≈" ou $op == "?=" ou $op == "=~" ou $op == "==" ou $op == "!=" ou $op == "%") {
      retour "0"
    }
    $ta = vue_texte($va)
    $tb = vue_texte($vb)
    $p1 = rnum($ta)
    $q1 = rden($ta)
    $p2 = rnum($tb)
    $q2 = rden($tb)
    $r = ""
    $np = 0
    $nq = 1
    si ($op == "+") { $np = $p1 * $q2 + $p2 * $q1; $nq = $q1 * $q2 }
    sinon si ($op == "-") { $np = $p1 * $q2 - $p2 * $q1; $nq = $q1 * $q2 }
    sinon si ($op == "*") { $np = $p1 * $p2; $nq = $q1 * $q2 }
    sinon si ($op == "/") {
      si (rnul($tb)) { signaler($l, "Division par zéro dans une constante", $err); retour "0" }
      $np = $p1 * $q2; $nq = $q1 * $p2
    }
    sinon si ($op == "^") {
      si ($q2 != 1) { retour "0" }
      si ($p2 < 0 et rnul($ta)) { signaler($l, "0^négatif dans une constante", $err); retour "0" }
      si ($p2 < 0 ou $p2 > 64) { retour "0" }
      $num = 1
      $jj = 0
      tant_que ($jj < $p2) { $num = $num * $p1; $jj = $jj + 1 }
      $den = 1
      $jj = 0
      tant_que ($jj < $p2) { $den = $den * $q1; $jj = $jj + 1 }
      $np = $num; $nq = $den
    }
    sinon si ($op == "div") {
      si (rnul($tb)) { signaler($l, "division par zéro dans une constante", $err); retour "0" }
      $r = chaine($p1 * $q2 div ($q1 * $p2))
      stocker($i, $r, "", $foi, $fot, $fof)
      retour "1|" + $r + "|"
    }
    sinon { retour "0" }
    # ⚠ Un entier géant (2^63, 2^64, 40!...) ne doit JAMAIS traverser
    # pgcd2()/vabs() : le JIT perd son tag bignum à cette profondeur d'appel
    # (mesuré : « conversion vers entier impossible (type Vide) »). Quand le
    # dénominateur vaut 1 (cas de toutes les puissances entières), rnorm et
    # rden1 sont l'identité : on court-circuite, exactement comme GMP.
    $r = ""
    $fl = ""
    si ($nq == 1) {
      $r = chaine($np)
      si ($np == 0) { $r = "0" }
    } sinon {
      $r = rnorm($np, $nq)
      si (non rden1($np, $nq)) { $fl = "q" }
    }
    stocker($i, $r, $fl, $foi, $fot, $fof)
    retour "1|" + $r + "|" + $fl
  }
  retour "0"
}

fn replier_chaine($cs: chaine,
                  $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                  $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                  $lg: liste<entier>, $al: liste<entier>,
                  $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                  $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                  $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                  $err: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    replier_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

fn replier_instr($i: entier,
                 $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
                 $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
                 $lg: liste<entier>, $al: liste<entier>,
                 $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
                 $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
                 $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
                 $err: liste<chaine>) {
  si (longueur($err) > 1) { retour 0 }
  $kd = $ik[$i]
  si ($kd == "aff" ou $kd == "expr" ou $kd == "affi") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "retour") {
    $e = $ie[$i]
    si ($e >= 0) {
      replier_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    }
    retour 0
  }
  si ($kd == "si") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    $b2 = $ib2[$i]
    si ($b2 != "") {
      replier_chaine($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    }
    retour 0
  }
  si ($kd == "tq") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "pour") {
    replier_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $err)
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
    retour 0
  }
  si ($kd == "bloc") {
    replier_chaine($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
}

# ══════════════════ vérification de types (passe 2) ══════════════════
# Miroir du vérificateur C++ : expressions rendent le type « base|elt » ;
# deux paires d'environnements vivent en parallèle — l'environnement de
# l'instruction courante et le « locals » du membre (tout corps de si/
# tant_que/pour descend dans LOCALS, jamais dans l'environnement ambiant —
# bizarrerie fidèle du moteur, dualité globales/locals mesurée en v3.14).

fn ELTT($v: chaine) -> chaine {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour sous_chaine($v, $k + 1, $n)
}

fn t_from_texte($t: chaine, $f: chaine) -> chaine {
  si ($f == "1") { retour "flottant|vide" }
  si (contient_barre($t)) { retour "rationnel|vide" }
  retour "entier|vide"
}

fn ce_raw($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
              $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
              $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  si (longueur($err) > 1) { retour "vide|vide" }
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") { retour t_entree(vue_flag($vue)) }
  $kd = $k[$i]
  $lg0 = $lg[$i]
  si ($kd == "lit") { retour t_from_texte($tx[$i], $tf[$i]) }
  si ($kd == "ch") { retour "chaine|vide" }
  si ($kd == "c") { retour "complexe|vide" }
  si ($kd == "bol") { retour "booleen|vide" }
  si ($kd == "v") {
    $nom = $tx[$i]
    $t = env_get($nom, $vn, $vt)
    si ($t == "") { $t = env_get($nom, $gn, $gt) }
    # π / pi est une constante integrée du moteur (type chaine, voir la table
    # des builtins) : le vérificateur Rust la connaît et l'erreur porte alors
    # sur l'opération, pas sur la variable.
    si ($t == "" et ($nom == "π" ou $nom == "pi")) { $t = "chaine|vide" }
    si ($t == "") {
      signaler($lg0, "Variable '" + $nom + "' utilisée sans valeur", $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "lstvide") {
    retour "liste|" + $tx[$i]
  }
  si ($kd == "lst") {
    $n = $ac[$i]
    $sa = $as[$i]
    si ($n == 0) {
      signaler($lg0, "Liste vide : le type d'élément est introuvable", $err)
      retour "vide|vide"
    }
    $t_elt = check_expr($al[$sa], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $j = 1
    tant_que ($j < $n) {
      $tch = check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
      si ($tch != $t_elt) {
        si (estnum($tch) et estnum($t_elt)) { $t_elt = promote($tch, $t_elt) }
        sinon {
          signaler($lg0, "Liste hétérogène : " + nomty($t_elt) + " puis " + nomty($tch), $err)
          retour "vide|vide"
        }
      }
      $j = $j + 1
    }
    si (longueur($err) > 1) { retour "vide|vide" }
    si (BASE($t_elt) == "liste") {
      signaler($lg0, "Listes de listes non supportées pour l'instant", $err)
      retour "vide|vide"
    }
    retour "liste|" + BASE($t_elt)
  }
  si ($kd == "idx") {
    $tb = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $ti = check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $bb = BASE($tb)
    $bi = BASE($ti)
    si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "valeur" et $bb != "?") {
      signaler($lg0, "Index sur un " + nomty($tb) + ", une liste est attendue", $err)
      retour "vide|vide"
    }
    # front.rs:1989 — un base Dyn accepte tout index et rend un type dynamique.
    si ($bb == "?") { retour "?|vide" }
    si ($bb == "table" ou $bb == "valeur") {
      $cle_ok = 0
      si ($bi == "entier") { $cle_ok = 1 }
      sinon si ($bi == "rationnel") { $cle_ok = 1 }
      sinon si ($bi == "flottant") { $cle_ok = 1 }
      sinon si ($bi == "chaine") { $cle_ok = 1 }
      sinon si ($bi == "booleen") { $cle_ok = 1 }
      si ($bb == "table" et $cle_ok == 0) {
        signaler($lg0, "Index d'une table doit être un texte ou un nombre", $err)
        retour "vide|vide"
      }
      retour "valeur|vide"
    }
    si ($bi != "entier") {
      $msg = "Index d'une liste doit être entier"
      si ($bb == "chaine") { $msg = "Index d'une chaîne doit être entier" }
      signaler($lg0, $msg, $err)
      retour "vide|vide"
    }
    si ($bb == "chaine") { retour "chaine|vide" }
    retour ELTT($tb) + "|vide"
  }
  si ($kd == "uni") {
    $t = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si ($tx[$i] == "non") {
      si (BASE($t) != "booleen") {
        signaler($lg0, "La condition de non doit être booléenne, trouvé " + nomty($t), $err)
        retour "vide|vide"
      }
      retour "booleen|vide"
    }
    # front.rs:1917 — unaire (hors « non ») sur Dyn : laissé passer.
    si (BASE($t) == "?") { retour "?|vide" }
    si (non estnum($t)) {
      signaler($lg0, "Unaire " + $tx[$i] + " sur un " + nomty($t), $err)
      retour "vide|vide"
    }
    retour $t
  }
  si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super" ou $kd == "sfact" ou $kd == "mfact") {
    $t = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "entier") {
      signaler($lg0, "Factorielle attend un entier, trouvé " + nomty($t), $err)
      retour "vide|vide"
    }
    retour "entier|vide"
  }
  si ($kd == "bin") { retour check_bin($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                        $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                        $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt) }
  si ($kd == "app") { retour check_appel($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                                          $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret,
                                          $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt) }
  signaler($lg0, "Expression inconnue", $err)
  retour "vide|vide"
}

fn check_bin($i: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
             $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $op = $tx[$i]
  $lg0 = $lg[$i]
  $tg = check_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  $td = check_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  si (longueur($err) > 1) { retour "vide|vide" }
  si ($op == "et" ou $op == "ou") {
    si (BASE($tg) != "booleen") {
      signaler($lg0, "La condition de et/ou doit être booléenne, trouvé " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (BASE($td) != "booleen") {
      signaler($lg0, "La condition de et/ou doit être booléenne, trouvé " + nomty($td), $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "==" ou $op == "!=" ou $op == "≈" ou $op == "?=" ou $op == "=~") {
    si ($tg != $td et non(estnum($tg) et estnum($td))
        et BASE($tg) != "?" et BASE($td) != "?") {
      signaler($lg0, "Comparaison " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "<" ou $op == "<=" ou $op == ">" ou $op == ">=") {
    $okordre = 0
    si (estnum($tg) et estnum($td)) { $okordre = 1 }
    si (BASE($tg) == "chaine" et BASE($td) == "chaine") { $okordre = 1 }
    # front.rs:2035 — comparaison d'ordre avec un Dyn : résolue à l'exécution.
    si (BASE($tg) == "?" ou BASE($td) == "?") { $okordre = 1 }
    si ($okordre == 0) {
      signaler($lg0, "Ordre " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
      retour "vide|vide"
    }
    retour "booleen|vide"
  }
  si ($op == "+") {
    si (BASE($tg) == "chaine" et BASE($td) == "chaine") { retour "chaine|vide" }
    si (estnum($tg) et estnum($td)) { retour promote($tg, $td) }
    # front.rs:2044 — Dyn + X non numérique des deux côtés → Dyn.
    si (BASE($tg) == "?" ou BASE($td) == "?") { retour "?|vide" }
    # miroir de front.rs : `racine(n)` est typée irrationnel mais rend un
    # entier exact sur carré parfait ; l'addition est donc résolue à
    # l'exécution (les benches racines l'utilisent).
    si (BASE($tg) == "irrationnel" ou BASE($td) == "irrationnel") { retour "?|vide" }
    signaler($lg0, "Addition " + nomty($tg) + " + " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "-" ou $op == "*") {
    si (estnum($tg) et estnum($td)) { retour promote($tg, $td) }
    # front.rs:2058 — Dyn × X : type résolu à l'exécution.
    si (BASE($tg) == "?" ou BASE($td) == "?") { retour "?|vide" }
    signaler($lg0, "Opération " + nomty($tg) + " " + $op + " " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "/") {
    si (estnum($tg) et estnum($td)) {
      $r = promote($tg, $td)
      si (BASE($r) == "entier") { retour "rationnel|vide" }
      retour $r
    }
    # front.rs:2070 — division avec Dyn non résolu → Dyn.
    si (BASE($tg) == "?" ou BASE($td) == "?") { retour "?|vide" }
    signaler($lg0, "Division " + nomty($tg) + " / " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  si ($op == "%") {
    si (BASE($tg) == "entier" et BASE($td) == "entier") { retour "entier|vide" }
    signaler($lg0, "Le modulo exige deux entiers", $err)
    retour "vide|vide"
  }
  si ($op == "div") {
    si (non(estnum($tg) ou BASE($tg) == "booleen")) {
      signaler($lg0, "div attend un nombre à gauche, trouvé " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (non(estnum($td) ou BASE($td) == "booleen")) {
      signaler($lg0, "div attend un nombre à droite, trouvé " + nomty($td), $err)
      retour "vide|vide"
    }
    si (BASE($tg) == "flottant" ou BASE($td) == "flottant") { retour "flottant|vide" }
    retour "entier|vide"
  }
  si ($op == "^") {
    si (non estnum($tg)) {
      signaler($lg0, "Puissance sur une base " + nomty($tg), $err)
      retour "vide|vide"
    }
    si (BASE($td) == "flottant") { retour "flottant|vide" }
    $bd = BASE($td)
    si ($bd == "entier" ou $bd == "rationnel" ou $bd == "booleen") {
      $gb = $b[$i]
      $est_uni = 1
      si (entree($gb, $foi, $fot, $fof) != "0") { $est_uni = 0 }
      sinon si ($k[$gb] != "uni") { $est_uni = 0 }
      sinon si ($tx[$gb] != "-") { $est_uni = 0 }
      si ($est_uni == 1) {
        si (BASE($tg) == "entier") { retour "rationnel|vide" }
        retour $tg
      }
      si (BASE($tg) == "entier") { retour "entier|vide" }
      retour $tg
    }
    signaler($lg0, "Exposant " + nomty($td) + " impossible", $err)
    retour "vide|vide"
  }
  signaler($lg0, "Opérateur '" + $op + "' inconnu", $err)
  retour "vide|vide"
}

# — tables STDLIB et DYNAMIQUE (miroir exact des 45 + 4 entrées) —
# Format « retour|codes,virgules ». Codes inconnus du vérificateur C++
# (« n », « table ») acceptent tout : ils restent ici sans règle, fidèles.

fn std_sig($nom: chaine) -> chaine {
  si ($nom == "afficher") { retour "vide|n" }
  si ($nom == "saisir_entier") { retour "entier|" }
  si ($nom == "saisir_flottant") { retour "flottant|" }
  si ($nom == "factorielle") { retour "entier|entier" }
  si ($nom == "fibonacci") { retour "entier|entier" }
  si ($nom == "pgcd") { retour "entier|entier,entier" }
  si ($nom == "ppcm") { retour "entier|entier,entier" }
  si ($nom == "puissance") { retour "entier|num,entier" }
  si ($nom == "est_premier") { retour "booleen|entier" }
  si ($nom == "compter_premiers") { retour "entier|entier" }
  si ($nom == "nb_chiffres") { retour "entier|entier" }
  si ($nom == "nombre_pi") { retour "chaine|entier" }
  si ($nom == "longueur") { retour "entier|lct" }
  # front.rs:650-651 — alias `len` et primitive `type_de` (arg « tout » non vérifié).
  si ($nom == "len") { retour "entier|lct" }
  si ($nom == "type_de") { retour "chaine|tout" }
  si ($nom == "table") { retour "table|" }
  si ($nom == "inserer") { retour "vide|table,tout,tout" }
  si ($nom == "cle_existe") { retour "booleen|table,tout" }
  si ($nom == "supprimer") { retour "booleen|table,tout" }
  si ($nom == "cles") { retour "MIXTE|table" }
  si ($nom == "valeurs") { retour "MIXTE|table" }
  si ($nom == "joindre") { retour "vide|liste,liste_elt" }
  si ($nom == "ordre") { retour "entier|chaine" }
  si ($nom == "caractere") { retour "chaine|entier" }
  si ($nom == "sous_chaine") { retour "chaine|chaine,entier,entier" }
  si ($nom == "concatener") { retour "chaine|liste" }
  si ($nom == "ecrire_bytes") { retour "vide|chaine,chaine" }
  si ($nom == "ecrire_binaire") { retour "vide|chaine,liste" }
  si ($nom == "lire_texte") { retour "chaine|chaine" }
  si ($nom == "ecrire_texte") { retour "vide|chaine,chaine" }
  si ($nom == "nb_arguments") { retour "entier|" }
  si ($nom == "argument") { retour "chaine|entier" }
  si ($nom == "temps") { retour "entier|" }
  si ($nom == "duree") { retour "chaine|entier" }
  si ($nom == "afficher_erreur") { retour "vide|tout" }
  si ($nom == "quitter") { retour "vide|entier" }
  si ($nom == "abs") { retour "MIXTE|num" }
  si ($nom == "min") { retour "NUM_MAX|num,num" }
  si ($nom == "max") { retour "NUM_MAX|num,num" }
  si ($nom == "partie_entiere") { retour "entier|num" }
  si ($nom == "fraction") { retour "rationnel|entier,entier" }
  si ($nom == "graine") { retour "vide|entier" }
  si ($nom == "hasard") { retour "entier|entier" }
  si ($nom == "tampon") { retour "tampon|entier" }
  si ($nom == "octets") { retour "tampon|chaine" }
  si ($nom == "tampon_case") { retour "entier|tampon,entier" }
  si ($nom == "tampon_pose") { retour "vide|tampon,entier,entier" }
  si ($nom == "remplir_hasard") { retour "vide|tampon,tampon" }
  si ($nom == "remplir_hasard_philox") { retour "vide|tampon,tampon,entier" }
  si ($nom == "re" ou $nom == "im" ou $nom == "arg" ou $nom == "modulus") { retour "flottant|complexe" }
  si ($nom == "conj") { retour "complexe|complexe" }
  si ($nom == "millisecondes") { retour "entier|" }
  # front.rs:709-716 — `time`/`ms` et les 5 primitives GUI native.
  si ($nom == "time") { retour "chaine|" }
  si ($nom == "ms") { retour "entier|" }
  si ($nom == "fenetre_native") { retour "entier|chaine,entier,entier" }
  si ($nom == "fenetre_afficher") { retour "vide|entier" }
  si ($nom == "fenetre_attendre") { retour "vide|entier" }
  si ($nom == "fenetre_fermer") { retour "vide|entier" }
  si ($nom == "message_native") { retour "vide|chaine,chaine" }
  si ($nom == "fact") { retour "entier|entier" }
  si ($nom == "fib") { retour "entier|entier" }
  si ($nom == "gcd") { retour "entier|entier,entier" }
  si ($nom == "lcm") { retour "entier|entier,entier" }
  si ($nom == "pow") { retour "entier|num,entier" }
  si ($nom == "racine") { retour "irrationnel|entier" }
  si ($nom == "racine_decimales") { retour "chaine|entier,entier" }
  si ($nom == "is_prime") { retour "booleen|entier" }
  si ($nom == "digits") { retour "entier|entier" }
  si ($nom == "pi" ou $nom == "nombre_e" ou $nom == "e" ou $nom == "phi") { retour "chaine|entier" }
  si ($nom == "factorielle_rapide" ou $nom == "factorial_rapide" ou $nom == "rapide") { retour "entier|entier" }
  si ($nom == "approx" ou $nom == "factorial_approx") { retour "chaine|entier" }
  si ($nom == "primorielle") { retour "entier|entier" }
  si ($nom == "termial" ou $nom == "triangulaire" ou $nom == "termial_classique" ou $nom == "termial_kurepa" ou $nom == "kurepa" ou $nom == "terminal") { retour "entier|entier" }
  si ($nom == "super_factorielle") { retour "entier|entier" }
  si ($nom == "multifactorielle" ou $nom == "multifactoriel") { retour "entier|entier,entier" }
  si ($nom == "sous_factorielle" ou $nom == "derangement" ou $nom == "sous_factorial") { retour "entier|entier" }
  retour ""
}

fn dyn_sig($nom: chaine) -> chaine {
  si ($nom == "charger") { retour "entier|chaine" }
  si ($nom == "fermer") { retour "vide|entier" }
  si ($nom == "appeler0") { retour "flottant|entier,chaine" }
  si ($nom == "appeler1") { retour "flottant|entier,chaine,num" }
  si ($nom == "appeler2") { retour "flottant|entier,chaine,num,num" }
  retour ""
}

fn vargs($i: entier, $codes: chaine, $nom: chaine,
         $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
         $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
         $lg: liste<entier>, $al: liste<entier>,
         $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
         $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
         $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
         $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
         $tri: liste<entier>, $trt: liste<chaine>) {
  $nargs = $ac[$i]
  $np = nb_pieces($codes, 44)
  si ($nargs != $np) {
    signaler($lg[$i], $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($nargs), $err)
    retour 0
  }
  $sa = $as[$i]
  $t_elt = "vide|vide"
  $a_elt = 0
  $j = 0
  tant_que ($j < $nargs) {
    $ta = check_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $code = piece($codes, 44, $j + 1)
    si ($code == "chaine") {
      si (BASE($ta) != "chaine") { signaler($lg[$i], $nom + ": une chaine est attendue", $err) }
    }
    sinon si ($code == "num") {
      si (non estnum($ta)) {
        signaler($lg[$i], $nom + ": un nombre est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "entier") {
      si (BASE($ta) != "entier") {
        signaler($lg[$i], $nom + ": un entier est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "liste") {
      si (BASE($ta) != "liste") {
        signaler($lg[$i], $nom + ": une liste est attendue, reçu " + nomty($ta), $err)
      }
      $t_elt = tyb(ELTT($ta))
      $a_elt = 1
    }
    sinon si ($code == "tampon") {
      si (BASE($ta) != "tampon") {
        signaler($lg[$i], $nom + ": un tampon est attendu, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "lct") {
      $bb = BASE($ta)
      si ($bb != "liste" et $bb != "chaine" et $bb != "table" et $bb != "tampon") {
        signaler($lg[$i], $nom + ": une liste, une chaîne ou une table est attendue, reçu " + nomty($ta), $err)
      }
    }
    sinon si ($code == "liste_elt") {
      $tolere = 0
      si ($a_elt == 1 et BASE($t_elt) != "vide" et $ta != $t_elt) {
        si (estnum($ta) et estnum($t_elt) et promote($ta, $t_elt) == $t_elt) { $tolere = 1 }
        si ($tolere == 0) {
          signaler($lg[$i], $nom + ": élément " + nomty($ta) + " ne correspond pas à la liste " + nomty($t_elt), $err)
        }
      }
    }
    $j = $j + 1
  }
}

fn check_appel($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $lg0 = $lg[$i]
  $tx0 = $tx[$i]
  $mod = eclate_mod($tx0)
  $nom = eclate_nom($tx0)
  # — dynamique:: —
  si ($mod == "dynamique") {
    $spec = dyn_sig($nom)
    si ($spec == "") {
      signaler($lg0, "Fonction dynamique::" + $nom + " inconnue (disponibles: charger, fermer, appeler0, appeler1, appeler2)", $err)
      retour "vide|vide"
    }
    vargs($i, piece($spec, 124, 2), "dynamique::" + $nom,
          $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
          $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour tyb(piece($spec, 124, 1))
  }
  # — conversions d'un argument, avant les signatures —
  $cast = 0
  si ($nom == "entier") { $cast = 1 }
  sinon si ($nom == "rationnel") { $cast = 1 }
  sinon si ($nom == "flottant") { $cast = 1 }
  sinon si ($nom == "chaine") { $cast = 1 }
  si ($cast == 1 et $ac[$i] == 1) {
    $t = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si ($nom == "chaine") { retour "chaine|vide" }
    si (BASE($t) == "chaine") {
      si ($nom == "entier") { retour "entier|vide" }
      si ($nom == "flottant") { retour "flottant|vide" }
      signaler($lg0, "Conversion chaine → rationnel non disponible, passez par flottant", $err)
      retour "vide|vide"
    }
    si (non estnum($t)) {
      signaler($lg0, "Conversion " + nomty($t) + " → " + nomty(tyb($nom)) + " impossible", $err)
      retour "vide|vide"
    }
    retour tyb($nom)
  }
  # — fonctions de l'utilisateur (externes comprises) —
  $pos = 0
  $u = 1
  $nf = longueur($fnoms)
  tant_que ($u < $nf) {
    si ($pos == 0 et $fnoms[$u] == $nom) { $pos = $u }
    $u = $u + 1
  }
  si ($pos > 0) {
    $ps = $fparams[$pos]
    $np = nb_pieces($ps, 59)
    si ($ac[$i] != $np) {
      signaler($lg0, $nom + " attend " + chaine($np) + " argument(s), reçu " + chaine($ac[$i]), $err)
      retour "vide|vide"
    }
    $sa = $as[$i]
    $j = 1
    $ok = 1
    tant_que ($j <= $np) {
      si ($ok == 1) {
        $ta = check_expr($al[$sa + $j - 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                         $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
        $ent = piece($ps, 59, $j)
        $t_att = sous_chaine($ent, premier_pipe($ent) + 1, longueur($ent))
        $bad = 0
        si ($ta != $t_att) {
          # front.rs:2157 — un paramètre sans annotation (Dyn) accepte tout.
          si (BASE($t_att) != "?") {
            # est_numerique du moteur EXCLUT les complexes : aucune promotion
            # implicite numérique → complexe aux arguments de fonction.
            $numok = estnum($ta) et estnum($t_att) et BASE($ta) != "complexe" et BASE($t_att) != "complexe"
            si (non($numok et promote($ta, $t_att) == $t_att)) { $bad = 1 }
          }
        }
        si ($bad == 1) {
          signaler($lg0, "Argument de " + $nom + ": " + nomty($ta) + " reçu, " + nomty($t_att) + " attendu", $err)
          $ok = 0
        }
      }
      $j = $j + 1
    }
    retour $fret[$pos]
  }
  # — bibliothèque standard —
  $spec = std_sig($nom)
  si ($spec == "") {
    signaler($lg0, "Fonction '" + $nom + "' inconnue", $err)
    retour "vide|vide"
  }
  vargs($i, piece($spec, 124, 2), $nom,
        $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $vn, $vt, $gn, $gt,
        $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
  si (longueur($err) > 1) { retour "vide|vide" }
  $ret = piece($spec, 124, 1)
  si ($ret == "MIXTE") {
    $t = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "booleen") { retour "entier|vide" }
    retour $t
  }
  si ($ret == "NUM_MAX") {
    $ta1 = check_expr($al[$as[$i]], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $ta2 = check_expr($al[$as[$i] + 1], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour promote($ta1, $ta2)
  }
  retour tyb($ret)
}

fn premier_pipe($v: chaine) -> entier {
  $n = longueur($v)
  $k = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($k >= $n) { $ok = 0 }
    sinon si (ordre($v[$k]) == 124) { $ok = 0 }
    sinon { $k = $k + 1 }
  }
  retour $k
}

# ══════════════════ instructions vérifiées ══════════════════

fn check_instr($i: entier,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
               $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
               $ln: liste<chaine>, $lt: liste<chaine>,
               $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $ass: entier, $ra: chaine, $err: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) {
  si (longueur($err) > 1) { retour 0 }
  $kd = $ik[$i]
  $lg0 = $ilg[$i]
  si ($kd == "aff") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "vide") { signaler($lg0, "Rien à afficher ici", $err) }
    retour 0
  }
  si ($kd == "lire") {
    $nom = $ino[$i]
    $t = env_get($nom, $vn, $vt)
    si ($t == "") {
      reserver($nom, $lg0, $err)
      env_put($nom, "entier|vide", $vn, $vt)
      si (longueur($err) == 1) { joindre($tri, $i); joindre($trt, "1") }
    }
    sinon {
      $bb = BASE($t)
      si ($bb != "entier" et $bb != "flottant" et $bb != "rationnel") {
        signaler($lg0, "Ne peut pas lire dans une variable " + nomty($t) + " (entier/flottant attendus)", $err)
      }
      sinon {
        $nu = "1"
        si ($bb == "rationnel") { $nu = "2" }
        sinon si ($bb == "flottant") { $nu = "3" }
        joindre($tri, $i)
        joindre($trt, $nu)
      }
    }
    retour 0
  }
  si ($kd == "affi") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) == "vide") {
      signaler($lg0, "Impossible d'affecter une valeur sans type", $err)
      retour 0
    }
    $nom = $ino[$i]
    # Le moteur traite une globale comme un SHADOW dans un corps de fonction :
    # `$k = 0` local ne doit pas être confronté au type de la globale $k.
    $ex = env_get($nom, $vn, $vt)
    # i/pi/phi/e sont des globales du moteur : shadow, pas de contrôle de domaine
    si ($nom == "i" ou $nom == "pi" ou $nom == "phi" ou $nom == "e") { $ex = "" }
    $cible = $t
    si ($ex != "") {
      $cible = $ex
      $be = BASE($ex)
      $bt = BASE($t)
      $domaine_ok = 1
      # front.rs:1589 — Dyn de part ou d'autre : affectation laissée passer.
      si ($be == "valeur" ou $bt == "valeur" ou $be == "?" ou $bt == "?") { $domaine_ok = 1 }
      sinon si ($bt == "entier" et $be == "rationnel") { $domaine_ok = 1 }
      sinon si ($t != $ex) {
        $domaine_ok = 0
        si (promote($t, $ex) == $ex et estnum($t) et estnum($ex)) { $domaine_ok = 1 }
        si ($domaine_ok == 0) {
          signaler($lg0, "'" + $nom + "' est " + nomty($ex) + ", on ne peut pas y stocker du " + nomty($t), $err)
          retour 0
        }
      }
    }
    reserver($nom, $lg0, $err)
    env_put($nom, $cible, $vn, $vt)
    retour 0
  }
  si ($kd == "si") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "booleen") {
      signaler($lg0, "La condition de si doit être booléenne, trouvé " + nomty($t), $err)
      retour 0
    }
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    $b2 = $ib2[$i]
    si ($b2 != "" et longueur($err) == 1) {
      parcourir($b2, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    }
    retour 0
  }
  si ($kd == "tq") {
    $t = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                    $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($t) != "booleen") {
      signaler($lg0, "La condition de tant_que doit être booléenne, trouvé " + nomty($t), $err)
      retour 0
    }
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    retour 0
  }
  si ($kd == "pour") {
    $nom = $ino[$i]
    # le moteur suit les compteurs de boucle dans UN seul espace : un `pour i`
    # imbriqué dans un autre `pour` voit le compteur posé au niveau supérieur
    # (qui vit dans $gn/$gt quand le corps est parcouru avec $ln/$lt).
    si (env_get($nom, $vn, $vt) != "" ou env_get($nom, $gn, $gt) != "") {
      signaler($lg0, "La variable de boucle '" + $nom + "' existe déjà", $err)
      retour 0
    }
    $td = check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                     $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    $tfin = check_expr($ie2[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                       $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    si (BASE($td) != "entier" ou BASE($tfin) != "entier") {
      signaler($lg0, "pour…de…vers exige des bornes entières", $err)
      retour 0
    }
    reserver($nom, $lg0, $err)
    env_put($nom, "entier|vide", $vn, $vt)
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $ln, $lt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
    retour 0
  }
  si ($kd == "retour") {
    si ($ass == 0) {
      signaler($lg0, "'retour' hors de fonction", $err)
      retour 0
    }
    $e = $ie[$i]
    si ($e < 0) {
      si ($ra != "vide|vide") {
        signaler($lg0, "La fonction doit retourner un " + nomty($ra), $err)
      }
    }
    sinon {
      $t = check_expr($e, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
      $bad = 0
      # fonction sans type de retour déclaré : le moteur met le retour en
      # Dyn (« ? ») et accepte n'importe quel type de valeur.
      si (BASE($ra) == "?") { $bad = 0 }
      sinon si ($t != $ra) {
        si (non(estnum($t) et estnum($ra) et promote($t, $ra) == $ra)) { $bad = 1 }
      }
      si ($bad == 1) {
        signaler($lg0, "La fonction retourne " + nomty($t) + ", attendu " + nomty($ra), $err)
      }
    }
    retour 0
  }
  si ($kd == "expr") {
    check_expr($ie[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
               $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err, $tni, $tnt, $tri, $trt)
    retour 0
  }
  si ($kd == "bloc") {
    parcourir($ib1[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
  }
}

fn parcourir($cs: chaine,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
             $ln: liste<chaine>, $lt: liste<chaine>,
             $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $ass: entier, $ra: chaine, $err: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>) {
  $j = 0
  $n = longueur($cs)
  $cur = ""
  tant_que ($j < $n) {
    si (longueur($err) > 1) { $j = $n }
    sinon {
      $c = ordre($cs[$j])
      si ($c == 44) {
        si ($cur != "") {
          check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                      $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                      $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
          $cur = ""
        }
      }
      sinon { $cur = $cur + $cs[$j] }
      $j = $j + 1
    }
  }
  si (longueur($err) == 1 et $cur != "") {
    check_instr(entier($cur), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $vn, $vt, $gn, $gt, $ln, $lt, $fnoms, $fparams, $fret,
                $foi, $fot, $fof, $ass, $ra, $err, $tni, $tnt, $tri, $trt)
  }
}

# comparution lexicale par codepoints = ordre std::map du moteur
fn cmp_str($a: chaine, $b: chaine) -> entier {
  $la = longueur($a)
  $lb = longueur($b)
  $n = $la
  si ($lb < $n) { $n = $lb }
  $i = 0
  tant_que ($i < $n) {
    $ca = ordre($a[$i])
    $cb = ordre($b[$i])
    si ($ca < $cb) { retour -1 }
    si ($ca > $cb) { retour 1 }
    $i = $i + 1
  }
  si ($la < $lb) { retour -1 }
  si ($la > $lb) { retour 1 }
  retour 0
}

# ══════════════════ notes de types et coque de vérification ══════════════════
# L'émission RIR a besoin du type que le vérificateur a calculé pour chaque
# nœud (suffixes add.f, cst.q, destination de index…) et du type de lecture
# de chaque « lire » (message du dump). check_expr est la COQUE de ce_raw :
# elle note le type (index du nœud vers « base|elt ») à chaque visite saine
# puis le rend. Les secondes visites (MIXTE/NUM_MAX recalent l'argument)
# recréent des entrées identiques : la recherche lit la première, le doublon
# est inoffensif. Les notes voyagent en listes plates — une table en
# paramètre serait hors de portée de l'AOT — et l'ordre post-ordre des deux
# passes rend la recherche linéaire quasi immédiate.

fn check_expr($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $vn: liste<chaine>, $vt: liste<chaine>, $gn: liste<chaine>, $gt: liste<chaine>,
              $fnoms: liste<chaine>, $fparams: liste<chaine>, $fret: liste<chaine>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $err: liste<chaine>, $tni: liste<entier>, $tnt: liste<chaine>,
              $tri: liste<entier>, $trt: liste<chaine>) -> chaine {
  $t = ce_raw($i, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $vn, $vt, $gn, $gt, $fnoms, $fparams, $fret, $foi, $fot, $fof, $err,
              $tni, $tnt, $tri, $trt)
  si (longueur($err) == 1) {
    joindre($tni, $i)
    joindre($tnt, $t)
  }
  retour $t
}

# type d'une entrée de repli d'après son drapeau : « 1 » flottant, « q »
# rationnel, vide entier — sans jamais ratisser le texte (un pli comme
# 2^30000000 fait neuf millions de caractères que contient_barre ne doit
# pas parcourir, et le drapeau porte déjà l'information, comme le nœud
# littéral reconstitué côté C++ : T_ENTIER / T_RATIONNEL / T_FLOTTANT).
fn t_entree($f: chaine) -> chaine {
  si ($f == "1") { retour "flottant|vide" }
  si ($f == "q") { retour "rationnel|vide" }
  retour "entier|vide"
}

# dénominateur réduit à 1 ? — miroir fidèle de la normalisation de rnorm,
# calculé sur les entiers (le pgcd d'un géant et de 1 est un seul modulo).
fn rden1($p: entier, $q: entier) -> booleen {
  $np = $p
  $nq = $q
  si ($nq < 0) { $np = 0 - $np; $nq = 0 - $nq }
  si ($np == 0) { retour vrai }
  $g = pgcd2($np, $nq)
  si ($g > 1) { $nq = $nq div $g }
  retour $nq == 1
}

fn contient($s: chaine, $d: chaine) -> booleen {
  $n = longueur($s)
  $m = longueur($d)
  si ($m == 0) { retour vrai }
  $i = 0
  tant_que ($i + $m <= $n) {
    si (sous_chaine($s, $i, $i + $m) == $d) { retour vrai }
    $i = $i + 1
  }
  retour faux
}

# texte de littéral -> double au sens de lit_valeur_d : « p/q » vaut p divisé
# par q (le moteur fait strtod puis division), le reste passe par flottant(),
# le strtod du moteur — arrondi au plus proche identique.
fn val_d($v: chaine) -> flottant {
  $t = vue_texte($v)
  $n = longueur($t)
  $j = 0
  $ok = 1
  tant_que ($ok == 1) {
    si ($j >= $n) { $ok = 0 }
    sinon si (ordre($t[$j]) == 47) { $ok = 0 }
    sinon { $j = $j + 1 }
  }
  si ($j >= $n) { retour flottant($t) }
  retour flottant(sous_chaine($t, 0, $j)) / flottant(sous_chaine($t, $j + 1, $n))
}

# texte que le moteur écrit dans le RIR pour un flottant replié :
# texte_flottant = représentation la plus courte qui se relit à l'identique,
# « .0 » ajouté si elle n'a ni point ni exposant. chaine() imite ce texte
# SAUF pour les flottants entiers (|v| < 1e16) où il tronque via %lld :
# « 5.0 » devient « 5 » et « -0.0 » devient « 0 », signe perdu. On recolle
# donc « .0 » dans ce cas ; le signe du zéro se calcule sur place dans le
# pli (négation qui écrase un zéro, produit de facteurs de signes
# contraires) et se fige dans le texte stocké — 1.0 / 0.0 lève « division
# par zéro » dans le moteur, aucun sondage n'est possible, et les fonctions
# ne voyant pas les globales, rien d'autre ne peut charrier ce signe.
fn flot_txt($v: flottant, $zneg: booleen) -> chaine {
  $rs = chaine($v)
  $af = $v
  si ($af < 0.0) { $af = -$af }
  si ($af < 10000000000000000.0) {
    si ($v == entier($v)) {
      si ($v == 0.0) {
        $rs = "0.0"
        si ($zneg) { $rs = "-0.0" }
      }
      sinon {
        # flottant entier : chaine() passe par %lld — il faut le %.Ng de
        # texte_flottant. Chiffres significatifs = digits sans les zéros
        # finaux ; exposant = longueur - 1. printf : style fixe si
        # exposant < chiffres, sinon scientifique « d.ddde±dd ».
        $dg = chaine(entier($af))
        $e = longueur($dg) - 1
        $m = $dg
        $ok = 1
        tant_que ($ok == 1) {
          $nn = longueur($m)
          si ($nn <= 1) { $ok = 0 }
          sinon si (ordre($m[$nn - 1]) == 48) { $m = sous_chaine($m, 0, $nn - 1) }
          sinon { $ok = 0 }
        }
        $p = longueur($m)
        si ($e < $p) {
          $rs = $dg + ".0"
        } sinon {
          $rs = sous_chaine($m, 0, 1)
          si ($p > 1) { $rs = $rs + "." + sous_chaine($m, 1, $p) }
          $rs = $rs + "e+"
          si ($e < 10) { $rs = $rs + "0" }
          $rs = $rs + chaine($e)
        }
        si ($v < 0.0) { $rs = "-" + $rs }
      }
    }
  }
  retour $rs
}

# le signe d'un texte de littéral (les opérandes d'un pli sont toujours des
# littéraux — le « -0.0 » déjà plié porte son moins).
fn texte_neg($t: chaine) -> booleen {
  si (longueur($t) == 0) { retour faux }
  retour ordre($t[0]) == 45
}

# ══════════════════ émission RIR (passe 3) ══════════════════
# Miroir d'EmetteurRir : compteurs partagés — %t et suffixes de bloc comptent
# sans reprise sur tout le module. Les blocs sont déclarés dans l'ordre des
# push_back C++ ; le bloc en attente (test de tant_que, borne de pour) reçoit
# ses lignes avant même d'être listé, en portant déjà son nom : la liste $fb
# garde l'ordre de création et la fenêtre de lignes d'un bloc reste contiguë.
# Le curseur est toujours le dernier bloc déclaré — la coupure des « si »
# imbriqués tombe donc dans le « fin » intérieur, comme dans le moteur.

fn rir_of($b: chaine) -> chaine {
  si ($b == "entier") { retour "z" }
  si ($b == "rationnel") { retour "q" }
  si ($b == "flottant") { retour "f" }
  si ($b == "booleen") { retour "b" }
  si ($b == "chaine") { retour "s" }
  si ($b == "liste") { retour "l" }
  si ($b == "table") { retour "tbl" }
  retour "u"
}

fn tick_t($tc: liste<entier>) -> chaine {
  $s = "%t" + chaine(longueur($tc) - 1)
  joindre($tc, 0)
  retour $s
}

fn tick_b($bc: liste<entier>) -> chaine {
  $s = "_" + chaine(longueur($bc) - 1)
  joindre($bc, 0)
  retour $s
}

# type annoté d'un nœud : note de première visite, entrée de repli (littéral
# reconstitué du monde C++), littéral de source, puis le vide.
fn own($i: entier, $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
       $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
       $tni: liste<entier>, $tnt: liste<chaine>) -> chaine {
  $n = longueur($tni)
  $j = 1
  tant_que ($j < $n) {
    si ($tni[$j] == $i) { retour $tnt[$j] }
    $j = $j + 1
  }
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") { retour t_entree(vue_flag($vue)) }
  si ($k[$i] == "lit") { retour t_from_texte($tx[$i], $tf[$i]) }
  retour "vide|vide"
}

fn e_bloc($fb: liste<chaine>, $cc: liste<entier>, $nom: chaine) {
  joindre($fb, $nom)
  joindre($cc, longueur($fb) - 1)
}

# $na : la ligne a un opérande — le dump C++ écrit « » + texte pour chaque
# opérande, même vide (une chaine vide se dump «cst.s » avec l'espace).
fn e_ligne($fl: liste<chaine>, $flb: liste<entier>, $fp: liste<chaine>, $cc: liste<entier>,
           $dest: chaine, $op: chaine, $argstr: chaine, $msg: chaine, $na: booleen) {
  $l = "  "
  si ($dest != "") { $l = $l + $dest + " = " }
  $l = $l + $op
  si ($na) { $l = $l + " " + $argstr }
  si ($msg != "") { $l = $l + " \"" + $msg + "\"" }
  joindre($fl, $l)
  joindre($flb, $cc[longueur($cc) - 1])
  joindre($fp, $op)
}

# ══════════════════ émission RIR (format actuel) ══════════════════
# S-expression d'une expression depuis les pools (miroir de analyseur.rose).
# Les vues repliées (entree()) ont priorité sur le nœud brut.
fn em_ast_expr($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>) -> chaine {
  $vue = entree($i, $foi, $fot, $fof)
  $kd = $k[$i]
  $op0 = $tx[$i]
  $txt = $tx[$i]
  # repli de `-` sur un littéral : le moteur garde le drapeau neg et ecrit
  # "(f -" + texte. Quand le texte replié porte deja un '-', le neg rend
  # deux moins (ex. `moitie(-2.5)` -> `(f --2.5)`).
  si ($vue != "0" et $kd == "uni" et $op0 == "-" et vue_flag($vue) == "1") {
    $un = vue_texte($vue)
    si (longueur($un) > 0 et ordre($un[0]) == 45) { retour "(f -" + $un + ")" }
    retour "(f " + $un + ")"
  }
  # `-1` source : le moteur Rust garde le drapeau neg ET le texte replié
  # (déjà signé) -> `(n --1)`. Double négation repliée -> `(n 1)`.
  si ($vue != "0" et $kd == "uni" et $op0 == "-" et vue_flag($vue) == "") {
    $un = vue_texte($vue)
    si (longueur($un) > 0 et ordre($un[0]) == 45) { retour "(n -" + $un + ")" }
    retour "(n " + $un + ")"
  }
  # nœud replié : utiliser le texte/flag de la vue
  si ($vue != "0") {
    $txt = vue_texte($vue)
    $fl = vue_flag($vue)
    $kd = "lit"
    $op0 = ""
    $tf0 = $fl
    si ($fl == "1") { retour "(f " + $txt + ")" }
    si (contient_barre($txt)) { retour "(f " + $txt + ")" }
    retour "(n " + $txt + ")"
  }
  si ($kd == "lit") {
    si ($tf[$i] == "1") { retour "(f " + $txt + ")" }
    si (contient_barre($txt)) { retour "(f " + $txt + ")" }
    retour "(n " + $txt + ")"
  }
  si ($kd == "ch") { retour "(s \"" + ast_echapper($txt) + "\")" }
  si ($kd == "c") { retour "(c " + $txt + ")" }
  si ($kd == "bol") {
    si ($txt == "1") { retour "(b vraie)" }
    retour "(b faux)"
  }
  si ($kd == "v") { retour "(v " + $txt + ")" }
  si ($kd == "idx") {
    retour "(idx " + em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) +
           " " + em_ast_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + ")"
  }
  si ($kd == "bin") {
    retour "(bin " + $op0 + " " +
           em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + " " +
           em_ast_expr($b[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + ")"
  }
  si ($kd == "uni") {
    retour "(uni " + $op0 + " " +
           em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof) + ")"
  }
  si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super" ou $kd == "sfact" ou $kd == "mfact") {
    $nomf = "fact"
    si ($kd == "prim") { $nomf = "prim" }
    si ($kd == "term") { $nomf = "term" }
    si ($kd == "super") { $nomf = "super" }
    si ($kd == "sfact") { $nomf = "sfact" }
    $enf = em_ast_expr($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($kd == "mfact") { retour "(mfact " + $txt + " " + $enf + ")" }
    retour "(" + $nomf + " " + $enf + ")"
  }
  si ($kd == "lstvide") { retour "(lstvide " + $txt + ")" }
  si ($kd == "lst") {
    $e = "(lst"
    $sa = $as[$i]
    $nb = $ac[$i]
    $j = 0
    tant_que ($j < $nb) {
      $e = $e + " " + em_ast_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
      $j = $j + 1
    }
    retour $e + ")"
  }
  si ($kd == "app") {
    $mod = eclate_mod($txt)
    $nom = eclate_nom($txt)
    $e = "(app "
    si ($mod != "") { $e = $e + $mod + "::" }
    $e = $e + $nom
    $sa = $as[$i]
    $nb = $ac[$i]
    $j = 0
    tant_que ($j < $nb) {
      $e = $e + " " + em_ast_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
      $j = $j + 1
    }
    retour $e + ")"
  }
  retour "(v ?)"
}

fn ast_echapper($s: chaine) -> chaine {
  $o = ""
  $j = 0
  $n = longueur($s)
  tant_que ($j < $n) {
    $c = ordre($s[$j])
    si ($c == 92) { $o = $o + "\\\\" }
    sinon si ($c == 34) { $o = $o + "\\\"" }
    sinon si ($c == 10) { $o = $o + "\\n" }
    sinon si ($c == 13) { $o = $o + "\\r" }
    sinon si ($c == 9) { $o = $o + "\\t" }
    sinon { $o = $o + $s[$j] }
    $j = $j + 1
  }
  retour $o
}

# ── table des slots : nom → index (listes rembourrées à 0) ──
# $sn contient les noms, $sg les flags globaux (1 si global).
fn slot_index($slnom: chaine, $sln: liste<chaine>) -> entier {
  $sixn = longueur($sln)
  $sixj = 1
  tant_que ($sixj < $sixn) {
    si ($sln[$sixj] == $slnom) { retour $sixj - 1 }
    $sixj = $sixj + 1
  }
  retour -1
}

fn slot_de($slnom: chaine, $sln: liste<chaine>) -> entier {
  $sdk = slot_index($slnom, $sln)
  si ($sdk >= 0) { retour $sdk }
  joindre($sln, $slnom)
  retour longueur($sln) - 2
}

# marque un slot comme global
fn marquer_global($k: entier, $sg: liste<entier>) {
  $mgj = 1
  $mgn = longueur($sg)
  tant_que ($mgj < $mgn et $sg[$mgj] != $k) { $mgj = $mgj + 1 }
  si ($mgj >= $mgn) { joindre($sg, $k) }
}

# abstraction d'une expression en Eabstrait (S-expression RIR).
# $connus : liste des noms de fonctions à corps (RIR_CONNUS).
# rend "" si non abstractible (⇒ forme AST).
fn em_abstrait($i: entier,
              $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
              $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
              $lg: liste<entier>, $al: liste<entier>,
              $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
              $sn: liste<chaine>, $connus: liste<chaine>) -> chaine {
  $vue = entree($i, $foi, $fot, $fof)
  $kd = $k[$i]
  $op0 = $tx[$i]
  $txt = $tx[$i]
  # Var → slot (le nom doit avoir un slot)
  si ($kd == "v") {
    $s = slot_index($tx[$i], $sn)
    si ($s >= 0) { retour "slot " + chaine($s) }
    retour ""
  }
  # Appel → appel_rir si fonction connue, args non vides et tous des Var
  si ($kd == "app") {
    $nom = eclate_nom($tx[$i])
    $connu = 0
    $u = 1
    tant_que ($u < longueur($connus)) {
      si ($connus[$u] == $nom) { $connu = 1 }
      $u = $u + 1
    }
    $sa = $as[$i]
    $nb = $ac[$i]
    $tousvar = 1
    si ($nb == 0) { $tousvar = 0 }
    $j = 0
    tant_que ($j < $nb) {
      si ($k[$al[$sa + $j]] != "v") { $tousvar = 0 }
      $j = $j + 1
    }
    si ($connu == 1 et $tousvar == 1) {
      $e = "(appel_rir " + $nom
      $j = 0
      tant_que ($j < $nb) {
        $e = $e + " " + em_ast_expr($al[$sa + $j], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
        $j = $j + 1
      }
      retour $e + ")"
    }
    retour ""
  }
  # Littéral replié : entier / flottant (rationnel refusé)
  si ($vue != "0") {
    $txt = vue_texte($vue)
    $fl = vue_flag($vue)
    si ($fl == "1") { retour "flottant " + vers_flottant($txt) }
    si (contient_barre($txt)) { retour "" }
    retour "entier " + $txt
  }
  si ($kd == "lit") {
    si ($tf[$i] == "1") { retour "flottant " + vers_flottant($txt) }
    si (contient_barre($txt)) { retour "" }
    retour "entier " + $txt
  }
  # Un exposant rationnel (1/3, 2/5...) est hors sous-ensemble cote Rust :
  # Eabstrait::Binaire n'a pas de rationnel, donc abstraire() echoue et
  # l'affichage reste un (bin ^ ...) AST.
  si ($kd == "bin" et $op0 == "^") {
    $vexp = entree($b[$i], $foi, $fot, $fof)
    si ($vexp != "0" et contient_barre(vue_texte($vexp))) { retour "" }
    si ($k[$b[$i]] == "lit" et contient_barre($tx[$b[$i]])) { retour "" }
  }
  # Binaire : op dans le sous-ensemble, deux opérandes abstractibles
  $ops = "|" + $op0 + "|"
  si ($kd == "bin" et contient_ops("|+|-|*|/|%|^|div|<|<=|>|>=|==|!=|et|ou|", $ops)) {
    $g = ""
    $ga = $a[$i]
    $vga = entree($ga, $foi, $fot, $fof)
    si ($k[$ga] == "uni" et $tx[$ga] == "-" et $vga != "0" et vue_flag($vga) == "1") {
      $tga = vue_texte($vga)
      $fga = vue_flag($vga)
      $pga = $tga
      si (longueur($pga) > 0 et ordre($pga[0]) == 45) { $pga = sous_chaine($pga, 1, longueur($pga)) }
      si ($fga == "1") { $g = "(neg flottant " + vers_flottant($pga) + ")" }
      sinon { $g = "(neg entier " + $pga + ")" }
    } sinon { $g = em_abstrait($ga, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus) }
    $d = ""
    $gb = $b[$i]
    $vgb = entree($gb, $foi, $fot, $fof)
    si ($k[$gb] == "uni" et $tx[$gb] == "-" et $vgb != "0" et vue_flag($vgb) == "1") {
      $tgb = vue_texte($vgb)
      $fgb = vue_flag($vgb)
      $pgb = $tgb
      si (longueur($pgb) > 0 et ordre($pgb[0]) == 45) { $pgb = sous_chaine($pgb, 1, longueur($pgb)) }
      si ($fgb == "1") { $d = "(neg flottant " + vers_flottant($pgb) + ")" }
      sinon { $d = "(neg entier " + $pgb + ")" }
    } sinon { $d = em_abstrait($gb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus) }
    si ($g != "" et $d != "") { retour "(bin " + $op0 + " " + $g + " " + $d + ")" }
    retour ""
  }
  # Unaire : - → neg, non → non
  si ($kd == "uni") {
    $g = em_abstrait($a[$i], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    si ($g == "") { retour "" }
    si ($op0 == "-") { retour "(neg " + $g + ")" }
    si ($op0 == "non") { retour "(non " + $g + ")" }
    retour ""
  }
  retour ""
}

fn contient_ops($s: chaine, $sub: chaine) -> booleen {
  $n = longueur($s)
  $m = longueur($sub)
  $i = 0
  tant_que ($i + $m <= $n) {
    si (sous_chaine($s, $i, $i + $m) == $sub) { retour vrai }
    $i = $i + 1
  }
  retour faux
}

# main.rs ecrit Eabstrait::Flottant avec d.to_string() (Display Rust) :
# decimal plein, jamais d'exposant, et "-0" pour le zero negatif. chaine()
# de Rose donne le plus court qui se relit (texte_flottant, style %g) ; on
# developpe l'exponentielle et on recolle le signe du zero.
fn vers_flottant($t: chaine) -> chaine {
  $neg = faux
  si (longueur($t) > 0 et ordre($t[0]) == 45) { $neg = vrai }
  $s = chaine(flottant($t))
  $u = $s
  $signe = ""
  si (longueur($u) > 0 et ordre($u[0]) == 45) { $signe = "-"; $u = sous_chaine($u, 1, longueur($u)) }
  $n = longueur($u)
  $e = -1
  $i = 0
  tant_que ($i < $n) {
    si (ordre($u[$i]) == 101) { $e = $i }
    $i = $i + 1
  }
  si ($e < 0) {
    si ($neg et $u == "0") { retour "-0" }
    retour $s
  }
  $mant = sous_chaine($u, 0, $e)
  $expo = entier(sous_chaine($u, $e + 1, $n))
  $digits = ""
  $dec = -1
  $j = 0
  $lm = longueur($mant)
  tant_que ($j < $lm) {
    si (ordre($mant[$j]) == 46) { $dec = longueur($digits) }
    sinon { $digits = $digits + $mant[$j] }
    $j = $j + 1
  }
  si ($dec < 0) { $dec = longueur($digits) }
  $pt = $dec + $expo
  $nd = longueur($digits)
  $res = ""
  si ($pt <= 0) {
    $res = "0."
    $z = 0
    tant_que ($z < 0 - $pt) { $res = $res + "0"; $z = $z + 1 }
    $res = $res + $digits
  } sinon si ($pt >= $nd) {
    $res = $digits
    $z = 0
    tant_que ($z < $pt - $nd) { $res = $res + "0"; $z = $z + 1 }
  } sinon {
    $res = sous_chaine($digits, 0, $pt) + "." + sous_chaine($digits, $pt, $nd)
  }
  retour $signe + $res
}

fn em_expr($i: entier, $ta: chaine,
           $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
           $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
           $lg: liste<entier>, $al: liste<entier>,
           $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
           $tni: liste<entier>, $tnt: liste<chaine>,
           $tc: liste<entier>, $bc: liste<entier>,
           $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
           $fp: liste<chaine>, $cc: liste<entier>) -> chaine {
  $ty = own($i, $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
  si ($ta == "u" et BASE($ty) != "vide") { $ta = rir_of(BASE($ty)) }
  $kd = $k[$i]
  $op0 = $tx[$i]
  $t = ""
  $g = ""
  $d = ""
  $opn = ""
  # — comparaison entre tampons : égalité générique, pas de conversion —
  si ($kd == "bin" et ($op0 == "==" ou $op0 == "!=")) {
    $tg = own($a[$i], $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
    $td = own($b[$i], $k, $tx, $tf, $foi, $fot, $fof, $tni, $tnt)
    si (BASE($tg) == "tampon" ou BASE($td) == "tampon") {
      $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      $d = em_expr($b[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      $t = tick_t($tc)
      $opn = "cmp.eq.b"
      si ($op0 == "!=") { $opn = "cmp.ne.b" }
      e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g + " " + $d, "", vrai)
      retour $t
    }
  }
  # — nœud replié = littéral du monde C++ : constante inline —
  $vue = entree($i, $foi, $fot, $fof)
  si ($vue != "0") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst." + $ta, "@" + "c" + vue_texte($vue), "", vrai)
    retour $t
  }
  si ($kd == "lit") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst." + $ta, "@" + "c" + $tx[$i], "", vrai)
    retour $t
  }
  si ($kd == "ch") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "cst.s", $tx[$i], "", vrai)
    retour $t
  }
  si ($kd == "bol") {
    $t = tick_t($tc)
    $vv = "faux"
    si ($tx[$i] == "1") { $vv = "vrai" }
    e_ligne($fl, $flb, $fp, $cc, $t, "cst.b", $vv, "", vrai)
    retour $t
  }
  si ($kd == "v") { retour "%" + $tx[$i] }
  si ($kd == "idx") {
    $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $d = em_expr($b[$i], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "index", $g + " " + $d, "", vrai)
    retour $t
  }
  si ($kd == "bin") {
    $g = em_expr($a[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $d = em_expr($b[$i], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    si ($op0 == "+") { $opn = "add" }
    sinon si ($op0 == "-") { $opn = "sub" }
    sinon si ($op0 == "*") { $opn = "mul" }
    sinon si ($op0 == "/") { $opn = "div" }
    sinon si ($op0 == "div") { $opn = "divf" }
    sinon si ($op0 == "^") { $opn = "pow" }
    sinon si ($op0 == "%") { $opn = "rem.z" }
    sinon si ($op0 == "==") { $opn = "cmp.eq" }
    sinon si ($op0 == "!=") { $opn = "cmp.ne" }
    sinon si ($op0 == "<") { $opn = "cmp.lt" }
    sinon si ($op0 == "<=") { $opn = "cmp.le" }
    sinon si ($op0 == ">") { $opn = "cmp.gt" }
    sinon si ($op0 == ">=") { $opn = "cmp.ge" }
    sinon si ($op0 == "et") { $opn = "and" }
    sinon si ($op0 == "ou") { $opn = "or" }
    sinon { $opn = $op0 }
    si ($op0 == "≈" ou $op0 == "?=" ou $op0 == "=~") { $opn = "cmp.approx" }
    si ($opn != "cmp.approx") { $opn = $opn + "." + $ta }
    e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g + " " + $d, "", vrai)
    retour $t
  }
  si ($kd == "uni") {
    $g = em_expr($a[$i], $ta, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    $opn = "neg." + $ta
    si ($tx[$i] == "non") { $opn = "not.b" }
    e_ligne($fl, $flb, $fp, $cc, $t, $opn, $g, "", vrai)
    retour $t
  }
  si ($kd == "fac" ou $kd == "prim" ou $kd == "term" ou $kd == "super") {
    $g = em_expr($a[$i], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "call @builtin.factorielle", $g, "", vrai)
    retour $t
  }
  si ($kd == "lstvide") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "liste.new", "", "", faux)
    retour $t
  }
  si ($kd == "lst") {
    $t = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $t, "liste.new", "", "", faux)
    $sa = $as[$i]
    $nb = $ac[$i]
    $j = 0
    tant_que ($j < $nb) {
      $d = em_expr($al[$sa + $j], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      e_ligne($fl, $flb, $fp, $cc, "", "liste.push", $t + " " + $d, "", vrai)
      $j = $j + 1
    }
    retour $t
  }
  si ($kd == "app") {
    $sa = $as[$i]
    $nb = $ac[$i]
    $args = ""
    $j = 0
    tant_que ($j < $nb) {
      $d = em_expr($al[$sa + $j], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      si ($args == "") { $args = $d } sinon { $args = $args + " " + $d }
      $j = $j + 1
    }
    $t = tick_t($tc)
    $nom = $tx[$i]
    $nq = longueur($nom)
    $q = 0
    $okq = 1
    tant_que ($okq == 1) {
      si ($q >= $nq) { $okq = 0 }
      sinon si (ordre($nom[$q]) == 59) { $okq = 0 }
      sinon { $q = $q + 1 }
    }
    si ($q < $nq) { $nom = sous_chaine($nom, $q + 1, $nq) }
    $asg = "$" + $nom
    si ($args != "") { $asg = $asg + " " + $args }
    e_ligne($fl, $flb, $fp, $cc, $t, "call", $asg, "", vrai)
    retour $t
  }
  retour "%?"
}

fn em_instr($ix: entier,
            $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
            $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
            $lg: liste<entier>, $al: liste<entier>,
            $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
            $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
            $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
            $tni: liste<entier>, $tnt: liste<chaine>,
            $tri: liste<entier>, $trt: liste<chaine>,
            $tc: liste<entier>, $bc: liste<entier>,
            $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
            $fp: liste<chaine>, $cc: liste<entier>) {
  $kd = $ik[$ix]
  $lgn = $ilg[$ix]
  $v = ""
  $sf = ""
  si ($kd == "aff") {
    $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "afficher", $v, "", vrai)
    retour 0
  }
  si ($kd == "lire") {
    $t = tick_t($tc)
    $nu = "1"
    $nn = longueur($tri)
    $j = 1
    $trouve = 0
    tant_que ($j < $nn et $trouve == 0) {
      si ($tri[$j] == $ix) { $nu = $trt[$j]; $trouve = 1 }
      $j = $j + 1
    }
    e_ligne($fl, $flb, $fp, $cc, $t, "lire", "%" + $ino[$ix], $nu, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $t, $ino[$ix], vrai)
    retour 0
  }
  si ($kd == "affi") {
    $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $v, $ino[$ix], vrai)
    retour 0
  }
  si ($kd == "si") {
    $v = em_expr($ie[$ix], "b", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $sf = tick_b($bc)
    $l1 = ".alors_" + chaine($lgn) + $sf
    $l2 = ".sinon_" + chaine($lgn) + $sf
    $l3 = ".fin_" + chaine($lgn) + $sf
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $v + " " + $l1 + " " + $l2, "", vrai)
    e_bloc($fb, $cc, $l1)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l2)
    si ($ib2[$ix] != "") {
      em_corps($ib2[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    }
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l3)
    retour 0
  }
  si ($kd == "tq") {
    $sf = tick_b($bc)
    $l1 = ".cond_" + chaine($lgn) + $sf
    $l2 = ".corps_" + chaine($lgn) + $sf
    $l3 = ".fin_" + chaine($lgn) + $sf
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l1)
    $v = em_expr($ie[$ix], "b", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $v + " " + $l2 + " " + $l3, "", vrai)
    e_bloc($fb, $cc, $l2)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l3)
    retour 0
  }
  si ($kd == "pour") {
    $var = $ino[$ix]
    $sf = tick_b($bc)
    $l1 = ".cond_" + chaine($lgn) + $sf
    $l2 = ".corps_" + chaine($lgn) + $sf
    $l3 = ".incr_" + chaine($lgn) + $sf
    $l4 = ".fin_" + chaine($lgn) + $sf
    $v = em_expr($ie[$ix], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $v, $var, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l1)
    $d = em_expr($ie2[$ix], "z", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    $ct = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $ct, "cmp.lt.z", "%" + $var + " " + $d, "", vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br.cond", $ct + " " + $l2 + " " + $l4, "", vrai)
    e_bloc($fb, $cc, $l2)
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l3, "", vrai)
    e_bloc($fb, $cc, $l3)
    $nt = tick_t($tc)
    e_ligne($fl, $flb, $fp, $cc, $nt, "add.z", "%" + $var + " @c1", "", vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "affect", $nt, $var, vrai)
    e_ligne($fl, $flb, $fp, $cc, "", "br", $l1, "", vrai)
    e_bloc($fb, $cc, $l4)
    retour 0
  }
  si ($kd == "retour") {
    si ($ie[$ix] >= 0) {
      $v = em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
      e_ligne($fl, $flb, $fp, $cc, "", "ret", $v, "", vrai)
    }
    sinon {
      e_ligne($fl, $flb, $fp, $cc, "", "ret.u", "", "", faux)
    }
    retour 0
  }
  si ($kd == "expr") {
    em_expr($ie[$ix], "u", $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $tni, $tnt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
    retour 0
  }
  si ($kd == "bloc") {
    em_corps($ib1[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
  }
}

fn em_corps($cs: chaine,
            $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
            $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
            $lg: liste<entier>, $al: liste<entier>,
            $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
            $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
            $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
            $tni: liste<entier>, $tnt: liste<chaine>,
            $tri: liste<entier>, $trt: liste<chaine>,
            $tc: liste<entier>, $bc: liste<entier>,
            $fb: liste<chaine>, $fl: liste<chaine>, $flb: liste<entier>,
            $fp: liste<chaine>, $cc: liste<entier>) {
  $j = 0
  $n = longueur($cs)
  $debut = 0
  tant_que ($j <= $n) {
    $c = 10
    si ($j < $n) { $c = ordre($cs[$j]) }
    si ($j == $n ou $c == 44) {
      si ($j > $debut) {
        em_instr(entier(sous_chaine($cs, $debut, $j)), $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
        $debut = $j + 1
      }
    }
    $j = $j + 1
  }
}

# ── abaissement d'un corps en opérations RIR ──────────────────────────
# Les ops sont accumulées dans $op (chaîne « instruction\n»), numérotées par
# $ipc. Les sauts utilisent des marqueurs « @label » remplacés en fin de passe.
# $sn = noms des slots, $sg = flags globaux, $connus = fonctions RIR.

fn rir_op($opch: chaine, $ipc: entier, $ops: liste<chaine>) {
  $s = chaine($ipc)
  $pad = ""
  $z = longueur($s)
  tant_que ($z < 4) { $pad = $pad + "0"; $z = $z + 1 }
  joindre($ops, "    " + $pad + $s + " " + $opch)
}

# émet une op pour une instruction ; rend le nouveau $ipc
fn rir_instr($ix: entier, $ipc: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $sn: liste<chaine>, $glst: liste<entier>, $connus: liste<chaine>, $ops: liste<chaine>,
             $estprincipal: booleen, $dans_pour: booleen) -> entier {
  $kd = $ik[$ix]
  $pc = $ipc
  si ($kd == "aff") {
    $absres = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($absres != "") {
      rir_op("afficher_abstrait " + $absres, $pc, $ops)
    } sinon {
      rir_op("afficher " + $ex, $pc, $ops)
    }
    retour $pc + 1
  }
  si ($kd == "expr") {
    rir_op("expr " + em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof), $pc, $ops)
    retour $pc + 1
  }
  si ($kd == "affi") {
    $rislot = slot_de($ino[$ix], $sn)
    # miroir de collecter() cote Rust : une variable affectee DANS un corps
    # de « pour » n'est pas declarée globale (mesuré : t_tampon $x slot 3 et
    # $c slot 8 absents de « globaux » dans l'oracle).
    si ($estprincipal et non $dans_pour) { marquer_global($rislot, $glst) }
    $riab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $riex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($riab != "") {
      rir_op("affect slot " + chaine($rislot) + " = " + $riab, $pc, $ops)
    } sinon {
      rir_op("affect_ast slot " + chaine($rislot) + " = " + $riex, $pc, $ops)
    }
    retour $pc + 1
  }
  si ($kd == "retour") {
    si ($ie[$ix] >= 0) {
      $ab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
      $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
      si ($ab != "") { rir_op("retour_abstrait " + $ab, $pc, $ops) }
      sinon { rir_op("retour " + $ex, $pc, $ops) }
    } sinon {
      rir_op("retour", $pc, $ops)
    }
    retour $pc + 1
  }
  si ($kd == "lire") {
    $s = slot_de($ino[$ix], $sn)
    si ($estprincipal) { marquer_global($s, $glst) }
    rir_op("lire slot " + chaine($s) + " Dyn", $pc, $ops)
    retour $pc + 1
  }
  # contrôle de flux : sauts (à patcher)
  si ($kd == "si") {
    $ab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    $a_sinon = 0
    si (longueur($ib2[$ix]) > 0) { $a_sinon = 1 }
    si ($a_sinon == 1) {
      si ($ab != "") { rir_op("saut_si_faux_abstrait @sinon_" + chaine($ix) + "_ " + $ab, $pc, $ops) }
      sinon { rir_op("saut_si_faux @sinon_" + chaine($ix) + "_ " + $ex, $pc, $ops) }
      $pc = $pc + 1
      $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
      rir_op("saut @fin_" + chaine($ix) + "_", $pc, $ops)
      $pc = $pc + 1
      joindre($ops, "@sinon_" + chaine($ix) + "_:")
      $pc = rir_corps($ib2[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
      joindre($ops, "@fin_" + chaine($ix) + "_:")
    } sinon {
      # sans sinon : saut-si-faux vise directement « après », aucun saut final
      si ($ab != "") { rir_op("saut_si_faux_abstrait @fin_" + chaine($ix) + "_ " + $ab, $pc, $ops) }
      sinon { rir_op("saut_si_faux @fin_" + chaine($ix) + "_ " + $ex, $pc, $ops) }
      $pc = $pc + 1
      $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
      joindre($ops, "@fin_" + chaine($ix) + "_:")
    }
    retour $pc
  }
  si ($kd == "tq") {
    joindre($ops, "@cond_" + chaine($ix) + "_:")
    $ab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $ex = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    si ($ab != "") { rir_op("saut_si_faux_abstrait @fin_" + chaine($ix) + "_ " + $ab, $pc, $ops) }
    sinon { rir_op("saut_si_faux @fin_" + chaine($ix) + "_ " + $ex, $pc, $ops) }
    $pc = $pc + 1
    $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
    rir_op("saut @cond_" + chaine($ix) + "_", $pc, $ops)
    $pc = $pc + 1
    joindre($ops, "@fin_" + chaine($ix) + "_:")
    retour $pc
  }
  si ($kd == "pour") {
    $pslot = slot_de($ino[$ix], $sn)
    si ($estprincipal et non $dans_pour) { marquer_global($pslot, $glst) }
    $pdebut = em_ast_expr($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    $pab = em_abstrait($ie[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    si ($pab != "") { rir_op("affect slot " + chaine($pslot) + " = " + $pab, $pc, $ops) }
    sinon { rir_op("affect_ast slot " + chaine($pslot) + " = " + $pdebut, $pc, $ops) }
    $pc = $pc + 1
    joindre($ops, "@pcond_" + chaine($ix) + "_:")
    # test : bin < (v var) fin
    $pfin = em_ast_expr($ie2[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof)
    $pfab = em_abstrait($ie2[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $foi, $fot, $fof, $sn, $connus)
    $pvar = "slot " + chaine($pslot)
    si ($pfab != "") {
      rir_op("saut_si_faux_abstrait @pfin_" + chaine($ix) + "_ (bin < " + $pvar + " " + $pfab + ")", $pc, $ops)
    } sinon {
      rir_op("saut_si_faux @pfin_" + chaine($ix) + "_ (bin < (v " + $ino[$ix] + ") " + $pfin + ")", $pc, $ops)
    }
    $pc = $pc + 1
    $pc = rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, vrai)
    rir_op("affect slot " + chaine($pslot) + " = (bin + slot " + chaine($pslot) + " entier 1)", $pc, $ops)
    $pc = $pc + 1
    rir_op("saut @pcond_" + chaine($ix) + "_", $pc, $ops)
    $pc = $pc + 1
    joindre($ops, "@pfin_" + chaine($ix) + "_:")
    retour $pc
  }
  si ($kd == "bloc") {
    retour rir_corps($ib1[$ix], $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
  }
  retour $pc
}

fn rir_corps($cs: chaine, $ipc: entier,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $sn: liste<chaine>, $glst: liste<entier>, $connus: liste<chaine>, $ops: liste<chaine>,
             $estprincipal: booleen, $dans_pour: booleen) -> entier {
  $pc = $ipc
  $j = 0
  $n = longueur($cs)
  $debut = 0
  tant_que ($j <= $n) {
    $c = 10
    si ($j < $n) { $c = ordre($cs[$j]) }
    si ($j == $n ou $c == 44) {
      si ($j > $debut) {
        $pc = rir_instr(entier(sous_chaine($cs, $debut, $j)), $pc, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, $dans_pour)
        $debut = $j + 1
      }
    }
    $j = $j + 1
  }
  retour $pc
}

# patche les marqueurs @label dans les sauts : remplacer @label par le numéro
# de l'op qui porte le marqueur "@label:" ; supprimer les lignes marqueurs.
fn rir_patcher($ops: liste<chaine>) -> liste<chaine> {
  # 1) enlever les lignes marqueurs, garder la liste des ops réelles
  $res = [""]
  $labels = [""]
  $cibles = [0]
  $u = 1
  tant_que ($u < longueur($ops)) {
    $ch = $ops[$u]
    si (longueur($ch) > 0 et ordre($ch[0]) == 64) {
      joindre($labels, sous_chaine($ch, 1, longueur($ch) - 1))
      joindre($cibles, longueur($res) - 1)
    } sinon {
      joindre($res, $ch)
    }
    $u = $u + 1
  }
  # 2) pour chaque op, remplacer @label par la cible du PREMIER marqueur
  #    de ce label situé APRÈS l'op (le plus proche en avant).
  $out = [""]
  $tab = table()
  $z = 1
  tant_que ($z < longueur($labels)) {
    inserer($tab, $labels[$z], $cibles[$z])
    $z = $z + 1
  }
  $u = 1
  tant_que ($u < longueur($res)) {
    $ch = rir_patch_op($res[$u], $u, $labels, $cibles, $tab)
    joindre($out, $ch)
    $u = $u + 1
  }
  retour $out
}

fn rir_patch_op($ch: chaine, $pos: entier, $labels: liste<chaine>, $cibles: liste<entier>, $tab: table) -> chaine {
  $parts = [""]
  $cur = ""
  $i = 0
  $n = longueur($ch)
  tant_que ($i < $n) {
    si ($ch[$i] == "@") {
      $j = $i + 1
      $lab = ""
      tant_que ($j < $n et est_suite(ordre($ch[$j]))) {
        $lab = $lab + $ch[$j]
        $j = $j + 1
      }
      si (longueur($lab) > 0 et cle_existe($tab, $lab)) {
        joindre($parts, $cur)
        joindre($parts, chaine($tab[$lab]))
        $cur = ""
        $i = $j
      } sinon {
        $cur = $cur + "@"
        $i = $i + 1
      }
    } sinon {
      $cur = $cur + $ch[$i]
      $i = $i + 1
    }
  }
  joindre($parts, $cur)
  retour rnat_join($parts, 1, longueur($parts))
}

fn cibles_distance($c: entier, $p: entier) -> entier {
  $d = $c - $p
  si ($d < 0) { $d = -$d }
  retour $d
}

fn position_sous($s: chaine, $sub: chaine) -> entier {
  $n = longueur($s)
  $m = longueur($sub)
  $i = 0
  tant_que ($i + $m <= $n) {
    si (sous_chaine($s, $i, $i + $m) == $sub) { retour $i }
    $i = $i + 1
  }
  retour -1
}

fn remplacer_tout($s: chaine, $de: chaine, $vers: chaine) -> chaine {
  $parts = [""]
  $cur = ""
  $i = 0
  $nd = longueur($de)
  $ns = longueur($s)
  tant_que ($i < $ns) {
    si ($i + $nd <= $ns et sous_chaine($s, $i, $i + $nd) == $de) {
      joindre($parts, $cur)
      joindre($parts, $vers)
      $cur = ""
      $i = $i + $nd
    } sinon {
      $cur = $cur + $s[$i]
      $i = $i + 1
    }
  }
  joindre($parts, $cur)
  retour rnat_join($parts, 1, longueur($parts))
}

fn em_fonction_rir($nom: chaine, $ps: chaine, $ra: chaine, $corps: chaine,
             $estprincipal: booleen,
             $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
             $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
             $lg: liste<entier>, $al: liste<entier>,
             $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
             $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
             $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
             $connus: liste<chaine>, $outl: liste<chaine>) {
  $sn = [""]
  $glst = [0]   # sentinelle (0 au lieu de -1 : évite un repli de -1 fragile)
  # paramètres d'abord
  $np = nb_pieces($ps, 59)
  $u = 1
  tant_que ($u <= $np) {
    $ent = piece($ps, 59, $u)
    $pp = premier_pipe($ent)
    $pn = sous_chaine($ent, 0, $pp)
    joindre($sn, $pn)
    $u = $u + 1
  }
  $ops = [""]
  $pc = rir_corps($corps, 0, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $sn, $glst, $connus, $ops, $estprincipal, faux)
  $ops = rir_patcher($ops)
  # patch des marqueurs : d'abord retirer les lignes marqueurs, noter leur cible
  # (les marqueurs sont émis avec un numéro séquentiel dans $ops).
  joindre($outl, "fonction " + $nom)
  $u = 1
  tant_que ($u <= $np) {
    $ent = piece($ps, 59, $u)
    $pp = premier_pipe($ent)
    $pn = sous_chaine($ent, 0, $pp)
    $pt = sous_chaine($ent, $pp + 1, longueur($ent))
    joindre($outl, "  param " + $pn + " " + nomty($pt))
    $u = $u + 1
  }
  joindre($outl, "  retour " + nomty($ra))
  joindre($outl, "  n_slots " + chaine(longueur($sn) - 1))
  $lgn = "  noms"
  $u = 1
  tant_que ($u < longueur($sn)) {
    $lgn = $lgn + " [" + chaine($u - 1) + "]" + $sn[$u]
    $u = $u + 1
  }
  joindre($outl, $lgn)
  si (longueur($glst) > 1) {
    $lgg = "  globaux"
    $u = 1
    tant_que ($u < longueur($glst)) {
      $lgg = $lgg + " " + chaine($glst[$u])
      $u = $u + 1
    }
    joindre($outl, $lgg)
  }
  joindre($outl, "  ops")
  $u = 1
  tant_que ($u < longueur($ops)) {
    joindre($outl, $ops[$u])
    $u = $u + 1
  }
}

fn em_fonction($nom: chaine, $ps: chaine, $ra: chaine, $corps: chaine,
               $k: liste<chaine>, $tx: liste<chaine>, $tf: liste<chaine>,
               $a: liste<entier>, $b: liste<entier>, $as: liste<entier>, $ac: liste<entier>,
               $lg: liste<entier>, $al: liste<entier>,
               $ik: liste<chaine>, $ino: liste<chaine>, $ie: liste<entier>, $ie2: liste<entier>,
               $ib1: liste<chaine>, $ib2: liste<chaine>, $ilg: liste<entier>,
               $foi: liste<entier>, $fot: liste<chaine>, $fof: liste<chaine>,
               $tni: liste<entier>, $tnt: liste<chaine>,
               $tri: liste<entier>, $trt: liste<chaine>,
               $tc: liste<entier>, $bc: liste<entier>,
               $outl: liste<chaine>) {
  $fb = [""]
  $fl = [""]
  $flb = [0]
  $fp = [""]
  $cc = [0]
  e_bloc($fb, $cc, ".entree")
  em_corps($corps, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al, $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $tni, $tnt, $tri, $trt, $tc, $bc, $fb, $fl, $flb, $fp, $cc)
  # — ret. implicite quand la dernière ligne n'est pas un retour —
  $ret_ok = 0
  si (longueur($fp) > 1) {
    $pop = $fp[longueur($fp) - 1]
    si (longueur($pop) >= 3) {
      si (sous_chaine($pop, 0, 3) == "ret") { $ret_ok = 1 }
    }
  }
  si ($ret_ok == 0) { e_ligne($fl, $flb, $fp, $cc, "", "ret.u", "", "", faux) }
  # — assemblage : en-tête (paramètres sous la forme étonnante du dump,
  # nom %nom : type), puis chaque bloc avec sa fenêtre de lignes —
  joindre($outl, "")
  $tt = "fonction " + $nom + "("
  $np = nb_pieces($ps, 59)
  $u = 1
  tant_que ($u <= $np) {
    si ($u > 1) { $tt = $tt + ", " }
    $ent = piece($ps, 59, $u)
    $pp = premier_pipe($ent)
    $pn = sous_chaine($ent, 0, $pp)
    $pt = sous_chaine($ent, $pp + 1, longueur($ent))
    $tt = $tt + $pn + " %" + $pn + " : " + rir_of(BASE($pt))
    $u = $u + 1
  }
  $tt = $tt + ") -> " + rir_of(BASE($ra)) + " {"
  joindre($outl, $tt)
  $ln = 1
  $bk = 1
  tant_que ($bk < longueur($fb)) {
    joindre($outl, $fb[$bk] + ":")
    $arret = 0
    tant_que ($ln < longueur($fl) et $arret == 0) {
      si ($flb[$ln] != $bk) { $arret = 1 }
      sinon {
        joindre($outl, $fl[$ln])
        $ln = $ln + 1
      }
    }
    $bk = $bk + 1
  }
  joindre($outl, "}")
}


# ══════════════════ API du lecteur ══════════════════

# Avec registre de sources (noms[i] -> sources[i]) : aucun accès disque pour
# les imports, diagnostics d'import exacts, cycle-safe.
fn lire_programme_reg($chemin: chaine, $noms: liste<chaine>,
                      $sources: liste<chaine>) -> chaine {
  $err = [""]
  $src = ls_charger($chemin, $chemin, $noms, $sources, [""], 0, $err)
  si (longueur($err) > 1) { retour "ERR|" + $err[1] }
  $N = longueur($src)

$N = longueur($src)

# —— phase 1 : lexage vers $gen (types), $x (textes), $gl (lignes) ——
$gen = [""]
$x = [""]
$gl = [0]
$i = 0
$suiv = -1
$c = 0
$cc = 0
$ok = 1
$t = ""
$nx = 0
$q = 0
$buf = ""
$txt = ""
$nu = ""
$dollar = 0
$flott = 0
$point_ok = 0
$lnr = 1

$cles = table()
inserer($cles, "fn", 1)
inserer($cles, "retour", 1)
inserer($cles, "si", 1)
inserer($cles, "sinon", 1)
inserer($cles, "tant_que", 1)
inserer($cles, "pour", 1)
inserer($cles, "de", 1)
inserer($cles, "vers", 1)
inserer($cles, "vrai", 1)
inserer($cles, "faux", 1)
inserer($cles, "et", 1)
inserer($cles, "ou", 1)
inserer($cles, "non", 1)
inserer($cles, "div", 1)
inserer($cles, "entier", 1)
inserer($cles, "rationnel", 1)
inserer($cles, "flottant", 1)
inserer($cles, "booleen", 1)
inserer($cles, "chaine", 1)
inserer($cles, "liste", 1)
inserer($cles, "table", 1)

$dernier = "debut"

tant_que ($i < $N) {
  $c = ordre($src[$i])
  $suiv = -1
  si ($i + 1 < $N) { $suiv = ordre($src[$i + 1]) }
  $pchar = 10
  si ($i > 0) { $pchar = ordre($src[$i - 1]) }
  $apres = 0
  si ($dernier == "nombre" ou $dernier == "flottant" ou $dernier == "chaine" ou $dernier == "ident" ou $dernier == "mot" ou $dernier == "rparen" ou $dernier == "rbracket" ou $dernier == "multifacto" ou $dernier == "diese" ou $dernier == "terminal" ou $dernier == "superfacto" ou $dernier == "chapeau" ou $dernier == "deuxpts") { $apres = 1 }

  si ($c == 32 ou $c == 9 ou $c == 13 ou $c == 10) {
    si ($c == 10) { $lnr = $lnr + 1 }
    $i = $i + 1
  }
  sinon si ($c == 37 et $suiv == 37 et ($i == 0 ou $pchar == 10)) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1 }
    }
  }
  sinon si ($c == 35) {
    si ($apres == 1 et $i > 0 et $pchar != 32 et $pchar != 9 et $pchar != 13 et $pchar != 10) {
      joindre($gen, "diese")
      joindre($x, "#")
      joindre($gl, $lnr)
      $i = $i + 1
      $dernier = "diese"
    } sinon {
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 10) { $ok = 0 }
        sinon { $i = $i + 1 }
      }
    }
  }
  sinon si ($c == 47 et $suiv == 47) {
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (ordre($src[$i]) == 10) { $ok = 0 }
      sinon { $i = $i + 1 }
    }
  }
  sinon si ($c == 33) {
    si ($apres == 0) {
      joindre($gen, "sfact"); joindre($x, "!"); joindre($gl, $lnr); $i = $i + 1; $dernier = "sfact"
    } sinon si ($suiv == 61) {
      joindre($gen, "!="); joindre($x, "!="); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
    } sinon {
      $txt = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (ordre($src[$i]) == 33 et non ($i + 1 < $N et ordre($src[$i + 1]) == 61)) {
          $txt = $txt + "!"
          $i = $i + 1
        } sinon { $ok = 0 }
      }
      joindre($gen, "multifacto"); joindre($x, $txt); joindre($gl, $lnr); $dernier = "multifacto"
    }
  }
  sinon si ($c == 63) {
    si ($suiv == 61) {
      joindre($gen, "≈"); joindre($x, "?="); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
    } sinon {
      $est_debut = 0
      si ($pchar == 10 ou $pchar == 59 ou $pchar == 62 ou $i == 0) { $est_debut = 1 }
      $j = $i + 1
      $okq = 1
      tant_que ($okq == 1) {
        si ($j >= $N) { $okq = 0 }
        sinon si (ordre($src[$j]) == 32 ou ordre($src[$j]) == 9 ou ordre($src[$j]) == 13) { $j = $j + 1 }
        sinon { $okq = 0 }
      }
      $suit_paren = 0
      si ($j < $N et ordre($src[$j]) == 40) { $suit_paren = 1 }
      $ouvre_si = 0
      si ($est_debut == 1 et $suit_paren == 1) { $ouvre_si = 1 }
      si ($ouvre_si == 0) {
        joindre($gen, "terminal")
        joindre($x, "?")
      } sinon {
        joindre($gen, "?")
        joindre($x, "?")
      }
      joindre($gl, $lnr)
      $i = $i + 1
      $dernier = "autre"
    }
  }
  sinon si ($c == 34 ou $c == 39) {
    $q = $c
    $dl = $lnr
    $i = $i + 1
    $buf = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon {
        $cc = ordre($src[$i])
        si ($cc == 92) {
          si ($i + 1 >= $N) { $ok = 0 }
          sinon {
            $nx = ordre($src[$i + 1])
            si ($nx == 110) { $buf = $buf + "\n" }
            sinon si ($nx == 116) { $buf = $buf + "\t" }
            sinon si ($nx == 92 ou $nx == 34 ou $nx == 39) { $buf = $buf + sous_chaine($src, $i + 1, $i + 2) }
            sinon { $buf = $buf + "\\" + sous_chaine($src, $i + 1, $i + 2) }
            $i = $i + 2
          }
        }
        sinon si ($cc == $q) {
          $i = $i + 1
          $ok = 0
        }
        sinon {
          si ($cc == 10) { $lnr = $lnr + 1 }
          $buf = $buf + $src[$i]
          $i = $i + 1
        }
      }
    }
    joindre($gen, "chaine"); joindre($x, $buf); joindre($gl, $dl); $dernier = "chaine"
  }
  sinon si (est_chiffre($c)) {
    $txt = ""
    $flott = 0
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_chiffre(ordre($src[$i]))) {
        $txt = $txt + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    $point_ok = 0
    si ($i < $N) {
      si ($i + 1 < $N) {
        si (ordre($src[$i]) == 46 et est_chiffre(ordre($src[$i + 1]))) { $point_ok = 1 }
      }
    }
    si ($point_ok == 1) {
      $flott = 1
      $txt = $txt + "."
      $i = $i + 1
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (est_chiffre(ordre($src[$i]))) {
          $txt = $txt + $src[$i]
          $i = $i + 1
        }
        sinon { $ok = 0 }
      }
    }
    si ($flott == 1) { joindre($gen, "flottant"); $dernier = "flottant" }
    sinon { joindre($gen, "nombre"); $dernier = "nombre" }
    joindre($x, $txt)
    joindre($gl, $lnr)
  }
  sinon si ($c == 960) {
    joindre($gen, "mot"); joindre($x, "π"); joindre($gl, $lnr); $i = $i + 1; $dernier = "mot"
  }
  sinon si ($c == 966) {
    joindre($gen, "mot"); joindre($x, "φ"); joindre($gl, $lnr); $i = $i + 1; $dernier = "mot"
  }
  sinon si ($c == 36) {
    $est_var = 0
    si ($suiv != -1 et est_lettre($suiv)) { $est_var = 1 }
    si ($est_var == 0) {
      joindre($gen, "superfacto"); joindre($x, "$"); joindre($gl, $lnr); $i = $i + 1; $dernier = "superfacto"
    } sinon {
      $i = $i + 1
      $nu = ""
      $ok = 1
      tant_que ($ok == 1) {
        si ($i >= $N) { $ok = 0 }
        sinon si (est_suite(ordre($src[$i]))) {
          $nu = $nu + $src[$i]
          $i = $i + 1
        }
        sinon { $ok = 0 }
      }
      joindre($gen, "ident"); joindre($x, $nu); joindre($gl, $lnr); $dernier = "ident"
    }
  }
  sinon si (est_lettre($c)) {
    $nu = ""
    $ok = 1
    tant_que ($ok == 1) {
      si ($i >= $N) { $ok = 0 }
      sinon si (est_suite(ordre($src[$i]))) {
        $nu = $nu + $src[$i]
        $i = $i + 1
      }
      sinon { $ok = 0 }
    }
    si (cle_existe($cles, $nu)) { joindre($gen, "ident") } sinon { joindre($gen, "mot") }
    joindre($x, $nu)
    joindre($gl, $lnr)
    $dernier = "mot"
  }
  sinon si (paire($c, $suiv) != "") {
    joindre($gen, paire($c, $suiv)); joindre($x, sous_chaine($src, $i, $i + 2)); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre"
  }
  sinon si ($c == 62 et $suiv == 62) { joindre($gen, ">>"); joindre($x, ">>"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 60 et $suiv == 60) { joindre($gen, "<<"); joindre($x, "<<"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 45 et $suiv == 62) { joindre($gen, "->"); joindre($x, "->"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 61) { joindre($gen, "="); joindre($x, "="); joindre($gl, $lnr); $i = $i + 1; $dernier = "autre" }
  sinon si ($c == 58 et $suiv == 58) { joindre($gen, "::"); joindre($x, "::"); joindre($gl, $lnr); $i = $i + 2; $dernier = "autre" }
  sinon si ($c == 178) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "2"); joindre($gl, $lnr); $i = $i + 1; $dernier = "nombre" }
  sinon si ($c == 179) { joindre($gen, "^"); joindre($x, "^"); joindre($gl, $lnr); joindre($gen, "nombre"); joindre($x, "3"); joindre($gl, $lnr); $i = $i + 1; $dernier = "nombre" }
  sinon si (uni($c) != "") { joindre($gen, uni($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1; $dernier = "autre" }
  sinon si (car($c) != "") {
    joindre($gen, car($c)); joindre($x, $src[$i]); joindre($gl, $lnr); $i = $i + 1
    si ($c == 41) { $dernier = "rparen" }
    sinon si ($c == 93) { $dernier = "rbracket" }
    sinon si ($c == 94) { $dernier = "chapeau" }
    sinon si ($c == 58) { $dernier = "deuxpts" }
    sinon { $dernier = "autre" }
  }
  sinon { $i = $i + 1 }
}
joindre($gen, "eof")
joindre($x, "")
joindre($gl, $lnr)

# —— phase 2 : descente vers les pools ——
$k = [""]
$tx = [""]
$tf = [""]
$a = [-1]
$b = [-1]
$as = [0]
$ac = [0]
$lg = [0]
$al = [-1]

$ik = [""]
$ino = [""]
$ie = [-1]
$ie2 = [-1]
$ib1 = [""]
$ib2 = [""]
$ilg = [0]

$fnoms = [""]
$fext = [""]
$fparams = [""]
$fret = [""]
$fcorps = [""]
$fligne = [0]

$foi = [-1]
$fot = [""]
$fof = [""]
$err = [""]
$tni = [0]
$tnt = [""]
$tri = [0]
$trt = [""]

$topb = ""
$p = 1
$dll = ""
$son = ""
$sym = ""

tant_que (T0($gen, $p) != "eof") {
  $t = T0($gen, $p)
  si ($t == ";") { $p = $p + 1 }
  sinon si ($t == "@" et (EMOT($gen, $x, $p + 1, "dll") ou EMOT($gen, $x, $p + 1, "sym"))) {
    $genre = VX0($x, $p + 1)
    $q = $p + 2
    si (T0($gen, $q) == "(") { $q = $q + 1 }
    si (T0($gen, $q) == "chaine") {
      si ($genre == "dll") { $dll = VX0($x, $q) }
      sinon { $sym = VX0($x, $q) }
      $q = $q + 1
      si (T0($gen, $q) == ",") {
        $q = $q + 1
        $son = VX0($x, $q)
        $q = $q + 1
      }
    }
    si (T0($gen, $q) == ")") { $q = $q + 1 }
    $p = $q
  }
  sinon si (EMOT($gen, $x, $p, "fn")) {
    $r = def_fn($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $fnoms, $fext, $fparams, $fret, $fcorps, $fligne)
    $p = SEPR($r)
  }
  sinon {
    $r = instruction($gen, $x, $gl, $p, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                      $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg)
    $p = SEPR($r)
    si ($topb != "") { $topb = $topb + "," }
    $topb = $topb + NOD($r)
  }
}

$topb = rnat_flat($topb)
# —— tri des fonctions par nom (ordre std::map) ——
$ordre = [0]
$nn = longueur($fnoms)
$w = 1
tant_que ($w < $nn) {
  $best = -1
  $j = 1
  tant_que ($j < $nn) {
    $pris = 0
    $u = 1
    $no2 = longueur($ordre)
    tant_que ($u < $no2) {
      si ($ordre[$u] == $j) { $pris = 1 }
      $u = $u + 1
    }
    si ($pris == 0) {
      si ($best < 0) { $best = $j }
      sinon si (cmp_str($fnoms[$j], $fnoms[$best]) < 0) { $best = $j }
    }
    $j = $j + 1
  }
  joindre($ordre, $best)
  $w = $w + 1
}

# —— passe 1 : repli de constantes (fonctions triées, puis niveau supérieur) ——
$w = 1
tant_que ($w < longueur($ordre)) {
  $ix = $ordre[$w]
  si ($fext[$ix] == "" et longueur($err) == 1) {
    replier_chaine($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                   $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
  }
  $w = $w + 1
}
si (longueur($err) == 1) {
  replier_chaine($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                 $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg, $foi, $fot, $fof, $err)
}

# —— passe 2 : vérification ——
# pré-passe (miroir de verifier) : ne collecte que les affectations et lectures
# globales du niveau supérieur, pour que les corps de fonction les voient.
# On ne passe PAS par parcourir sur $topb entier : les boucles `pour` y
# enregistreraient leur compteur comme globale, ce que le moteur ne fait pas.
$gln = [""]
$glt = [""]
$topg = ""
$gp = 0
$gn2 = longueur($topb)
$gcur = ""
tant_que ($gp < $gn2) {
  $gc = ordre($topb[$gp])
  si ($gc == 44) {
    si ($gcur != "") {
      $gix = entier($gcur)
      si ($ik[$gix] == "affi" ou $ik[$gix] == "lire") {
        si ($topg != "") { $topg = $topg + "," }
        $topg = $topg + $gcur
      }
      $gcur = ""
    }
  } sinon { $gcur = $gcur + $topb[$gp] }
  $gp = $gp + 1
}
si ($gcur != "") {
  $gix = entier($gcur)
  si ($ik[$gix] == "affi" ou $ik[$gix] == "lire") {
    si ($topg != "") { $topg = $topg + "," }
    $topg = $topg + $gcur
  }
}
$topg = rnat_flat($topg)
$err2 = [""]
$tni2 = [0]
$tnt2 = [""]
$tri2 = [0]
$trt2 = [""]
$lc0 = [""]
$lct0 = [""]
si (longueur($err) == 1) {
  parcourir($topg, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
            $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
            $gln, $glt, $gln, $glt, $lc0, $lct0,
            $fnoms, $fparams, $fret, $foi, $fot, $fof, 0, "vide|vide", $err2, $tni2, $tnt2, $tri2, $trt2)
}
$w = 1
tant_que ($w < longueur($ordre)) {
  si (longueur($err) == 1) {
    $ix = $ordre[$w]
    si ($fext[$ix] != "") {
      $ps = $fparams[$ix]
      $np = nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = piece($ps, 59, $u)
        $pp = premier_pipe($ent)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        $bb = BASE($pt)
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          signaler($fligne[$ix], "Type " + nomty($pt) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
        $u = $u + 1
      }
      $bb = BASE($fret[$ix])
      si (longueur($err) == 1) {
        si ($bb != "entier" et $bb != "flottant" et $bb != "booleen" et $bb != "chaine") {
          signaler($fligne[$ix], "Type " + nomty($fret[$ix]) + " non supporté aux frontières d'une fonction externe (utilisez entier/flottant/booleen/chaine)", $err)
        }
      }
    }
    sinon {
      $lc = [""]
      $lct = [""]
      $ps = $fparams[$ix]
      $np = nb_pieces($ps, 59)
      $u = 1
      tant_que ($u <= $np) {
        $ent = piece($ps, 59, $u)
        $pp = premier_pipe($ent)
        $pn = sous_chaine($ent, 0, $pp)
        $pt = sous_chaine($ent, $pp + 1, longueur($ent))
        reserver($pn, 0, $err)
        env_put($pn, $pt, $lc, $lct)
        $u = $u + 1
      }
      parcourir($fcorps[$ix], $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                $lc, $lct, $gln, $glt, $lc, $lct,
                $fnoms, $fparams, $fret, $foi, $fot, $fof, 1, $fret[$ix], $err, $tni, $tnt, $tri, $trt)
    }
  }
  $w = $w + 1
}

# —— passe 2 (suite) : instructions de tête, environnement = globales ——
$lc = [""]
$lct = [""]
si (longueur($err) == 1) {
  parcourir($topb, $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
            $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
            $gln, $glt, $gln, $glt, $lc, $lct,
            $fnoms, $fparams, $fret, $foi, $fot, $fof, 0, "vide|vide", $err, $tni, $tnt, $tri, $trt)
}

# —— passe 3 : émission RIR (oracle « rose rir ») ——
# Fonctions triées (ordre std::map, externes sans corps), puis le niveau
# supérieur sous $principal ; compteurs %t et suffixes de bloc sans reprise.
$outl = [""]
joindre($outl, "rir")
# liste des fonctions à corps (RIR_CONNUS)
$connus = [""]
$w = 1
tant_que ($w < longueur($ordre)) {
  $ix = $ordre[$w]
  si ($fext[$ix] == "") { joindre($connus, $fnoms[$ix]) }
  $w = $w + 1
}
si (longueur($err) == 1) {
  $w = 1
  tant_que ($w < longueur($ordre)) {
    $ix = $ordre[$w]
    si ($fext[$ix] == "") {
      em_fonction_rir($fnoms[$ix], $fparams[$ix], $fret[$ix], $fcorps[$ix], faux,
                  $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
                  $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
                  $foi, $fot, $fof, $connus, $outl)
    } sinon {
      joindre($outl, "fonction " + $fnoms[$ix] + " (sans RIR)")
    }
    $w = $w + 1
  }
  em_fonction_rir("$principal", "", "vide|vide", $topb, vrai,
              $k, $tx, $tf, $a, $b, $as, $ac, $lg, $al,
              $ik, $ino, $ie, $ie2, $ib1, $ib2, $ilg,
              $foi, $fot, $fof, $connus, $outl)
}
si (longueur($err) > 1) { retour "ERR|" + $err[1] }
$ls_rir = $outl[1]
$ls_u = 2
tant_que ($ls_u < longueur($outl)) {
  $ls_rir = $ls_rir + "\n" + $outl[$ls_u]
  $ls_u = $ls_u + 1
}
retour "OK|" + $ls_rir

}

# Sans registre : lit le fichier demandé et ses imports depuis le disque.
fn lire_programme($chemin: chaine) -> chaine {
  $n = [""]
  $s = [""]
  retour lire_programme_reg($chemin, $n, $s)
}

# Exécution en ligne de commande : `rose lecteur_source.rose <fichier.rose>`.
# Sortie : "OK|<rir>" ou "ERR|<diagnostic>".
si (nb_arguments() > 0) {
  $r_ls = lire_programme(argument(0))
  >> $r_ls
}
