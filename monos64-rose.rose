# ═══════════════════════════════════════════════════════════════════════════
# ASSEMBLAGE DE L'IMAGE DISQUE (genere en Rose)
# ═══════════════════════════════════════════════════════════════════════════
$boot = liste_vers_chaine($boot_octets)
$kernel = liste_vers_chaine($kernel_octets)

$img = $boot
$cur = longueur($img)
tant_que ($cur < 512) { $img = $img + octet_brut(0); $cur = $cur + 1 }
$img = $img + $kernel

# Superblock MOSFS a LBA 64
$cur = longueur($img)
tant_que ($cur < 64*512) { $img = $img + octet_brut(0); $cur = $cur + 1 }
# "MOSFS1\0\0" + version1 + total2880 + root65 + root4 + data69
