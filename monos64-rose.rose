# monos64-rose.rose — PORT COMPLET DE MONOS64 EN ROSE
#
# Constat daté : 26/11/2026. Programme Rose qui regenere l'OS complet :
#   - bootloader (donnees Rose, 512 octets)
#   - noyau 32 bits (donnees Rose, 24430 octets)
#   - 43 applications MOSX (donnees Rose)
#   - systeme de fichiers MOSFS + image disque 1,44 Mo
#
# Tout est donnee Rose ; aucun fichier Zig n'est lu par le programme Rose.
# Les fichiers .rose de donnees sont concatenes ci-dessous (generation croisee).

fn octet_brut($v: entier) -> chaine { retour caractere($v % 256) }
fn octets_ajouter(l: liste<entier>, a: liste<entier>) -> liste<entier> {
  $r = [l[0]]
  $k = 1
  tant_que ($k < longueur(l)) { joindre($r, l[$k]); $k = $k + 1 }
  $j = 0
  tant_que ($j < longueur(a)) { joindre($r, a[$j]); $j = $j + 1 }
  retour $r
}
fn liste_vers_chaine(l: liste<entier>) -> chaine {
  $out = ""
  $i = 1
  tant_que ($i < longueur(l)) { $out = $out + octet_brut(l[$i]); $i = $i + 1 }
  retour $out
}

