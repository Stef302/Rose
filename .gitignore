# =============================================================================
# ROSE — .gitignore
# =============================================================================

# --- Artefacts lourds distribués (exclu du dépôt Git) -----------------------
Rose language.zip
*.zip

# --- Binaires compilés (C++, Rust, Zig, v2) ---------------------------------
bin/
*.exe
*.pdb
rose-cpp/rose-x64
rose-cpp/test_jit-x64
rose-cpp/rose-x64-qemu

# Binaires d'exécution sous moteur/ (conservés localement, non trackés)
rose-cpp/rose
rose-cpp/rose-win64.exe
rose-cpp/rose-win64.pdb
rose/rose-20

# --- Build artefacts --------------------------------------------------------
*.o
suite_bundle*
t_exact_bin
__pycache__/
*.pyc
*.pyo
target/
zig-out/
zig-cache/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
installateur/dist/
installateur/staging/

# l'installeur Windows est un livrable du site — il est versionné
!docs/*.exe

# --- Artefacts de banc et de couverture (ajoutés 28/10/2026) ----------------
# Aucun de ces fichiers n'est un livrable ; ils portent des chemins de build.
nohup.out
global_out.txt
gmon.out
programme.cpp
*.gcda
*.gcno
bench/englobant/.b_*
bench/global/bench_global_cpp
bench/global/bench_global_rs
bench/langages/mdp_mt19937
bench/langages/mdp_rand_c
bench/langages/mdp_rs
bench/langages/mdp_splitmix
bench/langages/mdp_philox

# --- Journaux de debug et de couverture (dé-suivis le 28/10/2026) -----------
# Les .pdb portaient 813/620/554 occurrences du chemin de build personnel ;
# les .gcda/.o/.obj sont des artefacts de compilation, jamais des livrables.
*.o
*.obj
*.gcda
*.gcno
*.pdb
rose_compiler.cpp
rose_interpreter.cpp
rose_compiler
rose_interpreter
rose_interpreter.cpp
rose-20
