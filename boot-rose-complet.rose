fn octets_ajouter(l: liste<entier>, a: liste<entier>) -> liste<entier> {
  $r = [l[0]]
  $k = 1
  tant_que ($k < longueur(l)) { joindre($r, l[$k]); $k = $k + 1 }
  $j = 0
  tant_que ($j < longueur(a)) { joindre($r, a[$j]); $j = $j + 1 }
  retour $r
}

# Ecriture
$out = ""
$i = 1
tant_que ($i < longueur($octets)) {
  $out = $out + octet_brut($octets[$i])
  $i = $i + 1
}
ecrire_bytes("/home/clausake/Stefan/monos/boot-rose.bin", $out)
afficher("boot-rose.bin : " + chaine(longueur($out)) + " octets (genere par Rose)")
