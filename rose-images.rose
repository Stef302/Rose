# rose-images.rose — GÉNÉRATEUR D'IMAGES PNG DE L'OS, EN ROSE PUR
#
# Constat daté : 26/11/2026. Ce programme Rose compose une image de l'OS
# (bannière + état des briques) et écrit un VRAI fichier PNG :
#   signature + IHDR + IDAT (zlib stocké) + IEND, via `ecrire_bytes`.
# Aucun outil externe, aucune dépendance Linux, aucun assembleur/linker.
# Les pixels sont stockés dans une `table` Rose mutée par `inserer`.

fn octet_brut($v: entier) -> chaine { retour caractere($v % 256) }

fn u16le(v: entier) -> chaine {
  $r = octet_brut(v % 256)
  $r = $r + octet_brut((v ÷ 256) % 256)
  retour $r
}

fn u32le(v: entier) -> chaine {
  $r = octet_brut(v % 256)
  $r = $r + octet_brut((v ÷ 256) % 256)
  $r = $r + octet_brut((v ÷ 65536) % 256)
  $r = $r + octet_brut((v ÷ 16777216) % 256)
  retour $r
}

# ── Police bitmap 5x7 : glyphe = chaîne de 35 bits, 7 lignes de 5 ───────────
fn glyphe_bits(c: chaine) -> chaine {
  si (c == "0") { retour "11111100011000110001100011000111111" }
  si (c == "1") { retour "00100011000010000100001000010011111" }
  si (c == "2") { retour "11111000010001100110011001100011111" }
  si (c == "3") { retour "11111000010011100001000011000111111" }
  si (c == "4") { retour "10001100011000111111000010000100001" }
  si (c == "5") { retour "11111100001111000001000011000111111" }
  si (c == "6") { retour "11111100001111010001100011000111111" }
  si (c == "7") { retour "11111000010001000100010001000010000" }
  si (c == "8") { retour "11111100011111110001100011000111111" }
  si (c == "9") { retour "11111100011111100001000111000101111" }
  si (c == "A") { retour "01110100011000111111100011000110001" }
  si (c == "B") { retour "11110100011111010001100011000111110" }
  si (c == "C") { retour "01111100001000010000100001000001111" }
  si (c == "D") { retour "11110100011000110001100011000111110" }
  si (c == "E") { retour "11111100001111010000100001000011111" }
  si (c == "F") { retour "11111100001111010000100001000010000" }
  si (c == "G") { retour "01111100001000010111100011000101111" }
  si (c == "H") { retour "10001100011111110001100011000110001" }
  si (c == "I") { retour "11111001000010000100001000010011111" }
  si (c == "J") { retour "11111000010000100001100011000101110" }
  si (c == "K") { retour "10001100101010011000101001001010001" }
  si (c == "L") { retour "10000100001000010000100001000011111" }
  si (c == "M") { retour "10001110111010110001100011000110001" }
  si (c == "N") { retour "10001110011010110011100011000110001" }
  si (c == "O") { retour "01110100011000110001100011000101110" }
  si (c == "P") { retour "11110100011111010000100001000010000" }
  si (c == "Q") { retour "01110100011000110001101011001001101" }
  si (c == "R") { retour "11110100011111010100100101000110001" }
  si (c == "S") { retour "01111100000111000001000011000101110" }
  si (c == "T") { retour "11111001000010000100001000010000100" }
  si (c == "U") { retour "10001100011000110001100011000101110" }
  si (c == "V") { retour "10001100011000110001010100101000100" }
  si (c == "W") { retour "10001100011000110101101011101110001" }
  si (c == "X") { retour "10001010100010001010100011000110001" }
  si (c == "Y") { retour "10001010100010000100001000010000100" }
  si (c == "Z") { retour "11111000010001000100010001000011111" }
  si (c == "-") { retour "00000000000000011111000000000000000" }
  si (c == ".") { retour "00000000000000000000000000010000100" }
  si (c == ":") { retour "00000000000010000000001000000000000" }
  si (c == ">") { retour "00000001000111011111011100010000000" }
  si (c == "%") { retour "11001110010001001010010101001110011" }
  si (c == "_") { retour "00000000000000000000000000000011111" }
  retour "00000000000000000000000000000000000"
}

fn glyphe(c: chaine, rang: entier) -> chaine {
  retour sous_chaine(glyphe_bits($c), $rang * 5, $rang * 5 + 5)
}

# ── Pixels : table mutée (clé = idx*3+composante) ───────────────────────────
fn setpix(t: table, x: entier, y: entier, r: entier, g: entier, b: entier, w: entier) -> entier {
  $idx = (y * $w + $x) * 3
  inserer(t, $idx, $r)
  inserer(t, $idx + 1, $g)
  inserer(t, $idx + 2, $b)
  retour 0
}

fn img_texte(t: table, x0: entier, y0: entier, s: chaine,
             r: entier, g: entier, b: entier, echelle: entier, w: entier) -> entier {
  $cx = $x0
  $n = longueur(s)
  $i = 0
  tant_que ($i < $n) {
    $c = sous_chaine(s, $i, $i + 1)
    $ligne = 0
    tant_que ($ligne < 7) {
      $motif = glyphe($c, $ligne)
      $col = 0
      tant_que ($col < 5) {
        $bit = sous_chaine($motif, $col, $col + 1)
        si ($bit == "1") {
          $dy = 0
          tant_que ($dy < $echelle) {
            $dx = 0
            tant_que ($dx < $echelle) {
              setpix(t, $cx + $col * $echelle + $dx, $cy0($y0, $ligne, $echelle, $dy),
                     $r, $g, $b, $w)
              $dx = $dx + 1
            }
            $dy = $dy + 1
          }
        }
        $col = $col + 1
      }
      $ligne = $ligne + 1
    }
    $cx = $cx + 6 * $echelle
    $i = $i + 1
  }
  retour 0
}

fn cy0(y0: entier, ligne: entier, echelle: entier, dy: entier) -> entier {
  retour $y0 + $ligne * $echelle + $dy
}

fn img_bordure(t: table, w: entier, h: entier, r: entier, g: entier, b: entier) -> entier {
  $x = 0
  tant_que ($x < $w) {
    setpix(t, $x, 0, $r, $g, $b, $w)
    setpix(t, $x, $h - 1, $r, $g, $b, $w)
    $x = $x + 1
  }
  $y = 0
  tant_que ($y < $h) {
    setpix(t, 0, $y, $r, $g, $b, $w)
    setpix(t, $w - 1, $y, $r, $g, $b, $w)
    $y = $y + 1
  }
  retour 0
}

fn img_bloc(t: table, x0: entier, y0: entier, bw: entier, bh: entier,
            r: entier, g: entier, b: entier, w: entier) -> entier {
  $y = 0
  tant_que ($y < $bh) {
    $x = 0
    tant_que ($x < $bw) {
      setpix(t, $x0 + $x, $y0 + $y, $r, $g, $b, $w)
      $x = $x + 1
    }
    $y = $y + 1
  }
  retour 0
}

# ── CRC32 (bit à bit, données Rose) ────────────────────────────────────────
fn crc32(octets: chaine) -> entier {
  $crc = 4294967295
  $n = longueur(octets)
  $i = 0
  tant_que ($i < $n) {
    $b = ordre(sous_chaine(octets, $i, $i + 1))
    $crc = $crc ^ $b
    $bit = 0
    tant_que ($bit < 8) {
      $bit0 = $crc % 2
      $crc = $crc ÷ 2
      si ($bit0 == 1) { $crc = $crc ^ 3988292384 }
      $bit = $bit + 1
    }
    $i = $i + 1
  }
  retour $crc ^ 4294967295
}

fn chunk(type: chaine, donnees: chaine) -> chaine {
  $r = u32le(longueur(donnees))
  $r = $r + type + donnees
  $r = $r + u32le(crc32(type + donnees))
  retour $r
}

# ── zlib "stored" (sans compression) ───────────────────────────────────────
fn zlib_stored(donnees: chaine) -> chaine {
  $r = octet_brut(120) + octet_brut(1)
  $n = longueur(donnees)
  $pos = 0
  tant_que ($pos < $n) {
    $reste = $n - $pos
    $taille = 65535
    si ($reste < $taille) { $taille = $reste }
    $final = 0
    si ($pos + $taille >= $n) { $final = 1 }
    $r = $r + octet_brut($final)
    $r = $r + u16le($taille)
    $r = $r + u16le(65535 - $taille)
    $k = 0
    tant_que ($k < $taille) {
      $r = $r + sous_chaine($donnees, $pos + $k, $pos + $k + 1)
      $k = $k + 1
    }
    $pos = $pos + $taille
  }
  $a = 1
  $b = 0
  $i = 0
  tant_que ($i < $n) {
    $v = ordre(sous_chaine(donnees, $i, $i + 1))
    $a = ($a + $v) % 65521
    $b = ($b + $a) % 65521
    $i = $i + 1
  }
  $r = $r + u32le($b * 65536 + $a)
  retour $r
}

# ── Écriture PNG ───────────────────────────────────────────────────────────
fn png_ecrire(chemin: chaine, t: table, w: entier, h: entier) -> entier {
  $raw = ""
  $y = 0
  tant_que ($y < $h) {
    $raw = $raw + octet_brut(0)
    $x = 0
    tant_que ($x < $w) {
      $idx = ($y * $w + $x) * 3
      $v = 0
      si (cle_existe(t, $idx)) { $v = t[$idx] }
      $raw = $raw + octet_brut($v)
      $idx2 = $idx + 1
      $v2 = 0
      si (cle_existe(t, $idx2)) { $v2 = t[$idx2] }
      $raw = $raw + octet_brut($v2)
      $idx3 = $idx + 2
      $v3 = 0
      si (cle_existe(t, $idx3)) { $v3 = t[$idx3] }
      $raw = $raw + octet_brut($v3)
      $x = $x + 1
    }
    $y = $y + 1
  }
  $ihdr = u32le($w) + u32le($h)
  $ihdr = $ihdr + octet_brut(8) + octet_brut(2) + octet_brut(0) + octet_brut(0) + octet_brut(0)
  $idat = zlib_stored($raw)
  $png = octet_brut(137) + "PNG"
  $png = $png + octet_brut(13) + octet_brut(10) + octet_brut(26) + octet_brut(10)
  $png = $png + chunk("IHDR", $ihdr)
  $png = $png + chunk("IDAT", $idat)
  $png = $png + chunk("IEND", "")
  ecrire_bytes($chemin, $png)
  retour longueur($png)
}

# ── Composition ────────────────────────────────────────────────────────────
$largeur = 256
$hauteur = 160
$pix = table()

img_bordure($pix, $largeur, $hauteur, 255, 105, 180)
img_texte($pix, 8, 8, "ROSE OS 1.0", 255, 255, 255, 1, $largeur)
img_texte($pix, 8, 22, "GENERE PAR ROSE", 255, 105, 180, 1, $largeur)
img_texte($pix, 8, 36, "INTERRUPTIONS MEMOIRE", 255, 255, 255, 1, $largeur)
img_texte($pix, 8, 50, "PILOTES ABI IMAGE PROFIL", 255, 255, 255, 1, $largeur)
img_texte($pix, 8, 64, "RUNTIME BACKEND QUBIT", 255, 255, 255, 1, $largeur)
img_texte($pix, 8, 78, "BOOTING FROM ROM..OK", 255, 255, 255, 1, $largeur)

img_texte($pix, 8, 96, "MEMOIRE 128P OK", 255, 105, 180, 1, $largeur)
img_bloc($pix, 8, 108, 240, 6, 0, 180, 0, $largeur)
img_texte($pix, 8, 118, "ORDONNANCEUR 4P OK", 255, 105, 180, 1, $largeur)
img_bloc($pix, 8, 130, 240, 6, 0, 180, 0, $largeur)
img_texte($pix, 8, 140, "", 255, 105, 180, 1, $largeur)




img_texte($pix, 8, 148, "> AIDE", 255, 255, 255, 1, $largeur)


$n = png_ecrire("/home/clausake/Stefan/monos/rose-os.png", $pix, $largeur, $hauteur)
afficher("rose-os.png ecrit : " + chaine($n) + " octets (" + chaine($largeur) + "x" + chaine($hauteur) + ")")
