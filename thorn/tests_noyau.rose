# ═══════════════════════════════════════════════════════════════════════════
# thorn/tests_noyau.rose — tests unitaires du noyau de Thorn.
# Lancer depuis la racine du dépôt : ./rose/rose thorn/tests_noyau.rose
# ═══════════════════════════════════════════════════════════════════════════

importer "thorn/src/noyau.rose"

# Les globals ne sont PAS visibles en écriture depuis une fonction Rose :
# le bilan voyage donc dans une table partagée (passée par référence).
$cpt = table()
inserer($cpt, "r", 0)
inserer($cpt, "e", 0)

fn incrementer(cpt: table, cle: chaine) {
  $v = 0
  $x = cpt[cle]
  $v = $x
  inserer(cpt, cle, $v + 1)
}

fn tester(cpt: table, nom: chaine, obtenu: chaine, attendu: chaine) {
  si (obtenu == attendu) {
    >> "✓ " + nom
    incrementer(cpt, "r")
  } sinon {
    >> "✗ " + nom + " : obtenu " + obtenu + ", attendu " + attendu
    incrementer(cpt, "e")
  }
}

fn montrer(t: table) -> chaine {
  $g = noy_genre(t)
  si ($g == "var") { retour noy_nom(t) }
  si ($g == "type") { retour "Type(" + chaine(noy_niveau(t)) + ")" }
  si ($g == "pi") {
    retour "Pi(" + noy_nom(t) + ":" + montrer(noy_champ(t, "domaine")) + "," +
           montrer(noy_champ(t, "codomaine")) + ")"
  }
  si ($g == "lam") {
    retour "Lam(" + noy_nom(t) + ":" + montrer(noy_champ(t, "domaine")) + "," +
           montrer(noy_champ(t, "corps")) + ")"
  }
  si ($g == "app") {
    retour "App(" + montrer(noy_champ(t, "fonction")) + "," +
           montrer(noy_champ(t, "argument")) + ")"
  }
  si ($g == "const") { retour "Const(" + noy_nom(t) + ")" }
  si ($g == "ind") { retour "Ind(" + noy_nom(t) + ")" }
  si ($g == "constructeur") { retour "Constr(" + noy_nom(t) + ")" }
  si ($g == "elim") { retour "Elim(" + noy_nom(t) + ")" }
  retour "?"
}

# Contexte : X : Type(0), a : X, y : X.
$ctx = noy_ctx_vide()
$ctx = noy_ctx_ajouter($ctx, "X", noy_type(0))
$ctxa = noy_ctx_ajouter($ctx, "a", noy_var("X"))
$ctxy = noy_ctx_ajouter($ctx, "y", noy_var("X"))

# ── 1. Identité λx:X. x : Πx:X. X ─────────────────────────────────────────
$id = noy_lam("x", noy_var("X"), noy_var("x"))
$rid = verifier($id, $ctx)
tester($cpt, "identite : acceptee", chaine(noy_est_ok($rid)), "vrai")
tester($cpt, "identite : type", montrer(noy_type_res($rid)), "Pi(x:X,X)")
tester($cpt, "identite : sans erreur", chaine(noy_erreur($rid) == ""), "vrai")
tester($cpt, "bien_forme identite", chaine(bien_forme($id, $ctx)), "vrai")

# ── 2. Application à un argument ────────────────────────────────────────────
$app = noy_app($id, noy_var("a"))
$rap = verifier($app, $ctxa)
tester($cpt, "app : acceptee", chaine(noy_est_ok($rap)), "vrai")
tester($cpt, "app : type", montrer(noy_type_res($rap)), "X")

# Application VÉRITABLEMENT dépendante :
# (λA:Type(0). λx:A. x) X  :  Πx:X. X
$dep = noy_app(noy_lam("A", noy_type(0),
                       noy_lam("x", noy_var("A"), noy_var("x"))),
               noy_var("X"))
$rdep = verifier($dep, $ctx)
tester($cpt, "app dependante : acceptee", chaine(noy_est_ok($rdep)), "vrai")
tester($cpt, "app dependante : type substitue", montrer(noy_type_res($rdep)), "Pi(x:X,X)")

# ── 3. Alpha-équivalence ───────────────────────────────────────────────────
$id_y = noy_lam("y", noy_var("X"), noy_var("y"))
$id_z = noy_lam("z", noy_var("X"), noy_var("z"))
$id_libre = noy_lam("y", noy_var("X"), noy_var("z"))
tester($cpt, "alpha : x == y", chaine(convertible($id, $id_y)), "vrai")
tester($cpt, "alpha : y == z", chaine(convertible($id_y, $id_z)), "vrai")
tester($cpt, "alpha : lieur != libre", chaine(convertible($id, $id_libre)), "faux")

$nest1 = noy_lam("x", noy_var("X"), noy_lam("y", noy_var("X"), noy_var("x")))
$nest2 = noy_lam("u", noy_var("X"), noy_lam("v", noy_var("X"), noy_var("u")))
$nest3 = noy_lam("u", noy_var("X"), noy_lam("v", noy_var("X"), noy_var("v")))
tester($cpt, "alpha imbrique : vrai", chaine(convertible($nest1, $nest2)), "vrai")
tester($cpt, "alpha imbrique : faux", chaine(convertible($nest1, $nest3)), "faux")

# ── 4. Capture-évitation ───────────────────────────────────────────────────
# Piège classique : (λx. λy. x) y  doit donner  λy'. y  et NON  λy. y.
$capt = noy_app($nest1, noy_var("y"))
$normal = beta($capt)
tester($cpt, "capture : resultat lam", noy_genre($normal), "lam")
tester($cpt, "capture : lieur renomme", chaine(noy_nom($normal) != "y"), "vrai")
tester($cpt, "capture : corps = y libre", montrer(noy_champ($normal, "corps")), "y")
$attendu = noy_lam("z", noy_var("X"), noy_var("y"))
tester($cpt, "capture : alpha attendu", chaine(convertible($normal, $attendu)), "vrai")
$piege = noy_lam("y", noy_var("X"), noy_var("y"))
tester($cpt, "capture : pas de capture", chaine(convertible($normal, $piege)), "faux")
$rcap = verifier($capt, $ctxy)
tester($cpt, "capture : verification ok", chaine(noy_est_ok($rcap)), "vrai")
tester($cpt, "capture : type", montrer(noy_type_res($rcap)), "Pi(y:X,X)")

# Substitution directe : shadowing et renommage.
$shadow = noy_subst($id, "x", noy_var("y"))
tester($cpt, "subst : lieur masque", montrer($shadow), "Lam(x:X,x)")
$renom = noy_subst(noy_lam("y", noy_var("X"), noy_var("x")), "x", noy_var("y"))
tester($cpt, "subst : renommage lieur", chaine(noy_nom($renom) != "y"), "vrai")
tester($cpt, "subst : renommage corps", montrer(noy_champ($renom, "corps")), "y")

# ── 5. Détection d'erreur ──────────────────────────────────────────────────
$mauvais = noy_app(noy_type(0), noy_var("X"))
$rm = verifier($mauvais, $ctx)
tester($cpt, "erreur : app d'un Type", chaine(noy_est_ok($rm)), "faux")
tester($cpt, "erreur : message present", chaine(noy_erreur($rm) != ""), "vrai")
$rvar = verifier(noy_var("inconnu"), $ctx)
tester($cpt, "erreur : variable non liee", chaine(noy_est_ok($rvar)), "faux")
$rmal = verifier(table(), $ctx)
tester($cpt, "erreur : terme mal forme", chaine(noy_est_ok($rmal)), "faux")
tester($cpt, "bien_forme : mal forme", chaine(bien_forme(table(), $ctx)), "faux")
$stuck = noy_app(noy_var("f"), noy_var("a"))
tester($cpt, "beta : terme bloque stable", montrer(beta($stuck)), "App(f,a)")

# ── 6. Univers et règle Pi ─────────────────────────────────────────────────
$rty = verifier(noy_type(0), $ctx)
tester($cpt, "Type(0) : Type(1)", montrer(noy_type_res($rty)), "Type(1)")
$pi2 = noy_pi("A", noy_type(0), noy_type(1))
$rpi = verifier($pi2, $ctx)
tester($cpt, "Pi(Type0,Type1) : Type(2)", montrer(noy_type_res($rpi)), "Type(2)")

# ── 7. Garde de pas (pas de boucle infinie) ────────────────────────────────
$omega = noy_app(noy_lam("x", noy_var("X"), noy_app(noy_var("x"), noy_var("x"))),
                 noy_lam("x", noy_var("X"), noy_app(noy_var("x"), noy_var("x"))))
$rom = noy_beta_lim($omega, 50)
tester($cpt, "garde : erreur explicite", chaine(noy_erreur_beta($rom) != ""), "vrai")
tester($cpt, "garde : borne respectee", chaine(noy_pas_beta($rom) <= 50), "vrai")

# ── 8. Contexte sous forme de table (interopérabilité) ─────────────────────
$ctab = table()
inserer($ctab, "X", noy_type(0))
$rtab = verifier(noy_var("X"), $ctab)
tester($cpt, "contexte table : accepte", chaine(noy_est_ok($rtab)), "vrai")
tester($cpt, "contexte table : type", montrer(noy_type_res($rtab)), "Type(0)")

# ── 9. Résultats structurés : codes, contexte, ligne ─────────────────────────
tester($cpt, "resultat : code OK", noy_code($rid), "OK")
tester($cpt, "resultat : champs presents",
       chaine(cle_existe($rid, "code") et cle_existe($rid, "contexte") et
              cle_existe($rid, "ligne") et cle_existe($rid, "pas")), "vrai")
$rv = verifier(noy_var("inconnu"), $ctx)
tester($cpt, "code : variable non liee", noy_code($rv), "VAR_NON_LIE")
tester($cpt, "contexte : variable non liee", noy_contexte($rv), "Var")
tester($cpt, "code : app d'un Type", noy_code($rm), "APP_PAS_PI")
tester($cpt, "contexte : app d'un Type", noy_contexte($rm), "App")
tester($cpt, "code : terme mal forme", noy_code($rmal), "GENRE_INCONNU")
tester($cpt, "code : accesseur def sur table vide",
       chaine(noy_code(table()) == "" et noy_contexte(table()) == ""), "vrai")

# Position de ligne OPTIONNELLE portée par le terme fautif.
$v_ligne = noy_var("inconnu")
inserer($v_ligne, "ligne", 42)
$rl = verifier($v_ligne, $ctx)
tester($cpt, "ligne : remontee dans Resultat", chaine(noy_ligne_res($rl)), "42")
tester($cpt, "ligne : absent = 0", chaine(noy_ligne_res($rv)), "0")

# ── 10. Garde de pas remontée dans verifier ─────────────────────────────────
$rlim = verifier_lim($id, $ctx, 0)
tester($cpt, "garde verifier : code GARDE_PAS", noy_code($rlim), "GARDE_PAS")
tester($cpt, "garde verifier : contexte", noy_contexte($rlim), "synthese")
tester($cpt, "garde verifier : message", chaine(noy_erreur($rlim) != ""), "vrai")
$ru = noy_univers_res($omega, 5)
tester($cpt, "garde univers : erreur remontee", chaine(noy_erreur($ru) != ""), "vrai")
tester($cpt, "garde univers : code", noy_code($ru), "GARDE_PAS")
tester($cpt, "garde univers : pas bornes", chaine(noy_pas_res($ru) <= 5), "vrai")
$rcv = noy_convertible_res($omega, $omega, 5)
tester($cpt, "garde conversion : erreur remontee", chaine(noy_erreur($rcv) != ""), "vrai")
tester($cpt, "garde conversion : code", noy_code($rcv), "GARDE_PAS")

# ── 11. Cumulativité contrôlée Type(i) ≤ Type(j) si i ≤ j ───────────────────
tester($cpt, "cumul : strict Type0 != Type1",
       chaine(convertible(noy_type(0), noy_type(1))), "faux")
tester($cpt, "cumul : Type0 <= Type1", chaine(cumulatif(noy_type(0), noy_type(1))), "vrai")
tester($cpt, "cumul : Type1 <= Type0 refuse", chaine(cumulatif(noy_type(1), noy_type(0))), "faux")
tester($cpt, "cumul : Type2 <= Type2", chaine(cumulatif(noy_type(2), noy_type(2))), "vrai")
$appcum = noy_app(noy_lam("A", noy_type(1), noy_var("A")), noy_var("X"))
$rcum = verifier($appcum, $ctx)
tester($cpt, "cumul : application acceptee", chaine(noy_est_ok($rcum)), "vrai")
tester($cpt, "cumul : type substitue", montrer(noy_type_res($rcum)), "Type(1)")
tester($cpt, "cumul : code OK", noy_code($rcum), "OK")
$big = noy_const("Big", noy_type(1))
$appbad = noy_app(noy_lam("A", noy_type(0), noy_var("A")), $big)
$rbad = verifier($appbad, $ctx)
tester($cpt, "cumul : descente interdite", chaine(noy_est_ok($rbad)), "faux")
tester($cpt, "cumul : code CUMUL", noy_code($rbad), "CUMUL")
$dom_non = noy_const("n", noy_var("X"))
$pi_bad = noy_pi("z", $dom_non, noy_type(0))
$rpi_bad = verifier($pi_bad, $ctx)
tester($cpt, "niveau Pi : domaine non univers refuse", chaine(noy_est_ok($rpi_bad)), "faux")
tester($cpt, "niveau Pi : code UNIVERS", noy_code($rpi_bad), "UNIVERS")
tester($cpt, "niveau Pi : contexte", noy_contexte($rpi_bad), "Pi/domaine")

# ── 12. Eq typé : a et b doivent avoir le même type ─────────────────────────
$ctxay = noy_ctx_ajouter($ctxa, "y", noy_var("X"))
$eq_ok = noy_ind("=", [table(), noy_var("a"), noy_var("y")])
$req = verifier($eq_ok, $ctxay)
tester($cpt, "eq : meme type accepte", chaine(noy_est_ok($req)), "vrai")
tester($cpt, "eq : type rendu", montrer(noy_type_res($req)), "Type(0)")
$eq_bad = noy_ind("=", [table(), noy_var("a"), noy_type(0)])
$reqb = verifier($eq_bad, $ctxay)
tester($cpt, "eq : types differents refuses", chaine(noy_est_ok($reqb)), "faux")
tester($cpt, "eq : code EQ_MAL_TYPE", noy_code($reqb), "EQ_MAL_TYPE")
tester($cpt, "eq : contexte", noy_contexte($reqb), "ind(=)")
$eq3_ok = noy_ind("Eq", [table(), noy_var("X"), noy_var("a"), noy_var("y")])
$req3 = verifier($eq3_ok, $ctxay)
tester($cpt, "eq3 : a,b : X accepte", chaine(noy_est_ok($req3)), "vrai")
$eq3_bad = noy_ind("Eq", [table(), noy_var("X"), noy_var("a"), noy_type(0)])
$req3b = verifier($eq3_bad, $ctxay)
tester($cpt, "eq3 : second membre hors de X", chaine(noy_est_ok($req3b)), "faux")
tester($cpt, "eq3 : code EQ_MAL_TYPE", noy_code($req3b), "EQ_MAL_TYPE")
tester($cpt, "eq3 : contexte b", noy_contexte($req3b), "ind(Eq)/b")

# ── 13. ι-réduction réelle : motifs zero / succ ─────────────────────────────
fn natT() -> table { retour noy_ind("Nat", [table()]) }
fn zeroT() -> table { retour noy_const("zero", natT()) }
fn succSymb() -> table { retour noy_const("succ", noy_pi("n", natT(), natT())) }
fn succT(n: table) -> table { retour noy_app(succSymb(), n) }
fn plusSymb() -> table {
  retour noy_const("plus", noy_pi("m", natT(), noy_pi("n", natT(), natT())))
}
fn plusT(m: table, n: table) -> table { retour noy_app(noy_app(plusSymb(), m), n) }
fn natrecSymb() -> table {
  $P = noy_pi("m", natT(), noy_type(0))
  $base = noy_app(noy_var("P"), zeroT())
  $pas = noy_pi("n", natT(), noy_pi("ih", noy_app(noy_var("P"), noy_var("n")),
                                    noy_app(noy_var("P"), succT(noy_var("n")))))
  $ty = noy_pi("P", $P, noy_pi("base", $base, noy_pi("pas", $pas,
        noy_pi("m", natT(), noy_app(noy_var("P"), noy_var("m"))))))
  retour noy_const("nat_rec", $ty)
}
fn natrecT(P: table, base: table, pas: table, m: table) -> table {
  retour noy_app(noy_app(noy_app(noy_app(natrecSymb(), P), base), pas), m)
}
$natctx = noy_ctx_ajouter($ctx, "n", natT())

tester($cpt, "iota : plus zero n = n",
       montrer(beta(plusT(zeroT(), noy_var("n")))), "n")
tester($cpt, "iota : plus (succ zero) n = succ n",
       montrer(beta(plusT(succT(zeroT()), noy_var("n")))), "App(Const(succ),n)")
tester($cpt, "iota : plus (succ (succ zero)) zero",
       montrer(beta(plusT(succT(succT(zeroT())), zeroT()))),
       "App(Const(succ),App(Const(succ),Const(zero)))")
$bp = noy_beta_lim(plusT(succT(zeroT()), noy_var("n")), 100)
tester($cpt, "iota : pas comptes", chaine(noy_pas_beta($bp)), "2")

$Pnat = noy_lam("m", natT(), natT())
$base0 = zeroT()
$pasS = noy_lam("n", natT(), noy_lam("ih", natT(), succT(noy_var("ih"))))
tester($cpt, "iota : nat_rec zero = base",
       montrer(beta(natrecT($Pnat, $base0, $pasS, zeroT()))), "Const(zero)")
tester($cpt, "iota : nat_rec (succ zero) = pas 0 base",
       montrer(beta(natrecT($Pnat, $base0, $pasS, succT(zeroT())))),
       "App(Const(succ),Const(zero))")

# Un const quelconque nommé « plus » mais MAL typé ne doit jamais se réduire.
$fauxplus = noy_const("plus", noy_type(0))
$fauxapp = noy_app(noy_app($fauxplus, zeroT()), zeroT())
tester($cpt, "iota : garde-fou type du const",
       montrer(beta($fauxapp)), "App(App(Const(plus),Const(zero)),Const(zero))")
$fauxplus2 = noy_const("plus", noy_pi("m", natT(), noy_pi("n", natT(), noy_type(0))))
$fauxapp2 = noy_app(noy_app($fauxplus2, zeroT()), zeroT())
tester($cpt, "iota : garde-fou codomaine",
       montrer(beta($fauxapp2)), "App(App(Const(plus),Const(zero)),Const(zero))")

# Préservation du type : les termes calculés restent vérifiés par le noyau.
$rplus = verifier(plusT(zeroT(), noy_var("n")), $natctx)
tester($cpt, "iota : plus zero n verifie", chaine(noy_est_ok($rplus)), "vrai")
tester($cpt, "iota : type Nat", montrer(noy_type_res($rplus)), "Ind(Nat)")
tester($cpt, "iota : convertible a n",
       chaine(convertible(plusT(zeroT(), noy_var("n")), noy_var("n"))), "vrai")
tester($cpt, "iota : equation succ convertible",
       chaine(convertible(plusT(succT(noy_var("m")), noy_var("n")),
                          succT(plusT(noy_var("m"), noy_var("n"))))), "vrai")
$rrec = verifier(natrecT($Pnat, $base0, $pasS, zeroT()), $natctx)
tester($cpt, "iota : nat_rec verifie", chaine(noy_est_ok($rrec)), "vrai")
tester($cpt, "iota : nat_rec type P(zero)", montrer(noy_type_res($rrec)), "Ind(Nat)")

# ── 14. Second inductif : Bool, not, bool_rec (contrôle de structure) ───────
fn boolT() -> table { retour noy_ind("Bool", [table()]) }
fn trueT() -> table { retour noy_const("true", boolT()) }
fn falseT() -> table { retour noy_const("false", boolT()) }
fn notSymb() -> table { retour noy_const("not", noy_pi("b", boolT(), boolT())) }
fn notT(b: table) -> table { retour noy_app(notSymb(), b) }
fn boolrecSymb() -> table {
  $P = noy_pi("b", boolT(), noy_type(0))
  $t = noy_app(noy_var("P"), trueT())
  $f = noy_app(noy_var("P"), falseT())
  $ty = noy_pi("P", $P, noy_pi("t", $t, noy_pi("f", $f,
         noy_pi("b", boolT(), noy_app(noy_var("P"), noy_var("b"))))))
  retour noy_const("bool_rec", $ty)
}
fn boolrecT(P: table, t: table, f: table, b: table) -> table {
  retour noy_app(noy_app(noy_app(noy_app(boolrecSymb(), P), t), f), b)
}
$motiveB = noy_lam("b", boolT(), natT())
$brVrai = zeroT()
$brFaux = succT(zeroT())

# ι de bool_rec : les deux branches.
tester($cpt, "bool : rec true = branche vrai",
       montrer(beta(boolrecT($motiveB, $brVrai, $brFaux, trueT()))), "Const(zero)")
tester($cpt, "bool : rec false = branche faux",
       montrer(beta(boolrecT($motiveB, $brVrai, $brFaux, falseT()))),
       "App(Const(succ),Const(zero))")
$br1 = noy_beta_lim(boolrecT($motiveB, $brVrai, $brFaux, trueT()), 100)
tester($cpt, "bool : rec un pas", chaine(noy_pas_beta($br1)), "1")
$br2 = noy_beta_lim(boolrecT($motiveB, $brVrai, $brFaux, falseT()), 100)
tester($cpt, "bool : rec faux un pas", chaine(noy_pas_beta($br2)), "1")

# ι de not, et imbrication.
tester($cpt, "bool : not true = false", montrer(beta(notT(trueT()))), "Const(false)")
tester($cpt, "bool : not false = true", montrer(beta(notT(falseT()))), "Const(true)")
$bn1 = noy_beta_lim(notT(trueT()), 100)
tester($cpt, "bool : not un pas", chaine(noy_pas_beta($bn1)), "1")
tester($cpt, "bool : not imbrique", montrer(beta(notT(notT(trueT())))), "Const(true)")
$bn2 = noy_beta_lim(notT(notT(trueT())), 100)
tester($cpt, "bool : not imbrique deux pas", chaine(noy_pas_beta($bn2)), "2")

# Conversion définitionnelle (βι + α) et réduction sous un lieur.
tester($cpt, "bool : rec true convertible",
       chaine(convertible(boolrecT($motiveB, $brVrai, $brFaux, trueT()), $brVrai)), "vrai")
tester($cpt, "bool : rec false convertible",
       chaine(convertible(boolrecT($motiveB, $brVrai, $brFaux, falseT()), $brFaux)), "vrai")
tester($cpt, "bool : not convertible", chaine(convertible(notT(trueT()), falseT())), "vrai")
$sousB = noy_lam("z", boolT(), boolrecT($motiveB, $brVrai, $brFaux, trueT()))
tester($cpt, "bool : reduction sous lambda", montrer(noy_champ(beta($sousB), "corps")),
       "Const(zero)")
$melange = boolrecT($motiveB, $brVrai, $brFaux, notT(falseT()))
tester($cpt, "bool : melange not/rec", montrer(beta($melange)), "Const(zero)")
$bmel = noy_beta_lim($melange, 100)
tester($cpt, "bool : melange deux pas", chaine(noy_pas_beta($bmel)), "2")

# Garde-fous : nom seul ne suffit pas, l'annotation doit avoir la bonne structure.
$fauxrec = noy_const("bool_rec", noy_type(0))
$fauxrecapp = noy_app(noy_app(noy_app(noy_app($fauxrec, $motiveB), $brVrai), $brFaux), trueT())
$grec = noy_beta_lim($fauxrecapp, 100)
tester($cpt, "bool : garde rec mal type", chaine(noy_pas_beta($grec)), "0")
$fauxnot = noy_const("not", noy_type(0))
$gnot = noy_beta_lim(noy_app($fauxnot, trueT()), 100)
tester($cpt, "bool : garde not mal type", chaine(noy_pas_beta($gnot)), "0")
$fauxtrue = noy_const("true", natT())
$gtrue = noy_beta_lim(boolrecT($motiveB, $brVrai, $brFaux, $fauxtrue), 100)
tester($cpt, "bool : garde true mal note", chaine(noy_pas_beta($gtrue)), "0")

# Scrutinee non constructeur : bloqué (correct), mais le terme reste vérifiable.
$ctxb = noy_ctx_ajouter($ctx, "b", boolT())
$bvar = boolrecT($motiveB, $brVrai, $brFaux, noy_var("b"))
$gbv = noy_beta_lim($bvar, 100)
tester($cpt, "bool : variable bloque", chaine(noy_pas_beta($gbv)), "0")
$rvb = verifier($bvar, $ctxb)
tester($cpt, "bool : variable verifiee", chaine(noy_est_ok($rvb)), "vrai")
tester($cpt, "bool : variable type Nat", montrer(noy_type_res($rvb)), "Ind(Nat)")

# Préservation du type par le noyau (le terme réduit et l'original ont le même type).
$rv1 = verifier(boolrecT($motiveB, $brVrai, $brFaux, trueT()), $ctx)
tester($cpt, "bool : rec true verifie", chaine(noy_est_ok($rv1)), "vrai")
tester($cpt, "bool : rec true type Nat", montrer(noy_type_res($rv1)), "Ind(Nat)")
$rv2 = verifier(boolrecT($motiveB, $brVrai, $brFaux, falseT()), $ctx)
tester($cpt, "bool : rec false verifie", chaine(noy_est_ok($rv2)), "vrai")
tester($cpt, "bool : rec false type Nat", montrer(noy_type_res($rv2)), "Ind(Nat)")
$rv3 = verifier(notT(trueT()), $ctx)
tester($cpt, "bool : not verifie", chaine(noy_est_ok($rv3)), "vrai")
tester($cpt, "bool : not type Bool", montrer(noy_type_res($rv3)), "Ind(Bool)")
$rv4 = verifier(boolrecSymb(), $ctx)
tester($cpt, "bool : elimininateur bien forme", chaine(noy_est_ok($rv4)), "vrai")
$rv5 = verifier(trueT(), $ctx)
tester($cpt, "bool : true bien forme", chaine(noy_est_ok($rv5)), "vrai")
tester($cpt, "bool : true type Bool", montrer(noy_type_res($rv5)), "Ind(Bool)")

# Contrôle de structure : prédicats exposés, testés directement.
tester($cpt, "bool : structure rec valide",
       chaine(noy_bool_rec_valide(noy_champ(boolrecSymb(), "type"))), "vrai")
tester($cpt, "bool : structure rec invalide",
       chaine(noy_bool_rec_valide(noy_type(0))), "faux")
tester($cpt, "bool : motif Bool valide",
       chaine(noy_est_motive_bool(noy_pi("b", boolT(), noy_type(0)))), "vrai")
tester($cpt, "bool : motif Nat refuse",
       chaine(noy_est_motive_bool(noy_pi("b", natT(), noy_type(0)))), "faux")
tester($cpt, "bool : structure not valide",
       chaine(noy_not_valide(noy_champ(notSymb(), "type"))), "vrai")
tester($cpt, "bool : structure not invalide",
       chaine(noy_not_valide(noy_type(0))), "faux")
tester($cpt, "bool : constructeur true reconnu", chaine(noy_est_true(trueT())), "vrai")
tester($cpt, "bool : faux true rejete",
       chaine(noy_est_true(noy_const("true", natT()))), "faux")

>> "REUSSIS=" + chaine($cpt["r"])
>> "ECHOUES=" + chaine($cpt["e"])
si ($cpt["e"] == 0) { >> "RESULTAT: OK" } sinon { >> "RESULTAT: ECHEC" }
