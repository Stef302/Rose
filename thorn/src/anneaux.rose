                 noy_lam("a",$an_A,$an_corps))
}
fn an_lem_neg_inj(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_h = noy_var("h")
  $an_nn = an_loi_nom("neg_neg",an_s)
  $an_x1 = $an_a
  $an_x2 = an_neg(an_s,an_neg(an_s,$an_a))
  $an_x3 = an_neg(an_s,an_neg(an_s,$an_b))
  $an_h1 = an_sy($an_A,$an_x2,$an_a,ta_ap1($an_nn,$an_a))
  $an_h2 = an_c1($an_A,an_neg_de(an_s),an_neg(an_s,$an_a),an_neg(an_s,$an_b),$an_h)
  $an_h3 = ta_ap1($an_nn,$an_b)
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_b,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_b,$an_h2,$an_h3))
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,
            noy_pi("h",an_eq($an_A,an_neg(an_s,$an_a),an_neg(an_s,$an_b)),an_eq($an_A,$an_a,$an_b))))
  $an_hty = an_eq($an_A,an_neg(an_s,$an_a),an_neg(an_s,$an_b))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("h",$an_hty,$an_corps))))
}
fn an_lem_neg_add(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_x = an_plus(an_s,an_neg(an_s,$an_a),an_neg(an_s,$an_b))
  $an_cxl = an_loi_nom("add_left_comm",an_s)
  # x + (a+b) = ((x+a)+b) = ((-a)+(-b)+a)+b = ((-a)+(a+(-b)))+b
  $an_xa1 = an_plus(an_s,$an_x,$an_a)
  $an_xa2 = an_plus(an_s,an_neg(an_s,$an_a),an_plus(an_s,an_neg(an_s,$an_b),$an_a))
  $an_xa3 = an_plus(an_s,an_neg(an_s,$an_a),an_plus(an_s,$an_a,an_neg(an_s,$an_b)))
  $an_xa4 = an_plus(an_s,an_plus(an_s,an_neg(an_s,$an_a),$an_a),an_neg(an_s,$an_b))
  $an_xa5 = an_plus(an_s,an_zero(an_s),an_neg(an_s,$an_b))
  $an_e1 = an_Laa(an_s,$an_x,$an_a,$an_b)
  $an_e2 = an_Laa(an_s,an_neg(an_s,$an_a),an_neg(an_s,$an_b),$an_a)
  $an_e3 = an_cg($an_A,an_add_de(an_s),an_neg(an_s,$an_a),
                  an_plus(an_s,an_neg(an_s,$an_b),$an_a),
                  an_plus(an_s,$an_a,an_neg(an_s,$an_b)),an_Lac(an_s,an_neg(an_s,$an_b),$an_a))
  $an_e4 = an_sy($an_A,$an_xa4,an_plus(an_s,an_neg(an_s,$an_a),an_plus(an_s,$an_a,an_neg(an_s,$an_b))),
                 an_Laa(an_s,an_neg(an_s,$an_a),$an_a,an_neg(an_s,$an_b)))
  $an_e5 = an_cd($an_A,an_add_de(an_s),an_neg(an_s,$an_b),an_plus(an_s,an_neg(an_s,$an_a),$an_a),an_zero(an_s),an_Linv_l(an_s,$an_a))
  $an_e6 = an_Lazl(an_s,an_neg(an_s,$an_b))
  $an_xaa = an_tr($an_A,$an_xa1,$an_xa2,$an_xa5,$an_e2,
             an_tr($an_A,$an_xa2,$an_xa3,$an_xa5,$an_e3,
             an_tr($an_A,$an_xa3,$an_xa4,$an_xa5,$an_e4,$an_e5)))
  $an_hx1 = an_plus(an_s,$an_x,an_plus(an_s,$an_a,$an_b))
  $an_hx2 = an_plus(an_s,$an_xa1,$an_b)
  $an_hx3 = an_plus(an_s,$an_xa5,$an_b)
  $an_hx4 = an_plus(an_s,an_neg(an_s,$an_b),$an_b)
  $an_h1 = an_sy($an_A,$an_hx2,$an_hx1,$an_e1)
  $an_h2 = an_cd($an_A,an_add_de(an_s),$an_b,$an_xa1,$an_xa5,an_xaa)
  $an_hx = an_tr($an_A,$an_hx1,$an_hx2,an_zero(an_s),$an_h1,
            an_tr($an_A,$an_hx2,$an_hx3,an_zero(an_s),$an_h2,
            an_tr($an_A,$an_hx3,$an_hx4,an_zero(an_s),
                  an_cd($an_A,an_add_de(an_s),$an_b,an_plus(an_s,an_zero(an_s),an_neg(an_s,$an_b)),an_neg(an_s,$an_b),an_Lazl(an_s,an_neg(an_s,$an_b))),
                  an_Linv_l(an_s,$an_b))))
  $an_u = an_loi_nom("neg_unique",an_s)
  $an_corps = an_sy($an_A,$an_x,an_neg(an_s,an_plus(an_s,$an_a,$an_b)),ta_ap3($an_u,an_plus(an_s,$an_a,$an_b),$an_x,$an_hx))
  retour an_pair(an_pi2($an_A,an_eq($an_A,an_neg(an_s,an_plus(an_s,$an_a,$an_b)),$an_x)),an_lam2($an_A,$an_corps))
}
fn an_lem_add_left_cancel(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_h = noy_var("h")
  $an_negadd = an_loi_nom("neg_add_cancel_l",an_s)
  $an_x1 = $an_b
  $an_x2 = an_plus(an_s,an_neg(an_s,$an_a),an_plus(an_s,$an_a,$an_b))
  $an_x3 = an_plus(an_s,an_neg(an_s,$an_a),an_plus(an_s,$an_a,$an_c))
  $an_h1 = an_sy($an_A,$an_x2,$an_b,ta_ap2($an_negadd,$an_a,$an_b))
  $an_h2 = an_cg($an_A,an_add_de(an_s),an_neg(an_s,$an_a),an_plus(an_s,$an_a,$an_b),an_plus(an_s,$an_a,$an_c),$an_h)
  $an_h3 = ta_ap2($an_negadd,$an_a,$an_c)
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_c,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_c,$an_h2,$an_h3))
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("c",$an_A,
            noy_pi("h",an_eq($an_A,an_plus(an_s,$an_a,$an_b),an_plus(an_s,$an_a,$an_c)),an_eq($an_A,$an_b,$an_c)))))
  $an_hty = an_eq($an_A,an_plus(an_s,$an_a,$an_b),an_plus(an_s,$an_a,$an_c))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("c",$an_A,noy_lam("h",$an_hty,$an_corps)))))
}
fn an_lem_add_right_cancel(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_h = noy_var("h")
  $an_lc = an_loi_nom("add_left_cancel",an_s)
  $an_hty = an_eq($an_A,an_plus(an_s,$an_b,$an_a),an_plus(an_s,$an_c,$an_a))
  $an_hab = an_plus(an_s,$an_a,$an_b)
  $an_hba = an_plus(an_s,$an_b,$an_a)
  $an_hca = an_plus(an_s,$an_c,$an_a)
  $an_hac = an_plus(an_s,$an_a,$an_c)
  $an_habac = an_tr($an_A,$an_hab,$an_hba,$an_hac,
               an_sy($an_A,$an_hba,$an_hab,an_Lac(an_s,$an_b,$an_a)),
               an_tr($an_A,$an_hba,$an_hca,$an_hac,$an_h,an_Lac(an_s,$an_c,$an_a)))
  $an_corps = ta_ap4($an_lc,$an_a,$an_b,$an_c,$an_habac)
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("c",$an_A,noy_pi("h",$an_hty,an_eq($an_A,$an_b,$an_c)))))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("c",$an_A,noy_lam("h",$an_hty,$an_corps)))))
}

fn an_lem_eq_neg_of_add_eq_zero(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_h = noy_var("h")
  $an_u = an_loi_nom("neg_unique",an_s)
  $an_corps = ta_ap3($an_u,$an_b,$an_a,$an_h)
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,
            noy_pi("h",an_eq($an_A,an_plus(an_s,$an_a,$an_b),an_zero(an_s)),
                   an_eq($an_A,$an_a,an_neg(an_s,$an_b)))))
  $an_hty = an_eq($an_A,an_plus(an_s,$an_a,$an_b),an_zero(an_s))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("h",$an_hty,$an_corps))))
