}
fn an_lem_mul_left_comm(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_x1 = an_mul(an_s,$an_a,an_mul(an_s,$an_b,$an_c))
  $an_x2 = an_mul(an_s,an_mul(an_s,$an_a,$an_b),$an_c)
  $an_x3 = an_mul(an_s,an_mul(an_s,$an_b,$an_a),$an_c)
  $an_x4 = an_mul(an_s,$an_b,an_mul(an_s,$an_a,$an_c))
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Lma(an_s,$an_a,$an_b,$an_c))
  $an_h2 = an_cd($an_A,an_mul_de(an_s),$an_c,an_mul(an_s,$an_a,$an_b),an_mul(an_s,$an_b,$an_a),an_Lmc(an_s,$an_a,$an_b))
  $an_h3 = an_Lma(an_s,$an_b,$an_a,$an_c)
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x4,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_x4,$an_h2,$an_h3))
  retour an_pair(an_pi3($an_A,an_eq($an_A,$an_x1,$an_x4)),an_lam3($an_A,$an_corps))
}
fn an_lem_mul_right_comm(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_x1 = an_mul(an_s,an_mul(an_s,$an_a,$an_b),$an_c)
  $an_x2 = an_mul(an_s,$an_a,an_mul(an_s,$an_b,$an_c))
  $an_x3 = an_mul(an_s,$an_a,an_mul(an_s,$an_c,$an_b))
  $an_x4 = an_mul(an_s,an_mul(an_s,$an_a,$an_c),$an_b)
  $an_h1 = an_Lma(an_s,$an_a,$an_b,$an_c)
  $an_h2 = an_cg($an_A,an_mul_de(an_s),$an_a,an_mul(an_s,$an_b,$an_c),an_mul(an_s,$an_c,$an_b),an_Lmc(an_s,$an_b,$an_c))
  $an_h3 = an_sy($an_A,$an_x4,$an_x3,an_Lma(an_s,$an_a,$an_c,$an_b))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x4,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_x4,$an_h2,$an_h3))
  retour an_pair(an_pi3($an_A,an_eq($an_A,$an_x1,$an_x4)),an_lam3($an_A,$an_corps))
}
fn an_lem_mul_perm4(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_d = noy_var("d")
  $an_rc = an_loi_nom("mul_right_comm",an_s)
  $an_x1 = an_mul(an_s,an_mul(an_s,$an_a,$an_b),an_mul(an_s,$an_c,$an_d))
  $an_x2 = an_mul(an_s,an_mul(an_s,an_mul(an_s,$an_a,$an_b),$an_c),$an_d)
  $an_x3 = an_mul(an_s,an_mul(an_s,an_mul(an_s,$an_a,$an_c),$an_b),$an_d)
  $an_x4 = an_mul(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_b,$an_d))
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Lma(an_s,an_mul(an_s,$an_a,$an_b),$an_c,$an_d))
  $an_h2 = an_cd($an_A,an_mul_de(an_s),$an_d,an_mul(an_s,an_mul(an_s,$an_a,$an_b),$an_c),
                 an_mul(an_s,an_mul(an_s,$an_a,$an_c),$an_b),ta_ap3($an_rc,$an_a,$an_b,$an_c))
  $an_h3 = an_Lma(an_s,an_mul(an_s,$an_a,$an_c),$an_b,$an_d)
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x4,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_x4,$an_h2,$an_h3))
  retour an_pair(an_pi4($an_A,an_eq($an_A,$an_x1,$an_x4)),an_lam4($an_A,$an_corps))
}
fn an_lem_zero_mul_absorb(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_x1 = an_mul(an_s,an_mul(an_s,an_zero(an_s),$an_a),$an_b)
  $an_x2 = an_mul(an_s,an_zero(an_s),$an_b)
  $an_h1 = an_cd($an_A,an_mul_de(an_s),$an_b,an_mul(an_s,an_zero(an_s),$an_a),an_zero(an_s),an_Lzml(an_s,$an_a))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,an_zero(an_s),$an_h1,an_Lzml(an_s,$an_b))
  retour an_pair(an_pi2($an_A,an_eq($an_A,$an_x1,an_zero(an_s))),an_lam2($an_A,$an_corps))
}
fn an_lem_mul_zero_absorb(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_x1 = an_mul(an_s,an_mul(an_s,$an_a,an_zero(an_s)),$an_b)
  $an_x2 = an_mul(an_s,an_zero(an_s),$an_b)
  $an_h1 = an_cd($an_A,an_mul_de(an_s),$an_b,an_mul(an_s,$an_a,an_zero(an_s)),an_zero(an_s),an_Lmzl(an_s,$an_a))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,an_zero(an_s),$an_h1,an_Lzml(an_s,$an_b))
  retour an_pair(an_pi2($an_A,an_eq($an_A,$an_x1,an_zero(an_s))),an_lam2($an_A,$an_corps))
}
fn an_lem_mul_one_unique(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_ep = noy_var("e'"); $an_h = noy_var("h")
  $an_hty = noy_pi("x",$an_A,an_eq($an_A,an_mul(an_s,$an_ep,noy_var("x")),noy_var("x")))
  $an_x1 = $an_ep
  $an_x2 = an_mul(an_s,$an_ep,an_one(an_s))
  $an_x3 = an_one(an_s)
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Lm1r($an_s,$an_ep))
  $an_h2 = ta_ap1($an_h,an_one(an_s))
  $an_chaine = an_tr($an_A,$an_x1,$an_x2,$an_x3,$an_h1,$an_h2)
  $an_corps = an_sy($an_A,$an_x1,$an_x3,$an_chaine)
  retour an_pair(noy_pi("e'",$an_A,noy_pi("h",$an_hty,an_eq($an_A,an_one(an_s),$an_ep))),
                 noy_lam("e'",$an_A,noy_lam("h",$an_hty,$an_corps)))
}

fn an_lem_mul_congr_l(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_h = noy_var("h")
  $an_hty = an_eq($an_A,$an_a,$an_b)
  $an_corps = an_cd($an_A,an_mul_de(an_s),$an_c,$an_a,$an_b,$an_h)
  retour an_pair(noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("c",$an_A,
            noy_pi("h",$an_hty,an_eq($an_A,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_b,$an_c)))))),
            noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("c",$an_A,noy_lam("h",$an_hty,$an_corps)))))
}
fn an_lem_mul_congr_r(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_h = noy_var("h")
  $an_hty = an_eq($an_A,$an_a,$an_b)
  $an_corps = an_cg($an_A,an_mul_de(an_s),$an_c,$an_a,$an_b,$an_h)
  retour an_pair(noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("c",$an_A,
            noy_pi("h",$an_hty,an_eq($an_A,an_mul(an_s,$an_c,$an_a),an_mul(an_s,$an_c,$an_b)))))),
            noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("c",$an_A,noy_lam("h",$an_hty,$an_corps)))))
}

# ── 6. Corpus GÉNÉRIQUE — distributivité et négation (lemmes 41..56) ─────────

fn an_lem_dist_l_symm(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_corps = an_sy($an_A,an_mul(an_s,noy_var("a"),an_plus(an_s,noy_var("b"),noy_var("c"))),
                    an_plus(an_s,an_mul(an_s,noy_var("a"),noy_var("b")),an_mul(an_s,noy_var("a"),noy_var("c"))),
                    an_Ldl(an_s,noy_var("a"),noy_var("b"),noy_var("c")))
  retour an_pair(an_pi3($an_A,an_eq($an_A,an_plus(an_s,an_mul(an_s,noy_var("a"),noy_var("b")),an_mul(an_s,noy_var("a"),noy_var("c"))),
                                           an_mul(an_s,noy_var("a"),an_plus(an_s,noy_var("b"),noy_var("c"))))),an_lam3($an_A,$an_corps))
}
fn an_lem_dist_r_symm(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_corps = an_sy($an_A,an_mul(an_s,an_plus(an_s,noy_var("a"),noy_var("b")),noy_var("c")),
                    an_plus(an_s,an_mul(an_s,noy_var("a"),noy_var("c")),an_mul(an_s,noy_var("b"),noy_var("c"))),
                    an_Ldr(an_s,noy_var("a"),noy_var("b"),noy_var("c")))
  retour an_pair(an_pi3($an_A,an_eq($an_A,an_plus(an_s,an_mul(an_s,noy_var("a"),noy_var("c")),an_mul(an_s,noy_var("b"),noy_var("c"))),
                                           an_mul(an_s,an_plus(an_s,noy_var("a"),noy_var("b")),noy_var("c")))),an_lam3($an_A,$an_corps))
}
fn an_lem_mul_add_comm(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_x1 = an_mul(an_s,$an_a,an_plus(an_s,$an_b,$an_c))
  $an_x2 = an_plus(an_s,an_mul(an_s,$an_a,$an_b),an_mul(an_s,$an_a,$an_c))
  $an_x3 = an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_a,$an_b))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x3,an_Ldl(an_s,$an_a,$an_b,$an_c),an_Lac(an_s,an_mul(an_s,$an_a,$an_b),an_mul(an_s,$an_a,$an_c)))
  retour an_pair(an_pi3($an_A,an_eq($an_A,$an_x1,$an_x3)),an_lam3($an_A,$an_corps))
}
fn an_lem_add_mul_comm(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_x1 = an_mul(an_s,an_plus(an_s,$an_a,$an_b),$an_c)
  $an_x2 = an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_b,$an_c))
  $an_x3 = an_plus(an_s,an_mul(an_s,$an_b,$an_c),an_mul(an_s,$an_a,$an_c))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x3,an_Ldr(an_s,$an_a,$an_b,$an_c),an_Lac(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_b,$an_c)))
  retour an_pair(an_pi3($an_A,an_eq($an_A,$an_x1,$an_x3)),an_lam3($an_A,$an_corps))
}
fn an_lem_mul_add_add(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_d = noy_var("d")
  $an_x1 = an_plus(an_s,an_mul(an_s,$an_a,an_plus(an_s,$an_b,$an_c)),an_mul(an_s,$an_a,$an_d))
  $an_x2 = an_mul(an_s,$an_a,an_plus(an_s,an_plus(an_s,$an_b,$an_c),$an_d))
  $an_corps = an_sy($an_A,$an_x2,$an_x1,an_Ldl(an_s,$an_a,an_plus(an_s,$an_b,$an_c),$an_d))
  retour an_pair(an_pi4($an_A,an_eq($an_A,$an_x1,$an_x2)),an_lam4($an_A,$an_corps))
}
fn an_lem_add_mul_mul(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_d = noy_var("d")
  $an_x1 = an_plus(an_s,an_mul(an_s,an_plus(an_s,$an_a,$an_b),$an_c),an_mul(an_s,$an_d,$an_c))
  $an_x2 = an_mul(an_s,an_plus(an_s,an_plus(an_s,$an_a,$an_b),$an_d),$an_c)
  $an_corps = an_sy($an_A,$an_x2,$an_x1,an_Ldr(an_s,an_plus(an_s,$an_a,$an_b),$an_d,$an_c))
  retour an_pair(an_pi4($an_A,an_eq($an_A,$an_x1,$an_x2)),an_lam4($an_A,$an_corps))
}
fn an_lem_mul_add_mul(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_d = noy_var("d")
  $an_x1 = an_mul(an_s,an_plus(an_s,$an_a,$an_b),an_plus(an_s,$an_c,$an_d))
  $an_x2 = an_plus(an_s,an_mul(an_s,$an_a,an_plus(an_s,$an_c,$an_d)),an_mul(an_s,$an_b,an_plus(an_s,$an_c,$an_d)))
  $an_x3 = an_plus(an_s,an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_a,$an_d)),an_mul(an_s,$an_b,an_plus(an_s,$an_c,$an_d)))
  $an_x4 = an_plus(an_s,an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_a,$an_d)),an_plus(an_s,an_mul(an_s,$an_b,$an_c),an_mul(an_s,$an_b,$an_d)))
  $an_h1 = an_Ldr(an_s,$an_a,$an_b,an_plus(an_s,$an_c,$an_d))
  $an_h2 = an_cd($an_A,an_add_de(an_s),an_mul(an_s,$an_b,an_plus(an_s,$an_c,$an_d)),
                 an_mul(an_s,$an_a,an_plus(an_s,$an_c,$an_d)),
                 an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_a,$an_d)),
                 an_Ldl(an_s,$an_a,$an_c,$an_d))
  $an_h3 = an_cg($an_A,an_add_de(an_s),an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,$an_a,$an_d)),
                 an_mul(an_s,$an_b,an_plus(an_s,$an_c,$an_d)),
                 an_plus(an_s,an_mul(an_s,$an_b,$an_c),an_mul(an_s,$an_b,$an_d)),
                 an_Ldl(an_s,$an_b,$an_c,$an_d))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x4,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_x4,$an_h2,$an_h3))
  retour an_pair(an_pi4($an_A,an_eq($an_A,$an_x1,$an_x4)),an_lam4($an_A,$an_corps))
}
fn an_lem_neg_mul(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_x1 = an_plus(an_s,an_mul(an_s,an_neg(an_s,$an_a),$an_b),an_mul(an_s,$an_a,$an_b))
  $an_x2 = an_mul(an_s,an_plus(an_s,an_neg(an_s,$an_a),$an_a),$an_b)
  $an_x3 = an_mul(an_s,an_zero(an_s),$an_b)
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Ldr(an_s,an_neg(an_s,$an_a),$an_a,$an_b))
  $an_h2 = an_cd($an_A,an_mul_de(an_s),$an_b,an_plus(an_s,an_neg(an_s,$an_a),$an_a),an_zero(an_s),an_Linv_l(an_s,$an_a))
  $an_h3 = an_Lzml(an_s,$an_b)
  $an_hx = an_tr($an_A,$an_x1,$an_x2,an_zero(an_s),$an_h1,an_tr($an_A,$an_x2,$an_x3,an_zero(an_s),$an_h2,$an_h3))
  $an_u = an_loi_nom("neg_unique",an_s)
  $an_corps = ta_ap3($an_u,an_mul(an_s,$an_a,$an_b),an_mul(an_s,an_neg(an_s,$an_a),$an_b),$an_hx)
  retour an_pair(an_pi2($an_A,an_eq($an_A,an_mul(an_s,an_neg(an_s,$an_a),$an_b),an_neg(an_s,an_mul(an_s,$an_a,$an_b)))),an_lam2($an_A,$an_corps))
}
fn an_lem_mul_neg(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_x1 = an_plus(an_s,an_mul(an_s,$an_a,an_neg(an_s,$an_b)),an_mul(an_s,$an_a,$an_b))
  $an_x2 = an_mul(an_s,$an_a,an_plus(an_s,an_neg(an_s,$an_b),$an_b))
  $an_x3 = an_mul(an_s,$an_a,an_zero(an_s))
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Ldl(an_s,$an_a,an_neg(an_s,$an_b),$an_b))
  $an_h2 = an_cg($an_A,an_mul_de(an_s),$an_a,an_plus(an_s,an_neg(an_s,$an_b),$an_b),an_zero(an_s),an_Linv_l(an_s,$an_b))
  $an_h3 = an_Lmzl(an_s,$an_a)
  $an_hx = an_tr($an_A,$an_x1,$an_x2,an_zero(an_s),$an_h1,an_tr($an_A,$an_x2,$an_x3,an_zero(an_s),$an_h2,$an_h3))
  $an_u = an_loi_nom("neg_unique",an_s)
  $an_corps = ta_ap3($an_u,an_mul(an_s,$an_a,$an_b),an_mul(an_s,$an_a,an_neg(an_s,$an_b)),$an_hx)
  retour an_pair(an_pi2($an_A,an_eq($an_A,an_mul(an_s,$an_a,an_neg(an_s,$an_b)),an_neg(an_s,an_mul(an_s,$an_a,$an_b)))),an_lam2($an_A,$an_corps))
}
fn an_lem_neg_mul_neg(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_nm = an_loi_nom("neg_mul",an_s); $an_mn = an_loi_nom("mul_neg",an_s); $an_nn = an_loi_nom("neg_neg",an_s)
  $an_x1 = an_mul(an_s,an_neg(an_s,$an_a),an_neg(an_s,$an_b))
  $an_x2 = an_neg(an_s,an_mul(an_s,$an_a,an_neg(an_s,$an_b)))
  $an_x3 = an_neg(an_s,an_neg(an_s,an_mul(an_s,$an_a,$an_b)))
  $an_h1 = ta_ap2($an_nm,$an_a,an_neg(an_s,$an_b))
  $an_h2 = an_c1($an_A,an_neg_de(an_s),an_mul(an_s,$an_a,an_neg(an_s,$an_b)),an_neg(an_s,an_mul(an_s,$an_a,$an_b)),ta_ap2($an_mn,$an_a,$an_b))
  $an_h3 = ta_ap1($an_nn,an_mul(an_s,$an_a,$an_b))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,an_mul(an_s,$an_a,$an_b),$an_h1,an_tr($an_A,$an_x2,$an_x3,an_mul(an_s,$an_a,$an_b),$an_h2,$an_h3))
  retour an_pair(an_pi2($an_A,an_eq($an_A,$an_x1,an_mul(an_s,$an_a,$an_b))),an_lam2($an_A,$an_corps))
}
fn an_lem_neg_mul_alt(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_nm = an_loi_nom("neg_mul",an_s); $an_mn = an_loi_nom("mul_neg",an_s)
  $an_corps = an_tr($an_A,an_mul(an_s,an_neg(an_s,$an_a),$an_b),
                    an_neg(an_s,an_mul(an_s,$an_a,$an_b)),
                    an_mul(an_s,$an_a,an_neg(an_s,$an_b)),
                    ta_ap2($an_nm,$an_a,$an_b),
                    an_sy($an_A,an_mul(an_s,$an_a,an_neg(an_s,$an_b)),an_neg(an_s,an_mul(an_s,$an_a,$an_b)),ta_ap2($an_mn,$an_a,$an_b)))
  retour an_pair(an_pi2($an_A,an_eq($an_A,an_mul(an_s,an_neg(an_s,$an_a),$an_b),an_mul(an_s,$an_a,an_neg(an_s,$an_b)))),an_lam2($an_A,$an_corps))
}
fn an_lem_add_neg_mul(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_nm = an_loi_nom("neg_mul",an_s)
  $an_x1 = an_mul(an_s,an_plus(an_s,$an_a,an_neg(an_s,$an_b)),$an_c)
  $an_x2 = an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_mul(an_s,an_neg(an_s,$an_b),$an_c))
  $an_x3 = an_plus(an_s,an_mul(an_s,$an_a,$an_c),an_neg(an_s,an_mul(an_s,$an_b,$an_c)))
  $an_h1 = an_Ldr(an_s,$an_a,an_neg(an_s,$an_b),$an_c)
  $an_h2 = an_cg($an_A,an_add_de(an_s),an_mul(an_s,$an_a,$an_c),an_mul(an_s,an_neg(an_s,$an_b),$an_c),an_neg(an_s,an_mul(an_s,$an_b,$an_c)),ta_ap2($an_nm,$an_b,$an_c))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x3,$an_h1,$an_h2)
  retour an_pair(an_pi3($an_A,an_eq($an_A,$an_x1,$an_x3)),an_lam3($an_A,$an_corps))
}
fn an_lem_mul_add_neg(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_mn = an_loi_nom("mul_neg",an_s)
  $an_x1 = an_mul(an_s,$an_a,an_plus(an_s,$an_b,an_neg(an_s,$an_c)))
  $an_x2 = an_plus(an_s,an_mul(an_s,$an_a,$an_b),an_mul(an_s,$an_a,an_neg(an_s,$an_c)))
  $an_x3 = an_plus(an_s,an_mul(an_s,$an_a,$an_b),an_neg(an_s,an_mul(an_s,$an_a,$an_c)))
  $an_h1 = an_Ldl(an_s,$an_a,$an_b,an_neg(an_s,$an_c))
