}
fn an_lem_neg_add_alt(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_na = an_loi_nom("neg_add",an_s)
  $an_x1 = an_neg(an_s,an_plus(an_s,$an_a,$an_b))
  $an_x2 = an_plus(an_s,an_neg(an_s,$an_a),an_neg(an_s,$an_b))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,an_plus(an_s,an_neg(an_s,$an_b),an_neg(an_s,$an_a)),
                    ta_ap2($an_na,$an_a,$an_b),
                    an_Lac(an_s,an_neg(an_s,$an_a),an_neg(an_s,$an_b)))
  retour an_pair(an_pi2($an_A,an_eq($an_A,$an_x1,an_plus(an_s,an_neg(an_s,$an_b),an_neg(an_s,$an_a)))),an_lam2($an_A,$an_corps))
}
fn an_lem_add_self_of_eq_neg(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_h = noy_var("h")
  $an_x1 = an_plus(an_s,$an_a,$an_a)
  $an_x2 = an_plus(an_s,an_neg(an_s,$an_a),$an_a)
  $an_corps = an_tr($an_A,$an_x1,$an_x2,an_zero(an_s),
                    an_cd($an_A,an_add_de(an_s),$an_a,$an_a,an_neg(an_s,$an_a),$an_h),
                    an_Linv_l(an_s,$an_a))
  $an_but = noy_pi("a",$an_A,noy_pi("h",an_eq($an_A,$an_a,an_neg(an_s,$an_a)),an_eq($an_A,$an_x1,an_zero(an_s))))
  $an_hty = an_eq($an_A,$an_a,an_neg(an_s,$an_a))
  $an_hty = an_eq($an_A,$an_a,an_neg(an_s,$an_a))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("h",$an_hty,$an_corps)))
}

# ── 5. Corpus GÉNÉRIQUE — multiplication (lemmes 27..40) ─────────────────────

fn an_lem_mul_assoc4(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_d = noy_var("d")
  $an_ab = an_mul(an_s,$an_a,$an_b); $an_bc = an_mul(an_s,$an_b,$an_c); $an_cd = an_mul(an_s,$an_c,$an_d)
  $an_l = an_mul(an_s,an_mul(an_s,$an_ab,$an_c),$an_d)
  $an_m1 = an_mul(an_s,an_mul(an_s,$an_a,$an_bc),$an_d)
  $an_m2 = an_mul(an_s,$an_a,an_mul(an_s,$an_bc,$an_d))
  $an_r = an_mul(an_s,$an_a,an_mul(an_s,$an_b,$an_cd))
  $an_h1 = an_cd($an_A,an_mul_de(an_s),$an_d,an_mul(an_s,$an_ab,$an_c),an_mul(an_s,$an_a,$an_bc),an_Lma(an_s,$an_a,$an_b,$an_c))
  $an_h2 = an_Lma(an_s,$an_a,$an_bc,$an_d)
  $an_h3 = an_cg($an_A,an_mul_de(an_s),$an_a,an_mul(an_s,$an_bc,$an_d),an_mul(an_s,$an_b,$an_cd),an_Lma(an_s,$an_b,$an_c,$an_d))
  $an_corps = an_tr($an_A,$an_l,$an_m1,$an_r,$an_h1,an_tr($an_A,$an_m1,$an_m2,$an_r,$an_h2,$an_h3))
  retour an_pair(an_pi4($an_A,an_eq($an_A,$an_l,$an_r)),an_lam4($an_A,$an_corps))
}
fn an_lem_mul_one_l(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a")
  retour an_pair(noy_pi("a",$an_A,an_eq($an_A,an_mul(an_s,an_one(an_s),$an_a),$an_a)),noy_lam("a",$an_A,an_Lm1l(an_s,$an_a)))
