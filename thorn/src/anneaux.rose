# ═════════════════════════════════════════════════════════════════════════════
# thorn/src/anneaux.rose — JALON M2 : DEMI-ANNEAUX, ANNEAUX, ORDRES COMPATIBLES
# ═════════════════════════════════════════════════════════════════════════════
#
# Fichier NOUVEAU du chantier M2. Aucun fichier hors périmètre n'est modifié.
# Aucun commit, aucune publication.
#
# Ce module étend le schéma M0 (thorn/src/hierarchie.rose) et M1
# (thorn/src/ordres.rose) aux structures algébriques à DEUX opérations :
#
#   AddMonoid   = { car, add, 0, add_assoc, add_idl, add_idr }
#   AddGroupe   = AddMonoid + { neg, invl, invr }  (commutativité incluse)
#   Semiring    = AddMonoid(comm) + MulMonoid + { dist_l, dist_r, 0*m, m*0 }
#   Ring        = Semiring + AddGroupe
#   CommRing    = Ring + { mul_comm }
#   OrdreRing   = Ring + { le, le_refl, le_trans, le_antisymm,
#                          le_add, le_mul_nonneg, zero_le_one }
#
# Comme en M0/M1 : une classe est une TABLE Rose ; chaque champ de loi est un
# TERME DE PREUVE VÉRIFIÉ, jamais un drapeau. Les lemmes génériques sont des
# fonctions Rose paramétrées par l'enregistrement : un seul terme, valable pour
# toute instance. Chaque terme est soumis à `verifier()` puis `convertible()`
# par le rejeu (thorn/tests_anneaux.rose).
#
# AXIOMES DE SIGNATURE (supposés, non démontrés — documentés ici et dans
# MATHLIB_ROADMAP.md §M2) pour la SECTION ABSTRAITE `AnneauOrdreAbstrait` :
#   - les lois de structure elles-mêmes (assoc, identités, distributivités,
#     inverses additifs, compatibilité de l'ordre) : constantes de signature,
#     exactement comme `GroupeAbstrait` en M0 et `OrdreAbstrait` en M1 ;
#   - `pow : Πn Nat, Πx A, A` avec
#       pow_zero_ax : Πx A, pow 0 x = 1
#       pow_succ_ax : Πn Nat, Πx A, pow (succ n) x = pow n x * x
#     (aucune récursivité vérifiée dans le noyau : les équations de `pow`
#     sont des axiomes de signature, au même titre que `mult_0_r` dans
#     algebre.rose).
# Aucun changement du noyau. L'instance Nat n'ajoute AUCUN axiome nouveau :
# toutes ses lois sont des termes déjà vérifiés de algebre.rose (et le
# lemme de commutativité de × est reconstruit par induction ci-dessous).
#
# Vérifier :  ./rose/rose verif thorn/src/anneaux.rose
# Rejeu    :  ./rose/rose thorn/tests_anneaux.rose
# ═════════════════════════════════════════════════════════════════════════════

importer "thorn/src/ordres.rose"

# ── 0. Services minimaux (mêmes conventions que M0/M1) ───────────────────────

fn an_tab(an_x) -> table {
  $an_v = table()
  $an_v = an_x
  retour $an_v
}
fn an_ctx(an_x) -> liste<table> {
  $an_v = [table()]
  $an_v = an_x
  retour $an_v
}
fn an_champ(an_t: table, an_c: chaine) -> table {
  $an_r = table()
  si (cle_existe(an_t, an_c)) { $an_r = an_tab(an_t[an_c]) }
  retour $an_r
}
fn an_nom_champ(an_t: table) -> chaine {
  $an_s = ""
  si (cle_existe(an_t, "nom")) {
    $an_x = an_t["nom"]
    si (type($an_x) == "chaine") { $an_s = $an_x }
  }
  retour $an_s
}
fn an_niveau(an_i: table) -> chaine { retour mg_chaine_champ(an_i, "structure") }
fn an_pair(an_but: table, an_terme: table) -> table {
  $an_r = table()
  inserer($an_r, "but", an_but)
  inserer($an_r, "terme", an_terme)
  retour $an_r
}
fn an_loi(an_p: table) -> table { retour an_tab(an_p["terme"]) }

# Cache des termes de lemmes : chaque lemme générique est construit UNE fois.
# Sans ce cache, les lemmes qui réutilisent des lemmes antérieurs reconstruisent
# récursivement leurs termes (explosion mémoire mesurée au-delà de 8 Gio).
# Rose n'expose pas de variable globale entre modules importés : le cache est
# donc un champ de l'instance (table passée par référence), pas une globale.
fn an_memo_stocker(an_nom: chaine, an_s: table, an_p: table) {
  $an_m = an_tab(an_champ(an_s,"memo"))
  inserer($an_m, an_nom, an_p)
}
fn an_loi_nom(an_nom: chaine, an_s: table) -> table {
  $an_m = an_tab(an_champ(an_s,"memo"))
  $an_r = noy_absent()
  si (cle_existe($an_m, an_nom)) { $an_r = an_tab(an_tab($an_m[an_nom])["terme"]) }
  retour $an_r
}
fn an_compter(an_cpt: table, an_ok: booleen) {
  si (an_ok) { inserer(an_cpt, "r", an_cpt["r"] + 1) }
  sinon { inserer(an_cpt, "e", an_cpt["e"] + 1) }
}
fn an_test(an_nom: chaine, an_but: table, an_terme: table,
           an_ctx_local: liste<table>, an_cpt: table) {
  $an_r = verifier(an_terme, an_ctx_local)
  $an_syn = noy_est_ok($an_r)
  $an_conv = convertible(noy_type_res($an_r), an_but)
  $an_ok = $an_syn et $an_conv
  si ($an_ok) { >> "OK " + an_nom }
  sinon {
    $an_pq = "type synthétisé ≠ but"
    si (non $an_syn) { $an_pq = noy_erreur($an_r) }
    >> "ECHEC " + an_nom + " : " + $an_pq
  }
  an_compter(an_cpt, $an_ok)
}
fn an_lance(an_nom: chaine, an_p: table, an_ctx_local: liste<table>, an_cpt: table) {
  an_test(an_nom, an_tab(an_p["but"]), an_tab(an_p["terme"]), an_ctx_local, an_cpt)
}
fn an_test_bool(an_nom: chaine, an_ok: booleen, an_cpt: table) {
  si (an_ok) { >> "OK [structure] " + an_nom }
  sinon { >> "ECHEC [structure] " + an_nom }
  an_compter(an_cpt, an_ok)
}

# ── 1. Structures : AddMonoid → Semiring → Ring → CommRing (+ OrdreRing) ─────

fn an_add_monoid(an_nom: chaine, an_car: table, an_add: table, an_zero: table,
                 an_assoc: table, an_comm: table, an_idl: table, an_idr: table,
                 an_ctx_local: liste<table>) -> table {
  $an_r = table()
  inserer($an_r, "structure", "AddMonoid")
  inserer($an_r, "classe", "AddMonoid")
  inserer($an_r, "nom", an_nom)
  inserer($an_r, "car", an_car)
  inserer($an_r, "add", an_add)
  inserer($an_r, "zero", an_zero)
  inserer($an_r, "add_assoc", an_assoc)
  inserer($an_r, "add_comm", an_comm)
  inserer($an_r, "add_idl", an_idl)
  inserer($an_r, "add_idr", an_idr)
  inserer($an_r, "ctx", an_ctx_local)
  retour $an_r
}

fn an_semiring(an_nom: chaine, an_car: table, an_add: table, an_zero: table,
               an_mul: table, an_one: table,
               an_a_assoc: table, an_a_comm: table, an_a_idl: table, an_a_idr: table,
               an_m_assoc: table, an_m_idl: table, an_m_idr: table,
               an_dist_l: table, an_dist_r: table, an_zmul: table, an_mzero: table,
               an_ctx_local: liste<table>) -> table {
  $an_r = an_add_monoid(an_nom, an_car, an_add, an_zero,
                        an_a_assoc, an_a_comm, an_a_idl, an_a_idr, an_ctx_local)
  inserer($an_r, "structure", "Semiring")
  inserer($an_r, "classe", "Semiring")
  inserer($an_r, "mul", an_mul)
  inserer($an_r, "one", an_one)
  inserer($an_r, "mul_assoc", an_m_assoc)
  inserer($an_r, "mul_idl", an_m_idl)
  inserer($an_r, "mul_idr", an_m_idr)
  inserer($an_r, "dist_l", an_dist_l)
  inserer($an_r, "dist_r", an_dist_r)
  inserer($an_r, "zero_mul", an_zmul)
  inserer($an_r, "mul_zero", an_mzero)
  retour $an_r
}

fn an_ring(an_nom: chaine, an_car: table, an_add: table, an_zero: table, an_neg: table,
           an_mul: table, an_one: table,
           an_a_assoc: table, an_a_comm: table, an_a_idl: table, an_a_idr: table,
           an_invl: table, an_invr: table,
           an_m_assoc: table, an_m_idl: table, an_m_idr: table,
           an_dist_l: table, an_dist_r: table, an_zmul: table, an_mzero: table,
           an_ctx_local: liste<table>) -> table {
  $an_r = an_semiring(an_nom, an_car, an_add, an_zero, an_mul, an_one,
                      an_a_assoc, an_a_comm, an_a_idl, an_a_idr,
                      an_m_assoc, an_m_idl, an_m_idr,
                      an_dist_l, an_dist_r, an_zmul, an_mzero, an_ctx_local)
  inserer($an_r, "structure", "Ring")
  inserer($an_r, "classe", "Ring")
  inserer($an_r, "neg", an_neg)
  inserer($an_r, "add_invl", an_invl)
  inserer($an_r, "add_invr", an_invr)
  retour $an_r
}

fn an_comm_ring(an_nom: chaine, an_car: table, an_add: table, an_zero: table, an_neg: table,
                an_mul: table, an_one: table,
                an_a_assoc: table, an_a_comm: table, an_a_idl: table, an_a_idr: table,
                an_invl: table, an_invr: table,
                an_m_assoc: table, an_m_idl: table, an_m_idr: table, an_m_comm: table,
                an_dist_l: table, an_dist_r: table, an_zmul: table, an_mzero: table,
                an_ctx_local: liste<table>) -> table {
  $an_r = an_ring(an_nom, an_car, an_add, an_zero, an_neg, an_mul, an_one,
                  an_a_assoc, an_a_comm, an_a_idl, an_a_idr, an_invl, an_invr,
                  an_m_assoc, an_m_idl, an_m_idr,
                  an_dist_l, an_dist_r, an_zmul, an_mzero, an_ctx_local)
  inserer($an_r, "structure", "CommRing")
  inserer($an_r, "classe", "CommRing")
  inserer($an_r, "mul_comm", an_m_comm)
  retour $an_r
}

fn an_ordre_ring(an_nom: chaine, an_base: table, an_le: table,
                 an_le_refl: table, an_le_trans: table, an_le_antisymm: table,
                 an_le_add: table, an_le_mul: table, an_zero_le_one: table,
                 an_ctx_local: liste<table>) -> table {
  $an_r = an_base
  inserer($an_r, "structure", "OrdreRing")
  inserer($an_r, "classe", "OrdreRing")
  inserer($an_r, "le", an_le)
  inserer($an_r, "le_refl", an_le_refl)
  inserer($an_r, "le_trans", an_le_trans)
  inserer($an_r, "le_antisymm", an_le_antisymm)
  inserer($an_r, "le_add", an_le_add)
  inserer($an_r, "le_mul_nonneg", an_le_mul)
  inserer($an_r, "zero_le_one", an_zero_le_one)
  inserer($an_r, "ctx", an_ctx_local)
  retour $an_r
}

fn an_est_add_monoid(an_i: table) -> booleen {
  retour (cle_existe(an_i,"car") et cle_existe(an_i,"add") et
          cle_existe(an_i,"zero") et cle_existe(an_i,"add_assoc"))
}
fn an_est_semiring(an_i: table) -> booleen {
  retour (an_est_add_monoid(an_i) et cle_existe(an_i,"mul") et
          cle_existe(an_i,"one") et cle_existe(an_i,"dist_l") et
          cle_existe(an_i,"dist_r"))
}
fn an_est_ring(an_i: table) -> booleen {
  retour (an_est_semiring(an_i) et cle_existe(an_i,"neg") et
          cle_existe(an_i,"add_invl") et cle_existe(an_i,"add_invr"))
}
fn an_est_comm_ring(an_i: table) -> booleen {
  retour (an_est_ring(an_i) et cle_existe(an_i,"mul_comm"))
}
fn an_est_ordre_ring(an_i: table) -> booleen {
  retour (an_est_ring(an_i) et cle_existe(an_i,"le") et
          cle_existe(an_i,"le_trans") et cle_existe(an_i,"zero_le_one"))
}

fn an_car_de(an_i: table) -> table { retour an_champ(an_i,"car") }
fn an_ctx_de(an_i: table) -> liste<table> { retour an_ctx(an_champ(an_i,"ctx")) }
fn an_add_de(an_i: table) -> table { retour an_champ(an_i,"add") }
fn an_zero_de(an_i: table) -> table { retour an_champ(an_i,"zero") }
fn an_neg_de(an_i: table) -> table { retour an_champ(an_i,"neg") }
fn an_mul_de(an_i: table) -> table { retour an_champ(an_i,"mul") }
fn an_one_de(an_i: table) -> table { retour an_champ(an_i,"one") }
fn an_pow_de(an_i: table) -> table { retour an_champ(an_i,"pow") }
fn an_le_de(an_i: table) -> table { retour an_champ(an_i,"le") }

# ── 2. Termes de base et congrues (eq_rec, re-vérifiés par le rejeu) ─────────

fn an_eq(an_A: table, an_a: table, an_b: table) -> table {
  retour noy_ind("=", ta_params2(an_a, an_b))
}
fn an_rf(an_A: table, an_a: table) -> table {
  retour ta_ap2(ta_refl_symbole(), an_A, an_a)
}
fn an_sy(an_A: table, an_a: table, an_b: table, an_h: table) -> table {
  retour ta_ap4(ta_symm_symbole(), an_A, an_a, an_b, an_h)
}
fn an_tr(an_A: table, an_a: table, an_b: table, an_c: table,
         an_h1: table, an_h2: table) -> table {
  retour ta_ap6(ta_trans_symbole(), an_A, an_a, an_b, an_c, an_h1, an_h2)
}
fn an_plus(an_s: table, an_a: table, an_b: table) -> table {
  retour ta_ap2(an_add_de(an_s), an_a, an_b)
}
fn an_mul(an_s: table, an_a: table, an_b: table) -> table {
  retour ta_ap2(an_mul_de(an_s), an_a, an_b)
}
fn an_neg(an_s: table, an_a: table) -> table { retour ta_ap1(an_neg_de(an_s), an_a) }
fn an_zero(an_s: table) -> table { retour an_zero_de(an_s) }
fn an_one(an_s: table) -> table { retour an_one_de(an_s) }
fn an_pow(an_s: table, an_n: table, an_a: table) -> table {
  retour ta_ap2(an_pow_de(an_s), an_n, an_a)
}
fn an_le(an_s: table, an_a: table, an_b: table) -> table {
  retour ta_ap2(an_le_de(an_s), an_a, an_b)
}

# congrégation gauche/droite d'un opérateur binaire quelconque (M0)
fn an_cg(an_A: table, an_op: table, an_u: table, an_a: table, an_b: table, an_h: table) -> table {
  retour mg_congr_g(an_A, an_op, an_u, an_a, an_b, an_h)
}
fn an_cd(an_A: table, an_op: table, an_u: table, an_a: table, an_b: table, an_h: table) -> table {
  retour mg_congr_d(an_A, an_op, an_u, an_a, an_b, an_h)
}
# congrégation d'une fonction unaire f
fn an_c1(an_A: table, an_f: table, an_a: table, an_b: table, an_h: table) -> table {
  $an_P = noy_lam("z", an_A, an_eq(an_A, ta_ap1(an_f, an_a), ta_ap1(an_f, noy_var("z"))))
  retour ta_ap6(ta_eqrec_symbole(), an_A, an_a, an_b, $an_P,
                an_rf(an_A, ta_ap1(an_f, an_a)), an_h)
}
# de h : a = b, construit P a -> P b pour un prédicat P (transport)
fn an_transp(an_A: table, an_a: table, an_b: table, an_P: table, an_p: table, an_h: table) -> table {
  retour ta_ap6(ta_eqrec_symbole(), an_A, an_a, an_b, an_P, an_p, an_h)
}
fn an_pi2(an_A: table, an_but: table) -> table {
  retour noy_pi("a", an_A, noy_pi("b", an_A, an_but))
}
fn an_pi3(an_A: table, an_but: table) -> table {
  retour noy_pi("a", an_A, noy_pi("b", an_A, noy_pi("c", an_A, an_but)))
}
fn an_pi4(an_A: table, an_but: table) -> table {
  retour noy_pi("a", an_A, noy_pi("b", an_A, noy_pi("c", an_A, noy_pi("d", an_A, an_but))))
}
fn an_lam2(an_A: table, an_corps: table) -> table {
  retour noy_lam("a", an_A, noy_lam("b", an_A, an_corps))
}
fn an_lam3(an_A: table, an_corps: table) -> table {
  retour noy_lam("a", an_A, noy_lam("b", an_A, noy_lam("c", an_A, an_corps)))
}
fn an_lam4(an_A: table, an_corps: table) -> table {
  retour noy_lam("a", an_A, noy_lam("b", an_A, noy_lam("c", an_A, noy_lam("d", an_A, an_corps))))
}

# applications des lois de structure
fn an_Laa(an_s: table, an_a: table, an_b: table, an_c: table) -> table {
  retour ta_ap3(an_champ(an_s,"add_assoc"), an_a, an_b, an_c)
}
fn an_Lac(an_s: table, an_a: table, an_b: table) -> table {
  retour ta_ap2(an_champ(an_s,"add_comm"), an_a, an_b)
}
fn an_Lazl(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"add_idl"), an_a)
}
fn an_Lazr(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"add_idr"), an_a)
}
fn an_Linv_l(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"add_invl"), an_a)
}
fn an_Linv_r(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"add_invr"), an_a)
}
fn an_Lma(an_s: table, an_a: table, an_b: table, an_c: table) -> table {
  retour ta_ap3(an_champ(an_s,"mul_assoc"), an_a, an_b, an_c)
}
fn an_Lmc(an_s: table, an_a: table, an_b: table) -> table {
  retour ta_ap2(an_champ(an_s,"mul_comm"), an_a, an_b)
}
fn an_Lm1l(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"mul_idl"), an_a)
}
fn an_Lm1r(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"mul_idr"), an_a)
}
fn an_Lzml(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"zero_mul"), an_a)
}
fn an_Lmzl(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"mul_zero"), an_a)
}
fn an_Ldl(an_s: table, an_a: table, an_b: table, an_c: table) -> table {
  retour ta_ap3(an_champ(an_s,"dist_l"), an_a, an_b, an_c)
}
fn an_Ldr(an_s: table, an_a: table, an_b: table, an_c: table) -> table {
  retour ta_ap3(an_champ(an_s,"dist_r"), an_a, an_b, an_c)
}
fn an_Lpow0(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"pow_zero_ax"), an_a)
}
fn an_Lpows(an_s: table, an_n: table, an_a: table) -> table {
  retour ta_ap2(an_champ(an_s,"pow_succ_ax"), an_n, an_a)
}
fn an_Ller(an_s: table, an_a: table) -> table {
  retour ta_ap1(an_champ(an_s,"le_refl"), an_a)
}
fn an_Llet(an_s: table, an_a: table, an_b: table, an_c: table,
           an_h1: table, an_h2: table) -> table {
  retour ta_ap5(an_champ(an_s,"le_trans"), an_a, an_b, an_c, an_h1, an_h2)
}
fn an_Llea(an_s: table, an_a: table, an_b: table,
           an_h: table) -> table {
  retour ta_ap4(an_champ(an_s,"le_antisymm"), an_a, an_b,
                an_h, ta_ap4(an_champ(an_s,"le_antisymm"), an_a, an_b, an_h, an_h))
}
fn an_Lleadd(an_s: table, an_a: table, an_b: table, an_c: table, an_h: table) -> table {
  retour ta_ap4(an_champ(an_s,"le_add"), an_a, an_b, an_c, an_h)
}
fn an_Llemul(an_s: table, an_a: table, an_b: table, an_h1: table, an_h2: table) -> table {
  retour ta_ap4(an_champ(an_s,"le_mul_nonneg"), an_a, an_b, an_h1, an_h2)
}

# ── 3. Section abstraite : signature certifiée une fois pour toutes ──────────

fn an_sig() -> table {
  $an_s = table()
  $an_A = noy_var("A")
  $an_add = noy_const("add", noy_pi("x",$an_A,noy_pi("y",$an_A,$an_A)))
  $an_z   = noy_const("zero", $an_A)
  $an_neg = noy_const("neg", noy_pi("x",$an_A,$an_A))
  $an_mul = noy_const("mul", noy_pi("x",$an_A,noy_pi("y",$an_A,$an_A)))
  $an_one = noy_const("one", $an_A)
  $an_le  = noy_const("le", noy_pi("x",$an_A,noy_pi("y",$an_A,noy_type(0))))
  $an_pow = noy_const("pow", noy_pi("n",ta_nat(),noy_pi("x",$an_A,$an_A)))
  inserer($an_s,"A",$an_A)
  inserer($an_s,"add",$an_add)
  inserer($an_s,"zero",$an_z)
  inserer($an_s,"neg",$an_neg)
  inserer($an_s,"mul",$an_mul)
  inserer($an_s,"one",$an_one)
  inserer($an_s,"le",$an_le)
  inserer($an_s,"pow",$an_pow)
  $an_c = ta_ctx()
  $an_c = noy_ctx_ajouter($an_c,"A",noy_type(0))
  $an_c = noy_ctx_ajouter($an_c,"add",mg_coerce_tab($an_add["type"]))
  $an_c = noy_ctx_ajouter($an_c,"zero",$an_A)
  $an_c = noy_ctx_ajouter($an_c,"neg",mg_coerce_tab($an_neg["type"]))
  $an_c = noy_ctx_ajouter($an_c,"mul",mg_coerce_tab($an_mul["type"]))
  $an_c = noy_ctx_ajouter($an_c,"one",$an_A)
  $an_c = noy_ctx_ajouter($an_c,"le",mg_coerce_tab($an_le["type"]))
  $an_c = noy_ctx_ajouter($an_c,"pow",mg_coerce_tab($an_pow["type"]))

  # Termes d'aide pour les types de lois (x, y, z variables de noyau)
  $an_x = noy_var("x"); $an_y = noy_var("y"); $an_zv = noy_var("z")
  $an_addx = ta_ap2($an_add,$an_x,$an_y)

  $an_l1 = noy_const("add_assoc", noy_pi("x",$an_A,noy_pi("y",$an_A,noy_pi("z",$an_A,
      an_eq($an_A, ta_ap2($an_add, $an_addx, $an_zv),
                   ta_ap2($an_add, $an_x, ta_ap2($an_add,$an_y,$an_zv)))))))
  $an_l2 = noy_const("add_comm", noy_pi("x",$an_A,noy_pi("y",$an_A,
      an_eq($an_A, ta_ap2($an_add,$an_x,$an_y), ta_ap2($an_add,$an_y,$an_x)))))
  $an_l3 = noy_const("add_idl", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_add,$an_z,$an_x), $an_x)))
  $an_l4 = noy_const("add_idr", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_add,$an_x,$an_z), $an_x)))
  $an_l5 = noy_const("add_invl", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_add, ta_ap1($an_neg,$an_x), $an_x), $an_z)))
  $an_l6 = noy_const("add_invr", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_add, $an_x, ta_ap1($an_neg,$an_x)), $an_z)))
  $an_mulx = ta_ap2($an_mul,$an_x,$an_y)
  $an_l7 = noy_const("mul_assoc", noy_pi("x",$an_A,noy_pi("y",$an_A,noy_pi("z",$an_A,
      an_eq($an_A, ta_ap2($an_mul, $an_mulx, $an_zv),
                   ta_ap2($an_mul, $an_x, ta_ap2($an_mul,$an_y,$an_zv)))))))
  $an_l8 = noy_const("mul_comm", noy_pi("x",$an_A,noy_pi("y",$an_A,
      an_eq($an_A, ta_ap2($an_mul,$an_x,$an_y), ta_ap2($an_mul,$an_y,$an_x)))))
  $an_l9 = noy_const("mul_idl", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_mul,$an_one,$an_x), $an_x)))
  $an_l10 = noy_const("mul_idr", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_mul,$an_x,$an_one), $an_x)))
  $an_l11 = noy_const("zero_mul", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_mul,$an_z,$an_x), $an_z)))
  $an_l12 = noy_const("mul_zero", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_mul,$an_x,$an_z), $an_z)))
  $an_l13 = noy_const("dist_l", noy_pi("x",$an_A,noy_pi("y",$an_A,noy_pi("z",$an_A,
      an_eq($an_A, ta_ap2($an_mul,$an_x,ta_ap2($an_add,$an_y,$an_zv)),
                   ta_ap2($an_add, ta_ap2($an_mul,$an_x,$an_y),
                                   ta_ap2($an_mul,$an_x,$an_zv)))))))
  $an_l14 = noy_const("dist_r", noy_pi("x",$an_A,noy_pi("y",$an_A,noy_pi("z",$an_A,
      an_eq($an_A, ta_ap2($an_mul,ta_ap2($an_add,$an_x,$an_y),$an_zv),
                   ta_ap2($an_add, ta_ap2($an_mul,$an_x,$an_zv),
                                   ta_ap2($an_mul,$an_y,$an_zv)))))))
  $an_l15 = noy_const("pow_zero_ax", noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_pow,ta_zero(),$an_x), $an_one)))
  $an_l16 = noy_const("pow_succ_ax", noy_pi("n",ta_nat(),noy_pi("x",$an_A,
      an_eq($an_A, ta_ap2($an_pow,ta_succ(noy_var("n")),$an_x),
                   ta_ap2($an_mul, ta_ap2($an_pow,noy_var("n"),$an_x), $an_x)))))
  $an_l17 = noy_const("le_refl", noy_pi("x",$an_A, ta_ap2($an_le,$an_x,$an_x)))
  $an_l18 = noy_const("le_trans", noy_pi("x",$an_A,noy_pi("y",$an_A,noy_pi("z",$an_A,
      noy_pi("h1",ta_ap2($an_le,$an_x,$an_y),
        noy_pi("h2",ta_ap2($an_le,$an_y,$an_zv), ta_ap2($an_le,$an_x,$an_zv)))))))
  $an_l19 = noy_const("le_antisymm", noy_pi("x",$an_A,noy_pi("y",$an_A,
      noy_pi("h1",ta_ap2($an_le,$an_x,$an_y),
        noy_pi("h2",ta_ap2($an_le,$an_y,$an_x), an_eq($an_A,$an_x,$an_y))))))
  $an_l20 = noy_const("le_add", noy_pi("x",$an_A,noy_pi("y",$an_A,noy_pi("z",$an_A,
      noy_pi("h",ta_ap2($an_le,$an_x,$an_y),
             ta_ap2($an_le, ta_ap2($an_add,$an_x,$an_zv),
                            ta_ap2($an_add,$an_y,$an_zv)))))))
  $an_l21 = noy_const("le_mul_nonneg", noy_pi("x",$an_A,noy_pi("y",$an_A,
      noy_pi("h1",ta_ap2($an_le,$an_z,$an_x),
        noy_pi("h2",ta_ap2($an_le,$an_z,$an_y),
               ta_ap2($an_le,$an_z,ta_ap2($an_mul,$an_x,$an_y)))))))
  $an_l22 = noy_const("zero_le_one", ta_ap2($an_le,$an_z,$an_one))

  inserer($an_s,"add_assoc",$an_l1)
  inserer($an_s,"add_comm",$an_l2)
  inserer($an_s,"add_idl",$an_l3)
  inserer($an_s,"add_idr",$an_l4)
  inserer($an_s,"add_invl",$an_l5)
  inserer($an_s,"add_invr",$an_l6)
  inserer($an_s,"mul_assoc",$an_l7)
  inserer($an_s,"mul_comm",$an_l8)
  inserer($an_s,"mul_idl",$an_l9)
  inserer($an_s,"mul_idr",$an_l10)
  inserer($an_s,"zero_mul",$an_l11)
  inserer($an_s,"mul_zero",$an_l12)
  inserer($an_s,"dist_l",$an_l13)
  inserer($an_s,"dist_r",$an_l14)
  inserer($an_s,"pow_zero_ax",$an_l15)
  inserer($an_s,"pow_succ_ax",$an_l16)
  inserer($an_s,"le_refl",$an_l17)
  inserer($an_s,"le_trans",$an_l18)
  inserer($an_s,"le_antisymm",$an_l19)
  inserer($an_s,"le_add",$an_l20)
  inserer($an_s,"le_mul_nonneg",$an_l21)
  inserer($an_s,"zero_le_one",$an_l22)
  $an_noms = ["add_assoc","add_comm","add_idl","add_idr","add_invl","add_invr",
              "mul_assoc","mul_comm","mul_idl","mul_idr","zero_mul","mul_zero",
              "dist_l","dist_r","pow_zero_ax","pow_succ_ax","le_refl","le_trans",
              "le_antisymm","le_add","le_mul_nonneg","zero_le_one"]
  $an_k = 1
  tant_que ($an_k < longueur($an_noms)) {
    $an_l = an_tab($an_s[$an_noms[$an_k]])
    $an_c = noy_ctx_ajouter($an_c, noy_nom($an_l), mg_coerce_tab($an_l["type"]))
    $an_k = $an_k + 1
  }
  inserer($an_s,"ctx",$an_c)
  retour $an_s
}

fn an_inst_abstrait() -> table {
  $an_s = an_sig()
  $an_r = an_comm_ring("AnneauOrdreAbstrait",
    an_tab($an_s["A"]), an_tab($an_s["add"]),
    an_tab($an_s["zero"]), an_tab($an_s["neg"]),
    an_tab($an_s["mul"]), an_tab($an_s["one"]),
    an_tab($an_s["add_assoc"]), an_tab($an_s["add_comm"]),
    an_tab($an_s["add_idl"]), an_tab($an_s["add_idr"]),
    an_tab($an_s["add_invl"]), an_tab($an_s["add_invr"]),
    an_tab($an_s["mul_assoc"]), an_tab($an_s["mul_idl"]),
    an_tab($an_s["mul_idr"]), an_tab($an_s["mul_comm"]),
    an_tab($an_s["dist_l"]), an_tab($an_s["dist_r"]),
    an_tab($an_s["zero_mul"]), an_tab($an_s["mul_zero"]),
    an_ctx($an_s["ctx"]))
  $an_r = an_ordre_ring("AnneauOrdreAbstrait", $an_r, an_tab($an_s["le"]),
    an_tab($an_s["le_refl"]), an_tab($an_s["le_trans"]),
    an_tab($an_s["le_antisymm"]), an_tab($an_s["le_add"]),
    an_tab($an_s["le_mul_nonneg"]), an_tab($an_s["zero_le_one"]),
    an_ctx($an_s["ctx"]))
  inserer($an_r,"pow",an_tab($an_s["pow"]))
  inserer($an_r,"pow_zero_ax",an_tab($an_s["pow_zero_ax"]))
  inserer($an_r,"pow_succ_ax",an_tab($an_s["pow_succ_ax"]))
  inserer($an_r,"memo",table())
  retour $an_r
}

# ── 4. Corpus GÉNÉRIQUE — addition et inverses (lemmes 1..26) ────────────────

fn an_lem_add_assoc4(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_d = noy_var("d")
  $an_ab = an_plus(an_s,$an_a,$an_b); $an_bc = an_plus(an_s,$an_b,$an_c)
  $an_cd = an_plus(an_s,$an_c,$an_d)
  $an_l = an_plus(an_s, an_plus(an_s,$an_ab,$an_c), $an_d)
  $an_m1 = an_plus(an_s, an_plus(an_s,$an_a,$an_bc), $an_d)
  $an_m2 = an_plus(an_s,$an_a, an_plus(an_s,$an_bc,$an_d))
  $an_r = an_plus(an_s,$an_a, an_plus(an_s,$an_b,$an_cd))
  $an_h1 = an_cd($an_A, an_add_de(an_s), $an_d, an_plus(an_s,$an_ab,$an_c), an_plus(an_s,$an_a,$an_bc), an_Laa(an_s,$an_a,$an_b,$an_c))
  $an_h2 = an_Laa(an_s,$an_a,$an_bc,$an_d)
  $an_h3 = an_cg($an_A, an_add_de(an_s), $an_a, an_plus(an_s,$an_bc,$an_d), an_plus(an_s,$an_b,$an_cd), an_Laa(an_s,$an_b,$an_c,$an_d))
  $an_corps = an_tr($an_A,$an_l,$an_m1,$an_r, $an_h1, an_tr($an_A,$an_m1,$an_m2,$an_r,$an_h2,$an_h3))
  retour an_pair(an_pi4($an_A, an_eq($an_A,$an_l,$an_r)), an_lam4($an_A,$an_corps))
}

fn an_lem_add_left_comm(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_x1 = an_plus(an_s,$an_a,an_plus(an_s,$an_b,$an_c))
  $an_x2 = an_plus(an_s,an_plus(an_s,$an_a,$an_b),$an_c)
  $an_x3 = an_plus(an_s,an_plus(an_s,$an_b,$an_a),$an_c)
  $an_x4 = an_plus(an_s,$an_b,an_plus(an_s,$an_a,$an_c))
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Laa(an_s,$an_a,$an_b,$an_c))
  $an_h2 = an_cd($an_A,an_add_de(an_s),$an_c,an_plus(an_s,$an_a,$an_b),an_plus(an_s,$an_b,$an_a),an_Lac(an_s,$an_a,$an_b))
  $an_h3 = an_Laa(an_s,$an_b,$an_a,$an_c)
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x4,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_x4,$an_h2,$an_h3))
  retour an_pair(an_pi3($an_A,an_eq($an_A,$an_x1,$an_x4)), an_lam3($an_A,$an_corps))
}

fn an_lem_add_right_comm(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c")
  $an_x1 = an_plus(an_s,an_plus(an_s,$an_a,$an_b),$an_c)
  $an_x2 = an_plus(an_s,$an_a,an_plus(an_s,$an_b,$an_c))
  $an_x3 = an_plus(an_s,$an_a,an_plus(an_s,$an_c,$an_b))
  $an_x4 = an_plus(an_s,an_plus(an_s,$an_a,$an_c),$an_b)
  $an_h1 = an_Laa(an_s,$an_a,$an_b,$an_c)
  $an_h2 = an_cg($an_A,an_add_de(an_s),$an_a,an_plus(an_s,$an_b,$an_c),an_plus(an_s,$an_c,$an_b),an_Lac(an_s,$an_b,$an_c))
  $an_h3 = an_sy($an_A,an_plus(an_s,an_plus(an_s,$an_a,$an_c),$an_b),$an_x3,an_Laa(an_s,$an_a,$an_c,$an_b))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x4,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_x4,$an_h2,$an_h3))
  retour an_pair(an_pi3($an_A,an_eq($an_A,$an_x1,$an_x4)), an_lam3($an_A,$an_corps))
}

fn an_lem_add_perm4(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  $an_a = noy_var("a"); $an_b = noy_var("b"); $an_c = noy_var("c"); $an_d = noy_var("d")
  $an_x1 = an_plus(an_s,an_plus(an_s,$an_a,$an_b),an_plus(an_s,$an_c,$an_d))
  $an_x2 = an_plus(an_s,an_plus(an_s,an_plus(an_s,$an_a,$an_b),$an_c),$an_d)
  $an_rc = an_loi_nom("add_right_comm",an_s)
  $an_rhs = ta_ap3($an_rc,$an_a,$an_b,$an_c)
  $an_x3 = an_plus(an_s,an_plus(an_s,an_plus(an_s,$an_a,$an_c),$an_b),$an_d)
  $an_x4 = an_plus(an_s,an_plus(an_s,$an_a,$an_c),an_plus(an_s,$an_b,$an_d))
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Laa(an_s,an_plus(an_s,$an_a,$an_b),$an_c,$an_d))
  $an_h2 = an_cd($an_A,an_add_de(an_s),$an_d,an_plus(an_s,an_plus(an_s,$an_a,$an_b),$an_c),an_plus(an_s,an_plus(an_s,$an_a,$an_c),$an_b),$an_rhs)
  $an_h3 = an_Laa(an_s,an_plus(an_s,$an_a,$an_c),$an_b,$an_d)
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_x4,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_x4,$an_h2,$an_h3))
  retour an_pair(an_pi4($an_A,an_eq($an_A,$an_x1,$an_x4)),an_lam4($an_A,$an_corps))
}

fn an_lem_add_zero_l(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a")
  retour an_pair(noy_pi("a",$an_A,an_eq($an_A,an_plus(an_s,an_zero(an_s),$an_a),$an_a)),
                 noy_lam("a",$an_A,an_Lazl(an_s,$an_a)))
}
fn an_lem_add_zero_d(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a")
  retour an_pair(noy_pi("a",$an_A,an_eq($an_A,an_plus(an_s,$an_a,an_zero(an_s)),$an_a)),
                 noy_lam("a",$an_A,an_Lazr(an_s,$an_a)))
}
fn an_lem_add_comm(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  retour an_pair(an_pi2($an_A,an_eq($an_A,an_plus(an_s,noy_var("a"),noy_var("b")),an_plus(an_s,noy_var("b"),noy_var("a")))),
                 an_lam2($an_A,an_Lac(an_s,noy_var("a"),noy_var("b"))))
}
fn an_lem_neg_add_cancel_l(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_x1 = an_plus(an_s,an_neg(an_s,$an_a),an_plus(an_s,$an_a,$an_b))
  $an_x2 = an_plus(an_s,an_plus(an_s,an_neg(an_s,$an_a),$an_a),$an_b)
  $an_x3 = an_plus(an_s,an_zero(an_s),$an_b)
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Laa(an_s,an_neg(an_s,$an_a),$an_a,$an_b))
  $an_h2 = an_cd($an_A,an_add_de(an_s),$an_b,an_plus(an_s,an_neg(an_s,$an_a),$an_a),an_zero(an_s),an_Linv_l(an_s,$an_a))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_b,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_b,$an_h2,an_Lazl(an_s,$an_b)))
  retour an_pair(an_pi2($an_A,an_eq($an_A,$an_x1,$an_b)),an_lam2($an_A,$an_corps))
}
fn an_lem_add_neg_cancel_l(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b")
  $an_x1 = an_plus(an_s,$an_a,an_plus(an_s,an_neg(an_s,$an_a),$an_b))
  $an_x2 = an_plus(an_s,an_plus(an_s,$an_a,an_neg(an_s,$an_a)),$an_b)
  $an_x3 = an_plus(an_s,an_zero(an_s),$an_b)
  $an_h1 = an_sy($an_A,$an_x2,$an_x1,an_Laa(an_s,$an_a,an_neg(an_s,$an_a),$an_b))
  $an_h2 = an_cd($an_A,an_add_de(an_s),$an_b,an_plus(an_s,$an_a,an_neg(an_s,$an_a)),an_zero(an_s),an_Linv_r(an_s,$an_a))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,$an_b,$an_h1,an_tr($an_A,$an_x2,$an_x3,$an_b,$an_h2,an_Lazl(an_s,$an_b)))
  retour an_pair(an_pi2($an_A,an_eq($an_A,$an_x1,$an_b)),an_lam2($an_A,$an_corps))
}
fn an_lem_neg_unique(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_h = noy_var("h")
  $an_hty = an_eq($an_A,an_plus(an_s,$an_b,$an_a),an_zero(an_s))
  $an_x1 = $an_b
  $an_x2 = an_plus(an_s,$an_b,an_zero(an_s))
  $an_x3 = an_plus(an_s,$an_b,an_plus(an_s,$an_a,an_neg(an_s,$an_a)))
  $an_x4 = an_plus(an_s,an_plus(an_s,$an_b,$an_a),an_neg(an_s,$an_a))
  $an_x5 = an_plus(an_s,an_zero(an_s),an_neg(an_s,$an_a))
  $an_h1 = an_sy($an_A,$an_x2,$an_b,an_Lazr(an_s,$an_b))
  $an_h2 = an_cg($an_A,an_add_de(an_s),$an_b,an_zero(an_s),an_plus(an_s,$an_a,an_neg(an_s,$an_a)),an_sy($an_A,an_plus(an_s,$an_a,an_neg(an_s,$an_a)),an_zero(an_s),an_Linv_r(an_s,$an_a)))
  $an_h3 = an_sy($an_A,$an_x4,$an_x3,an_Laa(an_s,$an_b,$an_a,an_neg(an_s,$an_a)))
  $an_h4 = an_cd($an_A,an_add_de(an_s),an_neg(an_s,$an_a),an_plus(an_s,$an_b,$an_a),an_zero(an_s),$an_h)
  $an_h5 = an_Lazl(an_s,an_neg(an_s,$an_a))
  $an_corps = an_tr($an_A,$an_x1,$an_x2,an_neg(an_s,$an_a),$an_h1,
               an_tr($an_A,$an_x2,$an_x3,an_neg(an_s,$an_a),$an_h2,
               an_tr($an_A,$an_x3,$an_x4,an_neg(an_s,$an_a),$an_h3,
               an_tr($an_A,$an_x4,$an_x5,an_neg(an_s,$an_a),$an_h4,$an_h5))))
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("h",$an_hty,an_eq($an_A,$an_b,an_neg(an_s,$an_a)))))
  $an_t = noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("h",$an_hty,$an_corps)))
  retour an_pair($an_but,$an_t)
}
fn an_lem_neg_zero(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_u = an_loi_nom("neg_unique",an_s)
  $an_corps = an_sy($an_A,an_zero(an_s),an_neg(an_s,an_zero(an_s)),
               ta_ap3($an_u,an_zero(an_s),an_zero(an_s),an_Lazl(an_s,an_zero(an_s))))
