fn an_lem_zero_le_one(an_s: table) -> table {
  $an_A = an_car_de(an_s)
  retour an_pair(noy_pi("x",$an_A,an_le(an_s,an_zero(an_s),an_one(an_s))),noy_lam("x",$an_A,an_champ(an_s,"zero_le_one")))
}
fn an_lem_mul_nonneg(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_h1 = noy_var("h1"); $an_h2 = noy_var("h2")
  $an_t1 = an_le(an_s,an_zero(an_s),$an_a); $an_t2 = an_le(an_s,an_zero(an_s),$an_b)
  $an_corps = an_Llemul(an_s,$an_a,$an_b,$an_h1,$an_h2)
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("h1",$an_t1,noy_pi("h2",$an_t2,
             an_le(an_s,an_zero(an_s),an_mul(an_s,$an_a,$an_b))))))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("h1",$an_t1,noy_lam("h2",$an_t2,$an_corps)))))
}
fn an_lem_mul_nonneg_swap(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_h1 = noy_var("h1"); $an_h2 = noy_var("h2")
  $an_t1 = an_le(an_s,an_zero(an_s),$an_a); $an_t2 = an_le(an_s,an_zero(an_s),$an_b)
  $an_corps = an_Llemul(an_s,$an_b,$an_a,$an_h2,$an_h1)
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("h1",$an_t1,noy_pi("h2",$an_t2,
             an_le(an_s,an_zero(an_s),an_mul(an_s,$an_b,$an_a))))))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("h1",$an_t1,noy_lam("h2",$an_t2,$an_corps)))))
}
fn an_lem_sq_nonneg_of_nonneg(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_h = noy_var("h")
  $an_mn = an_loi_nom("mul_nonneg",an_s)
  $an_ty = an_le(an_s,an_zero(an_s),$an_a)
  $an_corps = ta_ap4($an_mn,$an_a,$an_a,$an_h,$an_h)
  $an_but = noy_pi("a",$an_A,noy_pi("h",$an_ty,an_le(an_s,an_zero(an_s),an_mul(an_s,$an_a,$an_a))))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("h",$an_ty,$an_corps)))
}

fn an_lem_le_add_of_nonneg_right(an_s: table) -> table {
  $an_A = an_car_de(an_s); $an_a = noy_var("a"); $an_b = noy_var("b"); $an_h = noy_var("h")
  $an_loeq = an_loi_nom("le_of_eq",an_s); $an_lar = an_loi_nom("le_add_left",an_s)
  $an_x1 = $an_a; $an_x2 = an_plus(an_s,$an_a,an_zero(an_s)); $an_x3 = an_plus(an_s,$an_a,$an_b)
  $an_h1 = ta_ap3($an_loeq,$an_a,$an_x2,an_sy($an_A,$an_x2,$an_a,an_Lazr(an_s,$an_a)))
  $an_h2 = ta_ap4($an_lar,an_zero(an_s),$an_b,$an_a,$an_h)
  $an_corps = an_Llet(an_s,$an_x1,$an_x2,$an_x3,$an_h1,$an_h2)
  $an_but = noy_pi("a",$an_A,noy_pi("b",$an_A,noy_pi("h",an_le(an_s,an_zero(an_s),$an_b),
             an_le(an_s,$an_a,an_plus(an_s,$an_a,$an_b)))))
  retour an_pair($an_but,noy_lam("a",$an_A,noy_lam("b",$an_A,noy_lam("h",an_le(an_s,an_zero(an_s),$an_b),$an_corps))))
}

# ── 9. Instances publiques ───────────────────────────────────────────────────

# Terme vérifié de commutativité de la multiplication de Nat. Aucune loi
# supplémentaire : il est obtenu par induction à partir des équations de ×
# (mult_0_r, mult_s_r) et des lemmes déjà vérifiés de algebre.rose.
fn an_term_mult_comm() -> table {
  $an_but = noy_pi("m", ta_nat(), noy_pi("n", ta_nat(),
             al_eq(al_mult(noy_var("m"),noy_var("n")),
                   al_mult(noy_var("n"),noy_var("m")))))
  $an_r0 = induction($an_but, ta_ctx())
  $an_k = ta_txt($an_r0, "nom_n")
  $an_ih = ta_txt($an_r0, "nom_ih")
  $an_base = noy_lam("n", ta_nat(),
    al_trans(al_mult(ta_zero(),noy_var("n")), ta_zero(),
             al_mult(noy_var("n"),ta_zero()),
             ta_ap1(al_term_mult_zero_g(), noy_var("n")),
             al_symm(ta_zero(), al_mult(noy_var("n"),ta_zero()), al_mult0r(noy_var("n")))))
  $an_h1 = ta_ap2(al_term_mult_succ_g(), noy_var("n"), noy_var($an_k))
  $an_h2 = al_congr_plus(al_mult(noy_var($an_k),noy_var("n")),
                         al_mult(noy_var("n"),noy_var($an_k)),
                         noy_var("n"), ta_ap1(noy_var($an_ih),noy_var("n")))
  $an_h3 = al_symm(al_mult(noy_var("n"),ta_succ(noy_var($an_k))),
                   ta_plus(al_mult(noy_var("n"),noy_var($an_k)),noy_var("n")),
                   al_multsr(noy_var("n"),noy_var($an_k)))
  $an_corps = al_trans(al_mult(ta_succ(noy_var($an_k)),noy_var("n")),
              ta_plus(al_mult(noy_var($an_k),noy_var("n")),noy_var("n")),
              al_mult(noy_var("n"),ta_succ(noy_var($an_k))), $an_h1,
              al_trans(ta_plus(al_mult(noy_var($an_k),noy_var("n")),noy_var("n")),
                       ta_plus(al_mult(noy_var("n"),noy_var($an_k)),noy_var("n")),
                       al_mult(noy_var("n"),ta_succ(noy_var($an_k))), $an_h2, $an_h3))
  $an_pas = noy_lam($an_k, ta_nat(),
              noy_lam($an_ih, noy_pi("n",ta_nat(),
                al_eq(al_mult(noy_var($an_k),noy_var("n")),
                      al_mult(noy_var("n"),noy_var($an_k)))),
              noy_lam("n", ta_nat(), $an_corps)))
  $an_rf = induction_resolue($an_but, ta_ctx(), $an_base, $an_pas)
  retour an_tab(noy_champ($an_rf,"terme"))
}

fn an_inst_nat() -> table {
  $an_assoc_m = mg_loi(al_lem_mult_assoc())
  $an_assoc_std = noy_lam("x", ta_nat(), noy_lam("y", ta_nat(),
                    noy_lam("z", ta_nat(),
                      ta_ap3($an_assoc_m, noy_var("z"), noy_var("x"), noy_var("y")))))
  $an_comm_add = noy_lam("a", ta_nat(), noy_lam("b", ta_nat(),
                    al_plus_comm(noy_var("a"),noy_var("b"))))
  $an_dist_g = mg_loi(al_lem_mult_distrib_g())
  $an_dist_d = mg_loi(al_lem_mult_distrib_d())
  $an_dl = noy_lam("a", ta_nat(), noy_lam("b", ta_nat(), noy_lam("c", ta_nat(),
                    ta_ap3($an_dist_g, noy_var("c"), noy_var("a"), noy_var("b")))))
  $an_dr = noy_lam("a", ta_nat(), noy_lam("b", ta_nat(), noy_lam("c", ta_nat(),
                    ta_ap3($an_dist_d, noy_var("c"), noy_var("a"), noy_var("b")))))
  $an_r = an_semiring("Nat/Semiring", ta_nat(), ta_plus_symbole(), ta_zero(),
                      al_mult_symbole(), al_un(),
                      mg_loi(al_lem_plus_assoc()), $an_comm_add,
                      mg_loi(al_lem_plus_zero_l()), mg_loi(al_lem_plus_zero_d()),
                      $an_assoc_std,
                      mg_loi(al_lem_mult_un_g()), mg_loi(al_lem_mult_un_d()),
                      $an_dl, $an_dr,
                      mg_loi(al_lem_mult_zero_g()), mg_loi(al_lem_mult_zero_d()),
                      ta_ctx())
  inserer($an_r,"structure","Semiring")
  inserer($an_r,"classe","Semiring")
  # Ordre de M1 réutilisé : lois certifiées, aucun axiome nouveau.
  inserer($an_r,"le",al_le_symbole())
  inserer($an_r,"le_refl",mg_loi(al_lem_le_refl()))
  inserer($an_r,"le_trans",mg_loi(al_lem_le_trans()))
  inserer($an_r,"le_antisymm",mg_loi(al_lem_le_antisymm()))
  inserer($an_r,"le_add",mg_loi(al_lem_le_plus_compatible_d()))
  $an_zle1 = noy_lam("x",ta_nat(),al_le_zero(al_un()))
  inserer($an_r,"zero_le_one",$an_zle1)
  retour $an_r
}

fn an_registre() -> liste<table> {
  $an_r = [table()]
  joindre($an_r, an_inst_nat())
  joindre($an_r, an_inst_abstrait())
  retour $an_r
}

fn an_registre_complet() -> liste<table> {
  $an_r = ord_registre_complet()
  $an_a = an_registre()
  $an_n = longueur($an_a)
  $an_k = 1
  tant_que ($an_k < $an_n) {
    $an_i = an_tab($an_a[$an_k])
    si (noy_est_absent(mg_registre_trouver($an_r, mg_nom_champ($an_i)))) {
      joindre($an_r, $an_i)
    }
    $an_k = $an_k + 1
  }
  retour $an_r
}




