# ═══════════════════════════════════════════════════════════════════════════
# thorn/src/principal.rose — PILOTE CLI DE THORN (PROV4)
# ═══════════════════════════════════════════════════════════════════════════
# Consommateur des modules des autres agents (SPEC.md) :
#   noyau.rose     : verifier, beta, convertible, bien_forme, noy_ctx_vide
#   lexeur.rose    : lexer
#   analyse.rose   : analyser
#   tactiques.rose : reflexivite, symetrie, introduction, application,
#                    induction, simplifier
# Aucune règle de typage, d'analyse ou de tactique n'est réimplémentée ici.
# Vérifier : ./rose/rose verif thorn/src/principal.rose
# ═══════════════════════════════════════════════════════════════════════════

importer "thorn/src/tactiques.rose"
importer "thorn/src/analyse.rose"
importer "thorn/src/noyau.rose"
importer "thorn/src/lexeur.rose"

# ── 1. Petits services sur chaînes et listes ───────────────────────────────

fn p_saut() -> chaine { retour caractere(10) }

fn p_sans_fin(s: chaine) -> chaine {
  $sf_n = longueur(s)
  si ($sf_n > 0 et sous_chaine(s, $sf_n - 1, $sf_n) == p_saut()) {
    retour sous_chaine(s, 0, $sf_n - 1)
  }
  retour s
}

fn p_est_blanc(c: chaine) -> booleen {
  retour c == " " ou c == "\t" ou c == "\n" ou c == "\r"
}

fn p_trim(s: chaine) -> chaine {
  $tm_a = 0
  $tm_b = longueur(s)
  tant_que ($tm_a < $tm_b et p_est_blanc(sous_chaine(s, $tm_a, $tm_a + 1))) {
    $tm_a = $tm_a + 1
  }
  tant_que ($tm_b > $tm_a et p_est_blanc(sous_chaine(s, $tm_b - 1, $tm_b))) {
    $tm_b = $tm_b - 1
  }
  retour sous_chaine(s, $tm_a, $tm_b)
}

fn p_theoreme_mot(s: chaine) -> booleen {
  retour s == "théorème" ou s == "theoreme"
}

fn p_preuve_mot(s: chaine) -> booleen {
  retour s == "preuve" ou s == "preuv" ou s == "proof"
}

# Les jetons produits par lexer() peuvent être 0-indexés ou comporter un
# sentinelle vide en 0 selon les versions du lexeur. On normalise TOUJOURS
# en [sentinelle, jeton_0, jeton_1, ...] pour rendre les découpages sûrs.
fn p_norm(j: liste<chaine>) -> liste<chaine> {
  $nm_r = [""]
  $nm_n = longueur(j)
  $nm_deb = 0
  si ($nm_n > 1 et j[0] == "") { $nm_deb = 1 }
  $nm_i = $nm_deb
  tant_que ($nm_i < $nm_n) {
    joindre($nm_r, j[$nm_i])
    $nm_i = $nm_i + 1
  }
  retour $nm_r
}

# Tranche [debut, fin[ d'une liste normalisée (1 = premier jeton).
fn p_tranche(j: liste<chaine>, debut: entier, fin: entier) -> liste<chaine> {
  $tr_r = [""]
  $tr_i = debut
  $tr_lim = longueur(j)
  si (fin < $tr_lim) { $tr_lim = fin }
  tant_que ($tr_i < $tr_lim) {
    joindre($tr_r, j[$tr_i])
    $tr_i = $tr_i + 1
  }
  retour $tr_r
}

# analyser() de PROV2 attend une liste 0-indexee (pas de sentinelle).
fn p_liste_vide_thorn() {
  retour valeurs(table())
}

fn p_sans_sentinel(j: liste<chaine>) -> liste<chaine> {
  $ss_r = [""]
  $ss_vide = p_liste_vide_thorn()
  $ss_r = $ss_vide
  $ss_n = longueur(j)
  $ss_i = 1
  tant_que ($ss_i < $ss_n) {
    joindre($ss_r, j[$ss_i])
    $ss_i = $ss_i + 1
  }
  retour $ss_r
}

fn p_cherche(j: liste<chaine>, mot: chaine, debut: entier, fin: entier) -> entier {
  $ch_i = debut
  $ch_lim = longueur(j)
  si (fin < $ch_lim) { $ch_lim = fin }
  tant_que ($ch_i < $ch_lim) {
    si (j[$ch_i] == mot) { retour $ch_i }
    $ch_i = $ch_i + 1
  }
  retour -1
}

fn p_cherche_theoreme(j: liste<chaine>, debut: entier) -> entier {
  $ct_i = debut
  $ct_n = longueur(j)
  tant_que ($ct_i < $ct_n) {
    si (p_theoreme_mot(j[$ct_i])) { retour $ct_i }
    $ct_i = $ct_i + 1
  }
  retour -1
}

fn p_cherche_preuve(j: liste<chaine>, debut: entier, fin: entier) -> entier {
  $cp_i = debut
  $cp_lim = longueur(j)
  si (fin < $cp_lim) { $cp_lim = fin }
  tant_que ($cp_i < $cp_lim) {
    si (p_preuve_mot(j[$cp_i])) { retour $cp_i }
    $cp_i = $cp_i + 1
  }
  retour -1
}

# ── 2. Découpage d'un flux de jetons en déclarations ───────────────────────

# Chaque déclaration : {nom, but (liste<chaine>), preuve (liste<chaine>)}.
fn p_declarations(j: liste<chaine>) -> table {
  $dc_decls = table()
  inserer($dc_decls, "n", 0)
  $dc_c = 0
  $dc_pos = p_cherche_theoreme(j, 1)
  tant_que ($dc_pos > 0) {
    $dc_suiv = p_cherche_theoreme(j, $dc_pos + 1)
    $dc_fin_bloc = $dc_suiv
    si ($dc_fin_bloc < 0) { $dc_fin_bloc = longueur(j) }

    $dc_nom = "sans_nom"
    si ($dc_pos + 1 < $dc_fin_bloc) {
      $dc_cand = j[$dc_pos + 1]
      si ($dc_cand != ":" et non p_theoreme_mot($dc_cand) et non p_preuve_mot($dc_cand)) {
        $dc_nom = $dc_cand
      }
    }

    $dc_pp = p_cherche_preuve(j, $dc_pos + 1, $dc_fin_bloc)
    $dc_deux = p_cherche(j, ":", $dc_pos + 1, $dc_fin_bloc)
    $dc_deb_but = $dc_pos + 2
    si ($dc_deux >= 0) { $dc_deb_but = $dc_deux + 1 }
    $dc_fin_but = $dc_fin_bloc
    si ($dc_pp >= 0 et $dc_pp < $dc_fin_but) { $dc_fin_but = $dc_pp }
    si ($dc_deb_but > $dc_fin_but) { $dc_deb_but = $dc_fin_but }

    $dc_preuve = [""]
    si ($dc_pp >= 0) {
      $dc_fin_preuve = $dc_fin_bloc
      $dc_fin_mot = p_cherche(j, "fin", $dc_pp + 1, $dc_fin_bloc)
      si ($dc_fin_mot >= 0) { $dc_fin_preuve = $dc_fin_mot }
      $dc_preuve = p_tranche(j, $dc_pp + 1, $dc_fin_preuve)
    }

    $dc_une = table()
    inserer($dc_une, "nom", $dc_nom)
    inserer($dc_une, "but", p_tranche(j, $dc_deb_but, $dc_fin_but))
    inserer($dc_une, "preuve", $dc_preuve)
    inserer($dc_decls, chaine($dc_c), $dc_une)
    $dc_c = $dc_c + 1
    si ($dc_suiv < 0) { $dc_pos = -1 } sinon { $dc_pos = $dc_suiv }
  }
  inserer($dc_decls, "n", $dc_c)
  retour $dc_decls
}

# ── 3. Analyse d'un but (module PROV2) ─────────────────────────────────────

fn p_est_terme(t) -> booleen {
  si (type(t) != "table") { retour faux }
  retour cle_existe(t, "genre")
}

fn p_analyser_but(j: liste<chaine>) -> table {
  $ab_r = table()
  $ab_e = ""
  essayer {
    $ab_r = analyser(p_sans_sentinel(j))
  } attraper($ab_e) {
    $ab_r = table()
  }
  # Certains parseurs rendent un nœud théorème : on accepte ses champs
  # « type » / « but » / « terme » s'ils sont présents.
  si (type($ab_r) == "table" et non p_est_terme($ab_r)) {
    si (cle_existe($ab_r, "type") et p_est_terme($ab_r["type"])) {
      $ab_r = $ab_r["type"]
    } sinon {
      si (cle_existe($ab_r, "but") et p_est_terme($ab_r["but"])) {
        $ab_r = $ab_r["but"]
      }
    }
  }
  retour $ab_r
}

# ── 4. Trace lisible ───────────────────────────────────────────────────────

fn p_montrer(t, prof: entier) -> chaine {
  si (type(t) != "table") { retour chaine(t) }
  si (prof > 4) { retour "…" }
  $mt_g = "?"
  si (cle_existe(t, "genre")) { $mt_g = chaine(t["genre"]) }
  $mt_s = $mt_g
  si (cle_existe(t, "nom")) { $mt_s = $mt_s + "(" + chaine(t["nom"]) + ")" }
  si (cle_existe(t, "niveau")) { $mt_s = $mt_s + "[" + chaine(t["niveau"]) + "]" }
  $mt_p = prof + 1
  si (cle_existe(t, "domaine")) {
    $mt_s = $mt_s + "(" + p_montrer(t["domaine"], $mt_p) + " -> " + p_montrer(t["codomaine"], $mt_p) + ")"
  }
  si (cle_existe(t, "corps")) {
    $mt_s = $mt_s + "(corps " + p_montrer(t["corps"], $mt_p) + ")"
  }
  si (cle_existe(t, "fonction")) {
    $mt_s = $mt_s + "(" + p_montrer(t["fonction"], $mt_p) + " " + p_montrer(t["argument"], $mt_p) + ")"
  }
  si (cle_existe(t, "type")) {
    $mt_s = $mt_s + " : " + p_montrer(t["type"], $mt_p)
  }
  retour $mt_s
}

fn p_ajoute_trace(sortie: table, nom: chaine, etiquette: chaine, t) {
  $at_s0 = sortie["s"]
  inserer(sortie, "s", $at_s0 + "  [trace] " + nom + " " + etiquette + " = " + p_montrer(t, 0) + p_saut())
}

# ── 5. Résultats de tactiques (module PROV3) ───────────────────────────────

fn p_ok(r) -> booleen {
  si (type(r) != "table") { retour faux }
  si (non cle_existe(r, "ok")) { retour faux }
  retour r["ok"] == vrai
}

fn p_raison(r) -> chaine {
  si (type(r) != "table") { retour "résultat inattendu" }
  si (cle_existe(r, "erreur") et chaine(r["erreur"]) != "") {
    retour chaine(r["erreur"])
  }
  si (cle_existe(r, "raison") et chaine(r["raison"]) != "") {
    retour chaine(r["raison"])
  }
  retour "raison inconnue"
}

fn p_buts_restants(r) -> entier {
  $br_n = 0
  si (type(r) == "table" et cle_existe(r, "buts")) {
    $br_b = r["buts"]
    si (type($br_b) == "table" et cle_existe($br_b, "n")) {
      $br_n = $br_b["n"]
    }
  }
  retour $br_n
}

# Une tactique est appelée UNIQUEMENT via les signatures de SPEC.md.
fn p_tactique(nom: chaine, but: table, ctx: liste<table>, preuve: liste<chaine>, sortie: table, trace: booleen, theoreme: chaine) -> table {
  $ta_r = table()
  $ta_e = ""
  essayer {
    si (nom == "reflexivite" ou nom == "réflexivité" ou nom == "refl") {
      $ta_r = reflexivite(but)
    } sinon {
      si (nom == "symetrie" ou nom == "symétrie" ou nom == "sym") {
        $ta_r = symetrie(but)
      } sinon {
        si (nom == "introduction" ou nom == "intro") {
          $ta_r = introduction(but, ctx)
        } sinon {
          si (nom == "application" ou nom == "app") {
            $ta_r = application(but, ctx)
          } sinon {
            si (nom == "induction" ou nom == "ind") {
              $ta_r = induction(but, ctx)
            } sinon {
              $ta_r = simplifier(but)
            }
          }
        }
      }
    }
  } attraper($ta_e) {
    inserer($ta_r, "ok", faux)
    inserer($ta_r, "erreur", "tactique " + nom + " : " + $ta_e)
  }
  retour $ta_r
}

fn p_est_tactique(s: chaine) -> booleen {
  retour s == "reflexivite" ou s == "réflexivité" ou s == "refl" ou s == "symetrie" ou s == "symétrie" ou s == "sym" ou s == "introduction" ou s == "intro" ou s == "application" ou s == "app" ou s == "appliquer" ou s == "induction" ou s == "ind" ou s == "simplifier" ou s == "simplification"
}

fn p_debut_commande(s: chaine) -> booleen {
  retour p_est_tactique(s) ou s == "cas" ou s == "fin"
}

# Nombre de buts residuels d'un Resultat PROV3 (liste rembourree).
fn p_nb_buts(r) -> entier {
  $n = 0
  si (type(r) == "table" et cle_existe(r, "buts")) {
    $b = [table()]
    $b = r["buts"]
    si (type($b) == "liste") { $n = longueur($b) - 1 }
  }
  si ($n < 0) { $n = 0 }
  retour $n
}

# ── 5b. Sequenceur de tactiques (scripts multi-lignes des preuves) ─────────

fn p_cmds_vides() -> table {
  $r = table()
  inserer($r, "n", 0)
  retour $r
}

fn p_cmds_ajoute(cmds: table, c: table) {
  $n = cmds["n"]
  inserer(cmds, chaine($n + 1), c)
  inserer(cmds, "n", $n + 1)
}

fn p_liste_depuis(j: liste<chaine>, debut: entier, fin: entier) -> liste<chaine> {
  $r = [""]
  $r = p_liste_vide_thorn()
  $i = debut
  tant_que ($i < fin et $i < longueur(j)) {
    joindre($r, j[$i])
    $i = $i + 1
  }
  retour $r
}

# Decoupe le flux de jetons en commandes. Une commande `cas` porte ses
# propres sous-commandes ; `appliquer` porte les jetons du terme a elaborer.
fn p_parse_cmds(j: liste<chaine>, debut: entier, fin: entier) -> table {
  $cmds = p_cmds_vides()
  $i = debut
  tant_que ($i < fin et $i < longueur(j)) {
    $mot = j[$i]
    $c = table()
    si ($mot == "reflexivite" ou $mot == "réflexivité" ou $mot == "refl") {
      inserer($c, "genre", "t")
      inserer($c, "nom", "reflexivite")
      inserer($c, "arg", "")
      p_cmds_ajoute($cmds, $c)
      $i = $i + 1
    } sinon si ($mot == "symetrie" ou $mot == "symétrie" ou $mot == "sym") {
      inserer($c, "genre", "t")
      inserer($c, "nom", "symetrie")
      inserer($c, "arg", "")
      p_cmds_ajoute($cmds, $c)
      $i = $i + 1
    } sinon si ($mot == "introduction" ou $mot == "intro") {
      $arg = ""
      si ($i + 1 < fin) { $arg = j[$i + 1] }
      inserer($c, "genre", "t")
      inserer($c, "nom", "introduction")
      inserer($c, "arg", $arg)
      p_cmds_ajoute($cmds, $c)
      $i = $i + 2
    } sinon si ($mot == "induction" ou $mot == "ind") {
      $arg = ""
      si ($i + 1 < fin) { $arg = j[$i + 1] }
      inserer($c, "genre", "t")
      inserer($c, "nom", "induction")
      inserer($c, "arg", $arg)
      p_cmds_ajoute($cmds, $c)
      $i = $i + 2
    } sinon si ($mot == "application" ou $mot == "app" ou $mot == "appliquer") {
      $dt = $i + 1
      $ft = $dt
      tant_que ($ft < fin et non p_debut_commande(j[$ft])) { $ft = $ft + 1 }
      inserer($c, "genre", "t")
      inserer($c, "nom", "appliquer")
      inserer($c, "arg", "")
      inserer($c, "tokens", p_liste_depuis(j, $dt, $ft))
      p_cmds_ajoute($cmds, $c)
      $i = $ft
    } sinon si ($mot == "cas") {
      $motif = ""
      si ($i + 1 < fin) { $motif = j[$i + 1] }
      $k = $i + 2
      $params = [""]
      $params = p_liste_vide_thorn()
      tant_que ($k < fin et j[$k] != ":") {
        joindre($params, j[$k])
        $k = $k + 1
      }
      si ($k < fin et j[$k] == ":") { $k = $k + 1 }
      $fs = $k
      tant_que ($fs < fin et j[$fs] != "cas") { $fs = $fs + 1 }
      inserer($c, "genre", "cas")
      inserer($c, "motif", $motif)
      inserer($c, "params", $params)
      inserer($c, "cmds", p_parse_cmds(j, $k, $fs))
      p_cmds_ajoute($cmds, $c)
      $i = $fs
    } sinon {
      $i = $i + 1
    }
  }
  retour $cmds
}

fn p_etat(but, ctx: liste<table>, terme, trou: chaine) -> table {
  $s = table()
  inserer($s, "ok", vrai)
  inserer($s, "err", "")
  inserer($s, "but", but)
  inserer($s, "ctx", ctx)
  inserer($s, "terme", terme)
  inserer($s, "trou", trou)
  inserer($s, "ind", table())
  inserer($s, "nb_cas", 0)
  retour $s
}

fn p_echoue(st: table, msg: chaine) {
  inserer(st, "ok", faux)
  inserer(st, "err", msg)
}

fn p_st_ok(st: table) -> booleen {
  $v = faux
  $v = st["ok"]
  retour $v
}

fn p_comme_table(x) -> table {
  $v = table()
  $v = x
  retour $v
}

# Remplissage de trou SANS evitement de capture. Les noms de troux sont
# generes frais ("?_", "?0", "?base", ...) et ne peuvent donc pas etre
# confondus avec un lieur du terme. noy_subst(), lui, renomme les lieurs
# des que la valeur inseree contient un nom libre commun : applique a un
# remplissage de trou, il casserait les references (mesure : identite
# donnait lambda A'. lambda x'. ... avec un `A` libre dans le domaine).
fn p_subst_brut_liste(l: liste<table>, nom: chaine, val: table) -> liste<table> {
  $r = [table()]
  $n = longueur(l)
  $i = 1
  tant_que ($i < $n) { joindre($r, p_subst_brut(l[$i], nom, val)); $i = $i + 1 }
  retour $r
}

fn p_subst_brut(t: table, nom: chaine, val: table) -> table {
  $g = noy_genre(t)
  si ($g == "var") {
    si (noy_nom(t) == nom) { retour val }
    retour t
  }
  si ($g == "app") {
    retour noy_app(p_subst_brut(noy_champ(t, "fonction"), nom, val),
                   p_subst_brut(noy_champ(t, "argument"), nom, val))
  }
  si ($g == "pi") {
    retour noy_pi(noy_nom(t),
                  p_subst_brut(noy_champ(t, "domaine"), nom, val),
                  p_subst_brut(noy_champ(t, "codomaine"), nom, val))
  }
  si ($g == "lam") {
    retour noy_lam(noy_nom(t),
                   p_subst_brut(noy_champ(t, "domaine"), nom, val),
                   p_subst_brut(noy_champ(t, "corps"), nom, val))
  }
  si ($g == "const" ou $g == "constructeur") {
    $ty = p_subst_brut(noy_champ(t, "type"), nom, val)
    si ($g == "const") { retour noy_const(noy_nom(t), $ty) }
    retour noy_constructeur(noy_nom(t), $ty)
  }
  si ($g == "ind") {
    retour noy_ind(noy_nom(t), p_subst_brut_liste(noy_champ_liste(t, "params"), nom, val))
  }
  si ($g == "elim") {
    retour noy_elim(noy_nom(t),
                    p_subst_brut(noy_champ(t, "motif"), nom, val),
                    p_subst_brut_liste(noy_champ_liste(t, "branches"), nom, val))
  }
  retour t
}

fn p_exec_cas(c: table, st: table, sortie: table, trace: booleen, theoreme: chaine) {
  $r = st["ind"]
  si (type($r) != "table" ou non cle_existe($r, "trou_base")) {
    p_echoue(st, "cas : aucune induction en cours")
    retour table()
  }
  $num = st["nb_cas"] + 1
  inserer(st, "nb_cas", $num)
  $buts = $r["buts"]
  $ctxs = $r["ctxs"]
  $but0 = table()
  $ctx0 = [table()]
  $ctx0 = st["ctx"]
  $trou = ""
  si ($num == 1) {
    $but0 = $buts[1]
    $ctx0 = [table()]
    $ctx0 = $ctxs[0]
    $trou = chaine($r["trou_base"])
  } sinon {
    $but0 = $buts[2]
    $ctx0 = [table()]
    $ctx0 = $ctxs[1]
    $trou = chaine($r["trou_pas"])
  }

  # `cas zero :` n'a pas de parametres ; `cas succ k ih :` en a deux. On
  # depouille les Pi correspondants du but residuel et on pre-construit les
  # lambda qui fermeront le terme de preuve de cette branche.
  $squelette = noy_var("?_")
  $butc = $but0
  $params = [""]
  $params = $c["params"]
  $nbp = longueur($params)
  # p_parse_cmds produit une liste de NOMS 0-indexee non rembourree.
  # Une eventuelle sentinelle est une chaine vide.
  si ($nbp > 0 et $params[0] == "") { $nbp = $nbp - 1 }
  $ns = [""]
  $ds = [table()]
  $k = 1
  tant_que ($k <= $nbp) {
    si (noy_genre($butc) != "pi") {
      p_echoue(st, "cas : but residuel inattendu")
      retour table()
    }
    joindre($ns, noy_nom($butc))
    joindre($ds, noy_champ($butc, "domaine"))
    $butc = noy_champ($butc, "codomaine")
    $k = $k + 1
  }
  # On enveloppe de la fin vers le debut : le premier PI devient le
  # lambda EXTERIEUR (sinon `cas succ k ih` donnerait lambda ih. lambda k,
  # et le type de ih, qui contient k, aurait un k libre).
  $j = $nbp
  tant_que ($j >= 1) {
    $squelette = noy_lam($ns[$j], $ds[$j], $squelette)
    $j = $j - 1
  }

  $etat = p_etat($butc, $ctx0, $squelette, "?_")
  $sous = table()
  $sous = $c["cmds"]
  p_exec_cmds($sous, $etat, sortie, trace, theoreme)
  si (non p_st_ok($etat)) {
    p_echoue(st, chaine($etat["err"]))
    retour table()
  }
  si (chaine($etat["trou"]) != "?_ferme") {
    p_echoue(st, "cas " + chaine($c["motif"]) + " : preuve incomplete")
    retour table()
  }
  inserer(st, "terme", p_subst_brut(p_comme_table(st["terme"]), $trou, p_comme_table($etat["terme"])))
  si ($num >= 2) { inserer(st, "trou", "?_ferme") }
}

# Execute une liste de commandes ; l'etat porte le but courant, le contexte,
# le squelette de terme et le nom du trou encore ouvert.
fn p_exec_cmds(cmds: table, st: table, sortie: table, trace: booleen, theoreme: chaine) {
  $n = cmds["n"]
  $i = 1
  tant_que ($i <= $n et p_st_ok(st)) {
    $c = table()
    $c = cmds[chaine($i)]
    si (chaine($c["genre"]) == "cas") {
      p_exec_cas($c, st, sortie, trace, theoreme)
    } sinon {
      $nom = chaine($c["nom"])
      $but = p_comme_table(st["but"])
      $ctx = [table()]
      $ctx = st["ctx"]
      $r = table()
      $e = ""
      essayer {
        si ($nom == "appliquer") {
          $jets = [""]
          $jets = $c["tokens"]
          $tm = p_comme_table(analyser($jets))
          $tm = ta_resoudre($tm, $ctx)
          $v = verifier($tm, $ctx)
          si (non p_ok($v)) {
            inserer($r, "ok", faux)
            inserer($r, "erreur", "appliquer : noyau refuse : " + p_raison($v))
          } sinon {
            si (non convertible(p_comme_table($v["type"]), $but)) {
              inserer($r, "ok", faux)
              inserer($r, "erreur", "appliquer : type de la preuve ≠ but")
            } sinon {
              inserer($r, "ok", vrai)
              inserer($r, "terme", $tm)
              si (trace) { p_ajoute_trace(sortie, theoreme, "appliquer", $tm) }
            }
          }
        } sinon {
          $vides = [""]
          $r = p_tactique($nom, $but, $ctx, $vides, sortie, trace, theoreme)
        }
      } attraper($e) {
        inserer($r, "ok", faux)
        inserer($r, "erreur", $nom + " : " + $e)
      }
      si (non p_ok($r)) {
        p_echoue(st, p_raison($r))
      } sinon {
        $nb = p_nb_buts($r)
        si ($nom == "introduction" et $nb < 1) {
          p_echoue(st, "introduction : aucun but residuel")
        } sinon {
          si ($nom == "induction" et $nb < 2) {
            p_echoue(st, "induction : branches manquantes")
          } sinon {
            $terme = p_subst_brut(p_comme_table(st["terme"]), chaine(st["trou"]), p_comme_table($r["terme"]))
            inserer(st, "terme", $terme)
            si (trace) { p_ajoute_trace(sortie, theoreme, "terme", $terme) }
            si ($nom == "introduction") {
              inserer(st, "trou", chaine($r["trou"]))
              inserer(st, "but", $r["buts"][1])
              inserer(st, "ctx", $r["ctxs"][0])
            } sinon {
              si ($nom == "induction") {
                inserer(st, "ind", $r)
                inserer(st, "nb_cas", 0)
              } sinon {
                inserer(st, "trou", "?_ferme")
              }
            }
          }
        }
      }
    }
    $i = $i + 1
  }
}

# Preuve directe : la ligne « preuve » est un terme, pas une tactique.
fn p_preuve_terme(preuve: liste<chaine>) -> table {
  $pt_t = table()
  $pt_e = ""
  essayer {
    $pt_t = analyser(p_sans_sentinel(preuve))
  } attraper($pt_e) {
    $pt_t = table()
  }
  retour $pt_t
}

# ── 6. Moteur du pilote ────────────────────────────────────────────────────

# Exécute un fichier .thn. Rend {sortie, code, total, reussis, lecture}.
fn pilote_executer(chemin: chaine, trace: booleen) -> table {
  $pe_res = table()
  inserer($pe_res, "sortie", "")
  inserer($pe_res, "code", 2)
  inserer($pe_res, "total", 0)
  inserer($pe_res, "reussis", 0)
  inserer($pe_res, "lecture", faux)

  $pe_src = ""
  $pe_e = ""
  $pe_lu = faux
  essayer {
    $pe_src = lire_texte(chemin)
    $pe_lu = vrai
    inserer($pe_res, "lecture", vrai)
  } attraper($pe_e) {
    $pe_e = $pe_e
  }
  si (non $pe_lu) {
    inserer($pe_res, "sortie", $pe_e)
    retour $pe_res
  }

  $pe_j = [""]
  $pe_brut = [""]
  essayer {
    $pe_brut = lexer($pe_src)
    $pe_j = p_norm($pe_brut)
  } attraper($pe_e) {
    inserer($pe_res, "sortie", "lexage impossible (" + chemin + ") : " + $pe_e)
    retour $pe_res
  }

  $pe_decls = p_declarations($pe_j)
  $pe_total = $pe_decls["n"]
  $pe_reussis = 0
  $pe_sortie = table()
  inserer($pe_sortie, "s", "")
  $pe_ctx = noy_ctx_vide()
  $pe_parse = faux
  $pe_i = 0

  tant_que ($pe_i < $pe_total) {
    $pe_d = $pe_decls[chaine($pe_i)]
    $pe_nom = chaine($pe_d["nom"])
    $pe_but_j = [""]
    $pe_but_j = $pe_d["but"]
    $pe_but = p_analyser_but($pe_but_j)
    # Normalisation syntaxique vers le format canonique PROV1/PROV3.
    si (p_est_terme($pe_but)) { $pe_but = ta_normalise($pe_but) }
    $pe_ligne = ""
    $pe_erreur_parse = ""

    si (non p_est_terme($pe_but)) {
      $pe_parse = vrai
      $pe_ligne = "ÉCHEC " + $pe_nom + " : analyse du but impossible"
    } sinon {
      si (trace) { p_ajoute_trace($pe_sortie, $pe_nom, "but", $pe_but) }
      $pe_vbut = verifier($pe_but, $pe_ctx)
      si (non p_ok($pe_vbut)) {
        $pe_ligne = "ÉCHEC " + $pe_nom + " : type invalide — " + p_raison($pe_vbut)
      } sinon {
        $pe_preuve = [""]
        $pe_preuve = $pe_d["preuve"]
        $pe_terme = table()

        si (longueur($pe_preuve) <= 1) {
          $pe_ligne = "ÉCHEC " + $pe_nom + " : aucune preuve fournie"
        } sinon {
          si (p_debut_commande($pe_preuve[1])) {
            $pe_cmds = p_parse_cmds($pe_preuve, 1, longueur($pe_preuve))
            $pe_etat = p_etat($pe_but, $pe_ctx, noy_var("?_"), "?_")
            p_exec_cmds($pe_cmds, $pe_etat, $pe_sortie, trace, $pe_nom)
            si (non p_st_ok($pe_etat)) {
              $pe_ligne = "ÉCHEC " + $pe_nom + " : " + chaine($pe_etat["err"])
            } sinon {
              $pe_terme = $pe_etat["terme"]
              si (chaine($pe_etat["trou"]) != "?_ferme") {
                $pe_ligne = "ÉCHEC " + $pe_nom + " : preuve incomplete"
              }
            }
          } sinon {
            $pe_terme = p_preuve_terme($pe_preuve)
            si (non p_est_terme($pe_terme)) {
              $pe_parse = vrai
              $pe_ligne = "ÉCHEC " + $pe_nom + " : analyse de la preuve impossible"
            } sinon {
              si (trace) { p_ajoute_trace($pe_sortie, $pe_nom, "terme", $pe_terme) }
            }
          }

          si ($pe_ligne == "") {
            $pe_vf = verifier($pe_terme, $pe_ctx)
            si (non p_ok($pe_vf)) {
              $pe_ligne = "ÉCHEC " + $pe_nom + " : terme de preuve invalide — " + p_raison($pe_vf)
            } sinon {
              $pe_type_final = table()
              $pe_type_final = $pe_vf["type"]
              si (non convertible($pe_type_final, $pe_but)) {
                $pe_ligne = "ÉCHEC " + $pe_nom + " : type de la preuve ≠ but"
              } sinon {
                $pe_ligne = "OK " + $pe_nom
                $pe_reussis = $pe_reussis + 1
              }
            }
          }
        }
      }
    }

    $pe_s0 = $pe_sortie["s"]
    inserer($pe_sortie, "s", $pe_s0 + $pe_ligne + p_saut())
    $pe_i = $pe_i + 1
  }

  $pe_s_str = ""
  $pe_s_str = $pe_sortie["s"]
  $pe_s1 = $pe_s_str + chaine($pe_total) + " théorème(s), " + chaine($pe_reussis) + " réussi(s)" + p_saut()
  inserer($pe_res, "sortie", p_sans_fin($pe_s1))
  inserer($pe_res, "total", $pe_total)
  inserer($pe_res, "reussis", $pe_reussis)
  si ($pe_total == 0 ou $pe_parse) {
    inserer($pe_res, "code", 2)
  } sinon {
    si ($pe_reussis == $pe_total) { inserer($pe_res, "code", 0) }
    sinon { inserer($pe_res, "code", 1) }
  }
  retour $pe_res
}

# ── 7. Aide et mode démo ───────────────────────────────────────────────────

fn pilote_aide() -> chaine {
  $aid_a = ""
  $aid_a = $aid_a + "Thorn — pilote de démonstration (en Rose)" + p_saut()
  $aid_a = $aid_a + p_saut()
  $aid_a = $aid_a + "Usage :" + p_saut()
  $aid_a = $aid_a + "  rose thorn/src/principal.rose <fichier.thn>  vérifie chaque théorème" + p_saut()
  $aid_a = $aid_a + "  rose thorn/src/principal.rose --demo [fichiers.thn...]" + p_saut()
  $aid_a = $aid_a + "  rose thorn/src/principal.rose --aide" + p_saut()
  $aid_a = $aid_a + p_saut()
  $aid_a = $aid_a + "Options :" + p_saut()
  $aid_a = $aid_a + "  --trace  affiche les termes construits" + p_saut()
  $aid_a = $aid_a + p_saut()
  $aid_a = $aid_a + "Format d'un fichier .thn :" + p_saut()
  $aid_a = $aid_a + "  théorème <nom> : <type du but>" + p_saut()
  $aid_a = $aid_a + "  preuve <tactique>" + p_saut()
  $aid_a = $aid_a + "Tactiques : reflexivite, symetrie, introduction, application," + p_saut()
  $aid_a = $aid_a + "induction, simplifier. La preuve peut aussi être un terme." + p_saut()
  $aid_a = $aid_a + p_saut()
  $aid_a = $aid_a + "Sortie : OK <nom> ou ÉCHEC <nom> : <raison>, puis" + p_saut()
  $aid_a = $aid_a + "« N théorème(s), M réussi(s) »." + p_saut()
  $aid_a = $aid_a + "Codes : 0 tout passe, 1 échec de preuve, 2 lecture/parsing." + p_saut()
  retour p_sans_fin($aid_a)
}

# Rose n'a pas de primitive pour lister un répertoire : les noms connus sont
# donc énumérés ici. --demo accepte aussi des chemins explicites en arguments.
fn pilote_manifeste() -> liste<chaine> {
  $man_l = ["thorn/preuves/base.thn", "thorn/preuves/exemple.thn", "thorn/preuves/identite.thn", "thorn/preuves/demo_identite.thn", "thorn/preuves/reflexivite.thn", "thorn/preuves/demo_reflexivite.thn", "thorn/preuves/symetrie.thn", "thorn/preuves/demo_symetrie.thn", "thorn/preuves/associativite.thn", "thorn/preuves/demo_associativite.thn", "thorn/preuves/commutativite.thn", "thorn/preuves/demo_commutativite.thn", "thorn/preuves/plus_zero.thn", "thorn/preuves/plus_succ.thn", "thorn/preuves/lemmes.thn", "thorn/preuves/demo_lemmes.thn"]
  retour $man_l
}

fn pilote_demo(fichiers: liste<chaine>, trace: booleen) -> table {
  $pd_res = table()
  inserer($pd_res, "sortie", "")
  inserer($pd_res, "code", 2)
  inserer($pd_res, "total", 0)
  inserer($pd_res, "reussis", 0)
  $pd_sortie = ""
  $pd_total = 0
  $pd_reussis = 0
  $pd_code = 0
  $pd_nb = 0
  $pd_k = 0
  $pd_n = longueur(fichiers)
  $pd_demo_fichier = ""
  tant_que ($pd_k < $pd_n) {
    $pd_demo_fichier = fichiers[$pd_k]
    $pd_un = pilote_executer(fichiers[$pd_k], trace)
    $pd_sortie_un = ""
    $pd_total_un = 0
    $pd_reussis_un = 0
    $pd_code_un = 0
    $pd_sortie_un = $pd_un["sortie"]
    $pd_total_un = $pd_un["total"]
    $pd_reussis_un = $pd_un["reussis"]
    $pd_code_un = $pd_un["code"]
    $pd_sortie = $pd_sortie + "=== " + $pd_demo_fichier + " ===" + p_saut() + p_sans_fin($pd_sortie_un) + p_saut() + p_saut()
    $pd_total = $pd_total + $pd_total_un
    $pd_reussis = $pd_reussis + $pd_reussis_un
    $pd_nb = $pd_nb + 1
    si ($pd_code_un == 2) { $pd_code = 2 }
    si ($pd_code_un == 1 et $pd_code == 0) { $pd_code = 1 }
    $pd_k = $pd_k + 1
  }
  si ($pd_nb == 0) {
    $pd_sortie = "Erreur : aucun fichier .thn jouable dans thorn/preuves/ (dossier absent ou vide)"
    $pd_code = 2
  } sinon {
    $pd_sortie = p_sans_fin($pd_sortie) + p_saut() + chaine($pd_total) + " théorème(s), " + chaine($pd_reussis) + " réussi(s)"
  }
  inserer($pd_res, "sortie", p_sans_fin($pd_sortie))
  inserer($pd_res, "total", $pd_total)
  inserer($pd_res, "reussis", $pd_reussis)
  inserer($pd_res, "code", $pd_code)
  retour $pd_res
}

# Filtre les chemins du manifeste réellement lisibles.
fn pilote_manifeste_present() -> liste<chaine> {
  $pm_l = [""]
  $pm_vide = p_liste_vide_thorn()
  $pm_l = $pm_vide
  $pm_m = pilote_manifeste()
  $pm_k = 0
  tant_que ($pm_k < longueur($pm_m)) {
    $pm_mani_fichier = $pm_m[$pm_k]
    $pm_lu = ""
    essayer {
      $pm_lu = lire_texte($pm_mani_fichier)
    } attraper($pm_e) { }
    si ($pm_lu != "") { joindre($pm_l, $pm_mani_fichier) }
    $pm_k = $pm_k + 1
  }
  retour $pm_l
}

# ── 8. Interface en ligne de commande ──────────────────────────────────────

fn pilote_main() {
  $mn_n = nb_arguments()
  si ($mn_n == 0) {
    >> pilote_aide()
    quitter(2)
  }

  $mn_trace = faux
  $mn_demo = faux
  $mn_chemins = [""]
  $mn_k = 0
  tant_que ($mn_k < $mn_n) {
    $mn_a = argument($mn_k)
    si ($mn_a == "--trace") {
      $mn_trace = vrai
    } sinon {
      si ($mn_a == "--demo") {
        $mn_demo = vrai
      } sinon {
        si ($mn_a == "--aide" ou $mn_a == "-h" ou $mn_a == "--help") {
          >> pilote_aide()
          quitter(0)
        } sinon {
          joindre($mn_chemins, $mn_a)
        }
      }
    }
    $mn_k = $mn_k + 1
  }

  $mn_resultat = table()
  si ($mn_demo) {
    $mn_fichiers = pilote_manifeste_present()
    # p_tranche() remet un sentinelle vide en 0 : --demo lirait alors un
    # chemin vide (« ===  === » + erreur de lecture). On veut une liste
    # 0-indexee sans sentinelle.
    si (longueur($mn_chemins) > 1) { $mn_fichiers = p_sans_sentinel($mn_chemins) }
    $mn_resultat = pilote_demo($mn_fichiers, $mn_trace)
  } sinon {
    si (longueur($mn_chemins) < 2) {
      >> pilote_aide()
      quitter(2)
    }
    $mn_resultat = pilote_executer($mn_chemins[1], $mn_trace)
  }
  $mn_sortie_finale = ""
  $mn_code_final = 0
  $mn_sortie_finale = $mn_resultat["sortie"]
  $mn_code_final = $mn_resultat["code"]
  >> $mn_sortie_finale
  quitter($mn_code_final)
}

pilote_main()
