# ═══════════════════════════════════════════════════════════════════════════
# thorn/src/noyau.rose — NOYAU DE VÉRIFICATION DE TYPES DE THORN
# ═══════════════════════════════════════════════════════════════════════════
#
# Interface publique (SPEC.md) :
#   verifier(t, ctx)      -> Resultat  {ok: booleen, type: Terme, erreur: chaine}
#   beta(t)               -> Terme     (beta-réduction complète, garde 10000)
#   convertible(a, b)     -> booleen   (beta + alpha-équivalence)
#   bien_forme(t, ctx)    -> booleen
#
# REPRÉSENTATION (contract SPEC.md) :
#   Terme = table Rose avec champ « genre » :
#     var          {genre:"var", nom}
#     type         {genre:"type", niveau: entier}
#     pi           {genre:"pi", nom, domaine, codomaine}
#     lam          {genre:"lam", nom, domaine, corps}
#     app          {genre:"app", fonction, argument}
#     const        {genre:"const", nom, type}
#     ind          {genre:"ind", nom, params: liste<table>}
#     constructeur {genre:"constructeur", nom, type}
#     elim         {genre:"elim", nom, motif, branches: liste<table>}
#   Contexte = liste<table> d'associations {nom, type}, REMBOURRÉE à l'index 0
#   par table() (le vérificateur Rose refuse les listes vides). Une table
#   {nom: Terme} est aussi acceptée : noy_normaliser_ctx la convertit.
#   Les listes de termes (params, branches) sont elles aussi rembourrées.
#   Sentinelle interne : {genre:"_absent"} = champ manquant / non lié.
#
# Aucune dépendance externe, aucun fichier modifié hors celui-ci.
# Documentation : thorn/docs/NOYAU.md
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────── 1. Constructeurs et accès défensif ───────────────────

fn noy_absent() -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "_absent")
  retour $nx_t
}

fn noy_genre(t: table) -> chaine {
  $nx_g = ""
  si (type(t) == "table") {
    si (cle_existe(t, "genre")) {
      $nx_x = t["genre"]
      si (type($nx_x) == "chaine") { $nx_g = $nx_x }
    }
  }
  retour $nx_g
}

fn noy_est_absent(t: table) -> booleen {
  retour noy_genre(t) == "_absent"
}

fn noy_nom(t: table) -> chaine {
  $nx_v = ""
  si (type(t) == "table") {
    si (cle_existe(t, "nom")) {
      $nx_x = t["nom"]
      si (type($nx_x) == "chaine") { $nx_v = $nx_x }
    }
  }
  retour $nx_v
}

fn noy_niveau(t: table) -> entier {
  $nx_v = -1
  si (type(t) == "table") {
    si (cle_existe(t, "niveau")) {
      $nx_x = t["niveau"]
      si (type($nx_x) == "entier") { $nx_v = $nx_x }
    }
  }
  retour $nx_v
}

# Numéro de ligne OPTIONNEL porté par un terme (0 = absent). Les termes
# construits par les autres modules n'en ont pas : le champ reste facultatif
# et n'est jamais exigé. Il permet à un outil d'atteindre une source de
# remonter la position jusqu'au Resultat.
fn noy_ligne(t: table) -> entier {
  $nx_v = 0
  si (type(t) == "table") {
    si (cle_existe(t, "ligne")) {
      $nx_x = t["ligne"]
      si (type($nx_x) == "entier") { $nx_v = $nx_x }
    }
  }
  retour $nx_v
}

# Lecture d'un champ-table : jamais d'erreur « clé absente ».
fn noy_champ(t: table, cle: chaine) -> table {
  $nx_r = noy_absent()
  si (type(t) == "table") {
    si (cle_existe(t, cle)) { $nx_r = t[cle] }
  }
  retour $nx_r
}

fn noy_entier_champ(t: table, cle: chaine) -> entier {
  $nx_v = -1
  si (type(t) == "table") {
    si (cle_existe(t, cle)) {
      $nx_x = t[cle]
      si (type($nx_x) == "entier") { $nx_v = $nx_x }
    }
  }
  retour $nx_v
}

fn noy_champ_liste(t: table, cle: chaine) -> liste<table> {
  $nx_r = [table()]
  si (type(t) == "table") {
    si (cle_existe(t, cle)) {
      $nx_x = t[cle]
      si (type($nx_x) == "liste") { $nx_r = $nx_x }
    }
  }
  retour $nx_r
}

fn noy_corps(t: table) -> table {
  $nx_g = noy_genre(t)
  si ($nx_g == "pi") { retour noy_champ(t, "codomaine") }
  si ($nx_g == "lam") { retour noy_champ(t, "corps") }
  retour noy_absent()
}

fn noy_var(n: chaine) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "var")
  inserer($nx_t, "nom", n)
  retour $nx_t
}

fn noy_type(n: entier) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "type")
  inserer($nx_t, "niveau", n)
  retour $nx_t
}

fn noy_pi(n: chaine, d: table, c: table) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "pi")
  inserer($nx_t, "nom", n)
  inserer($nx_t, "domaine", d)
  inserer($nx_t, "codomaine", c)
  retour $nx_t
}

fn noy_lam(n: chaine, d: table, c: table) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "lam")
  inserer($nx_t, "nom", n)
  inserer($nx_t, "domaine", d)
  inserer($nx_t, "corps", c)
  retour $nx_t
}

fn noy_app(f: table, a: table) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "app")
  inserer($nx_t, "fonction", f)
  inserer($nx_t, "argument", a)
  retour $nx_t
}

fn noy_const(n: chaine, ty: table) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "const")
  inserer($nx_t, "nom", n)
  inserer($nx_t, "type", ty)
  retour $nx_t
}

fn noy_constructeur(n: chaine, ty: table) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "constructeur")
  inserer($nx_t, "nom", n)
  inserer($nx_t, "type", ty)
  retour $nx_t
}

fn noy_ind(n: chaine, p: liste<table>) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "ind")
  inserer($nx_t, "nom", n)
  inserer($nx_t, "params", p)
  retour $nx_t
}

fn noy_elim(n: chaine, m: table, b: liste<table>) -> table {
  $nx_t = table()
  inserer($nx_t, "genre", "elim")
  inserer($nx_t, "nom", n)
  inserer($nx_t, "motif", m)
  inserer($nx_t, "branches", b)
  retour $nx_t
}

# ───────────────────────── 2. Listes de noms ───────────────────────────────

fn noy_contient(l: liste<chaine>, s: chaine) -> booleen {
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    si (l[$nx_k] == s) { retour vrai }
    $nx_k = $nx_k + 1
  }
  retour faux
}

fn noy_copie_ch(l: liste<chaine>) -> liste<chaine> {
  $nx_r = [""]
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    joindre($nx_r, l[$nx_k])
    $nx_k = $nx_k + 1
  }
  retour $nx_r
}

fn noy_ajoute_unique(l: liste<chaine>, s: chaine) -> liste<chaine> {
  $nx_r = noy_copie_ch(l)
  si (non noy_contient($nx_r, s)) { joindre($nx_r, s) }
  retour $nx_r
}

fn noy_sans_ch(l: liste<chaine>, s: chaine) -> liste<chaine> {
  $nx_r = [""]
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    si (l[$nx_k] != s) { joindre($nx_r, l[$nx_k]) }
    $nx_k = $nx_k + 1
  }
  retour $nx_r
}

fn noy_union_ch(a: liste<chaine>, b: liste<chaine>) -> liste<chaine> {
  $nx_r = noy_copie_ch(a)
  $nx_n = longueur(b)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    si (non noy_contient($nx_r, b[$nx_k])) { joindre($nx_r, b[$nx_k]) }
    $nx_k = $nx_k + 1
  }
  retour $nx_r
}

fn noy_copie_tab(l: liste<table>) -> liste<table> {
  $nx_r = [table()]
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    joindre($nx_r, l[$nx_k])
    $nx_k = $nx_k + 1
  }
  retour $nx_r
}

# ───────────────── 3. Variables libres / noms / fraîcheur ──────────────────

fn noy_libres_liste(l: liste<table>) -> liste<chaine> {
  $nx_r = [""]
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    $nx_r = noy_union_ch($nx_r, noy_libres(l[$nx_k]))
    $nx_k = $nx_k + 1
  }
  retour $nx_r
}

fn noy_libres(t: table) -> liste<chaine> {
  $nx_g = noy_genre(t)
  $nx_r = [""]
  si ($nx_g == "var") {
    retour noy_ajoute_unique($nx_r, noy_nom(t))
  }
  si ($nx_g == "app") {
    $nx_r = noy_union_ch(noy_libres(noy_champ(t, "fonction")),
                      noy_libres(noy_champ(t, "argument")))
    retour $nx_r
  }
  si ($nx_g == "pi" ou $nx_g == "lam") {
    $nx_r = noy_union_ch(noy_libres(noy_champ(t, "domaine")),
                      noy_libres(noy_corps(t)))
    $nx_r = noy_sans_ch($nx_r, noy_nom(t))
    retour $nx_r
  }
  si ($nx_g == "const" ou $nx_g == "constructeur") {
    retour noy_libres(noy_champ(t, "type"))
  }
  si ($nx_g == "ind") {
    retour noy_libres_liste(noy_champ_liste(t, "params"))
  }
  si ($nx_g == "elim") {
    $nx_r = noy_union_ch(noy_libres(noy_champ(t, "motif")),
                      noy_libres_liste(noy_champ_liste(t, "branches")))
    retour $nx_r
  }
  retour $nx_r
}

# TOUS les noms présents dans un terme (libres ET lieurs) : sert à garantir
# qu'un nom frais ne capturera rien, même sous un lieur intérieur.
fn noy_noms_liste(l: liste<table>) -> liste<chaine> {
  $nx_r = [""]
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    $nx_r = noy_union_ch($nx_r, noy_noms(l[$nx_k]))
    $nx_k = $nx_k + 1
  }
  retour $nx_r
}

fn noy_noms(t: table) -> liste<chaine> {
  $nx_g = noy_genre(t)
  $nx_r = [""]
  si ($nx_g == "var" ou $nx_g == "const" ou $nx_g == "constructeur" ou
      $nx_g == "ind" ou $nx_g == "elim") {
    $nx_r = noy_ajoute_unique($nx_r, noy_nom(t))
  }
  si ($nx_g == "app") {
    $nx_r = noy_union_ch(noy_noms(noy_champ(t, "fonction")),
                      noy_noms(noy_champ(t, "argument")))
    retour $nx_r
  }
  si ($nx_g == "pi" ou $nx_g == "lam") {
    $nx_r = noy_ajoute_unique($nx_r, noy_nom(t))
    $nx_r = noy_union_ch($nx_r, noy_noms(noy_champ(t, "domaine")))
    $nx_r = noy_union_ch($nx_r, noy_noms(noy_corps(t)))
    retour $nx_r
  }
  si ($nx_g == "ind") {
    $nx_r = noy_union_ch($nx_r, noy_noms_liste(noy_champ_liste(t, "params")))
    retour $nx_r
  }
  si ($nx_g == "elim") {
    $nx_r = noy_union_ch($nx_r, noy_noms(noy_champ(t, "motif")))
    $nx_r = noy_union_ch($nx_r, noy_noms_liste(noy_champ_liste(t, "branches")))
    retour $nx_r
  }
  si ($nx_g == "const" ou $nx_g == "constructeur") {
    $nx_r = noy_union_ch($nx_r, noy_noms(noy_champ(t, "type")))
  }
  retour $nx_r
}

fn noy_frais(base: chaine, ev: liste<chaine>) -> chaine {
  $nx_cand = base
  $nx_suf = ""
  tant_que (noy_contient(ev, $nx_cand)) {
    $nx_suf = $nx_suf + "'"
    $nx_cand = base + $nx_suf
  }
  retour $nx_cand
}

# ───────────── 4. Substitution capture-évitante (le cœur) ──────────────────

fn noy_subst_liste(l: liste<table>, nom: chaine, val: table) -> liste<table> {
  $nx_r = [table()]
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    joindre($nx_r, noy_subst(l[$nx_k], nom, val))
    $nx_k = $nx_k + 1
  }
  retour $nx_r
}

fn noy_subst(t: table, nom: chaine, val: table) -> table {
  $nx_g = noy_genre(t)

  si ($nx_g == "var") {
    si (noy_nom(t) == nom) { retour val }
    retour t
  }
  si ($nx_g == "type" ou $nx_g == "_absent") { retour t }

  si ($nx_g == "app") {
    retour noy_app(noy_subst(noy_champ(t, "fonction"), nom, val),
                   noy_subst(noy_champ(t, "argument"), nom, val))
  }

  si ($nx_g == "pi" ou $nx_g == "lam") {
    $nx_b = noy_nom(t)
    $nx_dom = noy_subst(noy_champ(t, "domaine"), nom, val)
    $nx_c = noy_corps(t)

    # Le lieur « b » masque « nom » dans le corps ; le domaine, lui, est
    # hors de sa portée et doit être substitué.
    si ($nx_b == nom) {
      si ($nx_g == "pi") { retour noy_pi($nx_b, $nx_dom, $nx_c) }
      retour noy_lam($nx_b, $nx_dom, $nx_c)
    }

    # Évitation de capture : on ne renomme le lieur QUE si la substitution
    # a réellement lieu dans le corps (nom libre dans c) ET que « b » est
    # libre dans « val ». Renommer sans nécessité est correct à alpha près,
    # mais rendrait les types affichés instables.
    $nx_a_substituer = noy_contient(noy_libres($nx_c), nom)
    $nx_capture = noy_contient(noy_libres(val), $nx_b)
    $nx_ev = noy_union_ch(noy_noms(t), noy_libres(val))
    $nx_ev = noy_ajoute_unique($nx_ev, nom)
    $nx_nb = $nx_b
    $nx_c2 = $nx_c
    si ($nx_a_substituer et $nx_capture) {
      $nx_nb = noy_frais($nx_b, $nx_ev)
      $nx_c2 = noy_subst($nx_c, $nx_b, noy_var($nx_nb))
    }
    $nx_c3 = noy_subst($nx_c2, nom, val)
    si ($nx_g == "pi") { retour noy_pi($nx_nb, $nx_dom, $nx_c3) }
    retour noy_lam($nx_nb, $nx_dom, $nx_c3)
  }

  si ($nx_g == "const" ou $nx_g == "constructeur") {
    $nx_ty = noy_subst(noy_champ(t, "type"), nom, val)
    si ($nx_g == "const") { retour noy_const(noy_nom(t), $nx_ty) }
    retour noy_constructeur(noy_nom(t), $nx_ty)
  }

  si ($nx_g == "ind") {
    retour noy_ind(noy_nom(t), noy_subst_liste(noy_champ_liste(t, "params"), nom, val))
  }

  si ($nx_g == "elim") {
    $nx_br = noy_subst_liste(noy_champ_liste(t, "branches"), nom, val)
    retour noy_elim(noy_nom(t), noy_subst(noy_champ(t, "motif"), nom, val), $nx_br)
  }

  retour t
}

# ────────────────────── 5. Beta-réduction complète ─────────────────────────

fn noy_pas(t: table) -> table {
  $nx_r = table()
  inserer($nx_r, "change", vrai)
  inserer($nx_r, "terme", t)
  retour $nx_r
}

fn noy_rien(t: table) -> table {
  $nx_r = table()
  inserer($nx_r, "change", faux)
  inserer($nx_r, "terme", t)
  retour $nx_r
}

fn noy_pas_l(l: liste<table>) -> table {
  $nx_r = table()
  inserer($nx_r, "change", vrai)
  inserer($nx_r, "liste", l)
  retour $nx_r
}

fn noy_rien_l(l: liste<table>) -> table {
  $nx_r = table()
  inserer($nx_r, "change", faux)
  inserer($nx_r, "liste", l)
  retour $nx_r
}

fn noy_change(r: table) -> booleen {
  $nx_v = faux
  si (cle_existe(r, "change")) {
    $nx_x = r["change"]
    si (type($nx_x) == "booleen") { $nx_v = $nx_x }
  }
  retour $nx_v
}

fn noy_resultat(r: table) -> table {
  retour noy_champ(r, "terme")
}

fn noy_resultat_l(r: table) -> liste<table> {
  $nx_v = [table()]
  si (cle_existe(r, "liste")) {
    $nx_x = r["liste"]
    si (type($nx_x) == "liste") { $nx_v = $nx_x }
  }
  retour $nx_v
}

# ───────────── 5bis. ι-réduction des motifs zero / succ ─────────────────────
#
# Le noyau calcule deux primitives désignées par leur nom ET par la forme de
# leur annotation de type (jamais un const quelconque ne se réduit) :
#   plus   : Πm:Nat. Πn:Nat. Nat
#     plus zero n        → n
#     plus (succ k) n    → succ (plus k n)
#   nat_rec: ΠP.Πbase.Πpas.Πm:Nat. P m
#     nat_rec P base pas zero        → base
#     nat_rec P base pas (succ k)    → pas k (nat_rec P base pas k)
# C'est une vraie ι-réduction dans noy_redex : beta() et convertible() la
# voient. Les axiomes plus_0_l / plus_s_l deviennent calculatoirement
# redondants (ils restent dans la bibliothèque, hors périmètre TH4).

fn noy_est_nat(t: table) -> booleen {
  retour (noy_genre(t) == "ind" et noy_nom(t) == "Nat")
}

fn noy_est_zero(t: table) -> booleen {
  retour (noy_genre(t) == "const" et noy_nom(t) == "zero")
}

# Domaine de la i-ème flèche d'une chaîne de Pi (sentinelle si absent).
fn noy_pi_domaine_ieme(t: table, i: entier) -> table {
  $nx_cur = t
  $nx_k = 1
  tant_que ($nx_k <= i) {
    si (noy_genre($nx_cur) != "pi") { retour noy_absent() }
    $nx_dom = noy_champ($nx_cur, "domaine")
    si ($nx_k == i) { retour $nx_dom }
    $nx_cur = noy_champ($nx_cur, "codomaine")
    $nx_k = $nx_k + 1
  }
  retour noy_absent()
}

# Codomaine de la i-ème flèche d'une chaîne de Pi (sentinelle si absent).
fn noy_pi_codomaine_ieme(t: table, i: entier) -> table {
  $nx_cur = t
  $nx_k = 1
  tant_que ($nx_k <= i) {
    si (noy_genre($nx_cur) != "pi") { retour noy_absent() }
    $nx_cod = noy_champ($nx_cur, "codomaine")
    si ($nx_k == i) { retour $nx_cod }
    $nx_cur = $nx_cod
    $nx_k = $nx_k + 1
  }
  retour noy_absent()
}

# Argument k si t est succ k ; sentinelle sinon.
fn noy_succ_arg(t: table) -> table {
  $nx_r = noy_absent()
  si (noy_genre(t) == "app") {
    $nx_f = noy_champ(t, "fonction")
    si (noy_genre($nx_f) == "const" et noy_nom($nx_f) == "succ") {
      $nx_r = noy_champ(t, "argument")
    }
  }
  retour $nx_r
}

# Épine d'application : {tete, args, n} avec args[1] = DERNIER argument.
fn noy_spine(t: table) -> table {
  $nx_args = [table()]
  $nx_cur = t
  $nx_n = 0
  tant_que (noy_genre($nx_cur) == "app") {
    joindre($nx_args, noy_champ($nx_cur, "argument"))
    $nx_cur = noy_champ($nx_cur, "fonction")
    $nx_n = $nx_n + 1
  }
  $nx_r = table()
  inserer($nx_r, "tete", $nx_cur)
  inserer($nx_r, "args", $nx_args)
  inserer($nx_r, "n", $nx_n)
  retour $nx_r
}

# ───────── 5bis-B. Second inductif : Bool et son éliminateur ────────────────
#
# Bool est le DEUXIÈME inductif doté d'une ι-réduction dans le noyau (Nat est
# le premier). Ses constructeurs true / false, la négation not et
# l'éliminateur DÉPENDANT bool_rec sont reconnus par leur NOM **et** par la
# STRUCTURE de leur annotation de type : un const quelconque portant ces noms
# mais mal typé ne se réduit jamais (même discipline que plus / nat_rec).
#
#   bool_rec : ΠP:(Πb:Bool.Type). Πt:(P true). Πf:(P false). Πb:Bool. P b
#     bool_rec P t f true   → t
#     bool_rec P t f false  → f
#   not : Πb:Bool. Bool
#     not true   → false
#     not false  → true

fn noy_est_bool(t: table) -> booleen {
  retour (noy_genre(t) == "ind" et noy_nom(t) == "Bool")
}

# Constructeur Bool : nom + annotation Ind(Bool). L'annotation fait partie du
# contrôle de structure : un « true » annoté autrement n'est pas un constructeur.
fn noy_est_constr_bool(t: table, nom: chaine) -> booleen {
  si (noy_genre(t) != "const") { retour faux }
  si (noy_nom(t) != nom) { retour faux }
  retour noy_est_bool(noy_champ(t, "type"))
}

fn noy_est_true(t: table) -> booleen { retour noy_est_constr_bool(t, "true") }
fn noy_est_false(t: table) -> booleen { retour noy_est_constr_bool(t, "false") }

# Motif d'élimination dépendante : Πb:Bool. Type(i) (codomaine univers).
fn noy_est_motive_bool(t: table) -> booleen {
  si (noy_genre(t) != "pi") { retour faux }
  si (non noy_est_bool(noy_pi_domaine_ieme(t, 1))) { retour faux }
  retour (noy_genre(noy_pi_codomaine_ieme(t, 1)) == "type")
}

# Contrôle de structure complet de l'annotation de bool_rec. Exige quatre
# flèches, un motif bien formé, deux branches présentes et un scrutinee Bool.
# C'est ce garde-fou qui distingue un vrai éliminateur d'un const homonyme.
fn noy_bool_rec_valide(ty: table) -> booleen {
  $nx_d1 = noy_pi_domaine_ieme(ty, 1)
  $nx_d2 = noy_pi_domaine_ieme(ty, 2)
  $nx_d3 = noy_pi_domaine_ieme(ty, 3)
  $nx_d4 = noy_pi_domaine_ieme(ty, 4)
  $nx_c4 = noy_pi_codomaine_ieme(ty, 4)
  si (non noy_est_motive_bool($nx_d1)) { retour faux }
  si (noy_est_absent($nx_d2) ou noy_est_absent($nx_d3)) { retour faux }
  si (non noy_est_bool($nx_d4)) { retour faux }
  si (noy_est_absent($nx_c4)) { retour faux }
  retour vrai
}

# Contrôle de structure de l'annotation de not : Πb:Bool. Bool.
fn noy_not_valide(ty: table) -> booleen {
  si (non noy_est_bool(noy_pi_domaine_ieme(ty, 1))) { retour faux }
  retour noy_est_bool(noy_pi_codomaine_ieme(ty, 1))
}

# ───────── 5bis-C. Registre de descripteurs d'inductifs ─────────────────────
#
# Les deux premiers inductifs (Nat, Bool) avaient leurs éliminateurs CÂBLÉS
# dans noy_iota. Ce registre les décrit désormais DE LA MÊME MANIÈRE qu'un
# troisième inductif, List, et pilote leur ι-réduction par les données :
#
#   descripteur d'inductif = table {
#     "ind"    : chaine            — nom du type (Nat / Bool / List)
#     "elim"   : chaine            — nom de l'éliminateur dépendant
#     "constructeurs" : liste<table> de descripteurs de constructeurs :
#        { "nom" : chaine,            — nom du constructeur
#          "branche" : entier,        — index (spine) de la branche à rendre
#          "nargs"   : entier,        — arité du constructeur
#          "recindex": entier }       — 0 = pas de récursion, sinon index
#                                       (spine) de l'argument récursif
#   }
#
# Conventions vérifiées par noy_registre_elim_valide (communes aux trois) :
#   éliminateur : ΠP.Πbase.Πstep.Πx:T. P x   (spine : args[4]=P, args[3]=base,
#   args[2]=step, args[1]=scrutinee). Pour un constructeur récursif, le pas
#   d'ι est  step <args du constr> (elim P base step <arg récursif>).
#
# CECI N'EST PAS un mécanisme d'inductifs utilisateurs : le registre est
# interne, fermé (trois entrées), sans motif utilisateur, sans indices, sans
# positivité ni contrôle de terminaison. Il factorise les trois éliminateurs
# déjà présents dans le noyau et y ajoute List.

# Type inductif déclaré : nom + annotation Ind(...) (paramètres ignorés).
fn noy_est_ind_nom(t: table, nom: chaine) -> booleen {
  retour (noy_genre(t) == "ind" et noy_nom(t) == nom)
}

# Résultat d'un type de constructeur : Ind(nom) direct (constructeur nulaires
# true/false/zero/nil) ou codomaine final d'une chaîne de Π (succ, cons).
# Borne de profondeur : garde contre une annotation pathologique.
fn noy_resultat_est_ind(t: table, nom: chaine, prof: entier) -> booleen {
  si (noy_est_ind_nom(t, nom)) { retour vrai }
  si (prof >= 8) { retour faux }
  si (noy_genre(t) == "pi") {
    retour noy_resultat_est_ind(noy_champ(t, "codomaine"), nom, prof + 1)
  }
  retour faux
}

fn noy_desc_constr(nom: chaine, branche: entier, nargs: entier,
                   recindex: entier) -> table {
  $nx_r = table()
  inserer($nx_r, "nom", nom)
  inserer($nx_r, "branche", branche)
  inserer($nx_r, "nargs", nargs)
  inserer($nx_r, "recindex", recindex)
  retour $nx_r
}

fn noy_desc_ind(ind: chaine, elim: chaine, cs: liste<table>) -> table {
  $nx_r = table()
  inserer($nx_r, "ind", ind)
  inserer($nx_r, "elim", elim)
  inserer($nx_r, "constructeurs", cs)
  retour $nx_r
}

# Le registre est construit localement à chaque appel : Rose ne permet pas
# d'indexer une globale par une variable dans une fonction (constat vérifié),
# et les trois descripteurs sont de toute façon minuscules.
fn noy_registre() -> liste<table> {
  $nx_r = [table()]

  # Nat : zero -> base (branche 3), succ k -> pas k (rec k).
  $nx_nat = [table()]
  joindre($nx_nat, noy_desc_constr("zero", 3, 0, 0))
  joindre($nx_nat, noy_desc_constr("succ", 2, 1, 1))
  joindre($nx_r, noy_desc_ind("Nat", "nat_rec", $nx_nat))

  # Bool : true -> t (branche 3), false -> f (branche 2), tous deux nulaires.
  $nx_bool = [table()]
  joindre($nx_bool, noy_desc_constr("true", 3, 0, 0))
  joindre($nx_bool, noy_desc_constr("false", 2, 0, 0))
  joindre($nx_r, noy_desc_ind("Bool", "bool_rec", $nx_bool))

  # List : nil -> base (branche 3), cons a l -> cons a l (rec l).
  # L'argument récursif est le DERNIER argument du constructeur (spine 1).
  $nx_list = [table()]
  joindre($nx_list, noy_desc_constr("nil", 3, 0, 0))
  joindre($nx_list, noy_desc_constr("cons", 2, 2, 1))
  joindre($nx_r, noy_desc_ind("List", "list_rec", $nx_list))

  retour $nx_r
}

fn noy_registre_trouver_elim(reg: liste<table>, elim: chaine) -> table {
  $nx_n = longueur(reg)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    $nx_d = reg[$nx_k]
    si (noy_chaine_res($nx_d, "elim") == elim) { retour $nx_d }
    $nx_k = $nx_k + 1
  }
  retour noy_absent()
}

fn noy_registre_trouver_constr(desc: table, nom: chaine) -> table {
  $nx_cs = noy_champ_liste(desc, "constructeurs")
  $nx_n = longueur($nx_cs)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    $nx_c = $nx_cs[$nx_k]
    si (noy_chaine_res($nx_c, "nom") == nom) { retour $nx_c }
    $nx_k = $nx_k + 1
  }
  retour noy_absent()
}

# Motif générique : Πx:Ind(nom). Type(i) (codomaine univers).
fn noy_registre_motive(t: table, nom: chaine) -> booleen {
  si (noy_genre(t) != "pi") { retour faux }
  si (non noy_est_ind_nom(noy_pi_domaine_ieme(t, 1), nom)) { retour faux }
  retour (noy_genre(noy_pi_codomaine_ieme(t, 1)) == "type")
}

# Contrôle de structure générique de l'éliminateur : quatre flèches, motif
# bien formé, deux branches présentes, scrutinee Ind(nom), résultat présent.
fn noy_registre_elim_valide(ty: table, nom: chaine) -> booleen {
  $nx_d1 = noy_pi_domaine_ieme(ty, 1)
  $nx_d2 = noy_pi_domaine_ieme(ty, 2)
  $nx_d3 = noy_pi_domaine_ieme(ty, 3)
  $nx_d4 = noy_pi_domaine_ieme(ty, 4)
  $nx_c4 = noy_pi_codomaine_ieme(ty, 4)
  si (non noy_registre_motive($nx_d1, nom)) { retour faux }
  si (noy_est_absent($nx_d2) ou noy_est_absent($nx_d3)) { retour faux }
  si (non noy_est_ind_nom($nx_d4, nom)) { retour faux }
  si (noy_est_absent($nx_c4)) { retour faux }
  retour vrai
}

fn noy_iota(t: table) -> table {
  $nx_sp = noy_spine(t)
  $nx_n = noy_entier_champ($nx_sp, "n")
  $nx_head = noy_champ($nx_sp, "tete")
  $nx_args = noy_champ_liste($nx_sp, "args")
  si (noy_genre($nx_head) != "const") { retour noy_rien(t) }
  $nx_nom = noy_nom($nx_head)
  $nx_ty = noy_champ($nx_head, "type")

  si ($nx_nom == "plus" et $nx_n == 2) {
    si (non noy_est_nat(noy_pi_domaine_ieme($nx_ty, 1))) { retour noy_rien(t) }
    si (non noy_est_nat(noy_pi_domaine_ieme($nx_ty, 2))) { retour noy_rien(t) }
    si (non noy_est_nat(noy_pi_codomaine_ieme($nx_ty, 2))) { retour noy_rien(t) }
    $nx_m = $nx_args[2]
    $nx_nn = $nx_args[1]
    si (noy_est_zero($nx_m)) { retour noy_pas($nx_nn) }
    $nx_k = noy_succ_arg($nx_m)
    si (non noy_est_absent($nx_k)) {
      $nx_reste = noy_app(noy_app($nx_head, $nx_k), $nx_nn)
      retour noy_pas(noy_app(noy_champ($nx_m, "fonction"), $nx_reste))
    }
  }

  # ── Bool : négation not (structure contrôlée) ──
  # L'annotation du scrutinee (déjà vérifiée Ind(Bool)) sert à construire le
  # constructeur résultant : pas de fabrique de terme arbitraire.
  si ($nx_nom == "not" et $nx_n == 1) {
    si (non noy_not_valide($nx_ty)) { retour noy_rien(t) }
    $nx_b = $nx_args[1]
    $nx_tybool = noy_champ($nx_b, "type")
    si (noy_est_true($nx_b)) { retour noy_pas(noy_const("false", $nx_tybool)) }
    si (noy_est_false($nx_b)) { retour noy_pas(noy_const("true", $nx_tybool)) }
  }

  # ── Éliminateurs pilotés par le registre : nat_rec, bool_rec, list_rec ──
  # Un seul mécanisme pour les trois inductifs. Les noms ne sont pas câblés
  # ici : c'est le registre qui associe nom → inductif → constructeurs.
  $nx_reg = noy_registre()
  $nx_desc = noy_registre_trouver_elim($nx_reg, $nx_nom)
  si (non noy_est_absent($nx_desc) et $nx_n == 4) {
    $nx_ind = noy_chaine_res($nx_desc, "ind")
    si (non noy_registre_elim_valide($nx_ty, $nx_ind)) { retour noy_rien(t) }
    $nx_scrut = $nx_args[1]
    $nx_sp2 = noy_spine($nx_scrut)
    $nx_shead = noy_champ($nx_sp2, "tete")
    $nx_sargs = noy_champ_liste($nx_sp2, "args")
    si (noy_genre($nx_shead) != "const") { retour noy_rien(t) }
    # Le RESULTAT du type du constructeur doit être Ind(ind) : couvre les
    # constructeurs nulaires (Ind direct) et les fonctions (succ, cons).
    si (non noy_resultat_est_ind(noy_champ($nx_shead, "type"), $nx_ind, 0)) {
      retour noy_rien(t)
    }
    $nx_cd = noy_registre_trouver_constr($nx_desc, noy_nom($nx_shead))
    si (noy_est_absent($nx_cd)) { retour noy_rien(t) }
    $nx_nargs = noy_entier_champ($nx_cd, "nargs")
    $nx_sna = longueur($nx_sargs) - 1
    si ($nx_sna != $nx_nargs) { retour noy_rien(t) }
    $nx_branche = $nx_args[noy_entier_champ($nx_cd, "branche")]
    $nx_recindex = noy_entier_champ($nx_cd, "recindex")
    si ($nx_recindex == 0) { retour noy_pas($nx_branche) }
    # Appel récursif : (elim P base step) <argument récursif>.
    $nx_head3 = noy_app(noy_app(noy_app($nx_head, $nx_args[4]), $nx_args[3]),
                        $nx_args[2])
    $nx_rec = noy_app($nx_head3, $nx_sargs[$nx_recindex])
    # Branche appliquée aux arguments du constructeur (ordre naturel),
    # puis à l'hypothèse de récursivité.
    $nx_out = $nx_branche
    $nx_j = $nx_nargs
    tant_que ($nx_j >= 1) {
      $nx_out = noy_app($nx_out, $nx_sargs[$nx_j])
      $nx_j = $nx_j - 1
    }
    $nx_out = noy_app($nx_out, $nx_rec)
    retour noy_pas($nx_out)
  }
  retour noy_rien(t)
}

# Un pas de réduction en stratégie normale (le plus à gauche, dehors).
fn noy_redex_liste(l: liste<table>) -> table {
  $nx_n = longueur(l)
  $nx_k = 1
  tant_que ($nx_k < $nx_n) {
    $nx_r = noy_redex(l[$nx_k])
    si (noy_change($nx_r)) {
      $nx_out = [table()]
      $nx_j = 1
      tant_que ($nx_j < $nx_k) {
        joindre($nx_out, l[$nx_j])
        $nx_j = $nx_j + 1
      }
      joindre($nx_out, noy_resultat($nx_r))
      $nx_j = $nx_k + 1
      tant_que ($nx_j < $nx_n) {
        joindre($nx_out, l[$nx_j])
        $nx_j = $nx_j + 1
      }
      retour noy_pas_l($nx_out)
    }
    $nx_k = $nx_k + 1
  }
  retour noy_rien_l(l)
}

fn noy_redex(t: table) -> table {
  # ι d'abord (réduction de tête) : avant toute descente, comme en G5.
  $nx_iota = noy_iota(t)
  si (noy_change($nx_iota)) { retour $nx_iota }

  $nx_g = noy_genre(t)

  si ($nx_g == "app") {
    $nx_f = noy_champ(t, "fonction")
    $nx_a = noy_champ(t, "argument")
    $nx_rf = noy_redex($nx_f)
    si (noy_change($nx_rf)) {
      retour noy_pas(noy_app(noy_resultat($nx_rf), $nx_a))
    }
    si (noy_genre($nx_f) == "lam") {
      retour noy_pas(noy_subst(noy_champ($nx_f, "corps"), noy_nom($nx_f), $nx_a))
    }
    $nx_ra = noy_redex($nx_a)
    si (noy_change($nx_ra)) {
      retour noy_pas(noy_app($nx_f, noy_resultat($nx_ra)))
    }
    retour noy_rien(t)
  }

  si ($nx_g == "pi") {
    $nx_rd = noy_redex(noy_champ(t, "domaine"))
    si (noy_change($nx_rd)) {
      retour noy_pas(noy_pi(noy_nom(t), noy_resultat($nx_rd), noy_champ(t, "codomaine")))
    }
    $nx_rc = noy_redex(noy_champ(t, "codomaine"))
    si (noy_change($nx_rc)) {
      retour noy_pas(noy_pi(noy_nom(t), noy_champ(t, "domaine"), noy_resultat($nx_rc)))
    }
    retour noy_rien(t)
  }

  si ($nx_g == "lam") {
    $nx_rd = noy_redex(noy_champ(t, "domaine"))
    si (noy_change($nx_rd)) {
      retour noy_pas(noy_lam(noy_nom(t), noy_resultat($nx_rd), noy_champ(t, "corps")))
    }
    $nx_rc = noy_redex(noy_champ(t, "corps"))
    si (noy_change($nx_rc)) {
      retour noy_pas(noy_lam(noy_nom(t), noy_champ(t, "domaine"), noy_resultat($nx_rc)))
    }
    retour noy_rien(t)
  }

  si ($nx_g == "const" ou $nx_g == "constructeur") {
    $nx_rt = noy_redex(noy_champ(t, "type"))
    si (noy_change($nx_rt)) {
      si ($nx_g == "const") { retour noy_pas(noy_const(noy_nom(t), noy_resultat($nx_rt))) }
      retour noy_pas(noy_constructeur(noy_nom(t), noy_resultat($nx_rt)))
    }
    retour noy_rien(t)
  }

  si ($nx_g == "ind") {
    $nx_rl = noy_redex_liste(noy_champ_liste(t, "params"))
    si (noy_change($nx_rl)) {
      retour noy_pas(noy_ind(noy_nom(t), noy_resultat_l($nx_rl)))
    }
    retour noy_rien(t)
  }

  si ($nx_g == "elim") {
    $nx_rm = noy_redex(noy_champ(t, "motif"))
    si (noy_change($nx_rm)) {
      retour noy_pas(noy_elim(noy_nom(t), noy_resultat($nx_rm), noy_champ_liste(t, "branches")))
    }
    $nx_rb = noy_redex_liste(noy_champ_liste(t, "branches"))
    si (noy_change($nx_rb)) {
      retour noy_pas(noy_elim(noy_nom(t), noy_champ(t, "motif"), noy_resultat_l($nx_rb)))
    }
    retour noy_rien(t)
  }

  retour noy_rien(t)
}

fn noy_pas_beta(r: table) -> entier {
  $nx_v = 0
  si (cle_existe(r, "pas")) {
    $nx_x = r["pas"]
    si (type($nx_x) == "entier") { $nx_v = $nx_x }
  }
  retour $nx_v
}

fn noy_erreur_beta(r: table) -> chaine {
  $nx_v = ""
  si (cle_existe(r, "erreur")) {
    $nx_x = r["erreur"]
    si (type($nx_x) == "chaine") { $nx_v = $nx_x }
  }
  retour $nx_v
}

# Réduction complète bornée. Rend {terme, pas, erreur}. En cas de dépassement,
# on rend le terme PARTIELLEMENT réduit et une erreur explicite : jamais de
# boucle infinie, jamais de plantage.
fn noy_beta_lim(t: table, limite: entier) -> table {
  $nx_cur = t
  $nx_pas = 0
  $nx_err = ""
  $nx_cont = vrai
  tant_que ($nx_cont) {
    si ($nx_pas >= limite) {
      $nx_test = noy_redex($nx_cur)
      si (noy_change($nx_test)) {
        $nx_err = "depassement de la garde de pas (" + chaine(limite) + ")"
      }
      $nx_cont = faux
    } sinon {
      $nx_r = noy_redex($nx_cur)
      si (noy_change($nx_r)) {
        $nx_cur = noy_resultat($nx_r)
        $nx_pas = $nx_pas + 1
      } sinon {
        $nx_cont = faux
      }
    }
  }
  $nx_res = table()
  inserer($nx_res, "terme", $nx_cur)
  inserer($nx_res, "pas", $nx_pas)
  inserer($nx_res, "erreur", $nx_err)
  retour $nx_res
}

fn beta(t: table) -> table {
  $nx_r = noy_beta_lim(t, 10000)
  retour noy_champ($nx_r, "terme")
}

# ────────────── 6. Alpha-équivalence (environnement de noms) ───────────────

# Indice (de Bruijn) du nom dans l'environnement, 0 = nom libre.
fn noy_index_env(env: liste<chaine>, s: chaine) -> entier {
  $nx_n = longueur(env)
  $nx_k = $nx_n - 1
  tant_que ($nx_k >= 1) {
    si (env[$nx_k] == s) { retour $nx_n - $nx_k }
    $nx_k = $nx_k - 1
  }
  retour 0
}

fn noy_alpha_liste(a: liste<table>, b: liste<table>,
                   ea: liste<chaine>, eb: liste<chaine>) -> booleen {
  $nx_na = longueur(a)
  $nx_nb = longueur(b)
  si ($nx_na != $nx_nb) { retour faux }
  $nx_k = 1
  tant_que ($nx_k < $nx_na) {
    si (non noy_alpha(a[$nx_k], b[$nx_k], ea, eb)) { retour faux }
    $nx_k = $nx_k + 1
  }
  retour vrai
}

# ea / eb : environnements de correspondance (listes de lieurs empilés).
fn noy_alpha(a: table, b: table,
             ea: liste<chaine>, eb: liste<chaine>) -> booleen {
  $nx_ga = noy_genre(a)
  $nx_gb = noy_genre(b)
  si ($nx_ga != $nx_gb) { retour faux }

  si ($nx_ga == "var") {
    $nx_ia = noy_index_env(ea, noy_nom(a))
    $nx_ib = noy_index_env(eb, noy_nom(b))
    si ($nx_ia > 0 ou $nx_ib > 0) { retour $nx_ia == $nx_ib }
    retour noy_nom(a) == noy_nom(b)
  }
  si ($nx_ga == "type") { retour noy_niveau(a) == noy_niveau(b) }
  si ($nx_ga == "app") {
    si (non noy_alpha(noy_champ(a, "fonction"), noy_champ(b, "fonction"), ea, eb)) {
      retour faux
    }
    retour noy_alpha(noy_champ(a, "argument"), noy_champ(b, "argument"), ea, eb)
  }
  si ($nx_ga == "pi" ou $nx_ga == "lam") {
    si (non noy_alpha(noy_champ(a, "domaine"), noy_champ(b, "domaine"), ea, eb)) {
      retour faux
    }
    $nx_nea = noy_copie_ch(ea)
    joindre($nx_nea, noy_nom(a))
    $nx_neb = noy_copie_ch(eb)
    joindre($nx_neb, noy_nom(b))
    retour noy_alpha(noy_corps(a), noy_corps(b), $nx_nea, $nx_neb)
  }
  si ($nx_ga == "const" ou $nx_ga == "constructeur") {
    si (noy_nom(a) != noy_nom(b)) { retour faux }
    retour noy_alpha(noy_champ(a, "type"), noy_champ(b, "type"), ea, eb)
  }
  si ($nx_ga == "ind") {
    si (noy_nom(a) != noy_nom(b)) { retour faux }
    retour noy_alpha_liste(noy_champ_liste(a, "params"),
                           noy_champ_liste(b, "params"), ea, eb)
  }
  si ($nx_ga == "elim") {
    si (noy_nom(a) != noy_nom(b)) { retour faux }
    si (non noy_alpha(noy_champ(a, "motif"), noy_champ(b, "motif"), ea, eb)) {
      retour faux
    }
    retour noy_alpha_liste(noy_champ_liste(a, "branches"),
                           noy_champ_liste(b, "branches"), ea, eb)
  }
  si ($nx_ga == "_absent") { retour vrai }
  retour faux
}

# Conversion avec garde et pas remontés : {ok, erreur, pas, code, contexte}.
fn noy_convertible_res(a: table, b: table, limite: entier) -> table {
  $nx_ra = noy_beta_lim(a, limite)
  $nx_rb = noy_beta_lim(b, limite)
  $nx_pa = noy_pas_beta($nx_ra)
  $nx_pb = noy_pas_beta($nx_rb)
  $nx_pas = $nx_pa + $nx_pb
  $nx_err = ""
  si (noy_erreur_beta($nx_ra) != "") { $nx_err = noy_erreur_beta($nx_ra) }
  si ($nx_err == "") { $nx_err = noy_erreur_beta($nx_rb) }
  $nx_ok = faux
  $nx_ea = [""]
  $nx_eb = [""]
  si ($nx_err == "") {
    $nx_ok = noy_alpha(noy_champ($nx_ra, "terme"),
                       noy_champ($nx_rb, "terme"), $nx_ea, $nx_eb)
  }
  $nx_res = table()
  inserer($nx_res, "ok", $nx_ok)
  inserer($nx_res, "erreur", $nx_err)
  inserer($nx_res, "pas", $nx_pas)
  inserer($nx_res, "code", "GARDE_PAS")
  inserer($nx_res, "contexte", "conversion/beta")
  retour $nx_res
}

# Interface publique historique : conversion stricte (beta + alpha), sans
# cumulativité. La cumulativité est appliquée par verifier, pas ici.
fn convertible(a: table, b: table) -> booleen {
  $nx_r = noy_convertible_res(a, b, 10000)
  retour (noy_est_ok($nx_r) et noy_erreur($nx_r) == "")
}

# Cumulativité contrôlée : a ≤ b si a ≡ b (beta+alpha) OU si les deux sont
# des univers Type(i), Type(j) avec i ≤ j. Rien d'autre n'est sous-typé.
# La garde et ses pas sont remontés exactement comme pour la conversion.
fn noy_cumul_res(a: table, b: table, limite: entier) -> table {
  $nx_ra = noy_beta_lim(a, limite)
  $nx_pa = noy_pas_beta($nx_ra)
  $nx_rb = noy_beta_lim(b, limite - $nx_pa)
  $nx_pas = $nx_pa + noy_pas_beta($nx_rb)
  $nx_err = noy_erreur_beta($nx_ra)
  si ($nx_err == "") { $nx_err = noy_erreur_beta($nx_rb) }
  $nx_ok = faux
  si ($nx_err == "") {
    $nx_ea = [""]
    $nx_eb = [""]
    $nx_ta = noy_champ($nx_ra, "terme")
    $nx_tb = noy_champ($nx_rb, "terme")
    $nx_ok = noy_alpha($nx_ta, $nx_tb, $nx_ea, $nx_eb)
    si (non $nx_ok) {
      si (noy_genre($nx_ta) == "type" et noy_genre($nx_tb) == "type") {
        $nx_i = noy_niveau($nx_ta)
        $nx_j = noy_niveau($nx_tb)
        si ($nx_i >= 0 et $nx_j >= 0 et $nx_i <= $nx_j) { $nx_ok = vrai }
      }
    }
  }
  $nx_res = table()
  inserer($nx_res, "ok", $nx_ok)
  inserer($nx_res, "erreur", $nx_err)
  inserer($nx_res, "pas", $nx_pas)
  inserer($nx_res, "code", "GARDE_PAS")
  inserer($nx_res, "contexte", "conversion/cumul")
  retour $nx_res
}

# Helper public (non destructif) : cumulativité bornée, sans remontée d'erreur.
fn cumulatif(a: table, b: table) -> booleen {
  $nx_r = noy_cumul_res(a, b, 10000)
  retour (noy_est_ok($nx_r) et noy_erreur($nx_r) == "")
}

# ─────────────────────── 7. Contextes ──────────────────────────────────────

fn noy_ctx_vide() -> liste<table> {
  $nx_c = [table()]
  retour $nx_c
}

# Accepte liste<table> REMBOURRÉE ou table {nom: Terme}.
fn noy_normaliser_ctx(ctx) -> liste<table> {
  $nx_r = [table()]
  si (type(ctx) == "liste") {
    $nx_c = [table()]
    $nx_c = ctx
    retour $nx_c
  }
  si (type(ctx) == "table") {
    $nx_tb = table()
    $nx_tb = ctx
    $nx_ks = cles($nx_tb)
    $nx_n = longueur($nx_ks)
    $nx_k = 0
    tant_que ($nx_k < $nx_n) {
      $nx_key = ""
      $nx_key = $nx_ks[$nx_k]
      $nx_e = table()
      inserer($nx_e, "nom", $nx_key)
      $nx_v = $nx_tb[$nx_key]
      inserer($nx_e, "type", $nx_v)
      joindre($nx_r, $nx_e)
      $nx_k = $nx_k + 1
    }
  }
  retour $nx_r
}

# Nouveau contexte (non destructif) : la liaison ajoutée masque les précédentes.
fn noy_ctx_ajouter(ctx: liste<table>, n: chaine, ty: table) -> liste<table> {
  $nx_r = [table()]
  $nx_cnt = longueur(ctx)
  $nx_k = 1
  tant_que ($nx_k < $nx_cnt) {
    joindre($nx_r, ctx[$nx_k])
    $nx_k = $nx_k + 1
  }
  $nx_e = table()
  inserer($nx_e, "nom", n)
  inserer($nx_e, "type", ty)
  joindre($nx_r, $nx_e)
  retour $nx_r
}

fn noy_ctx_type(ctx: liste<table>, n: chaine) -> table {
  $nx_r = noy_absent()
  $nx_cnt = longueur(ctx)
  $nx_k = $nx_cnt - 1
  tant_que ($nx_k >= 1) {
    $nx_e = ctx[$nx_k]
    si (noy_nom($nx_e) == n) {
      $nx_r = noy_champ($nx_e, "type")
      retour $nx_r
    }
    $nx_k = $nx_k - 1
  }
  retour $nx_r
}

# ──────────────────── 8. Synthèse de type (le vérificateur) ────────────────

# ───────────────── 8bis. Résultats structurés (codes d'erreur) ──────────────
#
# Tout Resultat rendu par verifier porte désormais, en plus de {ok,type,erreur}
# historique, les champs :
#   code      : chaine  — identifiant stable (OK, VAR_NON_LIE, GARDE_PAS, …)
#   contexte  : chaine  — règle du noyau qui a échoué (Var, Pi, App, Eq, …)
#   ligne     : entier  — champOptionnel « ligne » du terme fautif, 0 si absent
#   pas       : entier  — nombre de pas de réduction consommés
# Aucun champ n'est exigé d'un terme entrant : tout est défensif, jamais de
# panique, même sur une table vide ou un champ de mauvais type.

fn noy_resultat_plein(ok: booleen, ty: table, msg: chaine, code: chaine,
                      ctx: chaine, ligne: entier, pas: entier) -> table {
  $nx_r = table()
  inserer($nx_r, "ok", ok)
  inserer($nx_r, "type", ty)
  inserer($nx_r, "erreur", msg)
  inserer($nx_r, "code", code)
  inserer($nx_r, "contexte", ctx)
  inserer($nx_r, "ligne", ligne)
  inserer($nx_r, "pas", pas)
  retour $nx_r
}

fn noy_ok(ty: table, pas: entier) -> table {
  retour noy_resultat_plein(vrai, ty, "", "OK", "", 0, pas)
}

fn noy_err(msg: chaine, pas: entier) -> table {
  retour noy_err_c(msg, "ERREUR", "", pas)
}

fn noy_err_c(msg: chaine, code: chaine, ctx: chaine, pas: entier) -> table {
  retour noy_resultat_plein(faux, noy_absent(), msg, code, ctx, 0, pas)
}

fn noy_est_ok(r: table) -> booleen {
  $nx_v = faux
  si (cle_existe(r, "ok")) {
    $nx_x = r["ok"]
    si (type($nx_x) == "booleen") { $nx_v = $nx_x }
  }
  retour $nx_v
}

fn noy_erreur(r: table) -> chaine {
  $nx_v = ""
  si (cle_existe(r, "erreur")) {
    $nx_x = r["erreur"]
    si (type($nx_x) == "chaine") { $nx_v = $nx_x }
  }
  retour $nx_v
}

fn noy_type_res(r: table) -> table {
  retour noy_champ(r, "type")
}

fn noy_pas_res(r: table) -> entier {
  $nx_v = 0
  si (cle_existe(r, "pas")) {
    $nx_x = r["pas"]
    si (type($nx_x) == "entier") { $nx_v = $nx_x }
  }
  retour $nx_v
}

fn noy_chaine_res(r: table, cle: chaine) -> chaine {
  $nx_v = ""
  si (cle_existe(r, cle)) {
    $nx_x = r[cle]
    si (type($nx_x) == "chaine") { $nx_v = $nx_x }
  }
  retour $nx_v
}

fn noy_code(r: table) -> chaine { retour noy_chaine_res(r, "code") }
fn noy_contexte(r: table) -> chaine { retour noy_chaine_res(r, "contexte") }

fn noy_ligne_res(r: table) -> entier {
  $nx_v = 0
  si (cle_existe(r, "ligne")) {
    $nx_x = r["ligne"]
    si (type($nx_x) == "entier") { $nx_v = $nx_x }
  }
  retour $nx_v
}

# Détection d'univers AVEC garde remontée. Contrairement à l'ancienne version,
# la limite est celle de la synthèse en cours (et non un plafond fixe de 1000),
# l'erreur de beta n'est plus avalée et les pas consommés sont réinjectés.
# Rend {niveau, erreur, code, contexte, pas}.
fn noy_univers_res(t: table, limite: entier) -> table {
  $nx_r = noy_beta_lim(t, limite)
  $nx_u = noy_champ($nx_r, "terme")
  $nx_v = -1
  si (noy_genre($nx_u) == "type") { $nx_v = noy_niveau($nx_u) }
  $nx_res = table()
  inserer($nx_res, "niveau", $nx_v)
  inserer($nx_res, "erreur", noy_erreur_beta($nx_r))
  inserer($nx_res, "code", "GARDE_PAS")
  inserer($nx_res, "contexte", "univers/beta")
  inserer($nx_res, "pas", noy_pas_beta($nx_r))
  retour $nx_res
}

# Wrapper historique (niveau seul, -1 si ce n'est pas un univers).
fn noy_univers(t: table) -> entier {
  retour noy_entier_champ(noy_univers_res(t, 1000), "niveau")
}

# Wrapper de synthèse : propage le numéro de ligne du terme fautif vers le
# Resultat, sans jamais l'exiger (0 par défaut). Les appels récursifs de
# noy_synth0 passent par ici pour que la ligne la plus interne soit conservée.
fn noy_synth(t: table, ctx: liste<table>, limite: entier, pas0: entier) -> table {
  $nx_r = noy_synth0(t, ctx, limite, pas0)
  $nx_l = noy_ligne(t)
  si ($nx_l != 0 et non noy_est_ok($nx_r) et noy_ligne_res($nx_r) == 0) {
    inserer($nx_r, "ligne", $nx_l)
  }
  retour $nx_r
}

fn noy_synth0(t: table, ctx: liste<table>, limite: entier, pas0: entier) -> table {
  si (pas0 >= limite) {
    retour noy_err_c("depassement de la garde de pas (" + chaine(limite) + ")",
                     "GARDE_PAS", "synthese", pas0)
  }

  $nx_g = noy_genre(t)

  si ($nx_g == "var") {
    $nx_ty = noy_ctx_type(ctx, noy_nom(t))
    si (noy_est_absent($nx_ty)) {
      retour noy_err_c("variable non liee: " + noy_nom(t), "VAR_NON_LIE", "Var", pas0)
    }
    retour noy_ok($nx_ty, pas0)
  }

  # Règle Type(n) : Type(n+1).
  si ($nx_g == "type") {
    $nx_n = noy_niveau(t)
    si ($nx_n < 0) {
      retour noy_err_c("niveau de type negatif", "NIVEAU_NEGATIF", "Type", pas0)
    }
    retour noy_ok(noy_type($nx_n + 1), pas0)
  }

  # Règle Π. Les niveaux sont contrôlés avec la garde de la synthèse en cours ;
  # les pas de la détection d'univers sont réinjectés, plus avalés.
  si ($nx_g == "pi") {
    $nx_r1 = noy_synth(noy_champ(t, "domaine"), ctx, limite, pas0)
    si (non noy_est_ok($nx_r1)) { retour $nx_r1 }
    $nx_p1 = noy_pas_res($nx_r1)
    $nx_u1 = noy_univers_res(noy_type_res($nx_r1), limite - $nx_p1)
    $nx_pu1 = $nx_p1 + noy_pas_res($nx_u1)
    si (noy_erreur($nx_u1) != "") {
      retour noy_err_c(noy_erreur($nx_u1), "GARDE_PAS", "Pi/domaine/univers", $nx_pu1)
    }
    $nx_i = noy_entier_champ($nx_u1, "niveau")
    si ($nx_i < 0) {
      retour noy_err_c("domaine de Pi non typé par un univers", "UNIVERS", "Pi/domaine", $nx_pu1)
    }
    $nx_ctx2 = noy_ctx_ajouter(ctx, noy_nom(t), noy_champ(t, "domaine"))
    $nx_r2 = noy_synth(noy_champ(t, "codomaine"), $nx_ctx2, limite, $nx_pu1)
    si (non noy_est_ok($nx_r2)) { retour $nx_r2 }
    $nx_p2 = noy_pas_res($nx_r2)
    $nx_u2 = noy_univers_res(noy_type_res($nx_r2), limite - $nx_p2)
    $nx_pu2 = $nx_p2 + noy_pas_res($nx_u2)
    si (noy_erreur($nx_u2) != "") {
      retour noy_err_c(noy_erreur($nx_u2), "GARDE_PAS", "Pi/codomaine/univers", $nx_pu2)
    }
    $nx_j = noy_entier_champ($nx_u2, "niveau")
    si ($nx_j < 0) {
      retour noy_err_c("codomaine de Pi non typé par un univers", "UNIVERS", "Pi/codomaine", $nx_pu2)
    }
    retour noy_ok(noy_type(max($nx_i, $nx_j)), $nx_pu2)
  }

  # Règle λ : type = Π(nom, domaine, type_du_corps).
  si ($nx_g == "lam") {
    $nx_r1 = noy_synth(noy_champ(t, "domaine"), ctx, limite, pas0)
    si (non noy_est_ok($nx_r1)) { retour $nx_r1 }
    $nx_p1 = noy_pas_res($nx_r1)
    $nx_u1 = noy_univers_res(noy_type_res($nx_r1), limite - $nx_p1)
    $nx_pu1 = $nx_p1 + noy_pas_res($nx_u1)
    si (noy_erreur($nx_u1) != "") {
      retour noy_err_c(noy_erreur($nx_u1), "GARDE_PAS", "Lam/domaine/univers", $nx_pu1)
    }
    $nx_i = noy_entier_champ($nx_u1, "niveau")
    si ($nx_i < 0) {
      retour noy_err_c("domaine de Lambda non typé par un univers", "UNIVERS", "Lam/domaine", $nx_pu1)
    }
    $nx_ctx2 = noy_ctx_ajouter(ctx, noy_nom(t), noy_champ(t, "domaine"))
    $nx_r2 = noy_synth(noy_champ(t, "corps"), $nx_ctx2, limite, $nx_pu1)
    si (non noy_est_ok($nx_r2)) { retour $nx_r2 }
    $nx_ty = noy_pi(noy_nom(t), noy_champ(t, "domaine"), noy_type_res($nx_r2))
    retour noy_ok($nx_ty, noy_pas_res($nx_r2))
  }

  # Règle App : fonction : Πx:A.B, argument : A  =>  B[argument/x].
  si ($nx_g == "app") {
    $nx_rf = noy_synth(noy_champ(t, "fonction"), ctx, limite, pas0)
    si (non noy_est_ok($nx_rf)) { retour $nx_rf }
    $nx_pas1 = noy_pas_res($nx_rf)
    $nx_rb = noy_beta_lim(noy_type_res($nx_rf), limite - $nx_pas1)
    $nx_pas2 = $nx_pas1 + noy_pas_beta($nx_rb)
    si (noy_erreur_beta($nx_rb) != "") {
      retour noy_err_c(noy_erreur_beta($nx_rb), "GARDE_PAS", "App/type-fonction", $nx_pas2)
    }
    $nx_ft = noy_champ($nx_rb, "terme")
    si (noy_genre($nx_ft) != "pi") {
      retour noy_err_c("application d'un terme dont le type n'est pas un Pi", "APP_PAS_PI", "App", $nx_pas2)
    }
    $nx_ra = noy_synth(noy_champ(t, "argument"), ctx, limite, $nx_pas2)
    si (non noy_est_ok($nx_ra)) { retour $nx_ra }
    $nx_pas3 = noy_pas_res($nx_ra)
    $nx_dom = noy_champ($nx_ft, "domaine")
    $nx_cv = noy_cumul_res(noy_type_res($nx_ra), $nx_dom, limite - $nx_pas3)
    $nx_pas4 = $nx_pas3 + noy_pas_res($nx_cv)
    si (noy_erreur($nx_cv) != "") {
      retour noy_err_c(noy_erreur($nx_cv), "GARDE_PAS", "App/conversion", $nx_pas4)
    }
    si (non noy_est_ok($nx_cv)) {
      $nx_code = "APP_ARG"
      si (noy_univers(noy_type_res($nx_ra)) >= 0 et noy_univers($nx_dom) >= 0) {
        $nx_code = "CUMUL"
      }
      retour noy_err_c("type de l'argument incompatible avec le domaine",
                       $nx_code, "App", $nx_pas4)
    }
    $nx_res = noy_subst(noy_champ($nx_ft, "codomaine"), noy_nom($nx_ft), noy_champ(t, "argument"))
    retour noy_ok($nx_res, $nx_pas4)
  }

  si ($nx_g == "const" ou $nx_g == "constructeur") {
    $nx_ann = noy_champ(t, "type")
    $nx_rt = noy_synth($nx_ann, ctx, limite, pas0)
    si (non noy_est_ok($nx_rt)) { retour $nx_rt }
    $nx_pas1 = noy_pas_res($nx_rt)
    $nx_ua = noy_univers_res(noy_type_res($nx_rt), limite - $nx_pas1)
    $nx_pas2 = $nx_pas1 + noy_pas_res($nx_ua)
    si (noy_erreur($nx_ua) != "") {
      retour noy_err_c(noy_erreur($nx_ua), "GARDE_PAS", "const/annotation/univers", $nx_pas2)
    }
    $nx_lev = noy_entier_champ($nx_ua, "niveau")
    si ($nx_lev < 0) {
      retour noy_err_c("annotation de type non bien formée", "ANNOTATION", "const", $nx_pas2)
    }
    retour noy_ok($nx_ann, $nx_pas2)
  }

  # ind : validation structurelle des paramètres PLUS contrôle de formation
  # des égalités. Le type rendu reste une approximation documentée Type(0).
  #   ind("=",[a,b])    → a et b doivent avoir des types convertibles
  #   ind("Eq",[A,a,b]) → a et b doivent avoir le type A
  # Les autres inductifs ne sont pas contrôlés au-delà de leurs paramètres.
  si ($nx_g == "ind") {
    $nx_pl = noy_champ_liste(t, "params")
    $nx_n = longueur($nx_pl)
    $nx_k = 1
    $nx_pas = pas0
    $nx_tys = [table()]
    tant_que ($nx_k < $nx_n) {
      $nx_r = noy_synth($nx_pl[$nx_k], ctx, limite, $nx_pas)
      si (non noy_est_ok($nx_r)) {
        $nx_code = "IND_PARAM"
        si (noy_code($nx_r) == "GARDE_PAS") { $nx_code = "GARDE_PAS" }
        retour noy_err_c(noy_erreur($nx_r), $nx_code, "ind/param" + chaine($nx_k), noy_pas_res($nx_r))
      }
      $nx_pas = noy_pas_res($nx_r)
      joindre($nx_tys, noy_type_res($nx_r))
      $nx_k = $nx_k + 1
    }
    # égalité à deux paramètres (format canonique produit par le parseur)
    si (noy_nom(t) == "=" et $nx_n == 3) {
      $nx_cv = noy_convertible_res($nx_tys[1], $nx_tys[2], limite - $nx_pas)
      $nx_pas2 = $nx_pas + noy_pas_res($nx_cv)
      si (noy_erreur($nx_cv) != "") {
        retour noy_err_c(noy_erreur($nx_cv), "GARDE_PAS", "ind(=)/conversion", $nx_pas2)
      }
      si (non noy_est_ok($nx_cv)) {
        retour noy_err_c("membres d'une egalite de types differents", "EQ_MAL_TYPE", "ind(=)", $nx_pas2)
      }
      retour noy_ok(noy_type(0), $nx_pas2)
    }
    # égalité à trois paramètres (format explicite Eq(A,a,b))
    si (noy_nom(t) == "Eq" et $nx_n == 4) {
      $nx_A = $nx_pl[1]
      $nx_cv1 = noy_convertible_res($nx_tys[2], $nx_A, limite - $nx_pas)
      $nx_pas2 = $nx_pas + noy_pas_res($nx_cv1)
      si (noy_erreur($nx_cv1) != "") {
        retour noy_err_c(noy_erreur($nx_cv1), "GARDE_PAS", "ind(Eq)/conversion", $nx_pas2)
      }
      si (non noy_est_ok($nx_cv1)) {
        retour noy_err_c("premier membre de Eq hors de A", "EQ_MAL_TYPE", "ind(Eq)/a", $nx_pas2)
      }
      $nx_cv2 = noy_convertible_res($nx_tys[3], $nx_A, limite - $nx_pas2)
      $nx_pas3 = $nx_pas2 + noy_pas_res($nx_cv2)
      si (noy_erreur($nx_cv2) != "") {
        retour noy_err_c(noy_erreur($nx_cv2), "GARDE_PAS", "ind(Eq)/conversion", $nx_pas3)
      }
      si (non noy_est_ok($nx_cv2)) {
        retour noy_err_c("second membre de Eq hors de A", "EQ_MAL_TYPE", "ind(Eq)/b", $nx_pas3)
      }
      retour noy_ok(noy_type(0), $nx_pas3)
    }
    retour noy_ok(noy_type(0), $nx_pas)
  }

  si ($nx_g == "elim") {
    $nx_rm = noy_synth(noy_champ(t, "motif"), ctx, limite, pas0)
    si (non noy_est_ok($nx_rm)) {
      retour noy_err_c(noy_erreur($nx_rm), noy_code($nx_rm), "elim/motif", noy_pas_res($nx_rm))
    }
    $nx_pas = noy_pas_res($nx_rm)
    $nx_bl = noy_champ_liste(t, "branches")
    $nx_n = longueur($nx_bl)
    $nx_k = 1
    tant_que ($nx_k < $nx_n) {
      $nx_r = noy_synth($nx_bl[$nx_k], ctx, limite, $nx_pas)
      si (non noy_est_ok($nx_r)) {
        retour noy_err_c(noy_erreur($nx_r), noy_code($nx_r), "elim/branche" + chaine($nx_k), noy_pas_res($nx_r))
      }
      $nx_pas = noy_pas_res($nx_r)
      $nx_k = $nx_k + 1
    }
    retour noy_ok(noy_type(0), $nx_pas)
  }

  retour noy_err_c("genre de terme inconnu ou mal formé: " + $nx_g,
                   "GENRE_INCONNU", "synth", pas0)
}

# ────────────────────────── 9. Interface publique ──────────────────────────

fn verifier_lim(t: table, ctx, limite: entier) -> table {
  $nx_c = noy_normaliser_ctx(ctx)
  $nx_r = noy_synth(t, $nx_c, limite, 0)
  $nx_res = table()
  inserer($nx_res, "ok", noy_est_ok($nx_r))
  inserer($nx_res, "type", noy_type_res($nx_r))
  inserer($nx_res, "erreur", noy_erreur($nx_r))
  inserer($nx_res, "code", noy_code($nx_r))
  inserer($nx_res, "contexte", noy_contexte($nx_r))
  inserer($nx_res, "ligne", noy_ligne_res($nx_r))
  inserer($nx_res, "pas", noy_pas_res($nx_r))
  retour $nx_res
}

fn verifier(t: table, ctx) -> table {
  retour verifier_lim(t, ctx, 10000)
}

fn bien_forme(t: table, ctx) -> booleen {
  $nx_g = noy_genre(t)
  $nx_connu = faux
  si ($nx_g == "var" ou $nx_g == "type" ou $nx_g == "pi" ou $nx_g == "lam" ou
      $nx_g == "app" ou $nx_g == "const" ou $nx_g == "ind" ou
      $nx_g == "constructeur" ou $nx_g == "elim") { $nx_connu = vrai }
  si (non $nx_connu) { retour faux }
  $nx_r = verifier(t, ctx)
  retour noy_est_ok($nx_r)
}
