# ── Thorn — lexeur (PROV2) ────────────────────────────────────────────────
# Fichier autonome : aucun import, aucune variable globale (importer n'execute
# pas les instructions de tete du fichier importe).
# Verifier : ./rose/rose verif thorn/src/lexeur.rose
#
# API publique :
#   lexer(src)          -> liste<chaine> : jetons nus
#   lexer_detaille(src) -> liste<chaine> : jetons "texte~ligne"
#
# Le suffixe "~N" porte le numero de ligne. "~" ne peut jamais apparaitre dans
# un jeton Thorn (identifiants = lettres/accents/chiffres/tiret bas).
# analyser() accepte les deux formes. Aucune exception : un caractere inconnu
# donne le jeton "?" que le parseur signale avec sa ligne.

fn lex_est_lettre(c: chaine) -> booleen {
    si (longueur(c) == 0) { retour faux }
    $o = ordre(c)
    retour ($o >= 97 et $o <= 122) ou ($o >= 65 et $o <= 90) ou
           $o >= 128 ou c == "_"
}

fn lex_est_chiffre(c: chaine) -> booleen {
    si (longueur(c) == 0) { retour faux }
    $o = ordre(c)
    retour $o >= 48 et $o <= 57
}

fn lex_est_id(c: chaine) -> booleen {
    retour lex_est_lettre(c) ou lex_est_chiffre(c)
}

fn lex_est_simple(c: chaine) -> booleen {
    retour c == "=" ou c == ":" ou c == "," ou c == ";" ou
           c == "(" ou c == ")" ou c == "+" ou c == "-" ou
           c == "*" ou c == "/" ou c == "[" ou c == "]" ou
           c == "{" ou c == "}"
}

fn lex_emette(tab, k: entier, tok: chaine, ligne: entier, detaille: booleen) -> entier {
    $t = tok
    si (detaille) { $t = tok + "~" + chaine(ligne) }
    inserer(tab, k, $t)
    retour k + 1
}

fn syl_lexe(src: chaine, detaille: booleen) {
    $tab = table()
    $n = longueur(src)
    $i = 0
    $k = 0
    $ligne = 1
    tant_que ($i < $n) {
        $c = sous_chaine(src, $i, $i + 1)
        si ($c == "\n") {
            $ligne = $ligne + 1
            $i = $i + 1
        } sinon si ($c == " " ou $c == "\t" ou $c == "\r") {
            $i = $i + 1
        } sinon si ($c == "#") {
            tant_que ($i < $n et sous_chaine(src, $i, $i + 1) != "\n") {
                $i = $i + 1
            }
        } sinon si (lex_est_lettre($c)) {
            $deb = $i
            $i = $i + 1
            tant_que ($i < $n et lex_est_id(sous_chaine(src, $i, $i + 1))) {
                $i = $i + 1
            }
            $k = lex_emette($tab, $k, sous_chaine(src, $deb, $i), $ligne, detaille)
        } sinon si (lex_est_chiffre($c)) {
            $deb = $i
            $i = $i + 1
            tant_que ($i < $n et lex_est_chiffre(sous_chaine(src, $i, $i + 1))) {
                $i = $i + 1
            }
            $k = lex_emette($tab, $k, sous_chaine(src, $deb, $i), $ligne, detaille)
        } sinon si ($c == "-" et $i + 1 < $n et sous_chaine(src, $i + 1, $i + 2) == ">") {
            $k = lex_emette($tab, $k, "->", $ligne, detaille)
            $i = $i + 2
        } sinon si ($c == "=" et $i + 1 < $n et sous_chaine(src, $i + 1, $i + 2) == ">") {
            $k = lex_emette($tab, $k, "=>", $ligne, detaille)
            $i = $i + 2
        } sinon si (lex_est_simple($c)) {
            $k = lex_emette($tab, $k, $c, $ligne, detaille)
            $i = $i + 1
        } sinon {
            $k = lex_emette($tab, $k, "?", $ligne, detaille)
            $i = $i + 1
        }
    }
    $res = table()
    inserer($res, "n", $k)
    inserer($res, "j", valeurs($tab))
    retour $res
}

fn lexer(src: chaine) {
    $r = syl_lexe(src, faux)
    retour $r["j"]
}

fn lexer_detaille(src: chaine) {
    $r = syl_lexe(src, vrai)
    retour $r["j"]
}

# Variante interne : rend {n: nombre de jetons, j: jetons detailles}.
fn lexer_table(src: chaine) {
    retour syl_lexe(src, vrai)
}
