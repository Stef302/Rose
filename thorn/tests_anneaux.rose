# ═════════════════════════════════════════════════════════════════════════════
# thorn/tests_anneaux.rose — REJEU DU JALON M2 (demi-anneaux et anneaux)
# ═════════════════════════════════════════════════════════════════════════════
# Fichier NOUVEAU. Aucun fichier existant n'est modifié. Aucun commit.
#
# Chaque lemme générique est construit UNE fois, puis soumis à verifier() ET
# convertible() du noyau, puis mémorisé pour que les lemmes suivants réutilisent
# son terme au lieu de le reconstruire (cache de anneaux.rose).
# Aucun compteur n'est codé en dur : une preuve fausse est refusée ([refus]).
#
# Vérifier :  ./rose/rose verif thorn/tests_anneaux.rose
# Exécuter :  ./rose/rose thorn/tests_anneaux.rose
# ═════════════════════════════════════════════════════════════════════════════

importer "thorn/src/anneaux.rose"

$an_cpt = table()
inserer($an_cpt, "r", 0)
inserer($an_cpt, "e", 0)

fn an_test_refus(an_nom: chaine, an_but: table, an_terme: table, an_cpt: table) {
  $an_vr = verifier(an_terme, ta_ctx())
  $an_refuse = (non noy_est_ok($an_vr)) ou
                (non convertible(noy_type_res($an_vr), an_but))
  si ($an_refuse) { >> "OK [refus] " + an_nom }
  sinon { >> "ECHEC [refus] " + an_nom + " (preuve fausse acceptée)" }
  an_compter(an_cpt, $an_refuse)
}

>> "Thorn — jalon M2 : demi-anneaux et anneaux vérifiés par le noyau"

$an_abs = an_inst_abstrait()
$an_ctx_abs = an_ctx_de($an_abs)
$an_reg = mg_registre()
>> "contexte abstrait : " + chaine(longueur($an_ctx_abs) - 1) + " declaration(s)"

# ── 1. Structures et registre ───────────────────────────────────────────────
an_test_bool("structure/AnneauOrdreAbstrait est CommRing",
             an_est_comm_ring($an_abs), $an_cpt)
an_test_bool("structure/AnneauOrdreAbstrait est OrdreRing",
             an_est_ordre_ring($an_abs), $an_cpt)
# ── 2. Lois Nat certifiées rejouables sous le plafond mémoire (6 Gio) ────────
# Les termes lourds (distrib_d, mult_assoc, mult_un_g) sont construits dans
# an_inst_nat() mais leur construction dans le même processus que le corpus
# générique dépasserait le garde-fou : ils sont vérifiés par ailleurs dans
# thorn/tests_algebre.rose (34/0, porte de non-régression). Ici on rejoue les
# lois dont le terme est peu coûteux.
an_lance("loi/add_assoc[Nat]", al_lem_plus_assoc(), ta_ctx(), $an_cpt)
an_lance("loi/add_zero_l[Nat]", al_lem_plus_zero_l(), ta_ctx(), $an_cpt)
an_lance("loi/add_zero_d[Nat]", al_lem_plus_zero_d(), ta_ctx(), $an_cpt)
an_lance("loi/mul_zero_g[Nat]", al_lem_mult_zero_g(), ta_ctx(), $an_cpt)
an_lance("loi/mul_zero_d[Nat]", al_lem_mult_zero_d(), ta_ctx(), $an_cpt)

# ── 3. Corpus générique (contexte abstrait, ordre de dépendance) ────────────
