an_lance("gen/le_add_of_nonneg_right", $an_p_le_add_of_nonneg_right, $an_ctx_abs, $an_cpt)
an_memo_stocker("le_add_of_nonneg_right", $an_abs, $an_p_le_add_of_nonneg_right)

# Refus honnête : la réflexivité de 0=0 ne prouve pas 0=1.
$an_faux_but = ta_eq(ta_nat(),ta_zero(),ta_succ(ta_zero()))
$an_faux_preuve = ta_ap2(ta_refl_symbole(),ta_nat(),ta_zero())
an_test_refus("refus/0=0 n'est pas 0=1", $an_faux_but, $an_faux_preuve, $an_cpt)

>> chaine($an_cpt["r"]) + " contrôle(s) réussi(s), " + chaine($an_cpt["e"]) + " échec(s)"
si ($an_cpt["e"] == 0) {
  >> "RESULTAT: OK"
} sinon {
  >> "RESULTAT: ECHEC"
  quitter(1)
}
