# ═══════════════════════════════════════════════════════════════════════════
# thorn/tests_pilote.rose — tests bout en bout du pilote CLI de Thorn (PROV4)
# Lancer depuis la racine : ./rose/rose thorn/tests_pilote.rose
# Vérifier : ./rose/rose verif thorn/tests_pilote.rose
#
# Le pilote est importé comme bibliothèque : ses fonctions pures sont
# appelées directement. Le `quitter(...)` final empêche le CLI du module
# importé de s'exécuter (Rose exécute le corps importé après le programme
# principal). Aucun sous-processus n'est nécessaire.
# ═══════════════════════════════════════════════════════════════════════════

importer "thorn/src/principal.rose"

$tp_cpt = table()
inserer($tp_cpt, "r", 0)
inserer($tp_cpt, "e", 0)

fn tp_ok(nom: chaine) {
  >> "✓ " + nom
  $tp_v = $tp_cpt["r"]
  inserer($tp_cpt, "r", $tp_v + 1)
}

fn tp_ko(nom: chaine, obtenu: chaine, attendu: chaine) {
  >> "✗ " + nom + " : obtenu [" + obtenu + "], attendu [" + attendu + "]"
  $tp_v = $tp_cpt["e"]
  inserer($tp_cpt, "e", $tp_v + 1)
}

fn tp_egal(nom: chaine, obtenu: chaine, attendu: chaine) {
  si (obtenu == attendu) { tp_ok(nom) } sinon { tp_ko(nom, obtenu, attendu) }
}

fn tp_code(nom: chaine, obtenu: entier, attendu: entier) {
  tp_egal(nom, chaine(obtenu), chaine(attendu))
}

fn tp_contient(nom: chaine, texte: chaine, morceau: chaine) {
  $tp_i = sous_chaine(texte, 0, longueur(morceau))
  $tp_k = 0
  $tp_trouve = faux
  tant_que ($tp_k <= longueur(texte)) {
    si (sous_chaine(texte, $tp_k, $tp_k + longueur(morceau)) == morceau) {
      $tp_trouve = vrai
    }
    $tp_k = $tp_k + 1
  }
  si ($tp_trouve) { tp_ok(nom) } sinon { tp_ko(nom, texte, "contient " + morceau) }
}

# ── 1. --aide : texte exact ────────────────────────────────────────────────

$tp_aide = pilote_aide()
$tp_attendu_aide = "Thorn — pilote de démonstration (en Rose)\n\n" +
  "Usage :\n" +
  "  rose thorn/src/principal.rose <fichier.thn>  vérifie chaque théorème\n" +
  "  rose thorn/src/principal.rose --demo [fichiers.thn...]\n" +
  "  rose thorn/src/principal.rose --aide\n\n" +
  "Options :\n" +
  "  --trace  affiche les termes construits\n\n" +
  "Format d'un fichier .thn :\n" +
  "  théorème <nom> : <type du but>\n" +
  "  preuve <tactique>\n" +
  "Tactiques : reflexivite, symetrie, introduction, application,\n" +
  "induction, simplifier. La preuve peut aussi être un terme.\n\n" +
  "Sortie : OK <nom> ou ÉCHEC <nom> : <raison>, puis\n" +
  "« N théorème(s), M réussi(s) ».\n" +
  "Codes : 0 tout passe, 1 échec de preuve, 2 lecture/parsing."
tp_egal("aide : texte exact", $tp_aide, $tp_attendu_aide)

# ── 2. lecture d'un fichier .thn écrit par le test ─────────────────────────

$tp_ok_slg = "/tmp/opencode/thorn_pilote_ok.thn"
$tp_ko_slg = "/tmp/opencode/thorn_pilote_ko.thn"
$tp_src_ok = "théorème t_ok : type 1\n" +
             "preuve type 0\n" +
             "fin\n"
$tp_src_ko = "théorème t_ko : type 1\n" +
             "preuve type 1\n" +
             "fin\n"
ecrire_texte($tp_ok_slg, $tp_src_ok)
ecrire_texte($tp_ko_slg, $tp_src_ko)

$tp_r_ok = pilote_executer($tp_ok_slg, faux)
$tp_sortie_ok = ""
$tp_sortie_ok = chaine($tp_r_ok["sortie"])
$tp_code_ok = 0
$tp_code_ok = entier(chaine($tp_r_ok["code"]))
tp_egal("fichier OK : sortie exacte", $tp_sortie_ok,
        "OK t_ok\n1 théorème(s), 1 réussi(s)")
tp_code("fichier OK : code 0", $tp_code_ok, 0)

$tp_r_ko = pilote_executer($tp_ko_slg, faux)
$tp_sortie_ko = ""
$tp_sortie_ko = chaine($tp_r_ko["sortie"])
$tp_code_ko = 0
$tp_code_ko = entier(chaine($tp_r_ko["code"]))
tp_contient("fichier ÉCHEC : préfixe", $tp_sortie_ko, "ÉCHEC t_ko : ")
tp_contient("fichier ÉCHEC : bilan", $tp_sortie_ko, "1 théorème(s), 0 réussi(s)")
tp_code("fichier ÉCHEC : code 1", $tp_code_ko, 1)

# ── 3. lecture impossible → code 2, sans panic ─────────────────────────────

$tp_r_abs = pilote_executer("/tmp/opencode/thorn_pilote_inexistant.thn", faux)
$tp_code_abs = 0
$tp_code_abs = entier(chaine($tp_r_abs["code"]))
tp_code("fichier absent : code 2", $tp_code_abs, 2)

# ── 4. --trace : les termes construits apparaissent ────────────────────────

$tp_r_trace = pilote_executer($tp_ok_slg, vrai)
$tp_sortie_trace = ""
$tp_sortie_trace = chaine($tp_r_trace["sortie"])
tp_contient("trace : étiquette", $tp_sortie_trace, "[trace] t_ok but =")
tp_contient("trace : terme", $tp_sortie_trace, "[trace] t_ok terme =")

# ── 5. --demo : deux fichiers explicites ───────────────────────────────────

$tp_fichiers = [$tp_ok_slg, $tp_ok_slg]
$tp_r_demo = pilote_demo($tp_fichiers, faux)
$tp_sortie_demo = ""
$tp_sortie_demo = chaine($tp_r_demo["sortie"])
$tp_total_demo = 0
$tp_total_demo = entier(chaine($tp_r_demo["total"]))
$tp_reussis_demo = 0
$tp_reussis_demo = entier(chaine($tp_r_demo["reussis"]))
$tp_code_demo = 0
$tp_code_demo = entier(chaine($tp_r_demo["code"]))
tp_contient("demo : en-tête", $tp_sortie_demo, "=== " + $tp_ok_slg + " ===")
tp_egal("demo : bilan global", chaine($tp_total_demo) + "/" + chaine($tp_reussis_demo), "2/2")
tp_code("demo : code 0", $tp_code_demo, 0)

# ── bilan ──────────────────────────────────────────────────────────────────

>> "REUSSIS=" + chaine($tp_cpt["r"])
>> "ECHOUES=" + chaine($tp_cpt["e"])
si ($tp_cpt["e"] == 0) { >> "RESULTAT: OK" } sinon { >> "RESULTAT: ECHEC" }
si ($tp_cpt["e"] == 0) { quitter(0) } sinon { quitter(1) }
