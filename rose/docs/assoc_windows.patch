     fs::write(racine.join("current"), format!("app-{version}"))
         .map_err(|e| format!("écriture de current : {e}"))?;
     let _ = fs::remove_file(&nupkg);
+    // Réaffirme l'association APRÈS la mise à jour, en pointant le chemin
