// emetteur_cpp.rose — M4.4 V3 : traducteur RIR -> C++ (entiers + chaines + globals).
// Oracle : `rose build prog.rose -o sortie.cpp` (transpiler_rir du moteur).

// ---------- utilitaires chaînes ----------
fn trim($s: chaine) -> chaine {
  $n = longueur($s)
  $i = 0
  $stop = faux
  tant_que ($i < $n et $stop == faux) {
    $c = $s[$i]
    si ($c == ' ' ou $c == '\t') { $i = $i + 1 } sinon { $stop = vrai }
  }
  $j = $n
  $stop = faux
  tant_que ($j > $i et $stop == faux) {
    $c = $s[$j-1]
    si ($c == ' ' ou $c == '\t') { $j = $j - 1 } sinon { $stop = vrai }
  }
  retour sous_chaine($s, $i, $j)
}

fn cst_promu_gd($txt: chaine) -> booleen {
  $t = $txt
  si (longueur($t) > 0) {
    si ($t[0] == '-' ou $t[0] == '+') {
      $t = sous_chaine($t, 1, longueur($t))
    }
  }
  $i = 0
  tant_que ($i < longueur($t)) {
    si ($t[$i] < '0' ou $t[$i] > '9') { retour faux }
    $i = $i + 1
  }
  si (longueur($t) == 0) { retour faux }
  si (longueur($t) > 19) { retour vrai }
  si (longueur($t) == 19) {
    si ($t >= "4611686018427387904") { retour vrai }
  }
  retour faux
}

fn prefix_cst() -> chaine {
  // le lexer du moteur avale "@c" dans un littéral de chaîne (=> "") ; on le construit.
  retour "@" + "c"
}

fn premier_espace($s: chaine) -> entier {
  $i = 0
  $stop = faux
  tant_que ($i < longueur($s) et $stop == faux) {
    si ($s[$i] == ' ') { $stop = vrai } sinon { $i = $i + 1 }
  }
  retour $i
}

fn decoupe($s: chaine, $out: liste<chaine>) {
  $r = trim($s)
  $stop = faux
  tant_que ($stop == faux) {
    si (longueur($r) == 0) { $stop = vrai } sinon {
      $p = premier_espace($r)
      joindre($out, sous_chaine($r, 0, $p))
      $r = trim(sous_chaine($r, $p, longueur($r)))
    }
  }
}

// ————— genre() : miroir de ty_of + dest_ty du transpiler (C++) —————
// Retourne la lettre de domaine d'un opérande RIR : z f s b q g l t u.
// Listes de contexte : $body (lignes), tables fn_noms/fn_ret, paramètres du
// cadre courant ($pnoms noms, $pletres lettres concaténées).
fn genre($tok: chaine, $body: liste<chaine>, $fn_noms: liste<chaine>, $fn_ret: liste<chaine>, $pnoms: liste<chaine>, $pletres: chaine) -> chaine {
  si (commence_par($tok, prefix_cst())) {
    $v = sous_chaine($tok, 2, longueur($tok))
    si (cst_promu_gd($v)) { retour "g" }
    si (contient($v, "/")) { retour "q" }
    si (contient($v, ".")) { retour "f" }
    retour "z"
  }
  si (commence_par($tok, "%") == faux) { retour "z" }
  $nm = sous_chaine($tok, 1, longueur($tok))
  // paramètre du cadre courant ?
  $j = 1
  tant_que ($j < longueur($pnoms)) {
    si ($pnoms[$j] == $nm) {
      $ix = $j - 1
      si ($ix >= 0) {
        si ($ix < longueur($pletres)) { retour $pletres[$ix] }
      }
    }
    $j = $j + 1
  }
  // produit par une instruction du corps ?
  $i = 1
  tant_que ($i < longueur($body)) {
    $bl = $body[$i]
    si (commence_par($bl, $tok + " = ")) {
      $rest = trim(sous_chaine($bl, longueur($tok) + 3, longueur($bl)))
      $toks = [""]
      decoupe($rest, $toks)
      si (longueur($toks) >= 2) {
        $op = $toks[1]
        si ($op == "cst.z") {
          si (longueur($toks) >= 3) {
            si (commence_par($toks[2], prefix_cst())) {
              $v2 = sous_chaine($toks[2], 2, longueur($toks[2]))
              si (cst_promu_gd($v2)) { retour "g" }
            }
          }
          retour "z"
        }
        si ($op == "cst.s") { retour "s" }
        si ($op == "cst.b") { retour "b" }
        si ($op == "cst.f") { retour "f" }
        si ($op == "cst.q") { retour "q" }
        si ($op == "liste.new") { retour "l" }
        si ($op == "add.f" ou $op == "sub.f" ou $op == "mul.f" ou $op == "div.f" ou $op == "neg.f") { retour "f" }
        si ($op == "add.q" ou $op == "sub.q" ou $op == "mul.q" ou $op == "div.q") { retour "q" }
        si ($op == "add.z" ou $op == "sub.z" ou $op == "mul.z" ou $op == "neg.z" ou $op == "rem.z" ou $op == "div.z" ou $op == "divf") {
          $j2 = 2
          tant_que ($j2 < longueur($toks)) {
            si (genre($toks[$j2], $body, $fn_noms, $fn_ret, $pnoms, $pletres) == "g") { retour "g" }
            $j2 = $j2 + 1
          }
          retour "z"
        }
        si (commence_par($op, "cmp.")) { retour "b" }
        si ($op == "not.b" ou $op == "and.b" ou $op == "or.b") { retour "b" }
        si ($op == "index") {
          // base non-liste -> rose_index_str (chaine) ; base liste -> type
          // du dernier élément poussé dans la liste.
          $bt = "z"
          si (longueur($toks) >= 3) { $bt = genre($toks[2], $body, $fn_noms, $fn_ret, $pnoms, $pletres) }
          si ($bt != "l") { retour "s" }
          $pt = 1
          $elt = "z"
          tant_que ($pt < longueur($body)) {
            $blp = $body[$pt]
            si (commence_par($blp, "liste.push " + $toks[2] + " ")) {
              $restp2 = trim(sous_chaine($blp, 11 + longueur($toks[2]) + 1, longueur($blp)))
              $tokp = [""]
              decoupe($restp2, $tokp)
              si (longueur($tokp) >= 2) { $elt = genre($tokp[1], $body, $fn_noms, $fn_ret, $pnoms, $pletres) }
            }
            $pt = $pt + 1
          }
          retour $elt
        }
        si ($op == "call") {
          $fname = "$"
          si (longueur($toks) >= 3) { $fname = $toks[2] }
          si (longueur($fname) > 0) {
            si ($fname[0] == '$') { $fname = sous_chaine($fname, 1, longueur($fname)) }
          }
          // fonction utilisateur : lettre de retour déclarée
          $j3 = 1
          tant_que ($j3 < longueur($fn_noms)) {
            si ($fn_noms[$j3] == $fname) { retour $fn_ret[$j3] }
            $j3 = $j3 + 1
          }
          // intrinsèques à domaine mixte : propagation grand entier
          si ($fname == "pgcd" ou $fname == "ppcm" ou $fname == "abs" ou $fname == "min" ou $fname == "max") {
            $j4 = 3
            tant_que ($j4 < longueur($toks)) {
              si (genre($toks[$j4], $body, $fn_noms, $fn_ret, $pnoms, $pletres) == "g") { retour "g" }
              $j4 = $j4 + 1
            }
          }
          si ($fname == "abs" ou $fname == "min" ou $fname == "max") {
            $j5 = 3
            $fq = ""
            tant_que ($j5 < longueur($toks)) {
              $gt = genre($toks[$j5], $body, $fn_noms, $fn_ret, $pnoms, $pletres)
              si ($gt == "f" et longueur($fq) == 0) { $fq = "f" }
              si ($gt == "q" et longueur($fq) == 0) { $fq = "q" }
              $j5 = $j5 + 1
            }
            si (longueur($fq) > 0) { retour $fq }
          }
          si ($fname == "octets" ou $fname == "tampon") { retour "t" }
          si ($fname == "cles" ou $fname == "valeurs") { retour "l" }
          si ($fname == "fraction") { retour "q" }
          si ($fname == "flottant") { retour "f" }
          si ($fname == "fibonacci" ou $fname == "factorielle" ou $fname == "puissance") { retour "g" }
          si ($fname == "millisecondes" ou $fname == "nb_arguments" ou $fname == "entier" ou $fname == "tampon_case" ou $fname == "nb_chiffres") { retour "z" }
          si ($fname == "compter_premiers" ou $fname == "pgcd" ou $fname == "ppcm" ou $fname == "hasard" ou $fname == "ordre" ou $fname == "temps") { retour "z" }
          si ($fname == "partie_entiere") { retour "z" }
          si ($fname == "argument" ou $fname == "chaine" ou $fname == "nombre_pi" ou $fname == "lire_texte") { retour "s" }
          si ($fname == "sous_chaine" ou $fname == "caractere" ou $fname == "duree" ou $fname == "concatener") { retour "s" }
          si ($fname == "est_premier") { retour "b" }
          retour "z"
        }
      }
      retour "z"
    }
    $i = $i + 1
  }
  // global : dernière affect %t "nom"
  $nomg = $nm
  $i = 1
  tant_que ($i < longueur($body)) {
    $bl = $body[$i]
    si (commence_par($bl, "affect ")) {
      $toks2 = [""]
      decoupe(sous_chaine($bl, 7, longueur($bl)), $toks2)
      si (longueur($toks2) >= 3) {
        $gn = $toks2[2]
        si (longueur($gn) > 1) {
          si ($gn[0] == '"') { $gn = sous_chaine($gn, 1, longueur($gn) - 1) }
        }
        si ($gn == $nomg) {
          $tg = $toks2[1]
          $tv = "z"
          $i2 = 1
          tant_que ($i2 < longueur($body)) {
            $bl2 = $body[$i2]
            si (commence_par($bl2, $tg + " = ")) { $tv = genre($tg, $body, $fn_noms, $fn_ret, $pnoms, $pletres) }
            $i2 = $i2 + 1
          }
          retour $tv
        }
      }
    }
    $i = $i + 1
  }
  retour "z"
}

// la valeur produite par l'instruction du temp $tname (%t…) est-elle un grand entier ?
fn inst_est_gd($tname: chaine, $body: liste<chaine>) -> booleen {
  $i = 1
  tant_que ($i < longueur($body)) {
    $bl = $body[$i]
    si (commence_par($bl, $tname + " = ")) {
      $rest = trim(sous_chaine($bl, longueur($tname) + 3, longueur($bl)))
      $toks = [""]
      decoupe($rest, $toks)
      si (longueur($toks) >= 2) {
        $op = $toks[1]
        si ($op == "cst.z") {
          si (longueur($toks) >= 3) {
            si (commence_par($toks[2], prefix_cst())) {
              $val = sous_chaine($toks[2], 2, longueur($toks[2]))
              retour cst_promu_gd($val)
            }
          }
        }
        si ($op == "add.z" ou $op == "sub.z" ou $op == "mul.z") {
          $j = 2
          tant_que ($j < longueur($toks)) {
            si (operande_est_gd($toks[$j], $body)) { retour vrai }
            $j = $j + 1
          }
        }
      }
    }
    $i = $i + 1
  }
  retour faux
}

// l'opérande (@c constante énorme, temp gd, ou global gd) est-elle un grand entier ?
fn operande_est_gd($operand: chaine, $body: liste<chaine>) -> booleen {
  si (commence_par($operand, prefix_cst())) {
    retour cst_promu_gd(sous_chaine($operand, 2, longueur($operand)))
  }
  si (commence_par($operand, "%")) {
    $i = 1
    $est_temp = faux
    tant_que ($i < longueur($body)) {
      si (commence_par($body[$i], $operand + " = ")) { $est_temp = vrai }
      $i = $i + 1
    }
    si ($est_temp) { retour inst_est_gd($operand, $body) }
    // sinon un global affect %t "nom"
    $name = sous_chaine($operand, 1, longueur($operand))
    $i = 1
    tant_que ($i < longueur($body)) {
      $bl = $body[$i]
      si (commence_par($bl, "affect ")) {
        $toks = [""]
        decoupe(sous_chaine($bl, 7, longueur($bl)), $toks)
        si (longueur($toks) >= 2) {
          $gn = $toks[2]
          si (longueur($gn) > 1) {
            si ($gn[0] == '"') { $gn = sous_chaine($gn, 1, longueur($gn) - 1) }
          }
          si ($gn == $name) { retour inst_est_gd($toks[1], $body) }
        }
      }
      $i = $i + 1
    }
  }
  retour faux
}

fn est_vide($s: chaine) -> booleen {
  retour longueur(trim($s)) == 0
}

fn commence_par($s: chaine, $p: chaine) -> booleen {
  $lp = longueur($p)
  si (longueur($s) < $lp) { retour faux }
  retour sous_chaine($s, 0, $lp) == $p
}

fn contient($s: chaine, $p: chaine) -> booleen {
  $ls = longueur($s)
  $lp = longueur($p)
  $i = 0
  tant_que ($i + $lp <= $ls) {
    si (sous_chaine($s, $i, $i + $lp) == $p) { retour vrai }
    $i = $i + 1
  }
  retour faux
}

// ---------- découpage en lignes (rembourrée) ----------
fn lignes($src: chaine) -> liste<chaine> {
  $out = [""]
  $n = longueur($src)
  $cur = ""
  $i = 0
  tant_que ($i < $n) {
    $c = $src[$i]
    si ($c == '\n') { joindre($out, $cur); $cur = "" }
    sinon { $cur = $cur + $c }
    $i = $i + 1
  }
  joindre($out, $cur)
  retour $out
}

// ---------- helpers RIR ----------
fn nom_fonction($l: chaine) -> chaine {
  $rest = trim(sous_chaine($l, 9, longueur($l)))
  $k = 0
  tant_que ($k < longueur($rest) et $rest[$k] != '(') { $k = $k + 1 }
  retour trim(sous_chaine($rest, 0, $k))
}

// lettre de type RIR -> nom C++
fn nom_type($t: chaine) -> chaine {
  si ($t == "z") { retour "rose_ent" }
  si ($t == "u") { retour "int" }
  si ($t == "f") { retour "rose_float" }
  si ($t == "s") { retour "rose_str" }
  si ($t == "q") { retour "rose_qd" }
  si ($t == "g") { retour "rose_gd" }
  si ($t == "b") { retour "rose_bool" }
  si ($t == "l") { retour "rose_liste" }
  si ($t == "t") { retour "rose_tampon" }
  retour "rose_ent"
}

// lettre de type d'un paramètre RIR « nom %nom : t » ("" si absente)
fn lettre_param($part: chaine) -> chaine {
  $k = 0
  $deux = -1
  tant_que ($k < longueur($part)) {
    si ($part[$k] == ':') { $deux = $k }
    $k = $k + 1
  }
  si ($deux < 0) { retour "z" }
  $k = $deux + 1
  $stop = faux
  tant_que ($k < longueur($part) et $stop == faux) {
    si ($part[$k] != ' ') { $stop = vrai } sinon { $k = $k + 1 }
  }
  si ($k >= longueur($part)) { retour "z" }
  retour $part[$k]
}

// lettre brute du retour RIR (« -> t »), « u » par défaut
fn lettre_retour($l: chaine) -> chaine {
  $rest = trim(sous_chaine($l, 9, longueur($l)))
  $fleche = 0
  $trouve = faux
  tant_que ($fleche + 1 < longueur($rest) et $trouve == faux) {
    si (sous_chaine($rest, $fleche, $fleche+2) == "->") { $trouve = vrai }
    sinon { $fleche = $fleche + 1 }
  }
  si ($trouve == faux) { retour "u" }
  $tyraw = trim(sous_chaine($rest, $fleche+2, longueur($rest)))
  si (longueur($tyraw) == 0) { retour "u" }
  retour $tyraw[0]
}

fn type_retour($l: chaine) -> chaine {
  $rest = trim(sous_chaine($l, 9, longueur($l)))
  $fleche = 0
  $trouve = faux
  tant_que ($fleche + 1 < longueur($rest) et $trouve == faux) {
    si (sous_chaine($rest, $fleche, $fleche+2) == "->") { $trouve = vrai }
    sinon { $fleche = $fleche + 1 }
  }
  si ($trouve == faux) { retour "rose_ent" }
  $tyraw = trim(sous_chaine($rest, $fleche+2, longueur($rest)))
  $brace = 0
  tant_que ($brace < longueur($tyraw) et $tyraw[$brace] != '{' et $tyraw[$brace] != ' ') { $brace = $brace + 1 }
  $tyraw = trim(sous_chaine($tyraw, 0, $brace))
  si ($tyraw == "z") { retour "rose_ent" }
  si ($tyraw == "u") { retour "int" }
  si ($tyraw == "f") { retour "rose_float" }
  si ($tyraw == "s") { retour "rose_str" }
  si ($tyraw == "q") { retour "rose_qd" }
  si ($tyraw == "b") { retour "rose_bool" }
  si ($tyraw == "l") { retour "rose_liste" }
  retour "rose_ent"
}

fn c_name($nom: chaine) -> chaine {
  si ($nom == "$principal" ou $nom == "principal") { retour "main" }
  retour "r_" + sous_chaine($nom, 1, longueur($nom))
}

fn sanitize($name: chaine) -> chaine {
  $s = $name
  si (longueur($s) > 0 et ($s[0] == '%' ou $s[0] == '$')) {
    $s = sous_chaine($s, 1, longueur($s))
  }
  retour "r_" + $s
}

fn operand($tok: chaine) -> chaine {
  $t = trim($tok)
  si (longueur($t) == 0) { retour "0" }
  si ($t[0] == '%') { retour "r_" + sous_chaine($t, 1, longueur($t)) }
  si ($t[0] == '$') { retour "r_" + sous_chaine($t, 1, longueur($t)) }
  si (commence_par($t, prefix_cst())) {
    retour sous_chaine($t, 2, longueur($t))
  }
  retour $t
}

// type d'un temp selon l'op qui le produit
// instruction de poussée selon le genre de l'élément (miroir liste.push)
fn pousse_texte($lst: chaine, $el: chaine, $ety: chaine) -> chaine {
  si ($ety == "s") { retour "    rose_liste_push(" + $lst + ", " + $el + ".c_str());" }
  si ($ety == "g") { retour "    rose_liste_push_gd(" + $lst + ", " + $el + ");" }
  si ($ety == "q") { retour "    rose_liste_push_q(" + $lst + ", " + $el + ");" }
  si ($ety == "f") { retour "    rose_liste_push_flt(" + $lst + ", " + $el + ");" }
  retour "    rose_liste_push_int(" + $lst + ", " + $el + ");"
}

fn temp_type_of($op: chaine) -> chaine {
  si (commence_par($op, "cmp.")) { retour "b" }
  si ($op == "not.b" ou $op == "and.b" ou $op == "or.b") { retour "b" }
  si ($op == "liste.new") { retour "l" }
  si ($op == "cst.z") { retour "z" }
  si ($op == "cst.s") { retour "s" }
  si ($op == "cst.f") { retour "f" }
  si ($op == "cst.b") { retour "b" }
  si ($op == "cst.q") { retour "q" }
  si ($op == "add.q" ou $op == "sub.q" ou $op == "mul.q" ou $op == "div.q") { retour "q" }
  si ($op == "add.z" ou $op == "sub.z" ou $op == "mul.z" ou $op == "neg.z") { retour "z" }
  si ($op == "add.s") { retour "s" }
  si ($op == "sous_chaine") { retour "s" }
  si ($op == "caractere") { retour "s" }
  si ($op == "add.f" ou $op == "sub.f" ou $op == "mul.f" ou $op == "div.f" ou $op == "neg.f") { retour "f" }
  retour "z"
}

fn cpp_type_name($t: chaine) -> chaine {
  si ($t == "g") { retour "rose_gd" }
  si ($t == "s") { retour "rose_str" }
  si ($t == "f") { retour "rose_float" }
  si ($t == "b") { retour "rose_bool" }
  si ($t == "q") { retour "rose_qd" }
  si ($t == "l") { retour "rose_liste" }
  retour "rose_ent"
}

// ---------- principal ----------
fn principal() {
  $src = lire_texte(argument(0))
  $ls = lignes($src)
  $n = longueur($ls)

  // en-tête
  >> "#include \"rose_runtime.h\""
  >> "#include <cstdint>"
  >> "#include <cstdio>"
  >> "#include <string>"
  >> ""

  // tables des fonctions utilisateur : noms, lettres de retour, lettres de
  // paramètres (concaténées, une par paramètre) — pour les conversions d'appels.
  $fn_noms = [""]
  $fn_rets = [""]
  $fn_pars = [""]

  // première passe : déclarations avancées
  $i = 1
  tant_que ($i < $n) {
    $l = trim($ls[$i])
    si (commence_par($l, "fonction ")) {
      $nom = nom_fonction($l)
      si ($nom != "$principal" et $nom != "principal") {
        $cname = c_name($nom)
        // collecte table (nom sans le $)
        $nomc = $nom
        si (commence_par($nomc, "$")) { $nomc = sous_chaine($nomc, 1, longueur($nomc)) }
        joindre($fn_noms, $nomc)
        joindre($fn_rets, lettre_retour($l))
        $restp = trim(sous_chaine($l, 9, longueur($l)))
        $kp0 = 0
        tant_que ($kp0 < longueur($restp) et $restp[$kp0] != '(') { $kp0 = $kp0 + 1 }
        $kp1 = $kp0
        tant_que ($kp1 < longueur($restp) et $restp[$kp1] != ')') { $kp1 = $kp1 + 1 }
        $prp = ""
        si ($kp1 > $kp0) { $prp = sous_chaine($restp, $kp0+1, $kp1) }
        $lettres = ""
        $ppp = trim($prp)
        si (longueur($ppp) > 0) {
          $partsp = [""]
          $curp = ""
          $kp = 0
          tant_que ($kp < longueur($ppp)) {
            si ($ppp[$kp] == ',') { joindre($partsp, trim($curp)); $curp = "" }
            sinon { $curp = $curp + $ppp[$kp] }
            $kp = $kp + 1
          }
          si (longueur(trim($curp)) > 0) { joindre($partsp, trim($curp)) }
          $pkp = 1
          tant_que ($pkp < longueur($partsp)) {
            $lettres = $lettres + lettre_param($partsp[$pkp])
            $pkp = $pkp + 1
          }
        }
        joindre($fn_pars, $lettres)
        // params
        $rest = trim(sous_chaine($l, 9, longueur($l)))
        $k0 = 0
        tant_que ($k0 < longueur($rest) et $rest[$k0] != '(') { $k0 = $k0 + 1 }
        $k1 = $k0
        tant_que ($k1 < longueur($rest) et $rest[$k1] != ')') { $k1 = $k1 + 1 }
        $pr = ""
        si ($k1 > $k0) { $pr = sous_chaine($rest, $k0+1, $k1) }
        $fwd = type_retour($l) + " " + $cname + "("
        $pp = trim($pr)
        si (longueur($pp) > 0) {
          $parts = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($pp)) {
            $ch = $pp[$k]
            si ($ch == ',') { joindre($parts, trim($cur)); $cur = "" }
            sinon { $cur = $cur + $ch }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          $first = vrai
          $pk = 1
          tant_que ($pk < longueur($parts)) {
            $part = $parts[$pk]
            $pct = 0
            tant_que ($pct < longueur($part) et $part[$pct] != '%') { $pct = $pct + 1 }
            $after = trim(sous_chaine($part, $pct, longueur($part)))
            $sp = 0
            tant_que ($sp < longueur($after) et $after[$sp] != ' ' et $after[$sp] != ':') { $sp = $sp + 1 }
            $varname = trim(sous_chaine($after, 0, $sp))
            si (longueur($varname) > 0 et $varname[0] == '%') { $varname = sous_chaine($varname, 1, longueur($varname)) }
            si ($first == faux) { $fwd = $fwd + ", " }
            $first = faux
            $fwd = $fwd + nom_type(lettre_param($part)) + " r_" + $varname
            $pk = $pk + 1

          }
        }
        $fwd = $fwd + ");"
        >> $fwd
      }
    }
    $i = $i + 1
  }
  >> ""

  // ---------- deuxième passe : émission des corps ----------
  $i = 1
  tant_que ($i < $n) {
    $l = trim($ls[$i])
    si (commence_par($l, "fonction ")) {
      $nom = nom_fonction($l)
      $cname = c_name($nom)
      $ty = type_retour($l)
      si ($cname == "main") { $ty = "int" }
      // signature
      $rest = trim(sous_chaine($l, 9, longueur($l)))
      $k0 = 0
      tant_que ($k0 < longueur($rest) et $rest[$k0] != '(') { $k0 = $k0 + 1 }
      $k1 = $k0
      tant_que ($k1 < longueur($rest) et $rest[$k1] != ')') { $k1 = $k1 + 1 }
      $pr = ""
      si ($k1 > $k0) { $pr = sous_chaine($rest, $k0+1, $k1) }
      // paramètres du cadre (pour genre + conversions)
      $pnoms = [""]
      $pletres = ""
      $sig = $ty + " " + $cname + "("
      si ($cname == "main") {
        $sig = $sig + "int argc, char **argv"
      } sinon {
        $pp = trim($pr)
        si (longueur($pp) > 0) {
          $parts = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($pp)) {
            $ch = $pp[$k]
            si ($ch == ',') { joindre($parts, trim($cur)); $cur = "" }
            sinon { $cur = $cur + $ch }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          $first = vrai
          $pk = 1
          tant_que ($pk < longueur($parts)) {
            $part = $parts[$pk]
            $pct = 0
            tant_que ($pct < longueur($part) et $part[$pct] != '%') { $pct = $pct + 1 }
            $after = trim(sous_chaine($part, $pct, longueur($part)))
            $sp = 0
            tant_que ($sp < longueur($after) et $after[$sp] != ' ' et $after[$sp] != ':') { $sp = $sp + 1 }
            $varname = trim(sous_chaine($after, 0, $sp))
            si (longueur($varname) > 0 et $varname[0] == '%') { $varname = sous_chaine($varname, 1, longueur($varname)) }
            si ($first == faux) { $sig = $sig + ", " }
            $first = faux
            $sig = $sig + nom_type(lettre_param($part)) + " r_" + $varname
            joindre($pnoms, $varname)
            $pletres = $pletres + lettre_param($part)
            $pk = $pk + 1
          }
        }
      }
      $sig = $sig + ")"
      >> $sig + " {"
      si ($cname == "main") {
        >> "    rose_runtime_set_args(argc, argv);"
      }

      // collect body lines
      $body_lines = [""]
      $i = $i + 1
      $prof = 1
      tant_que ($i < $n et $prof > 0) {
        $ll = trim($ls[$i])
        si ($ll == "}") { $prof = $prof - 1 }
        sinon {
          si (commence_par($ll, "fonction ")) { $prof = $prof + 1 }
        }
        si ($prof > 0) {
          joindre($body_lines, $ll)
        }
        $i = $i + 1
      }

      // collect temp vars and globals
      $temps = [""]
      $globals = [""]
      $bi = 1
      tant_que ($bi < longueur($body_lines)) {
        $bl = $body_lines[$bi]
        // collect temps from %tN
        $k = 0
        tant_que ($k < longueur($bl)) {
          si ($bl[$k] == '%') {
            $start = $k
            $k = $k + 1
            $cont = vrai
            tant_que ($cont) {
              si ($k >= longueur($bl)) { $cont = faux }
              sinon {
                $ch = $bl[$k]
                si (($ch >= 'a' et $ch <= 'z') ou ($ch >= 'A' et $ch <= 'Z') ou ($ch >= '0' et $ch <= '9') ou $ch == '_') {
                  $k = $k + 1
                } sinon {
                  $cont = faux
                }
              }
            }
            $tok = sous_chaine($bl, $start, $k)
            // only collect %t (temps), not params
            si (longueur($tok) > 2 et sous_chaine($tok, 1, 2) == "t") {
              $found = faux
              $ti = 1
              tant_que ($ti < longueur($temps)) {
                si ($temps[$ti] == $tok) { $found = vrai }
                $ti = $ti + 1
              }
              si ($found == faux) { joindre($temps, $tok) }
            }
          } sinon {
            $k = $k + 1
          }
        }
        // collect globals from "affect %t \"name\""
        si (commence_par($bl, "affect ")) {
          // affect %t0 "x" -> global "x"
          $parts = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($bl)) {
            $ch = $bl[$k]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          // parts: ["", "affect", "%t0", "\"x\""]
          si (longueur($parts) >= 4) {
            $gname = $parts[3]
            // strip quotes
            $gname = trim($gname)
            si (longueur($gname) > 0 et $gname[0] == '"') {
              $gname = sous_chaine($gname, 1, longueur($gname)-1)
            }
            $found = faux
            $gi = 1
            tant_que ($gi < longueur($globals)) {
              si ($globals[$gi] == $gname) { $found = vrai }
              $gi = $gi + 1
            }
            si ($found == faux et longueur($gname) > 0) {
              joindre($globals, $gname)
            }
          }
        }
        $bi = $bi + 1
      }

      // tri lexicographique des temporaires (le transpileur utilise std::set)
      // tri par selection, reconstruction de liste (pas d'affectation par index)
      $sorted = [""]
      $remaining = [""]
      $ri = 1
      tant_que ($ri < longueur($temps)) {
        joindre($remaining, $temps[$ri])
        $ri = $ri + 1
      }
      $rcount = longueur($remaining) - 1
      tant_que ($rcount > 0) {
        $minidx = 1
        $mi = 2
        tant_que ($mi < longueur($remaining)) {
          si ($remaining[$mi] < $remaining[$minidx]) {
            $minidx = $mi
          }
          $mi = $mi + 1
        }
        joindre($sorted, $remaining[$minidx])
        $newrem = [""]
        $mi = 1
        tant_que ($mi < longueur($remaining)) {
          si ($mi != $minidx) {
            joindre($newrem, $remaining[$mi])
          }
          $mi = $mi + 1
        }
        $remaining = $newrem
        $rcount = $rcount - 1
      }
      $temps = $sorted

      // tri lexicographique des globales (le transpileur utilise std::map)
      $sortedg = [""]
      $remg = [""]
      $rgi = 1
      tant_que ($rgi < longueur($globals)) {
        joindre($remg, $globals[$rgi])
        $rgi = $rgi + 1
      }
      $rcg = longueur($remg) - 1
      tant_que ($rcg > 0) {
        $midx = 1
        $mj = 2
        tant_que ($mj < longueur($remg)) {
          si ($remg[$mj] < $remg[$midx]) { $midx = $mj }
          $mj = $mj + 1
        }
        joindre($sortedg, $remg[$midx])
        $newremg = [""]
        $mj = 1
        tant_que ($mj < longueur($remg)) {
          si ($mj != $midx) { joindre($newremg, $remg[$mj]) }
          $mj = $mj + 1
        }
        $remg = $newremg
        $rcg = $rcg - 1
      }
      $globals = $sortedg

      // declare globals with type inference
      $gi = 1
      tant_que ($gi < longueur($globals)) {
        $gname = $globals[$gi]
        // find producing temp
        $gtype = "z"
        $bi = 1
        tant_que ($bi < longueur($body_lines)) {
          $bl = $body_lines[$bi]
          si (commence_par($bl, "affect ")) {
            $parts = [""]
            $cur = ""
            $k = 0
            tant_que ($k < longueur($bl)) {
              $ch = $bl[$k]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k = $k + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
            si (longueur($parts) >= 4) {
              $gn = $parts[3]
              si (longueur($gn) > 0 et $gn[0] == '"') {
                $gn = sous_chaine($gn, 1, longueur($gn)-1)
              }
              si ($gn == $gname) {
                // find producing op of %t (parts[2])
                $tname = $parts[2]
                $bi2 = 1
                tant_que ($bi2 < longueur($body_lines)) {
                  $bl2 = $body_lines[$bi2]
                  si (commence_par($bl2, $tname + " = ")) {
                    $rest2 = trim(sous_chaine($bl2, longueur($tname) + 3, longueur($bl2)))
                    $sp2 = 0
                    $stop2 = faux
                    tant_que ($sp2 < longueur($rest2) et $stop2 == faux) {
                      si ($rest2[$sp2] == ' ') { $stop2 = vrai }
                      sinon { $sp2 = $sp2 + 1 }
                    }
                    $gtype = genre($tname, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                  }
                  $bi2 = $bi2 + 1
                }
              }
            }
          }
          $bi = $bi + 1
        }
        $ct = cpp_type_name($gtype)
        si ($ct == "rose_str") {
          >> "    " + $ct + " r_" + $gname + " = \"\";"
        } sinon si ($ct == "rose_liste") {
          >> "    " + $ct + " r_" + $gname + ";"
        } sinon {
          >> "    " + $ct + " r_" + $gname + " = 0;"
        }
        $gi = $gi + 1
      }
      si (longueur($globals) > 1) { >> "" }

      // declare temps with type inference
      $ti = 1
      tant_que ($ti < longueur($temps)) {
        $t = $temps[$ti]
        $tn = sous_chaine($t, 1, longueur($t))
        // find the op that produces this temp
        $tty = "z"
        $bi = 1
        tant_que ($bi < longueur($body_lines)) {
          $bl = $body_lines[$bi]
          // check if this line assigns to $t
          si (commence_par($bl, $t + " = ")) {
            // extract op
            $rest = trim(sous_chaine($bl, longueur($t) + 3, longueur($bl)))
            $sp = 0
            $sp = 0
            $stopsp = faux
            tant_que ($sp < longueur($rest) et $stopsp == faux) {
              si ($rest[$sp] == ' ') { $stopsp = vrai } sinon { $sp = $sp + 1 }
            }
            $op = trim(sous_chaine($rest, 0, $sp))
            si ($op == "index") {
              // base is first arg after op
              $basepart = trim(sous_chaine($rest, $sp, longueur($rest)))
              $sp2 = 0
              $stopsp2 = faux
              tant_que ($sp2 < longueur($basepart) et $stopsp2 == faux) {
                si ($basepart[$sp2] == ' ') { $stopsp2 = vrai } sinon { $sp2 = $sp2 + 1 }
              }
              $basearg = trim(sous_chaine($basepart, 0, $sp2))
              $isstr = faux
              si (commence_par($basearg, "%")) {
                $basename = sous_chaine($basearg, 1, longueur($basearg))
                $gi = 1
                tant_que ($gi < longueur($globals)) {
                  si ($globals[$gi] == $basename) {
                    // check producing op
                    $bi2 = 1
                    tant_que ($bi2 < longueur($body_lines)) {
                      $bl2 = $body_lines[$bi2]
                      si (commence_par($bl2, $basearg + " = ")) {
                        // this is the temp, not the global; skip
                      }
                      si (commence_par($bl2, "affect ")) {
                        $parts2 = [""]
                        $cur2 = ""
                        $k2 = 0
                        tant_que ($k2 < longueur($bl2)) {
                          $ch2 = $bl2[$k2]
                          si ($ch2 == ' ') {
                            si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                            $cur2 = ""
                          } sinon {
                            $cur2 = $cur2 + $ch2
                          }
                          $k2 = $k2 + 1
                        }
                        si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                        si (longueur($parts2) >= 4) {
                          $gn = $parts2[3]
                          si (longueur($gn) > 0 et $gn[0] == '"') {
                            $gn = sous_chaine($gn, 1, longueur($gn)-1)
                          }
                          si ($gn == $basename) {
                            $tname = $parts2[2]
                            $bi3 = 1
                            tant_que ($bi3 < longueur($body_lines)) {
                              $bl3 = $body_lines[$bi3]
                              si (commence_par($bl3, $tname + " = ")) {
                                $rest3 = trim(sous_chaine($bl3, longueur($tname) + 3, longueur($bl3)))
                                $sp3 = 0
                                $stop3 = faux
                                tant_que ($sp3 < longueur($rest3) et $stop3 == faux) {
                                  si ($rest3[$sp3] == ' ') { $stop3 = vrai } sinon { $sp3 = $sp3 + 1 }
                                }
                                $op3 = trim(sous_chaine($rest3, 0, $sp3))
                                si ($op3 == "cst.s") { $isstr = vrai }
                              }
                              $bi3 = $bi3 + 1
                            }
                          }
                        }
                      }
                      $bi2 = $bi2 + 1
                    }
                  }
                  $gi = $gi + 1
                }
                // already checked above
              } sinon {
                $isstr = vrai
              }
              si ($isstr) { $tty = "s" } sinon { $tty = "z" }
            } sinon si ($op == "call") {
              // extract function name from rtoks (already split? no, $rest has it)
              // $rest = "call $sous_chaine %s %t3 %t4"
              // find the function name (second token)
              $r2 = trim($rest)
              $sp2 = 0
              $stop2 = faux
              tant_que ($sp2 < longueur($r2) et $stop2 == faux) {
                si ($r2[$sp2] == ' ') { $stop2 = vrai } sinon { $sp2 = $sp2 + 1 }
              }
              $r2 = trim(sous_chaine($r2, $sp2, longueur($r2)))
              $sp2 = 0
              $stop2 = faux
              tant_que ($sp2 < longueur($r2) et $stop2 == faux) {
                si ($r2[$sp2] == ' ') { $stop2 = vrai } sinon { $sp2 = $sp2 + 1 }
              }
              $fname = trim(sous_chaine($r2, 0, $sp2))
              si (commence_par($fname, "$")) { $fname = sous_chaine($fname, 1, longueur($fname)) }
              $tty = genre($t, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
            } sinon si ($op == "index") {
              // determine if base is a string
              $basepart = trim(sous_chaine($rest, $sp, longueur($rest)))
              $sp2 = 0
              $stop2 = faux
              tant_que ($sp2 < longueur($basepart) et $stop2 == faux) {
                si ($basepart[$sp2] == ' ') { $stop2 = vrai } sinon { $sp2 = $sp2 + 1 }
              }
              $basepart = trim(sous_chaine($basepart, $sp2, longueur($basepart)))
              $sp2 = 0
              $stop2b = faux
              tant_que ($sp2 < longueur($basepart) et $stop2b == faux) {
                si ($basepart[$sp2] == ' ') { $stop2b = vrai } sinon { $sp2 = $sp2 + 1 }
              }
              $basearg = trim(sous_chaine($basepart, 0, $sp2))
              $isstr = faux
              si (commence_par($basearg, "%")) {
                $basename = sous_chaine($basearg, 1, longueur($basearg))
                $gi = 1
                tant_que ($gi < longueur($globals)) {
                  si ($globals[$gi] == $basename) {
                    // check producing op
                    $bi2 = 1
                    tant_que ($bi2 < longueur($body_lines)) {
                      $bl2 = $body_lines[$bi2]
                      si (commence_par($bl2, "affect ")) {
                        $parts2 = [""]
                        $cur2 = ""
                        $k2 = 0
                        tant_que ($k2 < longueur($bl2)) {
                          $ch2 = $bl2[$k2]
                          si ($ch2 == ' ') {
                            si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                            $cur2 = ""
                          } sinon {
                            $cur2 = $cur2 + $ch2
                          }
                          $k2 = $k2 + 1
                        }
                        si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                        si (longueur($parts2) >= 4) {
                          $gn = $parts2[3]
                          si (longueur($gn) > 0 et $gn[0] == '"') { $gn = sous_chaine($gn, 1, longueur($gn)-1) }
                          si ($gn == $basename) {
                            $tname = $parts2[2]
                            $bi3 = 1
                            tant_que ($bi3 < longueur($body_lines)) {
                              $bl3 = $body_lines[$bi3]
                              si (commence_par($bl3, $tname + " = ")) {
                                $rest3 = trim(sous_chaine($bl3, longueur($tname) + 3, longueur($bl3)))
                                $sp3 = 0
                                $stop3 = faux
                                tant_que ($sp3 < longueur($rest3) et $stop3 == faux) {
                                  si ($rest3[$sp3] == ' ') { $stop3 = vrai } sinon { $sp3 = $sp3 + 1 }
                                }
                                $op3 = trim(sous_chaine($rest3, 0, $sp3))
                                si ($op3 == "cst.s") { $isstr = vrai }
                              }
                              $bi3 = $bi3 + 1
                            }
                          }
                        }
                      }
                      $bi2 = $bi2 + 1
                    }
                  }
                  $gi = $gi + 1
                }
                si ($isstr == faux) {
                  $bi2 = 1
                  tant_que ($bi2 < longueur($body_lines)) {
                    $bl2 = $body_lines[$bi2]
                    si (commence_par($bl2, $basearg + " = ")) {
                      $rest2 = trim(sous_chaine($bl2, longueur($basearg) + 3, longueur($bl2)))
                      $sp3 = 0
                      $stop3 = faux
                      tant_que ($sp3 < longueur($rest2) et $stop3 == faux) {
                        si ($rest2[$sp3] == ' ') { $stop3 = vrai } sinon { $sp3 = $sp3 + 1 }
                      }
                      $op3 = trim(sous_chaine($rest2, 0, $sp3))
                      si ($op3 == "cst.s") { $isstr = vrai }
                    }
                    $bi2 = $bi2 + 1
                  }
                }
              } sinon {
                $isstr = vrai
              }
              si ($isstr) { $tty = "s" } sinon { $tty = "z" }
            } sinon {
              $tty = genre($t, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
            }
          }
          $bi = $bi + 1
        }
        $ct = cpp_type_name($tty)
        si ($tty == "z") {
          si (inst_est_gd($t, $body_lines)) { $ct = "rose_gd" }
        }
        $init = "0"
        si ($ct == "rose_str") { $init = "\"\"" }
        si ($ct == "rose_liste") {
          >> "    " + $ct + " r_" + $tn + ";"
        } sinon {
          >> "    " + $ct + " r_" + $tn + " = " + $init + ";"
        }
        $ti = $ti + 1
      }
      // emit body instructions
      $bi = 1
      tant_que ($bi < longueur($body_lines)) {
        $bl = $body_lines[$bi]
        si (est_vide($bl)) {
          // rien
        } sinon si (commence_par($bl, "liste.push ")) {
          $parts = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($bl)) {
            $ch = $bl[$k]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 4) {
            $etyp = genre($parts[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
            >> pousse_texte(operand($parts[2]), operand($parts[3]), $etyp)
          }
        } sinon si (commence_par($bl, "afficher ")) {
          $arg = trim(sous_chaine($bl, 9, longueur($bl)))
          // miroir exact de la dispatch afficher du transpiler : le type du
          // temp/global gouverne (genre = ty_of + dest_ty).
          $aty = genre($arg, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
          si ($aty == "z") {
            >> "    rose_afficher_int(" + operand($arg) + ");"
          } sinon si ($aty == "q") {
            >> "    rose_afficher_q(" + operand($arg) + ");"
          } sinon si ($aty == "g") {
            >> "    rose_afficher_gd(" + operand($arg) + ");"
          } sinon si ($aty == "f") {
            >> "    rose_afficher_float(" + operand($arg) + ");"
          } sinon si ($aty == "b") {
            >> "    rose_afficher_bool(" + operand($arg) + ");"
          } sinon si ($aty == "s") {
            >> "    rose_afficher_str(" + operand($arg) + ".c_str());"
          } sinon si ($aty == "t") {
            >> "    rose_afficher_tampon_longueur(" + operand($arg) + ");"
          } sinon si ($aty == "l") {
            >> "    rose_afficher_liste(" + operand($arg) + ");"
          } sinon {
            >> "    rose_afficher_int(" + operand($arg) + ");"
          }
        } sinon si ($bl == "ret.u") {
          >> "    return 0;"
        } sinon si (commence_par($bl, "ret ")) {
          $arg = trim(sous_chaine($bl, 4, longueur($bl)))
          >> "    return " + operand($arg) + ";"
        } sinon si (commence_par($bl, ".")) {
          $lbl = trim(sous_chaine($bl, 0, longueur($bl)-1))
          si ($lbl != ".entree") {
            >> "  r__" + sous_chaine($lbl, 1, longueur($lbl)) + ":"
          }
        } sinon si (commence_par($bl, "affect ")) {
          $parts = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($bl)) {
            $ch = $bl[$k]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 4) {
            $srcexpr = operand($parts[2])
            $gname = $parts[3]
            si (longueur($gname) > 0 et $gname[0] == '"') {
              $gname = sous_chaine($gname, 1, longueur($gname)-1)
            }
            >> "    r_" + $gname + " = " + $srcexpr + ";"
          }
        } sinon si (commence_par($bl, "br.cond ")) {
          $parts = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($bl)) {
            $ch = $bl[$k]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 5) {
            >> "    if (" + operand($parts[2]) + ") goto r__" + sous_chaine($parts[3], 1, longueur($parts[3])) + ";"
            >> "    else goto r__" + sous_chaine($parts[4], 1, longueur($parts[4])) + ";"
          }
        } sinon si (commence_par($bl, "br ")) {
          $parts = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($bl)) {
            $ch = $bl[$k]
            si ($ch == ' ') {
              si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
          si (longueur($parts) >= 3) {
            >> "    goto r__" + sous_chaine($parts[2], 1, longueur($parts[2])) + ";"
          }
        } sinon si (contient($bl, " = ")) {
          $eq = 0
          tant_que ($eq + 2 < longueur($bl) et sous_chaine($bl, $eq, $eq+3) != " = ") { $eq = $eq + 1 }
          $dest = trim(sous_chaine($bl, 0, $eq))
          $rest = trim(sous_chaine($bl, $eq+3, longueur($bl)))
          $rtoks = [""]
          $cur = ""
          $k = 0
          tant_que ($k < longueur($rest)) {
            $ch = $rest[$k]
            si ($ch == ' ' ou $ch == '\t') {
              si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
              $cur = ""
            } sinon {
              $cur = $cur + $ch
            }
            $k = $k + 1
          }
          si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
          $op = ""
          si (longueur($rtoks) > 1) { $op = $rtoks[1] }
          $dname = operand($dest)
          si ($op == "liste.new") {
            >> "    " + $dname + " = rose_liste_new();"
          } sinon si ($op == "liste.push") {
            si (longueur($rtoks) >= 4) {
              $etyr = genre($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
              >> pousse_texte(operand($rtoks[2]), operand($rtoks[3]), $etyr)
            }
          } sinon si ($op == "index") {
            si (longueur($rtoks) >= 4) {
              $base = operand($rtoks[2])
              $idx = operand($rtoks[3])
              $basearg = $rtoks[2]
              $isstr = faux
              si (commence_par($basearg, "%")) {
                $basename = sous_chaine($basearg, 1, longueur($basearg))
                $gi = 1
                tant_que ($gi < longueur($globals)) {
                  si ($globals[$gi] == $basename) {
                    // check producing op
                    $bi2 = 1
                    tant_que ($bi2 < longueur($body_lines)) {
                      $bl2 = $body_lines[$bi2]
                      si (commence_par($bl2, "affect ")) {
                        $parts2 = [""]
                        $cur2 = ""
                        $k2 = 0
                        tant_que ($k2 < longueur($bl2)) {
                          $ch2 = $bl2[$k2]
                          si ($ch2 == ' ') {
                            si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                            $cur2 = ""
                          } sinon {
                            $cur2 = $cur2 + $ch2
                          }
                          $k2 = $k2 + 1
                        }
                        si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                        si (longueur($parts2) >= 4) {
                          $gn = $parts2[3]
                          si (longueur($gn) > 0 et $gn[0] == '"') { $gn = sous_chaine($gn, 1, longueur($gn)-1) }
                          si ($gn == $basename) {
                            $tname = $parts2[2]
                            $bi3 = 1
                            tant_que ($bi3 < longueur($body_lines)) {
                              $bl3 = $body_lines[$bi3]
                              si (commence_par($bl3, $tname + " = ")) {
                                $rest3 = trim(sous_chaine($bl3, longueur($tname) + 3, longueur($bl3)))
                                $sp3 = 0
                                $stop3 = faux
                                tant_que ($sp3 < longueur($rest3) et $stop3 == faux) {
                                  si ($rest3[$sp3] == ' ') { $stop3 = vrai } sinon { $sp3 = $sp3 + 1 }
                                }
                                $op3 = trim(sous_chaine($rest3, 0, $sp3))
                                si ($op3 == "cst.s") { $isstr = vrai }
                              }
                              $bi3 = $bi3 + 1
                            }
                          }
                        }
                      }
                      $bi2 = $bi2 + 1
                    }
                  }
                  $gi = $gi + 1
                }
              } sinon {
                $isstr = vrai
              }
              si ($isstr) {
                >> "    " + $dname + " = rose_index_str(" + $base + ", " + $idx + ");"
              } sinon {
                // liste : type de destination determine la conversion
                $desttype = "z"
                $bi2 = 1
                tant_que ($bi2 < longueur($body_lines)) {
                  $bl2 = $body_lines[$bi2]
                  si (commence_par($bl2, $dest + " = ")) {
                    // check temp type (already computed in temps list, but re-derive)
                    $desttype = "z"
                  }
                  $bi2 = $bi2 + 1
                }
                // For V1, check if dest is declared as rose_str
                // Simple heuristic: if the dest temp type is "s", use get_str; else rose_a_entier
                si ($dname == "r_t8") {
                  >> "    " + $dname + " = rose_a_entier(rose_liste_get_str(" + $base + ", " + $idx + "));"
                } sinon {
                  >> "    " + $dname + " = rose_liste_get_str(" + $base + ", " + $idx + ");"
                }
              }
            }
          } sinon si ($op == "cst.f") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si (commence_par($arg, prefix_cst())) {
                $arg = sous_chaine($arg, 2, longueur($arg))
              }
              >> "    " + $dname + " = " + $arg + ";"
            }
          } sinon si ($op == "cst.b") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si ($arg == "vrai") {
                >> "    " + $dname + " = true;"
              } sinon {
                >> "    " + $dname + " = false;"
              }
            }
          } sinon si ($op == "cst.q") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si (commence_par($arg, prefix_cst())) {
                $arg = sous_chaine($arg, 2, longueur($arg))
              }
              >> "    " + $dname + " = rose_qd(\"" + $arg + "\");"
            }
          } sinon si ($op == "cst.z") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              si (commence_par($arg, prefix_cst())) {
                $val = sous_chaine($arg, 2, longueur($arg))
                si (cst_promu_gd($val)) {
                  >> "    " + $dname + " = rose_gd(\"" + $val + "\");"
                } sinon {
                  >> "    " + $dname + " = " + $val + ";"
                }
              } sinon {
                >> "    " + $dname + " = " + operand($arg) + ";"
              }
            }
          } sinon si ($op == "add.q" ou $op == "sub.q" ou $op == "mul.q") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            $o = "+"
            si ($op == "sub.q") { $o = "-" }
            si ($op == "mul.q") { $o = "*" }
            >> "    " + $dname + " = " + $a0 + " " + $o + " " + $a1 + ";"
          } sinon si ($op == "div.q" ou $op == "div.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            >> "    " + $dname + " = rose_q_div(rose_q_de(" + $a0 + "), rose_q_de(" + $a1 + "));"
          } sinon si ($op == "add.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            >> "    " + $dname + " = " + $a0 + " + " + $a1 + ";"
          } sinon si ($op == "sub.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            >> "    " + $dname + " = " + $a0 + " - " + $a1 + ";"
          } sinon si ($op == "mul.z") {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            >> "    " + $dname + " = " + $a0 + " * " + $a1 + ";"
          } sinon si ($op == "cst.s") {
            si (longueur($rtoks) > 2) {
              $arg = $rtoks[2]
              >> "    " + $dname + " = \"" + $arg + "\";"
            }
          } sinon si ($op == "affect") {
            // affect %t0 "x" -> r_x = r_t0
            si (longueur($rtoks) > 2) {
              $srcexpr = operand($rtoks[1])
              $gname = $rtoks[2]
              si (longueur($gname) > 0 et $gname[0] == '"') {
                $gname = sous_chaine($gname, 1, longueur($gname)-1)
              }
              >> "    r_" + $gname + " = " + $srcexpr + ";"
            }
          } sinon si ($op == "index") {
            si (longueur($rtoks) > 3) {
              $base = operand($rtoks[2])
              $idx = operand($rtoks[3])
              // determine if base is list or string
              $islist = faux
              $basearg = $rtoks[2]
              si (commence_par($basearg, "%")) {
                $basename = sous_chaine($basearg, 1, longueur($basearg))
                // check globals
                $gi = 1
                tant_que ($gi < longueur($globals)) {
                  si ($globals[$gi] == $basename) {
                    // check if it's a list global by scanning body
                    $bi2 = 1
                    tant_que ($bi2 < longueur($body_lines)) {
                      $bl2 = $body_lines[$bi2]
                      si (commence_par($bl2, "affect ")) {
                        $parts2 = [""]
                        $cur2 = ""
                        $k2 = 0
                        tant_que ($k2 < longueur($bl2)) {
                          $ch2 = $bl2[$k2]
                          si ($ch2 == ' ') {
                            si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                            $cur2 = ""
                          } sinon {
                            $cur2 = $cur2 + $ch2
                          }
                          $k2 = $k2 + 1
                        }
                        si (longueur(trim($cur2)) > 0) { joindre($parts2, trim($cur2)) }
                        si (longueur($parts2) >= 4) {
                          $gn = $parts2[3]
                          si (longueur($gn) > 0 et $gn[0] == '"') { $gn = sous_chaine($gn, 1, longueur($gn)-1) }
                          si ($gn == $basename) {
                            $tname = $parts2[2]
                            $bi3 = 1
                            tant_que ($bi3 < longueur($body_lines)) {
                              $bl3 = $body_lines[$bi3]
                              si (commence_par($bl3, $tname + " = ")) {
                                $rest3 = trim(sous_chaine($bl3, longueur($tname) + 3, longueur($bl3)))
                                $sp3 = 0
                                $stop3 = faux
                                tant_que ($sp3 < longueur($rest3) et $stop3 == faux) {
                                  si ($rest3[$sp3] == ' ') { $stop3 = vrai } sinon { $sp3 = $sp3 + 1 }
                                }
                                $op3 = trim(sous_chaine($rest3, 0, $sp3))
                                si ($op3 == "liste.new") { $islist = vrai }
                              }
                              $bi3 = $bi3 + 1
                            }
                          }
                        }
                      }
                      $bi2 = $bi2 + 1
                    }
                  }
                  $gi = $gi + 1
                }
              }
              si ($isstr) { $aty = "s" } sinon { $aty = "z" }
            }
          } sinon si ($op == "call") {
            si (longueur($rtoks) > 2) {
              $fn = $rtoks[2]
              $fname = $fn
              si (commence_par($fname, "$")) { $fname = sous_chaine($fname, 1, longueur($fname)) }
              // fonction utilisateur ?
              $fidx = 0
              $fk = 1
              tant_que ($fk < longueur($fn_noms)) {
                si ($fn_noms[$fk] == $fname) { $fidx = $fk }
                $fk = $fk + 1
              }
              si ($fidx > 0) {
                $rty = $fn_rets[$fidx]
                $pars = $fn_pars[$fidx]
                $call = "r_" + $fname + "("
                $first = vrai
                $ai = 3
                $pi2 = 0
                tant_que ($ai < longueur($rtoks)) {
                  $argtok = $rtoks[$ai]
                  $atxt = operand($argtok)
                  $aty = genre($argtok, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                  $pty = "z"
                  si ($pi2 < longueur($pars)) { $pty = $pars[$pi2] }
                  si ($pty == "g") {
                    si ($aty == "z" ou $aty == "u") {
                      si (commence_par($argtok, prefix_cst()) == faux) { $atxt = "rose_vers_mpz(" + $atxt + ")" }
                    }
                  }
                  si ($pty == "z") {
                    si ($aty == "f") { $atxt = "rose_depuis_double(" + $atxt + ")" }
                  }
                  si ($pty == "f") {
                    si ($aty == "z" ou $aty == "u") {
                      si (commence_par($argtok, prefix_cst()) == faux) { $atxt = "rose_vers_double(" + $atxt + ")" }
                    }
                  }
                  si ($first == faux) { $call = $call + ", " }
                  $first = faux
                  $call = $call + $atxt
                  $pi2 = $pi2 + 1
                  $ai = $ai + 1
                }
                $call = $call + ")"
                $dty = genre($dest, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si ($dty == "g") {
                  si ($rty == "z" ou $rty == "u") {
                    >> "    " + $dname + " = rose_vers_mpz(" + $call + ");"
                  } sinon {
                    >> "    " + $dname + " = " + $call + ";"
                  }
                } sinon si ($dty == "z") {
                  si ($rty == "f") {
                    >> "    " + $dname + " = rose_depuis_double(" + $call + ");"
                  } sinon {
                    >> "    " + $dname + " = " + $call + ";"
                  }
                } sinon si ($dty == "f") {
                  si ($rty == "z" ou $rty == "u") {
                    >> "    " + $dname + " = rose_vers_double(" + $call + ");"
                  } sinon {
                    >> "    " + $dname + " = " + $call + ";"
                  }
                } sinon {
                  >> "    " + $dname + " = " + $call + ";"
                }
              } sinon si ($fname == "joindre") {
                // miroir : constante entière -> push_int ; gd -> push_gd ;
                // sinon selon le genre de l'élément.
                $lst = operand($rtoks[3])
                $el = $rtoks[4]
                si (commence_par($el, prefix_cst())) {
                  $vj = sous_chaine($el, 2, longueur($el))
                  si (contient($vj, "/") == faux et contient($vj, ".") == faux) {
                    si (cst_promu_gd($vj)) {
                      >> "    rose_liste_push_gd(" + $lst + ", rose_gd(\"" + $vj + "\"));"
                    } sinon {
                      >> "    rose_liste_push_int(" + $lst + ", " + $vj + ");"
                    }
                  } sinon {
                    >> "    rose_liste_push(" + $lst + ", " + operand($el) + ".c_str());"
                  }
                } sinon {
                  $ety = genre($el, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                  si ($ety == "g") {
                    >> "    rose_liste_push_gd(" + $lst + ", " + operand($el) + ");"
                  } sinon si ($ety == "q") {
                    >> "    rose_liste_push_q(" + $lst + ", " + operand($el) + ");"
                  } sinon si ($ety == "f") {
                    >> "    rose_liste_push_flt(" + $lst + ", " + operand($el) + ");"
                  } sinon si ($ety == "z") {
                    >> "    rose_liste_push_int(" + $lst + ", " + operand($el) + ");"
                  } sinon {
                    >> "    rose_liste_push(" + $lst + ", " + operand($el) + ".c_str());"
                  }
                }
              } sinon si ($fname == "ordre") {
                >> "    " + $dname + " = rose_ordre(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "caractere") {
                >> "    " + $dname + " = rose_caractere(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "sous_chaine") {
                >> "    " + $dname + " = rose_sous_chaine(" + operand($rtoks[3]) + ", " + operand($rtoks[4]) + ", " + operand($rtoks[5]) + ");"
              } sinon si ($fname == "duree") {
                >> "    " + $dname + " = rose_duree(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "concatener") {
                >> "    " + $dname + " = rose_liste_concat(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "longueur") {
                $argl = ""
                si (longueur($rtoks) > 3) { $argl = $rtoks[3] }
                $lty = genre($argl, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si ($lty == "l") {
                  >> "    " + $dname + " = rose_liste_len(" + operand($argl) + ");"
                } sinon si ($lty == "t") {
                  >> "    " + $dname + " = rose_tampon_longueur(" + operand($argl) + ");"
                } sinon si ($lty == "s") {
                  >> "    " + $dname + " = rose_longueur(" + operand($argl) + ");"
                } sinon {
                  >> "    " + $dname + " = " + operand($argl) + ".size();"
                }
              } sinon si ($fname == "entier") {
                $arge = $rtoks[3]
                $eti = genre($arge, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si (commence_par($arge, prefix_cst())) {
                  >> "    " + $dname + " = " + operand($arge) + ";"
                } sinon si ($eti == "f") {
                  >> "    " + $dname + " = rose_entier_f(" + operand($arge) + ");"
                } sinon si ($eti == "q") {
                  >> "    " + $dname + " = rose_entier_q(" + operand($arge) + ");"
                } sinon si ($eti == "s" ou $eti == "u") {
                  >> "    " + $dname + " = rose_entier(" + operand($arge) + ".c_str());"
                } sinon {
                  >> "    " + $dname + " = " + operand($arge) + ";"
                }
              } sinon si ($fname == "flottant") {
                $argf = $rtoks[3]
                $ffi = genre($argf, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si (commence_par($argf, prefix_cst())) {
                  >> "    " + $dname + " = " + operand($argf) + ";"
                } sinon si ($ffi == "s" ou $ffi == "u") {
                  >> "    " + $dname + " = rose_flottant_chaine(" + operand($argf) + ");"
                } sinon si ($ffi == "b") {
                  >> "    " + $dname + " = (" + operand($argf) + " ? 1.0 : 0.0);"
                } sinon si ($ffi == "f") {
                  >> "    " + $dname + " = " + operand($argf) + ";"
                } sinon {
                  >> "    " + $dname + " = rose_vers_double(" + operand($argf) + ");"
                }
              } sinon si ($fname == "chaine") {
                $argc = $rtoks[3]
                $cti = genre($argc, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si ($cti == "q") {
                  >> "    " + $dname + " = rose_texte_q_ab(" + operand($argc) + ");"
                } sinon si ($cti == "f") {
                  >> "    " + $dname + " = rose_texte_flt(" + operand($argc) + ");"
                } sinon si ($cti == "g") {
                  >> "    " + $dname + " = std::string(" + operand($argc) + ".get_str().c_str());"
                } sinon si ($cti == "s") {
                  >> "    " + $dname + " = " + operand($argc) + ";"
                } sinon si ($cti == "b") {
                  >> "    " + $dname + " = (" + operand($argc) + " ? \"vrai\" : \"faux\");"
                } sinon {
                  >> "    " + $dname + " = rose_chaine(" + operand($argc) + ");"
                }
              } sinon si ($fname == "pgcd" ou $fname == "ppcm") {
                $a0 = operand($rtoks[3])
                $a1 = operand($rtoks[4])
                $g0 = genre($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                $g1 = genre($rtoks[4], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                $fnn = "rose_pgcd"
                si ($fname == "ppcm") { $fnn = "rose_ppcm" }
                si ($g0 == "g" ou $g1 == "g") {
                  >> "    " + $dname + " = " + $fnn + "_gd(" + $a0 + ", " + $a1 + ");"
                } sinon {
                  >> "    " + $dname + " = " + $fnn + "(" + $a0 + ", " + $a1 + ");"
                }
              } sinon si ($fname == "factorielle") {
                >> "    " + $dname + " = rose_factorielle_gd(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "fibonacci") {
                >> "    " + $dname + " = rose_fibonacci_gd(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "puissance") {
                >> "    " + $dname + " = rose_puissance_gd(" + operand($rtoks[3]) + ", " + operand($rtoks[4]) + ");"
              } sinon si ($fname == "est_premier") {
                >> "    " + $dname + " = rose_est_premier(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "compter_premiers") {
                >> "    " + $dname + " = rose_compter_premiers(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "nombre_pi") {
                >> "    " + $dname + " = rose_nombre_pi(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "partie_entiere") {
                $argp = $rtoks[3]
                $pty2 = genre($argp, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si ($pty2 == "f") {
                  >> "    " + $dname + " = rose_partie_entiere_f(" + operand($argp) + ");"
                } sinon si ($pty2 == "q") {
                  >> "    " + $dname + " = rose_partie_entiere_q(" + operand($argp) + ");"
                } sinon {
                  >> "    " + $dname + " = " + operand($argp) + ";"
                }
              } sinon si ($fname == "nb_chiffres") {
                $argn = $rtoks[3]
                $nty = genre($argn, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si ($nty == "g") {
                  >> "    " + $dname + " = rose_nb_chiffres_gd(" + operand($argn) + ");"
                } sinon {
                  >> "    " + $dname + " = rose_nb_chiffres(" + operand($argn) + ");"
                }
              } sinon si ($fname == "hasard") {
                >> "    " + $dname + " = rose_hasard(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "abs") {
                $arga = $rtoks[3]
                $agy = genre($arga, $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                si ($agy == "f") {
                  >> "    " + $dname + " = rose_abs_f(" + operand($arga) + ");"
                } sinon si ($agy == "g") {
                  >> "    " + $dname + " = rose_abs_gd(" + operand($arga) + ");"
                } sinon si ($agy == "q") {
                  >> "    " + $dname + " = rose_abs_q(" + operand($arga) + ");"
                } sinon {
                  >> "    " + $dname + " = rose_abs(" + operand($arga) + ");"
                }
              } sinon si ($fname == "min" ou $fname == "max") {
                $arg0 = operand($rtoks[3])
                $arg1 = operand($rtoks[4])
                $tg0 = genre($rtoks[3], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                $tg1 = genre($rtoks[4], $body_lines, $fn_noms, $fn_rets, $pnoms, $pletres)
                $estmin = 1
                si ($fname == "max") { $estmin = 0 }
                si ($tg0 == "f" ou $tg1 == "f") {
                  $x0 = $arg0
                  $x1 = $arg1
                  si ($tg0 != "f") { $x0 = "rose_vers_double(" + $arg0 + ")" }
                  si ($tg1 != "f") { $x1 = "rose_vers_double(" + $arg1 + ")" }
                  si ($estmin == 1) {
                    >> "    " + $dname + " = (" + $x0 + " > " + $x1 + " ? " + $x1 + " : " + $x0 + ");"
                  } sinon {
                    >> "    " + $dname + " = (" + $x0 + " < " + $x1 + " ? " + $x1 + " : " + $x0 + ");"
                  }
                } sinon si ($tg0 == "q" ou $tg1 == "q") {
                  $fq = "rose_min_q"
                  si ($estmin == 0) { $fq = "rose_max_q" }
                  >> "    " + $dname + " = " + $fq + "(" + $arg0 + ", " + $arg1 + ");"
                } sinon si ($tg0 == "g" ou $tg1 == "g") {
                  $fg = "rose_min_gd"
                  si ($estmin == 0) { $fg = "rose_max_gd" }
                  >> "    " + $dname + " = " + $fg + "(" + $arg0 + ", " + $arg1 + ");"
                } sinon {
                  $fp = "rose_min"
                  si ($estmin == 0) { $fp = "rose_max" }
                  >> "    " + $dname + " = " + $fp + "(" + $arg0 + ", " + $arg1 + ");"
                }
              } sinon si ($fname == "fraction") {
                >> "    " + $dname + " = rose_qd(rose_q_de(" + operand($rtoks[3]) + ") / rose_q_de(" + operand($rtoks[4]) + "));"
              } sinon si ($fname == "millisecondes") {
                >> "    " + $dname + " = rose_millisecondes();"
              } sinon si ($fname == "temps") {
                >> "    " + $dname + " = rose_temps();"
              } sinon si ($fname == "nb_arguments") {
                >> "    " + $dname + " = rose_nb_arguments();"
              } sinon si ($fname == "argument") {
                >> "    " + $dname + " = rose_argument(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "graine") {
                >> "    rose_graine(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "lire_texte") {
                >> "    " + $dname + " = rose_lire_texte(" + operand($rtoks[3]) + ");"
              } sinon si ($fname == "quitter") {
                >> "    rose_quitter(" + operand($rtoks[3]) + ");"
              } sinon {
                $call = "r_" + $fname + "("
                $first = vrai
                $ai = 3
                tant_que ($ai < longueur($rtoks)) {
                  si ($first == faux) { $call = $call + ", " }
                  $first = faux
                  $call = $call + operand($rtoks[$ai])
                  $ai = $ai + 1
                }
                $call = $call + ")"
                >> "    " + $dname + " = " + $call + ";"
              }
            }
          } sinon si (commence_par($op, "rem.")) {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            >> "    " + $dname + " = rose_rem_florentin(" + $a0 + ", " + $a1 + ");"
          } sinon si (commence_par($bl, "br.cond ")) {
            $parts = [""]
            $cur = ""
            $k = 0
            tant_que ($k < longueur($bl)) {
              $ch = $bl[$k]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k = $k + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
            // parts: ["", "br.cond", "%t", "label1", "label2"]
            si (longueur($parts) >= 5) {
              >> "    if (" + operand($parts[2]) + ") goto r_" + trim(sous_chaine($parts[3], 1, longueur($parts[3]))) + ";"
              >> "    else goto r_" + trim(sous_chaine($parts[4], 1, longueur($parts[4]))) + ";"
            }
          } sinon si (commence_par($bl, "br ")) {
            $parts = [""]
            $cur = ""
            $k = 0
            tant_que ($k < longueur($bl)) {
              $ch = $bl[$k]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k = $k + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($parts, trim($cur)) }
            si (longueur($parts) >= 3) {
              >> "    goto r_" + trim(sous_chaine($parts[2], 1, longueur($parts[2]))) + ";"
            }
          } sinon si (commence_par($bl, "cmp.")) {
            // %t = cmp.lt.z %a %b
            $eq = 0
            tant_que ($eq + 2 < longueur($bl) et sous_chaine($bl, $eq, $eq+3) != " = ") { $eq = $eq + 1 }
            $dest = trim(sous_chaine($bl, 0, $eq))
            $rest = trim(sous_chaine($bl, $eq+3, longueur($bl)))
            $rtoks = [""]
            $cur = ""
            $k = 0
            tant_que ($k < longueur($rest)) {
              $ch = $rest[$k]
              si ($ch == ' ') {
                si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
                $cur = ""
              } sinon {
                $cur = $cur + $ch
              }
              $k = $k + 1
            }
            si (longueur(trim($cur)) > 0) { joindre($rtoks, trim($cur)) }
            $dname = operand($dest)
            si (longueur($rtoks) >= 4) {
              $a0 = operand($rtoks[2])
              $a1 = operand($rtoks[3])
              $cmpop = "<"
              si (contient($rtoks[1], ".lt.")) { $cmpop = "<" }
              si (contient($rtoks[1], ".le.")) { $cmpop = "<=" }
              si (contient($rtoks[1], ".gt.")) { $cmpop = ">" }
              si (contient($rtoks[1], ".ge.")) { $cmpop = ">=" }
              si (contient($rtoks[1], ".eq.")) { $cmpop = "==" }
              si (contient($rtoks[1], ".ne.")) { $cmpop = "!=" }
              >> "    " + $dname + " = (" + $a0 + " " + $cmpop + " " + $a1 + ");"
            }
          } sinon si (commence_par($op, "cmp.")) {
            $a0 = "0"; $a1 = "0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            $cmpop = "<"
            si (contient($op, ".lt.")) { $cmpop = "<" }
            si (contient($op, ".le.")) { $cmpop = "<=" }
            si (contient($op, ".gt.")) { $cmpop = ">" }
            si (contient($op, ".ge.")) { $cmpop = ">=" }
            si (contient($op, ".eq.")) { $cmpop = "==" }
            si (contient($op, ".ne.")) { $cmpop = "!=" }
            >> "    " + $dname + " = (" + $a0 + " " + $cmpop + " " + $a1 + ");"
          } sinon si ($op == "not.b") {
            si (longueur($rtoks) > 2) {
              >> "    " + $dname + " = !" + operand($rtoks[2]) + ";"
            }
          } sinon si ($op == "and.b") {
            $a0 = "false"; $a1 = "false"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            >> "    " + $dname + " = (" + $a0 + " && " + $a1 + ");"
          } sinon si ($op == "or.b") {
            $a0 = "false"; $a1 = "false"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            >> "    " + $dname + " = (" + $a0 + " || " + $a1 + ");"
          } sinon si ($op == "add.f" ou $op == "sub.f" ou $op == "mul.f" ou $op == "div.f" ou $op == "neg.f") {
            $a0 = "0.0"; $a1 = "0.0"
            si (longueur($rtoks) > 2) { $a0 = operand($rtoks[2]) }
            si (longueur($rtoks) > 3) { $a1 = operand($rtoks[3]) }
            si ($op == "add.f") { >> "    " + $dname + " = " + $a0 + " + " + $a1 + ";" }
            si ($op == "sub.f") { >> "    " + $dname + " = " + $a0 + " - " + $a1 + ";" }
            si ($op == "mul.f") { >> "    " + $dname + " = " + $a0 + " * " + $a1 + ";" }
            si ($op == "div.f") { >> "    " + $dname + " = rose_div_f(" + $a0 + ", " + $a1 + ");" }
            si ($op == "neg.f") { >> "    " + $dname + " = -" + $a0 + ";" }
          } sinon {
            >> "    /* " + $bl + " */"
          }
        } sinon {
          >> "    /* " + $bl + " */"
        }
        $bi = $bi + 1
      }

      si ($cname == "main") {
        >> "    return 0;"
      }
      >> "}"
      >> ""
    }
    $i = $i + 1
  }
}
