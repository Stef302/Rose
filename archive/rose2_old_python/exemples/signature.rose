# Exemple signature — exactitude mathématique de Rose v2

>> 1 / 2 + 1 / 3          # rationnel exact : 5/6
>> 100!                    # factorielle exacte (produit-arbre)
>> 2 ^ 100                 # puissance entière exacte
>> fraction(22, 7) - fraction(355, 113)   # écart exact entre deux approches de π

$fact = 50!
>> $fact

# factorielle itérative maison, puis comparaison avec la builtin
fn facto_iteratif(n: entier) -> entier {
    $acc = 1
    pour k de 2 vers n + 1 { $acc = $acc * k }
    retour $acc
}
>> facto_iteratif(30)
>> facto_iteratif(30) == factorielle(30)

# sucre conditionnel + bornes Unicode
>> 13 ≤ 20
>> 7 ≠ 9
>> 4 ≥ 4
