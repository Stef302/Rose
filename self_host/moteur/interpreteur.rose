# interpreteur.rose — Jalon M5.0, auto-hébergement du moteur Rose.
#
# Interpréteur Rose écrit EN Rose. Version M5.1 : démonstration que le
# compilateur Rose peut compiler du code Rose en binaire natif.
#
# Ce fichier est un programme Rose valide : compilé par le compilateur Rose
# (compilateur/compilateur.rose via rose build), il produit un binaire
# natif qui s'exécute.
#
# Utilisation (une fois compilé) :
#   ./interpreteur
#
# Auto-hebergement M5 : en cours de construction...
# Les prochaines étapes ajouteront un lexer, un parseur et un evaluateur.

fn main() -> entier {
  >> "Interpreteur Rose auto-heberge - version 0.2 (M5.1)"
  >> "Ce programme est ecrit en Rose et compile par le compilateur Rose."
  >> "Auto-hebergement M5 : en cours..."
  retour 0
}
