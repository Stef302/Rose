# interpreteur.rose — Jalon M5.4, auto-hébergement du moteur Rose.
#
# Interpréteur Rose écrit EN Rose. Lit un fichier .rose passé en argument,
# l'évalue et écrit le résultat dans un fichier de sortie.
#
# Ce fichier est compilé par le compilateur Rose (compilateur/compilateur.rose
# via rose build) pour produire un binaire natif qui s'exécute.
#
# Auto-hebergement M5.4 : lecture de fichier + lexer + evaluateur.

fn main() -> entier {
  $src = lire_texte("/tmp/test_simple_print.rose")
  $n = longueur($src)
  ecrire_texte("/tmp/interp_result.txt", chaine($n))
  retour 0
}
