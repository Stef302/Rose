# interpreteur.rose — Moteur Rose écrit EN Rose (v5.3 : intérpréteur simple sans fonctions utilisateur).
# Usage : rose/rose self_host/moteur/interpreteur.rose prog.rose
# Supporte : entiers, + - * / div ^, (), >>, si, tant_que, var = expr, fn std.

fn cp_classe($c: entier) -> entier {
  si ($c >= 48 et $c <= 57) { retour 1 }
  si (($c >= 65 et $c <= 90) ou ($c >= 97 et $c <= 122) ou $c == 95) { retour 2 }
  retour 0
}

fn lexe_suivant($pos: entier, $src: chaine, $n: entier, $ligne: entier,
                $toks_tag: liste<chaine>, $toks_val: liste<chaine>,
                $toks_ligne: liste<entier>) -> liste<entier> {
  $avancer = 1
  tant_que ($avancer == 1) {
    $avancer = 0
    si ($pos < $n) {
      $c2 = ordre(sous_chaine($src, $pos, $pos + 1))
      si ($c2 == 32 ou $c2 == 9 ou $c2 == 13) { $pos = $pos + 1; $avancer = 1 }
      sinon si ($c2 == 10) { $pos = $pos + 1; $ligne = $ligne + 1; $avancer = 1 }
      sinon si ($c2 == 35) {
        $fin_ligne = 0
        tant_que ($fin_ligne == 0) {
          si ($pos >= $n) { $fin_ligne = 1 }
          sinon {
            $c3 = ordre(sous_chaine($src, $pos, $pos + 1))
            si ($c3 == 10) { $fin_ligne = 1; $ligne = $ligne + 1; $pos = $pos + 1 }
            sinon { $pos = $pos + 1 }
          }
        }
        $avancer = 1
      }
    }
  }
  si ($pos >= $n) { retour [$pos, $ligne] }
  $c = ordre(sous_chaine($src, $pos, $pos + 1))
  $k = cp_classe($c)
  si ($k == 1) {
    $d = $pos; $a = $pos; $flott = 0
    tant_que ($a < $n et ordre(sous_chaine($src, $a, $a + 1)) >= 48 et ordre(sous_chaine($src, $a, $a + 1)) <= 57) { $a = $a + 1 }
    si ($a < $n et ordre(sous_chaine($src, $a, $a + 1)) == 46) { $flott = 1; $a = $a + 1 }
    tant_que ($a < $n et ordre(sous_chaine($src, $a, $a + 1)) >= 48 et ordre(sous_chaine($src, $a, $a + 1)) <= 57) { $a = $a + 1 }
    si ($flott == 1) { joindre($toks_tag, "flot") } sinon { joindre($toks_tag, "nbr") }
    joindre($toks_val, sous_chaine($src, $d, $a)); joindre($toks_ligne, $ligne)
    retour [$a, $ligne]
  }
  si ($k == 2) {
    $d2 = $pos; $b = $pos
    tant_que ($b < $n et cp_classe(ordre(sous_chaine($src, $b, $b + 1))) != 0) { $b = $b + 1 }
    $nom = sous_chaine($src, $d2, $b); $pos = $b
    si ($nom == "fn")       { joindre($toks_tag, "fn"); joindre($toks_val, "fn"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "si")     { joindre($toks_tag, "si"); joindre($toks_val, "si"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "sinon")  { joindre($toks_tag, "sinon"); joindre($toks_val, "sinon"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "tant_que") { joindre($toks_tag, "tant_que"); joindre($toks_val, "tant_que"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "pour")   { joindre($toks_tag, "pour"); joindre($toks_val, "pour"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "de")     { joindre($toks_tag, "de"); joindre($toks_val, "de"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "vers")   { joindre($toks_tag, "vers"); joindre($toks_val, "vers"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "retour") { joindre($toks_tag, "retour"); joindre($toks_val, "retour"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "vrai")   { joindre($toks_tag, "vrai"); joindre($toks_val, "vrai"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "faux")   { joindre($toks_tag, "faux"); joindre($toks_val, "faux"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "et")     { joindre($toks_tag, "et"); joindre($toks_val, "et"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "ou")     { joindre($toks_tag, "ou"); joindre($toks_val, "ou"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "non")    { joindre($toks_tag, "non"); joindre($toks_val, "non"); joindre($toks_ligne, $ligne) }
    sinon si ($nom == "div")    { joindre($toks_tag, "div"); joindre($toks_val, "div"); joindre($toks_ligne, $ligne) }
    sinon {
      joindre($toks_tag, "ident"); joindre($toks_val, $nom); joindre($toks_ligne, $ligne)
    }
    retour [$pos, $ligne]
  }
  si ($c == 36) {
    $d3 = $pos; $b3 = $pos + 1
    tant_que ($b3 < $n et cp_classe(ordre(sous_chaine($src, $b3, $b3 + 1))) != 0) { $b3 = $b3 + 1 }
    $nom3 = sous_chaine($src, $d3, $b3)
    joindre($toks_tag, "var"); joindre($toks_val, $nom3); joindre($toks_ligne, $ligne)
    retour [$b3, $ligne]
  }
  si ($c == 34) {
    $d4 = $pos + 1; $b4 = $d4; $termine = 0
    tant_que ($termine == 0) {
      si ($b4 >= $n) { $termine = 1 }
      sinon {
        $c4 = ordre(sous_chaine($src, $b4, $b4 + 1))
        si ($c4 == 34) { $termine = 1 } sinon { $b4 = $b4 + 1 }
      }
    }
    $s = sous_chaine($src, $d4, $b4)
    joindre($toks_tag, "str"); joindre($toks_val, $s); joindre($toks_ligne, $ligne)
    retour [$b4 + 1, $ligne]
  }
  si ($c == 46) {
    $d5 = $pos; $b5 = $d5 + 1
    tant_que ($b5 < $n et ordre(sous_chaine($src, $b5, $b5 + 1)) >= 48 et ordre(sous_chaine($src, $b5, $b5 + 1)) <= 57) { $b5 = $b5 + 1 }
    joindre($toks_tag, "flot"); joindre($toks_val, sous_chaine($src, $d5, $b5)); joindre($toks_ligne, $ligne)
    retour [$b5, $ligne]
  }
  si ($pos + 1 < $n) { $c2b = ordre(sous_chaine($src, $pos + 1, $pos + 2)) } sinon { $c2b = 0 }
  si ($c == 62 et $c2b == 62) { joindre($toks_tag, "op"); joindre($toks_val, ">>"); joindre($toks_ligne, $ligne); retour [$pos + 2, $ligne] }
  si ($c == 60 et $c2b == 61) { joindre($toks_tag, "op"); joindre($toks_val, "<="); joindre($toks_ligne, $ligne); retour [$pos + 2, $ligne] }
  si ($c == 61 et $c2b == 61) { joindre($toks_tag, "op"); joindre($toks_val, "=="); joindre($toks_ligne, $ligne); retour [$pos + 2, $ligne] }
  si ($c == 33 et $c2b == 61) { joindre($toks_tag, "op"); joindre($toks_val, "!="); joindre($toks_ligne, $ligne); retour [$pos + 2, $ligne] }
  si ($c == 62 et $c2b == 61) { joindre($toks_tag, "op"); joindre($toks_val, ">="); joindre($toks_ligne, $ligne); retour [$pos + 2, $ligne] }
  si ($c == 45 et $c2b == 62) { joindre($toks_tag, "op"); joindre($toks_val, "->"); joindre($toks_ligne, $ligne); retour [$pos + 2, $ligne] }
  si ($c == 62) { joindre($toks_tag, "op"); joindre($toks_val, ">"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 60) { joindre($toks_tag, "op"); joindre($toks_val, "<"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 61) { joindre($toks_tag, "op"); joindre($toks_val, "="); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 33) { joindre($toks_tag, "op"); joindre($toks_val, "!"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 43) { joindre($toks_tag, "op"); joindre($toks_val, "+"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 45) { joindre($toks_tag, "op"); joindre($toks_val, "-"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 42) { joindre($toks_tag, "op"); joindre($toks_val, "*"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 47) { joindre($toks_tag, "op"); joindre($toks_val, "/"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 37) { joindre($toks_tag, "op"); joindre($toks_val, "%"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 94) { joindre($toks_tag, "op"); joindre($toks_val, "^"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 40) { joindre($toks_tag, "op"); joindre($toks_val, "("); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 41) { joindre($toks_tag, "op"); joindre($toks_val, ")"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 91) { joindre($toks_tag, "op"); joindre($toks_val, "["); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 93) { joindre($toks_tag, "op"); joindre($toks_val, "]"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 123) { joindre($toks_tag, "op"); joindre($toks_val, "{"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 125) { joindre($toks_tag, "op"); joindre($toks_val, "}"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 44) { joindre($toks_tag, "op"); joindre($toks_val, ","); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 58) { joindre($toks_tag, "op"); joindre($toks_val, ":"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  si ($c == 59) { joindre($toks_tag, "op"); joindre($toks_val, ";"); joindre($toks_ligne, $ligne); retour [$pos + 1, $ligne] }
  retour [$pos + 1, $ligne]
}

fn lexe_fichier($src: chaine, $n: entier,
                $toks_tag: liste<chaine>, $toks_val: liste<chaine>,
                $toks_ligne: liste<entier>) {
  $pos = 0; $ligne = 1
  tant_que ($pos < $n) {
    $r = lexe_suivant($pos, $src, $n, $ligne, $toks_tag, $toks_val, $toks_ligne)
    $pos = $r[0]; $ligne = $r[1]
  }
  joindre($toks_tag, "fin"); joindre($toks_val, ""); joindre($toks_ligne, $ligne)
}

fn lire_var($env: liste<chaine>, $nom: chaine) -> chaine {
  $i = longueur($env) - 2
  tant_que ($i >= 2) {
    si ($env[$i] == $nom) { retour $env[$i + 1] }
    $i = $i - 2
  }
  afficher_erreur($nom + " : Variable utilisée sans valeur"); quitter(1)
}

fn ecrire_var($env: liste<chaine>, $nom: chaine, $val: chaine) -> liste<chaine> {
  joindre($env, $nom); joindre($env, $val)
  retour $env
}

fn prec_de($op: chaine) -> entier {
  si ($op == "ou") { retour 1 }
  si ($op == "et") { retour 2 }
  si ($op == "==" ou $op == "!=" ou $op == "<" ou $op == ">" ou $op == "<=" ou $op == ">=") { retour 3 }
  si ($op == "+" ou $op == "-") { retour 4 }
  si ($op == "*" ou $op == "/" ou $op == "%" ou $op == "div") { retour 5 }
  si ($op == "^") { retour 6 }
  retour 0
}

fn est_op_binaire($op: chaine) -> entier {
  si ($op == "==" ou $op == "!=" ou $op == "<" ou $op == ">" ou $op == "<=" ou $op == ">=") { retour 1 }
  si ($op == "+" ou $op == "-" ou $op == "*" ou $op == "/" ou $op == "%" ou $op == "div" ou $op == "^") { retour 1 }
  retour 0
}

fn est_et_ou($tag: chaine) -> entier {
  si ($tag == "et" ou $tag == "ou") { retour 1 }
  retour 0
}

fn unaire($cur: entier, $toks_tag: liste<chaine>, $toks_val: liste<chaine>, $env: liste<chaine>) -> liste<entier> {
  $t = $toks_tag[$cur]
  si ($t == "op" et $toks_val[$cur] == "-") {
    $r = unaire($cur + 1, $toks_tag, $toks_val, $env)
    $cur = $r[0]
    retour [$cur, -$r[1]]
  }
  si ($t == "non") {
    $r2 = unaire($cur + 1, $toks_tag, $toks_val, $env)
    $cur = $r2[0]
    si ($r2[1] == 0) { retour [$cur, 1] } sinon { retour [$cur, 0] }
  }
  retour primaire($cur, $toks_tag, $toks_val, $env)
}

fn primaire($cur: entier, $toks_tag: liste<chaine>, $toks_val: liste<chaine>, $env: liste<chaine>) -> liste<entier> {
  $t = $toks_tag[$cur]; $v = $toks_val[$cur]
  si ($t == "nbr") { retour [$cur + 1, entier($v)] }
  si ($t == "vrai") { retour [$cur + 1, 1] }
  si ($t == "faux") { retour [$cur + 1, 0] }
  si ($t == "op" et $v == "(") {
    $r = expr_p($cur + 1, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $val = $r[1]
    $tk2 = $toks_tag[$cur]
    si ($tk2 == "op" et $toks_val[$cur] == ")") {
      retour postfixe($cur + 1, $val, $toks_tag, $toks_val, $env)
    } sinon { afficher_erreur("interp : ) attendu"); quitter(1) }
  }
  si ($t == "var" ou $t == "ident") {
    $nom = $v; $cur2 = $cur + 1
    si ($cur2 < longueur($toks_tag) et $toks_tag[$cur2] == "op" et $toks_val[$cur2] == "(") {
      $cur3 = $cur2 + 1
      $tk3 = $toks_tag[$cur3]
      si ($tk3 == "op" et $toks_val[$cur3] == ")") {
        $cur4 = $cur3 + 1
        $ri = appel_direct($nom, 0, 0, 0, $env)
        retour postfixe($cur4, $ri, $toks_tag, $toks_val, $env)
      } sinon {
        $r = expr_p($cur3, 0, $toks_tag, $toks_val, $env)
        $cur4 = $r[0]; $a0 = $r[1]
        $cur4 = $cur4 + 1
        $tk7 = $toks_tag[$cur4]
        si ($tk7 == "op" et $toks_val[$cur4] == ")") {
          $cur4 = $cur4 + 1
          $ri = appel_direct($nom, $a0, 0, 0, $env)
          retour postfixe($cur4, $ri, $toks_tag, $toks_val, $env)
        } sinon { afficher_erreur($nom + " : ) attendu"); quitter(1) }
      }
    }
    $rv = lire_var($env, $nom)
    retour postfixe($cur2, entier($rv), $toks_tag, $toks_val, $env)
  }
  afficher_erreur("interp : expression attendue avant " + $v); quitter(1)
}

fn appel_direct($nom: chaine, $a0: entier, $a1: entier, $a2: entier, $env: liste<chaine>) -> entier {
  si ($nom == "factorielle") { retour factorielle($a0) }
  si ($nom == "fibonacci")  { retour fibonacci($a0) }
  si ($nom == "pgcd")       { retour pgcd($a0, $a1) }
  si ($nom == "ppcm")       { retour ppcm($a0, $a1) }
  si ($nom == "est_premier") { si (est_premier($a0)) { retour 1 } sinon { retour 0 } }
  si ($nom == "compter_premiers") { retour compter_premiers($a0) }
  si ($nom == "nb_chiffres") { retour nb_chiffres($a0) }
  si ($nom == "puissance")  { retour puissance($a0, $a1) }
  si ($nom == "partie_entiere") { retour partie_entiere($a0) }
  si ($nom == "abs")        { retour abs($a0) }
  si ($nom == "min")        { retour min($a0, $a1) }
  si ($nom == "max")        { retour max($a0, $a1) }
  si ($nom == "entier")     { retour $a0 }
  si ($nom == "nb_arguments") { retour nb_arguments() }
  si ($nom == "argument")   { retour entier(argument($a0)) }
  si ($nom == "temps")      { retour temps() }
  si ($nom == "millisecondes") { retour millisecondes() }
  si ($nom == "hasard")     { retour hasard($a0) }
  afficher_erreur("interp : fonction inconnue " + $nom); quitter(1)
}

fn postfixe($cur: entier, $val: entier, $toks_tag: liste<chaine>, $toks_val: liste<chaine>, $env: liste<chaine>) -> liste<entier> {
  $fin = 0
  tant_que ($fin == 0) {
    $t = $toks_tag[$cur]
    si ($t == "fin") { $fin = 1 }
    sinon {
      si ($t == "op" et $toks_val[$cur] == "[") {
        $r = expr_p($cur + 1, 0, $toks_tag, $toks_val, $env)
        $cur = $r[0]
        $tc = $toks_tag[$cur]
        si ($tc == "op" et $toks_val[$cur] == "]") { $cur = $cur + 1 }
        sinon { afficher_erreur("interp : ] attendu"); quitter(1) }
        retour postfixe($cur, $val, $toks_tag, $toks_val, $env)
      } sinon si ($t == "op" et $toks_val[$cur] == "!") {
        $cur = $cur + 1; $val = factorielle($val)
      } sinon { $fin = 1 }
    }
  }
  retour [$cur, $val]
}

fn expr_p($cur: entier, $p: entier, $toks_tag: liste<chaine>, $toks_val: liste<chaine>, $env: liste<chaine>) -> liste<entier> {
  $r = unaire($cur, $toks_tag, $toks_val, $env)
  $cur = $r[0]; $g = $r[1]
  $fin = 0
  tant_que ($fin == 0) {
    $t = $toks_tag[$cur]; $stop = 1
    si ($t == "op" et est_op_binaire($toks_val[$cur]) == 1) {
      $pr = prec_de($toks_val[$cur])
      si ($pr > 0 et $pr >= $p) {
        $op = $toks_val[$cur]; $cur = $cur + 1
        si ($op == "^") { $r2 = expr_p($cur, $pr, $toks_tag, $toks_val, $env) }
        sinon { $r2 = expr_p($cur, $pr + 1, $toks_tag, $toks_val, $env) }
        $cur = $r2[0]; $d = $r2[1]
        si ($op == "+")  { $g = $g + $d }
        sinon si ($op == "-")  { $g = $g - $d }
        sinon si ($op == "*")  { $g = $g * $d }
        sinon si ($op == "/")  { $g = partie_entiere($g / $d) }
        sinon si ($op == "%")  { $g = $g % $d }
        sinon si ($op == "div") { $g = $g div $d }
        sinon si ($op == "^")  { $g = $g ^ $d }
        sinon si ($op == "==") { si ($g == $d) { $g = 1 } sinon { $g = 0 } }
        sinon si ($op == "!=") { si ($g != $d) { $g = 1 } sinon { $g = 0 } }
        sinon si ($op == "<")  { si ($g < $d) { $g = 1 } sinon { $g = 0 } }
        sinon si ($op == ">")  { si ($g > $d) { $g = 1 } sinon { $g = 0 } }
        sinon si ($op == "<=") { si ($g <= $d) { $g = 1 } sinon { $g = 0 } }
        sinon si ($op == ">=") { si ($g >= $d) { $g = 1 } sinon { $g = 0 } }
        sinon si ($op == "et") { si ($g != 0 et $d != 0) { $g = 1 } sinon { $g = 0 } }
        sinon si ($op == "ou") { si ($g != 0 ou $d != 0) { $g = 1 } sinon { $g = 0 } }
        $stop = 0
      }
    } sinon {
      si (est_et_ou($t) == 1) {
        $pr2 = prec_de($t)
        si ($pr2 >= $p) {
          $cur = $cur + 1
          $r2 = expr_p($cur, $pr2 + 1, $toks_tag, $toks_val, $env)
          $cur = $r2[0]; $d = $r2[1]
          si ($t == "et") { si ($g != 0 et $d != 0) { $g = 1 } sinon { $g = 0 } }
          sinon { si ($g != 0 ou $d != 0) { $g = 1 } sinon { $g = 0 } }
          $stop = 0
        }
      }
    }
    si ($stop == 1) { $fin = 1 }
  }
  retour [$cur, $g]
}

fn extraire_bloc($cur: entier, $toks_tag: liste<chaine>, $toks_val: liste<chaine>) -> liste<entier> {
  si (non ($toks_tag[$cur] == "op" et $toks_val[$cur] == "{")) {
    afficher_erreur("interp : { attendu"); quitter(1)
  }
  $cur = $cur + 1; $debut = $cur; $prof = 1; $trouve = 0
  tant_que ($trouve == 0) {
    $t = $toks_tag[$cur]
    si ($t == "fin") { afficher_erreur("interp : } attendu"); quitter(1) }
    si ($t == "op" et $toks_val[$cur] == "{") { $prof = $prof + 1; $cur = $cur + 1 }
    sinon si ($t == "op" et $toks_val[$cur] == "}") {
      $prof = $prof - 1
      si ($prof == 0) { $trouve = 1 } sinon { $cur = $cur + 1 }
    } sinon { $cur = $cur + 1 }
  }
  $fin = $cur; $cur = $cur + 1
  retour [$cur, $debut, $fin]
}

fn exec_corps($debut: entier, $fin: entier, $toks_tag: liste<chaine>,
              $toks_val: liste<chaine>, $env: liste<chaine>) -> liste<entier> {
  $cur = $debut; $rv = [0, 0, 0]
  tant_que ($cur < $fin) {
    $rv = executer_stmt($cur, $toks_tag, $toks_val, $env)
    $cur = $rv[1]
    si ($rv[0] == 1) { $cur = $fin }
  }
  retour $rv
}

fn executer_stmt($cur: entier, $toks_tag: liste<chaine>,
                 $toks_val: liste<chaine>, $env: liste<chaine>) -> liste<entier> {
  tant_que ($cur < longueur($toks_tag) et ($toks_tag[$cur] == "op" et ($toks_val[$cur] == "\n" ou $toks_val[$cur] == ";"))) {
    $cur = $cur + 1
  }
  si ($cur >= longueur($toks_tag)) { retour [0, $cur, 0] }
  $t = $toks_tag[$cur]; $v = $toks_val[$cur]
  si ($t == "fin") { retour [0, longueur($toks_tag), 0] }

  si ($t == "op" et $v == ">>") {
    $cur = $cur + 1
    $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $val = $r[1]
    >> $val; >> "\n"
    retour [0, $cur, 0]
  }

  si ($t == "si") {
    $cur = $cur + 1
    $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $cond = $r[1]
    $r2 = extraire_bloc($cur, $toks_tag, $toks_val)
    $cur = $r2[0]; $debut = $r2[1]; $fin = $r2[2]
    si ($cond != 0) {
      $rv = exec_corps($debut, $fin, $toks_tag, $toks_val, $env)
      si ($rv[0] == 1) { retour [1, $cur, $rv[2]] }
      si ($cur < longueur($toks_tag) et $toks_tag[$cur] == "sinon") {
        $cur = $cur + 1; $r3 = extraire_bloc($cur, $toks_tag, $toks_val); $cur = $r3[0]
      }
      retour [0, $cur, 0]
    } sinon {
      si ($cur < longueur($toks_tag) et $toks_tag[$cur] == "sinon") {
        $cur = $cur + 1; $r3 = extraire_bloc($cur, $toks_tag, $toks_val)
        $cur = $r3[0]; $debut2 = $r3[1]; $fin2 = $r3[2]
        $rv2 = exec_corps($debut2, $fin2, $toks_tag, $toks_val, $env)
        si ($rv2[0] == 1) { retour [1, $cur, $rv2[2]] }
        retour [0, $cur, 0]
      }
      retour [0, $cur, 0]
    }
  }

  si ($t == "tant_que") {
    $cur = $cur + 1
    $cond_pos = $cur
    $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $cond = $r[1]
    $r2 = extraire_bloc($cur, $toks_tag, $toks_val)
    $cur = $r2[0]; $debut = $r2[1]; $fin = $r2[2]
    tant_que ($cond != 0) {
      $rv = exec_corps($debut, $fin, $toks_tag, $toks_val, $env)
      si ($rv[0] == 1) { retour [1, $cur, $rv[2]] }
      $r = expr_p($cond_pos, 0, $toks_tag, $toks_val, $env)
      $cond = $r[1]
    }
    retour [0, $cur, 0]
  }

  si ($t == "pour") {
    $cur = $cur + 1
    $tk4 = $toks_tag[$cur]
    si (non ($tk4 == "ident" ou $tk4 == "var")) { afficher_erreur("pour : variable attendue"); quitter(1) }
    $nom = $toks_val[$cur]; $cur = $cur + 1; $cur = $cur + 1
    $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $a = $r[1]
    $cur = $cur + 1; $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $b = $r[1]
    $r2 = extraire_bloc($cur, $toks_tag, $toks_val)
    $cur = $r2[0]; $debut = $r2[1]; $fin = $r2[2]
    $env = ecrire_var($env, $nom, chaine($a))
    tant_que (entier(lire_var($env, $nom)) < $b) {
      $rv = exec_corps($debut, $fin, $toks_tag, $toks_val, $env)
      si ($rv[0] == 1) { retour [1, $cur, $rv[2]] }
      $env = ecrire_var($env, $nom, chaine(entier(lire_var($env, $nom)) + 1))
    }
    retour [0, $cur, 0]
  }

  si ($t == "fn") {
    $cur = $cur + 1; $cur = $cur + 1
    si ($cur < longueur($toks_tag) et $toks_tag[$cur] == "op" et $toks_val[$cur] == "(") {
      $cur = $cur + 1; $prof = 1
      tant_que ($prof > 0) {
        si ($toks_tag[$cur] == "op" et $toks_val[$cur] == "(") { $prof = $prof + 1 }
        sinon si ($toks_tag[$cur] == "op" et $toks_val[$cur] == ")") { $prof = $prof - 1 }
        $cur = $cur + 1
      }
    }
    si ($cur < longueur($toks_tag) et $toks_tag[$cur] == "op" et $toks_val[$cur] == "->") { $cur = $cur + 2 }
    $r = extraire_bloc($cur, $toks_tag, $toks_val)
    $cur = $r[0]
    retour [0, $cur, 0]
  }

  si ($t == "retour") {
    $cur = $cur + 1
    si ($cur < longueur($toks_tag) et $toks_tag[$cur] == "op" et ($toks_val[$cur] == "}" ou $toks_val[$cur] == "fin")) {
      retour [1, $cur, 0]
    }
    $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $val = $r[1]
    retour [1, $cur, $val]
  }

  si ($t == "ident" et $v == "var") {
    $cur = $cur + 1
    $nom = $toks_val[$cur]; $cur = $cur + 1
    si (non ($cur < longueur($toks_tag) et $toks_tag[$cur] == "op" et $toks_val[$cur] == "=")) {
      afficher_erreur($nom + " : = attendu"); quitter(1)
    }
    $cur = $cur + 1
    $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $val = $r[1]
    $env = ecrire_var($env, $nom, chaine($val))
    retour [0, $cur, 0]
  }

  si ($t == "var" et $cur + 1 < longueur($toks_tag) et $toks_tag[$cur + 1] == "op" et $toks_val[$cur + 1] == "=") {
    $nom = $v; $cur = $cur + 1; $cur = $cur + 1
    $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
    $cur = $r[0]; $val = $r[1]
    $env = ecrire_var($env, $nom, chaine($val))
    retour [0, $cur, 0]
  }

  $r = expr_p($cur, 0, $toks_tag, $toks_val, $env)
  $cur = $r[0]; _ = $r[1]
  retour [0, $cur, 0]
}

# ── Point d'entrée ──
$toks_tag = ["__init__"]; $toks_val = ["__init__"]; $toks_ligne = [0]; $env = ["__init__", "__init__"]
$chemin = argument(0)
$src = lire_texte($chemin); $n = longueur($src)
lexe_fichier($src, $n, $toks_tag, $toks_val, $toks_ligne)
$cur = 1; $nn = longueur($toks_tag); $rv = [0, 0, 0]; $iter = 0; $max_iter = 1000000
tant_que ($cur < $nn et $iter < $max_iter) {
  $rv = executer_stmt($cur, $toks_tag, $toks_val, $env)
  $cur = $rv[1]
  $env = $rv[2]
  $iter = $iter + 1
  si ($rv[0] == 1) { afficher_erreur("retour hors fonction"); quitter(1) }
}
si ($iter >= $max_iter) {
  afficher_erreur("interp : boucle infinie détectée (sécurité)")
  quitter(1)
}
