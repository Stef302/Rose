# interpreteur.rose — Jalon M5.1, auto-hébergement du moteur Rose.
# Interpréteur Rose écrit EN Rose. Version M5.1 : lexer + évaluateur
# d'expressions entières avec + et -.
# Ce fichier est compilé par le compilateur Rose (compilateur/compilateur.rose
# via rose build) pour produire un binaire natif.

fn main() -> entier {
  $src = "3 + 5 - 2"
  $n = longueur($src)
  $i = 0
  $acc = 0
  $signe = 1
  tant_que ($i < $n) {
    $c = ordre($src[$i])
    si ($c == 32 ou $c == 9 ou $c == 10) {
      $i = $i + 1
    } sinon si ($c >= 48 et $c <= 57) {
      $v = 0
      tant_que ($i < $n et ordre($src[$i]) >= 48 et ordre($src[$i]) <= 57) {
        $v = $v * 10 + (ordre($src[$i]) - 48)
        $i = $i + 1
      }
      $acc = $acc + ($signe * $v)
    } sinon si ($c == 43) {
      $signe = 1
      $i = $i + 1
    } sinon si ($c == 45) {
      $signe = -1
      $i = $i + 1
    } sinon {
      $i = $i + 1
    }
  }
  >> $acc
  retour 0
}
