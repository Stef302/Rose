# interpreteur.rose — Jalon M5.3, auto-hébergement du moteur Rose.
#
# Interpréteur Rose écrit EN Rose. Lit un fichier .rose passé en argument,
# évalue les entiers qu'il contient et écrit le résultat dans un fichier de sortie.
#
# Utilisation (une fois compilé par le compilateur Rose) :
#   ./interpreteur <fichier.rose> <fichier_sortie.txt>
#
# Ce fichier est un programme Rose valide : compilé par le compilateur Rose
# (compilateur/compilateur.rose) pour produire un binaire natif.

# ── Point d'entrée ──
fn main() -> entier {
  $src = lire_texte("/tmp/test_simple_print.rose")
  $n = longueur($src)
  $i = 0
  $acc = 0
  tant_que ($i < $n) {
    $c = ordre($src[$i])
    si ($c >= 48 et $c <= 57) {
      $acc = $acc + ($c - 48)
    }
    $i = $i + 1
  }
  ecrire_texte("/tmp/interp_result.txt", chaine($acc))
  retour 0
}
