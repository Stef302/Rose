# mos.bud — MANIFESTE DE DONNÉES du format exécutable Rose `.mos`.
# Aucune logique : ni `si`, ni boucle, ni fonction. Aucun format d'hôte
# (ELF/PE/COFF/WASM) n'est nommé comme format de sortie : `.mos` est le
# conteneur Rose universel. Les architectures sont des DONNÉES consultées
# par `compilateur/format_mos.rose` (`mos_arch_code`), jamais des branches
# codées en dur dans le chargeur.

nom: "format-mos-generique"
version: "1.0.0"

cible: {
  architecture: GENERIQUE
  boutisme: petit
  largeur_mot: 64
  largeur_page: 4096
  abi: rose-utilisateur-v0
}

profil: utilisateur

briques: [
  "abi/mos.bud",
  "compilateur/format_mos.rose",
  "tests_mos.rose"
]

options: {
  freestanding: vrai
  pie: faux
  gc: faux
  alloc_implicite: faux
  latence_max: 0
}

donnees: {
  # En-tête — largeurs en caractères ASCII (le conteneur est ASCII-safe).
  en_tete: {
    magic: "MOS"
    nul: 1
    version: "0001"
    version_majeure: 0
    version_mineure: 1
    taille_totale: 10
    architecture: 10
    adresse_entree: 10
    nombre_sections: 2
    table_section: { offset: 10, taille: 10, droits: 2 }
    longueur_table: 22
    debut_table: 40
    debut_charges: 106
  }

  # Permissions abstraites : aucun bit de pagination matérielle.
  droits: {
    lecture: 1
    ecriture: 2
    execution: 4
  }

  # Registre d'architectures — donnez-en une seule ligne par cible. Le
  # code est lu par `mos_arch_code`, il n'est pas comparé dans le code.
  architectures: [
    { nom: "GENERIQUE", code: 0 },
    { nom: "AARCH64", code: 1 },
    { nom: "X86_64", code: 2 },
    { nom: "WASM", code: 3 }
  ]

  # Trois sections fixes en v1. L'encodage des deux premières est
  # hexadécimal sur 4 chiffres par point de code Rose (donc exact même
  # avec des identifiants accentés ou `π` dans le RIR).
  sections: [
    { nom: "rir", droits: 5, encodage: "hex-points-4" },
    { nom: "cible", droits: 1, encodage: "hex-points-4" },
    { nom: "hash", droits: 1, encodage: "hex", longueur: 24 }
  ]

  hachage: {
    premier: "polynome-mod-2^31-1-base-257-graine-17"
    second: "polynome-mod-10^9+7-base-131-graine-31"
    troisieme: "polynome-mod-2147483629-base-31-graine-7"
    largeur: 8
    nombre: 3
    couverture: "en-tete + sections 1 et 2"
  }

  # Métadonnées de cible : ordre des champs de l'argument `cible` de
  # `mos_ecrire`, séparateur '|'. Le 6e champ est optionnel.
  cible: {
    separateur: "|"
    champs: [
      "architecture",
      "boutisme",
      "largeur_mot",
      "largeur_page",
      "abi",
      "adresse_entree"
    ]
  }
}

sortie: {
  format: mos
  entree: principal
  adresse_charge: 4194304
  alignement: 4096
}
