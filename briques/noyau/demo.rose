# demo.rose — PETIT NOYAU DE DÉMONSTRATION ÉCRIT EN ROSE
# ============================================================================
#
# Constat daté : 26/11/2026. Ce fichier est la SOURCE du noyau : la logique
# est écrite en Rose (fonction `principal()`), PAS sous forme d'octets calculés
# à la main. Il est concaténé APRÈS `compilateur/backend_universel.rose` (Rose
# n'a pas de modules) puis traduit par `bu_traduire` vers la cible NU `i386`.
#
# Ce que fait le noyau une fois chargé en anneau 0 :
#   1. il initialise la chaîne "ROSE KERNEL" (plus un 0 final) à l'adresse
#      physique fixe 0x101000 — trois mots de 32 bits écrits depuis %eax ;
#   2. il exécute HLT puis un saut relatif court sur lui-même (boucle infinie).
#
# Ce que fait CE fichier maintenant (compilation) :
#   `principal()` construit une SUITE D'OPÉRATIONS ABSTRAITES via `bu_operation`.
#    Aucun opcode x86 n'apparaît ici : c'est le backend qui les connaît.
#
# Les deux adresses sont des DONNÉES DU LIEUR (`lien_nu.rose`), pas des
# constantes de l'émetteur. La chaîne est décomposée en mots par `ordre()` :
# les caractères ne sont PAS recopiés en dur en décimal.
#
# Compilation :
#   bash briques/noyau/compiler_noyau.sh
#   objdump -D -b binary -mi386 briques/noyau/kernel32.bin
# ============================================================================

# ── Données du noyau (adresses choisies par le lieur, chaîne source) ─────────
$NU_ADRESSE_CHARGE = 1048576      # 0x100000 : adresse de chargement du binaire
$NU_ADRESSE_CHAINE = 1052672      # 0x101000 : adresse fixe de "ROSE KERNEL"
$NU_CHAINE = "ROSE KERNEL"

# Pack 4 caractères d'une chaîne Rose en un mot 32 bit primitive (petit-boutiste).
# Un octet manquant (bout de chaîne) vaut 0 : cela pose le terminateur NUL.
fn noyau_mot(s: chaine, debut: entier) -> entier {
  $v = 0
  $k = 0
  tant_que ($k < 4) {
    $c = 0
    si (debut + $k < longueur(s)) {
      $c = ordre(sous_chaine(s, debut + $k, debut + $k + 1))
    }
    $v = $v + $c * (256 ^ $k)
    $k = $k + 1
  }
  retour $v
}

# ── LA LOGIQUE DU NOYAU, EN ROSE ────────────────────────────────────────────
# Produit la suite abstraite que le backend traduira en x86 32 bits nu.
fn principal() -> liste<entier> {
  $seq = bu_sequence()

  # %eax = adresse fixe où écrire la chaîne (donnée du lieur).
  bu_ajouter($seq, bu_operation("imm", [0, $NU_ADRESSE_CHAINE]))

  # Écriture des 12 octets ("ROSE KERNEL" + NUL) en trois mots de 32 bits.
  # Chaque mot est CALCULÉ depuis la chaîne Rose, jamais tapé en décimal.
  $pos = 0
  tant_que ($pos < 12) {
    bu_ajouter($seq, bu_operation("imm", [1, noyau_mot($NU_CHAINE, $pos)]))
    bu_ajouter($seq, bu_operation("store", [1, 0, $pos]))
    $pos = $pos + 4
  }

  # Boucle finale : HLT puis saut relatif court sur l'instruction HLT.
  # -2 = EB FE : le décalage est fourni par le Rose, encodé par le backend.
  bu_ajouter($seq, bu_operation("hlt", [0]))
  bu_ajouter($seq, bu_operation("jmp_rel8", [-2]))

  retour $seq
}

# ── Contrôles de la source (avant émission) ──────────────────────────────────
>> longueur($NU_CHAINE)              # 11 : "ROSE KERNEL"
>> noyau_mot($NU_CHAINE, 0)          # 1163087698 = 0x45534F52 = "ROSE"
>> noyau_mot($NU_CHAINE, 4)          # 1380272928 = 0x52454B20 = " KER"
>> noyau_mot($NU_CHAINE, 8)          # 4998478 = 0x004C454E = "NEL\0"
>> longueur(principal()) - 1         # 9 opérations abstraites
