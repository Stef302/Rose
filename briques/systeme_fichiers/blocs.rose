# ═══════════════════════════════════════════════════════════════════════════
# briques/systeme_fichiers/blocs.rose — SYSTÈME DE FICHIERS PAR BLOCS, ROSE PUR
# ═══════════════════════════════════════════════════════════════════════════
#
# Brique OS : système de fichiers minimal par blocs. Aucun nom de FS, aucun
# périphérique. L'état est une liste d'entiers :
#   [nb_blocs, blocs_libres, nb_fichiers]
# puis pour chaque fichier (8 entiers) :
#   [inode, taille, bloc_debut, nb_blocs, type, parent, empreinte_nom, etat]
#   type : 1 = fichier, 2 = répertoire
#   etat : 0 = libre, 1 = occupé

fn fs_set(l: liste<entier>, idx: entier, v: entier) -> liste<entier> {
  $n = longueur(l)
  $m = $n
  si ($idx >= $m) { $m = $idx + 1 }
  $x0 = 0
  si ($n > 0) { $x0 = l[0] }
  si ($idx == 0) { $x0 = v }
  $r = [$x0]
  $k = 1
  tant_que ($k < $m) {
    $x = 0
    si ($k < $n) { $x = l[$k] }
    si ($k == $idx) { $x = v }
    joindre($r, $x)
    $k = $k + 1
  }
  retour $r
}

fn fs_nouveau(nb_blocs: entier) -> liste<entier> {
  $r = [$nb_blocs]
  joindre($r, $nb_blocs)   # blocs libres
  joindre($r, 0)            # nb fichiers
  # racine = répertoire inode 0
  $base = 3
  $r = fs_set($r, $base, 0)       # inode 0
  $r = fs_set($r, $base + 1, 0)   # taille 0
  $r = fs_set($r, $base + 2, 0)   # bloc_debut 0
  $r = fs_set($r, $base + 3, 0)   # nb_blocs 0
  $r = fs_set($r, $base + 4, 2)   # répertoire
  $r = fs_set($r, $base + 5, 0)   # parent (soi-même)
  $r = fs_set($r, $base + 6, 0)   # empreinte nom "/"
  $r = fs_set($r, $base + 7, 1)   # occupé
  $r = fs_set($r, 2, 1)            # 1 fichier (la racine)
  retour $r
}

fn fs_nb_blocs(f: liste<entier>) -> entier { retour f[0] }
fn fs_blocs_libres(f: liste<entier>) -> entier { retour f[1] }
fn fs_nb_fichiers(f: liste<entier>) -> entier { retour f[2] }

fn fs_base(i: entier) -> entier { retour 3 + 8 * $i }

fn fs_creer(f: liste<entier>, nom_empreinte: entier, type: entier,
            parent: entier, taille: entier) -> liste<entier> {
  $r = fs_set(f, 2, f[2] + 1)
  $i = f[2]   # nouvel index (avant incrément logique)
  $base = fs_base($i)
  $r = fs_set($r, $base, $i)
  $r = fs_set($r, $base + 1, $taille)
  $r = fs_set($r, $base + 2, 0)
  $r = fs_set($r, $base + 3, 0)
  $r = fs_set($r, $base + 4, $type)
  $r = fs_set($r, $base + 5, $parent)
  $r = fs_set($r, $base + 6, $nom_empreinte)
  $r = fs_set($r, $base + 7, 1)
  retour $r
}

fn fs_taille(f: liste<entier>, i: entier) -> entier { retour f[fs_base($i) + 1] }
fn fs_type(f: liste<entier>, i: entier) -> entier { retour f[fs_base($i) + 4] }
fn fs_etat(f: liste<entier>, i: entier) -> entier { retour f[fs_base($i) + 7] }
fn fs_parent(f: liste<entier>, i: entier) -> entier { retour f[fs_base($i) + 5] }
fn fs_empreinte(f: liste<entier>, i: entier) -> entier { retour f[fs_base($i) + 6] }

# Chercher un fichier par empreinte de nom dans un répertoire parent.
fn fs_chercher(f: liste<entier>, parent: entier, nom_empreinte: entier) -> entier {
  $nb = f[2]
  $i = 0
  tant_que ($i < $nb) {
    si (f[fs_base($i) + 5] == $parent et
        f[fs_base($i) + 6] == $nom_empreinte et
        f[fs_base($i) + 7] == 1) {
      retour $i
    }
    $i = $i + 1
  }
  retour -1
}
