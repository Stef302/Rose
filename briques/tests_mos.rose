# tests_mos.rose — banc de conformité du format `.mos` (v1).
#
# Usage (depuis la racine du dépôt) :
#   rose verif briques/tests_mos.rose                  → vérifié
#   rose briques/tests_mos.rose                        → oracle Rust
#   C0.elf briques/tests_mos.rose > tests_mos.elf      → compilateur auto-hébergé
#   ./tests_mos.elf                                    → mêmes octets de sortie
#
# Aucun `afficher` ici : `>>` est implémenté Identiquement par l'interpréteur
# et par l'émetteur G5. Le banc prouve :
#   1. l'écriture d'un conteneur (magic/version/sections/hashes) ;
#   2. la relecture exacte du RIR et des métadonnées de cible ;
#   3. la détection d'un octet modifié (payload, magic, version, troncature) ;
#   4. que le code d'architecture vient de `briques/abi/mos.bud` (donnée).

importer "compilateur/format_mos.rose"

$tm_chemin = "/tmp/opencode/tests_mos_demo.mos"
$tm_corrompu = "/tmp/opencode/tests_mos_corrompu.mos"
$tm_rir = "rir\nfonction principal\n  ops\n    0000 retour (n 42)\n"
$tm_cible = "GENERIQUE|petit|64|4096|rose-utilisateur-v0|4194304"

$tm_arch = mos_arch_code("GENERIQUE")
$tm_arch2 = mos_arch_code("X86_64")
>> "architecturebud=0/" + chaine($tm_arch) + "/2/" + chaine($tm_arch2)

$tm_rc = mos_ecrire($tm_rir, $tm_cible, $tm_chemin)
>> "ecriture=" + chaine($tm_rc)

$tm_txt = lire_texte($tm_chemin)
>> "magic=" + sous_chaine($tm_txt, 0, 3) + "-" + chaine(ordre(sous_chaine($tm_txt, 3, 4)))
>> "version=" + sous_chaine($tm_txt, 4, 8)
>> "taille=" + chaine(longueur($tm_txt))
>> "sections=" + sous_chaine($tm_txt, 38, 40)
>> "hash=" + sous_chaine($tm_txt, longueur($tm_txt) - 24, longueur($tm_txt))

$tm_val = mos_valider($tm_txt)
>> "validation=" + chaine($tm_val)

$tm_lu = mos_lire($tm_chemin)
>> "statut=" + $tm_lu[1]
$tm_oui_rir = "0"
$tm_oui_cible = "0"
$tm_oui_hash = "0"
si ($tm_lu[2] == $tm_rir) { $tm_oui_rir = "1" }
si ($tm_lu[3] == $tm_cible) { $tm_oui_cible = "1" }
si (sous_chaine($tm_txt, longueur($tm_txt) - 24, longueur($tm_txt)) == $tm_lu[6] + $tm_lu[7] + $tm_lu[8]) { $tm_oui_hash = "1" }
>> "rir_ok=" + $tm_oui_rir
>> "cible_ok=" + $tm_oui_cible
>> "arch_lue=" + $tm_lu[4]
>> "entree_lue=" + $tm_lu[5]
>> "hash_ok=" + $tm_oui_hash

# ── Détection de corruption ────────────────────────────────────────────────

$tm_faux_magic = "X" + sous_chaine($tm_txt, 1, longueur($tm_txt))
>> "faux_magic=" + chaine(mos_valider($tm_faux_magic))

$tm_fausse_version = sous_chaine($tm_txt, 0, 4) + "2" + sous_chaine($tm_txt, 5, longueur($tm_txt))
>> "fausse_version=" + chaine(mos_valider($tm_fausse_version))

$tm_tronque = sous_chaine($tm_txt, 0, 50)
>> "tronque=" + chaine(mos_valider($tm_tronque))

# Un seul chiffre hexadécimal modifié dans la charge RIR (offset 106).
$tm_reempl = "0"
si (sous_chaine($tm_txt, 106, 107) == "0") { $tm_reempl = "1" }
$tm_faux_payload = sous_chaine($tm_txt, 0, 106) + $tm_reempl + sous_chaine($tm_txt, 107, longueur($tm_txt))
>> "faux_payload=" + chaine(mos_valider($tm_faux_payload))

ecrire_texte($tm_corrompu, $tm_faux_payload)
$tm_lu_faux = mos_lire($tm_corrompu)
>> "relecture_corrompue=" + $tm_lu_faux[1]

>> "TESTS MOS VERTS : ecriture, relecture, 4 corruptions detectees"
quitter(0)
